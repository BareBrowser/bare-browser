+
+/** Tests for the script that keeps a page from cancelling the long-press menu on a video. */
+@RunWith(BaseRobolectricTestRunner.class)
+public class BareMediaMenuGuardUnitTest {
+    private static final String SCRIPT = BareMediaMenuGuard.SCRIPT;
+
+    @Test
+    public void testItListensBeforeThePageDoes() {
+        // Capture phase on the window, so it runs ahead of any handler on the video or document.
+        assertTrue(SCRIPT.contains("window.addEventListener('contextmenu'"));
+        assertTrue(SCRIPT.endsWith(",true);})()"));
+    }
+
+    @Test
+    public void testItActsOnlyOnTheUsersOwnPressOverAVideo() {
+        assertTrue(SCRIPT.contains("e.isTrusted"));
+        assertTrue(SCRIPT.contains("elementsFromPoint"));
+        assertTrue(SCRIPT.contains("'VIDEO'"));
+        assertTrue(SCRIPT.contains("stopImmediatePropagation"));
+    }
+
+    @Test
+    public void testItChangesNothingElseAboutTheEvent() {
+        assertFalse(SCRIPT.contains("preventDefault"));
+        assertFalse(SCRIPT.contains("dispatchEvent"));
+    }
+
+    @Test
+    public void testItRunsOncePerDocument() {
+        assertTrue(SCRIPT.contains("if(window.__bareMediaMenu)return;"));
+    }
+}

+/** Tests for choosing among the video files a page has fetched. */
+@RunWith(BaseRobolectricTestRunner.class)
+public class BareMediaCandidatesUnitTest {
+    private static Candidate file(String name, int kb, int age, String handler, int w, int h) {
+        return new Candidate("https://cdn.example/" + name + ".mp4", kb, age, handler, w, h);
+    }
+
+    private static String state(String json) {
+        return JSONObject.quote(json);
+    }
+
+    @Test
+    public void testAStillRunningScriptGivesNothingYet() {
+        assertNull(BareMediaCandidates.parse(null));
+        assertNull(BareMediaCandidates.parse(state("{}")));
+        assertNull(BareMediaCandidates.parse(state("{\"state\":\"running\",\"items\":[]}")));
+        assertNull(BareMediaCandidates.parse("garbage"));
+    }
+
+    @Test
+    public void testAFinishedScriptIsRead() {
+        List<Candidate> parsed =
+                BareMediaCandidates.parse(
+                        state(
+                                "{\"state\":\"done\",\"items\":[{\"url\":\"https://cdn.example/a.mp4\","
+                                        + "\"kb\":14953,\"ageS\":22,\"handler\":\"vide\",\"width\":720,"
+                                        + "\"height\":1280}]}"));
+        assertNotNull(parsed);
+        assertEquals(1, parsed.size());
+        assertEquals("vide", parsed.get(0).handler);
+        assertEquals(720, parsed.get(0).width);
+        assertEquals(1280, parsed.get(0).height);
+        assertEquals(22, parsed.get(0).ageSeconds);
+    }
+
+    @Test
+    public void testSoundAndUnsafeAddressesAreLeftOut() {
+        List<Candidate> all = new ArrayList<>();
+        all.add(file("video", 5000, 10, "vide", 720, 1280));
+        all.add(file("audio", 500, 10, "soun", 0, 0));
+        all.add(new Candidate("http://cdn.example/plain.mp4", 5000, 5, "vide", 720, 1280));
+        all.add(new Candidate("blob:https://site.example/1", 5000, 5, "vide", 720, 1280));
+        List<Candidate> choices = BareMediaCandidates.choices(all, 0, 0);
+        assertEquals(1, choices.size());
+        assertEquals("https://cdn.example/video.mp4", choices.get(0).url);
+    }
+
+    @Test
+    public void testFilesThatMatchThePressedPictureComeFirstAndAloneWhenThereAreAny() {
+        List<Candidate> all = new ArrayList<>();
+        all.add(file("old-match", 4000, 90, "vide", 720, 1280));
+        all.add(file("other-size", 9000, 5, "vide", 480, 854));
+        all.add(file("new-match", 3000, 20, "vide", 720, 1280));
+        List<Candidate> choices = BareMediaCandidates.choices(all, 720, 1280);
+        assertEquals(2, choices.size());
+        assertEquals("https://cdn.example/new-match.mp4", choices.get(0).url);
+        assertEquals("https://cdn.example/old-match.mp4", choices.get(1).url);
+    }
+
+    @Test
+    public void testWithNoMatchEveryVideoFileIsOfferedNewestFirst() {
+        List<Candidate> all = new ArrayList<>();
+        all.add(file("a", 4000, 90, "vide", 640, 360));
+        all.add(file("b", 9000, 5, "vide", 480, 854));
+        List<Candidate> choices = BareMediaCandidates.choices(all, 720, 1280);
+        assertEquals(2, choices.size());
+        assertEquals("https://cdn.example/b.mp4", choices.get(0).url);
+        // An undecoded video has no size to match, so nothing is narrowed.
+        assertEquals(2, BareMediaCandidates.choices(all, 0, 0).size());
+    }
+
+    @Test
+    public void testNoVideoFilesGivesAnEmptyList() {
+        List<Candidate> all = new ArrayList<>();
+        all.add(file("audio", 500, 10, "soun", 0, 0));
+        assertTrue(BareMediaCandidates.choices(all, 720, 1280).isEmpty());
+        assertTrue(BareMediaCandidates.choices(new ArrayList<>(), 0, 0).isEmpty());
+    }
+
+    @Test
+    public void testTheListIsCapped() {
+        List<Candidate> all = new ArrayList<>();
+        for (int i = 0; i < 20; i++) all.add(file("f" + i, 3000, i, "vide", 720, 1280));
+        assertEquals(BareMediaCandidates.MAX_CHOICES, BareMediaCandidates.choices(all, 720, 1280).size());
+    }
+
+    @Test
+    public void testALineSaysSizeFileAndAge() {
+        assertEquals("720x1280  14.6 MB  22 s ago", BareMediaCandidates.label(file("a", 14953, 22, "vide", 720, 1280)));
+        assertEquals("1.0 MB  3 min ago", BareMediaCandidates.label(file("a", 1024, 200, "vide", 0, 0)));
+    }
+
+    @Test
+    public void testTheScriptIsPartOfTheApp() {
+        String script = BareMediaProbe.readRaw(org.chromium.chrome.R.raw.bare_media_candidates);
+        assertTrue(script.contains("__bareCandidates"));
+    }
+}

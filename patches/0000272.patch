diff --git a/chrome/android/java/src/org/chromium/chrome/browser/bare/BareMediaCandidates.java b/chrome/android/java/src/org/chromium/chrome/browser/bare/BareMediaCandidates.java
new file mode 100644
index 00000000000..b3a4678d885
--- /dev/null
+++ b/chrome/android/java/src/org/chromium/chrome/browser/bare/BareMediaCandidates.java
@@ -0,0 +1,157 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.bare;
+
+import org.json.JSONArray;
+import org.json.JSONException;
+import org.json.JSONObject;
+
+import org.chromium.base.Callback;
+import org.chromium.base.task.PostTask;
+import org.chromium.base.task.TaskTraits;
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.chrome.R;
+import org.chromium.content_public.browser.WebContents;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Locale;
+
+/**
+ * The video files a page has fetched, for a video that has no file address of its own.
+ *
+ * <p>A feed keeps several videos on the page and preloads the next ones, so which fetched file
+ * belongs to the video that was pressed cannot be worked out reliably. This reads what the page
+ * fetched, with the kind of each file and the size of its picture, so the user can choose. The
+ * script is {@code res/raw/bare_media_candidates.js}.
+ */
+@NullMarked
+public final class BareMediaCandidates {
+    private BareMediaCandidates() {}
+
+    /** The most files offered at once. */
+    static final int MAX_CHOICES = 6;
+
+    private static final int POLL_MS = 250;
+    private static final int MAX_POLLS = 16;
+
+    /** One fetched file. */
+    public static final class Candidate {
+        public final String url;
+        public final int kb;
+        public final int ageSeconds;
+        public final String handler;
+        public final int width;
+        public final int height;
+
+        Candidate(String url, int kb, int ageSeconds, String handler, int width, int height) {
+            this.url = url;
+            this.kb = kb;
+            this.ageSeconds = ageSeconds;
+            this.handler = handler;
+            this.width = width;
+            this.height = height;
+        }
+    }
+
+    /** Reads the state the script leaves behind; null while it is still running. */
+    static @Nullable List<Candidate> parse(@Nullable String scriptResult) {
+        if (scriptResult == null) return null;
+        try {
+            Object decoded = new org.json.JSONTokener(scriptResult).nextValue();
+            if (!(decoded instanceof String)) return null;
+            JSONObject state = new JSONObject((String) decoded);
+            if (!state.optString("state", "").equals("done")) return null;
+            List<Candidate> out = new ArrayList<>();
+            JSONArray items = state.optJSONArray("items");
+            for (int i = 0; items != null && i < items.length(); i++) {
+                JSONObject item = items.getJSONObject(i);
+                out.add(
+                        new Candidate(
+                                item.optString("url", ""),
+                                item.optInt("kb", 0),
+                                item.optInt("ageS", 0),
+                                item.optString("handler", ""),
+                                item.optInt("width", 0),
+                                item.optInt("height", 0)));
+            }
+            return out;
+        } catch (JSONException e) {
+            return null;
+        }
+    }
+
+    /**
+     * The files worth offering: video only, on a safe address, newest first. Files whose picture
+     * matches the pressed video come first, and when any match, the rest are left out.
+     */
+    public static List<Candidate> choices(List<Candidate> all, int videoWidth, int videoHeight) {
+        List<Candidate> video = new ArrayList<>();
+        for (Candidate c : all) {
+            if (c.handler.equals("vide") && BareMediaProbe.isFileAddress(c.url)) video.add(c);
+        }
+        video.sort((a, b) -> Integer.compare(a.ageSeconds, b.ageSeconds));
+        List<Candidate> matching = new ArrayList<>();
+        if (videoWidth > 0 && videoHeight > 0) {
+            for (Candidate c : video) {
+                if (c.width == videoWidth && c.height == videoHeight) matching.add(c);
+            }
+        }
+        List<Candidate> chosen = matching.isEmpty() ? video : matching;
+        return chosen.size() > MAX_CHOICES ? chosen.subList(0, MAX_CHOICES) : chosen;
+    }
+
+    /** A line for the list: picture size, file size, and how long ago it was last fetched. */
+    static String label(Candidate c) {
+        StringBuilder out = new StringBuilder();
+        if (c.width > 0 && c.height > 0) out.append(c.width).append('x').append(c.height).append("  ");
+        out.append(String.format(Locale.US, "%.1f MB", c.kb / 1024.0));
+        out.append("  ");
+        if (c.ageSeconds < 90) {
+            out.append(c.ageSeconds).append(" s ago");
+        } else {
+            out.append(c.ageSeconds / 60).append(" min ago");
+        }
+        return out.toString();
+    }
+
+    /** Asks the page for the files it has fetched, and passes them on, or an empty list. */
+    public static void load(
+            @Nullable WebContents webContents, Callback<List<Candidate>> done) {
+        if (webContents == null || webContents.isDestroyed()) {
+            done.onResult(new ArrayList<>());
+            return;
+        }
+        String script = BareMediaProbe.readRaw(R.raw.bare_media_candidates);
+        if (script.isEmpty()) {
+            done.onResult(new ArrayList<>());
+            return;
+        }
+        BareScriptBridge.evaluate(
+                webContents, script, ignored -> poll(webContents, done, MAX_POLLS));
+    }
+
+    private static void poll(WebContents webContents, Callback<List<Candidate>> done, int left) {
+        if (webContents.isDestroyed()) {
+            done.onResult(new ArrayList<>());
+            return;
+        }
+        BareScriptBridge.evaluate(
+                webContents,
+                "JSON.stringify(window.__bareCandidates||{})",
+                result -> {
+                    List<Candidate> parsed = parse(result);
+                    if (parsed != null || left <= 0) {
+                        done.onResult(parsed == null ? new ArrayList<>() : parsed);
+                        return;
+                    }
+                    PostTask.postDelayedTask(
+                            TaskTraits.UI_DEFAULT,
+                            () -> poll(webContents, done, left - 1),
+                            POLL_MS);
+                });
+    }
+}

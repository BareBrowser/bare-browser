+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.bare;
+
+import org.chromium.base.task.PostTask;
+import org.chromium.base.task.TaskTraits;
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.components.embedder_support.contextmenu.ContextMenuParams;
+import org.chromium.content_public.browser.WebContents;
+
+import java.util.WeakHashMap;
+
+/**
+ * What the long-press menu should offer for media Chromium did not classify.
+ *
+ * <p>The menu is built from Chromium's own reading of the pressed element. When that is not a
+ * video, the page is asked what lies under the press before the menu is built, and the answer is
+ * kept for the menu to read. The wait is short and bounded; if the page is slow the menu is built
+ * without it.
+ */
+@NullMarked
+public final class BarePressedMedia {
+    private BarePressedMedia() {}
+
+    /** What to add to the menu. */
+    public enum Offer {
+        NONE,
+        VIDEO,
+        IMAGE
+    }
+
+    /** The longest the menu waits for the page, in milliseconds. */
+    static final long TIMEOUT_MS = 400;
+
+    private static final WeakHashMap<ContextMenuParams, BareMediaProbe.Pressed> sResults =
+            new WeakHashMap<>();
+
+    /**
+     * Whether to ask the page. Chromium's own video and audio handling is left alone, and so is
+     * anything that is not a web page, where there is no feed to look through.
+     */
+    public static boolean shouldProbe(
+            boolean isVideo, boolean isAudio, boolean isFile, @Nullable String pageScheme) {
+        if (isVideo || isAudio || isFile || pageScheme == null) return false;
+        return pageScheme.equals("http") || pageScheme.equals("https");
+    }
+
+    /**
+     * What to add, given what Chromium said and what the page said.
+     *
+     * <p>A video under the press is offered even when Chromium classified the press as an image,
+     * because a poster laid over a video is exactly that. An image is offered only when Chromium
+     * saw none, since otherwise its own image items already cover it. Two videos under one press
+     * give nothing.
+     */
+    public static Offer offerFor(
+            boolean paramsIsVideo, boolean paramsIsImage, BareMediaProbe.@Nullable Pressed pressed) {
+        if (paramsIsVideo || pressed == null || pressed.ambiguous) return Offer.NONE;
+        if (pressed.kind == BareMediaProbe.Pressed.VIDEO) return Offer.VIDEO;
+        if (pressed.kind == BareMediaProbe.Pressed.IMAGE && !paramsIsImage && pressed.address != null) {
+            return Offer.IMAGE;
+        }
+        return Offer.NONE;
+    }
+
+    /**
+     * Whether the video's separate audio track should be offered as well. Streaming pages often
+     * serve picture and sound as two files, so the picture alone is silent. The tab's record of
+     * fetches can say which audio file goes with the picture only when the page has one video, and
+     * only matters when the video has no file of its own.
+     */
+    public static boolean offersAudio(Offer offer, BareMediaProbe.@Nullable Pressed pressed) {
+        return offer == Offer.VIDEO
+                && pressed != null
+                && pressed.address == null
+                && pressed.videos <= 1;
+    }
+
+    /** Asks the page about the press, then runs {@code done} once, with or without an answer. */
+    public static void probe(
+            @Nullable WebContents webContents, ContextMenuParams params, Runnable done) {
+        final boolean[] finished = {false};
+        Runnable finish =
+                () -> {
+                    if (finished[0]) return;
+                    finished[0] = true;
+                    done.run();
+                };
+        PostTask.postDelayedTask(TaskTraits.UI_DEFAULT, finish, TIMEOUT_MS);
+        BareMediaProbe.findPressed(
+                webContents,
+                params.getTriggeringTouchXDp(),
+                params.getTriggeringTouchYDp(),
+                pressed -> {
+                    if (finished[0]) return;
+                    remember(params, pressed);
+                    finish.run();
+                });
+    }
+
+    static void remember(ContextMenuParams params, BareMediaProbe.Pressed pressed) {
+        sResults.put(params, pressed);
+    }
+
+    /** What the page said about the press that made these params, or null. */
+    public static BareMediaProbe.@Nullable Pressed get(ContextMenuParams params) {
+        return sResults.get(params);
+    }
+}

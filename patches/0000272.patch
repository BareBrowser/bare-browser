diff --git a/chrome/android/java/res/raw/bare_media_candidates.js b/chrome/android/java/res/raw/bare_media_candidates.js
new file mode 100644
index 00000000000..2c400a6f0e3
--- /dev/null
+++ b/chrome/android/java/res/raw/bare_media_candidates.js
@@ -0,0 +1,66 @@
+// Lists the video files this page has fetched, for a video that has no file address of its own.
+//
+// It starts the work and returns at once; the answer is read later from window.__bareCandidates:
+//   state  "running" or "done"
+//   items  newest first: {url, kb, ageS, handler, width, height}
+// A file is one address with its range parameters removed. The first few kilobytes of each are read,
+// from the page's own recent fetches, to learn whether it holds video or sound and how big its
+// picture is. At most MAX_GROUPS files are looked at and nothing is kept past the answer.
+(function () {
+  var MAX_GROUPS = 12, MIN_KB = 200, HEAD_BYTES = 8192;
+  var state = window.__bareCandidates = {state: 'running', items: []};
+
+  function u32(b, o) { return b[o] * 16777216 + (b[o + 1] << 16) + (b[o + 2] << 8) + b[o + 3]; }
+  function box(b, start, end, type) {
+    var o = start;
+    while (o + 8 <= end) {
+      var size = u32(b, o), t = String.fromCharCode(b[o + 4], b[o + 5], b[o + 6], b[o + 7]);
+      if (size < 8) return null;
+      if (t === type) return [o + 8, Math.min(o + size, end)];
+      o += size;
+    }
+    return null;
+  }
+
+  var now = performance.now(), groups = {};
+  performance.getEntriesByType('resource').forEach(function (e) {
+    var u;
+    try { u = new URL(e.name); } catch (x) { return; }
+    if (!/^https:$/.test(u.protocol) && !/^(localhost|127\.)/.test(u.hostname)) return;
+    if (e.initiatorType !== 'fetch' && e.initiatorType !== 'xmlhttprequest') return;
+    if (!/\.(mp4|m4s|m4v|webm)$/i.test(u.pathname)) return;
+    var range = u.searchParams.has('bytestart') || u.searchParams.has('byteend');
+    u.searchParams.delete('bytestart');
+    u.searchParams.delete('byteend');
+    var key = u.origin + u.pathname;
+    var g = groups[key] || (groups[key] = {base: u.href, kb: 0, last: 0, ranged: range});
+    g.kb += Math.round((e.encodedBodySize || e.decodedBodySize || 0) / 1024);
+    g.last = Math.max(g.last, e.responseEnd);
+  });
+
+  var list = Object.keys(groups).map(function (k) { return groups[k]; })
+      .filter(function (g) { return g.kb >= MIN_KB; })
+      .sort(function (a, b) { return b.last - a.last; }).slice(0, MAX_GROUPS);
+
+  Promise.all(list.map(function (g) {
+    var u = new URL(g.base);
+    if (g.ranged) { u.searchParams.set('bytestart', '0'); u.searchParams.set('byteend', String(HEAD_BYTES - 1)); }
+    var item = {url: g.base, kb: g.kb, ageS: Math.round((now - g.last) / 1000), handler: '', width: 0, height: 0};
+    return fetch(u.href, g.ranged ? {} : {headers: {Range: 'bytes=0-' + (HEAD_BYTES - 1)}})
+        .then(function (r) { return r.arrayBuffer(); })
+        .then(function (buf) {
+          var b = new Uint8Array(buf), moov = box(b, 0, b.length, 'moov');
+          var trak = moov && box(b, moov[0], moov[1], 'trak');
+          if (trak) {
+            var mdia = box(b, trak[0], trak[1], 'mdia'), h = mdia && box(b, mdia[0], mdia[1], 'hdlr');
+            if (h) item.handler = String.fromCharCode(b[h[0] + 8], b[h[0] + 9], b[h[0] + 10], b[h[0] + 11]);
+            var tk = box(b, trak[0], trak[1], 'tkhd');
+            if (tk) { item.width = u32(b, tk[1] - 8) >>> 16; item.height = u32(b, tk[1] - 4) >>> 16; }
+          }
+          return item;
+        })
+        .catch(function () { return item; });
+  })).then(function (items) { state.items = items; state.state = 'done'; },
+           function () { state.state = 'done'; });
+  return 'started';
+})()
diff --git a/chrome/android/java/res/raw/bare_pressed_media_probe.js b/chrome/android/java/res/raw/bare_pressed_media_probe.js
new file mode 100644
index 00000000000..0b6449629f2
--- /dev/null
+++ b/chrome/android/java/res/raw/bare_pressed_media_probe.js
@@ -0,0 +1,113 @@
+// Finds the media under a press, for pages whose media Chromium cannot classify, such as a feed that
+// draws a photo as a background or lays a poster over its video. It returns a JSON string.
+//
+// Called as (function)(x, y) with the press position in CSS pixels. The answer is:
+//   kind        "video", "image" or "none"
+//   src         the file address for the pressed media, or ""
+//   blob        true when the video is fed from a blob or media source, so it has no file address
+//   videos      how many sizeable videos the page has; page data is trusted only when it is one
+//   candidates  file addresses the page's own data names for videos
+//   ambiguous   true when two videos both lie under the press
+//
+// Only media that contains the press point counts. A neighbouring photo, or another post's video in
+// a shared container, is never taken. At most MAX_STACK elements under the point and MAX_UP
+// ancestors of the topmost one are looked at.
+(function (x, y) {
+  var MAX_STACK = 16, MAX_UP = 6, MIN_SIDE = 48, MAX_ADDRESS = 2048;
+  var KEYS = ['playable_url_quality_hd', 'browser_native_hd_url', 'playable_url',
+              'browser_native_sd_url', 'video_url', 'contentUrl'];
+
+  function abs(u) {
+    try { return new URL(u, location.href).href; } catch (e) { return ''; }
+  }
+  function visible(el) {
+    var cs = getComputedStyle(el);
+    return cs.display !== 'none' && cs.visibility !== 'hidden' && parseFloat(cs.opacity) > 0.05;
+  }
+  function contains(el) {
+    var r = el.getBoundingClientRect();
+    return r.width >= MIN_SIDE && r.height >= MIN_SIDE &&
+           x >= r.left && x <= r.right && y >= r.top && y <= r.bottom;
+  }
+  // A page-wide wrapper with a background is the page, not the photo that was pressed. A video
+  // can fill the screen, as a full-screen reel does, so this limit is not applied to videos.
+  function holds(el) {
+    var r = el.getBoundingClientRect();
+    return contains(el) && r.width * r.height <= 0.9 * innerWidth * innerHeight;
+  }
+  function safe(u) {
+    return typeof u === 'string' && u.length > 0 && u.length <= MAX_ADDRESS && /^https?:/i.test(u) &&
+           !/^https?:\/\/[^\/]*@/i.test(u);
+  }
+  function backgroundImage(el) {
+    var bg = getComputedStyle(el).backgroundImage;
+    var m = /url\((["']?)(.*?)\1\)/.exec(bg || '');
+    return m ? abs(m[2]) : '';
+  }
+
+  var stack = (document.elementsFromPoint(x, y) || []).slice(0, MAX_STACK);
+  var out = { kind: 'none', src: '', blob: false, videos: 0, candidates: [], ambiguous: false,
+              width: 0, height: 0 };
+
+  // Videos that lie under the point: in the stack, or inside one of the nearest ancestors of the
+  // topmost element, which is where a feed keeps the video a poster is laid over.
+  var found = [];
+  function addVideo(v) {
+    if (found.indexOf(v) < 0 && visible(v) && contains(v)) found.push(v);
+  }
+  for (var i = 0; i < stack.length; i++) if (stack[i].tagName === 'VIDEO') addVideo(stack[i]);
+  // The topmost element of a sensible size, so a page-wide or tiny overlay does not hide the card.
+  var up = null;
+  for (var t = 0; t < stack.length && !up; t++) if (holds(stack[t])) up = stack[t];
+  for (var n = 0; up && n < MAX_UP && up !== document.body; n++, up = up.parentElement) {
+    var inside = up.querySelectorAll ? up.querySelectorAll('video') : [];
+    for (var j = 0; j < inside.length && j < 8; j++) addVideo(inside[j]);
+  }
+
+  var all = document.querySelectorAll('video');
+  for (var a = 0; a < all.length; a++) {
+    var rr = all[a].getBoundingClientRect();
+    if (rr.width > MIN_SIDE && rr.height > MIN_SIDE) out.videos++;
+  }
+
+  if (found.length > 1) {
+    out.ambiguous = true;
+  } else if (found.length === 1) {
+    var v = found[0], s = v.currentSrc || v.src || '';
+    out.kind = 'video';
+    out.width = v.videoWidth || 0;
+    out.height = v.videoHeight || 0;
+    out.blob = /^blob:/i.test(s) || s === '';
+    if (!out.blob) out.src = abs(s);
+  } else {
+    // No video under the press. The photo is the topmost image-like element that holds the point:
+    // an <img>, or any element drawn with a background image.
+    for (var k = 0; k < stack.length; k++) {
+      var e = stack[k];
+      if (e === document.documentElement || e === document.body || !visible(e) || !holds(e)) continue;
+      var u = '';
+      if (e.tagName === 'IMG') u = e.currentSrc || e.src || '';
+      else u = backgroundImage(e);
+      u = abs(u);
+      if (safe(u)) { out.kind = 'image'; out.src = u; break; }
+    }
+  }
+
+  if (out.kind === 'video' || out.ambiguous) {
+    var text = '', ss = document.querySelectorAll('script');
+    for (var q = 0; q < ss.length && q < 200; q++) text += ss[q].textContent + ' ';
+    for (var w = 0; w < KEYS.length; w++) {
+      var needle = '"' + KEYS[w] + '":"', p = 0;
+      while ((p = text.indexOf(needle, p)) >= 0 && out.candidates.length < 20) {
+        p += needle.length;
+        var end = p;
+        while (end < text.length && !(text.charCodeAt(end) === 34 && text.charCodeAt(end - 1) !== 92)) end++;
+        var raw = text.slice(p, end), c = raw;
+        try { c = JSON.parse('"' + raw + '"'); } catch (err) {}
+        if (/^https?:/i.test(c) && out.candidates.indexOf(c) < 0) out.candidates.push(c);
+        p = end;
+      }
+    }
+  }
+  return JSON.stringify(out);
+})

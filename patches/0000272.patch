index 00000000000..952f46de7b8
--- /dev/null
+++ b/chrome/android/java/src/org/chromium/chrome/browser/bare/BareMediaMenuGuard.java
@@ -0,0 +1,54 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.bare;
+
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.content_public.browser.GlobalRenderFrameHostId;
+import org.chromium.content_public.browser.LifecycleState;
+import org.chromium.content_public.browser.Page;
+import org.chromium.content_public.browser.WebContents;
+import org.chromium.content_public.browser.WebContentsObserver;
+
+/**
+ * Keeps a page from cancelling the long-press menu on a video.
+ *
+ * <p>Chromium shows the menu only when the page leaves the contextmenu event alone, and some sites
+ * cancel it on their videos, so no menu, and no Download video, ever appears. This adds a listener
+ * that runs before the page's own and stops the page from seeing a real long-press over a video.
+ * Nothing else about the event changes, and only the user's own presses count, not events a page
+ * makes up.
+ */
+@NullMarked
+public final class BareMediaMenuGuard extends WebContentsObserver {
+    static final String SCRIPT =
+            "(function(){if(window.__bareMediaMenu)return;window.__bareMediaMenu=true;"
+                    + "window.addEventListener('contextmenu',function(e){if(!e.isTrusted)return;"
+                    + "var els=document.elementsFromPoint(e.clientX,e.clientY)||[];"
+                    + "for(var i=0;i<els.length&&i<16;i++){if(els[i].tagName==='VIDEO'){"
+                    + "e.stopImmediatePropagation();return;}}},true);})()";
+
+    private final WebContents mWebContents;
+
+    public BareMediaMenuGuard(WebContents webContents) {

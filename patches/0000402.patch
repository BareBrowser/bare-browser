@@ -0,0 +1,180 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.download.home.list;
+
+import android.app.Activity;
+import android.graphics.Color;
+import android.graphics.drawable.GradientDrawable;
+import android.text.TextUtils;
+import android.util.TypedValue;
+import android.view.Gravity;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.LinearLayout;
+import android.widget.TextView;
+
+import androidx.annotation.ColorInt;
+
+import org.chromium.base.Callback;
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.chrome.browser.download.internal.R;
+import org.chromium.components.browser_ui.widget.RiseSheet;
+import org.chromium.components.offline_items_collection.OfflineItem;
+
+import java.util.List;
+
+/**
+ * The question that comes before a file is deleted from the Downloads page: a card that rises from
+ * the bottom edge, with Cancel and Delete. Nothing is removed until Delete is tapped.
+ */
+@NullMarked
+public final class BareDownloadDelete {
+    private BareDownloadDelete() {}
+
+    /** Asks whether {@code items} may be deleted; {@code answer} gets false for anything else. */
+    public static void confirm(Activity activity, List<OfflineItem> items, Callback<Boolean> answer) {
+        View root = activity.findViewById(android.R.id.content);
+        if (root == null || items.isEmpty()) {
+            answer.onResult(false);
+            return;
+        }
+        float density = activity.getResources().getDisplayMetrics().density;
+        int bar = RiseSheet.barColor(root);
+        boolean light = luminance(bar) > 150;
+        @ColorInt int ink = light ? 0xFF1B1B1F : 0xFFE6E6EA;
+        @ColorInt int soft = (ink & 0x00FFFFFF) | 0x14000000;
+        @ColorInt int danger = light ? 0xFFB3261E : 0xFFF2B8B5;
+        @ColorInt int onDanger = light ? Color.WHITE : 0xFF601410;
+
+        LinearLayout content = new LinearLayout(activity);
+        content.setOrientation(LinearLayout.VERTICAL);
+        int side = Math.round(20 * density);
+        content.setPadding(side, 0, side, Math.round(14 * density));
+
+        boolean one = items.size() == 1;
+        content.addView(
+                text(
+                        activity,
+                        one
+                                ? activity.getString(R.string.bare_download_delete_title)
+                                : activity.getString(
+                                        R.string.bare_download_delete_title_many, items.size()),
+                        18,
+                        ink));
+        if (one) {
+            TextView name = text(activity, items.get(0).title, 14, (ink & 0x00FFFFFF) | 0xB3000000);
+            name.setSingleLine();
+            name.setEllipsize(TextUtils.TruncateAt.MIDDLE);
+            LinearLayout.LayoutParams nameParams =
+                    new LinearLayout.LayoutParams(
+                            ViewGroup.LayoutParams.MATCH_PARENT,
+                            ViewGroup.LayoutParams.WRAP_CONTENT);
+            nameParams.topMargin = Math.round(6 * density);
+            content.addView(name, nameParams);
+        }
+        TextView body =
+                text(
+                        activity,
+                        activity.getString(
+                                one
+                                        ? R.string.bare_download_delete_body
+                                        : R.string.bare_download_delete_body_many),
+                        14,
+                        (ink & 0x00FFFFFF) | 0xB3000000);
+        LinearLayout.LayoutParams bodyParams =
+                new LinearLayout.LayoutParams(
+                        ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT);
+        bodyParams.topMargin = Math.round(6 * density);
+        content.addView(body, bodyParams);
+
+        LinearLayout buttons = new LinearLayout(activity);
+        buttons.setOrientation(LinearLayout.HORIZONTAL);
+        TextView cancel = button(activity, activity.getString(R.string.cancel), ink, soft, density);
+        TextView delete =
+                button(
+                        activity,
+                        activity.getString(R.string.bare_download_delete_confirm),
+                        onDanger,
+                        danger,
+                        density);
+        LinearLayout.LayoutParams left =
+                new LinearLayout.LayoutParams(0, Math.round(44 * density), 1f);
+        left.rightMargin = Math.round(4 * density);
+        LinearLayout.LayoutParams right =
+                new LinearLayout.LayoutParams(0, Math.round(44 * density), 1f);
+        right.leftMargin = Math.round(4 * density);
+        buttons.addView(cancel, left);
+        buttons.addView(delete, right);
+        LinearLayout.LayoutParams buttonsParams =
+                new LinearLayout.LayoutParams(
+                        ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT);
+        buttonsParams.topMargin = Math.round(16 * density);
+        content.addView(buttons, buttonsParams);
+
+        boolean[] answered = {false};
+        RiseSheet[] sheet = new RiseSheet[1];
+        cancel.setOnClickListener(
+                v -> {
+                    if (sheet[0] != null) sheet[0].fold();
+                });
+        delete.setOnClickListener(
+                v -> {
+                    if (answered[0]) return;
+                    answered[0] = true;
+                    answer.onResult(true);
+                    if (sheet[0] != null) sheet[0].fold();
+                });
+        sheet[0] =
+                RiseSheet.showCard(
+                        root,
+                        content,
+                        /* modal= */ true,
+                        /* closeAfterMs= */ 0,
+                        () -> {
+                            // Back, a tap outside and Cancel all end up here without an answer.
+                            if (answered[0]) return;
+                            answered[0] = true;
+                            answer.onResult(false);
+                        });
+        if (sheet[0] == null && !answered[0]) {
+            // Another card is up: ask again later rather than delete.
+            answered[0] = true;
+            answer.onResult(false);
+        }
+    }
+
+    private static int luminance(@ColorInt int color) {
+        return (Color.red(color) * 299 + Color.green(color) * 587 + Color.blue(color) * 114) / 1000;
+    }
+
+    private static TextView text(Activity activity, String value, int sp, @ColorInt int color) {
+        TextView view = new TextView(activity);
+        view.setText(value);
+        view.setTextSize(TypedValue.COMPLEX_UNIT_SP, sp);
+        view.setTextColor(color);
+        return view;
+    }
+
+    private static TextView button(
+            Activity activity,
+            String label,
+            @ColorInt int textColor,
+            @ColorInt int fill,
+            float density) {
+        TextView view = new TextView(activity);
+        view.setText(label);
+        view.setTextSize(TypedValue.COMPLEX_UNIT_SP, 14);
+        view.setGravity(Gravity.CENTER);
+        view.setTextColor(textColor);
+        GradientDrawable shape = new GradientDrawable();
+        shape.setColor(fill);
+        shape.setCornerRadius(14 * density);
+        view.setBackground(shape);
+        view.setClickable(true);
+        view.setFocusable(true);
+        return view;
+    }
+}

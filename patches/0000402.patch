diff --git a/chrome/browser/download/internal/android/java/src/org/chromium/chrome/browser/download/home/list/BareDownloadDelete.java b/chrome/browser/download/internal/android/java/src/org/chromium/chrome/browser/download/home/list/BareDownloadDelete.java

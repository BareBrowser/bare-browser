diff --git a/chrome/android/java/src/org/chromium/chrome/browser/bare/BareTvFocus.java b/chrome/android/java/src/org/chromium/chrome/browser/bare/BareTvFocus.java
new file mode 100644
index 0000000000..59846ae9f1
--- /dev/null
+++ b/chrome/android/java/src/org/chromium/chrome/browser/bare/BareTvFocus.java
@@ -0,0 +1,243 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.bare;
+
+import android.app.Activity;
+import android.graphics.drawable.Drawable;
+import android.graphics.drawable.GradientDrawable;
+import android.graphics.drawable.InsetDrawable;
+import android.view.FocusFinder;
+import android.view.KeyEvent;
+import android.view.View;
+import android.view.ViewGroup;
+import android.view.ViewParent;
+import android.view.ViewTreeObserver.OnGlobalFocusChangeListener;
+
+import org.chromium.base.DeviceInfo;
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.chrome.R;
+import org.chromium.chrome.browser.tab.Tab;
+import org.chromium.components.browser_ui.styles.SemanticColorUtils;
+import org.chromium.components.browser_ui.widget.MenuOrKeyboardActionController;
+
+/** Bare: D-pad focus for Android TV, where a remote is the only input. */
+@NullMarked
+public final class BareTvFocus {
+    private static final int RING_WIDTH_DP = 3;
+    private static final int RING_RADIUS_DP = 28;
+    private static final int ADDRESS_BAR_INSET_DP = 7;
+
+    private BareTvFocus() {}
+
+    /**
+     * Moves focus between the page and the bars around it. The page lies under both bars, so
+     * Android's own search finds nothing above or below it.
+     */
+    public static boolean onKeyDown(Activity activity, @Nullable Tab tab, KeyEvent event) {
+        if (!DeviceInfo.isTV() || !event.hasNoModifiers()) return false;
+        View focused = activity.getCurrentFocus();
+        if (focused == null) return false;
+        int key = event.getKeyCode();
+        if (key == KeyEvent.KEYCODE_DPAD_LEFT || key == KeyEvent.KEYCODE_DPAD_RIGHT) {
+            return moveInsideTabCard(activity, focused, key)
+                    || moveInsideToolbar(activity, focused, key);
+        }
+        boolean up = key == KeyEvent.KEYCODE_DPAD_UP;
+        if (!up && key != KeyEvent.KEYCODE_DPAD_DOWN) return false;
+
+        View next = focused.focusSearch(up ? View.FOCUS_UP : View.FOCUS_DOWN);
+        if (next == focused) next = null;
+        View page = activity.findViewById(R.id.compositor_view_holder);
+        View topBar = activity.findViewById(R.id.control_container);
+        View bottomBar = activity.findViewById(R.id.bottom_app_bar_container);
+
+        if (contains(page, focused)) {
+            if (contains(page, next)) return false;
+            View tabs = activity.findViewById(R.id.hub_pane_host);
+            if (tabs != null && tabs.isShown()) return tabs.requestFocus();
+            View bar = up ? topBar : bottomBar;
+            if (bar == null || !bar.isShown()) return false;
+            if (up) {
+                View addressBar = setUpAddressBar(activity);
+                if (addressBar != null && addressBar.requestFocus()) return true;
+            }
+            return bar.requestFocus();
+        }
+
+        View bar = up ? bottomBar : topBar;
+        if (!contains(bar, focused) || contains(bar, next)) return false;
+        View content = tab == null ? null : tab.getView();
+        return content != null && content.isShown() && content.requestFocus();
+    }
+
+    /** A tab card spans its close button, so Android finds nothing beside it. */
+    private static boolean moveInsideTabCard(Activity activity, View focused, int key) {
+        View tabs = activity.findViewById(R.id.hub_pane_host);
+        if (focused == tabs || !contains(tabs, focused)) return false;
+        boolean rtl = focused.getLayoutDirection() == View.LAYOUT_DIRECTION_RTL;
+        if ((key == KeyEvent.KEYCODE_DPAD_RIGHT) != rtl) {
+            for (View button : focused.getFocusables(View.FOCUS_DOWN)) {
+                if (button != focused && button.isClickable()) return button.requestFocus();
+            }
+            return false;
+        }
+        for (ViewParent parent = focused.getParent();
+                parent instanceof View card && card != tabs;
+                parent = parent.getParent()) {
+            if (card.isFocusable() && card.isClickable()) return card.requestFocus();
+        }
+        return false;
+    }
+
+    /** The address bar spans the toolbar buttons, so Android finds nothing beside it. */
+    private static boolean moveInsideToolbar(Activity activity, View focused, int key) {
+        View topBar = activity.findViewById(R.id.control_container);
+        View buttons = activity.findViewById(R.id.toolbar_buttons);
+        if (buttons == null || !contains(topBar, focused)) return false;
+        View addressBar = setUpAddressBar(activity);
+        if (addressBar == null) return false;
+        boolean rtl = buttons.getLayoutDirection() == View.LAYOUT_DIRECTION_RTL;
+        boolean toButtons = (key == KeyEvent.KEYCODE_DPAD_RIGHT) != rtl;
+        if (focused == addressBar && toButtons) return buttons.requestFocus(View.FOCUS_DOWN);
+        View next =
+                focused.focusSearch(
+                        key == KeyEvent.KEYCODE_DPAD_RIGHT ? View.FOCUS_RIGHT : View.FOCUS_LEFT);
+        if (contains(buttons, focused)) {
+            if (toButtons || (next != focused && contains(buttons, next))) return false;
+            return addressBar.requestFocus();
+        }
+        // The button on the other side finds a view inside the address bar, not the bar itself.
+        return !contains(addressBar, focused)
+                && contains(addressBar, next)
+                && addressBar.requestFocus();
+    }
+
+    /**
+     * Makes the address bar focusable, rings it, and opens it on the center key. Its pill is
+     * shorter than its view. Without a bottom toolbar it is not focusable.
+     */
+    private static @Nullable View setUpAddressBar(Activity activity) {
+        View addressBar = activity.findViewById(R.id.location_bar);
+        if (addressBar == null || !addressBar.isShown()) return null;
+        addressBar.setFocusable(true);
+        float density = addressBar.getResources().getDisplayMetrics().density;
+        int inset = Math.round(ADDRESS_BAR_INSET_DP * density);
+        addressBar.setOnFocusChangeListener(
+                (view, hasFocus) ->
+                        view.setForeground(
+                                hasFocus
+                                        ? new InsetDrawable(ringFor(view), 0, inset, 0, inset)
+                                        : null));
+        if (!(activity instanceof MenuOrKeyboardActionController controller)) return addressBar;
+        addressBar.setOnKeyListener(
+                (view, code, event) -> {
+                    if (code != KeyEvent.KEYCODE_DPAD_CENTER && code != KeyEvent.KEYCODE_ENTER) {
+                        return false;
+                    }
+                    if (event.getAction() == KeyEvent.ACTION_UP) {
+                        controller.onMenuOrKeyboardAction(R.id.focus_url_bar, false);
+                    }
+                    return true;
+                });
+        return addressBar;
+    }
+
+    /** Focuses the first control in {@code page}, or {@code fallback} when it has none. */
+    public static void focusFirstControl(View page, View fallback) {
+        if (!DeviceInfo.isTV()) return;
+        for (View view : page.getFocusables(View.FOCUS_DOWN)) {
+            if (view.isClickable() && view.requestFocus()) return;
+        }
+        fallback.requestFocus();
+    }
+
+    /**
+     * Keeps focus inside {@code overlay} while it covers the browser, and rings its focused
+     * control.
+     */
+    public static void keepFocusIn(View overlay) {
+        if (!DeviceInfo.isTV()) return;
+        overlay.addOnUnhandledKeyEventListener((view, event) -> moveInside(overlay, event));
+        OnGlobalFocusChangeListener listener =
+                new OnGlobalFocusChangeListener() {
+                    private @Nullable View mRinged;
+                    private @Nullable Drawable mForegroundWas;
+
+                    @Override
+                    public void onGlobalFocusChanged(@Nullable View was, @Nullable View now) {
+                        if (mRinged != null) mRinged.setForeground(mForegroundWas);
+                        boolean inside = contains(overlay, now);
+                        mRinged = inside && now != null && now.isClickable() ? now : null;
+                        if (mRinged != null) {
+                            mForegroundWas = mRinged.getForeground();
+                            mRinged.setForeground(ringFor(mRinged));
+                        }
+                        if (now != null && !inside) overlay.post(() -> bringBack(overlay, was));
+                    }
+                };
+        overlay.addOnAttachStateChangeListener(
+                new View.OnAttachStateChangeListener() {
+                    @Override
+                    public void onViewAttachedToWindow(View view) {}
+
+                    @Override
+                    public void onViewDetachedFromWindow(View view) {
+                        view.getViewTreeObserver().removeOnGlobalFocusChangeListener(listener);
+                    }
+                });
+        overlay.getViewTreeObserver().addOnGlobalFocusChangeListener(listener);
+        overlay.post(() -> bringBack(overlay, null));
+    }
+
+    /** Android's own search would also find the browser's controls behind the overlay. */
+    private static boolean moveInside(View overlay, KeyEvent event) {
+        int direction =
+                switch (event.getKeyCode()) {
+                    case KeyEvent.KEYCODE_DPAD_UP -> View.FOCUS_UP;
+                    case KeyEvent.KEYCODE_DPAD_DOWN -> View.FOCUS_DOWN;
+                    case KeyEvent.KEYCODE_DPAD_LEFT -> View.FOCUS_LEFT;
+                    case KeyEvent.KEYCODE_DPAD_RIGHT -> View.FOCUS_RIGHT;
+                    default -> 0;
+                };
+        View focused = overlay.findFocus();
+        if (direction == 0
+                || focused == null
+                || event.getAction() != KeyEvent.ACTION_DOWN
+                || !(overlay instanceof ViewGroup group)) {
+            return false;
+        }
+        View next = FocusFinder.getInstance().findNextFocus(group, focused, direction);
+        if (next != null) next.requestFocus(direction);
+        return true;
+    }
+
+    private static void bringBack(View overlay, @Nullable View was) {
+        if (!overlay.isShown() || overlay.hasFocus()) return;
+        if (was != null && contains(overlay, was) && was.isShown() && was.requestFocus()) return;
+        focusFirstControl(overlay, overlay);
+    }
+
+    private static Drawable ringFor(View view) {
+        float density = view.getResources().getDisplayMetrics().density;
+        float half = view.getHeight() / 2f;
+        boolean round = view.getWidth() == view.getHeight();
+        GradientDrawable ring = new GradientDrawable();
+        ring.setCornerRadius(round ? half : Math.min(half, RING_RADIUS_DP * density));
+        ring.setStroke(
+                Math.round(RING_WIDTH_DP * density),
+                SemanticColorUtils.getDefaultIconColor(view.getContext()));
+        return ring;
+    }
+
+    private static boolean contains(@Nullable View ancestor, @Nullable View view) {
+        if (ancestor == null || view == null) return false;
+        if (ancestor == view) return true;
+        for (ViewParent parent = view.getParent(); parent != null; parent = parent.getParent()) {
+            if (parent == ancestor) return true;
+        }
+        return false;
+    }
+}

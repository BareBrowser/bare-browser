@@ -0,0 +1,95 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.incognito.reauth;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+
+import org.junit.After;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+
+import org.chromium.base.test.BaseRobolectricTestRunner;
+import org.chromium.chrome.browser.preferences.ChromePreferenceKeys;
+import org.chromium.chrome.browser.preferences.ChromeSharedPreferences;
+
+/** Unit tests for {@link BareIncognitoLockPolicy}. */
+@RunWith(BaseRobolectricTestRunner.class)
+public class BareIncognitoLockPolicyUnitTest {
+    @After
+    public void tearDown() {
+        ChromeSharedPreferences.getInstance()
+                .removeKey(ChromePreferenceKeys.BARE_INCOGNITO_BIOMETRIC_ONLY);
+        ChromeSharedPreferences.getInstance()
+                .removeKey(ChromePreferenceKeys.BARE_INCOGNITO_WIPE_AFTER);
+        ChromeSharedPreferences.getInstance()
+                .removeKey(ChromePreferenceKeys.BARE_INCOGNITO_FAILED_ATTEMPTS);
+    }
+
+    @Test
+    public void testDefaultsAreTheStockLockAndNoWipe() {
+        assertFalse(BareIncognitoLockPolicy.isBiometricOnly());
+        assertEquals(0, BareIncognitoLockPolicy.getWipeAfter());
+    }
+
+    @Test
+    public void testNeverWipesWhenOff() {
+        for (int i = 0; i < 20; i++) {
+            assertFalse(BareIncognitoLockPolicy.recordFailure());
+        }
+        assertEquals(0, BareIncognitoLockPolicy.getFailures());
+    }
+
+    @Test
+    public void testWipesOnTheLastAllowedFailureAndStartsOver() {
+        BareIncognitoLockPolicy.setWipeAfter(3);
+        assertFalse(BareIncognitoLockPolicy.recordFailure());
+        assertFalse(BareIncognitoLockPolicy.recordFailure());
+        assertTrue(BareIncognitoLockPolicy.recordFailure());
+        // The count starts over after a wipe.
+        assertEquals(0, BareIncognitoLockPolicy.getFailures());
+        assertFalse(BareIncognitoLockPolicy.recordFailure());
+    }
+
+    @Test
+    public void testOneFailureWipesWhenSetToOne() {
+        BareIncognitoLockPolicy.setWipeAfter(1);
+        assertTrue(BareIncognitoLockPolicy.recordFailure());
+    }
+
+    @Test
+    public void testAGoodUnlockClearsTheCount() {
+        BareIncognitoLockPolicy.setWipeAfter(3);
+        BareIncognitoLockPolicy.recordFailure();
+        BareIncognitoLockPolicy.recordFailure();
+        BareIncognitoLockPolicy.resetFailures();
+        assertFalse(BareIncognitoLockPolicy.recordFailure());
+        assertEquals(1, BareIncognitoLockPolicy.getFailures());
+    }
+
+    @Test
+    public void testChangingTheChoiceClearsTheCount() {
+        BareIncognitoLockPolicy.setWipeAfter(5);
+        BareIncognitoLockPolicy.recordFailure();
+        BareIncognitoLockPolicy.setWipeAfter(3);
+        assertEquals(0, BareIncognitoLockPolicy.getFailures());
+    }
+
+    @Test
+    public void testAValueThatIsNotOfferedMeansNever() {
+        ChromeSharedPreferences.getInstance()
+                .writeInt(ChromePreferenceKeys.BARE_INCOGNITO_WIPE_AFTER, 2);
+        assertEquals(0, BareIncognitoLockPolicy.getWipeAfter());
+    }
+
+    @Test
+    public void testBiometricOnlyIsStored() {
+        BareIncognitoLockPolicy.setBiometricOnly(true);
+        assertTrue(BareIncognitoLockPolicy.isBiometricOnly());
+        BareIncognitoLockPolicy.setBiometricOnly(false);
+        assertFalse(BareIncognitoLockPolicy.isBiometricOnly());
+    }
+}

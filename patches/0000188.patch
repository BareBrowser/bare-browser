+    /** Bare's additions to the Incognito section: how it unlocks, wiping, and how it is entered. */
+    private void initBareIncognitoPreferences() {
+        ChromeSwitchPreference biometricOnly = findPreference(PREF_BARE_INCOGNITO_BIOMETRIC_ONLY);
+        if (biometricOnly != null) {
+            biometricOnly.setChecked(BareIncognitoLockPolicy.isBiometricOnly());
+            biometricOnly.setOnPreferenceChangeListener(
+                    (preference, newValue) -> {
+                        BareIncognitoLockPolicy.setBiometricOnly((boolean) newValue);
+                        return true;
+                    });
+        }
+        ListPreference wipe = findPreference(PREF_BARE_INCOGNITO_WIPE_AFTER);
+        if (wipe != null) {
+            wipe.setValue(String.valueOf(BareIncognitoLockPolicy.getWipeAfter()));
+            wipe.setOnPreferenceChangeListener(
+                    (preference, newValue) -> {
+                        BareIncognitoLockPolicy.setWipeAfter(Integer.parseInt((String) newValue));
+                        return true;
+                    });
+        }
+        bindIncognitoSwitch(
+                PREF_BARE_INCOGNITO_QUIET_ENTRY,
+                ChromePreferenceKeys.BARE_INCOGNITO_QUIET_ENTRY);
+        bindIncognitoSwitch(
+                PREF_BARE_INCOGNITO_HAPTIC, ChromePreferenceKeys.BARE_INCOGNITO_ENTRY_HAPTIC);
+    }
+
+    /** A switch kept in shared preferences that is on unless the user turned it off. */
+    private void bindIncognitoSwitch(String preferenceKey, String storedKey) {
+        ChromeSwitchPreference preference = findPreference(preferenceKey);
+        if (preference == null) return;
+        preference.setChecked(ChromeSharedPreferences.getInstance().readBoolean(storedKey, true));
+        preference.setOnPreferenceChangeListener(
+                (p, newValue) -> {
+                    ChromeSharedPreferences.getInstance().writeBoolean(storedKey, (boolean) newValue);
+                    return true;
+                });
+    }
 }

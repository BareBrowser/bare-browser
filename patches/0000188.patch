@@ -0,0 +1,79 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.incognito.reauth;
+
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.chrome.browser.preferences.ChromePreferenceKeys;
+import org.chromium.chrome.browser.preferences.ChromeSharedPreferences;
+
+/**
+ * What Bare adds to the Incognito lock: unlocking with fingerprint or face only, and wiping
+ * Incognito after a number of failed unlocks in a row.
+ *
+ * <p>A failure is a prompt that ended without unlocking and was not simply cancelled. Cancelling
+ * does not count, so putting the phone down in the middle of the prompt cannot wipe anything. The
+ * count survives a restart and is cleared by a good unlock.
+ */
+@NullMarked
+public final class BareIncognitoLockPolicy {
+    /** The numbers of failed unlocks the user can pick; 0 never wipes. */
+    public static final int[] WIPE_CHOICES = {0, 1, 3, 5};
+
+    private BareIncognitoLockPolicy() {}
+
+    public static boolean isBiometricOnly() {
+        return ChromeSharedPreferences.getInstance()
+                .readBoolean(ChromePreferenceKeys.BARE_INCOGNITO_BIOMETRIC_ONLY, false);
+    }
+
+    public static void setBiometricOnly(boolean biometricOnly) {
+        ChromeSharedPreferences.getInstance()
+                .writeBoolean(ChromePreferenceKeys.BARE_INCOGNITO_BIOMETRIC_ONLY, biometricOnly);
+    }
+
+    /** How many failed unlocks in a row wipe Incognito, or 0 for never. */
+    public static int getWipeAfter() {
+        int stored =
+                ChromeSharedPreferences.getInstance()
+                        .readInt(ChromePreferenceKeys.BARE_INCOGNITO_WIPE_AFTER, 0);
+        for (int choice : WIPE_CHOICES) {
+            if (choice == stored) return stored;
+        }
+        return 0;
+    }
+
+    public static void setWipeAfter(int attempts) {
+        ChromeSharedPreferences.getInstance()
+                .writeInt(ChromePreferenceKeys.BARE_INCOGNITO_WIPE_AFTER, attempts);
+        resetFailures();
+    }
+
+    static int getFailures() {
+        return ChromeSharedPreferences.getInstance()
+                .readInt(ChromePreferenceKeys.BARE_INCOGNITO_FAILED_ATTEMPTS, 0);
+    }
+
+    static void resetFailures() {
+        ChromeSharedPreferences.getInstance()
+                .removeKey(ChromePreferenceKeys.BARE_INCOGNITO_FAILED_ATTEMPTS);
+    }
+
+    /**
+     * Counts one failed unlock. Returns whether that was the last one allowed, in which case the
+     * count is cleared and Incognito is to be wiped.
+     */
+    static boolean recordFailure() {
+        int wipeAfter = getWipeAfter();
+        if (wipeAfter == 0) return false;
+        int failures = getFailures() + 1;
+        if (failures >= wipeAfter) {
+            resetFailures();
+            return true;
+        }
+        ChromeSharedPreferences.getInstance()
+                .writeInt(ChromePreferenceKeys.BARE_INCOGNITO_FAILED_ATTEMPTS, failures);
+        return false;
+    }
+}

Subject: [PATCH] Patch 0000162

---
 sandbox/policy/linux/landlock_gpu_policy_android.cc | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/sandbox/policy/linux/landlock_gpu_policy_android.cc b/sandbox/policy/linux/landlock_gpu_policy_android.cc
index 997a5b7819a..84302b0462c 100644
--- a/sandbox/policy/linux/landlock_gpu_policy_android.cc
+++ b/sandbox/policy/linux/landlock_gpu_policy_android.cc
@@ -120,7 +120,11 @@ bool ApplyLandlock(sandbox::mojom::Sandbox sandbox_type) {
       // TODO(crbug.com/462103953): tighten these broad rules once the Corsola
       // issue is resolved and we've confirmed the precise paths needed.
       "/system/vendor/lib", "/system/vendor/lib64", "/vendor/lib",
-      "/vendor/lib64"};
+      "/vendor/lib64",
+      // Android loads libmedia_jni.so from these the first time a page uses
+      // MediaDrm, after this policy is in place: lib64 in a 64-bit build, lib
+      // in a 32-bit one. Without them Widevine video cannot create a CDM.
+      "/system/lib", "/system/lib64"};
   uint64_t ro_access =
       LANDLOCK_ACCESS_FS_READ_FILE | LANDLOCK_ACCESS_FS_READ_DIR;
   if (!AddRulesToPolicy(ruleset_fd.get(), allowed_ro_paths, ro_access)) {

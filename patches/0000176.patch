@@ -0,0 +1,51 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.services.gcm;
+
+import android.content.Context;
+
+import org.chromium.base.ContextUtils;
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.components.gcm_driver.instance_id.InstanceIDWithSubtype;
+
+import java.io.IOException;
+
+/**
+ * Makes web push subscriptions with the distributor the user picked. With none picked it leaves
+ * the call to Google Play services as before.
+ *
+ * <p>With a distributor the token Chromium keeps is the full address the site's server posts to,
+ * and Google is not asked for anything.
+ */
+@NullMarked
+public class BarePushSubscriber implements InstanceIDWithSubtype.TokenBroker {
+    /** Web push app ids start with this; other users of Instance ID are left alone. */
+    private static final String PUSH_APP_ID_PREFIX = "wp:";
+
+    @Override
+    public @Nullable String getToken(String subtype, String authorizedEntity, String scope)
+            throws IOException {
+        if (!subtype.startsWith(PUSH_APP_ID_PREFIX)) return null;
+        String distributor = BarePushDistributor.getDistributorPackage();
+        if (distributor.isEmpty()) return null;
+        Context context = ContextUtils.getApplicationContext();
+        return BarePushDistributor.register(context, distributor, subtype, authorizedEntity);
+    }
+
+    @Override
+    public boolean deleteToken(String subtype, String authorizedEntity, String scope)
+            throws IOException {
+        if (!subtype.startsWith(PUSH_APP_ID_PREFIX)) return false;
+        if (BarePushDistributor.findByApp(subtype, authorizedEntity) == null) return false;
+        // Whatever the distributor is now, this subscription was made through one.
+        String distributor = BarePushDistributor.getDistributorPackage();
+        Context context = ContextUtils.getApplicationContext();
+        if (!distributor.isEmpty()) {
+            BarePushDistributor.unregister(context::sendBroadcast, distributor, subtype, authorizedEntity);
+        }
+        return true;
+    }
+}

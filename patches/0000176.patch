diff --git a/chrome/android/junit/src/org/chromium/chrome/browser/services/gcm/BarePushDistributorUnitTest.java b/chrome/android/junit/src/org/chromium/chrome/browser/services/gcm/BarePushDistributorUnitTest.java
new file mode 100644
index 00000000000..40e20e02ea5
--- /dev/null
+++ b/chrome/android/junit/src/org/chromium/chrome/browser/services/gcm/BarePushDistributorUnitTest.java
@@ -0,0 +1,178 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.services.gcm;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertNotEquals;
+import static org.junit.Assert.assertNotNull;
+import static org.junit.Assert.assertNull;
+import static org.junit.Assert.assertTrue;
+import static org.junit.Assert.fail;
+
+import android.content.Intent;
+
+import org.junit.After;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+
+import org.chromium.base.test.BaseRobolectricTestRunner;
+import org.chromium.chrome.browser.preferences.ChromePreferenceKeys;
+import org.chromium.chrome.browser.preferences.ChromeSharedPreferences;
+import org.chromium.components.gcm_driver.GCMMessage;
+
+import java.io.IOException;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.List;
+
+/** Unit tests for {@link BarePushDistributor}. */
+@RunWith(BaseRobolectricTestRunner.class)
+public class BarePushDistributorUnitTest {
+    private static final String DIST = "dist.example";
+    private static final String OWN = "org.barebrowser";
+
+    @After
+    public void tearDown() {
+        ChromeSharedPreferences.getInstance().removeKey(ChromePreferenceKeys.BARE_PUSH_DISTRIBUTOR);
+        ChromeSharedPreferences.getInstance()
+                .removeKey(ChromePreferenceKeys.BARE_PUSH_SUBSCRIPTIONS);
+    }
+
+    /** A distributor that answers a registration with an address built from the token. */
+    private static BarePushDistributor.Sender answering(List<Intent> seen) {
+        return intent -> {
+            seen.add(intent);
+            if (BarePushDistributor.ACTION_REGISTER.equals(intent.getAction())) {
+                String token = intent.getStringExtra(BarePushDistributor.EXTRA_TOKEN);
+                new Thread(
+                                () ->
+                                        BarePushDistributor.onEndpoint(
+                                                token, "https://push.example/" + token))
+                        .start();
+            }
+        };
+    }
+
+    @Test
+    public void testNothingChosenIsNoDistributor() {
+        assertEquals("", BarePushDistributor.getDistributorPackage());
+        BarePushDistributor.setDistributorPackage(DIST);
+        assertEquals(DIST, BarePushDistributor.getDistributorPackage());
+        BarePushDistributor.setDistributorPackage("");
+        assertEquals("", BarePushDistributor.getDistributorPackage());
+    }
+
+    @Test
+    public void testTokensAreLongAndDifferent() {
+        String a = BarePushDistributor.newToken();
+        String b = BarePushDistributor.newToken();
+        assertEquals(32, a.length());
+        assertNotEquals(a, b);
+    }
+
+    @Test
+    public void testRegisteringGivesTheEndpointAndRemembersTheToken() throws Exception {
+        List<Intent> seen = new ArrayList<>();
+        String endpoint =
+                BarePushDistributor.register(answering(seen), OWN, DIST, "wp:app1", "SENDERKEY", 5000);
+
+        assertEquals(1, seen.size());
+        Intent sent = seen.get(0);
+        assertEquals(BarePushDistributor.ACTION_REGISTER, sent.getAction());
+        assertEquals(DIST, sent.getPackage());
+        assertEquals(OWN, sent.getStringExtra(BarePushDistributor.EXTRA_APPLICATION));
+        assertEquals("SENDERKEY", sent.getStringExtra(BarePushDistributor.EXTRA_VAPID));
+
+        String token = sent.getStringExtra(BarePushDistributor.EXTRA_TOKEN);
+        assertEquals("https://push.example/" + token, endpoint);
+        BarePushDistributor.Subscription stored = BarePushDistributor.findByToken(token);
+        assertNotNull(stored);
+        assertEquals("wp:app1", stored.appId);
+        assertEquals("SENDERKEY", stored.senderId);
+    }
+
+    @Test
+    public void testNoAnswerFailsAndForgetsTheToken() {
+        List<Intent> seen = new ArrayList<>();
+        try {
+            BarePushDistributor.register(seen::add, OWN, DIST, "wp:app1", "SENDERKEY", 100);
+            fail("expected a failure");
+        } catch (IOException expected) {
+            assertEquals("SERVICE_NOT_AVAILABLE", expected.getMessage());
+        }
+        assertNull(BarePushDistributor.findByApp("wp:app1", "SENDERKEY"));
+    }
+
+    @Test
+    public void testARefusalFails() {
+        BarePushDistributor.Sender refusing =
+                intent -> {
+                    String token = intent.getStringExtra(BarePushDistributor.EXTRA_TOKEN);
+                    new Thread(() -> BarePushDistributor.onRegistrationFailed(token)).start();
+                };
+        try {
+            BarePushDistributor.register(refusing, OWN, DIST, "wp:app1", "SENDERKEY", 5000);
+            fail("expected a failure");
+        } catch (IOException expected) {
+            assertEquals("REGISTRATION_FAILED", expected.getMessage());
+        }
+        assertNull(BarePushDistributor.findByApp("wp:app1", "SENDERKEY"));
+    }
+
+    @Test
+    public void testSubscribingAgainReplacesTheOldTokenAndTellsTheDistributor() throws Exception {
+        List<Intent> seen = new ArrayList<>();
+        BarePushDistributor.register(answering(seen), OWN, DIST, "wp:app1", "KEY", 5000);
+        String first = seen.get(0).getStringExtra(BarePushDistributor.EXTRA_TOKEN);
+
+        BarePushDistributor.register(answering(seen), OWN, DIST, "wp:app1", "KEY", 5000);
+        String second = seen.get(1).getStringExtra(BarePushDistributor.EXTRA_TOKEN);
+
+        assertNotEquals(first, second);
+        assertNull(BarePushDistributor.findByToken(first));
+        assertNotNull(BarePushDistributor.findByToken(second));
+        Intent drop = seen.get(2);
+        assertEquals(BarePushDistributor.ACTION_UNREGISTER, drop.getAction());
+        assertEquals(first, drop.getStringExtra(BarePushDistributor.EXTRA_TOKEN));
+    }
+
+    @Test
+    public void testUnregisteringForgetsTheSubscription() throws Exception {
+        List<Intent> seen = new ArrayList<>();
+        BarePushDistributor.register(answering(seen), OWN, DIST, "wp:app1", "KEY", 5000);
+        BarePushDistributor.unregister(seen::add, DIST, "wp:app1", "KEY");
+        assertNull(BarePushDistributor.findByApp("wp:app1", "KEY"));
+        assertEquals(BarePushDistributor.ACTION_UNREGISTER, seen.get(seen.size() - 1).getAction());
+    }
+
+    @Test
+    public void testAnUnknownTokenFindsNothing() {
+        assertNull(BarePushDistributor.findByToken("not-a-token"));
+    }
+
+    @Test
+    public void testAMessageIsBuiltTheWayWebPushDecryptionExpectsIt() throws Exception {
+        List<Intent> seen = new ArrayList<>();
+        BarePushDistributor.register(answering(seen), OWN, DIST, "wp:app1", "KEY", 5000);
+        String token = seen.get(0).getStringExtra(BarePushDistributor.EXTRA_TOKEN);
+        BarePushDistributor.Subscription subscription = BarePushDistributor.findByToken(token);
+        assertNotNull(subscription);
+
+        byte[] body = new byte[] {1, 2, 3, 4};
+        GCMMessage message = BarePushDistributor.buildMessage(subscription, body);
+        assertEquals("wp:app1", message.getAppId());
+        assertEquals("KEY", message.getSenderId());
+        assertTrue(Arrays.equals(body, message.getRawData()));
+        assertTrue(
+                Arrays.asList(message.getDataKeysAndValuesArray())
+                        .containsAll(Arrays.asList("content-encoding", "aes128gcm")));
+    }
+
+    @Test
+    public void testAMessageWithoutARegistrationIsNotAcceptedBecauseItsTokenIsUnknown() {
+        assertFalse(BarePushDistributor.findByToken("0123456789abcdef0123456789abcdef") != null);
+    }
+}

diff --git a/chrome/android/java/src/org/chromium/chrome/browser/services/gcm/BarePushDistributor.java b/chrome/android/java/src/org/chromium/chrome/browser/services/gcm/BarePushDistributor.java
new file mode 100644
index 00000000000..687cefff95a
--- /dev/null
+++ b/chrome/android/java/src/org/chromium/chrome/browser/services/gcm/BarePushDistributor.java
@@ -0,0 +1,336 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.services.gcm;
+
+import android.content.ComponentName;
+import android.content.Context;
+import android.content.Intent;
+import android.content.pm.PackageManager;
+import android.content.pm.ResolveInfo;
+import android.os.Bundle;
+
+import org.json.JSONArray;
+import org.json.JSONException;
+import org.json.JSONObject;
+
+import org.chromium.base.ContextUtils;
+import org.chromium.base.Log;
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.chrome.browser.preferences.ChromePreferenceKeys;
+import org.chromium.chrome.browser.preferences.ChromeSharedPreferences;
+import org.chromium.components.gcm_driver.GCMMessage;
+
+import java.io.IOException;
+import java.security.SecureRandom;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.concurrent.CountDownLatch;
+import java.util.concurrent.TimeUnit;
+
+/**
+ * Delivers web push through an app on the phone that the user chose, instead of through Google.
+ *
+ * <p>A site that asks to send push notifications needs an address its server can post to, and a
+ * way for what is posted to reach the browser. Chromium gets both from Google's messaging service,
+ * which this build has no receiver for. A <em>distributor</em> is an app that supplies both
+ * another way: it hands out an address, receives what is posted to it, and passes it to Bare.
+ *
+ * <p>The messages between Bare and the distributor are broadcasts, each addressed to one package:
+ *
+ * <ul>
+ *   <li>Bare to the distributor, {@code org.barebrowser.push.REGISTER}: extras {@code token} (an
+ *       unguessable string naming this subscription), {@code application} (Bare's package) and
+ *       {@code vapid} (the site's application server key, if it gave one). The distributor
+ *       answers with NEW_ENDPOINT or REGISTRATION_FAILED.
+ *   <li>Distributor to Bare, {@code org.barebrowser.push.NEW_ENDPOINT}: {@code token} and {@code
+ *       endpoint}, the address the site's server posts to.
+ *   <li>Distributor to Bare, {@code org.barebrowser.push.MESSAGE}: {@code token} and {@code
+ *       message}, the bytes that were posted, unchanged. They are the encrypted web push body;
+ *       Bare decrypts them with the keys it made for this subscription.
+ *   <li>{@code REGISTRATION_FAILED} (with {@code token}), {@code UNREGISTER} and {@code
+ *       UNREGISTERED} (with {@code token}) are as their names say.
+ * </ul>
+ *
+ * <p>The token is the only thing that ties a message to a subscription, so it is 128 random bits
+ * and is only ever sent to the distributor the user chose. A message for a token Bare does not
+ * know is dropped. A message that is not validly encrypted for the subscription is dropped by the
+ * decryption, so a forged one cannot show a notification.
+ */
+@NullMarked
+public final class BarePushDistributor {
+    private static final String TAG = "BarePush";
+
+    public static final String ACTION_REGISTER = "org.barebrowser.push.REGISTER";
+    public static final String ACTION_UNREGISTER = "org.barebrowser.push.UNREGISTER";
+    public static final String ACTION_NEW_ENDPOINT = "org.barebrowser.push.NEW_ENDPOINT";
+    public static final String ACTION_MESSAGE = "org.barebrowser.push.MESSAGE";
+    public static final String ACTION_REGISTRATION_FAILED = "org.barebrowser.push.REGISTRATION_FAILED";
+    public static final String ACTION_UNREGISTERED = "org.barebrowser.push.UNREGISTERED";
+
+    public static final String EXTRA_TOKEN = "token";
+    public static final String EXTRA_APPLICATION = "application";
+    public static final String EXTRA_VAPID = "vapid";
+    public static final String EXTRA_ENDPOINT = "endpoint";
+    public static final String EXTRA_MESSAGE = "message";
+
+    /** How long a registration waits for the distributor to answer. */
+    static final long REGISTER_TIMEOUT_MS = 10000;
+
+    /** One subscription made through a distributor. */
+    public static final class Subscription {
+        public final String token;
+        public final String appId;
+        public final String senderId;
+
+        Subscription(String token, String appId, String senderId) {
+            this.token = token;
+            this.appId = appId;
+            this.senderId = senderId;
+        }
+    }
+
+    /** Sends one broadcast to the distributor. Replaced in tests. */
+    interface Sender {
+        void send(Intent intent);
+    }
+
+    /** A registration waiting for the distributor's answer. */
+    private static final class Pending {
+        final CountDownLatch latch = new CountDownLatch(1);
+        volatile @Nullable String endpoint;
+    }
+
+    private static final Map<String, Pending> sPending = new HashMap<>();
+    private static final SecureRandom sRandom = new SecureRandom();
+
+    private BarePushDistributor() {}
+
+    // The choice.
+
+    /** The package the user chose to deliver push through, or empty for none. */
+    public static String getDistributorPackage() {
+        return ChromeSharedPreferences.getInstance()
+                .readString(ChromePreferenceKeys.BARE_PUSH_DISTRIBUTOR, "");
+    }
+
+    public static void setDistributorPackage(String packageName) {
+        if (packageName.isEmpty()) {
+            ChromeSharedPreferences.getInstance()
+                    .removeKey(ChromePreferenceKeys.BARE_PUSH_DISTRIBUTOR);
+        } else {
+            ChromeSharedPreferences.getInstance()
+                    .writeString(ChromePreferenceKeys.BARE_PUSH_DISTRIBUTOR, packageName);
+        }
+    }
+
+    /** The installed apps that handle registration, other than this browser. */
+    public static List<ResolveInfo> findDistributors(Context context) {
+        PackageManager pm = context.getPackageManager();
+        List<ResolveInfo> found = new ArrayList<>();
+        for (ResolveInfo info : pm.queryBroadcastReceivers(new Intent(ACTION_REGISTER), 0)) {
+            if (info.activityInfo == null) continue;
+            if (context.getPackageName().equals(info.activityInfo.packageName)) continue;
+            found.add(info);
+        }
+        return found;
+    }
+
+    // The subscriptions.
+
+    private static List<Subscription> readAll() {
+        List<Subscription> all = new ArrayList<>();
+        String stored =
+                ChromeSharedPreferences.getInstance()
+                        .readString(ChromePreferenceKeys.BARE_PUSH_SUBSCRIPTIONS, "");
+        if (stored.isEmpty()) return all;
+        try {
+            JSONArray array = new JSONArray(stored);
+            for (int i = 0; i < array.length(); i++) {
+                JSONObject entry = array.getJSONObject(i);
+                all.add(
+                        new Subscription(
+                                entry.getString("token"),
+                                entry.getString("appId"),
+                                entry.getString("senderId")));
+            }
+        } catch (JSONException e) {
+            Log.w(TAG, "Stored push subscriptions could not be read");
+            all.clear();
+        }
+        return all;
+    }
+
+    private static void writeAll(List<Subscription> all) {
+        JSONArray array = new JSONArray();
+        try {
+            for (Subscription s : all) {
+                array.put(
+                        new JSONObject()
+                                .put("token", s.token)
+                                .put("appId", s.appId)
+                                .put("senderId", s.senderId));
+            }
+        } catch (JSONException e) {
+            throw new IllegalStateException(e);
+        }
+        if (all.isEmpty()) {
+            ChromeSharedPreferences.getInstance()
+                    .removeKey(ChromePreferenceKeys.BARE_PUSH_SUBSCRIPTIONS);
+        } else {
+            ChromeSharedPreferences.getInstance()
+                    .writeString(ChromePreferenceKeys.BARE_PUSH_SUBSCRIPTIONS, array.toString());
+        }
+    }
+
+    static synchronized @Nullable Subscription findByToken(String token) {
+        for (Subscription s : readAll()) {
+            if (s.token.equals(token)) return s;
+        }
+        return null;
+    }
+
+    static synchronized @Nullable Subscription findByApp(String appId, String senderId) {
+        for (Subscription s : readAll()) {
+            if (s.appId.equals(appId) && s.senderId.equals(senderId)) return s;
+        }
+        return null;
+    }
+
+    private static synchronized void put(Subscription subscription) {
+        List<Subscription> all = readAll();
+        all.removeIf(s -> s.appId.equals(subscription.appId) && s.senderId.equals(subscription.senderId));
+        all.add(subscription);
+        writeAll(all);
+    }
+
+    private static synchronized void remove(String token) {
+        List<Subscription> all = readAll();
+        if (all.removeIf(s -> s.token.equals(token))) writeAll(all);
+    }
+
+    /** 128 random bits as hex. */
+    static String newToken() {
+        byte[] bytes = new byte[16];
+        sRandom.nextBytes(bytes);
+        StringBuilder out = new StringBuilder();
+        for (byte b : bytes) out.append(String.format("%02x", b));
+        return out.toString();
+    }
+
+    // Registering.
+
+    /** Registers with the chosen distributor, on a background thread. Returns the endpoint. */
+    static String register(
+            Context context, String distributorPackage, String appId, String senderId)
+            throws IOException {
+        return register(
+                intent -> context.sendBroadcast(intent),
+                context.getPackageName(),
+                distributorPackage,
+                appId,
+                senderId,
+                REGISTER_TIMEOUT_MS);
+    }
+
+    static String register(
+            Sender sender,
+            String ownPackage,
+            String distributorPackage,
+            String appId,
+            String senderId,
+            long timeoutMs)
+            throws IOException {
+        // The distributor is addressed by package, and a distributor that has not been opened since
+        // it was installed or force stopped still has to hear this, hence the stopped-packages flag.
+        // A new registration for the same site replaces the old one, so that the old token stops
+        // being accepted.
+        @Nullable Subscription previous = findByApp(appId, senderId);
+        String token = newToken();
+        Pending pending = new Pending();
+        synchronized (sPending) {
+            sPending.put(token, pending);
+        }
+        put(new Subscription(token, appId, senderId));
+        try {
+            Intent intent = new Intent(ACTION_REGISTER).setPackage(distributorPackage)
+                        .addFlags(Intent.FLAG_INCLUDE_STOPPED_PACKAGES);
+            intent.putExtra(EXTRA_TOKEN, token);
+            intent.putExtra(EXTRA_APPLICATION, ownPackage);
+            intent.putExtra(EXTRA_VAPID, senderId);
+            sender.send(intent);
+            boolean answered = pending.latch.await(timeoutMs, TimeUnit.MILLISECONDS);
+            String endpoint = pending.endpoint;
+            if (!answered || endpoint == null || endpoint.isEmpty()) {
+                remove(token);
+                throw new IOException(answered ? "REGISTRATION_FAILED" : "SERVICE_NOT_AVAILABLE");
+            }
+            if (previous != null) {
+                Intent drop = new Intent(ACTION_UNREGISTER).setPackage(distributorPackage)
+                        .addFlags(Intent.FLAG_INCLUDE_STOPPED_PACKAGES);
+                drop.putExtra(EXTRA_TOKEN, previous.token);
+                sender.send(drop);
+            }
+            return endpoint;
+        } catch (InterruptedException e) {
+            remove(token);
+            Thread.currentThread().interrupt();
+            throw new IOException("INTERRUPTED");
+        } finally {
+            synchronized (sPending) {
+                sPending.remove(token);
+            }
+        }
+    }
+
+    /** Tells the distributor to stop, and forgets the subscription. */
+    static void unregister(
+            Sender sender, String distributorPackage, String appId, String senderId) {
+        @Nullable Subscription subscription = findByApp(appId, senderId);
+        if (subscription == null) return;
+        Intent intent = new Intent(ACTION_UNREGISTER).setPackage(distributorPackage)
+                        .addFlags(Intent.FLAG_INCLUDE_STOPPED_PACKAGES);
+        intent.putExtra(EXTRA_TOKEN, subscription.token);
+        sender.send(intent);
+        remove(subscription.token);
+    }
+
+    // What the distributor says back.
+
+    static void onEndpoint(String token, @Nullable String endpoint) {
+        Pending pending;
+        synchronized (sPending) {
+            pending = sPending.get(token);
+        }
+        if (pending == null) return;
+        pending.endpoint = endpoint;
+        pending.latch.countDown();
+    }
+
+    static void onRegistrationFailed(String token) {
+        onEndpoint(token, null);
+    }
+
+    /**
+     * Builds the message the browser's push machinery expects from the bytes a distributor handed
+     * over. The content coding is the one web push uses, so the same decryption that handles a
+     * message from Google handles this one.
+     */
+    static GCMMessage buildMessage(Subscription subscription, byte[] body) {
+        Bundle extras = new Bundle();
+        extras.putString("subtype", subscription.appId);
+        extras.putByteArray("rawData", body);
+        extras.putString("content-encoding", "aes128gcm");
+        return new GCMMessage(subscription.senderId, extras);
+    }
+
+    /** The explicit address of this browser's receiver, for a distributor's replies. */
+    public static ComponentName receiverComponent() {
+        return new ComponentName(
+                ContextUtils.getApplicationContext(), BarePushReceiver.class);
+    }
+}

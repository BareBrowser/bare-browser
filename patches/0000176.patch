+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.services.gcm;
+
+import android.content.BroadcastReceiver;
+import android.content.Context;
+import android.content.Intent;
+
+import org.chromium.base.Log;
+import org.chromium.base.ThreadUtils;
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.components.gcm_driver.GCMMessage;
+
+/** Receives what a push distributor sends: its answers to a registration, and the messages. */
+@NullMarked
+public class BarePushReceiver extends BroadcastReceiver {
+    private static final String TAG = "BarePush";
+
+    @Override
+    public void onReceive(Context context, @Nullable Intent intent) {
+        if (intent == null) return;
+        String action = intent.getAction();
+        String token = intent.getStringExtra(BarePushDistributor.EXTRA_TOKEN);
+        if (action == null || token == null) return;
+
+        switch (action) {
+            case BarePushDistributor.ACTION_NEW_ENDPOINT:
+                BarePushDistributor.onEndpoint(
+                        token, intent.getStringExtra(BarePushDistributor.EXTRA_ENDPOINT));
+                break;
+            case BarePushDistributor.ACTION_REGISTRATION_FAILED:
+                BarePushDistributor.onRegistrationFailed(token);
+                break;
+            case BarePushDistributor.ACTION_MESSAGE:
+                byte[] body = intent.getByteArrayExtra(BarePushDistributor.EXTRA_MESSAGE);
+                if (body == null || body.length == 0) return;
+                BarePushDistributor.Subscription subscription =
+                        BarePushDistributor.findByToken(token);
+                if (subscription == null) {
+                    Log.w(TAG, "Dropped a message for a token this browser does not know");
+                    return;
+                }
+                GCMMessage message = BarePushDistributor.buildMessage(subscription, body);
+                ThreadUtils.postOnUiThread(
+                        () -> ChromeGcmListenerServiceImpl.scheduleOrDispatchMessageToDriver(message));
+                break;
+            default:
+                break;
+        }
+    }
+}

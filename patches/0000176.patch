@@ -0,0 +1,93 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.bare.settings;
+
+import android.content.Context;
+import android.content.pm.PackageManager;
+import android.content.pm.ResolveInfo;
+import android.os.Bundle;
+
+import androidx.preference.ListPreference;
+
+import org.chromium.base.supplier.MonotonicObservableSupplier;
+import org.chromium.base.supplier.ObservableSuppliers;
+import org.chromium.base.supplier.SettableMonotonicObservableSupplier;
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.chrome.R;
+import org.chromium.chrome.browser.services.gcm.BarePushDistributor;
+import org.chromium.chrome.browser.settings.ChromeBaseSettingsFragment;
+import org.chromium.components.browser_ui.settings.SettingsUtils;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/** Settings for where web push notifications come from. */
+@NullMarked
+public class BarePushSettingsFragment extends ChromeBaseSettingsFragment {
+    static final String PREF_DISTRIBUTOR = "bare_push_distributor";
+
+    private final SettableMonotonicObservableSupplier<String> mPageTitle =
+            ObservableSuppliers.createMonotonic();
+
+    @Override
+    public void onCreatePreferences(@Nullable Bundle savedInstanceState, @Nullable String rootKey) {
+        mPageTitle.set(getTitle(getContext()));
+        SettingsUtils.addPreferencesFromResource(this, R.xml.bare_push_preferences);
+
+        ListPreference distributor = findPreference(PREF_DISTRIBUTOR);
+        assert distributor != null;
+        distributor.setPersistent(false);
+
+        Context context = requireContext();
+        PackageManager pm = context.getPackageManager();
+        List<CharSequence> names = new ArrayList<>();
+        List<CharSequence> packages = new ArrayList<>();
+        names.add(getString(R.string.bare_push_distributor_none));
+        packages.add("");
+        for (ResolveInfo info : BarePushDistributor.findDistributors(context)) {
+            CharSequence label = info.loadLabel(pm);
+            names.add(label == null ? info.activityInfo.packageName : label);
+            packages.add(info.activityInfo.packageName);
+        }
+        distributor.setEntries(names.toArray(new CharSequence[0]));
+        distributor.setEntryValues(packages.toArray(new CharSequence[0]));
+
+        // An app that has since been removed must not stay chosen.
+        String chosen = BarePushDistributor.getDistributorPackage();
+        if (!packages.contains(chosen)) {
+            chosen = "";
+            BarePushDistributor.setDistributorPackage("");
+        }
+        distributor.setValue(chosen);
+        distributor.setSummary(distributor.getEntry());
+        distributor.setOnPreferenceChangeListener(
+                (preference, newValue) -> {
+                    BarePushDistributor.setDistributorPackage((String) newValue);
+                    int index = packages.indexOf(newValue);
+                    preference.setSummary(index < 0 ? names.get(0) : names.get(index));
+                    return true;
+                });
+    }
+
+    @Override
+    public MonotonicObservableSupplier<String> getPageTitle() {
+        return mPageTitle;
+    }
+
+    public static String getTitle(Context context) {
+        return context.getString(R.string.bare_push_settings_title);
+    }
+
+    @Override
+    public @AnimationType int getAnimationType() {
+        return AnimationType.PROPERTY;
+    }
+
+    @Override
+    public @Nullable String getMainMenuKey() {
+        return "bare_push";
+    }
+}

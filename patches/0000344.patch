diff --git a/chrome/browser/android/bare_canvas_block.cc b/chrome/browser/android/bare_canvas_block.cc
new file mode 100644
index 00000000000..ecdb29e3d56
--- /dev/null
+++ b/chrome/browser/android/bare_canvas_block.cc
@@ -0,0 +1,234 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/android/bare_canvas_block.h"
+
+#include <memory>
+#include <set>
+#include <string>
+#include <vector>
+
+#include "base/android/jni_android.h"
+#include "base/android/jni_array.h"
+#include "base/android/jni_string.h"
+#include "base/android/scoped_java_ref.h"
+#include "base/supports_user_data.h"
+#include "base/values.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/common/pref_names.h"
+#include "components/prefs/pref_service.h"
+#include "components/prefs/scoped_user_pref_update.h"
+#include "content/public/browser/browser_context.h"
+#include "content/public/browser/page.h"
+#include "content/public/browser/page_user_data.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/web_contents.h"
+#include "net/base/schemeful_site.h"
+#include "url/origin.h"
+
+// Must come after all headers that specialize FromJniType() / ToJniType().
+#include "chrome/android/chrome_jni_headers/BareCanvasBlockBridge_jni.h"
+
+namespace {
+
+using base::android::JavaRef;
+
+// Only its address is used, as the key the incognito list is stored under.
+const int kIncognitoSitesKey = 0;
+
+// The sites allowed in an incognito profile. Kept on the profile, in memory
+// only: it is never written anywhere and goes when the profile does. An
+// incognito profile does not read or change the regular profile's list.
+struct IncognitoSites : public base::SupportsUserData::Data {
+  std::set<std::string> sites;
+};
+
+std::set<std::string>* IncognitoSet(Profile* profile, bool create) {
+  auto* data =
+      static_cast<IncognitoSites*>(profile->GetUserData(&kIncognitoSitesKey));
+  if (!data && create) {
+    auto owned = std::make_unique<IncognitoSites>();
+    data = owned.get();
+    profile->SetUserData(&kIncognitoSitesKey, std::move(owned));
+  }
+  return data ? &data->sites : nullptr;
+}
+
+// The name a site is listed under, or empty for an origin with no site.
+std::string SiteOf(const url::Origin& origin) {
+  if (origin.opaque()) {
+    return std::string();
+  }
+  return net::SchemefulSite(origin).Serialize();
+}
+
+bool IsAllowed(Profile* profile, const std::string& site) {
+  if (site.empty()) {
+    return false;
+  }
+  if (profile->IsOffTheRecord()) {
+    const std::set<std::string>* sites = IncognitoSet(profile, false);
+    return sites && sites->contains(site);
+  }
+  for (const base::Value& value :
+       profile->GetPrefs()->GetList(prefs::kBareCanvasBlockAllowedSites)) {
+    if (value.is_string() && value.GetString() == site) {
+      return true;
+    }
+  }
+  return false;
+}
+
+void SetAllowed(Profile* profile, const std::string& site, bool allowed) {
+  if (site.empty() || IsAllowed(profile, site) == allowed) {
+    return;
+  }
+  if (profile->IsOffTheRecord()) {
+    std::set<std::string>* sites = IncognitoSet(profile, true);
+    if (allowed) {
+      sites->insert(site);
+    } else {
+      sites->erase(site);
+    }
+    return;
+  }
+  ScopedListPrefUpdate update(profile->GetPrefs(),
+                              prefs::kBareCanvasBlockAllowedSites);
+  if (allowed) {
+    update->Append(site);
+  } else {
+    update->EraseValue(base::Value(site));
+  }
+}
+
+// Present on a page once a canvas read has been blocked on it. It goes with
+// the page, so a reload or a new page starts without it.
+class ReadBlockedMark : public content::PageUserData<ReadBlockedMark> {
+ public:
+  ~ReadBlockedMark() override = default;
+
+ private:
+  explicit ReadBlockedMark(content::Page& page)
+      : content::PageUserData<ReadBlockedMark>(page) {}
+
+  friend content::PageUserData<ReadBlockedMark>;
+  PAGE_USER_DATA_KEY_DECL();
+};
+
+PAGE_USER_DATA_KEY_IMPL(ReadBlockedMark);
+
+Profile* ProfileOf(content::WebContents* web_contents) {
+  return web_contents
+             ? Profile::FromBrowserContext(web_contents->GetBrowserContext())
+             : nullptr;
+}
+
+std::string SiteOfPage(content::WebContents* web_contents) {
+  return SiteOf(web_contents->GetPrimaryMainFrame()->GetLastCommittedOrigin());
+}
+
+}  // namespace
+
+namespace bare_canvas_block {
+
+bool ShouldBlock(content::BrowserContext* browser_context,
+                 const url::Origin& top_level_origin) {
+  Profile* profile = Profile::FromBrowserContext(browser_context);
+  if (!profile ||
+      !profile->GetPrefs()->GetBoolean(prefs::kBareCanvasBlockEnabled)) {
+    return false;
+  }
+  return !IsAllowed(profile, SiteOf(top_level_origin));
+}
+
+void NoteReadBlocked(content::RenderFrameHost* render_frame_host) {
+  ReadBlockedMark::GetOrCreateForPage(
+      render_frame_host->GetOutermostMainFrame()->GetPage());
+}
+
+}  // namespace bare_canvas_block
+
+static jboolean JNI_BareCanvasBlockBridge_IsEnabled(
+    JNIEnv* env,
+    const JavaRef<jobject>& jprofile) {
+  Profile* profile = Profile::FromJavaObject(jprofile);
+  return profile &&
+         profile->GetPrefs()->GetBoolean(prefs::kBareCanvasBlockEnabled);
+}
+
+static void JNI_BareCanvasBlockBridge_SetEnabled(
+    JNIEnv* env,
+    const JavaRef<jobject>& jprofile,
+    jboolean enabled) {
+  if (Profile* profile = Profile::FromJavaObject(jprofile)) {
+    profile->GetPrefs()->SetBoolean(prefs::kBareCanvasBlockEnabled, enabled);
+  }
+}
+
+// Whether a canvas read has been blocked on the page the tab shows.
+static jboolean JNI_BareCanvasBlockBridge_WasReadBlocked(
+    JNIEnv* env,
+    const JavaRef<jobject>& jweb_contents) {
+  content::WebContents* web_contents =
+      content::WebContents::FromJavaWebContents(jweb_contents);
+  return web_contents &&
+         ReadBlockedMark::GetForPage(web_contents->GetPrimaryPage());
+}
+
+// Whether the site of the page the tab shows is on the allowed list.
+static jboolean JNI_BareCanvasBlockBridge_IsPageSiteAllowed(
+    JNIEnv* env,
+    const JavaRef<jobject>& jweb_contents) {
+  content::WebContents* web_contents =
+      content::WebContents::FromJavaWebContents(jweb_contents);
+  Profile* profile = ProfileOf(web_contents);
+  return profile && IsAllowed(profile, SiteOfPage(web_contents));
+}
+
+// Puts the site of the page the tab shows on the allowed list, or takes it
+// off. It applies to pages loaded afterwards; the caller reloads.
+static void JNI_BareCanvasBlockBridge_SetPageSiteAllowed(
+    JNIEnv* env,
+    const JavaRef<jobject>& jweb_contents,
+    jboolean allowed) {
+  content::WebContents* web_contents =
+      content::WebContents::FromJavaWebContents(jweb_contents);
+  if (Profile* profile = ProfileOf(web_contents)) {
+    SetAllowed(profile, SiteOfPage(web_contents), allowed);
+  }
+}
+
+static std::vector<std::string> JNI_BareCanvasBlockBridge_GetAllowedSites(
+    JNIEnv* env,
+    const JavaRef<jobject>& jprofile) {
+  std::vector<std::string> sites;
+  Profile* profile = Profile::FromJavaObject(jprofile);
+  if (!profile) {
+    return sites;
+  }
+  if (profile->IsOffTheRecord()) {
+    if (const std::set<std::string>* set = IncognitoSet(profile, false)) {
+      sites.assign(set->begin(), set->end());
+    }
+    return sites;
+  }
+  for (const base::Value& value :
+       profile->GetPrefs()->GetList(prefs::kBareCanvasBlockAllowedSites)) {
+    if (value.is_string()) {
+      sites.push_back(value.GetString());
+    }
+  }
+  return sites;
+}
+
+static void JNI_BareCanvasBlockBridge_RemoveAllowedSite(
+    JNIEnv* env,
+    const JavaRef<jobject>& jprofile,
+    std::string site) {
+  if (Profile* profile = Profile::FromJavaObject(jprofile)) {
+    SetAllowed(profile, site, false);
+  }
+}
+
+DEFINE_JNI(BareCanvasBlockBridge)

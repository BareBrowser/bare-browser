@@ -0,0 +1,132 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "third_party/blink/renderer/core/html/canvas/bare_canvas_block.h"
+
+#include <atomic>
+
+#include "third_party/blink/public/mojom/frame/frame.mojom-blink.h"
+#include "third_party/blink/renderer/core/execution_context/execution_context.h"
+#include "third_party/blink/renderer/core/frame/local_dom_window.h"
+#include "third_party/blink/renderer/core/frame/local_frame.h"
+#include "third_party/blink/renderer/core/html/canvas/canvas_image_source.h"
+#include "third_party/blink/renderer/core/workers/worker_global_scope.h"
+#include "third_party/blink/renderer/core/workers/worker_reporting_proxy.h"
+#include "third_party/blink/renderer/platform/graphics/static_bitmap_image.h"
+#include "third_party/blink/renderer/platform/graphics/unaccelerated_static_bitmap_image.h"
+#include "third_party/blink/renderer/platform/weborigin/security_origin.h"
+#include "third_party/skia/include/core/SkBitmap.h"
+#include "third_party/skia/include/core/SkColor.h"
+#include "third_party/skia/include/core/SkColorSpace.h"
+#include "third_party/skia/include/core/SkImage.h"
+#include "third_party/skia/include/core/SkImageInfo.h"
+#include "ui/gfx/geometry/size.h"
+
+namespace blink {
+
+namespace {
+
+// Read on worker threads, written on the main thread.
+std::atomic<bool> g_block_in_shared_workers{false};
+
+// Set once a blocked context has made an ImageBitmap from a canvas or has
+// been sent one. A renderer process serves one site, so this is as narrow as
+// an ImageBitmap can be followed without marking every copy of it.
+std::atomic<bool> g_canvas_bitmap_seen{false};
+
+void Report(ExecutionContext* context) {
+  if (context->BareCanvasBlockReported()) {
+    return;
+  }
+  context->SetBareCanvasBlockReported();
+  if (auto* window = DynamicTo<LocalDOMWindow>(context)) {
+    if (LocalFrame* frame = window->GetFrame()) {
+      frame->GetLocalFrameHostRemote().BareCanvasReadBlocked();
+    }
+    return;
+  }
+  // A dedicated worker passes it to the context that made it, which reports
+  // in turn. Shared and service workers have no single page to report to.
+  if (auto* scope = DynamicTo<WorkerGlobalScope>(context)) {
+    if (scope->IsDedicatedWorkerGlobalScope()) {
+      scope->ReportingProxy().BareCanvasReadBlocked();
+    }
+  }
+}
+
+}  // namespace
+
+void SetBareCanvasBlockInSharedWorkers(bool block) {
+  g_block_in_shared_workers.store(block, std::memory_order_relaxed);
+}
+
+bool BareCanvasReadIsBlocked(const ExecutionContext* context) {
+  if (!context) {
+    return false;
+  }
+  // Extensions draw their toolbar icons through a canvas (setIcon), so they
+  // are never blocked; otherwise the uBO button goes blank.
+  const SecurityOrigin* origin = context->GetSecurityOrigin();
+  if (origin && origin->Protocol() == "chrome-extension") {
+    return false;
+  }
+  if (context->BareBlockCanvasRead()) {
+    return true;
+  }
+  if (context->IsSharedWorkerGlobalScope() ||
+      context->IsServiceWorkerGlobalScope()) {
+    return g_block_in_shared_workers.load(std::memory_order_relaxed);
+  }
+  return false;
+}
+
+bool BareBlockCanvasRead(ExecutionContext* context) {
+  if (!BareCanvasReadIsBlocked(context)) {
+    return false;
+  }
+  Report(context);
+  return true;
+}
+
+scoped_refptr<StaticBitmapImage> BareBlankIfBlocked(
+    ExecutionContext* context,
+    scoped_refptr<StaticBitmapImage> image) {
+  if (!image || !BareBlockCanvasRead(context)) {
+    return image;
+  }
+  const gfx::Size size = image->Size();
+  SkBitmap bitmap;
+  if (size.IsEmpty() ||
+      !bitmap.tryAllocPixels(SkImageInfo::MakeN32Premul(
+          size.width(), size.height(), SkColorSpace::MakeSRGB()))) {
+    return nullptr;
+  }
+  bitmap.eraseColor(SK_ColorTRANSPARENT);
+  bitmap.setImmutable();
+  return UnacceleratedStaticBitmapImage::Create(bitmap.asImage());
+}
+
+void BareNoteCanvasBitmap(const ExecutionContext* context) {
+  if (BareCanvasReadIsBlocked(context)) {
+    g_canvas_bitmap_seen.store(true, std::memory_order_relaxed);
+  }
+}
+
+bool BareBlockCanvasExport(ExecutionContext* context,
+                           const CanvasImageSource& source) {
+  if (!BareCanvasReadIsBlocked(context)) {
+    return false;
+  }
+  const bool holds_canvas_pixels =
+      source.IsCanvasElement() || source.IsOffscreenCanvas() ||
+      (source.IsImageBitmap() &&
+       g_canvas_bitmap_seen.load(std::memory_order_relaxed));
+  if (!holds_canvas_pixels) {
+    return false;
+  }
+  Report(context);
+  return true;
+}
+
+}  // namespace blink

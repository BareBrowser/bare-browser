+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.bare.canvas;
+
+import android.content.Context;
+import android.graphics.Canvas;
+import android.graphics.Paint;
+import android.graphics.RectF;
+import android.text.Layout;
+import android.text.StaticLayout;
+import android.text.TextPaint;
+import android.util.AttributeSet;
+import android.view.View;
+
+import androidx.core.content.ContextCompat;
+
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.chrome.R;
+
+/**
+ * The picture on the welcome's canvas page: a page asks for canvas pixels, Bare hands over a blank
+ * canvas, and the site gets nothing it could recognize the browser by, while what is drawn on
+ * screen stays as it was. It draws only that one path, which is also all the feature does.
+ */
+@NullMarked
+public class BareCanvasFlowView extends View {
+    private static final int GRID = 4;
+
+    // A fixed little picture, standing for whatever a page drew.
+    private static final int[] CELL_COLORS = {
+        0xFF345FC7, 0xFF345FC7, 0xFF8AA8E8, 0xFF8AA8E8,
+        0xFF345FC7, 0xFFDA654B, 0xFFDA654B, 0xFF8AA8E8,
+        0xFFF1C27B, 0xFFDA654B, 0xFFDA654B, 0xFF5F9E6E,
+        0xFFF1C27B, 0xFFF1C27B, 0xFF5F9E6E, 0xFF5F9E6E,
+    };
+
+    private final Paint mFill = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint mStroke = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final TextPaint mText = new TextPaint(Paint.ANTI_ALIAS_FLAG);
+    private final RectF mRect = new RectF();
+    private final float mDensity;
+
+    public BareCanvasFlowView(Context context, AttributeSet attrs) {
+        super(context, attrs);
+        mDensity = context.getResources().getDisplayMetrics().density;
+        mStroke.setStyle(Paint.Style.STROKE);
+        mStroke.setStrokeWidth(1.5f * mDensity);
+        mText.setTextSize(12 * mDensity);
+        setContentDescription(context.getString(R.string.bare_welcome_canvas_picture_description));
+    }
+
+    @Override
+    protected void onMeasure(int widthSpec, int heightSpec) {
+        int width = MeasureSpec.getSize(widthSpec);
+        setMeasuredDimension(width, Math.round(192 * mDensity));
+    }
+
+    @Override
+    protected void onDraw(Canvas canvas) {
+        float width = getWidth();
+        float column = width / 3f;
+        float grid = Math.min(column - 28 * mDensity, 76 * mDensity);
+        float top = 8 * mDensity;
+        int accent = ContextCompat.getColor(getContext(), R.color.bare_welcome_accent);
+        int body = ContextCompat.getColor(getContext(), R.color.bare_welcome_body);
+        int title = ContextCompat.getColor(getContext(), R.color.bare_welcome_title);
+        int card = ContextCompat.getColor(getContext(), R.color.bare_welcome_card);
+        int divider = ContextCompat.getColor(getContext(), R.color.bare_welcome_divider);
+        int soft = ContextCompat.getColor(getContext(), R.color.bare_welcome_soft);
+
+        int[] labels = {
+            R.string.bare_welcome_canvas_step_ask,
+            R.string.bare_welcome_canvas_step_blank,
+            R.string.bare_welcome_canvas_step_receive,
+        };
+        for (int i = 0; i < 3; i++) {
+            float left = i * column + (column - grid) / 2f;
+            // Bare's own step sits in a tinted card so the eye finds where the change happens.
+            if (i == 1) {
+                mRect.set(i * column + 4 * mDensity, top - 6 * mDensity,
+                        (i + 1) * column - 4 * mDensity, top + grid + 74 * mDensity);
+                mFill.setColor(soft);
+                canvas.drawRoundRect(mRect, 14 * mDensity, 14 * mDensity, mFill);
+            }
+            // The first tile is what the page drew. The other two are the blank canvas.
+            drawGrid(canvas, left, top, grid, i > 0, accent, card);
+            drawLabel(canvas, getContext().getString(labels[i]), i * column + 8 * mDensity,
+                    top + grid + 10 * mDensity, column - 16 * mDensity, i == 1 ? title : body);
+        }
+        // Drawn after the cards so the tinted one cannot cover an arrow.
+        for (int i = 1; i < 3; i++) {
+            drawArrow(canvas, i * column, top + grid / 2f, accent);
+        }
+
+        // What is drawn on screen is not part of the path above and does not change.
+        float lineY = getHeight() - 30 * mDensity;
+        mFill.setColor(divider);
+        canvas.drawRect(8 * mDensity, lineY - 1, width - 8 * mDensity, lineY, mFill);
+        float small = 20 * mDensity;
+        drawGrid(canvas, 12 * mDensity, lineY + 5 * mDensity, small, false, accent, card);
+        drawLabel(canvas, getContext().getString(R.string.bare_welcome_canvas_screen_unchanged),
+                12 * mDensity + small + 10 * mDensity, lineY + 7 * mDensity,
+                width - small - 36 * mDensity, title);
+    }
+
+    private void drawGrid(Canvas canvas, float left, float top, float size, boolean blank,
+            int accent, int card) {
+        if (blank) {
+            mFill.setColor(card);
+            canvas.drawRect(left, top, left + size, top + size, mFill);
+        } else {
+            float cell = size / GRID;
+            for (int row = 0; row < GRID; row++) {
+                for (int col = 0; col < GRID; col++) {
+                    float x = left + col * cell;
+                    float y = top + row * cell;
+                    mFill.setColor(CELL_COLORS[row * GRID + col]);
+                    canvas.drawRect(x, y, x + cell, y + cell, mFill);
+                }
+            }
+        }
+        mStroke.setColor(accent);
+        mRect.set(left, top, left + size, top + size);
+        canvas.drawRect(mRect, mStroke);
+    }
+
+    private void drawArrow(Canvas canvas, float x, float y, int color) {
+        mStroke.setColor(color);
+        float half = 8 * mDensity;
+        canvas.drawLine(x - half, y, x + half, y, mStroke);
+        canvas.drawLine(x + half - 5 * mDensity, y - 5 * mDensity, x + half, y, mStroke);
+        canvas.drawLine(x + half - 5 * mDensity, y + 5 * mDensity, x + half, y, mStroke);
+    }
+
+    private void drawLabel(Canvas canvas, String text, float x, float y, float width, int color) {
+        mText.setColor(color);
+        StaticLayout layout =
+                StaticLayout.Builder.obtain(text, 0, text.length(), mText, Math.round(width))
+                        .setAlignment(Layout.Alignment.ALIGN_NORMAL)
+                        .build();
+        canvas.save();
+        canvas.translate(x, y);
+        layout.draw(canvas);
+        canvas.restore();
+    }
+}

+
+// The browser side of canvas read blocking: the switch, the list of sites it
+// leaves alone, and the note that a page had a read blocked. The renderer
+// side is third_party/blink/renderer/core/html/canvas/bare_canvas_block.h.
+namespace bare_canvas_block {
+
+// Whether canvas reads are blocked on a page whose top-level origin is
+// `top_level_origin`: the switch is on and the origin's site is not on the
+// allowed list. An opaque origin has no site to allow, so it is blocked
+// whenever the switch is on.
+bool ShouldBlock(content::BrowserContext* browser_context,
+                 const url::Origin& top_level_origin);
+
+// Remembers, for as long as the page lives, that a read was blocked on the
+// page `render_frame_host` belongs to. The menu offers to allow the site only
+// on such a page.
+void NoteReadBlocked(content::RenderFrameHost* render_frame_host);
+
+}  // namespace bare_canvas_block
+
+#endif  // CHROME_BROWSER_ANDROID_BARE_CANVAS_BLOCK_H_

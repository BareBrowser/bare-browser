+package org.chromium.chrome.browser.bare;
+
+import android.app.Activity;
+import android.graphics.Color;
+import android.os.Build;
+import android.view.Gravity;
+import android.view.View;
+import android.view.ViewGroup;
+import android.view.WindowInsets;
+import android.widget.FrameLayout;
+
+import androidx.annotation.ColorInt;
+
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.ui.util.ColorUtils;
+import org.chromium.chrome.browser.browser_controls.BrowserControlsStateProvider;
+import org.chromium.chrome.browser.browser_controls.BrowserControlsStateProvider.ControlsPosition;
+import org.chromium.chrome.browser.browser_controls.TopControlLayer;
+import org.chromium.chrome.browser.browser_controls.TopControlsStacker;
+import org.chromium.chrome.browser.browser_controls.TopControlsStacker.TopControlType;
+import org.chromium.chrome.browser.browser_controls.TopControlsStacker.TopControlVisibility;
+import org.chromium.chrome.browser.tab.Tab;
+import org.chromium.chrome.browser.theme.ThemeColorProvider.ThemeColorObserver;
+import org.chromium.chrome.browser.theme.TopUiThemeColorProvider;
+
+import java.util.function.Supplier;
+
+/**
+ * A top control as tall as the status bar. The page lays out below it and scrolls it away with the
+ * other browser controls. While the address bar is on top, an opaque strip in the status-bar inset
+ * uses the toolbar theme color and slides with the toolbar. With the address bar at the bottom the
+ * strip is not drawn, so the page stays visible there.
+ */
+@NullMarked
+public final class BareStatusBarLayer implements TopControlLayer, ThemeColorObserver {
+    private final Activity mActivity;
+    private final TopUiThemeColorProvider mThemeColorProvider;
+    private final BrowserControlsStateProvider mControls;
+    private final Supplier<@Nullable Tab> mTabSupplier;
+    private final View mStrip;
+    private int mHeight;
+    // The toolbar theme color. A scrim is only overlaid on top of it.
+    private @ColorInt int mBaseColor;
+    private @ColorInt int mScrimColor = Color.TRANSPARENT;
+
+    public BareStatusBarLayer(
+            Activity activity,
+            TopControlsStacker stacker,
+            TopUiThemeColorProvider themeColorProvider,
+            BrowserControlsStateProvider controls,
+            Supplier<@Nullable Tab> tabSupplier) {
+        mActivity = activity;
+        mThemeColorProvider = themeColorProvider;
+        mControls = controls;
+        mTabSupplier = tabSupplier;
+        mHeight = statusBarHeight(activity);
+        mStrip = new View(activity);
+        mStrip.setClickable(false);
+        mStrip.setFocusable(false);
+        mStrip.setImportantForAccessibility(View.IMPORTANT_FOR_ACCESSIBILITY_NO);
+        // Drawn after the content child, which holds the compositor, without a shadow.
+        mStrip.setElevation(24f);
+        mStrip.setOutlineProvider(null);
+        // The decor is not padded once the window draws edge to edge, so a top-gravity child of
+        // this height sits in the status-bar inset. It is outside the padded content layout, so
+        // that layout's dispatchDraw clip cannot hide it.
+        View decor = activity.getWindow().getDecorView();
+        ((ViewGroup) decor)
+                .addView(
+                        mStrip,
+                        new FrameLayout.LayoutParams(
+                                ViewGroup.LayoutParams.MATCH_PARENT,
+                                Math.max(mHeight, 0),
+                                Gravity.TOP));
+        applyThemeColor();
+        mThemeColorProvider.addThemeColorObserver(this);
+        mControls.addObserver(
+                new BrowserControlsStateProvider.Observer() {
+                    @Override
+                    public void onControlsOffsetChanged(
+                            int topOffset,
+                            int topControlsMinHeightOffset,
+                            boolean topControlsMinHeightChanged,
+                            int bottomOffset,
+                            int bottomControlsMinHeightOffset,
+                            boolean bottomControlsMinHeightChanged,
+                            boolean requestNewFrame,
+                            boolean isVisibilityForced) {
+                        // Same offset BrowserControlsManager applies to the toolbar view.
+                        if (mStrip.getVisibility() == View.VISIBLE) {
+                            mStrip.setTranslationY(topOffset);
+                        }
+                    }
+
+                    @Override
+                    public void onControlsPositionChanged(
+                            @ControlsPosition int controlsPosition) {
+                        syncStrip();
+                    }
+                });
+        decor.addOnLayoutChangeListener(
+                (v, l, t, r, b, ol, ot, or, ob) -> {
+                    int height = statusBarHeight(mActivity);
+                    if (height != mHeight) {
+                        mHeight = height;
+                        FrameLayout.LayoutParams lp =
+                                (FrameLayout.LayoutParams) mStrip.getLayoutParams();
+                        lp.height = Math.max(mHeight, 0);
+                        mStrip.setLayoutParams(lp);
+                        stacker.requestLayerUpdatePost(false);
+                    }
+                    syncStrip();
+                });
+        syncStrip();
+    }
+
+    /** Returns the status bar height, also while the status bar is hidden. */
+    public static int statusBarHeight(Activity activity) {
+        View decor = activity.getWindow().getDecorView();
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.R) {
+            WindowInsets insets = decor.getRootWindowInsets();
+            if (insets != null) {
+                int top = insets.getInsetsIgnoringVisibility(WindowInsets.Type.statusBars()).top;
+                if (top > 0) return top;
+            }
+        }
+        int id = activity.getResources().getIdentifier("status_bar_height", "dimen", "android");
+        return id > 0 ? activity.getResources().getDimensionPixelSize(id) : 0;
+    }
+
+    @Override
+    public @TopControlType int getTopControlType() {
+        return TopControlType.BARE_STATUS_BAR;
+    }
+
+    @Override
+    public int getTopControlHeight() {
+        return mHeight;
+    }
+
+    @Override
+    public @TopControlVisibility int getTopControlVisibility() {
+        return mHeight > 0 ? TopControlVisibility.VISIBLE : TopControlVisibility.HIDDEN;
+    }
+
+    @Override
+    public void onThemeColorChanged(int color, boolean shouldAnimate) {
+        // This is the color TopUiThemeColorProvider just fed to the toolbar background.
+        mBaseColor = color;
+        paint();
+    }
+
+    /**
+     * Blends the page scrim over the theme color while a bottom sheet's scrim is showing, and
+     * clears it when that scrim is gone. The theme color itself is unchanged.
+     */
+    public void setScrimColor(@ColorInt int scrimColor) {
+        if (mScrimColor == scrimColor) return;
+        mScrimColor = scrimColor;
+        paint();
+    }
+
+    private void applyThemeColor() {
+        @Nullable Tab tab = mTabSupplier.get();
+        mBaseColor =
+                tab != null
+                        ? mThemeColorProvider.getToolbarBackgroundColor(tab)
+                        : mThemeColorProvider.getThemeColor();
+        paint();
+    }
+
+    private void paint() {
+        mStrip.setBackgroundColor(ColorUtils.overlayColor(mBaseColor, mScrimColor));
+    }
+
+    /** Shows the strip only while the address bar is on top. Bottom stays transparent. */
+    private void syncStrip() {
+        boolean showOnTop =
+                mControls.getControlsPosition() != ControlsPosition.BOTTOM && mHeight > 0;
+        mStrip.setVisibility(showOnTop ? View.VISIBLE : View.GONE);
+        if (!showOnTop) return;
+        mStrip.setTranslationY(mControls.getTopControlOffset());
+    }
+}

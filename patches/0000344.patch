@@ -0,0 +1,72 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef THIRD_PARTY_BLINK_RENDERER_CORE_HTML_CANVAS_BARE_CANVAS_BLOCK_H_
+#define THIRD_PARTY_BLINK_RENDERER_CORE_HTML_CANVAS_BARE_CANVAS_BLOCK_H_
+
+#include "base/memory/scoped_refptr.h"
+#include "third_party/blink/renderer/core/core_export.h"
+
+namespace blink {
+
+class CanvasImageSource;
+class ExecutionContext;
+class StaticBitmapImage;
+
+// Blocking of canvas reads.
+//
+// When the user has turned it on, the browser tells each document whether
+// scripts that read pixels back from a canvas get blank pixels instead
+// (ExecutionContext::BareBlockCanvasRead). The decision is made per page, from
+// the top-level site, so every frame of a page gets the same answer. Dedicated
+// workers take their creator's answer. Shared and service workers can serve
+// pages of several sites, so they follow the switch alone.
+//
+// Nothing here touches drawing. A canvas keeps its real content, and copying
+// one canvas into another stays exact. Only the calls that hand pixels to
+// script are affected, and they return what an empty canvas of the same size
+// would: every argument check still runs first, and sizes, types and formats
+// are unchanged. The result does not depend on the device, the site or
+// anything random.
+//
+// All of this does nothing, at the cost of one test, when the context was not
+// told to block.
+
+// Sets whether shared and service workers in this process block. Called when
+// the browser sends the profile's setting, and again when it changes.
+CORE_EXPORT void SetBareCanvasBlockInSharedWorkers(bool block);
+
+// Whether canvas reads are blocked in `context`. Does not report anything.
+CORE_EXPORT bool BareCanvasReadIsBlocked(const ExecutionContext* context);
+
+// The same, for a call that is about to hand pixels to script. When it
+// returns true the caller must not expose the real pixels, and the browser is
+// told, once per context, that a read was blocked on this page.
+CORE_EXPORT bool BareBlockCanvasRead(ExecutionContext* context);
+
+// For an image a page is about to encode (toDataURL, toBlob, convertToBlob).
+// Returns `image` when reads are not blocked. Otherwise returns a transparent
+// image of the same size, or null if one cannot be made, which callers
+// already treat as "nothing to encode". Never falls back to `image`.
+CORE_EXPORT scoped_refptr<StaticBitmapImage> BareBlankIfBlocked(
+    ExecutionContext* context,
+    scoped_refptr<StaticBitmapImage> image);
+
+// Called when an ImageBitmap is made from a canvas, or arrives in a message,
+// in `context`. If reads are blocked there, ImageBitmaps can from then on
+// carry canvas pixels, so BareBlockCanvasExport() starts refusing them.
+CORE_EXPORT void BareNoteCanvasBitmap(const ExecutionContext* context);
+
+// For the calls that would move the pixels of `source` out of canvases
+// altogether: into a WebCodecs VideoFrame or a WebGPU texture, where they
+// could be read without touching a canvas again. True when `source` is a
+// canvas, or an ImageBitmap that may hold canvas pixels, and reads are
+// blocked. The caller then fails the call the way it does for a tainted
+// source.
+CORE_EXPORT bool BareBlockCanvasExport(ExecutionContext* context,
+                                       const CanvasImageSource& source);
+
+}  // namespace blink

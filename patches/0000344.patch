+                    int minHeight = mBrowserControlsStateProvider.getTopControlsMinHeight();
+                    boolean hidden = height > minHeight && topOffset <= minHeight - height;
+                    if (hidden == mBareStatusHidden) return;
+                    mBareStatusHidden = hidden;
+                    updateStatusBarColor();
+                }

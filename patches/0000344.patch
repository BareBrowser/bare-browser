+package org.chromium.chrome.browser.bare.canvas;
+
+import org.jni_zero.JniType;
+import org.jni_zero.NativeMethods;
+
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.chrome.browser.profiles.Profile;
+import org.chromium.content_public.browser.WebContents;
+
+/**
+ * The switch that blocks canvas reading, and the sites it leaves alone.
+ *
+ * <p>With the switch on, a page that reads pixels back from a canvas gets blank pixels. What is
+ * drawn on screen does not change. A site that needs the real pixels can be put on the allowed
+ * list. Both apply to pages loaded afterwards.
+ */
+@NullMarked
+public final class BareCanvasBlockBridge {
+    private BareCanvasBlockBridge() {}
+
+    public static boolean isEnabled(Profile profile) {
+        return BareCanvasBlockBridgeJni.get().isEnabled(profile);
+    }
+
+    public static void setEnabled(Profile profile, boolean enabled) {
+        BareCanvasBlockBridgeJni.get().setEnabled(profile, enabled);
+    }
+
+    /** Whether a canvas read has been blocked on the page the tab shows. */
+    public static boolean wasReadBlocked(@Nullable WebContents webContents) {
+        if (webContents == null || webContents.isDestroyed()) return false;
+        return BareCanvasBlockBridgeJni.get().wasReadBlocked(webContents);
+    }
+
+    /** Whether the site of the page the tab shows is on the allowed list. */
+    public static boolean isPageSiteAllowed(@Nullable WebContents webContents) {
+        if (webContents == null || webContents.isDestroyed()) return false;
+        return BareCanvasBlockBridgeJni.get().isPageSiteAllowed(webContents);
+    }
+
+    /** Allows the site of the page the tab shows, or blocks it again. Reload to apply. */
+    public static void setPageSiteAllowed(@Nullable WebContents webContents, boolean allowed) {
+        if (webContents == null || webContents.isDestroyed()) return;
+        BareCanvasBlockBridgeJni.get().setPageSiteAllowed(webContents, allowed);
+    }
+
+    public static String[] getAllowedSites(Profile profile) {
+        return BareCanvasBlockBridgeJni.get().getAllowedSites(profile);
+    }
+
+    public static void removeAllowedSite(Profile profile, String site) {
+        BareCanvasBlockBridgeJni.get().removeAllowedSite(profile, site);
+    }
+
+    @NativeMethods
+    public interface Natives {
+        boolean isEnabled(Profile profile);
+
+        void setEnabled(Profile profile, boolean enabled);
+
+        boolean wasReadBlocked(WebContents webContents);
+
+        boolean isPageSiteAllowed(WebContents webContents);
+
+        void setPageSiteAllowed(WebContents webContents, boolean allowed);
+
+        @JniType("std::vector<std::string>")
+        String[] getAllowedSites(Profile profile);
+
+        void removeAllowedSite(Profile profile, @JniType("std::string") String site);
+    }
+}

+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.bare;
+
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+import static org.mockito.ArgumentMatchers.anyBoolean;
+import static org.mockito.ArgumentMatchers.eq;
+import static org.mockito.Mockito.never;
+import static org.mockito.Mockito.verify;
+import static org.mockito.Mockito.when;
+
+import org.junit.After;
+import org.junit.Before;
+import org.junit.Rule;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.mockito.Mock;
+import org.mockito.junit.MockitoJUnit;
+import org.mockito.junit.MockitoRule;
+
+import org.chromium.components.prefs.PrefService;
+import org.chromium.components.user_prefs.UserPrefs;
+import org.chromium.components.user_prefs.UserPrefsJni;
+import org.chromium.base.test.BaseRobolectricTestRunner;
+import org.chromium.chrome.browser.bare.canvas.BareCanvasBlockBridge;
+import org.chromium.chrome.browser.bare.canvas.BareCanvasBlockBridgeJni;
+import org.chromium.chrome.browser.profiles.Profile;
+import org.chromium.chrome.browser.profiles.ProfileManager;
+
+/**
+ * Tests for the choice to block canvas reading: off by default, read and written through the one
+ * switch the browser reads, and written by the welcome only when it should be.
+ */
+@RunWith(BaseRobolectricTestRunner.class)
+public class BareCanvasBlockChoiceUnitTest {
+    @Rule public MockitoRule mMockitoRule = MockitoJUnit.rule();
+
+    @Mock private BareCanvasBlockBridge.Natives mNatives;
+    @Mock private Profile mProfile;
+    @Mock private UserPrefs.Natives mUserPrefsNatives;
+    @Mock private PrefService mPrefs;
+
+    @Before
+    public void setUp() {
+        BareCanvasBlockBridgeJni.setInstanceForTesting(mNatives);
+        UserPrefsJni.setInstanceForTesting(mUserPrefsNatives);
+        when(mUserPrefsNatives.get(mProfile)).thenReturn(mPrefs);
+        ProfileManager.setLastUsedProfileForTesting(mProfile);
+    }
+
+    @After
+    public void tearDown() {
+        ProfileManager.resetForTesting();
+    }
+
+    @Test
+    public void testTheSwitchReadsAndWritesTheBrowsersSetting() {
+        when(mNatives.isEnabled(mProfile)).thenReturn(false);
+        assertFalse(BareSecurityChoices.isBlockCanvasReading(mProfile));
+        when(mNatives.isEnabled(mProfile)).thenReturn(true);
+        assertTrue(BareSecurityChoices.isBlockCanvasReading(mProfile));
+
+        BareSecurityChoices.setBlockCanvasReading(mProfile, true);
+        verify(mNatives).setEnabled(mProfile, true);
+        BareSecurityChoices.setBlockCanvasReading(mProfile, false);
+        verify(mNatives).setEnabled(mProfile, false);
+    }
+
+    @Test
+    public void testTheWelcomeOpensWithItOff() {
+        for (boolean reviewing : new boolean[] {false, true}) {
+            BareWelcomeOverlay.Choices choices = BareWelcomeOverlay.currentChoices(reviewing);
+            assertFalse(choices.canvasBlock);
+            assertFalse(choices.canvasBlockTouched);
+        }
+    }
+
+    @Test
+    public void testAReviewWritesItOnlyWhenTheUserChangedIt() {
+        BareWelcomeOverlay.Choices choices = BareWelcomeOverlay.currentChoices(true);
+        BareWelcomeOverlay.applyChoices(choices);
+        verify(mNatives, never()).setEnabled(eq(mProfile), anyBoolean());
+
+        choices.canvasBlock = true;
+        choices.canvasBlockTouched = true;
+        BareWelcomeOverlay.applyChoices(choices);
+        verify(mNatives).setEnabled(mProfile, true);
+    }
+
+    @Test
+    public void testAReviewCanTurnItBackOff() {
+        BareWelcomeOverlay.Choices choices = BareWelcomeOverlay.currentChoices(true);
+        choices.canvasBlock = false;
+        choices.canvasBlockTouched = true;
+        BareWelcomeOverlay.applyChoices(choices);
+        verify(mNatives).setEnabled(mProfile, false);
+    }
+}

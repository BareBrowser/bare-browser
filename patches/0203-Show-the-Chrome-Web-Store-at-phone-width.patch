@@ -5141,6 +5149,25 @@ bool ChromeContentBrowserClient::OverrideWebPreferencesAfterNavigation(
     web_prefs->viewport_style = blink::mojom::ViewportStyle::kDefault;
     prefs_changed = true;
   }
+
+  // Web preferences are only recomputed when a navigation turns the desktop
+  // user agent on or off, so moving between the Chrome Web Store and another
+  // desktop site leaves the store's viewport rule in place, or misses it.
+  // Settle it here from the committed entry.
+  if (content::NavigationEntry* entry =
+          web_contents->GetController().GetVisibleEntry();
+      entry && entry->GetIsOverridingUserAgent()) {
+    const blink::UserAgentOverride& ua_override =
+        web_contents->GetUserAgentOverride();
+    const bool desktop_ua = ua_override.ua_metadata_override &&
+                            !ua_override.ua_metadata_override->mobile;
+    const bool viewport_meta_enabled =
+        !desktop_ua ||
+        RequestDesktopSiteWebContentsObserverAndroid::ShouldKeepWebStoreViewport(
+            web_contents);
+    prefs_changed |= web_prefs->viewport_meta_enabled != viewport_meta_enabled;
+    web_prefs->viewport_meta_enabled = viewport_meta_enabled;
+  }
 #endif  // BUILDFLAG(IS_ANDROID)
 

+
   // Override UA for renderer initiated navigation only. UA override for browser
   // initiated navigation is handled on Java side. This is to workaround known
   // issues crbug.com/40801643 and crbug.com/40799177.
@@ -123,6 +127,34 @@ void RequestDesktopSiteWebContentsObserverAndroid::DidStartNavigation(
 
 WEB_CONTENTS_USER_DATA_KEY_IMPL(RequestDesktopSiteWebContentsObserverAndroid);
 
+// static
+bool RequestDesktopSiteWebContentsObserverAndroid::ShouldRequestDesktopWebStore(
+    HostContentSettingsMap* map,
+    const GURL& url) {
+  if (!url.SchemeIs(url::kHttpsScheme) ||
+      url.host() != "chromewebstore.google.com") {
+    return false;
+  }
+  content_settings::SettingInfo setting_info;
+  map->GetContentSetting(url, url, ContentSettingsType::REQUEST_DESKTOP_SITE,
+                         &setting_info);
+  return setting_info.primary_pattern.MatchesAllHosts();
+}
+
+// static
+bool RequestDesktopSiteWebContentsObserverAndroid::ShouldKeepWebStoreViewport(
+    content::WebContents* web_contents) {
+  content::NavigationEntry* entry =
+      web_contents->GetController().GetVisibleEntry();
+  if (!entry || !entry->GetIsOverridingUserAgent()) {
+    return false;
+  }
+  Profile* profile =
+      Profile::FromBrowserContext(web_contents->GetBrowserContext());
+  return ShouldRequestDesktopWebStore(
+      HostContentSettingsMapFactory::GetForProfile(profile), entry->GetURL());
+}
+
 bool RequestDesktopSiteWebContentsObserverAndroid::ShouldAllowOnExternalDisplay(
     bool is_global_setting) {
   // Disallow if feature is disabled.

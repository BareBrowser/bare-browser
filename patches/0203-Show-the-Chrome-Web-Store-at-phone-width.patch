-        prefs.writeBoolean(ChromePreferenceKeys.WEBSTORE_DESKTOP_SITE_SEEDED, true);
+        if (prefs.readBoolean(ChromePreferenceKeys.WEBSTORE_DESKTOP_SITE_SEEDED, false)) {
+            DesktopSiteUtils.removeRequestDesktopSiteDomainException(
+                    profile, new GURL(UrlConstants.CHROME_WEBSTORE_URL));
+        }
+        prefs.writeBoolean(ChromePreferenceKeys.WEBSTORE_DESKTOP_SITE_CLEARED, true);
     }
 
     @Override
@@ -1727,7 +1723,7 @@ public class ChromeTabbedActivity extends ChromeActivity implements PreAttachInt
         try (TraceEvent te = TraceEvent.scoped("ChromeTabbedActivity.finishNativeInitialization")) {

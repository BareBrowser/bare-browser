From c2edc999f837280f4d4c8d3544bfe036b6241569 Mon Sep 17 00:00:00 2001
From: Bare <git@barebrowser.org>
Date: Sun, 11 Oct 2026 07:23:11 +0000
Subject: [PATCH] Report Chromium's version, not Bare's, from version_info

156 makes the AndroidManifest the only source of version information on
Android (upstream 7cb5ec9c41e): version_info::GetVersionNumber() and
VersionInfo.getProductVersion() now return the APK's versionName, and
PRODUCT_VERSION is no longer defined there. In Chrome that is the same string
as the Chromium version. Bare sets its own versionName, 1.0.0 and so on, so
every caller suddenly saw Bare's release number where it expected
156.0.8078.25.

The first visible result was a crash at startup: base::Version cannot parse
"1.0.0-m156-trial", so variations never initialised its country and a CHECK in
VariationsFieldTrialCreator::GetPermanentConsistencyCountry() aborted the
browser. Behind it were quieter ones: the User-Agent would have said
Chrome/1.0.0, extension minimum_chrome_version checks would have failed, and
the GPU cache key and crash reports would have carried the wrong version.

Both functions return the Chromium version again, from the same template
values the rest of the build uses. Version codes still come from the manifest,
which is what upstream's change was for.
---
 .../android/java/VersionConstants.java.version        |  4 ++++
 .../org/chromium/base/version_info/VersionInfo.java   |  3 +--
 base/version_info/version_info.cc                     | 11 ++++++-----
 base/version_info/version_info_values.h.version       |  4 ++--
 4 files changed, 13 insertions(+), 9 deletions(-)

diff --git a/base/version_info/android/java/VersionConstants.java.version b/base/version_info/android/java/VersionConstants.java.version
index 0d895fe2483..eaead44ac7f 100644
--- a/base/version_info/android/java/VersionConstants.java.version
+++ b/base/version_info/android/java/VersionConstants.java.version
@@ -11,6 +11,10 @@ import org.chromium.build.annotations.NullMarked;
 // Note: PATCH, VERSION_NAME and VERSION_CODE should come from ApkInfo.
 @NullMarked
 public class VersionConstants {
+    // Bare: the Chromium version. VersionInfo.getProductVersion() returns it, since
+    // Bare's versionName is Bare's own release number.
+    public static final String PRODUCT_VERSION = "@MAJOR@.@MINOR@.@BUILD@.@PATCH@";
+
     @SuppressWarnings({"ComplexBooleanConstant", "IdentityBinaryExpression"})
     public static final boolean IS_OFFICIAL_BUILD = @OFFICIAL_BUILD@ == 1;
 
diff --git a/base/version_info/android/java/src/org/chromium/base/version_info/VersionInfo.java b/base/version_info/android/java/src/org/chromium/base/version_info/VersionInfo.java
index d0897e80cdb..3906ee03667 100644
--- a/base/version_info/android/java/src/org/chromium/base/version_info/VersionInfo.java
+++ b/base/version_info/android/java/src/org/chromium/base/version_info/VersionInfo.java
@@ -4,7 +4,6 @@
 
 package org.chromium.base.version_info;
 
-import org.chromium.base.ApkInfo;
 import org.chromium.base.ResettersForTesting;
 import org.chromium.build.annotations.NullMarked;
 import org.chromium.build.annotations.Nullable;
@@ -84,7 +83,7 @@ public class VersionInfo {
      * @return The version number.
      */
     public static String getProductVersion() {
-        return ApkInfo.getPackageVersionName();
+        return VersionConstants.PRODUCT_VERSION;
     }
 
     /**
diff --git a/base/version_info/version_info.cc b/base/version_info/version_info.cc
index 4b76dfc87b5..4795d7c3424 100644
--- a/base/version_info/version_info.cc
+++ b/base/version_info/version_info.cc
@@ -11,15 +11,16 @@
 #include "base/strings/string_number_conversions.h"
 #include "base/version.h"
 
-#if BUILDFLAG(IS_ANDROID)
-#include "base/android/apk_info.h"
-#endif
-
 namespace version_info {
 
 #if BUILDFLAG(IS_ANDROID)
+// Bare: the Chromium version, as everywhere else. Upstream reads the APK's
+// versionName here, which in Chrome is the same string. Bare's versionName is
+// Bare's own release number, so reading it would make the User-Agent say
+// Chrome/1.0.0, fail every minimum_chrome_version check, and leave
+// base::Version invalid, which variations then refuses to start with.
 std::string_view GetVersionNumber() {
-  return base::android::apk_info::package_version_name();
+  return PRODUCT_VERSION;
 }
 #endif
 
diff --git a/base/version_info/version_info_values.h.version b/base/version_info/version_info_values.h.version
index e7a14529a99..c481e03b0f6 100644
--- a/base/version_info/version_info_values.h.version
+++ b/base/version_info/version_info_values.h.version
@@ -8,9 +8,9 @@
 #include "build/build_config.h"
 
 #define PRODUCT_NAME "@PRODUCT_FULLNAME@"
-#if !BUILDFLAG(IS_ANDROID)
+// Bare: defined on Android too. Bare sets its own versionName, so the
+// manifest cannot stand in for the Chromium version; see version_info.cc.
 #define PRODUCT_VERSION "@MAJOR@.@MINOR@.@BUILD@.@PATCH@"
-#endif
 #define LAST_CHANGE "@LASTCHANGE@"
 #define IS_OFFICIAL_BUILD @OFFICIAL_BUILD@
 

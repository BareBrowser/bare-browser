+
+    /**
+     * Downloads the picture, then its sound, and joins them once both have finished.
+     *
+     * <p>Each download may ask where to save it, on a card, and only one such question can be
+     * open at a time. So only the picture is asked about. The sound is started once the user has
+     * answered that card and the picture is coming in, and it goes to the default folder without
+     * asking; it is removed again once it is inside the video.
+     *
+     * <p>A download handed to another app, such as an external download manager, never shows up
+     * here and asks nothing. When no card comes up and the picture does not appear, the sound is
+     * sent the same way, and the user is told it is a second file. When the user cancels the card,
+     * the sound is not downloaded.
+     */
+    private static final class JoinWatch implements OfflineContentProvider.Observer {
+        private static final long POLL_MS = 500;
+        private static final long NO_CARD_MS = 3_000;
+        private static final long ANSWER_MS = 10 * 60_000;
+        private static final long APPEAR_MS = 30_000;
+        private static final long FINISH_MS = 60 * 60_000;
+
+        private final View mRoot;
+        private final GURL mVideo;
+        private final GURL mAudio;
+        private final Downloader mDownloader;
+        private final long mStartedAt = System.currentTimeMillis();
+        private final long mStartedUptime = SystemClock.uptimeMillis();
+        private final long mDeadline = mStartedUptime + FINISH_MS;
+        private @Nullable OfflineItem mVideoItem;
+        private @Nullable OfflineItem mAudioItem;
+        private boolean mDone;
+        private boolean mSawCard;
+        private long mCardClosedAt;
+        private boolean mAudioStarted;
+
+        JoinWatch(View root, GURL video, GURL audio, Downloader downloader) {
+            mRoot = root;
+            mVideo = video;
+            mAudio = audio;
+            mDownloader = downloader;
+        }
+
+        void start() {
+            OfflineContentAggregatorFactory.get().addObserver(this);
+            mDownloader.download(mVideo);
+            PostTask.postDelayedTask(TaskTraits.UI_DEFAULT, this::poll, POLL_MS);
+        }
+
+        /** Decides when to start the sound, while the picture's save card may be open. */
+        private void poll() {
+            if (mDone || mAudioStarted) return;
+            long now = SystemClock.uptimeMillis();
+            if (RiseSheet.isOpen()) {
+                mSawCard = true;
+                mCardClosedAt = 0;
+            } else if (pictureIsComing()) {
+                startAudio(/* external= */ false);
+                return;
+            } else if (!mSawCard && mVideoItem == null && now - mStartedUptime > NO_CARD_MS) {
+                // No card and no download here: another app took the picture.
+                startAudio(/* external= */ true);
+                return;
+            } else if (mSawCard) {
+                if (mCardClosedAt == 0) mCardClosedAt = now;
+                // The card closed and nothing came in: the user cancelled it.
+                if (now - mCardClosedAt > NO_CARD_MS) {
+                    stop();
+                    return;
+                }
+            }
+            if (now - mStartedUptime > ANSWER_MS) {
+                stop();
+                return;
+            }
+            PostTask.postDelayedTask(TaskTraits.UI_DEFAULT, this::poll, POLL_MS);
+        }
+
+        /** Whether the picture's save location is settled and its bytes are arriving. */
+        private boolean pictureIsComing() {
+            OfflineItem video = mVideoItem;
+            if (video == null) return false;
+            return video.receivedBytes > 0 || video.state == OfflineItemState.COMPLETE;
+        }
+
+        private void startAudio(boolean external) {
+            mAudioStarted = true;
+            if (external) {
+                mDownloader.download(mAudio);
+                tell(mRoot, R.string.bare_video_saved_two_files);
+                stop();
+                return;
+            }
+            BareDownloadCard.skipNextPrompt();
+            // The sound file is removed once it is inside the video, so it gets no finished card.
+            String soundName = new java.io.File(mAudio.getPath()).getName();
+            if (!soundName.isEmpty()) BareDownloadNotice.keepQuiet(soundName);
+            mDownloader.download(mAudio);
+            PostTask.postDelayedTask(
+                    TaskTraits.UI_DEFAULT,
+                    () -> {
+                        if (mAudioItem == null) stop();
+                    },
+                    APPEAR_MS);
+            see(null);
+        }
+
+        private void stop() {
+            if (mDone) return;
+            mDone = true;
+            OfflineContentAggregatorFactory.get().removeObserver(this);
+        }
+
+        private boolean isOurs(OfflineItem item, GURL url) {
+            if (item.creationTimeMs != 0 && item.creationTimeMs < mStartedAt - 5_000) return false;
+            return url.equals(item.originalUrl) || url.equals(item.url);
+        }
+
+        private void see(@Nullable OfflineItem item) {
+            if (mDone) return;
+            if (item != null) {
+                if (mVideoItem == null && isOurs(item, mVideo)) {
+                    mVideoItem = item;
+                } else if (mAudioStarted && mAudioItem == null && isOurs(item, mAudio)) {
+                    mAudioItem = item;
+                }
+                if (mVideoItem != null && mVideoItem.id != null && mVideoItem.id.equals(item.id)) {
+                    mVideoItem = item;
+                }
+                if (mAudioItem != null && mAudioItem.id != null && mAudioItem.id.equals(item.id)) {
+                    mAudioItem = item;
+                }
+            }
+            OfflineItem video = mVideoItem;
+            if (video != null && failed(video)) {
+                stop();
+                return;
+            }
+            OfflineItem audio = mAudioItem;
+            if (video == null || audio == null) return;
+            if (failed(video) || failed(audio) || SystemClock.uptimeMillis() > mDeadline) {
+                stop();
+                return;
+            }
+            if (video.state == OfflineItemState.COMPLETE && audio.state == OfflineItemState.COMPLETE) {
+                stop();
+                join(video, audio);
+            }
+        }
+
+        private static boolean failed(OfflineItem item) {
+            return item.state == OfflineItemState.FAILED
+                    || item.state == OfflineItemState.CANCELLED
+                    || item.externallyRemoved;
+        }
+
+        private void join(OfflineItem video, OfflineItem audio) {
+            ContentId videoId = video.id;
+            ContentId audioId = audio.id;
+            if (videoId == null || audioId == null) return;
+            OfflineContentProvider provider = OfflineContentAggregatorFactory.get();
+            // A finished download may have moved from where it was written to where it is
+            // published, so ask for both again.
+            provider.getItemById(
+                    videoId,
+                    currentVideo ->
+                            provider.getItemById(
+                                    audioId,
+                                    currentAudio -> joinFiles(currentVideo, currentAudio)));
+        }
+
+        private void joinFiles(@Nullable OfflineItem video, @Nullable OfflineItem audio) {
+            if (video == null || audio == null) {
+                tell(mRoot, R.string.bare_video_saved_two_files);
+                return;
+            }
+            String picture = video.filePath;
+            String sound = audio.filePath;
+            if (picture == null || sound == null || picture.isEmpty() || sound.isEmpty()) {
+                tell(mRoot, R.string.bare_video_saved_two_files);
+                return;
+            }
+            joinPaths(picture, sound, audio.id);
+        }
+
+        private void joinPaths(String picture, String sound, @Nullable ContentId audioId) {
+            Context context = ContextUtils.getApplicationContext();
+            PostTask.postTask(
+                    TaskTraits.USER_VISIBLE_MAY_BLOCK,
+                    () -> {
+                        boolean joined = BareVideoJoiner.joinInto(context, picture, sound);
+                        PostTask.postTask(
+                                TaskTraits.UI_DEFAULT,
+                                () -> {
+                                    if (joined) {
+                                        // The sound is inside the video now; its own file would
+                                        // only be a second copy of it.
+                                        if (audioId != null) {
+                                            OfflineContentAggregatorFactory.get()
+                                                    .removeItem(audioId);
+                                        }
+                                        tell(mRoot, R.string.bare_video_saved_with_sound);
+                                    } else {
+                                        tell(mRoot, R.string.bare_video_saved_two_files);
+                                    }
+                                });
+                    });
+        }
+
+        @Override
+        public void onItemsAdded(List<OfflineItem> items) {
+            for (OfflineItem item : items) see(item);
+        }
+
+        @Override
+        public void onItemRemoved(ContentId id) {
+            if ((mVideoItem != null && id.equals(mVideoItem.id))
+                    || (mAudioItem != null && id.equals(mAudioItem.id))) {
+                stop();
+            }
+        }
+
+        @Override
+        public void onItemUpdated(OfflineItem item, @Nullable UpdateDelta updateDelta) {
+            see(item);
+        }
     }
 }

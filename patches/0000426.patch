+
+    private static void tell(View root, String text, int triesLeft) {
+        if (RiseSheet.showMessage(root, text, null, null, null) || triesLeft <= 0) return;
+        PostTask.postDelayedTask(
+                TaskTraits.UI_DEFAULT, () -> tell(root, text, triesLeft - 1), 1000);

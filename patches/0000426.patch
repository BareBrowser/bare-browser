+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.bare;
+
+import android.content.Context;
+import android.media.MediaCodec;
+import android.media.MediaExtractor;
+import android.media.MediaFormat;
+import android.media.MediaMuxer;
+import android.net.Uri;
+import android.os.ParcelFileDescriptor;
+
+import org.chromium.base.Log;
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+
+import java.io.File;
+import java.io.FileInputStream;
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.OutputStream;
+import java.io.RandomAccessFile;
+import java.nio.ByteBuffer;
+
+/**
+ * Joins a picture-only mp4 and a sound-only mp4 into one mp4, with Android's own MediaExtractor and
+ * MediaMuxer. Nothing is decoded or re-encoded: the samples are copied as they are, so it takes
+ * about a second for a short clip. Streaming sites keep picture and sound in separate fragmented
+ * files; MediaExtractor reads those, and MediaMuxer writes an ordinary mp4.
+ *
+ * <p>MediaMuxer only writes the codecs an mp4 may hold on this Android version (H.264, H.265, and
+ * AV1 from Android 14, with AAC sound). A VP9 picture, for one, is refused, and the caller then
+ * keeps the two files as they are.
+ */
+@NullMarked
+final class BareVideoJoiner {
+    private static final String TAG = "BareVideoJoin";
+    private static final int START_BUFFER = 1 << 20;
+    private static final int MAX_SAMPLE = 32 << 20;
+
+    private BareVideoJoiner() {}
+
+    /**
+     * Joins {@code picture} and {@code sound} (content addresses or file paths) and writes the
+     * result over {@code picture}. Returns whether it did. On failure {@code picture} is left as it
+     * was. Runs on a background thread.
+     */
+    static boolean joinInto(Context context, String picture, String sound) {
+        File joined = new File(context.getCacheDir(), "bare-video-join.mp4");
+        try {
+            if (!join(context, picture, sound, joined)) return false;
+            if (!looksPlayable(joined)) return false;
+            copy(joined, context, picture);
+            return true;
+        } catch (IOException | RuntimeException e) {
+            Log.w(TAG, "Could not join picture and sound", e);
+            return false;
+        } finally {
+            joined.delete();
+        }
+    }
+
+    private static boolean join(Context context, String picture, String sound, File out)
+            throws IOException {
+        MediaExtractor video = new MediaExtractor();
+        MediaExtractor audio = new MediaExtractor();
+        ParcelFileDescriptor videoFd = null;
+        ParcelFileDescriptor audioFd = null;
+        MediaMuxer muxer = null;
+        boolean started = false;
+        try (RandomAccessFile file = new RandomAccessFile(out, "rw")) {
+            file.setLength(0);
+            videoFd = openRead(context, picture);
+            audioFd = openRead(context, sound);
+            video.setDataSource(videoFd.getFileDescriptor());
+            audio.setDataSource(audioFd.getFileDescriptor());
+            int videoTrack = track(video, "video/");
+            int audioTrack = track(audio, "audio/");
+            if (videoTrack < 0 || audioTrack < 0) return false;
+            MediaFormat videoFormat = video.getTrackFormat(videoTrack);
+            MediaFormat audioFormat = audio.getTrackFormat(audioTrack);
+            video.selectTrack(videoTrack);
+            audio.selectTrack(audioTrack);
+
+            muxer = new MediaMuxer(file.getFD(), MediaMuxer.OutputFormat.MUXER_OUTPUT_MPEG_4);
+            if (videoFormat.containsKey(MediaFormat.KEY_ROTATION)) {
+                muxer.setOrientationHint(videoFormat.getInteger(MediaFormat.KEY_ROTATION));
+            }
+            int outVideo;
+            int outAudio;
+            try {
+                outVideo = muxer.addTrack(videoFormat);
+                outAudio = muxer.addTrack(audioFormat);
+            } catch (IllegalStateException | IllegalArgumentException e) {
+                // A codec an mp4 cannot hold on this Android version.
+                Log.i(TAG, "Codec not supported for joining: " + videoFormat.getString(
+                        MediaFormat.KEY_MIME) + " + " + audioFormat.getString(MediaFormat.KEY_MIME));
+                return false;
+            }
+            muxer.start();
+            started = true;
+
+            ByteBuffer buffer = ByteBuffer.allocateDirect(START_BUFFER);
+            MediaCodec.BufferInfo info = new MediaCodec.BufferInfo();
+            long videoSamples = 0;
+            long audioSamples = 0;
+            // Samples are written in time order across the two tracks, so a player reading the
+            // file from the start finds picture and sound together.
+            while (true) {
+                long videoTime = video.getSampleTime();
+                long audioTime = audio.getSampleTime();
+                if (videoTime < 0 && audioTime < 0) break;
+                boolean takeVideo = audioTime < 0 || (videoTime >= 0 && videoTime <= audioTime);
+                MediaExtractor from = takeVideo ? video : audio;
+                long size = from.getSampleSize();
+                if (size > MAX_SAMPLE) return false;
+                if (size > buffer.capacity()) buffer = ByteBuffer.allocateDirect((int) size);
+                buffer.clear();
+                int read = from.readSampleData(buffer, 0);
+                if (read < 0) {
+                    from.unselectTrack(takeVideo ? videoTrack : audioTrack);
+                    continue;
+                }
+                int flags =
+                        (from.getSampleFlags() & MediaExtractor.SAMPLE_FLAG_SYNC) != 0
+                                ? MediaCodec.BUFFER_FLAG_KEY_FRAME
+                                : 0;
+                info.set(0, read, from.getSampleTime(), flags);
+                muxer.writeSampleData(takeVideo ? outVideo : outAudio, buffer, info);
+                if (takeVideo) videoSamples++;
+                else audioSamples++;
+                from.advance();
+            }
+            muxer.stop();
+            started = false;
+            return videoSamples > 0 && audioSamples > 0;
+        } finally {
+            if (muxer != null) {
+                try {
+                    if (started) muxer.stop();
+                } catch (IllegalStateException e) {
+                    // Already failed; the file is discarded.
+                }
+                muxer.release();
+            }
+            video.release();
+            audio.release();
+            closeQuietly(videoFd);
+            closeQuietly(audioFd);
+        }
+    }
+
+    /** Whether the joined file reads back with a picture track and a sound track. */
+    private static boolean looksPlayable(File file) throws IOException {
+        MediaExtractor check = new MediaExtractor();
+        try {
+            check.setDataSource(file.getAbsolutePath());
+            return track(check, "video/") >= 0 && track(check, "audio/") >= 0;
+        } finally {
+            check.release();
+        }
+    }
+
+    private static int track(MediaExtractor extractor, String prefix) {
+        for (int i = 0; i < extractor.getTrackCount(); i++) {
+            String mime = extractor.getTrackFormat(i).getString(MediaFormat.KEY_MIME);
+            if (mime != null && mime.startsWith(prefix)) return i;
+        }
+        return -1;
+    }
+
+    private static ParcelFileDescriptor openRead(Context context, String where)
+            throws IOException {
+        if (where.startsWith("content:")) {
+            ParcelFileDescriptor fd =
+                    context.getContentResolver().openFileDescriptor(Uri.parse(where), "r");
+            if (fd == null) throw new IOException("no descriptor");
+            return fd;
+        }
+        return ParcelFileDescriptor.open(new File(where), ParcelFileDescriptor.MODE_READ_ONLY);
+    }
+
+    /** Writes {@code from} over the download at {@code to}, replacing what was there. */
+    private static void copy(File from, Context context, String to) throws IOException {
+        try (InputStream in = new FileInputStream(from);
+                OutputStream out = openWrite(context, to)) {
+            byte[] buffer = new byte[256 * 1024];
+            int read;
+            while ((read = in.read(buffer)) > 0) out.write(buffer, 0, read);
+        }
+    }
+
+    private static OutputStream openWrite(Context context, String where) throws IOException {
+        if (where.startsWith("content:")) {
+            OutputStream out = context.getContentResolver().openOutputStream(Uri.parse(where), "wt");
+            if (out == null) throw new IOException("no stream");
+            return out;
+        }
+        return new FileOutputStream(where, false);
+    }
+
+    private static void closeQuietly(@Nullable ParcelFileDescriptor fd) {
+        if (fd == null) return;
+        try {
+            fd.close();
+        } catch (IOException e) {
+            // Nothing to do.
+        }
+    }
+}

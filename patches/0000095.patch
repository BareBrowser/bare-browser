diff --git a/chrome/browser/extensions/bare_bundled_extensions_loader.cc b/chrome/browser/extensions/bare_bundled_extensions_loader.cc
index c95c75ec36b..3bf563eccfe 100644
--- a/chrome/browser/extensions/bare_bundled_extensions_loader.cc
+++ b/chrome/browser/extensions/bare_bundled_extensions_loader.cc
@@ -2,6 +2,14 @@
 // Use of this source code is governed by a BSD-style license that can be
 // found in the LICENSE file.
 
+#include "base/memory/raw_ptr.h"
+#include "base/scoped_observation.h"
+#include "base/task/single_thread_task_runner.h"
+#include "chrome/browser/extensions/extension_util.h"
+#include "content/public/browser/browser_context.h"
+#include "extensions/browser/extension_prefs.h"
+#include "extensions/browser/extension_registry.h"
+#include "extensions/browser/extension_registry_observer.h"
 #include "chrome/browser/extensions/bare_bundled_extensions_loader.h"
 
 #include <stdint.h>
@@ -112,6 +120,88 @@ base::DictValue BuildPrefs() {
 
 }  // namespace
 
+// Waits for the bundled blocker to load, applies the default once, then goes
+// away. It owns itself because there is nothing here with a profile's lifetime
+// to hang it on, and it has one job.
+class BundledIncognitoDefaultApplier : public ExtensionRegistryObserver {
+ public:
+  static void Start(content::BrowserContext* context) {
+    new BundledIncognitoDefaultApplier(context);  // Deletes itself.
+  }
+
+  BundledIncognitoDefaultApplier(const BundledIncognitoDefaultApplier&) =
+      delete;
+  BundledIncognitoDefaultApplier& operator=(
+      const BundledIncognitoDefaultApplier&) = delete;
+
+  // Public so DeleteSoon can reach it.
+  ~BundledIncognitoDefaultApplier() override = default;
+
+ private:
+  explicit BundledIncognitoDefaultApplier(content::BrowserContext* context)
+      : context_(context) {
+    ExtensionRegistry* registry = ExtensionRegistry::Get(context_);
+    observation_.Observe(registry);
+    if (registry->enabled_extensions().GetByID(kUBlockOriginId)) {
+      Apply();  // Already loaded, so no event is coming.
+    }
+  }
+
+  void OnExtensionLoaded(content::BrowserContext* browser_context,
+                         const Extension* extension) override {
+    if (extension->id() == kUBlockOriginId) {
+      Apply();
+    }
+  }
+
+  void OnShutdown(ExtensionRegistry* registry) override { Finish(); }
+
+  void Apply() {
+    if (done_) {
+      return;
+    }
+    // Detach before doing anything else. Granting incognito access reloads the
+    // extension, which would otherwise arrive back here as another
+    // OnExtensionLoaded while this object was midway through deleting itself.
+    done_ = true;
+    observation_.Reset();
+
+    ExtensionPrefs* prefs = ExtensionPrefs::Get(context_);
+    bool unused = false;
+    // "incognito" is written only by SetIsIncognitoEnabled, so the key being
+    // present at all means the question has already been answered and the
+    // answer is the user's, whichever way it went. Only its absence is open,
+    // and answering it writes the key, so this happens exactly once per
+    // profile: a fresh install gets the default, an existing profile that has
+    // never been asked gets it on the next launch, and anyone who has since
+    // turned it off keeps it off.
+    if (!prefs->ReadPrefAsBoolean(kUBlockOriginId, "incognito", &unused)) {
+      util::SetIsIncognitoEnabled(kUBlockOriginId, context_, true);
+    }
+    Finish();
+  }
+
+  void Finish() {
+    observation_.Reset();
+    base::SingleThreadTaskRunner::GetCurrentDefault()->DeleteSoon(FROM_HERE,
+                                                                 this);
+  }
+
+  raw_ptr<content::BrowserContext> context_;
+  bool done_ = false;
+  base::ScopedObservation<ExtensionRegistry, ExtensionRegistryObserver>
+      observation_{this};
+};
+
+void ApplyBundledExtensionIncognitoDefault(content::BrowserContext* context) {
+  // Bare: the bundled blocker is allowed in incognito out of the box. A
+  // blocker that stops at the incognito boundary is a surprise rather than a
+  // safeguard. Nothing else is granted anything: every other extension keeps
+  // Chromium's default of no incognito access until the user says otherwise in
+  // chrome://extensions, and that same control turns this one off again.
+  BundledIncognitoDefaultApplier::Start(context);
+}
+
 BareBundledExtensionsLoader::BareBundledExtensionsLoader() = default;
 
 BareBundledExtensionsLoader::~BareBundledExtensionsLoader() = default;
diff --git a/chrome/browser/extensions/bare_bundled_extensions_loader.h b/chrome/browser/extensions/bare_bundled_extensions_loader.h
index 7ee92e373a6..22a35eaa125 100644
--- a/chrome/browser/extensions/bare_bundled_extensions_loader.h
+++ b/chrome/browser/extensions/bare_bundled_extensions_loader.h
@@ -8,6 +8,10 @@
 #include "base/values.h"
 #include "chrome/browser/extensions/external_loader.h"
 
+namespace content {
+class BrowserContext;
+}  // namespace content
+
 namespace extensions {
 
 // Offers the extensions Bare ships inside the apk to the external provider
@@ -36,6 +40,10 @@ class BareBundledExtensionsLoader : public ExternalLoader {
   void OnPrefsBuilt(base::DictValue prefs);
 };
 
+// Gives the bundled blocker incognito access the first time it is seen, and
+// never again. Safe to call on every startup.
+void ApplyBundledExtensionIncognitoDefault(content::BrowserContext* context);
+
 }  // namespace extensions
 
 #endif  // CHROME_BROWSER_EXTENSIONS_BARE_BUNDLED_EXTENSIONS_LOADER_H_
diff --git a/chrome/browser/extensions/external_provider_impl.cc b/chrome/browser/extensions/external_provider_impl.cc
index f4da5976ced..7b6caa6b612 100644
--- a/chrome/browser/extensions/external_provider_impl.cc
+++ b/chrome/browser/extensions/external_provider_impl.cc
@@ -955,6 +955,7 @@ void ExternalProviderImpl::CreateExternalProviders(
       service, base::MakeRefCounted<BareBundledExtensionsLoader>(), profile,
       ManifestLocation::kExternalPref, ManifestLocation::kExternalPrefDownload,
       Extension::NO_FLAGS));
+  ApplyBundledExtensionIncognitoDefault(profile);
 #endif
 
 #if BUILDFLAG(ENABLE_EXTENSIONS)

From 27efbc2ccd9c3efbe61b06c7af88c614d293fcac Mon Sep 17 00:00:00 2001
From: Bare <git@barebrowser.org>
Date: Sun, 16 Aug 2026 02:11:13 +0000
Subject: [PATCH] Hide the Google Password Manager row and sign-in promo

Autofill and passwords showed a Google Password Manager row permanently labelled "Stopped working on this device" with an error icon, above a Sign in to Chrome promo card.

Neither works in this build and neither can. PasswordManagerBackendSupportHelper.isBackendPresent() returns false in public Chromium, so IsPasswordManagerAvailable() is already false and PasswordsPreference deliberately renders the failure state rather than hiding the row. Sign-in is likewise unavailable without Google API keys.

Hides the passwords row outright and stops constructing the sign-in promo coordinator. Both remaining references to the coordinator are null-guarded, so nothing dangles.

Verified on device: the page now shows only Payments, Contact info, Identity docs, Travel and Autofill settings, with no crash.
---
 .../autofill/settings/AutofillAndPasswordsFragment.java   | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/chrome/android/java/src/org/chromium/chrome/browser/autofill/settings/AutofillAndPasswordsFragment.java b/chrome/android/java/src/org/chromium/chrome/browser/autofill/settings/AutofillAndPasswordsFragment.java
index 0b55d6975a3..5393c6e9c51 100644
--- a/chrome/android/java/src/org/chromium/chrome/browser/autofill/settings/AutofillAndPasswordsFragment.java
+++ b/chrome/android/java/src/org/chromium/chrome/browser/autofill/settings/AutofillAndPasswordsFragment.java
@@ -171,7 +171,8 @@ public class AutofillAndPasswordsFragment extends ChromeBaseSettingsFragment {
 
         SettingsUtils.addPreferencesFromResource(this, R.xml.autofill_and_passwords_preferences);
 
-        setupSignInPromo();
+        // De-Googled build: the sign-in promo card is not shown. Sign-in does not
+        // function here, so the card only advertises an unavailable feature.
 
         Preference personalContextPref = findPreference(PREF_AUTOFILL_PERSONAL_CONTEXT);
         personalContextPref.setVisible(
@@ -186,7 +187,12 @@ public class AutofillAndPasswordsFragment extends ChromeBaseSettingsFragment {
                     return true;
                 });
 
+        // De-Googled build: hide the Google Password Manager row. Its backend is
+        // the internal Google one, which PasswordManagerBackendSupportHelper
+        // reports as absent in a public build, so the row would otherwise render
+        // permanently as "Stopped working on this device" with an error icon.
         PasswordsPreference passwordsPreference = findPreference(PREF_PASSWORDS);
+        passwordsPreference.setVisible(false);
         passwordsPreference.setProfile(getProfile());
         passwordsPreference.setManagedPreferenceDelegate(createManagedPreferenceDelegate());
         passwordsPreference.setOnPreferenceClickListener(

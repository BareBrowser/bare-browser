From 6b6187e2486c5a4e7bc974ae20f3f8b15dabbb1f Mon Sep 17 00:00:00 2001
From: Bare <git@barebrowser.org>
Date: Sat, 22 Aug 2026 15:43:08 +0000
Subject: [PATCH] Patch 0000075

---
 components/omnibox/browser/autocomplete_result.cc  |    9 +++++++--
 .../zero_suggest_verbatim_match_provider.cc        |    9 ++++++++-
 2 files changed, 15 insertions(+), 3 deletions(-)

diff --git a/components/omnibox/browser/autocomplete_result.cc b/components/omnibox/browser/autocomplete_result.cc
index 0ec4c826bf2..4c9fda5df71 100644
--- a/components/omnibox/browser/autocomplete_result.cc
+++ b/components/omnibox/browser/autocomplete_result.cc
@@ -79,8 +79,13 @@ using AutocompleteMatchType = omnibox::AutocompleteMatchType;
 namespace {
 
 constexpr bool is_android_any = !!BUILDFLAG(IS_ANDROID);
-constexpr bool is_android_desktop = !!BUILDFLAG(IS_DESKTOP_ANDROID);
-constexpr bool is_android_mobile = is_android_any && !is_android_desktop;
+// De-Googled build: count every Android build as mobile for shaping the list.
+//
+// These have to stay constexpr, so this cannot ask the device. Bare is built from the desktop
+// Android target and ships to phones, and with this false is_desktop below becomes true, which
+// applies desktop grouping and limits and drops the verbatim match that the current page row is
+// built from.
+constexpr bool is_android_mobile = is_android_any;
 constexpr bool is_ios = !!BUILDFLAG(IS_IOS);
 constexpr bool is_desktop = !(is_android_mobile || is_ios);
 
diff --git a/components/omnibox/browser/zero_suggest_verbatim_match_provider.cc b/components/omnibox/browser/zero_suggest_verbatim_match_provider.cc
index f3775921610..b6d9924bcf5 100644
--- a/components/omnibox/browser/zero_suggest_verbatim_match_provider.cc
+++ b/components/omnibox/browser/zero_suggest_verbatim_match_provider.cc
@@ -44,7 +44,14 @@ bool IsVerbatimMatchEligible(
     return true;
   }
 
-  if (is_desktop_android) {
+  // De-Googled build: ask the device, not the build target.
+  //
+  // Bare is built from the desktop Android target and runs mostly on phones. The verbatim match
+  // is what places the current page at the head of the list, and the row offering share, copy and
+  // edit is built from it, so declining it for the whole target removed those actions everywhere.
+  // A real tablet or desktop still declines, which was the point of the original check.
+  if (is_desktop_android &&
+      ui::GetDeviceFormFactor() != ui::DEVICE_FORM_FACTOR_PHONE) {
     return false;
   }
 

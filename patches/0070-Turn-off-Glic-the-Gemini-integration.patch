From 3e5ea8b593cddaa7ca580e8a84f024c951c697f8 Mon Sep 17 00:00:00 2001
From: Bare <git@barebrowser.org>
Date: Sat, 22 Aug 2026 04:59:04 +0000
Subject: [PATCH] Turn off Glic, the Gemini integration

An unfolded Pixel Fold showed an "Ask Gemini" button in the tab strip, and
tapping it opened a Google account verification sheet. Patches 0019 and 0021
had removed the bottom bar action and the toolbar shortcut setting, both phone
surfaces. The tab strip only draws above a certain width, so on a phone the
button never appeared and those two looked like full coverage.

Rather than remove that one button, close the gate. GlicEnabling is what every
Glic surface asks before offering itself, so six predicates returning false
takes out the tab strip button and its long-press menu, the app menu item, the
link and image context menu, the text selection menu, and the settings entry
together. Verified on the Fold: the tab strip trailing area now holds only the
new tab button, and the app menu is down to its eleven real items.

wasPreviouslyNotAllowed, isDisabledByPolicy, isProfileManaged and
isPolicyEnforced are left alone. They report why the feature is unavailable
rather than whether to show it, and forcing them would misdescribe the state.

The feature could never work here anyway: it needs a signed-in Google account,
so the only thing those entry points did was ask the user to identify
themselves to Google.
---
 .../chrome/browser/glic/GlicEnabling.java     | 20 +++++++++++++++++++
 1 file changed, 20 insertions(+)

diff --git a/chrome/browser/glic/public/android/java/src/org/chromium/chrome/browser/glic/GlicEnabling.java b/chrome/browser/glic/public/android/java/src/org/chromium/chrome/browser/glic/GlicEnabling.java
index d88179d7c5e..79acfe29999 100644
--- a/chrome/browser/glic/public/android/java/src/org/chromium/chrome/browser/glic/GlicEnabling.java
+++ b/chrome/browser/glic/public/android/java/src/org/chromium/chrome/browser/glic/GlicEnabling.java
@@ -20,11 +20,26 @@ public class GlicEnabling {
 
     private static @Nullable Boolean sIsEnabledForTesting;
 
+    /**
+     * De-Googled build: Glic, the Gemini integration, is off everywhere.
+     *
+     * <p>Every Glic surface asks this class first, so closing the gate here removes all of them
+     * at once rather than one entry point at a time: the tab strip button and its menu, the app
+     * menu item, the link and text selection menus, and the settings page. Patch 0019 removed
+     * the bottom bar action separately because that one never consults this class.
+     *
+     * <p>The feature cannot work in this build regardless. It requires a signed-in Google
+     * account, so the only thing the buttons did was open a sheet asking the user to verify
+     * their identity to Google.
+     */
+    private static final boolean GLIC_ENABLED = false;
+
     /**
      * Returns whether the global Glic feature is enabled for Chrome. This status will not change at
      * runtime.
      */
     public static boolean isEnabledByFlags() {
+        if (!GLIC_ENABLED) return false;
         if (sIsEnabledForTesting != null) return sIsEnabledForTesting;
         return GlicEnablingJni.get().isEnabledByFlags();
     }
@@ -35,6 +50,7 @@ public class GlicEnabling {
      * #isEnabledByFlags()} is off. This will never change for a given profile.
      */
     public static boolean isProfileEligible(@Nullable Profile profile) {
+        if (!GLIC_ENABLED) return false;
         if (profile == null) return false;
         if (sIsEnabledForTesting != null) return sIsEnabledForTesting;
         return GlicEnablingJni.get().isProfileEligible(profile);
@@ -42,6 +58,7 @@ public class GlicEnabling {
 
     /** Returns true if the given profile has Glic enabled. This value can change at runtime. */
     public static boolean isEnabledForProfile(@Nullable Profile profile) {
+        if (!GLIC_ENABLED) return false;
         if (profile == null) return false;
         if (sIsEnabledForTesting != null) return sIsEnabledForTesting;
         return GlicEnablingJni.get().isEnabledForProfile(profile);
@@ -56,6 +73,7 @@ public class GlicEnabling {
 
     /** Returns true if the Glic settings page should be shown for the given profile. */
     public static boolean shouldShowSettingsPage(@Nullable Profile profile) {
+        if (!GLIC_ENABLED) return false;
         if (profile == null) return false;
         if (sIsEnabledForTesting != null) return sIsEnabledForTesting;
         return GlicEnablingJni.get().shouldShowSettingsPage(profile);
@@ -63,6 +81,7 @@ public class GlicEnabling {
 
     /** Returns true if the web actuation / auto browse toggle should be shown for the profile. */
     public static boolean shouldShowWebActuationToggle(@Nullable Profile profile) {
+        if (!GLIC_ENABLED) return false;
         if (profile == null) return false;
         if (sIsEnabledForTesting != null) return sIsEnabledForTesting;
         return GlicEnablingJni.get().shouldShowWebActuationToggle(profile);
@@ -80,6 +99,7 @@ public class GlicEnabling {
 
     /** Returns true if Glic is ready to be used for the given profile. */
     public static boolean isReadyForProfile(@Nullable Profile profile) {
+        if (!GLIC_ENABLED) return false;
         if (profile == null) return false;
         if (sIsEnabledForTesting != null) return sIsEnabledForTesting;
         return GlicEnablingJni.get().isReadyForProfile(profile);

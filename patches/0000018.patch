Subject: [PATCH] Patch 0000018

---
 .../ui/bottombar/BottomBarActionEligibility.java    | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/chrome/browser/ui/android/bottombar/java/src/org/chromium/chrome/browser/ui/bottombar/BottomBarActionEligibility.java b/chrome/browser/ui/android/bottombar/java/src/org/chromium/chrome/browser/ui/bottombar/BottomBarActionEligibility.java
index 75a5a23ccae..8eb241f2b00 100644
--- a/chrome/browser/ui/android/bottombar/java/src/org/chromium/chrome/browser/ui/bottombar/BottomBarActionEligibility.java
+++ b/chrome/browser/ui/android/bottombar/java/src/org/chromium/chrome/browser/ui/bottombar/BottomBarActionEligibility.java
@@ -19,6 +19,14 @@ public class BottomBarActionEligibility {
     /** Represents a sentinel value indicating that no action is eligible. */
     public static final @ActionId int ACTION_NONE = ActionId.NONE;
 
+    /**
+     * De-Googled build: the bottom bar extra slot stays empty.
+     *
+     * <p>The only action it can resolve to is GLIC, the Ask Gemini button, which opens a sheet
+     * demanding Google account verification and can do nothing here.
+     */
+    private static final boolean SHOW_BOTTOM_BAR_EXTRA_ACTION = false;
+
     private static @Nullable @ActionId Integer sCachedCandidateExtraAction;
 
     /** Returns the currently cached candidate extra action, or null if uninitialized. */
@@ -69,6 +77,11 @@ public class BottomBarActionEligibility {
      */
     @ActionId
     public static int getCandidateExtraAction(@Nullable Profile profile) {
+        if (!SHOW_BOTTOM_BAR_EXTRA_ACTION) {
+            sCachedCandidateExtraAction = ACTION_NONE;
+            return ACTION_NONE;
+        }
+
         if (profile == null) {
             return ACTION_NONE;
         }

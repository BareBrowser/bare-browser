From d217d9a352a28089977b8a0c17423e909aa6ee69 Mon Sep 17 00:00:00 2001
From: Bare <git@barebrowser.org>
Date: Sun, 16 Aug 2026 08:19:46 +0000
Subject: [PATCH] Patch 0000018

---
 .../bottombar/BottomBarActionEligibility.java | 22 +++++++++++++++++++
 1 file changed, 22 insertions(+)

diff --git a/chrome/browser/ui/android/bottombar/java/src/org/chromium/chrome/browser/ui/bottombar/BottomBarActionEligibility.java b/chrome/browser/ui/android/bottombar/java/src/org/chromium/chrome/browser/ui/bottombar/BottomBarActionEligibility.java
index 2aea1a2d1ce..19cfc34b818 100644
--- a/chrome/browser/ui/android/bottombar/java/src/org/chromium/chrome/browser/ui/bottombar/BottomBarActionEligibility.java
+++ b/chrome/browser/ui/android/bottombar/java/src/org/chromium/chrome/browser/ui/bottombar/BottomBarActionEligibility.java
@@ -24,6 +24,17 @@ public class BottomBarActionEligibility {
     /** Represents a sentinel value indicating that no action is eligible. */
     public static final @ActionId int ACTION_NONE = ActionId.NONE;
 
+    /**
+     * De-Googled build: the bottom bar extra slot stays empty.
+     *
+     * <p>Both actions it can resolve to are Google surfaces. GLIC is the Ask Gemini button, which
+     * opens a sheet demanding Google account verification and can do nothing here. AI_MODE is
+     * already unreachable because it requires the default search engine to be Google and this
+     * build ships DuckDuckGo, but it is covered too, so that switching the search engine back
+     * does not quietly bring an AI button along with it.
+     */
+    private static final boolean SHOW_BOTTOM_BAR_EXTRA_ACTION = false;
+
     private static @Nullable @ActionId Integer sCachedCandidateExtraAction;
 
     /** Returns the currently cached candidate extra action, or null if uninitialized. */
@@ -79,6 +90,12 @@ public class BottomBarActionEligibility {
             return false;
         }
 
+        // De-Googled build: with the slot fixed empty the answer needs no country code, which a
+        // build that never fetches a variations seed may never receive.
+        if (!SHOW_BOTTOM_BAR_EXTRA_ACTION) {
+            return true;
+        }
+
         Profile originalProfile = profile.getOriginalProfile();
         String normalizedCountry = normalizeCountry(country);
         boolean bypassGlic = BottomBarConfigUtils.bypassGlicGeofencing();
@@ -134,6 +151,11 @@ public class BottomBarActionEligibility {
      */
     @ActionId
     public static int getCandidateExtraAction(@Nullable Profile profile, @Nullable String country) {
+        if (!SHOW_BOTTOM_BAR_EXTRA_ACTION) {
+            sCachedCandidateExtraAction = ACTION_NONE;
+            return ACTION_NONE;
+        }
+
         if (profile == null) {
             return ACTION_NONE;
         }

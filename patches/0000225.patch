diff --git a/chrome/android/java/src/org/chromium/chrome/browser/bare/BareClearVeil.java b/chrome/android/java/src/org/chromium/chrome/browser/bare/BareClearVeil.java
new file mode 100644
index 00000000000..bb7e43874a6
--- /dev/null
+++ b/chrome/android/java/src/org/chromium/chrome/browser/bare/BareClearVeil.java
@@ -0,0 +1,92 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.bare;
+
+import android.app.Activity;
+import android.view.LayoutInflater;
+import android.view.View;
+import android.view.ViewGroup;
+
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.chrome.R;
+import org.chromium.chrome.browser.preferences.ChromePreferenceKeys;
+import org.chromium.chrome.browser.preferences.ChromeSharedPreferences;
+
+/**
+ * The cover with the moving logo that hides the window while a clear on leaving or exit finishes.
+ *
+ * <p>The clear is marked pending in a preference before it starts and unmarked when it is over, so
+ * a process that is killed halfway leaves the mark for the next start to find and finish.
+ */
+@NullMarked
+public final class BareClearVeil {
+    /** The cover is taken down after this long even if the clear never reports back. */
+    private static final long GIVE_UP_MS = 15000;
+
+    /** How long the new tab is given to appear before the cover starts to fade. */
+    private static final long HOLD_MS = 400;
+
+    private static final long FADE_MS = 200;
+
+    private static @Nullable View sView;
+    private static boolean sRunning;
+
+    private BareClearVeil() {}
+
+    /** Whether a clear was started and has not finished, in this process or an earlier one. */
+    public static boolean isPending() {
+        return ChromeSharedPreferences.getInstance()
+                .readBoolean(ChromePreferenceKeys.BARE_CLEAR_VEIL_PENDING, false);
+    }
+
+    /** Whether the pending clear was started by this process. */
+    public static boolean isRunning() {
+        return sRunning;
+    }
+
+    /** Marks a clear as pending, and covers the window now if {@code showNow}. */
+    public static void begin(Activity activity, boolean showNow) {
+        ChromeSharedPreferences.getInstance()
+                .writeBoolean(ChromePreferenceKeys.BARE_CLEAR_VEIL_PENDING, true);
+        sRunning = showNow;
+        if (showNow) show(activity);
+    }
+
+    /** Covers the window. Does nothing if it is already covered. */
+    public static void show(Activity activity) {
+        View existing = sView;
+        if (existing != null && existing.getParent() != null) return;
+        ViewGroup content = activity.findViewById(android.R.id.content);
+        if (content == null) return;
+        View view =
+                LayoutInflater.from(activity).inflate(R.layout.bare_clear_veil, content, false);
+        content.addView(view);
+        sView = view;
+        view.postDelayed(() -> end(), GIVE_UP_MS);
+    }
+
+    /** The clear is over and the new tab is up: unmarks it and fades the cover away. */
+    public static void end() {
+        ChromeSharedPreferences.getInstance()
+                .writeBoolean(ChromePreferenceKeys.BARE_CLEAR_VEIL_PENDING, false);
+        sRunning = false;
+        View view = sView;
+        if (view == null) return;
+        sView = null;
+        view.postDelayed(
+                () ->
+                        view.animate()
+                                .alpha(0f)
+                                .setDuration(FADE_MS)
+                                .withEndAction(
+                                        () -> {
+                                            ViewGroup parent = (ViewGroup) view.getParent();
+                                            if (parent != null) parent.removeView(view);
+                                        })
+                                .start(),
+                HOLD_MS);
+    }
+}

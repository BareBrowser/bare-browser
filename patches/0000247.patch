+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.omnibox;
+
+import android.app.AlertDialog;
+import android.content.Context;
+
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.components.search_engines.StarterPackId;
+import org.chromium.components.search_engines.TemplateUrl;
+import org.chromium.components.search_engines.TemplateUrlService;
+
+import java.util.ArrayList;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Set;
+
+/**
+ * The list the address bar's search engine icon opens: picking an engine sends the next search to
+ * it without changing the default. Picking the default drops an earlier choice.
+ */
+@NullMarked
+public final class BareEnginePicker {
+    private BareEnginePicker() {}
+
+    /** Shows the list; the choice is held in {@link BareSearchOverride} for {@code owner}. */
+    public static @Nullable AlertDialog show(
+            Context context, TemplateUrlService service, Object owner) {
+        List<TemplateUrl> engines = new ArrayList<>();
+        Set<String> seen = new HashSet<>();
+        for (TemplateUrl tu : service.getTemplateUrls()) {
+            if (tu.getStarterPackId() != StarterPackId.NONE) continue;
+            if (tu.getKeyword().isEmpty() || !seen.add(tu.getShortName())) continue;
+            engines.add(tu);
+        }
+        if (engines.isEmpty()) return null;
+        @Nullable TemplateUrl defaultEngine = service.getDefaultSearchEngineTemplateUrl();
+        @Nullable String chosen = BareSearchOverride.getName();
+        String[] names = new String[engines.size()];
+        int checked = -1;
+        for (int i = 0; i < names.length; i++) {
+            TemplateUrl tu = engines.get(i);
+            names[i] = tu.getShortName();
+            boolean current =
+                    chosen != null
+                            ? tu.getShortName().equals(chosen)
+                            : defaultEngine != null && tu.getURL().equals(defaultEngine.getURL());
+            if (current) checked = i;
+        }
+        AlertDialog dialog =
+                new AlertDialog.Builder(context)
+                        .setTitle(R.string.bare_engine_once_title)
+                        .setSingleChoiceItems(
+                                names,
+                                checked,
+                                (d, which) -> {
+                                    d.dismiss();
+                                    TemplateUrl picked = engines.get(which);
+                                    if (defaultEngine != null
+                                            && picked.getURL().equals(defaultEngine.getURL())) {
+                                        BareSearchOverride.clear(owner);
+                                    } else {
+                                        BareSearchOverride.set(
+                                                owner, picked.getURL(), picked.getShortName());
+                                    }
+                                })
+                        .create();
+        dialog.show();
+        return dialog;
+    }
+}

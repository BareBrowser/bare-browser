             mLocationBarRect.offset(mTempPosition[0], mTempPosition[1]);
 
             int shadowHeight = mToolbarHairline.getHeight();
+            // Bare: with the toolbar at the bottom the hairline sits above it, not under it. The
+            // drawn copy would treat it as a shadow below, cut that much off and leave the hairline

index 00000000000..ebcf224e5d7
--- /dev/null
+++ b/chrome/android/java/src/org/chromium/chrome/browser/bare/BareBackupUpgradeOverlay.java
@@ -0,0 +1,98 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.bare;
+
+import android.app.Activity;
+import android.content.SharedPreferences;
+import android.view.LayoutInflater;
+import android.view.View;
+import android.view.ViewGroup;
+import android.view.ViewTreeObserver;
+
+import androidx.core.graphics.Insets;
+import androidx.core.view.ViewCompat;
+import androidx.core.view.WindowInsetsCompat;
+
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.chrome.R;
+import org.chromium.chrome.browser.bare.backup.BareAutoBackup;
+import org.chromium.chrome.browser.bare.backup.BareAutoBackupSetupFragment;
+import org.chromium.components.browser_ui.widget.RiseSheet;
+
+/**
+ * Shown once to someone who updated from a version without automatic backup: what it is, Set up
+ * backups, and Not now. It comes after What's new, and comes back at the next start until it has
+ * an answer. Not now leaves backups on Manual; nothing is written until the user sets them up.
+ */
+@NullMarked
+final class BareBackupUpgradeOverlay {
+    private BareBackupUpgradeOverlay() {}
+
+    /** Shows the page if this profile has finished a welcome before and hasn't answered it yet. */
+    static void maybeShow(Activity activity, SharedPreferences prefs) {
+        if (prefs.getBoolean(BareWelcomeOverlay.KEY_BACKUP_PAGE_DONE, false)) return;
+        if (!prefs.getBoolean("shown", false)) return;
+        // Backups were set up some other way: nothing to offer.
+        if (BareAutoBackup.isOn()) {
+            prefs.edit().putBoolean(BareWelcomeOverlay.KEY_BACKUP_PAGE_DONE, true).apply();
+            return;
+        }
+        if (RiseSheet.isOpen()) return;
+        @Nullable ViewGroup root = activity.findViewById(android.R.id.content);
+        if (root == null || root.findViewById(R.id.bare_backup_upgrade_root) != null) return;
+
+        View overlay =
+                LayoutInflater.from(activity)
+                        .inflate(R.layout.bare_backup_upgrade_overlay, root, false);
+        overlay.setSaveFromParentEnabled(false);
+
+        View[] hidden = new View[root.getChildCount()];
+        for (int i = 0; i < root.getChildCount(); i++) {
+            hidden[i] = root.getChildAt(i);
+            hidden[i].setImportantForAccessibility(
+                    View.IMPORTANT_FOR_ACCESSIBILITY_NO_HIDE_DESCENDANTS);
+        }
+        ViewTreeObserver.OnWindowFocusChangeListener[] focus = {null};
+        Runnable close =
+                () -> {
+                    prefs.edit().putBoolean(BareWelcomeOverlay.KEY_BACKUP_PAGE_DONE, true).apply();
+                    if (focus[0] != null) {
+                        overlay.getViewTreeObserver().removeOnWindowFocusChangeListener(focus[0]);
+                    }
+                    root.removeView(overlay);
+                    for (View behind : hidden) {
+                        behind.setImportantForAccessibility(View.IMPORTANT_FOR_ACCESSIBILITY_AUTO);
+                    }
+                };
+        // Back from setup: done once backups are on; still here if setup was left half way.
+        focus[0] =
+                hasFocus -> {
+                    if (hasFocus && BareAutoBackup.isOn()) close.run();
+                };
+        overlay.getViewTreeObserver().addOnWindowFocusChangeListener(focus[0]);
+        overlay.findViewById(R.id.bare_backup_upgrade_set_up)
+                .setOnClickListener(v -> BareAutoBackupSetupFragment.open(activity, null));
+        overlay.findViewById(R.id.bare_backup_upgrade_not_now).setOnClickListener(v -> close.run());
+
+        overlay.addOnLayoutChangeListener(
+                (view, l, t, r, b, oldL, oldT, oldR, oldB) -> {
+                    WindowInsetsCompat insets = ViewCompat.getRootWindowInsets(view);
+                    if (insets == null) return;
+                    Insets bars =
+                            insets.getInsets(
+                                    WindowInsetsCompat.Type.systemBars()
+                                            | WindowInsetsCompat.Type.displayCutout());
+                    if (view.getPaddingTop() == bars.top
+                            && view.getPaddingBottom() == bars.bottom
+                            && view.getPaddingLeft() == bars.left
+                            && view.getPaddingRight() == bars.right) {
+                        return;
+                    }
+                    view.post(() -> view.setPadding(bars.left, bars.top, bars.right, bars.bottom));
+                });
+        root.addView(overlay);
+    }
+}

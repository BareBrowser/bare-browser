+    /** Whether a new tab opens with the keyboard up. Off unless the user turns it on. */
+    private void configureKeyboardOnNewTabSwitch() {
+        ChromeSwitchPreference row =
+                (ChromeSwitchPreference) findPreference(PREF_BARE_KEYBOARD_ON_NEW_TAB);
+        if (row == null) return;
+
+        row.setChecked(
+                ChromeSharedPreferences.getInstance()
+                        .readBoolean(ChromePreferenceKeys.BARE_KEYBOARD_ON_NEW_TAB, false));
+        row.setOnPreferenceChangeListener(
+                (preference, newValue) -> {
+                    ChromeSharedPreferences.getInstance()
+                            .writeBoolean(
+                                    ChromePreferenceKeys.BARE_KEYBOARD_ON_NEW_TAB,
+                                    (boolean) newValue);
+                    return true;
+                });
+    }
+

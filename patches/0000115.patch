@@ -341,6 +341,18 @@ inline constexpr char kWebKitForceDarkModeEnabled[] =
 inline constexpr char kBackgroundMediaPlayback[] =
     "bare.background_media_playback";
 
+// Bare Browser: which browsing data the Exit item in the app menu clears, as a
+// bitmask of BrowsingDataType values. Zero, the default, clears nothing and
+// makes Exit close the browser and no more. Exposed to Java through the
+// generated Pref class.
+inline constexpr char kClearOnExitTypes[] = "bare.clear_on_exit_types";
+
+// Bare Browser: true while an Exit-time deletion is running. If the process
+// goes away before the deletion reports back, the next start finds this set and

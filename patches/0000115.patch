new file mode 100644
index 00000000000..e833d3f0070
--- /dev/null
+++ b/chrome/android/java/src/org/chromium/chrome/browser/bare/BareClearOnExit.java
@@ -0,0 +1,118 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.bare;
+
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.chrome.browser.browsing_data.BrowsingDataBridge;
+import org.chromium.chrome.browser.browsing_data.BrowsingDataType;
+import org.chromium.chrome.browser.browsing_data.TimePeriod;
+import org.chromium.chrome.browser.preferences.Pref;
+import org.chromium.chrome.browser.profiles.Profile;
+import org.chromium.components.user_prefs.UserPrefs;
+
+/**
+ * What the Exit item in the app menu deletes before the browser closes.
+ *
+ * <p>The selection is a bitmask of {@link BrowsingDataType} values held in a profile preference, so
+ * it belongs to a profile rather than to the installation and will follow a profile if this build
+ * ever grows more than one. Zero, the default, means Exit closes the browser and deletes nothing.
+ *
+ * <p>Deletion goes through {@link BrowsingDataBridge}, the same path the Delete browsing data screen
+ * uses, so there is one deletion mechanism in the browser rather than a second one for exiting. It
+ * reports back when the removal has finished, which is what lets the caller wait before closing:
+ * Android has no equivalent of the keep-alive that holds a desktop browser open while its on-exit
+ * policy runs.
+ *
+ * <p>Chromium has an on-exit policy of its own, kClearBrowsingDataOnExitList, which is not used
+ * here. It refuses to delete history, site settings, autofill or passwords unless sync is off by
+ * enterprise policy or sign-in is disallowed, and neither is true in this build, so a selection
+ * containing any of those would be dropped without telling anyone.
+ */
+@NullMarked
+public final class BareClearOnExit {
+
+    private BareClearOnExit() {}
+
+    /** The types Exit may be asked to delete, in the order the settings screen lists them. */
+    public static final int[] AVAILABLE_TYPES = {
+        BrowsingDataType.HISTORY,
+        BrowsingDataType.SITE_DATA,
+        BrowsingDataType.CACHE,
+        BrowsingDataType.SITE_SETTINGS,
+        BrowsingDataType.FORM_DATA,
+        BrowsingDataType.PASSWORDS,
+    };
+
+    /** Returns the bitmask of types the user has chosen for this profile. */
+    public static int getSelection(Profile profile) {
+        return UserPrefs.get(profile).getInteger(Pref.CLEAR_ON_EXIT_TYPES);
+    }
+
+    /** Records the bitmask of types to delete on exit. */
+    public static void setSelection(Profile profile, int mask) {
+        UserPrefs.get(profile).setInteger(Pref.CLEAR_ON_EXIT_TYPES, mask);
+    }
+
+    /** Whether {@code type} is in {@code mask}. */
+    public static boolean isSelected(int mask, @BrowsingDataType int type) {
+        return (mask & (1 << type)) != 0;
+    }
+
+    /** Returns {@code mask} with {@code type} added or removed. */
+    public static int withType(int mask, @BrowsingDataType int type, boolean selected) {
+        return selected ? (mask | (1 << type)) : (mask & ~(1 << type));
+    }
+
+    /**
+     * Deletes whatever the profile has selected and then runs {@code whenDone}.
+     *
+     * <p>{@code whenDone} runs on the UI thread in every case, including when nothing is selected,
+     * so a caller can treat this as the single step before it closes.
+     *
+     * <p>A pending flag is written before the deletion starts and cleared when it reports back. If
+     * the process goes away in between, {@link #resumeIfInterrupted} finds the flag on the next
+     * start and deletes again.
+     */
+    public static void clearThen(Profile profile, Runnable whenDone) {
+        int[] types = selectedTypes(getSelection(profile));
+        if (types.length == 0) {
+            whenDone.run();
+            return;
+        }
+        UserPrefs.get(profile).setBoolean(Pref.CLEAR_ON_EXIT_PENDING, true);
+        BrowsingDataBridge.getForProfile(profile)
+                .clearBrowsingData(
+                        () -> {
+                            UserPrefs.get(profile).setBoolean(Pref.CLEAR_ON_EXIT_PENDING, false);
+                            whenDone.run();
+                        },
+                        types,
+                        TimePeriod.ALL_TIME);
+    }
+
+    /**
+     * Finishes a deletion that an earlier exit started but did not see through.
+     *
+     * <p>Called once the profile is available on a normal start. Does nothing in the usual case,
+     * where the flag is clear.
+     */
+    public static void resumeIfInterrupted(Profile profile) {
+        if (!UserPrefs.get(profile).getBoolean(Pref.CLEAR_ON_EXIT_PENDING)) return;
+        clearThen(profile, () -> {});
+    }
+
+    private static int[] selectedTypes(int mask) {
+        int count = 0;
+        for (int type : AVAILABLE_TYPES) {
+            if (isSelected(mask, type)) count++;
+        }
+        int[] types = new int[count];
+        int i = 0;
+        for (int type : AVAILABLE_TYPES) {
+            if (isSelected(mask, type)) types[i++] = type;
+        }
+        return types;
+    }
+}

+    public static boolean isLeaveAsExit() {
+        return ChromeSharedPreferences.getInstance()
+                .readBoolean(ChromePreferenceKeys.BARE_LEAVE_AS_EXIT, false);
+    }
+
+    public static void setLeaveAsExit(boolean enabled) {
+        ChromeSharedPreferences.getInstance()
+                .writeBoolean(ChromePreferenceKeys.BARE_LEAVE_AS_EXIT, enabled);
+    }
+
+    /** Whether exiting also closes every tab, in both normal and private browsing. */
+    public static boolean isCloseTabs() {
+        return ChromeSharedPreferences.getInstance()
+                .readBoolean(ChromePreferenceKeys.BARE_CLEAR_CLOSE_TABS, false);
+    }

+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.bare;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+
+import org.junit.After;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+
+import org.chromium.base.test.BaseRobolectricTestRunner;
+import org.chromium.chrome.browser.preferences.ChromePreferenceKeys;
+import org.chromium.chrome.browser.preferences.ChromeSharedPreferences;
+import org.chromium.chrome.browser.ui.extensions.BareExtensionPresentation;
+
+/** Unit tests for {@link BareExtensionPresentation}. */
+@RunWith(BaseRobolectricTestRunner.class)
+public class BareExtensionPresentationUnitTest {
+    @After
+    public void tearDown() {
+        ChromeSharedPreferences.getInstance()
+                .removeKey(ChromePreferenceKeys.BARE_EXTENSION_PRESENTATION);
+    }
+
+    @Test
+    public void testTheStoredNothingIsThePopup() {
+        assertEquals(BareExtensionPresentation.POPUP, BareExtensionPresentation.get());
+        assertFalse(BareExtensionPresentation.isFullScreen());
+    }
+
+    @Test
+    public void testFullScreenIsRemembered() {
+        BareExtensionPresentation.set(BareExtensionPresentation.FULL_SCREEN);
+        assertTrue(BareExtensionPresentation.isFullScreen());
+    }
+
+    @Test
+    public void testChoosingThePopupForgetsTheKey() {
+        BareExtensionPresentation.set(BareExtensionPresentation.FULL_SCREEN);
+        BareExtensionPresentation.set(BareExtensionPresentation.POPUP);
+        assertFalse(
+                ChromeSharedPreferences.getInstance()
+                        .contains(ChromePreferenceKeys.BARE_EXTENSION_PRESENTATION));
+    }
+
+    @Test
+    public void testTheCardIsRemembered() {
+        BareExtensionPresentation.set(BareExtensionPresentation.CARD);
+        assertTrue(BareExtensionPresentation.isCard());
+        assertEquals(BareExtensionPresentation.CARD, BareExtensionPresentation.get());
+        assertFalse(BareExtensionPresentation.isFullScreen());
+        assertTrue(BareExtensionPresentation.sizedByView());
+    }
+
+    @Test
+    public void testChoosingThePopupAfterTheCardForgetsTheKey() {
+        BareExtensionPresentation.set(BareExtensionPresentation.CARD);
+        BareExtensionPresentation.set(BareExtensionPresentation.POPUP);
+        assertFalse(
+                ChromeSharedPreferences.getInstance()
+                        .contains(ChromePreferenceKeys.BARE_EXTENSION_PRESENTATION));
+        assertFalse(BareExtensionPresentation.sizedByView());
+    }
+
+    @Test
+    public void testAValueThisBuildDoesNotOfferIsThePopup() {
+        ChromeSharedPreferences.getInstance()
+                .writeInt(ChromePreferenceKeys.BARE_EXTENSION_PRESENTATION, 7);
+        assertFalse(BareExtensionPresentation.isFullScreen());
+        ChromeSharedPreferences.getInstance()
+                .writeInt(ChromePreferenceKeys.BARE_EXTENSION_PRESENTATION, 3);
+        assertEquals(BareExtensionPresentation.POPUP, BareExtensionPresentation.get());
+    }
+}

@@ -0,0 +1,60 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.ui.extensions;
+
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.chrome.browser.preferences.ChromePreferenceKeys;
+import org.chromium.chrome.browser.preferences.ChromeSharedPreferences;
+
+/**
+ * How an extension's own interface opens: the popup under its button, a view that fills the
+ * screen with a close button, or a card that rises from behind the toolbar.
+ *
+ * <p>The popup is what Chromium does and what every install had, so it is what nothing stored
+ * means.
+ */
+@NullMarked
+public final class BareExtensionPresentation {
+    /** The popup under the extension's button. */
+    public static final int POPUP = 0;
+
+    /** A clean view over the page, with a close button. */
+    public static final int FULL_SCREEN = 1;
+
+    /** A card that rises from behind the toolbar, the page inside it. */
+    public static final int CARD = 2;
+
+    private BareExtensionPresentation() {}
+
+    public static int get() {
+        int stored =
+                ChromeSharedPreferences.getInstance()
+                        .readInt(ChromePreferenceKeys.BARE_EXTENSION_PRESENTATION, POPUP);
+        return stored == FULL_SCREEN || stored == CARD ? stored : POPUP;
+    }
+
+    public static void set(int presentation) {
+        if (presentation == FULL_SCREEN || presentation == CARD) {
+            ChromeSharedPreferences.getInstance()
+                    .writeInt(ChromePreferenceKeys.BARE_EXTENSION_PRESENTATION, presentation);
+        } else {
+            ChromeSharedPreferences.getInstance()
+                    .removeKey(ChromePreferenceKeys.BARE_EXTENSION_PRESENTATION);
+        }
+    }
+
+    public static boolean isFullScreen() {
+        return get() == FULL_SCREEN;
+    }
+
+    public static boolean isCard() {
+        return get() == CARD;
+    }
+
+    /** Whether the page takes the size of the view it is shown in rather than its own. */
+    public static boolean sizedByView() {
+        return get() != POPUP;
+    }
+}

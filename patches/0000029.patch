+            setButtonVisibility(ActionId.INCOGNITO, /* visible= */ false);
             return;
         }
 
@@ -295,8 +296,15 @@ public class BottomBarMediator
         Integer candidateExtraAction = mResolvedCandidateExtraAction;
         if (candidateExtraAction != null && candidateExtraAction == ActionId.GLIC) {
             updateGlicVisibility(originalProfile);
+        } else if (candidateExtraAction != null && candidateExtraAction == ActionId.INCOGNITO) {
+            // De-Googled build: the incognito button shares this slot, so it needs asking about
+            // too. Only GLIC was considered here, which left the slot empty for any other
+            // action however correctly it was registered.
+            setButtonVisibility(ActionId.GLIC, /* visible= */ false);
+            setButtonVisibility(ActionId.INCOGNITO, /* visible= */ true);
         } else {
             setButtonVisibility(ActionId.GLIC, /* visible= */ false);
+            setButtonVisibility(ActionId.INCOGNITO, /* visible= */ false);
         }
     }
 

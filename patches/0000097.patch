diff --git a/chrome/browser/ui/android/bottombar/java/src/org/chromium/chrome/browser/ui/bottombar/BareToolbarDefaults.java b/chrome/browser/ui/android/bottombar/java/src/org/chromium/chrome/browser/ui/bottombar/BareToolbarDefaults.java
new file mode 100644
index 00000000000..7bb34899287
--- /dev/null
+++ b/chrome/browser/ui/android/bottombar/java/src/org/chromium/chrome/browser/ui/bottombar/BareToolbarDefaults.java
@@ -0,0 +1,109 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.ui.bottombar;
+
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.chrome.browser.ui.actions.ActionId;
+
+/**
+ * The one place that says what Bare's bottom bar looks like when nobody has changed it.
+ *
+ * <p>Everything about defaults is answered here and nowhere else, so that a stored preference is
+ * only ever an override of this table rather than a second copy of it. Nothing writes these values
+ * anywhere: a slot the user has not touched is resolved by reading this table every time. That is
+ * what makes an upgrade from a build with no toolbar preferences produce the toolbar that build
+ * already had, with no migration step to get wrong, and what makes a reset able to simply forget
+ * the overrides.
+ */
+@NullMarked
+public final class BareToolbarDefaults {
+    private BareToolbarDefaults() {}
+
+    /**
+     * The action a slot performs when the user has expressed no preference. This is the arrangement
+     * Bare shipped: home, the spare slot holding incognito, the new tab button in the centre, the
+     * tab switcher and the app menu.
+     */
+    public static @ActionId int actionFor(@BareToolbarSlot int slot) {
+        switch (slot) {
+            case BareToolbarSlot.HOME:
+                return ActionId.HOME_BUTTON;
+            case BareToolbarSlot.EXTRA:
+                return ActionId.INCOGNITO;
+            case BareToolbarSlot.NEW_TAB:
+                return ActionId.NEW_TAB;
+            case BareToolbarSlot.TAB_SWITCHER:
+                return ActionId.TAB_SWITCHER;
+            case BareToolbarSlot.APP_MENU:
+                return ActionId.APP_MENU;
+            default:
+                return ActionId.APP_MENU;
+        }
+    }
+
+    /**
+     * Whether the user may choose what a slot does.
+     *
+     * <p>Two slots are fixed for now. The new tab button is the centre of the bar and is drawn
+     * differently from its neighbours, with its own background and ripple, and it is the one
+     * control that should always be where the user left it. The tab switcher draws a live tab
+     * count through a view class of its own rather than the shared button template, so it is not
+     * interchangeable with an ordinary action yet.
+     */
+    public static boolean isConfigurable(@BareToolbarSlot int slot) {
+        return slot == BareToolbarSlot.HOME
+                || slot == BareToolbarSlot.EXTRA
+                || slot == BareToolbarSlot.APP_MENU;
+    }
+
+    /**
+     * The actions a slot is able to hold.
+     *
+     * <p>This is what the bar could put in a position, not what it currently does. The spare slot
+     * has always been shared: upstream fills it with one of two Google surfaces depending on the
+     * profile and the country, and Bare fills it with incognito. Only one of them is ever visible,
+     * so anything asking about that slot has to ask about all of them.
+     */
+    public static @ActionId int[] candidatesFor(@BareToolbarSlot int slot) {
+        switch (slot) {
+            case BareToolbarSlot.HOME:
+                return new int[] {ActionId.HOME_BUTTON};
+            case BareToolbarSlot.EXTRA:
+                return new int[] {ActionId.GLIC, ActionId.AI_MODE, ActionId.INCOGNITO};
+            case BareToolbarSlot.NEW_TAB:
+                return new int[] {ActionId.NEW_TAB};
+            case BareToolbarSlot.TAB_SWITCHER:
+                return new int[] {ActionId.TAB_SWITCHER};
+            case BareToolbarSlot.APP_MENU:
+                return new int[] {ActionId.APP_MENU};
+            default:
+                return new int[] {};
+        }
+    }
+
+    /**
+     * Whether an action is one this build knows how to put in a slot.
+     *
+     * <p>A stored preference is just an integer, and it can outlive the action it names: a build
+     * that drops an action, or a preference written by a newer build and then read by an older
+     * one, both arrive here as a number with nothing behind it. Anything not recognised is treated
+     * as no answer at all, so the slot falls back to its default rather than rendering nothing.
+     */
+    public static boolean isKnownAction(int actionId) {
+        switch (actionId) {
+            case ActionId.HOME_BUTTON:
+            case ActionId.TAB_SWITCHER:
+            case ActionId.APP_MENU:
+            case ActionId.BACK_BUTTON:
+            case ActionId.NEW_TAB:
+            case ActionId.GLIC:
+            case ActionId.AI_MODE:
+            case ActionId.INCOGNITO:
+                return true;
+            default:
+                return false;
+        }
+    }
+}
diff --git a/chrome/browser/ui/android/bottombar/java/src/org/chromium/chrome/browser/ui/bottombar/BareToolbarLayout.java b/chrome/browser/ui/android/bottombar/java/src/org/chromium/chrome/browser/ui/bottombar/BareToolbarLayout.java
new file mode 100644
index 00000000000..c3b15a4f33f
--- /dev/null
+++ b/chrome/browser/ui/android/bottombar/java/src/org/chromium/chrome/browser/ui/bottombar/BareToolbarLayout.java
@@ -0,0 +1,54 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.ui.bottombar;
+
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.chrome.browser.ui.actions.ActionId;
+
+/**
+ * Answers where an action lives in the bottom bar, and what a position in the bar is for.
+ *
+ * <p>This is the piece that replaces asking an action which container it belongs to. That question
+ * could only ever have one answer, which is why the bar could not be rearranged. Asking a slot
+ * what it holds, and looking an action up by finding the slot holding it, is the same question
+ * with the dependency the other way round.
+ *
+ * <p>With no preferences stored this resolves to exactly the arrangement Bare shipped.
+ */
+@NullMarked
+public final class BareToolbarLayout {
+    private BareToolbarLayout() {}
+
+    /** The action a slot currently performs. */
+    public static @ActionId int actionForSlot(@BareToolbarSlot int slot) {
+        return BareToolbarPrefs.getPrimaryAction(slot);
+    }
+
+    /**
+     * The slot an action is currently shown in, or {@link BareToolbarSlot#NONE} if the bar has
+     * nowhere to put it.
+     *
+     * <p>A slot is matched either because it is set to that action or because the action is one of
+     * the alternatives it can hold. The second case is what keeps the shared slot working: only
+     * one of its actions is chosen at a time, but the others still have to resolve to it so that
+     * whichever becomes eligible is hidden or shown in the right place.
+     */
+    public static @BareToolbarSlot int slotForAction(@ActionId int actionId) {
+        for (int slot = 0; slot < BareToolbarSlot.COUNT; slot++) {
+            if (actionForSlot(slot) == actionId) return slot;
+        }
+        for (int slot = 0; slot < BareToolbarSlot.COUNT; slot++) {
+            for (int candidate : BareToolbarDefaults.candidatesFor(slot)) {
+                if (candidate == actionId) return slot;
+            }
+        }
+        return BareToolbarSlot.NONE;
+    }
+
+    /** Every action the given slot is able to hold, whichever one it is set to. */
+    public static @ActionId int[] candidatesForSlot(@BareToolbarSlot int slot) {
+        return BareToolbarDefaults.candidatesFor(slot);
+    }
+}
diff --git a/chrome/browser/ui/android/bottombar/java/src/org/chromium/chrome/browser/ui/bottombar/BareToolbarPrefs.java b/chrome/browser/ui/android/bottombar/java/src/org/chromium/chrome/browser/ui/bottombar/BareToolbarPrefs.java
new file mode 100644
index 00000000000..87ba261f02a
--- /dev/null
+++ b/chrome/browser/ui/android/bottombar/java/src/org/chromium/chrome/browser/ui/bottombar/BareToolbarPrefs.java
@@ -0,0 +1,83 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.ui.bottombar;
+
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.chrome.browser.preferences.ChromePreferenceKeys;
+import org.chromium.chrome.browser.preferences.ChromeSharedPreferences;
+import org.chromium.chrome.browser.ui.actions.ActionId;
+
+/**
+ * Stores which action the user has put in a toolbar slot, and answers with Bare's default when
+ * they have not put anything there.
+ *
+ * <p>Reads pass the default through rather than seeding it, following the same shape as the
+ * adaptive toolbar shortcut preference. A profile that has never opened the toolbar settings holds
+ * no toolbar keys at all, which is what an upgrade from an older build looks like, and it resolves
+ * to the arrangement that build shipped. Launching the browser writes nothing.
+ *
+ * <p>Only the primary action is stored. The long press has its own preference in a later patch;
+ * there is nothing to record for it yet and an empty key now would only be one more thing to keep
+ * consistent.
+ */
+@NullMarked
+public final class BareToolbarPrefs {
+    /** No preference stored. Chosen to be outside the range of any real action id. */
+    private static final int UNSET = -1;
+
+    private BareToolbarPrefs() {}
+
+    /**
+     * The action a slot performs, which is the stored choice when there is a usable one and Bare's
+     * default otherwise.
+     *
+     * <p>A slot that cannot be configured never consults storage, so a value left behind by a
+     * build that allowed more of them cannot resurface.
+     */
+    public static @ActionId int getPrimaryAction(@BareToolbarSlot int slot) {
+        if (!BareToolbarDefaults.isConfigurable(slot)) {
+            return BareToolbarDefaults.actionFor(slot);
+        }
+        int stored = ChromeSharedPreferences.getInstance().readInt(primaryKey(slot), UNSET);
+        if (stored == UNSET || !BareToolbarDefaults.isKnownAction(stored)) {
+            return BareToolbarDefaults.actionFor(slot);
+        }
+        return stored;
+    }
+
+    /** Whether the user has chosen anything for this slot. */
+    public static boolean hasPrimaryAction(@BareToolbarSlot int slot) {
+        if (!BareToolbarDefaults.isConfigurable(slot)) return false;
+        return ChromeSharedPreferences.getInstance().readInt(primaryKey(slot), UNSET) != UNSET;
+    }
+
+    /**
+     * Records the action for a slot. Nothing calls this yet; the settings screen that will is a
+     * later patch.
+     */
+    public static void setPrimaryAction(@BareToolbarSlot int slot, @ActionId int actionId) {
+        if (!BareToolbarDefaults.isConfigurable(slot)) return;
+        if (!BareToolbarDefaults.isKnownAction(actionId)) return;
+        ChromeSharedPreferences.getInstance().writeInt(primaryKey(slot), actionId);
+    }
+
+    /**
+     * Forgets every choice, which returns the bar to Bare's defaults.
+     *
+     * <p>The keys are removed rather than overwritten with the current defaults. A reset that
+     * wrote today's answers down would freeze them, and a later build that changed a default would
+     * leave anyone who had ever pressed reset on the old arrangement with no way back to it.
+     */
+    public static void resetAll() {
+        for (int slot = 0; slot < BareToolbarSlot.COUNT; slot++) {
+            if (!BareToolbarDefaults.isConfigurable(slot)) continue;
+            ChromeSharedPreferences.getInstance().removeKey(primaryKey(slot));
+        }
+    }
+
+    private static String primaryKey(@BareToolbarSlot int slot) {
+        return ChromePreferenceKeys.BOTTOM_BAR_SLOT_PRIMARY_ACTION.createKey(slot);
+    }
+}
diff --git a/chrome/browser/ui/android/bottombar/java/src/org/chromium/chrome/browser/ui/bottombar/BareToolbarSlot.java b/chrome/browser/ui/android/bottombar/java/src/org/chromium/chrome/browser/ui/bottombar/BareToolbarSlot.java
new file mode 100644
index 00000000000..60151e46c5f
--- /dev/null
+++ b/chrome/browser/ui/android/bottombar/java/src/org/chromium/chrome/browser/ui/bottombar/BareToolbarSlot.java
@@ -0,0 +1,50 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.ui.bottombar;
+
+import androidx.annotation.IntDef;
+
+import org.chromium.build.annotations.NullMarked;
+
+import java.lang.annotation.ElementType;
+import java.lang.annotation.Retention;
+import java.lang.annotation.RetentionPolicy;
+import java.lang.annotation.Target;
+
+/**
+ * Identifies a position in the bottom bar, left to right, independently of what that position
+ * currently does.
+ *
+ * <p>The bar has always had five positions; what it did not have was a name for them. An action
+ * was mapped straight to the container it lived in, so the position and the action were the same
+ * idea and neither could move. Naming the positions is what lets a later patch put a different
+ * action in one of them.
+ *
+ * <p>These values are indices into the containers held by {@link BottomBarView} and are also
+ * written into preferences, so they must stay stable.
+ */
+@IntDef({
+    BareToolbarSlot.HOME,
+    BareToolbarSlot.EXTRA,
+    BareToolbarSlot.NEW_TAB,
+    BareToolbarSlot.TAB_SWITCHER,
+    BareToolbarSlot.APP_MENU,
+})
+@Retention(RetentionPolicy.SOURCE)
+@Target(ElementType.TYPE_USE)
+@NullMarked
+public @interface BareToolbarSlot {
+    int HOME = 0;
+    int EXTRA = 1;
+    int NEW_TAB = 2;
+    int TAB_SWITCHER = 3;
+    int APP_MENU = 4;
+
+    /** Number of slots. Not a slot itself. */
+    int COUNT = 5;
+
+    /** No slot holds the action in question. Not a slot itself. */
+    int NONE = -1;
+}

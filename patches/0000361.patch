+package org.chromium.chrome.browser.download;
+
+import android.net.Uri;
+
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.components.download.BareDownloadTree;
+
+/**
+ * Bare: where finished downloads are saved. Null means the phone's Download folder; otherwise a
+ * folder the user picked with ACTION_OPEN_DOCUMENT_TREE. All methods are safe on the UI thread.
+ */
+@NullMarked
+public final class BareDownloadLocation {
+    private BareDownloadLocation() {}
+
+    /** The chosen folder (a tree URI), or null for the phone's Download folder. */
+    public static @Nullable Uri get() {
+        return BareDownloadTree.get();
+    }
+
+    /** Saves the folder. The caller has already taken the persistable read and write grant. */
+    public static void set(Uri treeUri) {
+        BareDownloadTree.set(treeUri);
+    }
+
+    /** Back to the phone's Download folder. The caller releases the grant. */
+    public static void clear() {
+        BareDownloadTree.set(null);
+    }
+
+    /** True when no folder is set, or when Bare can still write to it. */
+    public static boolean isUsable() {
+        return BareDownloadTree.isUsable();
+    }
+
+    /**
+     * Returns true once after a finished download could not be saved to the folder and went to
+     * the Download folder instead.
+     */
+    public static boolean consumeFallback() {
+        return BareDownloadTree.consumeFallback();
+    }
+}

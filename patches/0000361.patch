+// Copyright 2026 The Bare Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.download;
+
+import org.chromium.base.Log;
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+
+/**
+ * Per-part progress of a running download, for the lanes bar on the downloads page.
+ *
+ * <p>The download engine registers a {@link Provider}. Without one, or when it has nothing for a
+ * download, the page draws a single lane from the overall progress.
+ */
+@NullMarked
+public final class BareDownloadParts {
+    private static final String TAG = "BareDownloadParts";
+
+    /** The most lanes the page draws. */
+    public static final int MAX_PARTS = 4;
+
+    /** A snapshot of one download's parts. */
+    public static final class Info {
+        /** Bytes received by each part. */
+        public final long[] received;
+
+        /** Bytes each part covers. Zero or less when not known (an open-ended last part). */
+        public final long[] length;
+
+        /** Overall speed in bytes per second, or -1 when not known. */
+        public final long bytesPerSecond;
+
+        /** Whether the data received so far is kept in a .baredownload file. */
+        public final boolean savedAsBareDownload;
+
+        public Info(
+                long[] received, long[] length, long bytesPerSecond, boolean savedAsBareDownload) {
+            this.received = received;
+            this.length = length;
+            this.bytesPerSecond = bytesPerSecond;
+            this.savedAsBareDownload = savedAsBareDownload;
+        }
+
+        /** Number of parts, 0 when the arrays do not line up. */
+        public int count() {
+            if (received == null || length == null || received.length != length.length) return 0;
+            return Math.min(received.length, MAX_PARTS);
+        }
+    }
+
+    /** Implemented by the download engine. Called on the UI thread; must be cheap. */
+    public interface Provider {
+        @Nullable Info get(String guid);
+    }
+
+    private static @Nullable Provider sProvider;
+
+    private BareDownloadParts() {}
+
+    /** Called by the download engine once it can answer. */
+    public static void setProvider(@Nullable Provider provider) {
+        sProvider = provider;
+    }
+
+    /** Returns the parts of the download with {@code guid}, or null when not known. */
+    public static @Nullable Info get(@Nullable String guid) {
+        Provider provider = sProvider;
+        if (provider == null || guid == null) return null;
+        try {
+            Info info = provider.get(guid);
+            if (info == null || info.count() == 0) return null;
+            return info;
+        } catch (RuntimeException e) {
+            // The page must never crash over a progress bar.
+            Log.w(TAG, "Parts provider failed", e);
+            return null;
+        }
+    }
+}

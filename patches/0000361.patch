@@ -0,0 +1,102 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.download;
+
+import android.text.TextUtils;
+
+import org.jni_zero.JNINamespace;
+import org.jni_zero.JniType;
+import org.jni_zero.NativeMethods;
+
+import org.chromium.base.ThreadUtils;
+import org.chromium.base.library_loader.LibraryLoader;
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+
+/**
+ * Bare: per-part progress and resume state of a download, read from the native download item.
+ * Methods run on the UI thread, are cheap, and never throw.
+ */
+@JNINamespace("download")
+@NullMarked
+public final class BareDownloadEngine {
+    /** Not paused or interrupted, or unknown. */
+    public static final int RESUME_NONE = 0;
+
+    /** Resume continues where the download stopped. */
+    public static final int RESUME_CONTINUE = 1;
+
+    /** Resume works but starts again from zero. */
+    public static final int RESUME_RESTART = 2;
+
+    /** Resume does nothing; the download can only be removed or started again from the page. */
+    public static final int RESUME_IMPOSSIBLE = 3;
+
+    private BareDownloadEngine() {}
+
+    /** Hands the parts of each download to the downloads page. */
+    public static void registerPartsProvider() {
+        BareDownloadParts.setProvider(BareDownloadEngine::getParts);
+    }
+
+    private static BareDownloadParts.@Nullable Info getParts(String guid) {
+        long[] snapshot = getPartsSnapshot(guid);
+        if (snapshot == null) return null;
+        int n = (int) snapshot[2];
+        if (n < 1 || snapshot.length != 3 + 2 * n) return null;
+        long[] received = new long[n];
+        long[] length = new long[n];
+        System.arraycopy(snapshot, 3, received, 0, n);
+        System.arraycopy(snapshot, 3 + n, length, 0, n);
+        return new BareDownloadParts.Info(received, length, snapshot[0], snapshot[1] == 1);
+    }
+
+    /**
+     * Returns the parts of a download, or null when it is not known.
+     *
+     * <p>Layout: [0] bytes per second (-1 unknown), [1] 1 if a .baredownload file is kept for it,
+     * [2] number of parts n (1 to 4), then n received byte counts, then n part lengths (0 or less
+     * when unknown).
+     *
+     * @param guid The download GUID, OfflineItem.id.id.
+     */
+    public static long @Nullable [] getPartsSnapshot(String guid) {
+        if (!isReady(guid)) return null;
+        try {
+            long[] parts = BareDownloadEngineJni.get().getPartsSnapshot(guid);
+            return parts == null || parts.length < 3 ? null : parts;
+        } catch (Throwable t) {
+            return null;
+        }
+    }
+
+    /**
+     * Returns one of the RESUME_ values for a download.
+     *
+     * @param guid The download GUID, OfflineItem.id.id.
+     */
+    public static int getResumeState(String guid) {
+        if (!isReady(guid)) return RESUME_NONE;
+        try {
+            return BareDownloadEngineJni.get().getResumeState(guid);
+        } catch (Throwable t) {
+            return RESUME_NONE;
+        }
+    }
+
+    private static boolean isReady(String guid) {
+        return !TextUtils.isEmpty(guid)
+                && ThreadUtils.runningOnUiThread()
+                && LibraryLoader.getInstance().isInitialized();
+    }
+
+    @NativeMethods
+    interface Natives {
+        @JniType("std::vector<int64_t>")
+        long[] getPartsSnapshot(@JniType("std::string") String guid);
+
+        int getResumeState(@JniType("std::string") String guid);
+    }
+}

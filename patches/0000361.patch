+    /**
+     * Bare: the progress line of a running download, "1.4 GB of 2.3 GB · 5 mins left". Null when
+     * the size is not known, while the download waits, and in incognito, which hides sizes.
+     */
+    private static @Nullable String bareProgressText(
+            Context context, DownloadUpdate downloadUpdate) {
+        OfflineItem.@Nullable Progress progress = downloadUpdate.getProgress();
+        if (progress == null
+                || downloadUpdate.getIsDownloadPending()
+                || downloadUpdate.getIsOffTheRecord()
+                || progress.isIndeterminate()
+                || progress.max == null
+                || progress.unit != OfflineItemProgressUnit.BYTES) {
+            return null;

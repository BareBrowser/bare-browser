+package org.chromium.chrome.browser.download.home.list.view;
+
+import android.content.Context;
+import android.graphics.Canvas;
+import android.graphics.Paint;
+import android.graphics.RectF;
+import android.util.AttributeSet;
+import android.view.View;
+
+import androidx.annotation.ColorInt;
+
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+
+/**
+ * Bare: the lanes progress bar on a download card. One rounded lane per part of the download,
+ * side by side with small gaps, each filling with its own progress. A lane's width follows the
+ * share of the file its part covers.
+ */
+@NullMarked
+public class BareLanesView extends View {
+    private static final float GAP_DP = 3f;
+
+    private final Paint mTrackPaint = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint mFillPaint = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final RectF mRect = new RectF();
+    private final float mGapPx;
+
+    private float[] mFractions = new float[] {0f};
+    private float[] mWeights = new float[] {1f};
+
+    public BareLanesView(Context context, @Nullable AttributeSet attrs) {
+        super(context, attrs);
+        mGapPx = GAP_DP * context.getResources().getDisplayMetrics().density;
+        setImportantForAccessibility(IMPORTANT_FOR_ACCESSIBILITY_NO);
+    }
+
+    /** Sets the colours of the empty track and of the filled part. */
+    public void setColors(@ColorInt int track, @ColorInt int fill) {
+        if (mTrackPaint.getColor() == track && mFillPaint.getColor() == fill) return;
+        mTrackPaint.setColor(track);
+        mFillPaint.setColor(fill);
+        invalidate();
+    }
+
+    /**
+     * Sets the lanes.
+     *
+     * @param fractions How full each lane is, 0 to 1.
+     * @param weights How wide each lane is relative to the others. Same length as fractions.
+     */
+    public void setLanes(float[] fractions, float[] weights) {
+        if (fractions.length == 0 || fractions.length != weights.length) {
+            fractions = new float[] {0f};
+            weights = new float[] {1f};
+        }
+        mFractions = fractions;
+        mWeights = weights;
+        invalidate();
+    }
+
+    @Override
+    protected void onDraw(Canvas canvas) {
+        super.onDraw(canvas);
+        int n = mFractions.length;
+        float left = getPaddingLeft();
+        float top = getPaddingTop();
+        float width = getWidth() - getPaddingLeft() - getPaddingRight();
+        float height = getHeight() - getPaddingTop() - getPaddingBottom();
+        if (width <= 0 || height <= 0) return;
+
+        float totalWeight = 0;
+        for (float w : mWeights) totalWeight += Math.max(w, 0f);
+        float usable = width - mGapPx * (n - 1);
+        if (usable <= 0) return;
+
+        float radius = height / 2f;
+        boolean rtl = getLayoutDirection() == LAYOUT_DIRECTION_RTL;
+        float x = rtl ? left + width : left;
+        for (int i = 0; i < n; i++) {
+            float share = totalWeight > 0 ? Math.max(mWeights[i], 0f) / totalWeight : 1f / n;
+            float laneWidth = usable * share;
+            float start = rtl ? x - laneWidth : x;
+            mRect.set(start, top, start + laneWidth, top + height);
+            canvas.drawRoundRect(mRect, radius, radius, mTrackPaint);
+
+            float f = Math.max(0f, Math.min(1f, mFractions[i]));
+            if (f > 0f) {
+                // Keep a filled lane at least as wide as it is tall so its ends stay round.
+                float fillWidth = Math.max(laneWidth * f, Math.min(height, laneWidth));
+                if (rtl) {
+                    mRect.set(start + laneWidth - fillWidth, top, start + laneWidth, top + height);
+                } else {
+                    mRect.set(start, top, start + fillWidth, top + height);
+                }
+                canvas.drawRoundRect(mRect, radius, radius, mFillPaint);
+            }
+            x = rtl ? start - mGapPx : start + laneWidth + mGapPx;
+        }
+    }
+}

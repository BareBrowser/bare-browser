diff --git a/chrome/browser/download/internal/android/java/src/org/chromium/chrome/browser/download/home/list/holder/BareDownloadCards.java b/chrome/browser/download/internal/android/java/src/org/chromium/chrome/browser/download/home/list/holder/BareDownloadCards.java
new file mode 100644
index 00000000000..46cbbd50c59
--- /dev/null
+++ b/chrome/browser/download/internal/android/java/src/org/chromium/chrome/browser/download/home/list/holder/BareDownloadCards.java
@@ -0,0 +1,194 @@
+// Copyright 2026 The Bare Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.download.home.list.holder;
+
+import android.content.Context;
+import android.content.res.ColorStateList;
+import android.graphics.Color;
+import android.graphics.drawable.Drawable;
+import android.graphics.drawable.GradientDrawable;
+import android.graphics.drawable.RippleDrawable;
+import android.net.Uri;
+import android.provider.DocumentsContract;
+import android.text.TextUtils;
+import android.view.View;
+
+import androidx.annotation.ColorInt;
+
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.chrome.browser.download.home.list.UiUtils;
+import org.chromium.chrome.browser.download.internal.R;
+import org.chromium.components.browser_ui.styles.SemanticColorUtils;
+import org.chromium.components.browser_ui.util.DownloadUtils;
+import org.chromium.components.offline_items_collection.OfflineItem;
+import org.chromium.components.offline_items_collection.OfflineItemFilter;
+import org.chromium.ui.util.ColorUtils;
+
+import java.util.Locale;
+
+/** Bare: shared look of the download cards: card background, file-type icon, folder label. */
+@NullMarked
+final class BareDownloadCards {
+    /** File kinds that get their own icon tint. */
+    private static final int KIND_OTHER = 0;
+    private static final int KIND_VIDEO = 1;
+    private static final int KIND_ARCHIVE = 2;
+    private static final int KIND_IMAGE = 3;
+    private static final int KIND_DOCUMENT = 4;
+
+    private static final String[] ARCHIVE_EXTENSIONS = {
+        ".zip", ".rar", ".7z", ".tar", ".gz", ".tgz", ".bz2", ".xz", ".zst", ".apk", ".apks",
+        ".xapk", ".iso"
+    };
+    private static final String[] DOCUMENT_EXTENSIONS = {
+        ".pdf", ".doc", ".docx", ".odt", ".rtf", ".txt", ".md", ".epub", ".xls", ".xlsx", ".ods",
+        ".csv", ".ppt", ".pptx", ".odp"
+    };
+
+    private BareDownloadCards() {}
+
+    static float dp(Context context, float dp) {
+        return dp * context.getResources().getDisplayMetrics().density;
+    }
+
+    /** Gives {@code card} a rounded surface-container background with a press ripple. */
+    static void styleCard(View card, float radiusDp) {
+        Context context = card.getContext();
+        GradientDrawable shape = new GradientDrawable();
+        shape.setCornerRadius(dp(context, radiusDp));
+        shape.setColor(SemanticColorUtils.getColorSurfaceContainer(context));
+        GradientDrawable mask = new GradientDrawable();
+        mask.setCornerRadius(dp(context, radiusDp));
+        mask.setColor(Color.WHITE);
+        @ColorInt
+        int ripple = ColorUtils.inNightMode(context) ? 0x33FFFFFF : 0x1F000000;
+        card.setBackground(new RippleDrawable(ColorStateList.valueOf(ripple), shape, mask));
+    }
+
+    private static int kindOf(OfflineItem item) {
+        String name = item.title == null ? "" : item.title.toLowerCase(Locale.ROOT);
+        String mime = item.mimeType == null ? "" : item.mimeType.toLowerCase(Locale.ROOT);
+        if (item.filter == OfflineItemFilter.VIDEO || mime.startsWith("video/")) return KIND_VIDEO;
+        if (item.filter == OfflineItemFilter.IMAGE || mime.startsWith("image/")) return KIND_IMAGE;
+        if (mime.contains("zip") || mime.contains("compressed") || mime.contains("x-tar")
+                || mime.contains("x-7z") || mime.contains("rar")
+                || mime.equals("application/vnd.android.package-archive")
+                || endsWithAny(name, ARCHIVE_EXTENSIONS)) {
+            return KIND_ARCHIVE;
+        }
+        if (item.filter == OfflineItemFilter.DOCUMENT || mime.startsWith("text/")
+                || mime.equals("application/pdf") || mime.contains("document")
+                || mime.contains("msword") || mime.contains("spreadsheet")
+                || mime.contains("presentation") || endsWithAny(name, DOCUMENT_EXTENSIONS)) {
+            return KIND_DOCUMENT;
+        }
+        return KIND_OTHER;
+    }
+
+    private static boolean endsWithAny(String name, String[] suffixes) {
+        for (String suffix : suffixes) {
+            if (name.endsWith(suffix)) return true;
+        }
+        return false;
+    }
+
+    /** Returns {background, foreground} colours for the icon of {@code item}. */
+    static int[] iconColors(Context context, OfflineItem item) {
+        boolean night = ColorUtils.inNightMode(context);
+        if (DownloadUtils.shouldDisplayDownloadAsDangerous(item.dangerType, item.state)
+                || DownloadUtils.isBlockedSensitiveDownload(item)) {
+            return new int[] {
+                SemanticColorUtils.getColorSurfaceContainerHighest(context),
+                context.getColorStateList(R.color.error_icon_color_tint_list).getDefaultColor()
+            };
+        }
+        switch (kindOf(item)) {
+            case KIND_VIDEO:
+            case KIND_DOCUMENT:
+                return night ? new int[] {0xFF4A3A6B, 0xFFD0BCFF} : new int[] {0xFFEADDFF, 0xFF4F378B};
+            case KIND_ARCHIVE:
+                return night ? new int[] {0xFF5A4012, 0xFFFFCC80} : new int[] {0xFFFFE0B2, 0xFF8A5000};
+            case KIND_IMAGE:
+                return night ? new int[] {0xFF1E4D47, 0xFF80CBC4} : new int[] {0xFFC8F0EA, 0xFF00695C};
+            default:
+                return new int[] {
+                    SemanticColorUtils.getColorSurfaceContainerHighest(context),
+                    SemanticColorUtils.getDefaultIconColor(context)
+                };
+        }
+    }
+
+    /** The rounded-square tinted background behind a file-type icon. */
+    static Drawable iconBackground(Context context, OfflineItem item) {
+        GradientDrawable bg = new GradientDrawable();
+        bg.setCornerRadius(dp(context, 12));
+        bg.setColor(iconColors(context, item)[0]);
+        return bg;
+    }
+
+    /** The tinted file-type icon. */
+    static Drawable icon(Context context, OfflineItem item) {
+        Drawable icon = context.getDrawable(UiUtils.getIconForItem(item)).mutate();
+        icon.setTint(iconColors(context, item)[1]);
+        return icon;
+    }
+
+    /**
+     * The name of the folder a finished download sits in, from its file path. Never does I/O.
+     */
+    static String folderLabel(Context context, OfflineItem item) {
+        String phone = context.getString(R.string.bare_download_location_phone);
+        String path = item.filePath;
+        if (TextUtils.isEmpty(path)) return phone;
+        try {
+            if (path.startsWith("content://")) {
+                Uri uri = Uri.parse(path);
+                // MediaStore: finished downloads are published to the phone's Download folder.
+                if ("media".equals(uri.getAuthority())) return phone;
+                if (DocumentsContract.isDocumentUri(context, uri)) {
+                    String label = parentOfDocId(DocumentsContract.getDocumentId(uri));
+                    if (label != null) return label;
+                    // A file right at the top of a chosen folder: name the folder itself.
+                    if (DocumentsContract.isTreeUri(uri)) {
+                        String tree = lastSegment(DocumentsContract.getTreeDocumentId(uri));
+                        if (tree != null) return tree;
+                    }
+                }
+                return phone;
+            }
+            // Bare stages downloads in its own app folder and publishes them to Download.
+            if (path.contains("/Android/data/")) return phone;
+            int slash = path.lastIndexOf('/');
+            if (slash <= 0) return phone;
+            String parent = path.substring(0, slash);
+            String name = parent.substring(parent.lastIndexOf('/') + 1);
+            return TextUtils.isEmpty(name) ? phone : name;
+        } catch (RuntimeException e) {
+            return phone;
+        }
+    }
+
+    /** "primary:Movies" gives "Movies". */
+    private static @Nullable String lastSegment(@Nullable String docId) {
+        if (docId == null) return null;
+        int colon = docId.indexOf(':');
+        String rel = colon >= 0 ? docId.substring(colon + 1) : docId;
+        String name = rel.substring(rel.lastIndexOf('/') + 1);
+        return TextUtils.isEmpty(name) ? null : name;
+    }
+
+    /** "primary:Movies/clip.mp4" gives "Movies". */
+    private static @Nullable String parentOfDocId(@Nullable String docId) {
+        if (docId == null) return null;
+        int colon = docId.indexOf(':');
+        String rel = colon >= 0 ? docId.substring(colon + 1) : docId;
+        int slash = rel.lastIndexOf('/');
+        if (slash <= 0) return null;
+        String parent = rel.substring(0, slash);
+        String name = parent.substring(parent.lastIndexOf('/') + 1);
+        return TextUtils.isEmpty(name) ? null : name;
+    }
+}

+package org.chromium.chrome.browser.download;
+
+import android.Manifest;
+import android.app.Activity;
+import android.app.Notification;
+import android.app.NotificationChannel;
+import android.app.NotificationManager;
+import android.content.Context;
+import android.os.Build;
+import android.service.notification.StatusBarNotification;
+import android.text.TextUtils;
+
+import androidx.annotation.RequiresApi;
+import androidx.core.app.NotificationManagerCompat;
+
+import org.chromium.base.ActivityState;
+import org.chromium.base.ApplicationStatus;
+import org.chromium.base.ContextUtils;
+import org.chromium.base.Log;
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.chrome.browser.app.ChromeActivity;
+import org.chromium.chrome.browser.preferences.ChromePreferenceKeys;
+import org.chromium.chrome.browser.preferences.ChromeSharedPreferences;
+import org.chromium.components.offline_items_collection.OfflineItem.Progress;
+import org.chromium.ui.base.WindowAndroid;
+
+import java.text.NumberFormat;
+import java.util.Locale;
+
+/**
+ * Bare: download progress in the status bar and on the lock screen.
+ *
+ * <p>Builds on Chromium's own download notification. On Android 16 and later a running download's
+ * notification asks to be promoted to a Live Update, which gives it the chip in the status bar and
+ * the progress card on the lock screen. Older Android keeps the normal ongoing notification. The
+ * switch in Settings > Downloads turns the progress notification off.
+ */
+@NullMarked
+public final class BareDownloadProgress {
+    private static final String TAG = "BareDlProgress";
+
+    /** Whether the one-time notification question was already settled in this process. */
+    private static boolean sAskSettled;
+
+    private BareDownloadProgress() {}
+
+    /** Whether the "Show download progress" switch is on. On unless the user turned it off. */
+    public static boolean isEnabled() {
+        return ChromeSharedPreferences.getInstance()
+                .readBoolean(ChromePreferenceKeys.BARE_DOWNLOAD_PROGRESS_NOTIFICATION, true);
+    }
+
+    /**
+     * Asks Android for the notification permission the first time a download runs without it. At
+     * most once per install, only while Bare is in front, and only if Android can still show its
+     * dialog. Uses the same request as the notifications row on the welcome page.
+     */
+    public static void maybeAskForNotificationsOnce() {
+        if (sAskSettled) return;
+        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.TIRAMISU) {
+            sAskSettled = true;
+            return;
+        }
+        if (NotificationManagerCompat.from(ContextUtils.getApplicationContext())
+                .areNotificationsEnabled()) {
+            sAskSettled = true;
+            return;
+        }
+        if (ChromeSharedPreferences.getInstance()
+                .readBoolean(ChromePreferenceKeys.BARE_DOWNLOAD_NOTIFICATION_ASKED, false)) {
+            sAskSettled = true;
+            return;
+        }
+        Activity activity = ApplicationStatus.getLastTrackedFocusedActivity();
+        // Not in front right now. Try again on a later update of this or another download.
+        if (!(activity instanceof ChromeActivity chromeActivity)) return;
+        if (ApplicationStatus.getStateForActivity(activity) != ActivityState.RESUMED) return;
+        WindowAndroid window = chromeActivity.getWindowAndroid();
+        if (window == null) return;
+
+        sAskSettled = true;
+        // Android no longer shows the dialog after two refusals. Then leave it to Android's
+        // settings, as the welcome page does.
+        if (!window.canRequestPermission(Manifest.permission.POST_NOTIFICATIONS)) return;
+        ChromeSharedPreferences.getInstance()
+                .writeBoolean(ChromePreferenceKeys.BARE_DOWNLOAD_NOTIFICATION_ASKED, true);
+        window.requestPermissions(
+                new String[] {Manifest.permission.POST_NOTIFICATIONS}, (permissions, results) -> {});
+    }
+
+    /** Whether Android currently shows a notification of Bare's with this id and no tag. */
+    public static boolean isShowing(Context context, int notificationId) {
+        NotificationManager manager = context.getSystemService(NotificationManager.class);
+        if (manager == null) return false;
+        try {
+            for (StatusBarNotification shown : manager.getActiveNotifications()) {
+                if (shown.getId() == notificationId && shown.getTag() == null) return true;
+            }
+        } catch (RuntimeException e) {
+            // Treat as showing, so the caller replaces it rather than leaving a stale one.
+            return true;
+        }
+        return false;
+    }
+
+    /**
+     * Turns a running download's notification into a Live Update on Android 16 and later. Returns
+     * the notification unchanged on older Android, when the user turned Live Updates off for Bare,
+     * when the downloads channel is set to minimum, and for incognito downloads, whose progress
+     * stays off the lock screen.
+     *
+     * @param notification Chromium's in-progress notification: ongoing, titled, not a group
+     *     summary, no custom views, not colorized.
+     * @param progress The download's progress, or null when it has none yet.
+     * @param isOffTheRecord Whether the download belongs to an incognito profile.
+     */
+    public static Notification maybePromote(
+            Context context,
+            Notification notification,
+            @Nullable Progress progress,
+            boolean isOffTheRecord) {
+        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.BAKLAVA) return notification;
+        if (isOffTheRecord) return notification;
+        try {
+            return promote(context, notification, progress);
+        } catch (RuntimeException e) {
+            Log.w(TAG, "Live Update not built", e);
+            return notification;
+        }
+    }
+
+    @RequiresApi(Build.VERSION_CODES.BAKLAVA)
+    private static Notification promote(
+            Context context, Notification notification, @Nullable Progress progress) {
+        if ((notification.flags & Notification.FLAG_ONGOING_EVENT) == 0) return notification;
+        if ((notification.flags & Notification.FLAG_GROUP_SUMMARY) != 0) return notification;
+        if (TextUtils.isEmpty(notification.extras.getCharSequence(Notification.EXTRA_TITLE))) {
+            return notification;
+        }
+        NotificationManager manager = context.getSystemService(NotificationManager.class);
+        if (manager == null || !manager.canPostPromotedNotifications()) return notification;
+        String channelId = notification.getChannelId();
+        NotificationChannel channel =
+                channelId == null ? null : manager.getNotificationChannel(channelId);
+        if (channel == null || channel.getImportance() <= NotificationManager.IMPORTANCE_MIN) {
+            return notification;
+        }
+
+        boolean determinate = progress != null && !progress.isIndeterminate();
+        Notification.ProgressStyle style =
+                new Notification.ProgressStyle().setProgressIndeterminate(!determinate);
+        Notification.Builder builder = Notification.Builder.recoverBuilder(context, notification);
+        if (determinate && progress != null) {
+            int percent = Math.max(0, Math.min(100, progress.getPercentage()));
+            style.addProgressSegment(new Notification.ProgressStyle.Segment(100))
+                    .setProgress(percent);
+            builder.setShortCriticalText(
+                    NumberFormat.getPercentInstance(Locale.getDefault()).format(percent / 100.0));
+        }
+        Notification promoted =
+                builder.setStyle(style)
+                        .setOngoing(true)
+                        .setOnlyAlertOnce(true)
+                        .setRequestPromotedOngoing(true)
+                        .build();
+        if (!promoted.hasPromotableCharacteristics()) {
+            Log.w(TAG, "Download notification is not promotable");
+        }
+        return promoted;
+    }
+}

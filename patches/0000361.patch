@@ -0,0 +1,183 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Bare: per-part progress and resume state for the downloads page.
+
+#include <algorithm>
+#include <string>
+#include <vector>
+
+#include "base/android/jni_array.h"
+#include "base/android/jni_string.h"
+#include "base/feature_list.h"
+#include "chrome/browser/browser_process.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/profiles/profile_manager.h"
+#include "components/download/public/common/download_features.h"
+#include "components/download/public/common/download_item.h"
+#include "components/download/public/common/download_utils.h"
+#include "content/public/browser/download_manager.h"
+#include "net/http/http_response_headers.h"
+
+// Must come after all headers that specialize FromJniType() / ToJniType().
+#include "chrome/browser/download/android/jni_headers/BareDownloadEngine_jni.h"
+
+namespace download {
+
+namespace {
+
+constexpr size_t kMaxLanes = 4;
+
+// Resume states, kept in sync with BareDownloadEngine.java.
+constexpr int kResumeNone = 0;
+constexpr int kResumeContinue = 1;
+constexpr int kResumeRestart = 2;
+constexpr int kResumeImpossible = 3;
+
+DownloadItem* FindDownload(const std::string& guid) {
+  if (!g_browser_process) {
+    return nullptr;
+  }
+  ProfileManager* profile_manager = g_browser_process->profile_manager();
+  if (!profile_manager) {
+    return nullptr;
+  }
+  for (Profile* profile : profile_manager->GetLoadedProfiles()) {
+    std::vector<Profile*> profiles = profile->GetAllOffTheRecordProfiles();
+    profiles.push_back(profile);
+    for (Profile* p : profiles) {
+      content::DownloadManager* manager = p->GetDownloadManager();
+      if (!manager) {
+        continue;
+      }
+      if (DownloadItem* item = manager->GetDownloadByGuid(guid)) {
+        return item;
+      }
+    }
+  }
+  return nullptr;
+}
+
+bool HasStrongValidators(const DownloadItem& item) {
+  return !item.GetETag().empty() || !item.GetLastModifiedTime().empty();
+}
+
+}  // namespace
+
+static std::vector<int64_t> JNI_BareDownloadEngine_GetPartsSnapshot(
+    JNIEnv* env,
+    const std::string& guid) {
+  DownloadItem* item = FindDownload(guid);
+  if (!item) {
+    return {};
+  }
+
+  const int64_t total = item->GetTotalBytes();
+  std::vector<int64_t> received;
+  std::vector<int64_t> length;
+  const std::vector<DownloadItem::ReceivedSlice>& slices =
+      item->GetReceivedSlices();
+  if (slices.empty()) {
+    received.push_back(item->GetReceivedBytes());
+    length.push_back(total > 0 ? total : -1);
+  } else {
+    if (slices.front().offset > 0) {
+      // Nothing received yet for the start of the file.
+      received.push_back(0);
+      length.push_back(slices.front().offset);
+    }
+    for (size_t i = 0; i < slices.size(); ++i) {
+      const bool last = i + 1 == slices.size();
+      int64_t end = last ? total : slices[i + 1].offset;
+      received.push_back(slices[i].received_bytes);
+      length.push_back(end > slices[i].offset ? end - slices[i].offset : -1);
+    }
+  }
+
+  // After a resume there can be more slices than lanes; fold neighbours.
+  if (received.size() > kMaxLanes) {
+    const size_t group = (received.size() + kMaxLanes - 1) / kMaxLanes;
+    std::vector<int64_t> folded_received;
+    std::vector<int64_t> folded_length;
+    for (size_t i = 0; i < received.size(); i += group) {
+      int64_t r = 0;
+      int64_t l = 0;
+      for (size_t j = i; j < std::min(received.size(), i + group); ++j) {
+        r += received[j];
+        l = (l < 0 || length[j] <= 0) ? -1 : l + length[j];
+      }
+      folded_received.push_back(r);
+      folded_length.push_back(l);
+    }
+    received.swap(folded_received);
+    length.swap(folded_length);
+  }
+
+  const bool running =
+      item->GetState() == DownloadItem::IN_PROGRESS && !item->IsPaused();
+  const bool kept = !item->IsDone() && !item->GetFullPath().empty();
+
+  std::vector<int64_t> result;
+  result.reserve(3 + received.size() * 2);
+  result.push_back(running ? item->CurrentSpeed() : -1);
+  result.push_back(kept ? 1 : 0);
+  result.push_back(static_cast<int64_t>(received.size()));
+  result.insert(result.end(), received.begin(), received.end());
+  result.insert(result.end(), length.begin(), length.end());
+  return result;
+}
+
+static jint JNI_BareDownloadEngine_GetResumeState(JNIEnv* env,
+                                                  const std::string& guid) {
+  DownloadItem* item = FindDownload(guid);
+  if (!item) {
+    return kResumeNone;
+  }
+
+  const bool paused_in_progress =
+      item->GetState() == DownloadItem::IN_PROGRESS && item->IsPaused();
+  if (item->GetState() != DownloadItem::INTERRUPTED && !paused_in_progress) {
+    return kResumeNone;
+  }
+
+  // The server said it can't serve ranges, or gave nothing to check the file
+  // against: a resume will start from zero.
+  const net::HttpResponseHeaders* headers = item->GetResponseHeaders().get();
+  if (headers) {
+    if (headers->HasHeaderValue("Accept-Ranges", "none")) {
+      return kResumeRestart;
+    }
+    if (!HasStrongValidators(*item) &&
+        !headers->HasHeaderValue("Accept-Ranges", "bytes")) {
+      return kResumeRestart;
+    }
+  }
+
+  if (paused_in_progress) {
+    return kResumeContinue;
+  }
+
+  const bool restart_required =
+      item->GetFullPath().empty() ||
+      (!HasStrongValidators(*item) &&
+       !base::FeatureList::IsEnabled(
+           features::kAllowDownloadResumptionWithoutStrongValidators));
+  switch (GetDownloadResumeMode(item->GetURL(), item->GetLastReason(),
+                                restart_required,
+                                /*user_action_required=*/true)) {
+    case ResumeMode::IMMEDIATE_CONTINUE:
+    case ResumeMode::USER_CONTINUE:
+      return kResumeContinue;
+    case ResumeMode::IMMEDIATE_RESTART:
+    case ResumeMode::USER_RESTART:
+      return kResumeRestart;
+    case ResumeMode::INVALID:
+      return kResumeImpossible;
+  }
+  return kResumeNone;
+}
+
+}  // namespace download
+
+DEFINE_JNI(BareDownloadEngine)

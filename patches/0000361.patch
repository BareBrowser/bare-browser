+                context.getString(
+                        R.string.bare_downloads_size_of,
+                        DownloadUtils.getStringForBytes(context, progress.value),
+                        DownloadUtils.getStringForBytes(context, progress.max));
+        if (downloadUpdate.getTimeRemainingInMillis() >= 0
+                && !LegacyHelpers.isLegacyOfflinePage(downloadUpdate.getContentId())) {
+            text +=
+                    " · "
+                            + StringUtils.timeLeftForUi(
+                                    context, downloadUpdate.getTimeRemainingInMillis());
+        }
+        return text;
+    }
+
+    /**
+     * Bare: the notification for a running download while "Show download progress" is off.

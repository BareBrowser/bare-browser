+                NotificationWrapperBuilderFactory.createNotificationWrapperBuilder(
+                                ChromeChannelDefinitions.ChannelId.DOWNLOADS, metadata)
+                        .setLocalOnly(true)
+                        .setGroup(NotificationConstants.GROUP_DOWNLOADS)
+                        .setOngoing(true)
+                        .setAutoCancel(false)
+                        .setSilent(true)
+                        .setOnlyAlertOnce(true)
+                        .setShowWhen(false)
+                        .setSmallIcon(android.R.drawable.stat_sys_download)
+                        .setContentTitle(context.getString(R.string.download_started));
+        Bundle extras = new Bundle();
+        extras.putInt(EXTRA_NOTIFICATION_BUNDLE_ICON_ID, android.R.drawable.stat_sys_download);
+        builder.addExtras(extras);
+
+        ContentId id = downloadUpdate.getContentId();
+        if (id != null) {
+            Intent cancelIntent =
+                    buildActionIntent(
+                            context, ACTION_DOWNLOAD_CANCEL, id, downloadUpdate.getOtrProfileId());
+            cancelIntent.putExtra(NotificationConstants.EXTRA_NOTIFICATION_ID, notificationId);
+            builder.addAction(
+                    R.drawable.btn_close_white,
+                    context.getString(R.string.download_notification_cancel_button),
+                    buildPendingIntentProvider(context, cancelIntent, notificationId),
+                    LegacyHelpers.isLegacyDownload(id)
+                            ? NotificationUmaTracker.ActionType.DOWNLOAD_CANCEL
+                            : NotificationUmaTracker.ActionType.DOWNLOAD_PAGE_CANCEL);
+        }
+        if (!downloadUpdate.getIsTransient()) {
+            Intent downloadHomeIntent =
+                    buildActionIntent(
+                            context,
+                            ACTION_NOTIFICATION_CLICKED,
+                            null,
+                            downloadUpdate.getOtrProfileId());
+            downloadHomeIntent.putExtra(EXTRA_DOWNLOAD_DANGER_TYPE, downloadUpdate.getDangerType());
+            builder.setContentIntent(
+                    PendingIntentProvider.getService(
+                            context,
+                            notificationId,
+                            downloadHomeIntent,
+                            PendingIntent.FLAG_UPDATE_CURRENT));
+        }
         return builder.build();
     }
 

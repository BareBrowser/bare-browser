+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.components.download;
+
+import android.content.ContentResolver;
+import android.content.Context;
+import android.content.SharedPreferences;
+import android.content.UriPermission;
+import android.net.Uri;
+import android.os.FileUtils;
+import android.provider.DocumentsContract;
+import android.text.TextUtils;
+
+import org.chromium.base.ContextUtils;
+import org.chromium.base.Log;
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+
+import java.io.InputStream;
+import java.io.OutputStream;
+
+/**
+ * Bare: the folder the user picked for finished downloads (a Storage Access Framework tree).
+ *
+ * <p>Downloads are still written to a MediaStore pending item while they run. When one
+ * finishes, {@link DownloadCollectionBridge} asks this class to copy it into the tree. If the
+ * tree can't be written, the download is published to the phone's Download folder as usual and
+ * a fallback flag is set for the UI.
+ */
+@NullMarked
+public final class BareDownloadTree {
+    private static final String TAG = "BareDownloadTree";
+
+    /** Pref with the tree URI string. Empty or missing means the phone's Download folder. */
+    public static final String PREF_TREE_URI = "bare_download_tree_uri";
+
+    /** Pref set when a finished download had to go to the Download folder instead. */
+    public static final String PREF_TREE_FALLBACK = "bare_download_tree_fallback";
+
+    /** Name suffix of a download that is not finished yet. */
+    public static final String SUFFIX = ".baredownload";
+
+    private static final String MIME_UNKNOWN = "application/octet-stream";
+
+    private BareDownloadTree() {}
+
+    private static SharedPreferences prefs() {
+        return ContextUtils.getAppSharedPreferences();
+    }
+
+    public static @Nullable Uri get() {
+        String value = prefs().getString(PREF_TREE_URI, null);
+        return TextUtils.isEmpty(value) ? null : Uri.parse(value);
+    }
+
+    public static void set(@Nullable Uri treeUri) {
+        SharedPreferences.Editor editor = prefs().edit();
+        if (treeUri == null) {
+            editor.remove(PREF_TREE_URI);
+        } else {
+            editor.putString(PREF_TREE_URI, treeUri.toString());
+        }
+        editor.remove(PREF_TREE_FALLBACK).apply();
+    }
+
+    /** True when no tree is set, or when we still hold a write grant on it. */
+    public static boolean isUsable() {
+        Uri tree = get();
+        return tree == null || hasWriteGrant(tree);
+    }
+
+    /** Returns true once after a download could not be saved to the tree. */
+    public static boolean consumeFallback() {
+        if (!prefs().getBoolean(PREF_TREE_FALLBACK, false)) return false;
+        prefs().edit().remove(PREF_TREE_FALLBACK).apply();
+        return true;
+    }
+
+    private static boolean hasWriteGrant(Uri tree) {
+        try {
+            Context context = ContextUtils.getApplicationContext();
+            for (UriPermission p : context.getContentResolver().getPersistedUriPermissions()) {
+                if (tree.equals(p.getUri()) && p.isWritePermission()) return true;
+            }
+        } catch (Exception e) {
+            Log.w(TAG, "Can't read folder grants.");
+        }
+        return false;
+    }
+
+    /** Removes {@link #SUFFIX} from a name if it is there. */
+    public static String stripSuffix(String name) {
+        if (name.endsWith(SUFFIX) && name.length() > SUFFIX.length()) {
+            return name.substring(0, name.length() - SUFFIX.length());
+        }
+        return name;
+    }
+
+    /**
+     * Copies a finished download into the tree. Runs on the download sequence, never on the UI
+     * thread. The copy is named {@code <name>.baredownload} until it is complete.
+     *
+     * @param source Content URI of the finished MediaStore pending item.
+     * @param finalName Name the file should get in the tree.
+     * @return Document URI of the file in the tree, or null when nothing was saved there (no tree
+     *     set). On a failure the fallback flag is set and null is returned.
+     */
+    static @Nullable Uri copyIntoTree(Uri source, String finalName) {
+        Uri tree = get();
+        if (tree == null) return null;
+        if (!hasWriteGrant(tree)) {
+            markFallback();
+            return null;
+        }
+        ContentResolver resolver = ContextUtils.getApplicationContext().getContentResolver();
+        Uri created = null;
+        try {
+            Uri parent =
+                    DocumentsContract.buildDocumentUriUsingTree(
+                            tree, DocumentsContract.getTreeDocumentId(tree));
+            created =
+                    DocumentsContract.createDocument(
+                            resolver, parent, MIME_UNKNOWN, finalName + SUFFIX);
+            if (created == null) throw new IllegalStateException("createDocument");
+            try (InputStream in = resolver.openInputStream(source);
+                    OutputStream out = resolver.openOutputStream(created, "w")) {
+                if (in == null || out == null) throw new IllegalStateException("open");
+                FileUtils.copy(in, out);
+            }
+            Uri renamed = DocumentsContract.renameDocument(resolver, created, finalName);
+            Uri result = renamed != null ? renamed : created;
+            created = null;
+            return result;
+        } catch (Exception e) {
+            Log.w(TAG, "Saving to the chosen folder failed, using Download.");
+            if (created != null) {
+                try {
+                    DocumentsContract.deleteDocument(resolver, created);
+                } catch (Exception ignored) {
+                    // Nothing more to do; the leftover keeps its .baredownload name.
+                }
+            }
+            markFallback();
+            return null;
+        }
+    }
+
+    private static void markFallback() {
+        prefs().edit().putBoolean(PREF_TREE_FALLBACK, true).apply();
+    }
+}

+    private boolean showBareLocationDialog(DownloadLocationPreference preference) {
+        Context context = getContext();
+        if (context == null) return false;
+        DownloadLocationPreferenceAdapter adapter = preference.getAdapter();
+
+        List<CharSequence> labels = new ArrayList<>();
+        List<Integer> positions = new ArrayList<>();
+        for (int i = 0; i < adapter.getCount(); i++) {
+            Object item = adapter.getItem(i);
+            if (!(item instanceof DirectoryOption option) || !adapter.isEnabled(i)) continue;
+            labels.add(
+                    option.type == DirectoryOption.DownloadLocationDirectoryType.DEFAULT
+                            ? context.getString(R.string.bare_download_location_phone_folder)
+                            : option.name);
+            positions.add(i);
+        }
+
+        Uri tree = BareDownloadLocation.get();
+        int checked = -1;
+        if (tree != null) {
+            checked = labels.size();
+            labels.add(DownloadLocationPreference.folderName(context, tree));
+            positions.add(POSITION_TREE);
+            labels.add(context.getString(R.string.bare_download_location_choose_other));
+        } else {
+            checked = positions.indexOf(adapter.getSelectedItemId());
+            labels.add(context.getString(R.string.bare_download_location_choose));
+        }
+        positions.add(POSITION_PICK);
+
+        new AlertDialog.Builder(context, R.style.ThemeOverlay_BrowserUI_AlertDialog)
+                .setTitle(R.string.downloads_location_selector_title)
+                .setSingleChoiceItems(
+                        labels.toArray(new CharSequence[0]),
+                        checked,
+                        (dialog, which) -> {
+                            dialog.dismiss();
+                            int position = positions.get(which);
+                            if (position == POSITION_TREE) return;
+                            if (position == POSITION_PICK) {
+                                pickFolder();
+                                return;
+                            }
+                            useDirectory(preference, position);
+                        })
+                .setNegativeButton(R.string.cancel, null)
+                .show();
+        return true;
+    }
+
+    private static final int POSITION_TREE = -10;
+    private static final int POSITION_PICK = -11;
+
+    /** Bare: back to the phone's Download folder or an SD card. */
+    private void useDirectory(DownloadLocationPreference preference, int position) {
+        releaseFolder(BareDownloadLocation.get());
+        BareDownloadLocation.clear();
+        preference.getAdapter().selectItem(position);
+        preference.updateSummary();
+    }
+
+    private void pickFolder() {
+        Intent intent = new Intent(Intent.ACTION_OPEN_DOCUMENT_TREE);
+        intent.addFlags(
+                Intent.FLAG_GRANT_READ_URI_PERMISSION
+                        | Intent.FLAG_GRANT_WRITE_URI_PERMISSION
+                        | Intent.FLAG_GRANT_PERSISTABLE_URI_PERMISSION
+                        | Intent.FLAG_GRANT_PREFIX_URI_PERMISSION);
+        Uri current = BareDownloadLocation.get();
+        if (current != null) intent.putExtra(DocumentsContract.EXTRA_INITIAL_URI, current);
+        try {
+            mFolderPicker.launch(intent);
+        } catch (ActivityNotFoundException e) {
+            Context context = getContext();
+            if (context != null) {
+                Toast.makeText(
+                                context,
+                                R.string.bare_download_location_no_picker,
+                                Toast.LENGTH_SHORT)
+                        .show();
+            }
+        }
+    }
+
+    private void onFolderPicked(ActivityResult result) {
+        Context context = getContext();
+        Intent data = result.getData();
+        if (context == null || result.getResultCode() != Activity.RESULT_OK || data == null) {
+            return;
+        }
+        Uri tree = data.getData();
+        if (tree == null) return;
+        try {
+            context.getContentResolver()
+                    .takePersistableUriPermission(
+                            tree,
+                            Intent.FLAG_GRANT_READ_URI_PERMISSION
+                                    | Intent.FLAG_GRANT_WRITE_URI_PERMISSION);
+        } catch (SecurityException e) {
+            // Without a lasting grant the folder would stop working after a restart.
+            Toast.makeText(context, R.string.bare_download_location_no_picker, Toast.LENGTH_SHORT)
+                    .show();
+            return;
+        }
+        Uri previous = BareDownloadLocation.get();
+        if (previous != null && !previous.equals(tree)) releaseFolder(previous);
+        BareDownloadLocation.set(tree);
+        if (mLocationChangePref != null) mLocationChangePref.updateSummary();
+    }
+
+    private void releaseFolder(@Nullable Uri tree) {
+        Context context = getContext();
+        if (tree == null || context == null) return;
+        try {
+            context.getContentResolver()
+                    .releasePersistableUriPermission(
+                            tree,
+                            Intent.FLAG_GRANT_READ_URI_PERMISSION
+                                    | Intent.FLAG_GRANT_WRITE_URI_PERMISSION);
+        } catch (SecurityException e) {
+            // Already gone.
+        }
+    }

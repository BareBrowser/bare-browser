From 6d644386eb6b27fb9ecc029542853c0d6d208420 Mon Sep 17 00:00:00 2001
From: Bare <git@barebrowser.org>
Date: Sun, 11 Oct 2026 07:23:34 +0000
Subject: [PATCH] Patch 0000131

---
 chrome/browser/intranet_redirect_detector.cc | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/chrome/browser/intranet_redirect_detector.cc b/chrome/browser/intranet_redirect_detector.cc
index 935d24eb60c..76c87e7f5a7 100644
--- a/chrome/browser/intranet_redirect_detector.cc
+++ b/chrome/browser/intranet_redirect_detector.cc
@@ -75,7 +75,11 @@ GURL IntranetRedirectDetector::RedirectOrigin() {
 void IntranetRedirectDetector::RegisterPrefs(PrefRegistrySimple* registry) {
   registry->RegisterStringPref(prefs::kLastKnownIntranetRedirectOrigin,
                                std::string());
-  registry->RegisterBooleanPref(prefs::kDNSInterceptionChecksEnabled, true);
+  // Bare: off by default. On Android this now runs on every launch and every
+  // network change, sending HEAD requests for made-up hostnames to whatever
+  // resolver the device uses. All it buys is the omnibox noticing an ISP that
+  // answers for names that do not exist.
+  registry->RegisterBooleanPref(prefs::kDNSInterceptionChecksEnabled, false);
 }
 
 void IntranetRedirectDetector::Restart() {

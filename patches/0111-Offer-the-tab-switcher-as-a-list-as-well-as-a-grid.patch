+    private static PropertyModel buildModel(boolean incognito) {
+        // IS_INCOGNITO is readable-only, so it is fixed when the model is built, the same way the
+        // switcher builds one model per tab.
+        return new PropertyModel.Builder(TabProperties.ALL_KEYS_TAB_GRID)
+                .with(TabProperties.TAB_ACTION_STATE, TabActionState.CLOSABLE)
+                .with(TabProperties.IS_INCOGNITO, incognito)
+                .with(TabProperties.IS_SELECTED, false)

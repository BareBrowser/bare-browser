+        bind(TabProperties.URL_DOMAIN);
+        assertEquals("example.com", url().getText().toString());
+        assertEquals(View.VISIBLE, url().getVisibility());
+    }
+
+    @Test
+    public void testDomainIsHiddenWhenThereIsNone() {
+        // An internal page and a tab group header both arrive without a domain.
+        mModel.set(TabProperties.URL_DOMAIN, null);
+        bind(TabProperties.URL_DOMAIN);
+        assertEquals(View.GONE, url().getVisibility());
+
+        mModel.set(TabProperties.URL_DOMAIN, "");
+        bind(TabProperties.URL_DOMAIN);
+        assertEquals(View.GONE, url().getVisibility());
+    }
+
+    @Test
+    public void testMissingFaviconLeavesNoImageBehind() {
+        mModel.set(TabProperties.FAVICON_FETCHER, null);
+        bind(TabProperties.FAVICON_FETCHER);
+        assertEquals(View.GONE, favicon().getVisibility());
+        assertNull(favicon().getDrawable());
+    }
+
+    @Test
+    public void testCloseButtonIsHiddenWithoutAnAction() {
+        mModel.set(TabProperties.TAB_ACTION_BUTTON_DATA, null);
+        bind(TabProperties.TAB_ACTION_BUTTON_DATA);
+        assertEquals(View.GONE, actionButton().getVisibility());
+    }
+
+    @Test
+    public void testSelectedTabIsRecordedOnTheRow() {
+        mModel.set(TabProperties.IS_SELECTED, true);
+        bind(TabProperties.IS_SELECTED);
+        assertTrue(mRow.isActivated());
+    }
+
+    @Test
+    public void testIncognitoRowBindsTheSameWay() {
+        mModel = buildModel(/* incognito= */ true);
+        mModel.set(TabProperties.TITLE, "Private page");
+        mModel.set(TabProperties.URL_DOMAIN, "example.com");
+        bind(TabProperties.TITLE);
+        bind(TabProperties.URL_DOMAIN);
+        assertEquals("Private page", title().getText().toString());
+        assertEquals("example.com", url().getText().toString());
+    }
+
+    @Test
+    public void testGroupRowWithoutAColourDoesNotCrash() {
+        // A group header arrives with no colour provider until one is resolved.
+        mModel.set(TabProperties.TAB_GROUP_COLOR_VIEW_PROVIDER, null);
+        bind(TabProperties.TAB_GROUP_COLOR_VIEW_PROVIDER);
+        assertEquals(View.GONE, mRow.findViewById(R.id.bare_tab_row_group_color).getVisibility());
+    }
+
+    @Test
+    public void testRecyclingReleasesWhatTheRowHeld() {
+        mModel.set(TabProperties.FAVICON_FETCHER, null);
+        bind(TabProperties.FAVICON_FETCHER);
+        BareTabRowViewBinder.onViewRecycled(mModel, mRow);
+        assertNull(favicon().getDrawable());
+        assertEquals(View.GONE, mRow.findViewById(R.id.bare_tab_row_group_color).getVisibility());
+    }
+
+    @Test
+    public void testUnknownKeyIsIgnored() {
+        // The binder is called for every key the model carries, including ones a row does not
+        // show, and must simply do nothing for them.
+        mModel.set(TabProperties.THUMBNAIL_FETCHER, null);
+        bind(TabProperties.THUMBNAIL_FETCHER);
+        bind(null);
+    }
+}
diff --git a/chrome/android/features/tab_ui/junit/src/org/chromium/chrome/browser/tasks/tab_management/BareTabViewModeUnitTest.java b/chrome/android/features/tab_ui/junit/src/org/chromium/chrome/browser/tasks/tab_management/BareTabViewModeUnitTest.java
new file mode 100644
index 00000000000..360a2a3ddd2
--- /dev/null
+++ b/chrome/android/features/tab_ui/junit/src/org/chromium/chrome/browser/tasks/tab_management/BareTabViewModeUnitTest.java
@@ -0,0 +1,99 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.tasks.tab_management;
+
+import static org.junit.Assert.assertEquals;
+
+import org.junit.After;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+
+import org.chromium.base.test.BaseRobolectricTestRunner;
+import org.chromium.chrome.browser.preferences.ChromePreferenceKeys;
+import org.chromium.chrome.browser.preferences.ChromeSharedPreferences;
+import org.chromium.chrome.browser.tab_ui.TabListMode;
+
+/** Unit tests for how the Tab view setting is stored, read back and turned into a list mode. */
+@RunWith(BaseRobolectricTestRunner.class)
+public class BareTabViewModeUnitTest {
+
+    @After
+    public void tearDown() {
+        ChromeSharedPreferences.getInstance().removeKey(ChromePreferenceKeys.BARE_TAB_VIEW);
+        ChromeSharedPreferences.getInstance().removeKey(ChromePreferenceKeys.BARE_OPEN_LINKS_IN_APPS);
+    }
+
+    private static void store(String value) {
+        ChromeSharedPreferences.getInstance()
+                .writeString(ChromePreferenceKeys.BARE_TAB_VIEW, value);
+    }
+
+    @Test
+    public void testDefaultIsGrid() {
+        assertEquals(BareTabViewMode.Mode.GRID, BareTabViewMode.get());
+    }
+
+    @Test
+    public void testEachModePersists() {
+        store(BareTabViewMode.VALUE_LIST);
+        assertEquals(BareTabViewMode.Mode.LIST, BareTabViewMode.get());
+
+        store(BareTabViewMode.VALUE_GRID);
+        assertEquals(BareTabViewMode.Mode.GRID, BareTabViewMode.get());
+    }
+
+    @Test
+    public void testUnrecognisedValueFallsBackToGrid() {
+        // A preference written by a later build, or corrupted, must leave the switcher as it was.
+        store("mosaic");
+        assertEquals(BareTabViewMode.Mode.GRID, BareTabViewMode.get());
+
+        store("");
+        assertEquals(BareTabViewMode.Mode.GRID, BareTabViewMode.get());
+    }
+
+    @Test
+    public void testRoundTrip() {
+        assertEquals(
+                BareTabViewMode.Mode.LIST,
+                BareTabViewMode.fromValue(BareTabViewMode.toValue(BareTabViewMode.Mode.LIST)));
+        assertEquals(
+                BareTabViewMode.Mode.GRID,
+                BareTabViewMode.fromValue(BareTabViewMode.toValue(BareTabViewMode.Mode.GRID)));
+    }
+
+    @Test
+    public void testGridKeepsTheExistingSwitcherMode() {
+        // Grid has to resolve to the mode the switcher already used, or choosing it would be a
+        // different switcher rather than the one every install has.
+        assertEquals(
+                TabListMode.GRID, BareTabViewMode.toTabListMode(BareTabViewMode.Mode.GRID));
+    }
+
+    @Test
+    public void testListSelectsTheListMode() {
+        assertEquals(
+                TabListMode.BARE_LIST, BareTabViewMode.toTabListMode(BareTabViewMode.Mode.LIST));
+    }
+
+    @Test
+    public void testAbsentPreferenceSelectsGridMode() {
+        assertEquals(
+                TabListMode.GRID, BareTabViewMode.toTabListMode(BareTabViewMode.get()));
+    }
+
+    @Test
+    public void testDoesNotDisturbAnotherBarePreference() {
+        ChromeSharedPreferences.getInstance()
+                .writeString(ChromePreferenceKeys.BARE_OPEN_LINKS_IN_APPS, "ask");
+        store(BareTabViewMode.VALUE_LIST);
+
+        assertEquals(BareTabViewMode.Mode.LIST, BareTabViewMode.get());
+        assertEquals(
+                "ask",
+                ChromeSharedPreferences.getInstance()
+                        .readString(ChromePreferenceKeys.BARE_OPEN_LINKS_IN_APPS, ""));
+    }
+}

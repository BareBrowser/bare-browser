@@ -0,0 +1,71 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.tasks.tab_management;
+
+import androidx.annotation.IntDef;
+
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.chrome.browser.preferences.ChromePreferenceKeys;
+import org.chromium.chrome.browser.preferences.ChromeSharedPreferences;
+import org.chromium.chrome.browser.tab_ui.TabListMode;
+
+import java.lang.annotation.Retention;
+import java.lang.annotation.RetentionPolicy;
+
+/**
+ * How the tab switcher lays its tabs out.
+ *
+ * <p>The values are written into a preference and so have to stay stable. They are stored as
+ * strings because the setting is a list preference, which writes the value it was given.
+ */
+@NullMarked
+public final class BareTabViewMode {
+    @IntDef({Mode.GRID, Mode.LIST})
+    @Retention(RetentionPolicy.SOURCE)
+    public @interface Mode {
+        int GRID = 0;
+        int LIST = 1;
+    }
+
+    public static final String VALUE_GRID = "grid";
+    public static final String VALUE_LIST = "list";
+
+    /**
+     * The layout the user has chosen.
+     *
+     * <p>Grid is the answer for a preference that was never written, so an install that predates
+     * the setting keeps the switcher it already had. It is also the answer for a value this build
+     * does not recognise, which covers a preference written by a later build and read back by this
+     * one.
+     */
+    public static @Mode int get() {
+        String value =
+                ChromeSharedPreferences.getInstance()
+                        .readString(ChromePreferenceKeys.BARE_TAB_VIEW, VALUE_GRID);
+        return fromValue(value);
+    }
+
+    /** The mode a stored preference string names, or Grid if it names nothing this build knows. */
+    public static @Mode int fromValue(String value) {
+        return VALUE_LIST.equals(value) ? Mode.LIST : Mode.GRID;
+    }
+
+    /** The preference string for a mode. */
+    public static String toValue(@Mode int mode) {
+        return mode == Mode.LIST ? VALUE_LIST : VALUE_GRID;
+    }
+
+    /**
+     * The {@link TabListMode} a mode asks the tab switcher for.
+     *
+     * <p>Grid resolves to the mode the switcher has always used, so choosing it leaves every
+     * upstream path exactly as it was.
+     */
+    public static @TabListMode int toTabListMode(@Mode int mode) {
+        return mode == Mode.LIST ? TabListMode.BARE_LIST : TabListMode.GRID;
+    }
+
+    private BareTabViewMode() {}
+}

+package org.chromium.chrome.browser.tasks.tab_management;
+
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.FrameLayout;
+import android.widget.ImageView;
+import android.widget.TextView;
+
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.chrome.tab_ui.R;
+import org.chromium.ui.modelutil.PropertyKey;
+import org.chromium.ui.modelutil.PropertyModel;
+
+/**
+ * Binds a tab or a tab group to one row of the list tab switcher.
+ *
+ * <p>A row is the favicon, the title and the domain, so nothing here reads {@link
+ * TabProperties#THUMBNAIL_FETCHER}. The list is built with no thumbnail provider at all, so no
+ * fetcher is ever created for these models and there is nothing to read.
+ *
+ * <p>Everything the row shows comes from the same properties the grid card uses, through the same
+ * shared helpers, so a row and a card describe a tab the same way and the accessibility text is the
+ * one the switcher already produced.
+ */
+@NullMarked
+public class BareTabRowViewBinder {
+    /** Binds one property. Called per key, and once per key when a row is first shown. */
+    public static void bind(
+            PropertyModel model, ViewGroup view, @Nullable PropertyKey propertyKey) {
+        if (propertyKey == null) return;
+
+        TextView title = view.findViewById(R.id.bare_tab_row_title);
+        TextView url = view.findViewById(R.id.bare_tab_row_url);
+        ImageView favicon = view.findViewById(R.id.bare_tab_row_favicon);
+        View actionButton = view.findViewById(R.id.action_button);
+        FrameLayout groupColor = view.findViewById(R.id.bare_tab_row_group_color);
+
+        if (TabProperties.TITLE == propertyKey) {
+            title.setText(model.get(TabProperties.TITLE));
+        } else if (TabProperties.URL_DOMAIN == propertyKey) {
+            // A group header and an internal page have no domain to show. The row keeps its
+            // height either way, so a missing domain reads as a one-line row rather than a gap.
+            @Nullable String domain = model.get(TabProperties.URL_DOMAIN);
+            boolean hasDomain = domain != null && !domain.isEmpty();
+            url.setText(hasDomain ? domain : "");
+            url.setVisibility(hasDomain ? View.VISIBLE : View.GONE);
+        } else if (TabProperties.FAVICON_FETCHER == propertyKey) {
+            TabListViewBinderUtils.updateFaviconAndVisibility(model, favicon);
+        } else if (TabProperties.IS_SELECTED == propertyKey) {
+            // The favicon has a selected form, and the row records the state so a theme can show
+            // the current tab without this binder deciding what that should look like.
+            view.setActivated(model.get(TabProperties.IS_SELECTED));
+            TabListViewBinderUtils.updateFaviconImage(model, favicon);
+        } else if (TabProperties.TAB_CLICK_LISTENER == propertyKey) {
+            TabListViewBinderUtils.setNullableClickListener(
+                    model.get(TabProperties.TAB_CLICK_LISTENER), view, model);
+        } else if (TabProperties.TAB_ACTION_BUTTON_DATA == propertyKey) {
+            @Nullable TabActionButtonData data = model.get(TabProperties.TAB_ACTION_BUTTON_DATA);
+            TabListViewBinderUtils.bindActionButton(model, actionButton, data);
+            actionButton.setVisibility(data == null ? View.GONE : View.VISIBLE);
+        } else if (TabProperties.CONTENT_DESCRIPTION_TEXT_RESOLVER == propertyKey) {
+            TabListViewBinderUtils.updateContentDescription(model, view);
+        } else if (TabProperties.ACTION_BUTTON_DESCRIPTION_TEXT_RESOLVER == propertyKey) {
+            TabListViewBinderUtils.updateActionButtonContentDescription(model, actionButton);
+        } else if (TabProperties.TAB_GROUP_COLOR_VIEW_PROVIDER == propertyKey) {
+            // The same colour widget the grid card attaches, so a group is coloured here the way
+            // it is coloured everywhere else.
+            @Nullable TabGroupColorViewProvider provider =
+                    model.get(TabProperties.TAB_GROUP_COLOR_VIEW_PROVIDER);
+            TabCardViewBinderUtils.updateTabGroupColorView(groupColor, provider);
+        }
+    }
+
+    /** Releases what the row holds so a recycled view starts from nothing. */
+    public static void onViewRecycled(PropertyModel model, View view) {
+        ImageView favicon = view.findViewById(R.id.bare_tab_row_favicon);
+        if (favicon != null) favicon.setImageDrawable(null);
+
+        FrameLayout groupColor = view.findViewById(R.id.bare_tab_row_group_color);
+        if (groupColor != null) {
+            // The colour view is shared and has one parent at a time, so it has to come off this
+            // row before the row can be handed to another item.
+            TabCardViewBinderUtils.detachTabGroupColorView(groupColor);
+            groupColor.setVisibility(View.GONE);
+        }
+    }
+
+    private BareTabRowViewBinder() {}
+}

diff --git a/chrome/browser/extensions/bare_extension_importance.cc b/chrome/browser/extensions/bare_extension_importance.cc
new file mode 100644
index 00000000000..96539af5a20
--- /dev/null
+++ b/chrome/browser/extensions/bare_extension_importance.cc
@@ -0,0 +1,114 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/extensions/bare_extension_importance.h"
+
+#include "build/build_config.h"
+
+#if BUILDFLAG(IS_ANDROID)
+#include "base/functional/bind.h"
+#include "base/scoped_observation.h"
+#include "base/task/single_thread_task_runner.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/common/pref_names.h"
+#include "components/prefs/pref_change_registrar.h"
+#include "components/prefs/pref_service.h"
+#include "content/public/browser/android/child_process_importance.h"
+#include "content/public/browser/web_contents.h"
+#include "extensions/browser/extension_host.h"
+#include "extensions/browser/extension_host_registry.h"
+#include "extensions/browser/process_manager.h"
+#include "extensions/common/mojom/view_type.mojom.h"
+#endif  // BUILDFLAG(IS_ANDROID)
+
+namespace extensions {
+
+#if BUILDFLAG(IS_ANDROID)
+namespace {
+
+// Gives each extension background page a binding Android counts when it picks
+// what to kill.
+//
+// A Manifest V2 background page has no tab in front of it, no media and no
+// service worker, so Chromium ranks its renderer as low as a process can be,
+// with a binding Android may drop first. Android's memory killer takes such a
+// process soon after Bare leaves the foreground, and the extension stops
+// working until it is loaded again. Moderate importance is the level a page
+// that is on screen but not the main frame gets, and it adds the binding that
+// keeps the process in step with the browser's own.
+//
+// This lowers the odds. It does not make the process unkillable: a phone short
+// enough of memory will still take it, and BundledExtensionRecovery loads the
+// extension again afterwards.
+class ExtensionImportanceKeeper : public ExtensionHostRegistry::Observer {
+ public:
+  explicit ExtensionImportanceKeeper(Profile* profile) : profile_(profile) {
+    observation_.Observe(ExtensionHostRegistry::Get(profile_));
+    pref_registrar_.Init(profile_->GetPrefs());
+    pref_registrar_.Add(
+        prefs::kBareKeepExtensionsAlive,
+        base::BindRepeating(&ExtensionImportanceKeeper::OnPrefChanged,
+                            base::Unretained(this)));
+  }
+
+  ExtensionImportanceKeeper(const ExtensionImportanceKeeper&) = delete;
+  ExtensionImportanceKeeper& operator=(const ExtensionImportanceKeeper&) =
+      delete;
+
+  ~ExtensionImportanceKeeper() override = default;
+
+ private:
+  void OnExtensionHostRenderProcessReady(
+      content::BrowserContext* browser_context,
+      ExtensionHost* host) override {
+    if (host->extension_host_type() !=
+        mojom::ViewType::kExtensionBackgroundPage) {
+      return;
+    }
+    Apply(host);
+  }
+
+  void OnExtensionHostRegistryShutdown(ExtensionHostRegistry* registry) override {
+    observation_.Reset();
+    pref_registrar_.RemoveAll();
+    base::SingleThreadTaskRunner::GetCurrentDefault()->DeleteSoon(FROM_HERE,
+                                                                 this);
+  }
+
+  void OnPrefChanged() {
+    ProcessManager* manager = ProcessManager::Get(profile_);
+    if (!manager) {
+      return;
+    }
+    for (ExtensionHost* host : manager->background_hosts()) {
+      Apply(host);
+    }
+  }
+
+  void Apply(ExtensionHost* host) {
+    const bool keep =
+        profile_->GetPrefs()->GetBoolean(prefs::kBareKeepExtensionsAlive);
+    host->host_contents()->SetPrimaryPageImportance(
+        keep ? content::ChildProcessImportance::MODERATE
+             : content::ChildProcessImportance::NORMAL,
+        content::ChildProcessImportance::NORMAL);
+  }
+
+  raw_ptr<Profile> profile_;
+  PrefChangeRegistrar pref_registrar_;
+  base::ScopedObservation<ExtensionHostRegistry,
+                          ExtensionHostRegistry::Observer>
+      observation_{this};
+};
+
+}  // namespace
+
+void StartExtensionImportanceKeeper(Profile* profile) {
+  new ExtensionImportanceKeeper(profile);  // Owns itself.
+}
+#else
+void StartExtensionImportanceKeeper(Profile* profile) {}
+#endif  // BUILDFLAG(IS_ANDROID)
+
+}  // namespace extensions

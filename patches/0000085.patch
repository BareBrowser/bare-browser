From 2d690d59ea27252c344a81ec30b9a3bb41223b9e Mon Sep 17 00:00:00 2001
From: Bare <git@barebrowser.org>
Date: Mon, 24 Aug 2026 22:27:11 +0000
Subject: [PATCH] Patch 0000085

---
 .../chrome/browser/bare/BareUpdateCheck.java      | 15 ++++++++++++++-
 .../browser/preferences/ChromePreferenceKeys.java |  7 +++++++
 2 files changed, 21 insertions(+), 1 deletion(-)

diff --git a/chrome/android/java/src/org/chromium/chrome/browser/bare/BareUpdateCheck.java b/chrome/android/java/src/org/chromium/chrome/browser/bare/BareUpdateCheck.java
index 791712a0746..a47025fcf91 100644
--- a/chrome/android/java/src/org/chromium/chrome/browser/bare/BareUpdateCheck.java
+++ b/chrome/android/java/src/org/chromium/chrome/browser/bare/BareUpdateCheck.java
@@ -119,6 +119,19 @@ public class BareUpdateCheck {
      */
     public static void clearBadge() {
         prefs().writeBoolean(ChromePreferenceKeys.BARE_UPDATE_BADGE, false);
+        // Remember which release was on screen. Without this the next check raises the dot
+        // again for the same version, so someone who looked and chose to stay where they are
+        // gets asked once a day until they give in.
+        String latest = getLatestTag();
+        if (latest != null) {
+            prefs().writeString(ChromePreferenceKeys.BARE_UPDATE_ACKED_TAG, latest);
+        }
+    }
+
+    /** The release the user has already been shown, or null if none has been. */
+    private static @Nullable String ackedTag() {
+        String tag = prefs().readString(ChromePreferenceKeys.BARE_UPDATE_ACKED_TAG, "");
+        return tag.isEmpty() ? null : tag;
     }
 
     /**
@@ -161,7 +174,7 @@ public class BareUpdateCheck {
                                     prefs().writeString(
                                             ChromePreferenceKeys.BARE_UPDATE_LATEST_TAG, tag);
                                 }
-                                if (newer) {
+                                if (newer && !tag.equals(ackedTag())) {
                                     prefs().writeBoolean(
                                             ChromePreferenceKeys.BARE_UPDATE_BADGE, true);
                                 }
diff --git a/chrome/browser/preferences/android/java/src/org/chromium/chrome/browser/preferences/ChromePreferenceKeys.java b/chrome/browser/preferences/android/java/src/org/chromium/chrome/browser/preferences/ChromePreferenceKeys.java
index 944d26389ba..165a010ed08 100644
--- a/chrome/browser/preferences/android/java/src/org/chromium/chrome/browser/preferences/ChromePreferenceKeys.java
+++ b/chrome/browser/preferences/android/java/src/org/chromium/chrome/browser/preferences/ChromePreferenceKeys.java
@@ -414,6 +414,12 @@ public final class ChromePreferenceKeys {
      */
     public static final String BARE_UPDATE_ONBOARDED = "Chrome.Bare.UpdateOnboarded";
 
+    /**
+     * The release tag the user has already been shown. The dot is not raised again for it, so
+     * declining an update is remembered rather than asked once a day until it is taken.
+     */
+    public static final String BARE_UPDATE_ACKED_TAG = "Chrome.Bare.UpdateAckedTag";
+
     public static final String DOWNLOAD_USE_EXTERNAL_DOWNLOAD_MANAGER =
             "Chrome.Download.UseExternalDownloadManager";
 
@@ -1228,6 +1234,7 @@ public final class ChromePreferenceKeys {
                 BARE_UPDATE_BADGE,
                 BARE_UPDATE_LAST_CHECK_MS,
                 BARE_UPDATE_LATEST_TAG,
+                BARE_UPDATE_ACKED_TAG,
                 BARE_UPDATE_MODE,
                 BARE_UPDATE_ONBOARDED,
                 BARE_UPDATE_REMINDER,

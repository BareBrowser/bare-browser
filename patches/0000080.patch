diff --git a/components/send_tab_to_self/entry_point_display_reason.cc b/components/send_tab_to_self/entry_point_display_reason.cc
index 876a016264c..9961be3736b 100644
--- a/components/send_tab_to_self/entry_point_display_reason.cc
+++ b/components/send_tab_to_self/entry_point_display_reason.cc
@@ -107,12 +107,13 @@ std::optional<EntryPointDisplayReason> GetEntryPointDisplayReason(
     return std::nullopt;
   }
 
-  if (ShouldOfferSignin(sync_service, pref_service)) {
-    return EntryPointDisplayReason::kOfferSignIn;
-  }
-
-  if (ShouldOfferReauth(sync_service, pref_service)) {
-    return EntryPointDisplayReason::kOfferReauth;
+  // De-Googled build: never show the entry point in order to ask for a Google
+  // account. Upstream offers send-tab-to-self to signed-out users precisely to
+  // recruit a sign-in, which in this build lands on a page that cannot complete.
+  // Returning nullopt removes the entry point from every surface that asks here.
+  if (ShouldOfferSignin(sync_service, pref_service) ||
+      ShouldOfferReauth(sync_service, pref_service)) {
+    return std::nullopt;
   }
 
   if (HasUserActionableErrorBlockingSendTabToSelf(*sync_service)) {

 .../signin_button/SigninButtonMediator.java   | 19 ++++++++++++-------
 1 file changed, 12 insertions(+), 7 deletions(-)

diff --git a/chrome/browser/ui/android/toolbar/java/src/org/chromium/chrome/browser/toolbar/signin_button/SigninButtonMediator.java b/chrome/browser/ui/android/toolbar/java/src/org/chromium/chrome/browser/toolbar/signin_button/SigninButtonMediator.java
index a05eb61fba9..531d43584a6 100644
--- a/chrome/browser/ui/android/toolbar/java/src/org/chromium/chrome/browser/toolbar/signin_button/SigninButtonMediator.java
+++ b/chrome/browser/ui/android/toolbar/java/src/org/chromium/chrome/browser/toolbar/signin_button/SigninButtonMediator.java
@@ -253,13 +253,18 @@ final class SigninButtonMediator
     }
 
     void updateButtonVisibility(boolean shouldShowOnPage) {
-        mShouldShowOnPage = shouldShowOnPage;
-
-        // INFLATE_BUTTON is true as long as the button should exist on the current page.
-        mModel.set(SigninButtonProperties.SHOULD_SHOW_ON_PAGE, mShouldShowOnPage);
-
-        // SHOW_BUTTON depends on both page state and available space.
-        mModel.set(SigninButtonProperties.IS_VISIBLE, mShouldShowOnPage && mHasSpaceToShow);
+        // De-Googled build: the avatar button is never shown.
+        //
+        // Its only action is "Signed out. Opens options to sign in.", and signing in
+        // is deliberately not possible here, so the button is a dead end on every new
+        // tab. Both properties are pinned to false rather than left to the page and
+        // space checks, so the button is neither inflated nor made visible.
+        //
+        // updateButtonState() asserts IS_VISIBLE is false for off-the-record and null
+        // profiles, which still holds.
+        mShouldShowOnPage = false;
+        mModel.set(SigninButtonProperties.SHOULD_SHOW_ON_PAGE, false);
+        mModel.set(SigninButtonProperties.IS_VISIBLE, false);
     }
 
     private void updateButtonState() {

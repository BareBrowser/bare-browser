From 4cd21e2dcccb7eaba0c7bb0f315078c357b4a42c Mon Sep 17 00:00:00 2001
From: Bare <git@barebrowser.org>
Date: Mon, 12 Oct 2026 22:38:22 +0000
Subject: [PATCH] Keep account preview data off

Chromium 156 turned kEnableAccountPreviewData on; at 153 it was off. Its
service is created for every profile and fetches sync preview data from
chromesyncpreview.pa.googleapis.com for accounts that have refresh tokens.
This build has no browser sign-in, so in practice there is no such account,
and no request was seen. It is off again anyway, so that nothing depends on
that staying true.
---
 components/signin/public/base/signin_switches.cc | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/components/signin/public/base/signin_switches.cc b/components/signin/public/base/signin_switches.cc
index 8ed63a3dbca..d0631ac1c5d 100644
--- a/components/signin/public/base/signin_switches.cc
+++ b/components/signin/public/base/signin_switches.cc
@@ -295,7 +295,10 @@ BASE_FEATURE(kDontIncludeSIDUnsecureCookiesInGaiaAuthFetcher,
 
 // Enables fetching sync preview data from the server for accounts with refresh
 // tokens.
-BASE_FEATURE(kEnableAccountPreviewData, base::FEATURE_ENABLED_BY_DEFAULT);
+// Bare: off. Its service is built for every profile and would ask
+// chromesyncpreview.pa.googleapis.com about any account with a refresh token;
+// this build has no browser sign-in to give it one.
+BASE_FEATURE(kEnableAccountPreviewData, base::FEATURE_DISABLED_BY_DEFAULT);
 const base::FeatureParam<base::TimeDelta>
     kAccountPreviewDataPeriodicRefreshTiming{
         &kEnableAccountPreviewData, "AccountPreviewDataPeriodicRefreshTiming",

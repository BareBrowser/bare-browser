From cb05e514fcbbb0b9688eb17a2014413ec735580c Mon Sep 17 00:00:00 2001
From: Bare <git@barebrowser.org>
Date: Tue, 18 Aug 2026 17:11:31 +0000
Subject: [PATCH] Patch 0000034

---
 .../org/chromium/components/omnibox/OmniboxFeatures.java  | 4 +++-
 components/omnibox/common/omnibox_features.cc             | 8 +++++++-
 2 files changed, 10 insertions(+), 2 deletions(-)

diff --git a/components/omnibox/common/android/java/src/org/chromium/components/omnibox/OmniboxFeatures.java b/components/omnibox/common/android/java/src/org/chromium/components/omnibox/OmniboxFeatures.java
index bb444ba6776..8efdc931668 100644
--- a/components/omnibox/common/android/java/src/org/chromium/components/omnibox/OmniboxFeatures.java
+++ b/components/omnibox/common/android/java/src/org/chromium/components/omnibox/OmniboxFeatures.java
@@ -146,8 +146,10 @@ public class OmniboxFeatures {
     public static final CachedFlag sPostDelayedTaskFocusTab =
             newFlag(OmniboxFeatureList.POST_DELAYED_TASK_FOCUS_TAB, FeatureState.ENABLED_IN_PROD);
 
+    // De-Googled build: ENABLED_IN_PROD rather than ENABLED_IN_TEST, matching the native
+    // default, so the search engine management screen is reachable in a shipped build.
     public static final CachedFlag sOmniboxSiteSearch =
-            newFlag(OmniboxFeatureList.OMNIBOX_SITE_SEARCH, FeatureState.ENABLED_IN_TEST);
+            newFlag(OmniboxFeatureList.OMNIBOX_SITE_SEARCH, FeatureState.ENABLED_IN_PROD);
 
     public static final CachedFlag sStarterPackExpansion =
             newFlag(OmniboxFeatureList.STARTER_PACK_EXPANSION, FeatureState.ENABLED_IN_PROD);
diff --git a/components/omnibox/common/omnibox_features.cc b/components/omnibox/common/omnibox_features.cc
index c1352e2e165..5da1084a4dd 100644
--- a/components/omnibox/common/omnibox_features.cc
+++ b/components/omnibox/common/omnibox_features.cc
@@ -394,7 +394,13 @@ BASE_FEATURE(kOmniboxPrefetchSelectedSuggestionsOmtAndroid, DISABLED);
 BASE_FEATURE(kOmniboxSearchPrefetchOnEnterKeyDown, DISABLED);
 
 // Enables keyword-based site search functionality on Android devices.
-BASE_FEATURE(kOmniboxSiteSearch, DISABLED);
+//
+// De-Googled build: enabled. This unlocks "Manage search engines and site search", which is
+// the only way to add a search engine by hand on Android. It matters here because the
+// prepopulated engine list lives in third_party/search_engines_data, which is not tracked by
+// the chromium/src git history, so a custom built-in engine cannot ship in a patch series.
+// Letting the user add their own covers that, and the added engine can be made the default.
+BASE_FEATURE(kOmniboxSiteSearch, ENABLED);
 
 // Enables additional site search providers for the Site search Starter Pack.
 BASE_FEATURE(kStarterPackExpansion, enable_if(!IS_IOS));

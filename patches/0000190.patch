+    private static boolean stored() {
+        return ChromeSharedPreferences.getInstance()
+                .readBoolean(ChromePreferenceKeys.DOWNLOAD_EXTERNAL_SEND_SIGN_IN, false);
+    }
+
+    @Test
+    public void testSharingSignInIsOffByDefault() {
+        assertFalse(BareWelcomeOverlay.currentChoices(false).downloadSignIn);
+    }
+
+    @Test
+    public void testItIsStoredOnlyWhileAManagerIsInUse() {
+        BareWelcomeOverlay.Choices choices = BareWelcomeOverlay.currentChoices(false);
+        choices.externalDownloadManager = true;
+        choices.downloadSignIn = true;
+        BareWelcomeOverlay.applyChoices(choices);
+        assertTrue(stored());
+
+        // Turning the manager off takes the sharing with it, even if the switch was left on.
+        choices.externalDownloadManager = false;
+        BareWelcomeOverlay.applyChoices(choices);
+        assertFalse(stored());
+    }
+
+    @Test
+    public void testAReviewDoesNotShowSharingWithoutAManager() {
+        ChromeSharedPreferences.getInstance()
+                .writeBoolean(ChromePreferenceKeys.DOWNLOAD_EXTERNAL_SEND_SIGN_IN, true);
+        assertFalse(BareWelcomeOverlay.currentChoices(true).downloadSignIn);
+
+        ChromeSharedPreferences.getInstance()
+                .writeBoolean(ChromePreferenceKeys.DOWNLOAD_USE_EXTERNAL_DOWNLOAD_MANAGER, true);
+        assertTrue(BareWelcomeOverlay.currentChoices(true).downloadSignIn);
+    }
+}

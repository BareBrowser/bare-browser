+                        R.style.Theme_BrowserUI_DayNight);
+        mRoot = LayoutInflater.from(mContext).inflate(R.layout.bare_toolbar_preview, null);
+    }
+
+    private boolean shown(int id) {
+        return mRoot.findViewById(id).getVisibility() == View.VISIBLE;
+    }
+
+    @Test
+    public void testTheFullLayoutShowsTheAddressBarAndAllFivePositions() {
+        BareToolbarPreviewBinder.bind(
+                mRoot, ActionId.HOME_BUTTON, ActionId.INCOGNITO, false, slot -> {});
+        assertTrue(shown(R.id.bare_preview_full));
+        assertFalse(shown(R.id.bare_preview_minimal));
+        for (int id :
+                new int[] {
+                    R.id.bare_preview_slot_home,
+                    R.id.bare_preview_slot_extra,
+                    R.id.bare_preview_new_tab,
+                    R.id.bare_preview_tab_switcher,
+                    R.id.bare_preview_slot_app_menu,
+                }) {
+            ImageView view = mRoot.findViewById(id);
+            assertNotNull(view.getDrawable());
+            assertFalse(view.getContentDescription().toString().isEmpty());
+        }
+    }
+
+    @Test
+    public void testTheMinimalLayoutIsOneRowWithTheThreeFixedButtons() {
+        BareToolbarPreviewBinder.bind(
+                mRoot, ActionId.HOME_BUTTON, ActionId.INCOGNITO, true, slot -> {});
+        assertTrue(shown(R.id.bare_preview_minimal));
+        assertFalse(shown(R.id.bare_preview_full));
+        for (int id :
+                new int[] {
+                    R.id.bare_preview_minimal_new_tab,
+                    R.id.bare_preview_minimal_tab_switcher,
+                    R.id.bare_preview_minimal_app_menu,
+                }) {
+            assertNotNull(((ImageView) mRoot.findViewById(id)).getDrawable());
+        }
+    }
+
+    @Test
+    public void testChoosingAButtonRedrawsItsPosition() {
+        BareToolbarPreviewBinder.bind(
+                mRoot, ActionId.HOME_BUTTON, ActionId.INCOGNITO, false, slot -> {});
+        ImageView first = mRoot.findViewById(R.id.bare_preview_slot_home);
+        String before = first.getContentDescription().toString();
+
+        BareToolbarPreviewBinder.bind(
+                mRoot, ActionId.FIND_IN_PAGE, ActionId.INCOGNITO, false, slot -> {});
+        assertFalse(before.equals(first.getContentDescription().toString()));
+    }
+
+    @Test
+    public void testOnlyTheTwoChangeablePositionsRespondToAPress() {
+        List<Integer> pressed = new ArrayList<>();
+        BareToolbarPreviewBinder.bind(
+                mRoot, ActionId.HOME_BUTTON, ActionId.INCOGNITO, false, pressed::add);
+
+        mRoot.findViewById(R.id.bare_preview_slot_home).performClick();
+        mRoot.findViewById(R.id.bare_preview_slot_extra).performClick();
+        mRoot.findViewById(R.id.bare_preview_new_tab).performClick();
+        mRoot.findViewById(R.id.bare_preview_tab_switcher).performClick();
+        mRoot.findViewById(R.id.bare_preview_slot_app_menu).performClick();
+
+        assertEquals(2, pressed.size());
+        assertEquals(BareToolbarSlot.HOME, (int) pressed.get(0));
+        assertEquals(BareToolbarSlot.EXTRA, (int) pressed.get(1));
+    }
+
+    @Test
+    public void testWithoutACallbackThePictureIsInert() {
+        BareToolbarPreviewBinder.bind(
+                mRoot, ActionId.HOME_BUTTON, ActionId.INCOGNITO, false, null);
+        View home = mRoot.findViewById(R.id.bare_preview_slot_home);
+        assertFalse(home.isClickable());
+        assertFalse(home.hasOnClickListeners());
+    }
+}

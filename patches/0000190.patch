@@ -0,0 +1,113 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.bare.settings;
+
+import android.content.Context;
+import android.content.res.ColorStateList;
+import android.view.View;
+import android.widget.ImageView;
+
+import androidx.core.widget.ImageViewCompat;
+
+import org.chromium.base.Callback;
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.chrome.R;
+import org.chromium.chrome.browser.ui.actions.ActionId;
+import org.chromium.chrome.browser.ui.bottombar.BareToolbarSlot;
+import org.chromium.components.browser_ui.styles.SemanticColorUtils;
+
+/**
+ * Fills in the toolbar picture ({@code bare_toolbar_preview}) for a given arrangement.
+ *
+ * <p>Settings draws it from what is stored and the welcome draws it from what the user has picked
+ * so far, so the two look the same because they run this one piece of code.
+ */
+@NullMarked
+public final class BareToolbarPreviewBinder {
+    private static final @BareToolbarSlot int[] CONFIGURABLE_SLOTS = {
+        BareToolbarSlot.HOME, BareToolbarSlot.EXTRA
+    };
+
+    private BareToolbarPreviewBinder() {}
+
+    /**
+     * Draws the picture.
+     *
+     * @param root The inflated {@code bare_toolbar_preview}.
+     * @param first The action in the first changeable position.
+     * @param second The action in the second changeable position.
+     * @param minimal Whether to draw the one-row layout.
+     * @param onSlotClicked Called with the slot pressed, or null to leave the picture inert.
+     */
+    public static void bind(
+            View root,
+            @ActionId int first,
+            @ActionId int second,
+            boolean minimal,
+            @Nullable Callback<Integer> onSlotClicked) {
+        Context context = root.getContext();
+        root.findViewById(R.id.bare_preview_minimal)
+                .setVisibility(minimal ? View.VISIBLE : View.GONE);
+        root.findViewById(R.id.bare_preview_full).setVisibility(minimal ? View.GONE : View.VISIBLE);
+
+        if (minimal) {
+            bindFixed(root, R.id.bare_preview_minimal_new_tab, ActionId.NEW_TAB);
+            bindFixed(root, R.id.bare_preview_minimal_tab_switcher, ActionId.TAB_SWITCHER);
+            bindFixed(root, R.id.bare_preview_minimal_app_menu, ActionId.APP_MENU);
+            return;
+        }
+
+        for (@BareToolbarSlot int slot : CONFIGURABLE_SLOTS) {
+            ImageView view = root.findViewById(viewIdForSlot(slot));
+            @ActionId int actionId = slot == BareToolbarSlot.HOME ? first : second;
+
+            setIcon(view, actionId);
+            view.setContentDescription(
+                    context.getString(
+                            R.string.bare_toolbar_position_description,
+                            context.getString(BareToolbarActionUi.positionNameFor(slot)),
+                            context.getString(BareToolbarActionUi.labelFor(actionId))));
+            view.setOnClickListener(
+                    onSlotClicked == null ? null : v -> onSlotClicked.onResult(slot));
+            // After the listener: setting one makes a view clickable, even when it is null.
+            view.setClickable(onSlotClicked != null);
+            view.setFocusable(onSlotClicked != null);
+        }
+
+        bindFixed(root, R.id.bare_preview_new_tab, ActionId.NEW_TAB);
+        bindFixed(root, R.id.bare_preview_tab_switcher, ActionId.TAB_SWITCHER);
+        bindFixed(root, R.id.bare_preview_slot_app_menu, ActionId.APP_MENU);
+    }
+
+    /** The positions the user cannot change are drawn, and say so if asked. */
+    private static void bindFixed(View root, int viewId, @ActionId int actionId) {
+        Context context = root.getContext();
+        ImageView view = root.findViewById(viewId);
+        setIcon(view, actionId);
+        view.setContentDescription(
+                context.getString(
+                        R.string.bare_toolbar_position_fixed_description,
+                        context.getString(BareToolbarActionUi.labelFor(actionId))));
+    }
+
+    /**
+     * Draws one icon in the colour the toolbar draws its icons in. Tinted because several of
+     * these are black assets that the real bar tints as it draws them.
+     */
+    private static void setIcon(ImageView view, @ActionId int actionId) {
+        view.setImageResource(BareToolbarActionUi.iconFor(actionId));
+        ImageViewCompat.setImageTintList(
+                view,
+                ColorStateList.valueOf(
+                        SemanticColorUtils.getDefaultIconColor(view.getContext())));
+    }
+
+    private static int viewIdForSlot(@BareToolbarSlot int slot) {
+        return slot == BareToolbarSlot.HOME
+                ? R.id.bare_preview_slot_home
+                : R.id.bare_preview_slot_extra;
+    }
+}

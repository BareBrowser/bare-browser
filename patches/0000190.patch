+    }
+
+    @Test
+    public void testTheRequestDiffersWithAndWithoutTheCookie() {
+        // Sharing off: the native side passes no cookie, and the intent has no Cookie header.
+        Intent off = DownloadController.buildHandoffIntent(URL, "", PAGE, AGENT, "");
+        // Sharing on: the cookie travels in the headers.
+        Intent on = DownloadController.buildHandoffIntent(URL, "", PAGE, AGENT, COOKIE);
+        assertFalse(off.getBundleExtra(Browser.EXTRA_HEADERS).containsKey("Cookie"));
+        assertEquals(COOKIE, on.getBundleExtra(Browser.EXTRA_HEADERS).getString("Cookie"));
+        // Everything else is the same either way.
+        assertEquals(off.getDataString(), on.getDataString());
+        assertEquals(
+                off.getBundleExtra(Browser.EXTRA_HEADERS).getString("Referer"),
+                on.getBundleExtra(Browser.EXTRA_HEADERS).getString("Referer"));
+    }
 }

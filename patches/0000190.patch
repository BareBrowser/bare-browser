+
+    @Test
+    public void testSharingSignInIsOffUntilTheUserTurnsItOn() {
+        ChromeSharedPreferences.getInstance().removeKey(ChromePreferenceKeys.DOWNLOAD_EXTERNAL_SEND_SIGN_IN);
+        assertFalse(DownloadController.shouldSendSignInToExternalDownloadManager());
+        ChromeSharedPreferences.getInstance().writeBoolean(ChromePreferenceKeys.DOWNLOAD_EXTERNAL_SEND_SIGN_IN, true);

+++ b/chrome/browser/ui/android/bottombar/java/src/org/chromium/chrome/browser/ui/bottombar/BareToolbarDefaults.java
@@ -96,12 +96,15 @@ public final class BareToolbarDefaults {
      * <p>GLIC and AI Mode are absent for their own reason. They still exist as actions, because
      * the shared slot they came from is upstream code this build keeps in step with, but they are
      * Google surfaces that do nothing here and offering them as choices would be offering nothing.
+     *
+     * <p>Translate is absent too. It needs a Google API key, which this build does not
+     * have, so the button could be pressed but never translate anything. A slot that
+     * was given Translate by an earlier release falls back to its default.
      */
     public static final @ActionId int[] CATALOGUE = {
         ActionId.HOME_BUTTON,
         ActionId.INCOGNITO,
         ActionId.SHARE,
-        ActionId.TRANSLATE,
         ActionId.BOOKMARK,
     };
 

 .../settings/BareToolbarSettingsUnitTest.java |  2 +-
 .../ui/bottombar/BareToolbarDefaults.java     |  5 +++-
 .../bottombar/BareToolbarLayoutUnitTest.java  | 28 +++++++++++++------
 .../bottombar/BareToolbarPrefsUnitTest.java   |  4 +--
 .../BareToolbarSecondaryActionsUnitTest.java  | 16 +++++------
 6 files changed, 42 insertions(+), 20 deletions(-)

diff --git a/chrome/android/java/src/org/chromium/chrome/browser/bare/BareButtonDataActionAdapter.java b/chrome/android/java/src/org/chromium/chrome/browser/bare/BareButtonDataActionAdapter.java
index 06c8f8123cb..c12978e4657 100644
--- a/chrome/android/java/src/org/chromium/chrome/browser/bare/BareButtonDataActionAdapter.java
+++ b/chrome/android/java/src/org/chromium/chrome/browser/bare/BareButtonDataActionAdapter.java
@@ -109,6 +109,13 @@ public class BareButtonDataActionAdapter
                         mTab = tab;
                         refresh();
                     }
+
+                    // Whether Share has something to share depends on the page, so a tab that
+                    // opened on the new tab page has to be asked again once it navigates.
+                    @Override
+                    public void onUrlUpdated(Tab tab) {
+                        refresh();
+                    }
                 };
 
         mRegistry.register(mActionId, mModel);

+package org.chromium.chrome.browser.bare.settings;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertNotEquals;
+import static org.junit.Assert.assertNotNull;
+import static org.junit.Assert.assertNull;
+
+import android.content.Context;
+import android.view.ContextThemeWrapper;
+import android.view.View;
+
+import androidx.preference.Preference;
+import androidx.test.core.app.ApplicationProvider;
+
+import org.junit.Test;
+import org.junit.runner.RunWith;
+
+import org.chromium.base.test.BaseRobolectricTestRunner;
+import org.chromium.chrome.R;
+import org.chromium.components.browser_ui.widget.containment.ContainerStyle;
+import org.chromium.components.browser_ui.widget.containment.ContainmentItem;
+import org.chromium.components.browser_ui.widget.containment.ContainmentItemController;
+import org.chromium.components.browser_ui.widget.containment.ContainmentViewStyler;
+
+import java.util.ArrayList;
+
+/**
+ * Unit tests for how the toolbar picture sits in the settings list.
+ *
+ * <p>The list restyles every row's background after the row is bound. The picture draws its own
+ * card, so the row has to ask for no background; otherwise the list's white card shows around it.
+ */
+@RunWith(BaseRobolectricTestRunner.class)
+public class BareToolbarPreviewPreferenceUnitTest {
+    private final Context mContext =
+            new ContextThemeWrapper(
+                    ApplicationProvider.getApplicationContext(), R.style.Theme_BrowserUI_DayNight);
+
+    @Test
+    public void testThePictureAsksTheListForNoBackground() {
+        BareToolbarPreviewPreference picture = new BareToolbarPreviewPreference(mContext, null);
+        assertEquals(
+                ContainmentItem.BackgroundStyle.NONE, picture.getCustomBackgroundStyle());
+    }
+
+    @Test
+    public void testTheListLeavesTheRowWithoutABackground() {
+        ArrayList<Preference> rows = new ArrayList<>();
+        rows.add(new BareToolbarPreviewPreference(mContext, null));
+        rows.add(new Preference(mContext));
+
+        ArrayList<ContainerStyle> styles =
+                new ContainmentItemController(mContext).generatePreferenceStyles(rows);
+
+        assertEquals(ContainerStyle.EMPTY, styles.get(0));
+        // An ordinary row next to it still gets the list's card.
+        assertNotEquals(ContainerStyle.EMPTY, styles.get(1));
+
+        View picture = new View(mContext);
+        ContainmentViewStyler.applyBackgroundStyle(picture, styles.get(0));
+        assertNull(picture.getBackground());
+
+        View ordinary = new View(mContext);
+        ContainmentViewStyler.applyBackgroundStyle(ordinary, styles.get(1));
+        assertNotNull(ordinary.getBackground());
+    }
+}

+bool HasType(const base::Value& value, SettingType type) {
+  switch (type) {
+    case SettingType::kBool:
+      return value.is_bool();
+    case SettingType::kInt:
+      return value.is_int();
+    case SettingType::kDouble:
+      return value.is_double() || value.is_int();
+    case SettingType::kString:
+      return value.is_string();
+    case SettingType::kStringSet:
+    case SettingType::kList:
+      return value.is_list();
+    case SettingType::kDict:
+      return value.is_dict();
+  }
+}
+
+bool IsValid(const Setting& setting, const base::Value& value) {
+  return HasType(value, setting.type) && setting.is_valid(value);
+}

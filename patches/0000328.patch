+}
+
+FakeAndroidPrefs::FakeAndroidPrefs() = default;
+FakeAndroidPrefs::~FakeAndroidPrefs() = default;
+
+std::optional<base::Value> FakeAndroidPrefs::Get(const std::string& key,
+                                                 SettingType type) const {
+  auto it = values_.find(key);
+  if (it == values_.end()) {
+    return std::nullopt;
+  }
+  return it->second.Clone();
+}
+
+void FakeAndroidPrefs::Set(const std::string& key, const base::Value& value) {
+  values_[key] = value.Clone();
+}
+
+void FakeAndroidPrefs::Remove(const std::string& key) {
+  values_.erase(key);
+}
+
+void RegisterSettingsForTest(PrefRegistrySimple* registry,
+                             SettingStore store) {
+  for (const Setting& setting : AllSettings()) {
+    if (setting.store != store) {
+      continue;
+    }
+    switch (setting.type) {
+      case SettingType::kBool:
+        registry->RegisterBooleanPref(setting.key, false);
+        break;
+      case SettingType::kInt:
+        registry->RegisterIntegerPref(setting.key, 0);
+        break;
+      case SettingType::kDouble:
+        registry->RegisterDoublePref(setting.key, 0);
+        break;
+      case SettingType::kString:
+        registry->RegisterStringPref(setting.key, "");
+        break;
+      case SettingType::kStringSet:
+      case SettingType::kList:
+        registry->RegisterListPref(setting.key);
+        break;
+      case SettingType::kDict:
+        registry->RegisterDictionaryPref(setting.key);
+        break;
+    }
+  }
+}
+
+}  // namespace bare::backup

+namespace bare::backup {
+namespace {
+
+// Everything a backup reads from or restores into, for one phone.
+class Phone {
+ public:
+  Phone() {
+    RegisterSettingsForTest(profile_.registry(), SettingStore::kProfile);
+    RegisterSettingsForTest(local_state_.registry(),
+                            SettingStore::kLocalState);
+    HostContentSettingsMap::RegisterProfilePrefs(
+        engines_env_.pref_service().registry());
+    site_settings_ = base::MakeRefCounted<HostContentSettingsMap>(
+        &engines_env_.pref_service(), false, true, false, false);
+    engines_env_.template_url_service()->Load();
+
+    auto storage = std::make_unique<FakeReadingListModelStorage>();
+    FakeReadingListModelStorage* storage_ptr = storage.get();
+    reading_list_ = std::make_unique<ReadingListModelImpl>(
+        std::move(storage), syncer::StorageType::kUnspecified,
+        syncer::WipeModelUponSyncDisabledBehavior::kNever, &clock_);
+    storage_ptr->TriggerLoadCompletion();

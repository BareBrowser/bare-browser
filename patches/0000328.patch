@@ -0,0 +1,57 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_BARE_BACKUP_BACKUP_SITE_SETTINGS_H_
+#define CHROME_BROWSER_BARE_BACKUP_BACKUP_SITE_SETTINGS_H_
+
+#include <stddef.h>
+
+#include <optional>
+
+#include "base/values.h"
+
+class HostContentSettingsMap;
+
+// Site settings for a fixed list of types (cookies, JavaScript, pop-ups,
+// location, camera, microphone, notifications and similar). Chooser grants
+// such as USB devices are not content settings and aren't on the list.
+// Types are stored by their registry name, settings as "allow", "block",
+// "ask" or "session_only".
+//
+// - Setup: the global default of each type ({"defaults": {"popups": "block"}}).
+// - Personal (personal/site_settings.json): the per-site exceptions the user
+//   set, without expiring or one-time grants.
+namespace bare::backup {
+
+inline constexpr size_t kMaxSiteExceptions = 10000;
+
+struct SiteSettingsRestoreResult {
+  size_t applied = 0;
+  // Unknown type, a type not on the list, a bad pattern or a value the type
+  // doesn't take.
+  size_t skipped = 0;
+};
+
+base::DictValue SiteDefaultsToJson(const HostContentSettingsMap& map);
+
+SiteSettingsRestoreResult RestoreSiteDefaults(HostContentSettingsMap& map,
+                                              const base::DictValue& json);
+
+struct SiteExceptionsWriteResult {
+  base::DictValue json;
+  size_t exceptions = 0;
+};
+
+SiteExceptionsWriteResult SiteExceptionsToJson(
+    const HostContentSettingsMap& map);
+
+// The backup wins where it and the phone set the same site and type. Returns
+// nullopt, changing nothing, if `json` isn't an exception list.
+std::optional<SiteSettingsRestoreResult> RestoreSiteExceptions(
+    HostContentSettingsMap& map,
+    const base::DictValue& json);
+
+}  // namespace bare::backup
+
+#endif  // CHROME_BROWSER_BARE_BACKUP_BACKUP_SITE_SETTINGS_H_

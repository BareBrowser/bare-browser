+// found in the LICENSE file.
+
+#include "chrome/browser/bare/backup/backup_site_settings.h"
+
+#include <string>
+
+#include "base/json/json_reader.h"
+#include "base/json/json_writer.h"
+#include "base/memory/scoped_refptr.h"
+#include "base/test/task_environment.h"
+#include "base/time/time.h"
+#include "components/content_settings/core/browser/host_content_settings_map.h"
+#include "components/content_settings/core/common/content_settings.h"
+#include "components/content_settings/core/common/content_settings_constraints.h"
+#include "components/content_settings/core/common/content_settings_pattern.h"
+#include "components/content_settings/core/common/content_settings_types.h"
+#include "components/sync_preferences/testing_pref_service_syncable.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "url/gurl.h"
+
+namespace bare::backup {
+namespace {
+
+base::DictValue Parse(std::string_view json) {
+  return *base::JSONReader::ReadDict(json, base::JSON_PARSE_RFC);
+}
+
+class TestMap {
+ public:
+  TestMap() {
+    HostContentSettingsMap::RegisterProfilePrefs(prefs_.registry());
+    map_ = base::MakeRefCounted<HostContentSettingsMap>(
+        &prefs_, /*is_off_the_record=*/false, /*store_last_modified=*/true,
+        /*restore_session=*/false, /*should_record_metrics=*/false);
+  }
+  ~TestMap() { map_->ShutdownOnUIThread(); }
+
+  HostContentSettingsMap& operator*() { return *map_; }
+  HostContentSettingsMap* operator->() { return map_.get(); }
+
+ private:
+  sync_preferences::TestingPrefServiceSyncable prefs_;
+  scoped_refptr<HostContentSettingsMap> map_;
+};
+
+ContentSetting Get(TestMap& map, const char* url, ContentSettingsType type) {
+  return map->GetContentSetting(GURL(url), GURL(url), type);
+}
+
+class BackupSiteSettingsTest : public testing::Test {
+ protected:
+  base::test::SingleThreadTaskEnvironment task_environment_;
+  TestMap source_;
+  TestMap target_;
+};
+
+TEST_F(BackupSiteSettingsTest, DefaultsRoundTrip) {
+  source_->SetDefaultContentSetting(ContentSettingsType::POPUPS,
+                                    CONTENT_SETTING_ALLOW);
+  source_->SetDefaultContentSetting(ContentSettingsType::GEOLOCATION,
+                                    CONTENT_SETTING_BLOCK);
+  source_->SetDefaultContentSetting(ContentSettingsType::JAVASCRIPT_OPTIMIZER,
+                                    CONTENT_SETTING_BLOCK);
+  const base::DictValue json = SiteDefaultsToJson(*source_);
+  EXPECT_EQ(*json.FindDict("defaults")->FindString("popups"), "allow");
+
+  SiteSettingsRestoreResult result =
+      RestoreSiteDefaults(*target_, Parse(*base::WriteJson(json)));
+  EXPECT_EQ(result.skipped, 0u);
+  EXPECT_GT(result.applied, 5u);
+  EXPECT_EQ(target_->GetDefaultContentSetting(ContentSettingsType::POPUPS),
+            CONTENT_SETTING_ALLOW);
+  EXPECT_EQ(target_->GetDefaultContentSetting(ContentSettingsType::GEOLOCATION),
+            CONTENT_SETTING_BLOCK);
+  EXPECT_EQ(target_->GetDefaultContentSetting(
+                ContentSettingsType::JAVASCRIPT_OPTIMIZER),
+            CONTENT_SETTING_BLOCK);
+}
+
+TEST_F(BackupSiteSettingsTest, BadDefaultsSkipped) {
+  SiteSettingsRestoreResult result = RestoreSiteDefaults(*target_, Parse(R"({
+      "defaults": {"popups": "sometimes", "no-such-type": "allow",
+                   "geolocation": 1, "notifications": "default",
+                   "javascript": "block"}})"));
+  EXPECT_EQ(result.applied, 1u);
+  EXPECT_EQ(result.skipped, 4u);
+  EXPECT_EQ(target_->GetDefaultContentSetting(ContentSettingsType::JAVASCRIPT),
+            CONTENT_SETTING_BLOCK);
+}
+
+// A file can't make a permission Allow for every site: Settings only offers
+// Ask or Block there, so such a default is refused and the phone's stays.
+TEST_F(BackupSiteSettingsTest, NoAllowDefaultForPermissions) {
+  SiteSettingsRestoreResult result = RestoreSiteDefaults(*target_, Parse(R"({
+      "defaults": {"clipboard": "allow", "geolocation": "allow",
+                   "notifications": "allow", "midi-sysex": "allow",
+                   "media-stream-camera": "allow", "popups": "allow"}})"));
+  EXPECT_EQ(result.applied, 1u);  // Pop-ups: a switch in Settings.
+  EXPECT_EQ(result.skipped, 5u);
+  for (ContentSettingsType type :
+       {ContentSettingsType::CLIPBOARD_READ_WRITE,
+        ContentSettingsType::GEOLOCATION, ContentSettingsType::NOTIFICATIONS,
+        ContentSettingsType::MIDI_SYSEX,
+        ContentSettingsType::MEDIASTREAM_CAMERA}) {
+    EXPECT_EQ(target_->GetDefaultContentSetting(type), CONTENT_SETTING_ASK)
+        << static_cast<int>(type);
+  }
+  // Block and Ask still come back.
+  result = RestoreSiteDefaults(*target_, Parse(R"({
+      "defaults": {"geolocation": "block", "notifications": "ask"}})"));
+  EXPECT_EQ(result.applied, 2u);
+  EXPECT_EQ(target_->GetDefaultContentSetting(ContentSettingsType::GEOLOCATION),
+            CONTENT_SETTING_BLOCK);
+}
+
+TEST_F(BackupSiteSettingsTest, ExceptionsRoundTrip) {
+  const auto site = ContentSettingsPattern::FromString("https://a.test:443");
+  const auto wild = ContentSettingsPattern::Wildcard();
+  source_->SetContentSettingCustomScope(site, wild,
+                                        ContentSettingsType::GEOLOCATION,
+                                        CONTENT_SETTING_ALLOW);
+  source_->SetContentSettingCustomScope(
+      ContentSettingsPattern::FromString("[*.]b.test"), wild,
+      ContentSettingsType::JAVASCRIPT, CONTENT_SETTING_BLOCK);
+  // A temporary grant is not exported.
+  content_settings::ContentSettingConstraints temporary;
+  temporary.set_lifetime(base::Hours(1));
+  source_->SetContentSettingCustomScope(
+      ContentSettingsPattern::FromString("https://c.test:443"), wild,
+      ContentSettingsType::MEDIASTREAM_CAMERA, CONTENT_SETTING_ALLOW,
+      temporary);
+
+  SiteExceptionsWriteResult written = SiteExceptionsToJson(*source_);
+  EXPECT_EQ(written.exceptions, 2u);
+
+  // The phone already blocks location for a.test; the backup wins.
+  target_->SetContentSettingCustomScope(site, wild,
+                                        ContentSettingsType::GEOLOCATION,
+                                        CONTENT_SETTING_BLOCK);
+  auto result = RestoreSiteExceptions(*target_,
+                                      Parse(*base::WriteJson(written.json)));
+  ASSERT_TRUE(result);
+  EXPECT_EQ(result->applied, 2u);
+  EXPECT_EQ(result->skipped, 0u);
+  EXPECT_EQ(Get(target_, "https://a.test/", ContentSettingsType::GEOLOCATION),
+            CONTENT_SETTING_ALLOW);
+  EXPECT_EQ(Get(target_, "https://x.b.test/", ContentSettingsType::JAVASCRIPT),
+            CONTENT_SETTING_BLOCK);
+  EXPECT_NE(Get(target_, "https://c.test/",
+                ContentSettingsType::MEDIASTREAM_CAMERA),
+            CONTENT_SETTING_ALLOW);
+
+  // Running it again changes nothing.
+  result = RestoreSiteExceptions(*target_, written.json);
+  EXPECT_EQ(SiteExceptionsToJson(*target_).exceptions, 2u);
+}
+
+TEST_F(BackupSiteSettingsTest, BadExceptionsSkipped) {
+  auto result = RestoreSiteExceptions(*target_, Parse(R"({"exceptions": [
+      {"type": "geolocation", "primary": "*", "secondary": "*", "setting": "allow"},
+      {"type": "geolocation", "primary": "not a [pattern", "secondary": "*", "setting": "allow"},
+      {"type": "geolocation", "primary": "https://a.test:443", "secondary": "https://b.test:443", "setting": "allow"},
+      {"type": "usb-chooser-data", "primary": "https://a.test:443", "secondary": "*", "setting": "allow"},
+      {"type": "popups", "primary": "https://a.test:443", "secondary": "*", "setting": "default"},
+      {"type": "popups", "primary": "https://a.test:443", "secondary": "*"},
+      "not an exception",
+      {"type": "popups", "primary": "https://a.test:443", "secondary": "*", "setting": "allow"}
+  ]})"));
+  ASSERT_TRUE(result);
+  EXPECT_EQ(result->applied, 1u);
+  EXPECT_EQ(result->skipped, 7u);
+  EXPECT_EQ(Get(target_, "https://a.test/", ContentSettingsType::POPUPS),
+            CONTENT_SETTING_ALLOW);
+  EXPECT_NE(Get(target_, "https://z.test/", ContentSettingsType::GEOLOCATION),
+            CONTENT_SETTING_ALLOW);
+}
+
+TEST_F(BackupSiteSettingsTest, NotAList) {
+  EXPECT_FALSE(RestoreSiteExceptions(*target_, Parse(R"({"exceptions": 3})")));
+  EXPECT_FALSE(RestoreSiteExceptions(*target_, Parse(R"({})")));
+}
+
+}  // namespace
+}  // namespace bare::backup

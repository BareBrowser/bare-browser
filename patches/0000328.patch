+    {"id": 5, "parent": "elsewhere", "type": "folder", "title": "bad root"},
+    {"id": 6, "parent": 5, "type": "url", "title": "in bad folder", "url": "https://a.test/"},
+    {"id": 2, "parent": 1, "type": "url", "title": "duplicate id", "url": "https://a.test/"},
+    {"id": 7, "parent": 1, "type": "separator"},

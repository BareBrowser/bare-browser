+std::string SerializeGurlForAndroid(const GURL& url) {
+  const url::Parsed& parsed = url.parsed_for_possibly_invalid_spec();
+  if (parsed.inner_parsed()) {
+    return std::string();
+  }
+  constexpr char kDelimiter = '\0';
+  std::string body = "1";
+  body += kDelimiter;
+  body += url.is_valid() ? "true" : "false";
+  for (const url::Component& part :
+       {parsed.scheme, parsed.username, parsed.password, parsed.host,
+        parsed.port, parsed.path, parsed.query, parsed.ref}) {
+    body += kDelimiter;
+    body += base::NumberToString(part.begin);
+    body += kDelimiter;
+    body += base::NumberToString(part.len);
+  }
+  body += kDelimiter;
+  body += parsed.potentially_dangling_markup ? "true" : "false";
+  body += kDelimiter;
+  body += "false";  // no inner URL
+  body += kDelimiter;
+  body += url.possibly_invalid_spec();
+  return base::NumberToString(body.size()) + kDelimiter + body;
+}

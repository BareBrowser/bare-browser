+PackageWriter::PackageWriter(const PackageLimits& limits) : limits_(limits) {}
+
+PackageWriter::~PackageWriter() = default;
+
+bool PackageWriter::Add(std::string_view name, std::string_view contents) {
+  if (!IsSafeEntryName(name) || name.back() == '/' ||
+      entries_.size() >= limits_.max_entries ||
+      contents.size() > limits_.max_file_size ||
+      contents.size() > limits_.max_total_size - total_size_ ||
+      std::ranges::any_of(entries_,
+                          [&](const Entry& e) { return e.name == name; })) {
+    return false;
+  }
+  entries_.push_back({std::string(name), std::string(contents)});
+  total_size_ += contents.size();
+  return true;
+}
+
+std::string PackageWriter::Finish() {
+  auto build = [this](bool deflate) {
+    std::string out;
+    std::string central;
+    for (const Entry& entry : entries_) {
+      std::string deflated;
+      if (deflate) {
+        deflated = RawDeflate(entry.contents);
+      }
+      const bool use_deflated =
+          deflate && deflated.size() < entry.contents.size();
+      const std::string_view body =
+          use_deflated ? std::string_view(deflated) : entry.contents;
+      const uint16_t method = use_deflated ? kMethodDeflated : kMethodStored;
+      const uint16_t flags = base::IsStringASCII(entry.name) ? 0 : kFlagUtf8Name;
+      const uint32_t crc = static_cast<uint32_t>(
+          crc32(0, reinterpret_cast<const Bytef*>(entry.contents.data()),
+                base::checked_cast<uInt>(entry.contents.size())));
+      const uint32_t offset = base::checked_cast<uint32_t>(out.size());
+
+      Append32(out, kLocalHeaderSignature);
+      Append16(out, kZipVersion);
+      Append16(out, flags);
+      Append16(out, method);
+      Append16(out, kDosTime);
+      Append16(out, kDosDate);
+      Append32(out, crc);
+      Append32(out, base::checked_cast<uint32_t>(body.size()));
+      Append32(out, base::checked_cast<uint32_t>(entry.contents.size()));
+      Append16(out, base::checked_cast<uint16_t>(entry.name.size()));
+      Append16(out, 0);
+      out += entry.name;
+      out += body;
+
+      Append32(central, kCentralHeaderSignature);
+      Append16(central, kZipVersion);
+      Append16(central, kZipVersion);
+      Append16(central, flags);
+      Append16(central, method);
+      Append16(central, kDosTime);
+      Append16(central, kDosDate);
+      Append32(central, crc);
+      Append32(central, base::checked_cast<uint32_t>(body.size()));
+      Append32(central, base::checked_cast<uint32_t>(entry.contents.size()));
+      Append16(central, base::checked_cast<uint16_t>(entry.name.size()));
+      Append16(central, 0);  // extra field
+      Append16(central, 0);  // comment
+      Append16(central, 0);  // disk
+      Append16(central, 0);  // internal attributes
+      Append32(central, 0);  // external attributes
+      Append32(central, offset);
+      central += entry.name;
+    }
+    const uint32_t central_offset = base::checked_cast<uint32_t>(out.size());
+    out += central;
+    Append32(out, kEndSignature);
+    Append16(out, 0);
+    Append16(out, 0);
+    Append16(out, base::checked_cast<uint16_t>(entries_.size()));
+    Append16(out, base::checked_cast<uint16_t>(entries_.size()));
+    Append32(out, base::checked_cast<uint32_t>(central.size()));
+    Append32(out, central_offset);
+    Append16(out, 0);
+    return out;
+  };
+
+  std::string zip = build(/*deflate=*/true);
+  if (total_size_ > limits_.max_ratio * zip.size()) {
+    zip = build(/*deflate=*/false);
+  }
+  entries_.clear();
+  total_size_ = 0;
+  return zip;
+}

+#ifndef CHROME_BROWSER_BARE_BACKUP_BACKUP_SETTINGS_H_
+#define CHROME_BROWSER_BARE_BACKUP_BACKUP_SETTINGS_H_
+
+#include <stddef.h>
+
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/containers/span.h"
+#include "base/memory/raw_ptr.h"
+#include "base/values.h"
+#include "url/gurl.h"
+
+class PrefService;
+
+// The settings a backup may carry. Only keys in AllSettings() are ever read,
+// written or restored, each with the values it accepts; anything else in a
+// file is reported and left alone.
+//
+// In a package, each group is one JSON file:
+//
+//   {"android": {"Bare.Glass": false, "Bare.Haptics": null},
+//    "profile": {"enable_do_not_track": true},
+//    "local_state": {"dns_over_https.mode": "secure"}}
+//
+// null means the setting was at its default, so a restore clears it on the
+// new phone rather than pinning today's default.
+namespace bare::backup {
+
+// What Java's GURL.serialize() writes for `url`, which is how
+// Chrome.Homepage.CustomGurl is stored. Empty for a URL with an inner URL
+// (filesystem:), which a homepage never is.
+std::string SerializeGurlForAndroid(const GURL& url);
+
+enum class SettingStore {
+  // The app's default SharedPreferences.
+  kAndroid,
+  kProfile,
+  kLocalState,
+};
+
+enum class SettingGroup {
+  kSetup,
+  kPersonal,
+};
+
+enum class SettingType {
+  kBool,
+  kInt,
+  kDouble,
+  kString,
+  // An Android string set, as a list of strings.
+  kStringSet,
+  kList,
+  kDict,
+};
+
+struct Setting {
+  SettingStore store;
+  SettingGroup group;
+  const char* key;
+  SettingType type;
+  // Checks a value already known to be of `type`.
+  bool (*is_valid)(const base::Value& value);
+  // Read once per process, so a change needs a restart.
+  bool needs_restart = false;
+  // For a personal setting: values that may also travel in Setup. Null
+  // means personal only.
+  bool (*also_setup_if)(const base::Value& value) = nullptr;
+};
+
+base::span<const Setting> AllSettings();
+
+// Bare's Java side reads and writes the app's SharedPreferences through this.
+class AndroidPrefs {
+ public:
+  virtual ~AndroidPrefs() = default;
+  // nullopt when the key isn't set.
+  virtual std::optional<base::Value> Get(const std::string& key,
+                                         SettingType type) const = 0;
+  virtual void Set(const std::string& key, const base::Value& value) = 0;
+  virtual void Remove(const std::string& key) = 0;
+};
+
+struct SettingsStores {
+  raw_ptr<AndroidPrefs> android = nullptr;
+  raw_ptr<PrefService> profile = nullptr;
+  raw_ptr<PrefService> local_state = nullptr;
+};
+
+struct SettingsWriteResult {
+  base::DictValue json;
+  size_t count = 0;
+};
+
+SettingsWriteResult SettingsToJson(SettingGroup group,
+                                   const SettingsStores& stores);
+
+struct SettingsRestoreResult {
+  size_t applied = 0;
+  // "store:key" of listed settings whose value was refused.
+  std::vector<std::string> skipped;
+  // "store:key" of keys that aren't on the list for this group.
+  std::vector<std::string> unknown;
+  bool needs_restart = false;
+};
+
+SettingsRestoreResult RestoreSettings(SettingGroup group,
+                                      const base::DictValue& json,
+                                      const SettingsStores& stores);
+
+}  // namespace bare::backup
+
+#endif  // CHROME_BROWSER_BARE_BACKUP_BACKUP_SETTINGS_H_

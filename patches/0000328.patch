+bool Hostname(const base::Value& value) {
+  const std::string& host = value.GetString();
+  return host.size() <= 255 &&
+         std::ranges::all_of(host, [](char c) {
+           return base::IsAsciiAlphaNumeric(c) || c == '.' || c == '-' ||
+                  c == ':' || c == '[' || c == ']';
+         });
+}
+
+// BareTranslateProtocol.isAllowedEndpoint: https anywhere, http only to the
+// phone itself or a private network.
+bool TranslateEndpoint(const base::Value& value) {
+  if (value.GetString().size() > kMaxStringLength) {
+    return false;
+  }
+  const GURL url(value.GetString());
+  if (!url.is_valid()) {
+    return false;
+  }
+  if (url.SchemeIs(url::kHttpsScheme)) {
+    return true;
+  }
+  if (!url.SchemeIs(url::kHttpScheme)) {
+    return false;
+  }
+  const std::string host = url.GetHost();
+  if (host == "localhost" || host.ends_with(".local") ||
+      host.ends_with(".lan") || host.starts_with("127.") ||
+      host.starts_with("10.") || host.starts_with("192.168.")) {
+    return true;
+  }
+  if (host.starts_with("172.")) {
+    const std::vector<SV> octets = base::SplitStringPiece(
+        host, ".", base::KEEP_WHITESPACE, base::SPLIT_WANT_ALL);
+    int second = 0;
+    return octets.size() == 4 && base::StringToInt(octets[1], &second) &&
+           second >= 16 && second <= 31;
+  }
+  return false;
+}
+
+// Chrome.Homepage.CustomGurl holds a GURL as Java's GURL.serialize() writes
+// it, and Java reads it back trusting the component offsets it carries. So a
+// restored value must be exactly what this build would write for its own
+// spec, and the page must be a web page or the new tab page.
+bool HomepageGurl(const base::Value& value) {
+  const std::string& serialized = value.GetString();
+  if (serialized.empty() || serialized.size() > kMaxUrlLength) {
+    return false;
+  }
+  const size_t last = serialized.rfind('\0');
+  if (last == std::string::npos) {
+    return false;
+  }
+  const GURL url(serialized.substr(last + 1));
+  const bool allowed = url.is_valid() && (url.SchemeIsHTTPOrHTTPS() ||
+                                          url.spec() == "chrome-native://newtab/" ||
+                                          url.spec() == "chrome://newtab/");
+  return allowed && serialized == SerializeGurlForAndroid(url);
+}
+
+// dns_over_https.templates: whitespace-separated https URL templates.
+bool DohTemplates(const base::Value& value) {
+  if (value.GetString().size() > kMaxStringLength) {
+    return false;
+  }
+  return std::ranges::all_of(
+      base::SplitStringPiece(value.GetString(), " \t\n", base::TRIM_WHITESPACE,
+                             base::SPLIT_WANT_NONEMPTY),
+      [](SV spec) {
+        const GURL url(spec);
+        return url.is_valid() && url.SchemeIs(url::kHttpsScheme);
+      });
+}
+
+// Templates that are all Chromium's built-in providers (public resolvers, the
+// same for everyone). A custom template can carry an account ID, so it stays
+// personal.
+bool BuiltInDohTemplates(const base::Value& value) {
+  const std::vector<SV> templates =
+      base::SplitStringPiece(value.GetString(), " \t\n",
+                             base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY);
+  return !templates.empty() &&
+         std::ranges::all_of(templates, [](SV spec) {
+           return std::ranges::any_of(
+               net::DohProviderEntry::GetList(), [&](const auto& entry) {
+                 return entry->doh_server_config.server_template() == spec;
+               });
+         });
+}

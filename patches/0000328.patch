+// Builds a package in memory. Anything it writes, ReadPackage() reads back
+// with the same limits.
+class PackageWriter {
+ public:
+  explicit PackageWriter(const PackageLimits& limits = PackageLimits());
+  PackageWriter(const PackageWriter&) = delete;
+  PackageWriter& operator=(const PackageWriter&) = delete;
+  ~PackageWriter();
+
+  // Returns false, and adds nothing, if `name` fails IsSafeEntryName(), names
+  // a directory, is already in the package, or would take it past a limit.
+  bool Add(std::string_view name, std::string_view contents);
+
+  // The zip. Entries are deflated, or all stored if deflating would put the
+  // package over the ratio limit.
+  std::string Finish();
+
+ private:
+  struct Entry {
+    std::string name;
+    std::string contents;
+  };
+
+  const PackageLimits limits_;
+  std::vector<Entry> entries_;
+  uint64_t total_size_ = 0;
+};
+
 }  // namespace bare::backup
 

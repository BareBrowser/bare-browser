+TEST(BackupSettingsTest, ListIsWellFormed) {
+  std::set<std::pair<SettingStore, std::string>> seen;
+  for (const Setting& setting : AllSettings()) {
+    EXPECT_TRUE(seen.insert({setting.store, setting.key}).second)
+        << setting.key;
+    EXPECT_TRUE(setting.is_valid);
+  }
+  // Session, device and bookkeeping state never goes in a backup.
+  for (const char* never :
+       {"Bare.Push.Distributor", "Bare.Push.Subscriptions",
+        "Chrome.Bare.UpdateLatestTag", "Chrome.Bare.UpdateLastCheckMs",
+        "Chrome.Bare.UpdateAckedTag", "Chrome.Bare.UpdateBadge",
+        "Chrome.Bare.UpdateOnboarded", "Bare.Incognito.FailedAttempts",
+        "Bare.ClearOnExit.VeilPending", "bare.clear_on_exit_pending",
+        "Bare.AppMenu.EditTipCount", "Chrome.Bare.NewIconUnlocked",
+        "Chrome.Bare.NewIconInUse", "Chrome.Download.ExternalManagerPackage",
+        "background_media_playback", "external_download_manager_enabled",
+        "external_download_manager_app", "incognito.incognito_reauthentication",
+        "shown_for_install", "draft_first_button"}) {
+    for (const Setting& setting : AllSettings()) {
+      EXPECT_NE(std::string(setting.key), never);
+    }
+  }
+}

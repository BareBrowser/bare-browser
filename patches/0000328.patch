+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_BARE_BACKUP_BACKUP_CONTENTS_H_
+#define CHROME_BROWSER_BARE_BACKUP_BACKUP_CONTENTS_H_
+
+#include <map>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/memory/raw_ptr.h"
+#include "base/types/expected.h"
+#include "chrome/browser/bare/backup/backup_bookmarks.h"
+#include "chrome/browser/bare/backup/backup_file.h"
+#include "chrome/browser/bare/backup/backup_package.h"
+#include "chrome/browser/bare/backup/backup_reading_list.h"
+#include "chrome/browser/bare/backup/backup_search_engines.h"
+#include "chrome/browser/bare/backup/backup_settings.h"
+#include "chrome/browser/bare/backup/backup_site_settings.h"
+
+class HostContentSettingsMap;
+class ReadingListModel;
+class TemplateURLService;
+
+namespace bookmarks {
+class BookmarkModel;
+}
+
+// What goes in a package and how it comes back out. A package holds:
+//
+//   manifest.json              {"schema": 1, "kind": "full",
+//                               "sections": [...], "counts": {...}}
+//   setup/settings.json        {"prefs": {...}, "site_defaults": {...},
+//                               "search_engine": {"default_prepopulate_id": 92}}
+//   personal/settings.json     {"prefs": {...}}
+//   personal/search_engines.json
+//   personal/site_settings.json
+//   personal/bookmarks.json
+//   personal/reading_list.json
+//
+// A setup package has the manifest and setup/ only.
+namespace bare::backup {
+
+inline constexpr int kSchemaVersion = 1;
+
+// Sections the restore screen offers a switch for.
+inline constexpr char kSectionSettings[] = "settings";
+inline constexpr char kSectionSearchEngines[] = "search_engines";
+inline constexpr char kSectionSiteSettings[] = "site_settings";
+inline constexpr char kSectionBookmarks[] = "bookmarks";
+
+struct Sources {
+  SettingsStores settings;
+  raw_ptr<HostContentSettingsMap> site_settings = nullptr;
+  raw_ptr<TemplateURLService> search_engines = nullptr;
+  raw_ptr<bookmarks::BookmarkModel> bookmarks = nullptr;
+  raw_ptr<ReadingListModel> reading_list = nullptr;
+};
+
+struct BuiltPackage {
+  std::string zip;
+  // For the file header: "settings", "bookmarks", "reading_list",
+  // "site_settings", "search_engines".
+  std::map<std::string, int> counts;
+};
+
+// Setup writes the Setup group only; full adds Personal. Returns nullopt if
+// a section is too large for a package.
+std::optional<BuiltPackage> BuildPackage(Kind kind, const Sources& from);
+
+enum class ContentsError {
+  kNoManifest,
+  kBadManifest,
+  // Written by a newer Bare.
+  kNewerSchema,
+  // The manifest says setup and the file header says full, or the reverse.
+  kKindMismatch,
+};
+
+struct PackageSummary {
+  PackageSummary();
+  PackageSummary(const PackageSummary&);
+  PackageSummary& operator=(const PackageSummary&);
+  ~PackageSummary();
+
+  int schema = 0;
+  Kind kind = Kind::kSetup;
+  std::vector<std::string> sections;
+  std::map<std::string, int> counts;
+};
+
+// `file_kind` is the kind in the file header, which is authenticated in a
+// full file.
+base::expected<PackageSummary, ContentsError> ReadManifest(
+    const Package& package,
+    Kind file_kind);
+
+struct RestoreChoices {
+  bool settings = true;
+  bool search_engines = true;
+  bool site_settings = true;
+  bool bookmarks = true;
+};
+
+struct RestoreReport {
+  RestoreReport();
+  RestoreReport(RestoreReport&&);
+  RestoreReport& operator=(RestoreReport&&);
+  ~RestoreReport();
+
+  std::vector<std::string> sections_applied;
+  // The section that stopped the restore: unreadable, or nothing on this
+  // phone to restore into.
+  std::optional<std::string> section_failed;
+  // Chosen sections after the failed one, which were not run.
+  std::vector<std::string> sections_not_run;
+
+  SettingsRestoreResult settings;
+  SiteSettingsRestoreResult site_defaults;
+  // nullopt when the backup's default engine isn't a built-in one.
+  std::optional<bool> default_search_engine_restored;
+  SearchEnginesRestoreResult search_engines;
+  SiteSettingsRestoreResult site_exceptions;
+  BookmarksRestoreResult bookmarks;
+  ReadingListRestoreResult reading_list;
+
+  // Entries Bare doesn't know, and personal entries in a setup package.
+  std::vector<std::string> ignored_entries;
+};
+
+// Applies the chosen sections in order: settings, search engines, site
+// settings, bookmarks with the reading list. A failed section stops the
+// restore; what was applied stays, and running it again is safe (settings are
+// written again, bookmarks go into a second folder, nothing is duplicated
+// elsewhere).
+RestoreReport RestorePackage(const Package& package,
+                             const PackageSummary& summary,
+                             const RestoreChoices& choices,
+                             const Sources& to,
+                             const std::u16string& bookmark_folder_title);
+
+}  // namespace bare::backup
+
+#endif  // CHROME_BROWSER_BARE_BACKUP_BACKUP_CONTENTS_H_

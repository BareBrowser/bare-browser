+// The listed setting for `key` that `group` may carry with `value`.
+const Setting* Find(SettingStore store,
+                    SettingGroup group,
+                    SV key,
+                    const base::Value& value) {
+  for (const Setting& setting : kSettings) {
+    if (setting.store != store || key != setting.key) {
+      continue;
+    }
+    if (setting.group == group) {
+      return &setting;
+    }
+    if (group == SettingGroup::kSetup && setting.also_setup_if &&
+        HasType(value, setting.type) && setting.also_setup_if(value)) {
+      return &setting;
+    }
+  }
+  return nullptr;
+}
+
+PrefService* PrefsFor(SettingStore store, const SettingsStores& stores) {
+  return store == SettingStore::kProfile ? stores.profile.get()
+                                         : stores.local_state.get();
+}
+
+// The current value, or nullopt at the default. Sets `readable` to false when
+// this phone has no such setting.
+std::optional<base::Value> Current(const Setting& setting,
+                                   const SettingsStores& stores,
+                                   bool& readable) {
+  readable = true;
+  if (setting.store == SettingStore::kAndroid) {
+    if (!stores.android) {
+      readable = false;
+      return std::nullopt;
+    }
+    return stores.android->Get(setting.key, setting.type);
+  }
+  PrefService* prefs = PrefsFor(setting.store, stores);
+  const PrefService::Preference* pref =
+      prefs ? prefs->FindPreference(setting.key) : nullptr;
+  if (!pref) {
+    readable = false;
+    return std::nullopt;
+  }
+  if (pref->IsDefaultValue()) {
+    return std::nullopt;
+  }
+  return pref->GetValue()->Clone();
+}
+
+}  // namespace
+
+base::span<const Setting> AllSettings() {
+  return kSettings;
+}
+
+SettingsWriteResult SettingsToJson(SettingGroup group,
+                                   const SettingsStores& stores) {
+  SettingsWriteResult result;
+  for (SettingStore store : kStores) {
+    base::DictValue values;
+    for (const Setting& setting : kSettings) {
+      const bool shared_value =
+          group == SettingGroup::kSetup && setting.also_setup_if;
+      if (setting.store != store ||
+          (setting.group != group && !shared_value)) {
+        continue;
+      }
+      bool readable = false;
+      std::optional<base::Value> value = Current(setting, stores, readable);
+      if (!readable) {
+        continue;
+      }
+      if (shared_value && setting.group != group &&
+          (!value || !HasType(*value, setting.type) ||
+           !setting.also_setup_if(*value))) {
+        continue;
+      }
+      if (!value) {
+        values.Set(setting.key, base::Value());
+      } else if (IsValid(setting, *value)) {
+        values.Set(setting.key, std::move(*value));
+      } else {
+        // Not a value this build would accept back, so it isn't written.
+        continue;
+      }
+      ++result.count;
+    }
+    result.json.Set(StoreName(store), std::move(values));
+  }
+  return result;
+}
+
+SettingsRestoreResult RestoreSettings(SettingGroup group,
+                                      const base::DictValue& json,
+                                      const SettingsStores& stores) {
+  SettingsRestoreResult result;
+  for (const auto [name, section] : json) {
+    const auto store = std::ranges::find_if(
+        kStores, [&](SettingStore s) { return name == StoreName(s); });
+    if (store == kStores.end() || !section.is_dict()) {
+      result.unknown.push_back(name);
+      continue;
+    }
+    for (const auto [key, value] : section.GetDict()) {
+      const std::string label = name + ":" + key;
+      const Setting* setting = Find(*store, group, key, value);
+      if (!setting) {
+        result.unknown.push_back(label);
+        continue;
+      }
+      bool readable = false;
+      const std::optional<base::Value> before =
+          Current(*setting, stores, readable);
+      if (!readable || (!value.is_none() && !IsValid(*setting, value))) {
+        result.skipped.push_back(label);
+        continue;
+      }
+      // Secure mode without a server would stop every lookup.
+      if (std::string_view(setting->key) == "dns_over_https.mode" &&
+          value.is_string() && value.GetString() == "secure" &&
+          stores.local_state->FindPreference("dns_over_https.templates") &&
+          stores.local_state->GetString("dns_over_https.templates").empty() &&
+          !section.GetDict().FindString("dns_over_https.templates")) {
+        result.skipped.push_back(label);
+        continue;
+      }
+      if (*store == SettingStore::kAndroid) {
+        if (value.is_none()) {
+          stores.android->Remove(key);
+        } else {
+          stores.android->Set(key, value);
+        }
+      } else {
+        PrefService* prefs = PrefsFor(*store, stores);
+        if (value.is_none()) {
+          prefs->ClearPref(key);
+        } else if (prefs->FindPreference(key)->GetType() == value.type() ||
+                   setting->type == SettingType::kDouble) {
+          prefs->Set(key, value);
+        } else {
+          result.skipped.push_back(label);
+          continue;
+        }
+      }
+      ++result.applied;
+      const bool changed =
+          before ? value != *before : !value.is_none();
+      result.needs_restart |= setting->needs_restart && changed;
+    }
+  }
+
+  // Bare's two translation services exclude each other; the setters write
+  // the other one off. A restore that turns one on does the same.
+  if (stores.android) {
+    const base::DictValue* android = json.FindDict("android");
+    const auto turned_on = [&](SV key) {
+      return android && android->FindBool(key).value_or(false) &&
+             Find(SettingStore::kAndroid, group, key, *android->Find(key));
+    };
+    if (turned_on("Bare.Translate.PageTranslation")) {
+      stores.android->Set("Bare.Translate.OwnServer", base::Value(false));
+    } else if (turned_on("Bare.Translate.OwnServer")) {
+      stores.android->Set("Bare.Translate.PageTranslation",
+                          base::Value(false));
+    }
+  }
+  return result;
+}
+
+}  // namespace bare::backup

+// partition.default_zoom_level: partition key to zoom level. Chromium's zoom
+// levels run from about -7.6 (25%) to 8.8 (500%).
+bool ZoomLevels(const base::Value& value) {
+  return value.GetDict().size() <= 16 &&
+         std::ranges::all_of(value.GetDict(), [](const auto& entry) {
+           const std::optional<double> level = entry.second.GetIfDouble();
+           return entry.first.size() <= 256 && level && *level >= -8.0 &&
+                  *level <= 9.0;
+         });
+}
+
+bool AnyString(const base::Value& value) {
+  return value.GetString().size() <= kMaxStringLength;
+}
+
+// Bare.UserAgent.Custom: printable ASCII, like UserAgentPresets.isValidCustom.
+bool UserAgent(const base::Value& value) {
+  const std::string& text = value.GetString();
+  return !text.empty() && text.size() <= kMaxStringLength &&
+         std::ranges::all_of(text, [](char c) { return c >= 0x20 && c <= 0x7e; });
+}

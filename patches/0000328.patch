+
+ReadingListWriteResult ReadingListToJson(const ReadingListModel& model) {
+  ReadingListWriteResult result;
+  base::ListValue entries;
+  for (const GURL& url : model.GetKeys()) {
+    scoped_refptr<const ReadingListEntry> entry = model.GetEntryByURL(url);
+    if (!entry || result.entries >= kMaxReadingListEntries) {
+      continue;
+    }
+    base::DictValue json;
+    json.Set("url", entry->URL().spec());
+    json.Set("title", entry->Title());
+    json.Set("read", entry->IsRead());
+    json.Set("added", base::NumberToString(entry->CreationTime()));
+    entries.Append(std::move(json));
+    ++result.entries;
+  }
+  result.json.Set("entries", std::move(entries));
+  return result;
+}
+
+std::optional<ReadingListRestoreResult> RestoreReadingList(
+    ReadingListModel& model,
+    const base::DictValue& json) {
+  const base::ListValue* entries = json.FindList("entries");
+  if (!model.loaded() || !entries ||
+      entries->size() > kMaxReadingListEntries) {
+    return std::nullopt;
+  }
+  ReadingListRestoreResult result;
+  for (const base::Value& value : *entries) {
+    const base::DictValue* entry = value.GetIfDict();
+    const std::string* spec = entry ? entry->FindString("url") : nullptr;
+    const std::string* title = entry ? entry->FindString("title") : nullptr;
+    if (!spec || spec->size() > url::kMaxURLChars) {
+      ++result.skipped;
+      continue;
+    }
+    const GURL url(*spec);
+    if (!url.is_valid() || !model.IsUrlSupported(url)) {
+      ++result.skipped;
+      continue;
+    }
+    if (model.GetEntryByURL(url)) {
+      ++result.already_present;
+      continue;
+    }
+    std::optional<base::Time> added;
+    int64_t micros = 0;
+    const std::string* added_text = entry->FindString("added");
+    if (added_text && base::StringToInt64(*added_text, &micros) && micros > 0) {
+      added = base::Time::UnixEpoch() + base::Microseconds(micros);
+    }
+    model.AddOrReplaceEntry(url, title ? title->substr(0, kMaxTitleLength) : "",
+                            reading_list::ADDED_VIA_IMPORT, std::nullopt,
+                            added);
+    if (entry->FindBool("read").value_or(false)) {
+      model.SetReadStatusIfExists(url, true);
+    }
+    ++result.added;
+  }
+  return result;
+}
+
+}  // namespace bare::backup

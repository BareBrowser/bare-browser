new file mode 100644
index 00000000000..5ad6eeb6264
--- /dev/null
+++ b/chrome/browser/bare/backup/backup_site_settings.cc
@@ -0,0 +1,239 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/bare/backup/backup_site_settings.h"
+
+#include <algorithm>
+#include <array>
+#include <string>
+#include <utility>
+
+#include "components/content_settings/core/browser/content_settings_info.h"
+#include "components/content_settings/core/browser/content_settings_registry.h"
+#include "components/content_settings/core/browser/content_settings_utils.h"
+#include "components/content_settings/core/browser/host_content_settings_map.h"
+#include "components/content_settings/core/browser/website_settings_info.h"
+#include "components/content_settings/core/browser/website_settings_registry.h"
+#include "components/content_settings/core/common/content_settings.h"
+#include "components/content_settings/core/common/content_settings_pattern.h"
+#include "components/content_settings/core/common/content_settings_types.h"
+#include "components/content_settings/core/common/content_settings_utils.h"
+
+namespace bare::backup {
+
+namespace {
+
+// The types a backup carries. A permission's default can only be Ask or
+// Block in Bare's Settings, so a file can't make it Allow for every site; the
+// others are on/off switches there.
+struct Listed {
+  ContentSettingsType type;
+  bool permission;
+};
+
+constexpr auto kListed = std::to_array<Listed>({
+    {ContentSettingsType::ADS, false},
+    {ContentSettingsType::AR, true},
+    {ContentSettingsType::AUTO_DARK_WEB_CONTENT, false},
+    {ContentSettingsType::AUTOMATIC_DOWNLOADS, true},
+    {ContentSettingsType::BACKGROUND_SYNC, false},
+    {ContentSettingsType::CLIPBOARD_READ_WRITE, true},
+    {ContentSettingsType::COOKIES, false},
+    {ContentSettingsType::GEOLOCATION, true},
+    {ContentSettingsType::IDLE_DETECTION, true},
+    {ContentSettingsType::IMAGES, false},
+    {ContentSettingsType::JAVASCRIPT, false},
+    {ContentSettingsType::JAVASCRIPT_JIT, false},
+    {ContentSettingsType::JAVASCRIPT_OPTIMIZER, false},
+    {ContentSettingsType::MEDIASTREAM_CAMERA, true},
+    {ContentSettingsType::MEDIASTREAM_MIC, true},
+    {ContentSettingsType::MIDI_SYSEX, true},
+    {ContentSettingsType::NOTIFICATIONS, true},
+    {ContentSettingsType::POPUPS, false},
+    {ContentSettingsType::PROTECTED_MEDIA_IDENTIFIER, true},
+    {ContentSettingsType::REQUEST_DESKTOP_SITE, false},
+    {ContentSettingsType::SENSORS, false},
+    {ContentSettingsType::SOUND, false},
+});
+
+constexpr auto kTypes = [] {
+  std::array<ContentSettingsType, kListed.size()> types{};
+  for (size_t i = 0; i < kListed.size(); ++i) {
+    types[i] = kListed[i].type;
+  }
+  return types;
+}();
+
+bool IsListed(ContentSettingsType type) {
+  return std::ranges::find(kTypes, type) != kTypes.end();
+}
+
+// The registry entry for a listed type, or null if this build doesn't
+// register it (some types are desktop only).
+const content_settings::ContentSettingsInfo* InfoFor(ContentSettingsType type) {
+  return content_settings::ContentSettingsRegistry::GetInstance()->Get(type);
+}
+
+std::optional<ContentSettingsType> TypeFromName(const std::string* name) {
+  if (!name) {
+    return std::nullopt;
+  }
+  const content_settings::WebsiteSettingsInfo* info =
+      content_settings::WebsiteSettingsRegistry::GetInstance()->GetByName(
+          *name);
+  if (!info || !IsListed(info->type()) || !InfoFor(info->type())) {
+    return std::nullopt;
+  }
+  return info->type();
+}
+
+// Whether Settings could have left `setting` as the default for `type`: the
+// type's own starting value, Ask or Block for a permission, Allow or Block
+// for a switch.
+bool IsSettableDefault(ContentSettingsType type, ContentSetting setting) {
+  const content_settings::ContentSettingsInfo* info = InfoFor(type);
+  if (!info || !info->IsDefaultSettingValid(setting)) {
+    return false;
+  }
+  if (setting == content_settings::ValueToContentSetting(
+                     info->website_settings_info()->initial_default_value())) {
+    return true;
+  }
+  const auto listed = std::ranges::find(kListed, type, &Listed::type);
+  if (listed == kListed.end()) {
+    return false;
+  }
+  return listed->permission
+             ? setting == CONTENT_SETTING_ASK || setting == CONTENT_SETTING_BLOCK
+             : setting == CONTENT_SETTING_ALLOW ||
+                   setting == CONTENT_SETTING_BLOCK;
+}
+
+std::optional<ContentSetting> SettingFromName(const std::string* name) {
+  ContentSetting setting = CONTENT_SETTING_DEFAULT;
+  if (!name || !content_settings::ContentSettingFromString(*name, &setting) ||
+      setting == CONTENT_SETTING_DEFAULT) {
+    return std::nullopt;
+  }
+  return setting;
+}
+
+}  // namespace
+
+base::DictValue SiteDefaultsToJson(const HostContentSettingsMap& map) {
+  base::DictValue defaults;
+  for (ContentSettingsType type : kTypes) {
+    const content_settings::ContentSettingsInfo* info = InfoFor(type);
+    if (!info) {
+      continue;
+    }
+    defaults.Set(info->website_settings_info()->name(),
+                 content_settings::ContentSettingToString(
+                     map.GetDefaultContentSetting(type)));
+  }
+  base::DictValue json;
+  json.Set("defaults", std::move(defaults));
+  return json;
+}
+
+SiteSettingsRestoreResult RestoreSiteDefaults(HostContentSettingsMap& map,
+                                              const base::DictValue& json) {
+  SiteSettingsRestoreResult result;
+  const base::DictValue* defaults = json.FindDict("defaults");
+  if (!defaults) {
+    return result;
+  }
+  for (const auto [name, value] : *defaults) {
+    const std::optional<ContentSettingsType> type = TypeFromName(&name);
+    const std::optional<ContentSetting> setting =
+        SettingFromName(value.GetIfString());
+    if (!type || !setting || !IsSettableDefault(*type, *setting)) {
+      ++result.skipped;
+      continue;
+    }
+    map.SetDefaultContentSetting(*type, *setting);
+    ++result.applied;
+  }
+  return result;
+}
+
+SiteExceptionsWriteResult SiteExceptionsToJson(
+    const HostContentSettingsMap& map) {
+  SiteExceptionsWriteResult result;
+  base::ListValue exceptions;
+  for (ContentSettingsType type : kTypes) {
+    const content_settings::ContentSettingsInfo* info = InfoFor(type);
+    if (!info) {
+      continue;
+    }
+    for (const ContentSettingPatternSource& rule :
+         map.GetSettingsForOneType(type)) {
+      if (rule.source != content_settings::mojom::ProviderType::kPrefProvider ||
+          rule.incognito || !rule.metadata.expiration().is_null() ||
+          rule.metadata.session_model() !=
+              content_settings::mojom::SessionModel::DURABLE ||
+          rule.primary_pattern == ContentSettingsPattern::Wildcard() ||
+          !rule.setting_value.is_int()) {
+        continue;
+      }
+      if (result.exceptions >= kMaxSiteExceptions) {
+        break;
+      }
+      base::DictValue exception;
+      exception.Set("type", info->website_settings_info()->name());
+      exception.Set("primary", rule.primary_pattern.ToString());
+      exception.Set("secondary", rule.secondary_pattern.ToString());
+      exception.Set("setting", content_settings::ContentSettingToString(
+                                   rule.GetContentSetting()));
+      exceptions.Append(std::move(exception));
+      ++result.exceptions;
+    }
+  }
+  result.json.Set("exceptions", std::move(exceptions));
+  return result;
+}
+
+std::optional<SiteSettingsRestoreResult> RestoreSiteExceptions(
+    HostContentSettingsMap& map,
+    const base::DictValue& json) {
+  const base::ListValue* exceptions = json.FindList("exceptions");
+  if (!exceptions || exceptions->size() > kMaxSiteExceptions) {
+    return std::nullopt;
+  }
+  SiteSettingsRestoreResult result;
+  for (const base::Value& value : *exceptions) {
+    const base::DictValue* exception = value.GetIfDict();
+    if (!exception) {
+      ++result.skipped;
+      continue;
+    }
+    const std::optional<ContentSettingsType> type =
+        TypeFromName(exception->FindString("type"));
+    const std::optional<ContentSetting> setting =
+        SettingFromName(exception->FindString("setting"));
+    const std::string* primary_text = exception->FindString("primary");
+    const std::string* secondary_text = exception->FindString("secondary");
+    if (!type || !setting || !primary_text || !secondary_text ||
+        !InfoFor(*type)->IsSettingValid(*setting)) {
+      ++result.skipped;
+      continue;
+    }
+    const ContentSettingsPattern primary =
+        ContentSettingsPattern::FromString(*primary_text);
+    const ContentSettingsPattern secondary =
+        ContentSettingsPattern::FromString(*secondary_text);
+    if (!primary.IsValid() || !secondary.IsValid() ||
+        primary == ContentSettingsPattern::Wildcard() ||
+        (secondary != ContentSettingsPattern::Wildcard() &&
+         !InfoFor(*type)->website_settings_info()->SupportsSecondaryPattern())) {
+      ++result.skipped;
+      continue;
+    }
+    map.SetContentSettingCustomScope(primary, secondary, *type, *setting);
+    ++result.applied;
+  }
+  return result;
+}
+
+}  // namespace bare::backup

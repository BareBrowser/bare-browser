diff --git a/chrome/browser/bare/backup/backup_contents.cc b/chrome/browser/bare/backup/backup_contents.cc
new file mode 100644
index 00000000000..3edbd0b1de7
--- /dev/null
+++ b/chrome/browser/bare/backup/backup_contents.cc
@@ -0,0 +1,346 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/bare/backup/backup_contents.h"
+
+#include <set>
+#include <utility>
+
+#include "base/json/json_reader.h"
+#include "base/json/json_writer.h"
+#include "base/strings/string_util.h"
+
+namespace bare::backup {
+
+namespace {
+
+constexpr char kManifest[] = "manifest.json";
+constexpr char kSetupSettings[] = "setup/settings.json";
+constexpr char kPersonalSettings[] = "personal/settings.json";
+constexpr char kPersonalSearchEngines[] = "personal/search_engines.json";
+constexpr char kPersonalSiteSettings[] = "personal/site_settings.json";
+constexpr char kPersonalBookmarks[] = "personal/bookmarks.json";
+constexpr char kPersonalReadingList[] = "personal/reading_list.json";
+
+constexpr size_t kMaxJsonDepth = 8;
+
+const char* KindName(Kind kind) {
+  return kind == Kind::kFull ? "full" : "setup";
+}
+
+bool AddJson(PackageWriter& writer,
+             const char* name,
+             const base::DictValue& json) {
+  std::optional<std::string> text = base::WriteJson(json);
+  return text && writer.Add(name, *text);
+}
+
+std::optional<base::DictValue> ReadJson(const Package& package,
+                                        const char* name) {
+  auto it = package.find(name);
+  if (it == package.end()) {
+    return std::nullopt;
+  }
+  return base::JSONReader::ReadDict(it->second, base::JSON_PARSE_RFC,
+                                    kMaxJsonDepth);
+}
+
+bool IsKnownEntry(const std::string& name, Kind kind) {
+  if (name == kManifest || name == kSetupSettings) {
+    return true;
+  }
+  // Extension files and their list arrive with the extensions step; until
+  // then they are listed as ignored like anything else.
+  if (kind != Kind::kFull) {
+    return false;
+  }
+  for (const char* known :
+       {kPersonalSettings, kPersonalSearchEngines, kPersonalSiteSettings,
+        kPersonalBookmarks, kPersonalReadingList}) {
+    if (name == known) {
+      return true;
+    }
+  }
+  return false;
+}
+
+}  // namespace
+
+PackageSummary::PackageSummary() = default;
+PackageSummary::PackageSummary(const PackageSummary&) = default;
+PackageSummary& PackageSummary::operator=(const PackageSummary&) = default;
+PackageSummary::~PackageSummary() = default;
+
+RestoreReport::RestoreReport() = default;
+RestoreReport::RestoreReport(RestoreReport&&) = default;
+RestoreReport& RestoreReport::operator=(RestoreReport&&) = default;
+RestoreReport::~RestoreReport() = default;
+
+std::optional<BuiltPackage> BuildPackage(Kind kind, const Sources& from) {
+  BuiltPackage built;
+  PackageWriter writer;
+  base::ListValue sections;
+
+  // Setup group.
+  SettingsWriteResult setup = SettingsToJson(SettingGroup::kSetup,
+                                             from.settings);
+  base::DictValue setup_json;
+  setup_json.Set("prefs", std::move(setup.json));
+  if (from.site_settings) {
+    setup_json.Set("site_defaults", SiteDefaultsToJson(*from.site_settings));
+  }
+  if (from.search_engines) {
+    base::DictValue engine;
+    if (std::optional<int> id =
+            BuiltInDefaultSearchEngine(*from.search_engines)) {
+      engine.Set("default_prepopulate_id", *id);
+    }
+    setup_json.Set("search_engine", std::move(engine));
+  }
+  if (!AddJson(writer, kSetupSettings, setup_json)) {
+    return std::nullopt;
+  }
+  sections.Append(kSectionSettings);
+  int settings_count = static_cast<int>(setup.count);
+
+  if (kind == Kind::kFull) {
+    SettingsWriteResult personal =
+        SettingsToJson(SettingGroup::kPersonal, from.settings);
+    settings_count += static_cast<int>(personal.count);
+    base::DictValue personal_json;
+    personal_json.Set("prefs", std::move(personal.json));
+    if (!AddJson(writer, kPersonalSettings, personal_json)) {
+      return std::nullopt;
+    }
+    if (from.search_engines) {
+      SearchEnginesWriteResult engines =
+          SearchEnginesToJson(*from.search_engines);
+      if (!AddJson(writer, kPersonalSearchEngines, engines.json)) {
+        return std::nullopt;
+      }
+      sections.Append(kSectionSearchEngines);
+      built.counts["search_engines"] = static_cast<int>(engines.engines);
+    }
+    if (from.site_settings) {
+      SiteExceptionsWriteResult exceptions =
+          SiteExceptionsToJson(*from.site_settings);
+      if (!AddJson(writer, kPersonalSiteSettings, exceptions.json)) {
+        return std::nullopt;
+      }
+      sections.Append(kSectionSiteSettings);
+      built.counts["site_settings"] = static_cast<int>(exceptions.exceptions);
+    }
+    if (from.bookmarks) {
+      BookmarksWriteResult bookmarks = BookmarksToJson(*from.bookmarks);
+      if (!AddJson(writer, kPersonalBookmarks, bookmarks.json)) {
+        return std::nullopt;
+      }
+      sections.Append(kSectionBookmarks);
+      built.counts["bookmarks"] = static_cast<int>(bookmarks.urls);
+      if (from.reading_list) {
+        ReadingListWriteResult reading_list =
+            ReadingListToJson(*from.reading_list);
+        if (!AddJson(writer, kPersonalReadingList, reading_list.json)) {
+          return std::nullopt;
+        }
+        built.counts["reading_list"] =
+            static_cast<int>(reading_list.entries);
+      }
+    }
+  }
+  built.counts["settings"] = settings_count;
+
+  base::DictValue counts;
+  for (const auto& [name, count] : built.counts) {
+    counts.Set(name, count);
+  }
+  base::DictValue manifest;
+  manifest.Set("schema", kSchemaVersion);
+  manifest.Set("kind", KindName(kind));
+  manifest.Set("sections", std::move(sections));
+  manifest.Set("counts", std::move(counts));
+  if (!AddJson(writer, kManifest, manifest)) {
+    return std::nullopt;
+  }
+  built.zip = writer.Finish();
+  return built;
+}
+
+base::expected<PackageSummary, ContentsError> ReadManifest(
+    const Package& package,
+    Kind file_kind) {
+  if (!package.contains(kManifest)) {
+    return base::unexpected(ContentsError::kNoManifest);
+  }
+  std::optional<base::DictValue> manifest = ReadJson(package, kManifest);
+  if (!manifest) {
+    return base::unexpected(ContentsError::kBadManifest);
+  }
+  const std::optional<int> schema = manifest->FindInt("schema");
+  const std::string* kind = manifest->FindString("kind");
+  const base::ListValue* sections = manifest->FindList("sections");
+  if (!schema || *schema < 1 || !kind || !sections) {
+    return base::unexpected(ContentsError::kBadManifest);
+  }
+  if (*schema > kSchemaVersion) {
+    return base::unexpected(ContentsError::kNewerSchema);
+  }
+  if (*kind != KindName(file_kind)) {
+    return base::unexpected(ContentsError::kKindMismatch);
+  }
+
+  PackageSummary summary;
+  summary.schema = *schema;
+  summary.kind = file_kind;
+  std::set<std::string> seen;
+  for (const base::Value& section : *sections) {
+    if (!section.is_string()) {
+      return base::unexpected(ContentsError::kBadManifest);
+    }
+    const std::string& name = section.GetString();
+    const bool known =
+        name == kSectionSettings ||
+        (file_kind == Kind::kFull &&
+         (name == kSectionSearchEngines || name == kSectionSiteSettings ||
+          name == kSectionBookmarks));
+    // Sections from a later Bare, or personal ones in a setup file, are not
+    // offered.
+    if (known && seen.insert(name).second) {
+      summary.sections.push_back(name);
+    }
+  }
+  if (const base::DictValue* counts = manifest->FindDict("counts")) {
+    for (const auto [name, count] : *counts) {
+      if (count.is_int() && count.GetInt() >= 0) {
+        summary.counts[name] = count.GetInt();
+      }
+    }
+  }
+  return summary;
+}
+
+RestoreReport RestorePackage(const Package& package,
+                             const PackageSummary& summary,
+                             const RestoreChoices& choices,
+                             const Sources& to,
+                             const std::u16string& bookmark_folder_title) {
+  RestoreReport report;
+  for (const auto& [name, contents] : package) {
+    if (!IsKnownEntry(name, summary.kind)) {
+      report.ignored_entries.push_back(name);
+    }
+  }
+  const auto offered = [&](const char* section) {
+    return std::ranges::find(summary.sections, section) !=
+           summary.sections.end();
+  };
+
+  struct Step {
+    const char* section;
+    bool chosen;
+  };
+  const Step steps[] = {
+      {kSectionSettings, choices.settings},
+      {kSectionSearchEngines, choices.search_engines},
+      {kSectionSiteSettings, choices.site_settings},
+      {kSectionBookmarks, choices.bookmarks},
+  };
+
+  for (const Step& step : steps) {
+    if (!step.chosen || !offered(step.section)) {
+      continue;
+    }
+    if (report.section_failed) {
+      report.sections_not_run.push_back(step.section);
+      continue;
+    }
+    const std::string section = step.section;
+    bool ok = false;
+    if (section == kSectionSettings) {
+      std::optional<base::DictValue> setup = ReadJson(package, kSetupSettings);
+      std::optional<base::DictValue> personal;
+      if (summary.kind == Kind::kFull) {
+        personal = ReadJson(package, kPersonalSettings);
+      }
+      ok = setup && (summary.kind != Kind::kFull || personal);
+      if (ok) {
+        if (const base::DictValue* prefs = setup->FindDict("prefs")) {
+          report.settings =
+              RestoreSettings(SettingGroup::kSetup, *prefs, to.settings);
+        }
+        if (const base::DictValue* defaults = setup->FindDict("site_defaults");
+            defaults && to.site_settings) {
+          report.site_defaults =
+              RestoreSiteDefaults(*to.site_settings, *defaults);
+        }
+        const base::DictValue* engine = setup->FindDict("search_engine");
+        if (std::optional<int> id =
+                engine ? engine->FindInt("default_prepopulate_id")
+                       : std::nullopt;
+            id && to.search_engines) {
+          report.default_search_engine_restored =
+              RestoreBuiltInDefaultSearchEngine(*to.search_engines, *id);
+        }
+        if (personal) {
+          if (const base::DictValue* prefs = personal->FindDict("prefs")) {
+            SettingsRestoreResult more =
+                RestoreSettings(SettingGroup::kPersonal, *prefs, to.settings);
+            report.settings.applied += more.applied;
+            report.settings.needs_restart |= more.needs_restart;
+            std::ranges::move(more.skipped,
+                              std::back_inserter(report.settings.skipped));
+            std::ranges::move(more.unknown,
+                              std::back_inserter(report.settings.unknown));
+          }
+        }
+      }
+    } else if (section == kSectionSearchEngines) {
+      std::optional<base::DictValue> json =
+          ReadJson(package, kPersonalSearchEngines);
+      std::optional<SearchEnginesRestoreResult> result;
+      if (json && to.search_engines) {
+        result = RestoreSearchEngines(*to.search_engines, *json);
+      }
+      if ((ok = result.has_value())) {
+        report.search_engines = *result;
+      }
+    } else if (section == kSectionSiteSettings) {
+      std::optional<base::DictValue> json =
+          ReadJson(package, kPersonalSiteSettings);
+      std::optional<SiteSettingsRestoreResult> result;
+      if (json && to.site_settings) {
+        result = RestoreSiteExceptions(*to.site_settings, *json);
+      }
+      if ((ok = result.has_value())) {
+        report.site_exceptions = *result;
+      }
+    } else if (section == kSectionBookmarks) {
+      std::optional<base::DictValue> json =
+          ReadJson(package, kPersonalBookmarks);
+      std::optional<BookmarksRestoreResult> result;
+      if (json && to.bookmarks) {
+        result = RestoreBookmarks(*to.bookmarks, *json, bookmark_folder_title);
+      }
+      if ((ok = result.has_value())) {
+        report.bookmarks = std::move(*result);
+        // The reading list travels with bookmarks and is optional in a file.
+        std::optional<base::DictValue> list =
+            ReadJson(package, kPersonalReadingList);
+        if (list && to.reading_list) {
+          if (auto added = RestoreReadingList(*to.reading_list, *list)) {
+            report.reading_list = *added;
+          }
+        }
+      }
+    }
+    if (ok) {
+      report.sections_applied.push_back(section);
+    } else {
+      report.section_failed = section;
+    }
+  }
+  return report;
+}
+
+}  // namespace bare::backup

+TEST(BackupSettingsTest, RoundTrip) {
+  Phone source;
+  source.android.Set("Bare.Glass", base::Value(false));
+  source.android.Set("ui_theme_setting", base::Value(3));
+  source.android.Set("Chrome.Bare.AppMenuOrder",
+                     base::Value("reload,history,new_tab"));
+  base::ListValue hidden;
+  hidden.Append("lens");
+  hidden.Append("ai_mode");
+  source.android.Set("Bare.AppMenu.OrderAll",
+                     base::Value("immersive,task_manager,print"));
+  source.android.Set("Bare.Extensions.QuickCrx", base::Value(true));
+  source.android.Set("Bare.AppMenu.HiddenItems", base::Value(hidden.Clone()));
+  source.android.Set("Bare.Translate.ApiKey", base::Value("secret"));
+  source.profile.SetBoolean("enable_do_not_track", true);
+  source.profile.SetInteger("bare.clear_on_exit_types", 7);
+  source.profile.SetString("intl.selected_languages", "en-US,de,pt-BR");
+  base::DictValue zoom;
+  zoom.Set("x", 1.5);
+  source.profile.SetDict("partition.default_zoom_level.android", zoom.Clone());
+  source.local_state.SetString("dns_over_https.mode", "off");
+
+  // The new phone has its own values; setup replaces them, including the
+  // ones the old phone left at their default.
+  Phone target;
+  target.android.Set("Bare.Haptics", base::Value(false));
+  target.profile.SetBoolean("https_only_mode_enabled", true);
+
+  SettingsWriteResult setup = SettingsToJson(SettingGroup::kSetup,
+                                             source.stores());
+  const base::DictValue json = Parse(*base::WriteJson(setup.json));
+  EXPECT_FALSE(json.FindDict("android")->contains("Bare.Translate.ApiKey"));
+  SettingsRestoreResult result =
+      RestoreSettings(SettingGroup::kSetup, json, target.stores());
+  EXPECT_TRUE(result.skipped.empty());
+  EXPECT_TRUE(result.unknown.empty());
+  EXPECT_EQ(result.applied, setup.count);
+  EXPECT_TRUE(result.needs_restart);  // the zoom level
+
+  EXPECT_EQ(target.android.values_.at("Bare.Glass"), base::Value(false));
+  EXPECT_EQ(target.android.values_.at("ui_theme_setting"), base::Value(3));
+  EXPECT_EQ(target.android.values_.at("Bare.AppMenu.HiddenItems"),
+            base::Value(std::move(hidden)));
+  EXPECT_EQ(target.android.values_.at("Bare.AppMenu.OrderAll"),
+            base::Value("immersive,task_manager,print"));
+  EXPECT_EQ(target.android.values_.at("Bare.Extensions.QuickCrx"),
+            base::Value(true));
+  EXPECT_FALSE(target.android.values_.contains("Bare.Haptics"));
+  EXPECT_FALSE(target.android.values_.contains("Bare.Translate.ApiKey"));
+  EXPECT_TRUE(target.profile.GetBoolean("enable_do_not_track"));
+  EXPECT_FALSE(target.profile.GetBoolean("https_only_mode_enabled"));
+  EXPECT_EQ(target.profile.GetInteger("bare.clear_on_exit_types"), 7);
+  EXPECT_EQ(target.profile.GetString("intl.selected_languages"),
+            "en-US,de,pt-BR");
+  EXPECT_EQ(target.profile.GetDict("partition.default_zoom_level.android"),
+            zoom);
+  EXPECT_EQ(target.local_state.GetString("dns_over_https.mode"), "off");
+
+  // Personal carries only the personal keys.
+  SettingsWriteResult personal =
+      SettingsToJson(SettingGroup::kPersonal, source.stores());
+  result = RestoreSettings(SettingGroup::kPersonal, personal.json,
+                           target.stores());
+  EXPECT_TRUE(result.unknown.empty());
+  EXPECT_EQ(target.android.values_.at("Bare.Translate.ApiKey"),
+            base::Value("secret"));
+}

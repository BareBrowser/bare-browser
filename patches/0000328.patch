+TEST(BackupSettingsTest, HomepageMustBeAWebPage) {
+  const std::string web =
+      SerializeGurlForAndroid(GURL("https://example.org/start?x=1"));
+  ASSERT_FALSE(web.empty());
+
+  auto restore = [](const std::string& serialized) {
+    Phone target;
+    base::DictValue android;
+    android.Set("Chrome.Homepage.CustomGurl", serialized);
+    base::DictValue json;
+    json.Set("android", std::move(android));
+    return RestoreSettings(SettingGroup::kPersonal, json, target.stores())
+        .applied;
+  };
+  EXPECT_EQ(restore(web), 1u);
+  EXPECT_EQ(restore(SerializeGurlForAndroid(GURL("http://example.org/"))), 1u);
+
+  // Not a web page.
+  EXPECT_EQ(restore(SerializeGurlForAndroid(GURL("javascript:alert(1)"))), 0u);
+  EXPECT_EQ(restore(SerializeGurlForAndroid(GURL("file:///sdcard/a.html"))),
+            0u);
+  EXPECT_EQ(restore(SerializeGurlForAndroid(GURL("data:text/html,hi"))), 0u);
+
+  // Offsets that don't belong to the spec, which Java would trust as written.
+  std::string moved = web;
+  const std::string host = std::string(1, '\0') + "8" + '\0' + "11" + '\0';
+  const size_t at = moved.find(host);
+  ASSERT_NE(at, std::string::npos);
+  moved.replace(at, host.size(), std::string(1, '\0') + "0" + '\0' + "11" +
+                                     '\0');
+  EXPECT_EQ(restore(moved), 0u);
+
+  // The spec swapped for another web page whose parts sit elsewhere, offsets
+  // left as they were.
+  std::string swapped = web;
+  swapped.replace(swapped.rfind('\0') + 1, std::string::npos,
+                  "https://an.example.net/start?x=1");
+  EXPECT_EQ(restore(swapped), 0u);
+
+  // Only the spec, without the rest.
+  EXPECT_EQ(restore("https://example.org/"), 0u);
+}

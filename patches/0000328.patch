@@ -0,0 +1,223 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/bare/backup/backup_bookmarks.h"
+
+#include <memory>
+#include <string>
+
+#include "base/json/json_reader.h"
+#include "base/json/json_writer.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/test/task_environment.h"
+#include "chrome/browser/bare/backup/backup_test_util.h"
+#include "components/bookmarks/browser/bookmark_model.h"
+#include "components/bookmarks/browser/bookmark_node.h"
+#include "components/bookmarks/test/test_bookmark_client.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "url/gurl.h"
+
+namespace bare::backup {
+namespace {
+
+using bookmarks::BookmarkModel;
+using bookmarks::BookmarkNode;
+using bookmarks::TestBookmarkClient;
+
+// One line per node, indented by depth, for comparing whole trees.
+void Describe(const BookmarkNode* node, int depth, std::string& out) {
+  for (const auto& child : node->children()) {
+    out += std::string(depth * 2, ' ') + base::UTF16ToUTF8(child->GetTitle());
+    if (child->is_url()) {
+      out += " " + child->url().spec();
+    }
+    out += "\n";
+    if (child->is_folder()) {
+      Describe(child.get(), depth + 1, out);
+    }
+  }
+}
+
+std::string Describe(const BookmarkModel& model) {
+  std::string out;
+  for (const BookmarkNode* root :
+       {static_cast<const BookmarkNode*>(model.bookmark_bar_node()),
+        static_cast<const BookmarkNode*>(model.other_node()),
+        static_cast<const BookmarkNode*>(model.mobile_node())}) {
+    out += "[" + base::UTF16ToUTF8(root->GetTitle()) + "]\n";
+    Describe(root, 1, out);
+  }
+  return out;
+}
+
+base::DictValue Parse(std::string_view json) {
+  return *base::JSONReader::ReadDict(json, base::JSON_PARSE_RFC);
+}
+
+class BackupBookmarksTest : public testing::Test {
+ protected:
+  void FillSource() {
+    BookmarkModel& m = *source_;
+    const BookmarkNode* news =
+        m.AddFolder(m.bookmark_bar_node(), 0, u"News");
+    m.AddURL(news, 0, u"Example", GURL("https://example.org/"));
+    const BookmarkNode* deep = m.AddFolder(news, 1, u"Deeper");
+    m.AddURL(deep, 0, u"日本語 \U0001F600",
+             GURL("https://example.org/ja"));
+    m.AddURL(m.bookmark_bar_node(), 1, u"Bar link", GURL("https://a.test/"));
+    m.AddURL(m.other_node(), 0, u"Other", GURL("https://b.test/x?y=1#z"));
+    m.AddFolder(m.other_node(), 1, u"Empty folder");
+    m.AddURL(m.mobile_node(), 0, u"Mobile", GURL("https://c.test/"));
+    m.AddURL(m.mobile_node(), 1, u"Bookmarklet",
+             GURL("javascript:alert(1)"));
+  }
+
+  base::test::SingleThreadTaskEnvironment task_environment_;
+  ScopedTestStrings strings_;
+  std::unique_ptr<BookmarkModel> source_ = TestBookmarkClient::CreateModel();
+  std::unique_ptr<BookmarkModel> target_ = TestBookmarkClient::CreateModel();
+};
+
+TEST_F(BackupBookmarksTest, EmptyModel) {
+  BookmarksWriteResult written = BookmarksToJson(*source_);
+  EXPECT_EQ(written.urls, 0u);
+  EXPECT_TRUE(written.json.FindList("nodes")->empty());
+  auto restored = RestoreBookmarks(*target_, written.json, u"Restored");
+  ASSERT_TRUE(restored);
+  EXPECT_EQ(restored->urls + restored->folders, 0u);
+  EXPECT_FALSE(restored->into_folder);
+  EXPECT_TRUE(target_->mobile_node()->children().empty());
+}
+
+TEST_F(BackupBookmarksTest, ExactTreeIntoEmptyModel) {
+  FillSource();
+  BookmarksWriteResult written = BookmarksToJson(*source_);
+  EXPECT_EQ(written.urls, 6u);
+  EXPECT_EQ(written.folders, 3u);
+
+  // Through JSON text, as it will be in the file.
+  const std::string text = *base::WriteJson(written.json);
+  auto restored =
+      RestoreBookmarks(*target_, Parse(text), u"Restored 2026-11-03");
+  ASSERT_TRUE(restored);
+  EXPECT_FALSE(restored->into_folder);
+  EXPECT_EQ(restored->urls, 6u);
+  EXPECT_EQ(restored->folders, 3u);
+  EXPECT_EQ(restored->skipped, 0u);
+  EXPECT_EQ(Describe(*target_), Describe(*source_));
+
+  const BookmarkNode* news = target_->bookmark_bar_node()->children()[0].get();
+  EXPECT_EQ(news->date_added(),
+            source_->bookmark_bar_node()->children()[0]->date_added());
+}
+
+TEST_F(BackupBookmarksTest, PhoneInUseGetsAFolder) {
+  FillSource();
+  target_->AddURL(target_->bookmark_bar_node(), 0, u"Mine",
+                  GURL("https://mine.test/"));
+  target_->AddFolder(target_->mobile_node(), 0, u"Restored 2026-11-03");
+
+  auto restored = RestoreBookmarks(*target_, BookmarksToJson(*source_).json,
+                                   u"Restored 2026-11-03");
+  ASSERT_TRUE(restored);
+  EXPECT_TRUE(restored->into_folder);
+  EXPECT_EQ(restored->folder_title, u"Restored 2026-11-03 (1)");
+  EXPECT_EQ(restored->urls, 6u);
+
+  // The user's own bookmarks are where they were.
+  EXPECT_EQ(target_->bookmark_bar_node()->children().size(), 1u);
+  EXPECT_EQ(target_->bookmark_bar_node()->children()[0]->GetTitle(), u"Mine");
+  ASSERT_EQ(target_->mobile_node()->children().size(), 2u);
+  const BookmarkNode* folder = target_->mobile_node()->children()[1].get();
+  EXPECT_EQ(folder->GetTitle(), u"Restored 2026-11-03 (1)");
+  // Three permanent folders were used, so each gets its own subfolder.
+  ASSERT_EQ(folder->children().size(), 3u);
+  EXPECT_EQ(folder->children()[0]->GetTitle(),
+            source_->bookmark_bar_node()->GetTitle());
+  EXPECT_EQ(folder->children()[0]->children().size(), 2u);
+
+  // Running it again adds a second folder and nothing else.
+  restored = RestoreBookmarks(*target_, BookmarksToJson(*source_).json,
+                              u"Restored 2026-11-03");
+  EXPECT_EQ(restored->folder_title, u"Restored 2026-11-03 (2)");
+  EXPECT_EQ(target_->mobile_node()->children().size(), 3u);
+  EXPECT_EQ(target_->bookmark_bar_node()->children().size(), 1u);
+  EXPECT_TRUE(target_->mobile_node()->children()[0]->children().empty());
+}
+
+TEST_F(BackupBookmarksTest, OneRootGoesStraightIntoTheFolder) {
+  source_->AddURL(source_->mobile_node(), 0, u"Only", GURL("https://o.test/"));
+  target_->AddURL(target_->mobile_node(), 0, u"Mine",
+                  GURL("https://mine.test/"));
+  auto restored =
+      RestoreBookmarks(*target_, BookmarksToJson(*source_).json, u"Restored");
+  ASSERT_TRUE(restored);
+  const BookmarkNode* folder = target_->mobile_node()->children()[1].get();
+  ASSERT_EQ(folder->children().size(), 1u);
+  EXPECT_EQ(folder->children()[0]->GetTitle(), u"Only");
+}
+
+TEST_F(BackupBookmarksTest, TenThousandAndDeep) {
+  const BookmarkNode* folder = source_->other_node();
+  for (int depth = 0; depth < 200; ++depth) {
+    folder = source_->AddFolder(folder, 0,
+                                u"Level " + base::NumberToString16(depth));
+  }
+  for (int i = 0; i < 10000; ++i) {
+    source_->AddURL(i % 2 ? folder : source_->mobile_node(), 0,
+                    u"Page " + base::NumberToString16(i),
+                    GURL("https://example.org/" + base::NumberToString(i)));
+  }
+  const std::string text = *base::WriteJson(BookmarksToJson(*source_).json);
+  auto restored = RestoreBookmarks(*target_, Parse(text), u"Restored");
+  ASSERT_TRUE(restored);
+  EXPECT_EQ(restored->urls, 10000u);
+  EXPECT_EQ(restored->folders, 200u);
+  EXPECT_EQ(Describe(*target_), Describe(*source_));
+}
+
+TEST_F(BackupBookmarksTest, BadNodesAreSkipped) {
+  base::DictValue json = Parse(R"({"nodes": [
+    {"id": 1, "parent": "bookmark_bar", "type": "folder", "title": "Good"},

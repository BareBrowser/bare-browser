+template <int kMin, int kMax>
+bool IntRange(const base::Value& value) {
+  return value.GetInt() >= kMin && value.GetInt() <= kMax;
+}
+
+template <const auto& kValues>
+bool IntIn(const base::Value& value) {
+  return std::ranges::find(kValues, value.GetInt()) != kValues.end();
+}
+
+template <const auto& kValues>
+bool StringIn(const base::Value& value) {
+  return std::ranges::find(kValues, SV(value.GetString())) != kValues.end();
+}
+
+template <const auto& kValues>
+bool ListOf(const base::Value& value) {
+  return std::ranges::all_of(value.GetList(), [](const base::Value& item) {
+    return item.is_string() && StringIn<kValues>(item);
+  });
+}
+
+template <const auto& kValues>
+bool CommaListOf(const base::Value& value) {
+  if (value.GetString().empty()) {
+    return true;
+  }
+  return std::ranges::all_of(
+      base::SplitStringPiece(value.GetString(), ",", base::TRIM_WHITESPACE,
+                             base::SPLIT_WANT_ALL),
+      [](SV item) {
+        return std::ranges::find(kValues, item) != kValues.end();
+      });
+}
+
+// "en", "pt-BR", "zh-Hant", "sr-Latn-RS".
+bool IsLanguageCode(SV code) {
+  if (code.empty() || code.size() > 16) {
+    return false;
+  }
+  const std::vector<SV> parts =
+      base::SplitStringPiece(code, "-", base::KEEP_WHITESPACE,
+                             base::SPLIT_WANT_ALL);
+  if (parts[0].size() < 2 || parts[0].size() > 3 ||
+      !std::ranges::all_of(parts[0], base::IsAsciiAlpha<char>)) {
+    return false;
+  }
+  return std::ranges::all_of(parts, [](SV part) {
+    return !part.empty() && part.size() <= 8 &&
+           std::ranges::all_of(part, base::IsAsciiAlphaNumeric<char>);
+  });
+}
+
+bool LanguageCodeOrEmpty(const base::Value& value) {
+  return value.GetString().empty() || IsLanguageCode(value.GetString());
+}
+
+bool LanguageCodeCsv(const base::Value& value) {
+  return value.GetString().empty() ||
+         std::ranges::all_of(
+             base::SplitStringPiece(value.GetString(), ",",
+                                    base::TRIM_WHITESPACE,
+                                    base::SPLIT_WANT_ALL),
+             IsLanguageCode);
+}
+
+bool LanguageCodeList(const base::Value& value) {
+  return value.GetList().size() <= 300 &&
+         std::ranges::all_of(value.GetList(), [](const base::Value& item) {
+           return item.is_string() && IsLanguageCode(item.GetString());
+         });
+}
+
+// translate_allowlists: source language to target language.
+bool LanguageCodeMap(const base::Value& value) {
+  return value.GetDict().size() <= 300 &&
+         std::ranges::all_of(value.GetDict(), [](const auto& entry) {
+           return IsLanguageCode(entry.first) && entry.second.is_string() &&
+                  IsLanguageCode(entry.second.GetString());
+         });
+}

new file mode 100644
index 00000000000..6ebd2a76591
--- /dev/null
+++ b/chrome/browser/bare/backup/backup_search_engines.h
@@ -0,0 +1,60 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_BARE_BACKUP_BACKUP_SEARCH_ENGINES_H_
+#define CHROME_BROWSER_BARE_BACKUP_BACKUP_SEARCH_ENGINES_H_
+
+#include <stddef.h>
+
+#include <optional>
+
+#include "base/values.h"
+
+class TemplateURLService;
+
+// Search engines, in two parts:
+// - Setup: the default engine when it is one of the built-in ones, stored as
+//   its prepopulate ID so it maps to the same engine on any phone.
+// - Personal (personal/search_engines.json): every engine that isn't built in,
+//   a starter pack keyword or set by policy, and the default when it is one of
+//   those, by keyword.
+namespace bare::backup {
+
+inline constexpr size_t kMaxSearchEngines = 500;
+
+// nullopt when the default is not built in, or there is none.
+std::optional<int> BuiltInDefaultSearchEngine(
+    const TemplateURLService& service);
+
+// Makes the built-in engine with `prepopulate_id` the default. Returns true if
+// it is the default afterwards. The list of built-in engines depends on the
+// region, so the engine may not exist here.
+bool RestoreBuiltInDefaultSearchEngine(TemplateURLService& service,
+                                       int prepopulate_id);
+
+struct SearchEnginesWriteResult {
+  base::DictValue json;
+  size_t engines = 0;
+};
+
+SearchEnginesWriteResult SearchEnginesToJson(TemplateURLService& service);
+
+struct SearchEnginesRestoreResult {
+  size_t added = 0;
+  // A keyword this phone already has. The phone's engine is kept.
+  size_t already_present = 0;
+  size_t skipped = 0;
+  bool default_set = false;
+};
+
+// Adds the engines whose keyword is free. The default changes only if the
+// backup's default is among the engines now present. Returns nullopt, changing
+// nothing, if `json` isn't an engine list.
+std::optional<SearchEnginesRestoreResult> RestoreSearchEngines(
+    TemplateURLService& service,
+    const base::DictValue& json);
+
+}  // namespace bare::backup
+
+#endif  // CHROME_BROWSER_BARE_BACKUP_BACKUP_SEARCH_ENGINES_H_
diff --git a/chrome/browser/bare/backup/backup_search_engines_unittest.cc b/chrome/browser/bare/backup/backup_search_engines_unittest.cc
new file mode 100644
index 00000000000..787435fd72e
--- /dev/null
+++ b/chrome/browser/bare/backup/backup_search_engines_unittest.cc
@@ -0,0 +1,164 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/bare/backup/backup_search_engines.h"
+
+#include <memory>
+#include <string>
+
+#include "base/json/json_reader.h"
+#include "base/json/json_writer.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/test/task_environment.h"
+#include "components/search_engines/search_engines_test_environment.h"
+#include "components/search_engines/template_url.h"
+#include "components/search_engines/template_url_data.h"
+#include "components/search_engines/template_url_service.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace bare::backup {
+namespace {
+
+base::DictValue Parse(std::string_view json) {
+  return *base::JSONReader::ReadDict(json, base::JSON_PARSE_RFC);
+}
+
+TemplateURL* AddEngine(TemplateURLService& service,
+                       const std::u16string& name,
+                       const std::u16string& keyword,
+                       const std::string& url) {
+  TemplateURLData data;
+  data.SetShortName(name);
+  data.SetKeyword(keyword);
+  data.SetURL(url);
+  data.suggestions_url = url + "&suggest=1";
+  return service.Add(std::make_unique<TemplateURL>(data));
+}
+
+class BackupSearchEnginesTest : public testing::Test {
+ protected:
+  void SetUp() override {
+    for (auto* env : {&source_env_, &target_env_}) {
+      env->template_url_service()->Load();
+      ASSERT_TRUE(env->template_url_service()->loaded());
+    }
+  }
+
+  TemplateURLService& source() { return *source_env_.template_url_service(); }
+  TemplateURLService& target() { return *target_env_.template_url_service(); }
+
+  base::test::SingleThreadTaskEnvironment task_environment_;
+  search_engines::SearchEnginesTestEnvironment source_env_;
+  search_engines::SearchEnginesTestEnvironment target_env_;
+};
+
+TEST_F(BackupSearchEnginesTest, BuiltInDefault) {
+  // Bare's prepopulated list for the test region has one engine, so the
+  // target is moved off it first with a custom default.
+  std::optional<int> id = BuiltInDefaultSearchEngine(source());
+  ASSERT_TRUE(id);
+  EXPECT_EQ(*id, source().GetDefaultSearchProvider()->prepopulate_id());
+
+  TemplateURL* mine = AddEngine(target(), u"Mine", u"mine",
+                                "https://search.test/?q={searchTerms}");
+  target().SetUserSelectedDefaultSearchProvider(mine);
+  ASSERT_FALSE(BuiltInDefaultSearchEngine(target()));
+  EXPECT_TRUE(RestoreBuiltInDefaultSearchEngine(target(), *id));
+  EXPECT_EQ(target().GetDefaultSearchProvider()->prepopulate_id(), *id);
+
+  // Already the default: nothing to do, and that counts as restored.
+  EXPECT_TRUE(RestoreBuiltInDefaultSearchEngine(target(), *id));
+
+  // An ID this phone doesn't have changes nothing.
+  target().SetUserSelectedDefaultSearchProvider(mine);
+  EXPECT_FALSE(RestoreBuiltInDefaultSearchEngine(target(), 99999));
+  EXPECT_FALSE(RestoreBuiltInDefaultSearchEngine(target(), 0));
+  EXPECT_EQ(target().GetDefaultSearchProvider(), mine);
+}
+
+TEST_F(BackupSearchEnginesTest, CustomDefaultIsNotBuiltIn) {
+  TemplateURL* mine = AddEngine(source(), u"Mine", u"mine",
+                                "https://search.test/?q={searchTerms}");
+  source().SetUserSelectedDefaultSearchProvider(mine);
+  EXPECT_FALSE(BuiltInDefaultSearchEngine(source()));
+}
+
+TEST_F(BackupSearchEnginesTest, RoundTrip) {
+  TemplateURL* mine = AddEngine(source(), u"Mine é", u"mine",
+                                "https://search.test/?q={searchTerms}");
+  AddEngine(source(), u"Wiki", u"w",
+            "https://wiki.test/w/index.php?search={searchTerms}");
+  source().SetUserSelectedDefaultSearchProvider(mine);
+
+  SearchEnginesWriteResult written = SearchEnginesToJson(source());
+  EXPECT_EQ(written.engines, 2u);
+  EXPECT_EQ(*written.json.FindString("default_keyword"), "mine");
+  // Built-in engines are not in the personal list.
+  for (const base::Value& engine : *written.json.FindList("engines")) {
+    EXPECT_NE(*engine.GetDict().FindString("keyword"), "google.com");
+  }
+
+  auto restored =
+      RestoreSearchEngines(target(), Parse(*base::WriteJson(written.json)));
+  ASSERT_TRUE(restored);
+  EXPECT_EQ(restored->added, 2u);
+  EXPECT_EQ(restored->skipped, 0u);
+  EXPECT_TRUE(restored->default_set);
+  const TemplateURL* engine = target().GetDefaultSearchProvider();
+  EXPECT_EQ(engine->keyword(), u"mine");
+  EXPECT_EQ(engine->short_name(), u"Mine é");
+  EXPECT_EQ(engine->url(), "https://search.test/?q={searchTerms}");
+  EXPECT_EQ(engine->suggestions_url(),
+            "https://search.test/?q={searchTerms}&suggest=1");
+
+  // Again: nothing new, the phone's engines stay.
+  restored = RestoreSearchEngines(target(), written.json);
+  EXPECT_EQ(restored->added, 0u);
+  EXPECT_EQ(restored->already_present, 2u);
+}
+
+TEST_F(BackupSearchEnginesTest, ExistingKeywordKept) {
+  AddEngine(target(), u"Phone's own", u"mine",
+            "https://own.test/?q={searchTerms}");
+  auto restored = RestoreSearchEngines(target(), Parse(R"({"engines": [
+      {"name": "Backup", "keyword": "mine",
+       "url": "https://backup.test/?q={searchTerms}"}],
+      "default_keyword": "mine"})"));
+  ASSERT_TRUE(restored);
+  EXPECT_EQ(restored->already_present, 1u);
+  EXPECT_EQ(target().GetTemplateURLForKeyword(u"mine")->short_name(),
+            u"Phone's own");
+}
+
+TEST_F(BackupSearchEnginesTest, BadEnginesSkipped) {
+  const TemplateURL* default_before = target().GetDefaultSearchProvider();
+  auto restored = RestoreSearchEngines(target(), Parse(R"json({"engines": [
+      {"name": "No terms", "keyword": "a", "url": "https://a.test/"},
+      {"name": "Script", "keyword": "b", "url": "javascript:alert('{searchTerms}')"},
+      {"name": "File", "keyword": "c", "url": "file:///sdcard/{searchTerms}"},
+      {"name": "", "keyword": "d", "url": "https://d.test/?q={searchTerms}"},
+      {"name": "No keyword", "keyword": "", "url": "https://e.test/?q={searchTerms}"},
+      {"name": "Bad suggest", "keyword": "f", "url": "https://f.test/?q={searchTerms}",
+       "suggestions_url": "javascript:x"},
+      {"name": "Not a string", "keyword": 7, "url": "https://g.test/?q={searchTerms}"},
+      "not an engine",
+      {"name": "Good", "keyword": "ok", "url": "https://ok.test/?q={searchTerms}",
+       "favicon_url": ""}],
+      "default_keyword": "b"})json"));
+  ASSERT_TRUE(restored);
+  EXPECT_EQ(restored->added, 1u);
+  EXPECT_EQ(restored->skipped, 8u);
+  EXPECT_FALSE(restored->default_set);
+  EXPECT_EQ(target().GetDefaultSearchProvider(), default_before);
+  EXPECT_TRUE(target().GetTemplateURLForKeyword(u"ok"));
+  EXPECT_FALSE(target().GetTemplateURLForKeyword(u"b"));
+}

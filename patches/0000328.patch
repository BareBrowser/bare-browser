+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/bare/backup/backup_reading_list.h"
+
+#include <memory>
+#include <string>
+
+#include "base/json/json_reader.h"
+#include "base/json/json_writer.h"
+#include "base/test/simple_test_clock.h"
+#include "base/test/task_environment.h"
+#include "components/reading_list/core/fake_reading_list_model_storage.h"
+#include "components/reading_list/core/reading_list_entry.h"
+#include "components/reading_list/core/reading_list_model_impl.h"
+#include "components/sync/base/storage_type.h"
+#include "components/sync/model/wipe_model_upon_sync_disabled_behavior.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "url/gurl.h"
+
+namespace bare::backup {
+namespace {
+
+base::DictValue Parse(std::string_view json) {
+  return *base::JSONReader::ReadDict(json, base::JSON_PARSE_RFC);
+}
+
+std::unique_ptr<ReadingListModelImpl> CreateModel(base::Clock* clock) {
+  auto storage = std::make_unique<FakeReadingListModelStorage>();
+  FakeReadingListModelStorage* storage_ptr = storage.get();
+  auto model = std::make_unique<ReadingListModelImpl>(
+      std::move(storage), syncer::StorageType::kUnspecified,
+      syncer::WipeModelUponSyncDisabledBehavior::kNever, clock);
+  storage_ptr->TriggerLoadCompletion();
+  return model;
+}
+
+class BackupReadingListTest : public testing::Test {
+ protected:
+  base::test::SingleThreadTaskEnvironment task_environment_;
+  base::SimpleTestClock clock_;
+  std::unique_ptr<ReadingListModelImpl> source_ = CreateModel(&clock_);
+  std::unique_ptr<ReadingListModelImpl> target_ = CreateModel(&clock_);
+};
+
+TEST_F(BackupReadingListTest, RoundTrip) {
+  ASSERT_TRUE(source_->loaded());
+  source_->AddOrReplaceEntry(GURL("https://a.test/1"), "First",
+                             reading_list::ADDED_VIA_CURRENT_APP, std::nullopt,
+                             std::nullopt);
+  source_->AddOrReplaceEntry(GURL("https://b.test/2"), "Second é",
+                             reading_list::ADDED_VIA_CURRENT_APP, std::nullopt,
+                             std::nullopt);
+  source_->SetReadStatusIfExists(GURL("https://b.test/2"), true);
+  target_->AddOrReplaceEntry(GURL("https://a.test/1"), "Phone's own",
+                             reading_list::ADDED_VIA_CURRENT_APP, std::nullopt,
+                             std::nullopt);
+
+  ReadingListWriteResult written = ReadingListToJson(*source_);
+  EXPECT_EQ(written.entries, 2u);
+  auto result =
+      RestoreReadingList(*target_, Parse(*base::WriteJson(written.json)));
+  ASSERT_TRUE(result);
+  EXPECT_EQ(result->added, 1u);
+  EXPECT_EQ(result->already_present, 1u);
+  EXPECT_EQ(target_->size(), 2u);
+  EXPECT_EQ(target_->GetEntryByURL(GURL("https://a.test/1"))->Title(),
+            "Phone's own");
+  auto second = target_->GetEntryByURL(GURL("https://b.test/2"));
+  ASSERT_TRUE(second);
+  EXPECT_EQ(second->Title(), "Second é");
+  EXPECT_TRUE(second->IsRead());
+  EXPECT_EQ(second->CreationTime(),
+            source_->GetEntryByURL(GURL("https://b.test/2"))->CreationTime());
+}
+
+TEST_F(BackupReadingListTest, BadEntriesSkipped) {
+  auto result = RestoreReadingList(*target_, Parse(R"j({"entries": [
+      {"url": "not a url", "title": "x"},
+      {"title": "no url"},
+      {"url": "javascript:alert(1)", "title": "script"},
+      "not an entry",
+      {"url": "https://ok.test/", "added": "garbage"}
+  ]})j"));
+  ASSERT_TRUE(result);
+  EXPECT_EQ(result->added, 1u);
+  EXPECT_EQ(result->skipped, 4u);
+  EXPECT_FALSE(RestoreReadingList(*target_, Parse(R"j({"entries": 1})j")));
+}
+
+}  // namespace
+}  // namespace bare::backup
diff --git a/chrome/browser/bare/backup/backup_search_engines.cc b/chrome/browser/bare/backup/backup_search_engines.cc
new file mode 100644
index 00000000000..b54c01d1634
--- /dev/null
+++ b/chrome/browser/bare/backup/backup_search_engines.cc
@@ -0,0 +1,195 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/bare/backup/backup_search_engines.h"
+
+#include <memory>
+#include <string>
+#include <utility>
+
+#include "base/strings/utf_string_conversions.h"
+#include "components/search_engines/template_url.h"
+#include "components/search_engines/template_url_data.h"
+#include "components/search_engines/template_url_service.h"
+#include "components/search_engines/template_url_starter_pack_data.h"
+#include "url/gurl.h"
+
+namespace bare::backup {
+
+namespace {
+
+constexpr size_t kMaxNameLength = 256;
+
+bool IsUserEngine(const TemplateURL& engine) {
+  return engine.type() == TemplateURL::NORMAL &&
+         engine.prepopulate_id() == 0 &&
+         engine.starter_pack_id() ==
+             template_url_starter_pack_data::StarterPackId::kNone &&
+         !engine.CreatedByPolicy();
+}
+
+bool IsWebUrl(const std::string& spec) {
+  const GURL url(spec);
+  return url.is_valid() && url.SchemeIsHTTPOrHTTPS();
+}
+
+// An optional URL field: absent or empty is fine, anything else must be a web
+// URL. Returns false if the field is present and bad.
+bool ReadOptionalUrl(const base::DictValue& json,
+                     std::string_view key,
+                     std::string& out) {
+  const base::Value* value = json.Find(key);
+  if (!value) {
+    return true;
+  }
+  if (!value->is_string()) {
+    return false;
+  }
+  if (value->GetString().empty()) {
+    return true;
+  }
+  if (!IsWebUrl(value->GetString())) {
+    return false;
+  }
+  out = value->GetString();
+  return true;
+}
+
+std::optional<TemplateURLData> ReadEngine(const base::DictValue& json,
+                                          const SearchTermsData& terms) {
+  const std::string* name = json.FindString("name");
+  const std::string* keyword = json.FindString("keyword");
+  const std::string* url = json.FindString("url");
+  if (!name || name->empty() || name->size() > kMaxNameLength || !keyword ||
+      keyword->empty() || keyword->size() > kMaxNameLength || !url ||
+      !IsWebUrl(*url)) {
+    return std::nullopt;
+  }
+  TemplateURLData data;
+  data.SetShortName(base::UTF8ToUTF16(*name));
+  data.SetKeyword(base::UTF8ToUTF16(*keyword));
+  data.SetURL(*url);
+  std::string favicon;
+  if (!ReadOptionalUrl(json, "suggestions_url", data.suggestions_url) ||
+      !ReadOptionalUrl(json, "new_tab_url", data.new_tab_url) ||
+      !ReadOptionalUrl(json, "favicon_url", favicon)) {
+    return std::nullopt;
+  }
+  data.favicon_url = GURL(favicon);
+  data.safe_for_autoreplace =
+      json.FindBool("safe_for_autoreplace").value_or(false);
+  data.date_created = base::Time::Now();
+  data.last_modified = data.date_created;
+
+  // TemplateURLData accepts any string; the engine must also have a search
+  // URL with a place for the terms.
+  TemplateURL engine(data);
+  if (data.keyword().empty() || !engine.url_ref().IsValid(terms) ||
+      !engine.url_ref().SupportsReplacement(terms)) {
+    return std::nullopt;
+  }
+  return data;
+}
+
+}  // namespace
+
+std::optional<int> BuiltInDefaultSearchEngine(
+    const TemplateURLService& service) {
+  const TemplateURL* engine = service.GetDefaultSearchProvider();
+  if (!engine || engine->prepopulate_id() <= 0 ||
+      engine->type() != TemplateURL::NORMAL) {
+    return std::nullopt;
+  }
+  return engine->prepopulate_id();
+}
+
+bool RestoreBuiltInDefaultSearchEngine(TemplateURLService& service,
+                                       int prepopulate_id) {
+  if (prepopulate_id <= 0 || service.is_default_search_managed()) {
+    return false;
+  }
+  if (BuiltInDefaultSearchEngine(service) == prepopulate_id) {
+    return true;
+  }
+  for (TemplateURL* engine : service.GetTemplateURLs()) {
+    if (engine->prepopulate_id() == prepopulate_id &&
+        engine->type() == TemplateURL::NORMAL &&
+        service.CanMakeDefault(engine)) {
+      service.SetUserSelectedDefaultSearchProvider(engine);
+      return true;
+    }
+  }
+  return false;
+}
+
+SearchEnginesWriteResult SearchEnginesToJson(TemplateURLService& service) {
+  SearchEnginesWriteResult result;
+  base::ListValue engines;
+  for (const TemplateURL* engine : service.GetTemplateURLs()) {
+    if (!IsUserEngine(*engine) || result.engines >= kMaxSearchEngines) {
+      continue;
+    }
+    base::DictValue json;
+    json.Set("name", base::UTF16ToUTF8(engine->short_name()));
+    json.Set("keyword", base::UTF16ToUTF8(engine->keyword()));
+    json.Set("url", engine->url());
+    json.Set("suggestions_url", engine->suggestions_url());
+    json.Set("new_tab_url", engine->new_tab_url());
+    json.Set("favicon_url", engine->favicon_url().is_valid()
+                                ? engine->favicon_url().spec()
+                                : std::string());
+    json.Set("safe_for_autoreplace", engine->safe_for_autoreplace());
+    engines.Append(std::move(json));
+    ++result.engines;
+  }
+  result.json.Set("engines", std::move(engines));
+  const TemplateURL* default_engine = service.GetDefaultSearchProvider();
+  if (default_engine && IsUserEngine(*default_engine)) {
+    result.json.Set("default_keyword",
+                    base::UTF16ToUTF8(default_engine->keyword()));
+  }
+  return result;
+}
+
+std::optional<SearchEnginesRestoreResult> RestoreSearchEngines(
+    TemplateURLService& service,
+    const base::DictValue& json) {
+  const base::ListValue* engines = json.FindList("engines");
+  if (!engines || engines->size() > kMaxSearchEngines) {
+    return std::nullopt;
+  }
+  SearchEnginesRestoreResult result;
+  for (const base::Value& value : *engines) {
+    std::optional<TemplateURLData> data;
+    if (value.is_dict()) {
+      data = ReadEngine(value.GetDict(), service.search_terms_data());
+    }
+    if (!data) {
+      ++result.skipped;
+      continue;
+    }
+    if (service.GetTemplateURLForKeyword(data->keyword())) {
+      ++result.already_present;
+      continue;
+    }
+    if (service.Add(std::make_unique<TemplateURL>(*data))) {
+      ++result.added;
+    } else {
+      ++result.skipped;
+    }
+  }
+
+  const std::string* default_keyword = json.FindString("default_keyword");
+  if (default_keyword && !service.is_default_search_managed()) {
+    TemplateURL* engine =
+        service.GetTemplateURLForKeyword(base::UTF8ToUTF16(*default_keyword));
+    if (engine && IsUserEngine(*engine) && service.CanMakeDefault(engine)) {
+      service.SetUserSelectedDefaultSearchProvider(engine);
+      result.default_set = true;
+    }
+  }
+  return result;
+}
+
+}  // namespace bare::backup

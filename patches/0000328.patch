new file mode 100644
index 00000000000..af5021fcd04
--- /dev/null
+++ b/chrome/browser/bare/backup/backup_bookmarks.cc
@@ -0,0 +1,245 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/bare/backup/backup_bookmarks.h"
+
+#include <array>
+#include <map>
+#include <set>
+#include <utility>
+#include <vector>
+
+#include "base/memory/raw_ptr.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/time/time.h"
+#include "components/bookmarks/browser/bookmark_model.h"
+#include "components/bookmarks/browser/bookmark_node.h"
+#include "url/gurl.h"
+#include "url/url_constants.h"
+
+namespace bare::backup {
+
+namespace {
+
+using bookmarks::BookmarkModel;
+using bookmarks::BookmarkNode;
+
+constexpr size_t kMaxTitleLength = 4096;
+
+constexpr char kBookmarkBar[] = "bookmark_bar";
+constexpr char kOther[] = "other";
+constexpr char kMobile[] = "mobile";
+
+struct Root {
+  const char* name;
+  const BookmarkNode* node;
+};
+
+std::array<Root, 3> Roots(const BookmarkModel& model) {
+  return {{{kBookmarkBar, model.bookmark_bar_node()},
+           {kOther, model.other_node()},
+           {kMobile, model.mobile_node()}}};
+}
+
+std::string TimeToString(base::Time time) {
+  return base::NumberToString(
+      time.ToDeltaSinceWindowsEpoch().InMicroseconds());
+}
+
+base::Time TimeFromString(const std::string* text, base::Time fallback) {
+  int64_t micros = 0;
+  if (!text || !base::StringToInt64(*text, &micros) || micros <= 0) {
+    return fallback;
+  }
+  return base::Time::FromDeltaSinceWindowsEpoch(base::Microseconds(micros));
+}
+
+void AppendChildren(const BookmarkNode* folder,
+                    base::Value parent,
+                    BookmarksWriteResult& result,
+                    base::ListValue& nodes,
+                    int& next_id) {
+  for (const auto& child : folder->children()) {
+    base::DictValue node;
+    const int id = next_id++;
+    node.Set("id", id);
+    node.Set("parent", parent.Clone());
+    node.Set("title", base::UTF16ToUTF8(child->GetTitle()));
+    node.Set("added", TimeToString(child->date_added()));
+    if (child->is_folder()) {
+      node.Set("type", "folder");
+      nodes.Append(std::move(node));
+      ++result.folders;
+      AppendChildren(child.get(), base::Value(id), result, nodes, next_id);
+    } else {
+      node.Set("type", "url");
+      node.Set("url", child->url().spec());
+      nodes.Append(std::move(node));
+      ++result.urls;
+    }
+  }
+}
+
+std::u16string UniqueFolderTitle(const BookmarkNode* parent,
+                                 const std::u16string& title) {
+  std::set<std::u16string> taken;
+  for (const auto& child : parent->children()) {
+    if (child->is_folder()) {
+      taken.insert(child->GetTitle());
+    }
+  }
+  if (!taken.contains(title)) {
+    return title;
+  }
+  for (size_t i = 1;; ++i) {
+    std::u16string candidate =
+        title + u" (" + base::NumberToString16(i) + u")";
+    if (!taken.contains(candidate)) {
+      return candidate;
+    }
+  }
+}
+
+// A node from the file after checking. `parent` is a root name or the id of
+// an accepted folder.
+struct Checked {
+  int id = 0;
+  std::string root;
+  int parent_id = 0;
+  bool is_folder = false;
+  std::u16string title;
+  GURL url;
+  base::Time added;
+};
+
+}  // namespace
+
+BookmarksWriteResult BookmarksToJson(const BookmarkModel& model) {
+  BookmarksWriteResult result;
+  base::ListValue nodes;
+  int next_id = 1;
+  for (const Root& root : Roots(model)) {
+    AppendChildren(root.node, base::Value(root.name), result, nodes, next_id);
+  }
+  result.json.Set("nodes", std::move(nodes));
+  return result;
+}
+
+std::optional<BookmarksRestoreResult> RestoreBookmarks(
+    BookmarkModel& model,
+    const base::DictValue& json,
+    const std::u16string& folder_title) {
+  const base::ListValue* nodes = json.FindList("nodes");
+  if (!nodes || nodes->size() > kMaxBookmarkNodes) {
+    return std::nullopt;
+  }
+
+  BookmarksRestoreResult result;
+  const base::Time now = base::Time::Now();
+  std::vector<Checked> accepted;
+  std::set<int> seen_ids;
+  std::set<int> folder_ids;
+  std::set<std::string> roots_used;
+  for (const base::Value& value : *nodes) {
+    const base::DictValue* node = value.GetIfDict();
+    if (!node) {
+      ++result.skipped;
+      continue;
+    }
+    Checked checked;
+    const std::optional<int> id = node->FindInt("id");
+    const std::string* type = node->FindString("type");
+    const std::string* title = node->FindString("title");
+    const base::Value* parent = node->Find("parent");
+    if (!id || *id <= 0 || !seen_ids.insert(*id).second || !type ||
+        (*type != "folder" && *type != "url") || !parent) {
+      ++result.skipped;
+      continue;
+    }
+    checked.id = *id;
+    checked.is_folder = *type == "folder";
+    if (parent->is_string() &&
+        (parent->GetString() == kBookmarkBar || parent->GetString() == kOther ||
+         parent->GetString() == kMobile)) {
+      checked.root = parent->GetString();
+    } else if (parent->is_int() && folder_ids.contains(parent->GetInt())) {
+      checked.parent_id = parent->GetInt();
+    } else {
+      // Unknown parent, or inside a folder that was skipped.
+      ++result.skipped;
+      continue;
+    }
+    if (title) {
+      checked.title = base::UTF8ToUTF16(*title).substr(0, kMaxTitleLength);
+    }
+    if (!checked.is_folder) {
+      const std::string* url = node->FindString("url");
+      if (!url || url->size() > url::kMaxURLChars) {
+        ++result.skipped;
+        continue;
+      }
+      checked.url = GURL(*url);
+      if (!checked.url.is_valid()) {
+        ++result.skipped;
+        continue;
+      }
+    }
+    checked.added = TimeFromString(node->FindString("added"), now);
+    if (checked.is_folder) {
+      folder_ids.insert(checked.id);
+    }
+    if (!checked.root.empty()) {
+      roots_used.insert(checked.root);
+    }
+    accepted.push_back(std::move(checked));
+  }
+
+  bool model_empty = true;
+  for (const Root& root : Roots(model)) {
+    model_empty = model_empty && root.node->children().empty();
+  }
+
+  std::map<std::string, raw_ptr<const BookmarkNode>> targets;
+  if (model_empty) {
+    for (const Root& root : Roots(model)) {
+      targets[root.name] = root.node;
+    }
+  } else if (!accepted.empty()) {
+    result.into_folder = true;
+    result.folder_title = UniqueFolderTitle(model.mobile_node(), folder_title);
+    const BookmarkNode* container =
+        model.AddFolder(model.mobile_node(), model.mobile_node()->children().size(),
+                        result.folder_title);
+    for (const Root& root : Roots(model)) {
+      if (!roots_used.contains(root.name)) {
+        continue;
+      }
+      targets[root.name] =
+          roots_used.size() == 1
+              ? container
+              : model.AddFolder(container, container->children().size(),
+                                root.node->GetTitle());
+    }
+  }
+
+  std::map<int, raw_ptr<const BookmarkNode>> folders;
+  for (const Checked& node : accepted) {
+    const BookmarkNode* parent = node.root.empty()
+                                     ? folders[node.parent_id].get()
+                                     : targets[node.root].get();
+    const size_t index = parent->children().size();
+    if (node.is_folder) {
+      folders[node.id] =
+          model.AddFolder(parent, index, node.title, nullptr, node.added);
+      ++result.folders;
+    } else {
+      model.AddURL(parent, index, node.title, node.url, nullptr, node.added);
+      ++result.urls;
+    }
+  }
+  return result;
+}
+
+}  // namespace bare::backup
diff --git a/chrome/browser/bare/backup/backup_bookmarks.h b/chrome/browser/bare/backup/backup_bookmarks.h
new file mode 100644
index 00000000000..048b84bbf5d
--- /dev/null
+++ b/chrome/browser/bare/backup/backup_bookmarks.h
@@ -0,0 +1,66 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_BARE_BACKUP_BACKUP_BOOKMARKS_H_
+#define CHROME_BROWSER_BARE_BACKUP_BACKUP_BOOKMARKS_H_
+
+#include <stddef.h>
+
+#include <optional>
+#include <string>
+
+#include "base/values.h"
+
+namespace bookmarks {
+class BookmarkModel;
+}
+
+// Bookmarks in personal/bookmarks.json:
+//
+//   {"nodes": [{"id": 1, "parent": "bookmark_bar", "type": "folder",
+//               "title": "News", "added": "13350000000000000"},
+//              {"id": 2, "parent": 1, "type": "url", "title": "...",
+//               "url": "https://...", "added": "..."}]}
+//
+// The list is flat and in tree order, so a folder always comes before what's
+// in it and deep folders don't nest the JSON. "parent" is a permanent folder
+// name or the id of an earlier folder. "added" is microseconds since the
+// Windows epoch, as a string because JSON numbers lose int64 precision.
+namespace bare::backup {
+
+inline constexpr size_t kMaxBookmarkNodes = 100000;
+
+struct BookmarksWriteResult {
+  base::DictValue json;
+  size_t urls = 0;
+  size_t folders = 0;
+};
+
+// The three permanent folders and everything in them. Managed and account
+// folders are left out.
+BookmarksWriteResult BookmarksToJson(const bookmarks::BookmarkModel& model);
+
+struct BookmarksRestoreResult {
+  size_t urls = 0;
+  size_t folders = 0;
+  // Nodes that failed a check, and everything inside a folder that did.
+  size_t skipped = 0;
+  // False when the model was empty and the tree went back where it was.
+  bool into_folder = false;
+  std::u16string folder_title;
+};
+
+// An empty model gets the tree back exactly. Otherwise everything goes into a
+// new folder in Mobile bookmarks named `folder_title`, or `folder_title (1)`
+// and so on if that name is taken; the phone's own bookmarks are not touched.
+// Returns nullopt, with the model unchanged, if `json` isn't a bookmarks list
+// at all.
+std::optional<BookmarksRestoreResult> RestoreBookmarks(
+    bookmarks::BookmarkModel& model,
+    const base::DictValue& json,
+    const std::u16string& folder_title);
+
+}  // namespace bare::backup
+
+#endif  // CHROME_BROWSER_BARE_BACKUP_BACKUP_BOOKMARKS_H_

+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_BARE_BACKUP_BACKUP_READING_LIST_H_
+#define CHROME_BROWSER_BARE_BACKUP_BACKUP_READING_LIST_H_
+
+#include <stddef.h>
+
+#include <optional>
+
+#include "base/values.h"
+
+class ReadingListModel;
+
+// The reading list, in personal/reading_list.json:
+//
+//   {"entries": [{"url": "https://...", "title": "...", "read": false,
+//                 "added": "1762200000000000"}]}
+//
+// "added" is microseconds since the Unix epoch, as a string.
+namespace bare::backup {
+
+inline constexpr size_t kMaxReadingListEntries = 10000;
+
+struct ReadingListWriteResult {
+  base::DictValue json;
+  size_t entries = 0;
+};
+
+ReadingListWriteResult ReadingListToJson(const ReadingListModel& model);
+
+struct ReadingListRestoreResult {
+  size_t added = 0;
+  // Already in this phone's list. The phone's entry is kept.
+  size_t already_present = 0;
+  size_t skipped = 0;
+};
+
+// `model` must be loaded. Returns nullopt, changing nothing, if `json` isn't
+// an entry list.
+std::optional<ReadingListRestoreResult> RestoreReadingList(
+    ReadingListModel& model,
+    const base::DictValue& json);
+
+}  // namespace bare::backup
+
+#endif  // CHROME_BROWSER_BARE_BACKUP_BACKUP_READING_LIST_H_

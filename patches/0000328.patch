+TEST(BackupSettingsTest, PublicDnsServerTravelsInSetup) {
+  // Cloudflare's template, one of Chromium's built-in providers.
+  constexpr char kPublic[] = "https://chrome.cloudflare-dns.com/dns-query";
+  constexpr char kCustom[] = "https://dns.nextdns.test/abc123";
+
+  Phone source;
+  source.local_state.SetString("dns_over_https.mode", "secure");
+  source.local_state.SetString("dns_over_https.templates", kPublic);
+  base::DictValue setup =
+      SettingsToJson(SettingGroup::kSetup, source.stores()).json;
+  EXPECT_EQ(*setup.FindDict("local_state")
+                 ->FindString("dns_over_https.templates"),
+            kPublic);
+
+  Phone target;
+  SettingsRestoreResult result =
+      RestoreSettings(SettingGroup::kSetup, setup, target.stores());
+  EXPECT_TRUE(result.skipped.empty());
+  EXPECT_EQ(target.local_state.GetString("dns_over_https.templates"),
+            kPublic);
+  EXPECT_EQ(target.local_state.GetString("dns_over_https.mode"), "secure");
+
+  // A custom server stays out of setup, and a setup file can't bring one in.
+  source.local_state.SetString("dns_over_https.templates", kCustom);
+  setup = SettingsToJson(SettingGroup::kSetup, source.stores()).json;
+  EXPECT_FALSE(setup.FindDict("local_state")
+                   ->contains("dns_over_https.templates"));
+  result = RestoreSettings(
+      SettingGroup::kSetup,
+      Parse(R"j({"local_state": {"dns_over_https.templates":
+                 "https://dns.nextdns.test/abc123"}})j"),
+      target.stores());
+  EXPECT_EQ(result.unknown,
+            (std::vector<std::string>{"local_state:dns_over_https.templates"}));
+  EXPECT_EQ(target.local_state.GetString("dns_over_https.templates"),
+            kPublic);
+
+  // Full backups carry it either way.
+  base::DictValue personal =
+      SettingsToJson(SettingGroup::kPersonal, source.stores()).json;
+  EXPECT_EQ(*personal.FindDict("local_state")
+                 ->FindString("dns_over_https.templates"),
+            kCustom);
+}
+
+TEST(BackupSettingsTest, PersonalValueChecks) {
+  Phone target;
+  SettingsRestoreResult result = RestoreSettings(
+      SettingGroup::kPersonal, Parse(R"j({
+        "android": {
+          "Bare.Translate.Endpoint": "http://203.0.113.5/translate",
+          "Bare.UserAgent.Custom": "Mozilla\n",
+          "Bare.Translate.ConsentHost": "a host/with/slashes",
+          "Chrome.Homepage.CustomGurl": ""
+        },
+        "local_state": {"dns_over_https.templates": "http://dns.test/q"}
+      })j"),
+      target.stores());
+  EXPECT_EQ(result.applied, 0u);
+  EXPECT_EQ(result.skipped.size(), 5u);
+
+  result = RestoreSettings(
+      SettingGroup::kPersonal, Parse(R"j({
+        "android": {
+          "Bare.Translate.Endpoint": "http://192.168.1.20:5000/translate",
+          "Bare.UserAgent.Custom": "Mozilla/5.0 (X11; Linux x86_64)",
+          "Bare.Translate.ConsentHost": "192.168.1.20"
+        },
+        "local_state": {"dns_over_https.templates":
+            "https://a.test/dns-query{?dns} https://b.test/dns-query"}
+      })j"),
+      target.stores());
+  EXPECT_EQ(result.applied, 4u);
+  EXPECT_TRUE(result.skipped.empty());
+  EXPECT_TRUE(result.needs_restart);
+}

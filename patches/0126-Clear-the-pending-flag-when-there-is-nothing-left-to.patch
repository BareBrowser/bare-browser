From b7aa9d40c30ffd29841cc601f407a20e428ff085 Mon Sep 17 00:00:00 2001
From: Bare <git@barebrowser.org>
Date: Thu, 10 Sep 2026 04:04:24 +0000
Subject: [PATCH] Clear the pending flag when there is nothing left to delete

Clear on exit writes a flag before it starts and clears it when the deletion
reports back, so an exit cut short is finished on the next start. The resume
returns early when the selection is empty, and that early return was the one
path that did not clear the flag. Emptying the selection after an interrupted
exit therefore left it set for good, and the next start after re-selecting
anything deleted at a start rather than at an exit.

IDS_BARE_CLEAR_ON_EXIT_NOTHING went with it. Nothing in the series ever
referenced it and its description promised a summary line that was never built.

The header said Exit closes Bare. It closes the window it was chosen in, and
with a second window open the browser stays and can write back what was just
deleted, so it now says which of the two happens.
---
 .../org/chromium/chrome/browser/bare/BareClearOnExit.java    | 4 ++++
 chrome/browser/ui/android/strings/android_chrome_strings.grd | 5 +----
 2 files changed, 5 insertions(+), 4 deletions(-)

diff --git a/chrome/android/java/src/org/chromium/chrome/browser/bare/BareClearOnExit.java b/chrome/android/java/src/org/chromium/chrome/browser/bare/BareClearOnExit.java
index e833d3f0070..28e3e253ad4 100644
--- a/chrome/android/java/src/org/chromium/chrome/browser/bare/BareClearOnExit.java
+++ b/chrome/android/java/src/org/chromium/chrome/browser/bare/BareClearOnExit.java
@@ -78,6 +78,10 @@ public final class BareClearOnExit {
     public static void clearThen(Profile profile, Runnable whenDone) {
         int[] types = selectedTypes(getSelection(profile));
         if (types.length == 0) {
+            // Clear the flag on the way out. An exit interrupted while the selection still named
+            // something leaves it set, and if the selection is emptied before the next start the
+            // resume finds nothing to delete and used to leave the flag standing for good.
+            UserPrefs.get(profile).setBoolean(Pref.CLEAR_ON_EXIT_PENDING, false);
             whenDone.run();
             return;
         }
diff --git a/chrome/browser/ui/android/strings/android_chrome_strings.grd b/chrome/browser/ui/android/strings/android_chrome_strings.grd
index 29566262fe9..d781a0a527a 100644
--- a/chrome/browser/ui/android/strings/android_chrome_strings.grd
+++ b/chrome/browser/ui/android/strings/android_chrome_strings.grd
@@ -1136,11 +1136,8 @@ For example, some websites may respond to this request by showing you ads that a
       <message name="IDS_BARE_CLEAR_ON_EXIT_SUMMARY" desc="Summary under the Clear on exit row in Privacy and security settings.">
         Choose what Exit deletes
       </message>
-      <message name="IDS_BARE_CLEAR_ON_EXIT_NOTHING" desc="Shown under the Clear on exit row when the user has chosen nothing, so Exit only closes the browser.">
-        Nothing
-      </message>
       <message name="IDS_BARE_CLEAR_ON_EXIT_HEADER" desc="Explanation at the top of the Clear on exit screen.">
-        Exit closes Bare. Anything selected here is deleted first. Bookmarks, extensions and settings are never deleted.
+        Exit closes Bare. Anything selected here is deleted first. With more than one window open, Exit closes this window. Bookmarks, extensions and settings are never deleted.
       </message>
       <message name="IDS_CLEAR_BROWSING_DATA_TITLE" desc="Title of the Delete Browsing Data screen. [CHAR_LIMIT=32]">
         Delete browsing data

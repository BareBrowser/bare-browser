+    /**
+     * Reopens the tabs native checked, last of all, and adds them to the report and the receipt.
+     */
+    private static String reopenTabs(Profile profile, String json) {
+        try {
+            JSONObject report = new JSONObject(json);
+            String tabs = report.optString("tabs_json");
+            report.remove("tabs_json");
+            JSONObject receipt = report.optJSONObject("receipt");
+            if (!tabs.isEmpty()) {
+                int arrived = BareBackupTabs.restore(profile, tabs);
+                report.put("tabs", Math.max(arrived, 0));
+                report.put("tabs_failed", arrived < 0);
+                if (receipt != null) receipt.put("tabs", Math.max(arrived, 0));
+                JSONArray applied = report.optJSONArray("applied");
+                if (applied != null && arrived >= 0) applied.put("tabs");
+            }
+            return report.toString();
+        } catch (JSONException e) {
+            return json;
+        }
+    }

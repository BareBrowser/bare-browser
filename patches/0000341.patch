+void OnStateHistory(base::WeakPtr<Profile> profile,
+                    CollectedState state,
+                    StateCallback done,
+                    history::QueryResults results) {
+  for (const history::URLResult& result : results) {
+    if (result.hidden()) {
+      continue;
+    }
+    HistoryRow row;
+    row.url = result.url();
+    row.title = base::UTF16ToUTF8(result.title());
+    row.last_visit = result.visit_time();
+    row.visit_count = result.visit_count();
+    row.typed_count = result.typed_count();
+    state.history.push_back(std::move(row));
+  }
+  if (!profile || !state.include_cookies) {
+    std::move(done).Run(std::move(state));
+    return;
+  }
+  CookiesOf(profile.get())
+      ->GetAllCookies(mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+          base::BindOnce(&OnStateCookies, std::move(state), std::move(done)),
+          std::vector<net::CanonicalCookie>()));
+}
+
+// History from the last 90 days, newest visit per page, then the cookies.
+// The regular profile only: the bridge is never given an Incognito one.
+void CollectState(Profile* profile,
+                  std::string tabs_json,
+                  bool include_cookies,
+                  StateCallback done) {
+  CollectedState state;
+  state.tabs_json = std::move(tabs_json);
+  state.include_cookies = include_cookies;
+  history::HistoryService* history = HistoryServiceFactory::GetForProfile(
+      profile, ServiceAccessType::EXPLICIT_ACCESS);
+  if (!history) {
+    OnStateHistory(profile->GetWeakPtr(), std::move(state), std::move(done),
+                   history::QueryResults());
+    return;
+  }
+  history::QueryOptions options;
+  options.begin_time = base::Time::Now() - base::Days(kHistoryDays);
+  options.max_count = kMaxHistoryRows;
+  options.duplicate_policy = history::QueryOptions::REMOVE_ALL_DUPLICATES;
+  history->QueryHistory(std::u16string(), options,
+                        base::BindOnce(&OnStateHistory, profile->GetWeakPtr(),
+                                       std::move(state), std::move(done)),
+                        &HistoryTracker());
+}
+
+using BuildStep = base::OnceCallback<void(CollectedState, CollectedExtensions)>;
+
+// The state for a full package (none for setup), then the extensions, then
+// `build`.
+void CollectAll(Profile* profile,
+                bool full,
+                std::string tabs_json,
+                bool include_cookies,
+                BuildStep build) {
+  auto after_state = base::BindOnce(
+      [](base::WeakPtr<Profile> profile, bool full, BuildStep build,
+         CollectedState state) {
+        if (!profile) {
+          std::move(build).Run(std::move(state), CollectedExtensions());
+          return;
+        }
+        CollectExtensions(profile.get(), /*with_files=*/full,
+                          base::BindOnce(std::move(build), std::move(state)));
+      },
+      profile->GetWeakPtr(), full, std::move(build));
+  if (!full) {
+    std::move(after_state).Run(CollectedState());
+    return;
+  }
+  CollectState(profile, std::move(tabs_json), include_cookies,
+               std::move(after_state));
+}

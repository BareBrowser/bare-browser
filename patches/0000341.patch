index 00000000000..0d51c2b031a
--- /dev/null
+++ b/chrome/android/java/src/org/chromium/chrome/browser/bare/backup/BareBackupTabs.java
@@ -0,0 +1,234 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.bare.backup;
+
+import android.app.Activity;
+
+import org.json.JSONArray;
+import org.json.JSONException;
+import org.json.JSONObject;
+
+import org.chromium.base.ApplicationStatus;
+import org.chromium.base.Token;
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.chrome.browser.ChromeTabbedActivity;
+import org.chromium.chrome.browser.app.tabwindow.TabWindowManagerSingleton;
+import org.chromium.chrome.browser.profiles.Profile;
+import org.chromium.chrome.browser.tab.Tab;
+import org.chromium.chrome.browser.tab.TabIdManager;
+import org.chromium.chrome.browser.tab.TabSelectionType;
+import org.chromium.chrome.browser.tab.TabState;
+import org.chromium.chrome.browser.tab.WebContentsState;
+import org.chromium.chrome.browser.tabmodel.TabClosureParams;
+import org.chromium.chrome.browser.tabmodel.TabCreator;
+import org.chromium.chrome.browser.tabmodel.TabModel;
+import org.chromium.chrome.browser.tabmodel.TabModelSelector;
+import org.chromium.chrome.browser.url_constants.UrlConstantResolver;
+import org.chromium.components.embedder_support.util.UrlConstants;
+import org.chromium.components.embedder_support.util.UrlUtilities;
+import org.chromium.content_public.browser.LoadUrlParams;
+import org.chromium.url.GURL;
+
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+
+/**
+ * The open tabs in a full backup. Only the regular tabs of each window are read, never Incognito.
+ * A restored tab is its current page only, added frozen so it loads when it is opened.
+ */
+@NullMarked
+final class BareBackupTabs {
+    private BareBackupTabs() {}
+
+    /** The open tabs as {"tabs": [...], "groups": [...]}; native checks it again. */
+    static String collect() {
+        JSONArray tabs = new JSONArray();
+        JSONArray groups = new JSONArray();
+        Map<Token, Integer> groupIndex = new HashMap<>();
+        try {
+            for (TabModelSelector selector :
+                    TabWindowManagerSingleton.getInstance().getAllTabModelSelectors()) {
+                if (selector == null) continue;
+                TabModel model = selector.getModel(/* incognito= */ false);
+                int selected = model.index();
+                for (int i = 0; i < model.getCount(); i++) {
+                    Tab tab = model.getTabAt(i);
+                    if (tab == null || tab.isIncognito()) continue;
+                    JSONObject entry = new JSONObject();
+                    GURL url = tab.getUrl();
+                    if (UrlUtilities.isNtpUrl(url)) {
+                        entry.put("ntp", true);
+                    } else if (url.getScheme().equals(UrlConstants.HTTP_SCHEME)
+                            || url.getScheme().equals(UrlConstants.HTTPS_SCHEME)) {
+                        entry.put("url", url.getSpec());
+                    } else {
+                        continue;
+                    }
+                    entry.put("title", tab.getTitle());
+                    entry.put("pinned", tab.getIsPinned());
+                    entry.put("selected", i == selected);
+                    Token group = tab.getTabGroupId();
+                    if (group != null && !tab.getIsPinned()) {
+                        Integer index = groupIndex.get(group);
+                        if (index == null) {
+                            index = groups.length();
+                            groupIndex.put(group, index);
+                            JSONObject info = new JSONObject();
+                            String title = model.getTabGroupTitle(group);
+                            info.put("title", title == null ? "" : title);
+                            info.put("color", Math.max(0, model.getTabGroupColor(group)));
+                            info.put("collapsed", model.getTabGroupCollapsed(group));
+                            groups.put(info);
+                        }
+                        entry.put("group", index);
+                    }
+                    tabs.put(entry);
+                }
+            }
+            JSONObject all = new JSONObject();
+            all.put("tabs", tabs);
+            all.put("groups", groups);
+            return all.toString();
+        } catch (JSONException e) {
+            return "";
+        }
+    }
+
+    /**
+     * Adds the tabs native checked to the browser window, after the tabs already there. Tabs
+     * already open at the same address are not added twice but count as arrived. On a fresh
+     * phone, the one empty New tab page is closed and the saved selected tab is selected.
+     *
+     * @return how many tabs are now there from the file, or -1 if no browser window was ready.
+     */
+    static int restore(Profile profile, String json) {
+        ChromeTabbedActivity activity = browserWindow();
+        if (activity == null) return -1;
+        TabModelSelector selector = activity.getTabModelSelector();
+        if (selector == null || !selector.isTabStateInitialized()) return -1;
+        TabModel model = selector.getModel(/* incognito= */ false);
+        TabCreator creator = activity.getTabCreator(/* incognito= */ false);
+
+        JSONArray tabs;
+        JSONArray groups;
+        try {
+            JSONObject all = new JSONObject(json);
+            tabs = all.getJSONArray("tabs");
+            groups = all.optJSONArray("groups");
+        } catch (JSONException e) {
+            return 0;
+        }
+
+        Tab onlyEmpty = null;
+        Set<String> open = new HashSet<>();
+        for (int i = 0; i < model.getCount(); i++) {
+            Tab tab = model.getTabAt(i);
+            if (tab == null) continue;
+            open.add(tab.getIsPinned() + " " + tab.getUrl().getSpec());
+        }
+        if (model.getCount() == 1) {
+            Tab tab = model.getTabAt(0);
+            if (tab != null && UrlUtilities.isNtpUrl(tab.getUrl()) && !tab.getIsPinned()) {
+                onlyEmpty = tab;
+            }
+        }
+
+        int arrived = 0;
+        Tab select = null;
+        List<Tab> toPin = new ArrayList<>();
+        Map<Integer, List<Tab>> grouped = new HashMap<>();
+        int lastGroup = -1;
+        Set<Integer> closedGroups = new HashSet<>();
+        for (int i = 0; i < tabs.length(); i++) {
+            JSONObject entry = tabs.optJSONObject(i);
+            if (entry == null) continue;
+            boolean ntp = entry.optBoolean("ntp");
+            String url = ntp ? UrlConstantResolver.getOriginalNativeNtpUrl() : entry.optString("url");
+            GURL gurl = new GURL(url);
+            // Native allowed only these; checked again before anything is built from it.
+            if (!ntp
+                    && (!gurl.isValid()
+                            || !(gurl.getScheme().equals(UrlConstants.HTTP_SCHEME)
+                                    || gurl.getScheme().equals(UrlConstants.HTTPS_SCHEME))
+                            || !gurl.getUsername().isEmpty()
+                            || !gurl.getPassword().isEmpty())) {
+                continue;
+            }
+            boolean pinned = entry.optBoolean("pinned");
+            if (!ntp && open.contains(pinned + " " + gurl.getSpec())) {
+                arrived++;
+                continue;
+            }
+            String title = entry.optString("title");
+            TabState state = new TabState();
+            state.contentsState =
+                    WebContentsState.createSingleNavigationWebContentsState(
+                            profile, title.isEmpty() ? null : title, new LoadUrlParams(url));
+            if (state.contentsState == null) continue;
+            state.url = gurl;
+            state.timestampMillis = System.currentTimeMillis();
+            int id = TabIdManager.getInstance().generateValidId(Tab.INVALID_TAB_ID);
+            Tab tab = creator.createFrozenTab(state, id, model.getCount());
+            if (tab == null) continue;
+            arrived++;
+            if (!ntp) open.add(pinned + " " + gurl.getSpec());
+            if (entry.optBoolean("selected") && select == null) select = tab;
+            if (pinned) {
+                toPin.add(tab);
+                lastGroup = -1;
+                continue;
+            }
+            // A group's tabs sit next to each other. A file that splits one is not followed.
+            int group = entry.optInt("group", -1);
+            if (group >= 0 && group != lastGroup && grouped.containsKey(group)) {
+                closedGroups.add(group);
+            }
+            if (group >= 0 && !closedGroups.contains(group)) {
+                grouped.computeIfAbsent(group, g -> new ArrayList<>()).add(tab);
+            }
+            lastGroup = group;
+        }
+
+        for (Map.Entry<Integer, List<Tab>> entry : grouped.entrySet()) {
+            Token token = Token.createRandom();
+            model.createTabGroupForTabGroupSync(entry.getValue(), token);
+            JSONObject info = groups == null ? null : groups.optJSONObject(entry.getKey());
+            if (info == null) continue;
+            String title = info.optString("title");
+            if (!title.isEmpty()) model.setTabGroupTitle(token, title);
+            model.setTabGroupColor(token, info.optInt("color"));
+            if (info.optBoolean("collapsed")) model.setTabGroupCollapsed(token, true);
+        }
+        for (Tab tab : toPin) model.pinTab(tab.getId(), /* showUngroupDialog= */ false);
+
+        if (onlyEmpty != null && arrived > 0 && model.getCount() > 1) {
+            int index = select == null ? -1 : model.indexOf(select);
+            if (index >= 0) model.setIndex(index, TabSelectionType.FROM_USER);
+            model.getTabRemover()
+                    .closeTabs(
+                            TabClosureParams.closeTab(onlyEmpty).allowUndo(false).build(),
+                            /* allowDialog= */ false);
+        }
+        // So killing the app right away doesn't lose them.
+        activity.saveState();
+        return arrived;
+    }
+
+    private static @Nullable ChromeTabbedActivity browserWindow() {
+        for (Activity activity : ApplicationStatus.getRunningActivities()) {
+            if (activity instanceof ChromeTabbedActivity tabbed
+                    && !tabbed.isFinishing()
+                    && !tabbed.isDestroyed()) {
+                return tabbed;
+            }
+        }
+        return null;
+    }
+}

+// Restores history and cookies, checks the tabs for Java, then adds what
+// happened to `json` and runs `done`. Owns itself until then. Cookies already
+// on this phone are kept as they are; nothing is deleted.
+class StateRestore {
+ public:
+  using Done = base::OnceCallback<void(base::DictValue)>;
+
+  static void Start(Profile* profile,
+                    const Package& package,
+                    const PackageSummary& summary,
+                    bool tabs,
+                    bool history,
+                    bool cookies,
+                    base::DictValue json,
+                    Done done) {
+    auto* self = new StateRestore(profile, std::move(json), std::move(done));
+    const auto offered = [&](const char* section) {
+      return std::ranges::contains(summary.sections, section);
+    };
+    const base::Time now = base::Time::Now();
+    if (tabs && offered(kSectionTabs)) {
+      int count = 0;
+      int refused = 0;
+      std::string checked = ReadStateTabs(package, count, refused);
+      if (!checked.empty()) {
+        self->json_.Set("tabs_json", std::move(checked));
+      }
+      self->json_.Set("tabs_refused", refused);
+    }
+    if (history && offered(kSectionHistory)) {
+      self->history_chosen_ = true;
+      self->history_ = ReadStateHistory(package, now,
+                                        /*phone_has_history=*/false,
+                                        self->history_refused_);
+    }
+    if (cookies && offered(kSectionCookies)) {
+      self->cookies_chosen_ = true;
+      self->cookies_ = ReadStateCookies(package, now, self->cookies_refused_,
+                                        self->cookies_expired_);
+    }
+    self->RestoreHistory();
+  }
+
+ private:
+  StateRestore(Profile* profile, base::DictValue json, Done done)
+      : profile_(profile->GetWeakPtr()),
+        json_(std::move(json)),
+        done_(std::move(done)) {}
+
+  void RestoreHistory() {
+    history::HistoryService* service =
+        profile_ && !history_.empty()
+            ? HistoryServiceFactory::GetForProfile(
+                  profile_.get(), ServiceAccessType::EXPLICIT_ACCESS)
+            : nullptr;
+    if (!service) {
+      if (!history_.empty()) {
+        history_refused_ += static_cast<int>(history_.size());
+        history_.clear();
+      }
+      RestoreCookies();
+      return;
+    }
+    // One row is enough to know whether this phone has history of its own.
+    history::QueryOptions options;
+    options.max_count = 1;
+    service->QueryHistory(
+        std::u16string(), options,
+        base::BindOnce(&StateRestore::OnPhoneHistory, base::Unretained(this)),
+        &HistoryTracker());
+  }
+
+  void OnPhoneHistory(history::QueryResults results) {
+    history::HistoryService* service =
+        profile_ ? HistoryServiceFactory::GetForProfile(
+                       profile_.get(), ServiceAccessType::EXPLICIT_ACCESS)
+                 : nullptr;
+    if (!service) {
+      history_refused_ += static_cast<int>(history_.size());
+      history_.clear();
+      RestoreCookies();
+      return;
+    }
+    // A phone in use keeps its own address bar suggestions.
+    const bool phone_has_history = !results.empty();
+    constexpr size_t kBatch = 2000;
+    for (size_t start = 0; start < history_.size(); start += kBatch) {
+      history::URLRows rows;
+      for (size_t i = start; i < std::min(history_.size(), start + kBatch);
+           ++i) {
+        const HistoryRow& in = history_[i];
+        history::URLRow row(in.url);
+        row.set_title(base::UTF8ToUTF16(in.title));
+        row.set_last_visit(in.last_visit);
+        row.set_visit_count(in.visit_count);
+        row.set_typed_count(phone_has_history ? 0 : in.typed_count);
+        row.set_hidden(false);
+        rows.push_back(std::move(row));
+      }
+      // The source Chromium uses for history brought over from another device.
+      service->AddPagesWithDetails(rows,
+                                   history::SOURCE_OS_MIGRATION_IMPORTED);
+    }
+    history_added_ = static_cast<int>(history_.size());
+    history_.clear();
+    RestoreCookies();
+  }
+
+  static std::string CookieKey(const net::CanonicalCookie& cookie) {
+    return cookie.Name() + '\n' + cookie.Domain() + '\n' + cookie.Path() +
+           '\n' +
+           (cookie.PartitionKey() ? cookie.PartitionKey()->site().Serialize()
+                                  : std::string());
+  }
+
+  void RestoreCookies() {
+    if (!profile_ || cookies_.empty()) {
+      cookies_refused_ += static_cast<int>(cookies_.size());
+      cookies_.clear();
+      Finish();
+      return;
+    }
+    CookiesOf(profile_.get())
+        ->GetAllCookies(mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+            base::BindOnce(&StateRestore::OnPhoneCookies,
+                           base::Unretained(this)),
+            std::vector<net::CanonicalCookie>()));
+  }
+
+  void OnPhoneCookies(const std::vector<net::CanonicalCookie>& existing) {
+    if (!profile_) {
+      cookies_refused_ += static_cast<int>(cookies_.size());
+      cookies_.clear();
+      Finish();
+      return;
+    }
+    std::set<std::string> here;
+    for (const net::CanonicalCookie& cookie : existing) {
+      here.insert(CookieKey(cookie));
+    }
+    network::mojom::CookieManager* manager = CookiesOf(profile_.get());
+    std::vector<std::unique_ptr<net::CanonicalCookie>> to_set;
+    for (std::unique_ptr<net::CanonicalCookie>& cookie : cookies_) {
+      if (here.contains(CookieKey(*cookie))) {
+        ++cookies_there_;
+      } else {
+        to_set.push_back(std::move(cookie));
+      }
+    }
+    cookies_.clear();
+    pending_ = static_cast<int>(to_set.size());
+    if (pending_ == 0) {
+      Flush();
+      return;
+    }
+    for (const std::unique_ptr<net::CanonicalCookie>& cookie : to_set) {
+      const GURL source = net::cookie_util::CookieDomainAndPathToURL(
+          cookie->Domain(), cookie->Path(), cookie->SourceScheme());
+      manager->SetCanonicalCookie(
+          *cookie, source, net::CookieOptions::MakeAllInclusive(),
+          mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+              base::BindOnce(&StateRestore::OnCookieSet,
+                             base::Unretained(this)),
+              NotSet()));
+    }
+  }
+
+  // What a set that never answered counts as.
+  static net::CookieAccessResult NotSet() {
+    net::CookieInclusionStatus status;
+    status.AddExclusionReason(
+        net::CookieInclusionStatus::ExclusionReason::EXCLUDE_UNKNOWN_ERROR);
+    return net::CookieAccessResult(status);
+  }
+
+  void OnCookieSet(net::CookieAccessResult result) {
+    if (result.status.IsInclude()) {
+      ++cookies_set_;
+    } else {
+      ++cookies_refused_;
+    }
+    if (--pending_ == 0) {
+      Flush();
+    }
+  }
+
+  // The cookie store otherwise writes about 30 seconds later, and a Move's
+  // sender erases its copy as soon as the receipt arrives.
+  void Flush() {
+    if (!profile_) {
+      Finish();
+      return;
+    }
+    CookiesOf(profile_.get())
+        ->FlushCookieStore(mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+            base::BindOnce(&StateRestore::Finish, base::Unretained(this))));
+  }
+
+  void Finish() {
+    base::ListValue* applied = json_.FindList("applied");
+    if (applied && history_chosen_) {
+      applied->Append(kSectionHistory);
+    }
+    if (applied && cookies_chosen_) {
+      applied->Append(kSectionCookies);
+    }
+    json_.Set("history", history_added_);
+    json_.Set("history_refused", history_refused_);
+    json_.Set("cookies", cookies_set_);
+    json_.Set("cookies_there", cookies_there_ + cookies_expired_);
+    json_.Set("cookies_refused", cookies_refused_);
+    if (base::DictValue* receipt = json_.FindDict("receipt")) {
+      // Java fills in the tabs it reopened.
+      receipt->Set("tabs", 0);
+      receipt->Set("history", history_added_);
+      // Cookies already here and ones that expired on the way count as
+      // arrived, so ordinary timing can't block a Move.
+      receipt->Set("cookies", cookies_set_ + cookies_there_ + cookies_expired_);
+    }
+    Done done = std::move(done_);
+    base::DictValue json = std::move(json_);
+    delete this;
+    std::move(done).Run(std::move(json));
+  }
+
+  base::WeakPtr<Profile> profile_;
+  base::DictValue json_;
+  Done done_;
+  bool history_chosen_ = false;
+  bool cookies_chosen_ = false;
+  std::vector<HistoryRow> history_;
+  std::vector<std::unique_ptr<net::CanonicalCookie>> cookies_;
+  int history_added_ = 0;
+  int history_refused_ = 0;
+  int cookies_set_ = 0;
+  int cookies_there_ = 0;
+  int cookies_expired_ = 0;
+  int cookies_refused_ = 0;
+  int pending_ = 0;
+};

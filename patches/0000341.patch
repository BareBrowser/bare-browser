index 00000000000..d9fe5f40834
--- /dev/null
+++ b/chrome/browser/bare/backup/backup_state.h
@@ -0,0 +1,112 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_BARE_BACKUP_BACKUP_STATE_H_
+#define CHROME_BROWSER_BARE_BACKUP_BACKUP_STATE_H_
+
+#include <stddef.h>
+
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "base/time/time.h"
+#include "chrome/browser/bare/backup/backup_package.h"
+#include "net/cookies/canonical_cookie.h"
+#include "url/gurl.h"
+
+// The parts of a full backup that are the browsing session itself: open tabs,
+// history and cookies. Kept apart from the rest so a setup package never has
+// them, and read with stricter checks, since they can sign the user in or
+// show them pages.
+//
+//   state/tabs.json            the tabs, as Java collected them
+//   state/history/0000.jsonl   one row per line: [url, title, last visit
+//                              (ms since 1970), visits, typed]
+//   state/cookies/0000.jsonl   one cookie per line, as a JSON object
+namespace bare::backup {
+
+inline constexpr char kSectionTabs[] = "tabs";
+inline constexpr char kSectionHistory[] = "history";
+inline constexpr char kSectionCookies[] = "cookies";
+inline constexpr char kStatePrefix[] = "state/";
+
+inline constexpr size_t kMaxStateTabs = 2000;
+inline constexpr size_t kMaxHistoryRows = 50000;
+inline constexpr size_t kHistoryRowsPerShard = 5000;
+inline constexpr size_t kMaxStateCookies = 10000;
+inline constexpr size_t kCookiesPerShard = 2000;
+inline constexpr int kHistoryDays = 90;
+// The three together, unpacked. Older history goes first, then cookies.
+inline constexpr size_t kStateBudget = 20 * 1024 * 1024;
+
+struct HistoryRow {
+  GURL url;
+  std::string title;
+  base::Time last_visit;
+  int visit_count = 1;
+  int typed_count = 0;
+};
+
+// What the browser had when the backup was made.
+struct CollectedState {
+  CollectedState();
+  CollectedState(CollectedState&&);
+  CollectedState& operator=(CollectedState&&);
+  ~CollectedState();
+
+  // From Java: {"tabs": [...], "groups": [...]}. Checked again here.
+  std::string tabs_json;
+  std::vector<HistoryRow> history;
+  std::vector<net::CanonicalCookie> cookies;
+  // The user's "Include signed-in sessions".
+  bool include_cookies = true;
+};
+
+struct StateWriteResult {
+  int tabs = 0;
+  int history = 0;
+  int cookies = 0;
+};
+
+// Adds the state entries to a full package, within kStateBudget. Appends the
+// section names it wrote to `sections`.
+bool AddState(PackageWriter& writer,
+              const CollectedState& state,
+              base::Time now,
+              StateWriteResult& written,
+              std::vector<std::string>& sections);
+
+// The tabs a package carries, checked and in the shape Java restores them
+// from: {"tabs": [{"url" | "ntp", "title", "pinned", "group", "selected"}],
+// "groups": [{"title", "color", "collapsed"}]}. Tabs with an address Bare
+// won't open are dropped and counted in `refused`.
+std::string ReadStateTabs(const Package& package, int& count, int& refused);
+
+// History rows, checked: http and https only, no user name or password,
+// lengths capped, the last visit inside the last 90 days and not in the
+// future, counts clamped. On a phone that already has history, typed counts
+// are zeroed, so a file can't change what the address bar fills in.
+std::vector<HistoryRow> ReadStateHistory(const Package& package,
+                                         base::Time now,
+                                         bool phone_has_history,
+                                         int& refused);
+
+// Cookies, checked by Chromium's own rules for stored cookies and some more:
+// the source scheme agrees with Secure, no IP address or bare suffix as the
+// domain, times not in the future, expiry at most 400 days ahead, and
+// expired ones dropped and counted in `expired`.
+std::vector<std::unique_ptr<net::CanonicalCookie>> ReadStateCookies(
+    const Package& package,
+    base::Time now,
+    int& refused,
+    int& expired);
+
+// One line each, for tests and the shards.
+std::string HistoryRowToJsonLine(const HistoryRow& row);
+std::string CookieToJsonLine(const net::CanonicalCookie& cookie);
+
+}  // namespace bare::backup
+
+#endif  // CHROME_BROWSER_BARE_BACKUP_BACKUP_STATE_H_
diff --git a/chrome/browser/bare/backup/backup_state_unittest.cc b/chrome/browser/bare/backup/backup_state_unittest.cc
new file mode 100644
index 00000000000..211356d39b6
--- /dev/null
+++ b/chrome/browser/bare/backup/backup_state_unittest.cc
@@ -0,0 +1,272 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/bare/backup/backup_state.h"
+
+#include <string>
+#include <vector>
+
+#include "base/json/json_reader.h"
+#include "base/json/json_writer.h"
+#include "base/values.h"
+#include "net/cookies/cookie_partition_key.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace bare::backup {
+namespace {
+
+const base::Time kNow = base::Time::FromSecondsSinceUnixEpoch(1'762'950'000);
+
+Package Packed(const CollectedState& state, StateWriteResult& written) {
+  PackageWriter writer;
+  std::vector<std::string> sections;
+  EXPECT_TRUE(AddState(writer, state, kNow, written, sections));
+  auto package = ReadPackage(writer.Finish());
+  EXPECT_TRUE(package.has_value());
+  return package.has_value() ? *package : Package();
+}
+
+HistoryRow Row(const std::string& url, int days_ago, int visits = 3,
+               int typed = 2) {
+  HistoryRow row;
+  row.url = GURL(url);
+  row.title = "Title of " + url;
+  row.last_visit = kNow - base::Days(days_ago);
+  row.visit_count = visits;
+  row.typed_count = typed;
+  return row;
+}
+
+std::unique_ptr<net::CanonicalCookie> Cookie(
+    const std::string& name,
+    const std::string& domain,
+    bool secure,
+    bool httponly,
+    net::CookieSameSite same_site,
+    base::Time expiry,
+    std::optional<net::CookiePartitionKey> partition = std::nullopt) {
+  return net::CanonicalCookie::CreateUnsafeCookieForTesting(
+      name, "value-" + name, domain, "/", kNow - base::Days(10), expiry,
+      kNow - base::Days(1), kNow - base::Days(1), secure, httponly, same_site,
+      net::COOKIE_PRIORITY_DEFAULT, net::CookieSourceType::kHTTP, partition,
+      secure ? net::CookieSourceScheme::kSecure
+             : net::CookieSourceScheme::kNonSecure,
+      secure ? 443 : 80);
+}
+
+TEST(BackupStateTest, HistoryRoundTrip) {
+  CollectedState state;
+  state.history = {Row("https://a.example/one", 1),
+                   Row("http://b.example/two", 30, 7, 1)};
+  StateWriteResult written;
+  Package package = Packed(state, written);
+  EXPECT_EQ(written.history, 2);
+  EXPECT_TRUE(package.contains("state/history/0000.jsonl"));
+  int refused = -1;
+  std::vector<HistoryRow> rows =
+      ReadStateHistory(package, kNow, /*phone_has_history=*/false, refused);
+  EXPECT_EQ(refused, 0);
+  ASSERT_EQ(rows.size(), 2u);
+  EXPECT_EQ(rows[0].url, GURL("https://a.example/one"));
+  EXPECT_EQ(rows[0].title, "Title of https://a.example/one");
+  EXPECT_EQ(rows[1].visit_count, 7);
+  EXPECT_EQ(rows[1].typed_count, 1);
+}
+
+TEST(BackupStateTest, HistoryChecks) {
+  CollectedState state;
+  state.history = {Row("javascript:alert(1)", 1), Row("file:///sdcard/x", 1),
+                   Row("https://user:pw@a.example/", 1),
+                   Row("https://old.example/", 120),
+                   Row("https://ok.example/", 2, 999999, 999)};
+  StateWriteResult written;
+  Package package = Packed(state, written);
+  // Bad rows don't even go in.
+  EXPECT_EQ(written.history, 1);
+  int refused = 0;
+  std::vector<HistoryRow> rows =
+      ReadStateHistory(package, kNow, false, refused);
+  ASSERT_EQ(rows.size(), 1u);
+  EXPECT_EQ(rows[0].visit_count, 10000);
+  EXPECT_EQ(rows[0].typed_count, 10);
+  // On a phone with its own history, typed counts are zeroed.
+  rows = ReadStateHistory(package, kNow, true, refused);
+  ASSERT_EQ(rows.size(), 1u);
+  EXPECT_EQ(rows[0].typed_count, 0);
+}
+
+TEST(BackupStateTest, HistoryFromAHostileFile) {
+  Package package;
+  package["state/history/0000.jsonl"] =
+      "[\"https://future.example/\",\"t\",9999999999999,3,9]\n"
+      "not json\n"
+      "[\"javascript:alert(1)\",\"t\",1762900000000,1,1]\n"
+      "[\"https://a.example/\",\"t\",1762900000000]\n"
+      "[\"https://old.example/\",\"t\",1000,1,1]\n";
+  int refused = 0;
+  std::vector<HistoryRow> rows =
+      ReadStateHistory(package, kNow, false, refused);
+  ASSERT_EQ(rows.size(), 1u);
+  EXPECT_EQ(rows[0].last_visit, kNow);  // a time in the future becomes now
+  EXPECT_EQ(rows[0].typed_count, 3);    // never more than the visits
+  EXPECT_EQ(refused, 4);
+}
+
+TEST(BackupStateTest, CookiesRoundTrip) {
+  CollectedState state;
+  state.cookies.push_back(*Cookie("sid", ".site.example", true, true,
+                                  net::CookieSameSite::NO_RESTRICTION,
+                                  kNow + base::Days(30)));
+  state.cookies.push_back(*Cookie("lax", "site.example", false, false,
+                                  net::CookieSameSite::LAX_MODE,
+                                  base::Time()));  // a session cookie
+  state.cookies.push_back(*Cookie(
+      "part", "embed.example", true, false, net::CookieSameSite::NO_RESTRICTION,
+      kNow + base::Days(5),
+      net::CookiePartitionKey::FromURLForTesting(GURL("https://top.example"))));
+  StateWriteResult written;
+  Package package = Packed(state, written);
+  EXPECT_EQ(written.cookies, 3);
+  int refused = -1;
+  int expired = -1;
+  auto cookies = ReadStateCookies(package, kNow, refused, expired);
+  EXPECT_EQ(refused, 0);
+  EXPECT_EQ(expired, 0);
+  ASSERT_EQ(cookies.size(), 3u);
+  for (const auto& cookie : cookies) {
+    if (cookie->Name() == "sid") {
+      EXPECT_TRUE(cookie->SecureAttribute());
+      EXPECT_TRUE(cookie->IsHttpOnly());
+      EXPECT_EQ(cookie->SameSite(), net::CookieSameSite::NO_RESTRICTION);
+      EXPECT_EQ(cookie->ExpiryDate(), kNow + base::Days(30));
+    } else if (cookie->Name() == "lax") {
+      EXPECT_FALSE(cookie->IsPersistent());
+    } else {
+      ASSERT_TRUE(cookie->PartitionKey());
+      EXPECT_EQ(cookie->PartitionKey()->site(),
+                net::SchemefulSite(GURL("https://top.example")));
+    }
+  }
+}
+
+TEST(BackupStateTest, CookiesNotWorthRestoring) {
+  CollectedState state;
+  // Expired already, an IP address, a bare suffix.
+  state.cookies.push_back(*Cookie("old", "site.example", true, false,
+                                  net::CookieSameSite::LAX_MODE,
+                                  kNow - base::Days(1)));
+  state.cookies.push_back(*Cookie("ip", "192.168.1.1", false, false,
+                                  net::CookieSameSite::LAX_MODE,
+                                  kNow + base::Days(1)));
+  state.cookies.push_back(*Cookie("tld", ".com", false, false,
+                                  net::CookieSameSite::LAX_MODE,
+                                  kNow + base::Days(1)));
+  state.cookies.push_back(*Cookie("ok", "site.example", false, false,
+                                  net::CookieSameSite::LAX_MODE,
+                                  kNow + base::Days(1)));
+  StateWriteResult written;
+  Packed(state, written);
+  EXPECT_EQ(written.cookies, 1);
+
+  state.include_cookies = false;
+  Package without = Packed(state, written);
+  EXPECT_EQ(written.cookies, 0);
+  EXPECT_FALSE(without.contains("state/cookies/0000.jsonl"));
+}
+
+TEST(BackupStateTest, CookiesFromAHostileFile) {
+  CollectedState state;
+  state.cookies.push_back(*Cookie("sid", "site.example", true, true,
+                                  net::CookieSameSite::NO_RESTRICTION,
+                                  kNow + base::Days(30)));
+  StateWriteResult written;
+  Package package = Packed(state, written);
+  std::string good = package["state/cookies/0000.jsonl"];
+  std::optional<base::DictValue> base = base::JSONReader::ReadDict(good, base::JSON_PARSE_RFC);
+  ASSERT_TRUE(base);
+  const auto line = [&](const std::string& key, base::Value value) {
+    base::DictValue copy = base->Clone();
+    copy.Set(key, std::move(value));
+    return *base::WriteJson(copy) + "\n";
+  };
+  Package hostile;
+  hostile["state/cookies/0000.jsonl"] =
+      // Secure, but said to come from http.
+      line("source_scheme", base::Value(1)) +
+      // An immortal cookie is cut to 400 days.
+      line("expiry", base::Value("99999999999999999")) +
+      // __Host- may not be set for a whole domain.
+      [&] {
+        base::DictValue copy = base->Clone();
+        copy.Set("name", "__Host-x");
+        copy.Set("domain", ".site.example");
+        return *base::WriteJson(copy) + "\n";
+      }() +
+      // SameSite=None without Secure.
+      line("secure", base::Value(false)) +
+      "{\"name\":\"bad\"}\n";
+  int refused = 0;
+  int expired = 0;
+  auto cookies = ReadStateCookies(hostile, kNow, refused, expired);
+  for (const auto& cookie : cookies) {
+    EXPECT_FALSE(cookie->Name().starts_with("__Host-")) << cookie->Domain();
+    EXPECT_TRUE(cookie->SecureAttribute()) << cookie->Name();
+  }
+  ASSERT_EQ(cookies.size(), 1u);
+  EXPECT_LE(cookies[0]->ExpiryDate(), kNow + base::Days(400));
+  EXPECT_EQ(refused, 4);
+
+  // Expired on the way: not restored, counted apart from the refused ones.
+  cookies = ReadStateCookies(package, kNow + base::Days(31), refused, expired);
+  EXPECT_TRUE(cookies.empty());
+  EXPECT_EQ(refused, 0);
+  EXPECT_EQ(expired, 1);
+}
+
+TEST(BackupStateTest, Tabs) {
+  CollectedState state;
+  state.tabs_json = R"j({
+    "tabs": [
+      {"url": "https://a.example/", "title": "A", "pinned": true,
+       "group": 0, "selected": true},
+      {"ntp": true, "title": ""},
+      {"url": "javascript:alert(1)", "title": "x"},
+      {"url": "file:///sdcard/a", "title": "x"},
+      {"url": "https://user:pw@b.example/", "title": "x"},
+      {"url": "https://c.example/", "title": "C", "group": 7,
+       "selected": true}
+    ],
+    "groups": [{"title": "Work", "color": 99, "collapsed": true}]
+  })j";
+  StateWriteResult written;
+  Package package = Packed(state, written);
+  EXPECT_EQ(written.tabs, 3);
+  int count = 0, refused = 0;
+  std::optional<base::DictValue> tabs =
+      base::JSONReader::ReadDict(ReadStateTabs(package, count, refused),
+                                 base::JSON_PARSE_RFC);
+  ASSERT_TRUE(tabs);
+  EXPECT_EQ(count, 3);
+  const base::ListValue& list = *tabs->FindList("tabs");
+  EXPECT_EQ(*list[0].GetDict().FindString("url"), "https://a.example/");
+  EXPECT_EQ(list[0].GetDict().FindBool("pinned"), true);
+  EXPECT_EQ(list[0].GetDict().FindInt("group"), 0);
+  EXPECT_EQ(list[1].GetDict().FindBool("ntp"), true);
+  // A group that doesn't exist, and a second selected tab.
+  EXPECT_EQ(list[2].GetDict().FindInt("group"), -1);
+  EXPECT_EQ(list[2].GetDict().FindBool("selected"), false);
+  EXPECT_EQ((*tabs->FindList("groups"))[0].GetDict().FindInt("color"), 8);
+}
+
+TEST(BackupStateTest, NothingWhenEmpty) {
+  CollectedState state;
+  StateWriteResult written;
+  Package package = Packed(state, written);
+  for (const auto& [name, contents] : package) {
+    EXPECT_FALSE(name.starts_with(kStatePrefix)) << name;
+  }
+}
+
+}  // namespace
+}  // namespace bare::backup

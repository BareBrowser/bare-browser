+constexpr char kStateTabs[] = "state/tabs.json";
+constexpr char kStateHistoryPrefix[] = "state/history/";
+constexpr char kStateCookiesPrefix[] = "state/cookies/";
+constexpr size_t kMaxJsonDepth = 6;
+constexpr size_t kMaxTabUrl = 4096;
+constexpr size_t kMaxHistoryUrl = 2048;
+constexpr size_t kMaxTitleBytes = 1024;
+constexpr size_t kMaxGroupTitleBytes = 256;
+constexpr int kMaxGroups = 200;
+constexpr int kMaxGroupColor = 8;
+constexpr int kMaxVisitCount = 10000;
+constexpr int kMaxTypedCount = 10;
+constexpr size_t kMaxCookieNameValue = 4096;
+constexpr size_t kMaxCookieDomainPath = 256;
+constexpr base::TimeDelta kMaxCookieAge = base::Days(400);
+
+std::string Cut(const std::string& text, size_t bytes) {
+  std::string out;
+  base::TruncateUTF8ToByteSize(text, bytes, &out);
+  return out;
+}
+
+// http or https, valid, no user name or password, not too long.
+bool IsRestorableUrl(const GURL& url, size_t max_length) {
+  return url.is_valid() && url.SchemeIsHTTPOrHTTPS() && !url.has_username() &&
+         !url.has_password() && url.spec().size() <= max_length;
+}
+
+std::vector<std::string> ShardNames(const Package& package,
+                                    std::string_view prefix) {
+  std::vector<std::string> names;
+  for (const auto& [name, contents] : package) {
+    if (name.starts_with(prefix) && name.ends_with(".jsonl")) {
+      names.push_back(name);
+    }
+  }
+  return names;  // A std::map is already in name order.
+}
+
+std::string TimeString(base::Time time) {
+  return base::NumberToString(
+      time.ToDeltaSinceWindowsEpoch().InMicroseconds());
+}
+
+std::optional<base::Time> TimeFrom(const base::DictValue& dict,
+                                   std::string_view key) {
+  const std::string* text = dict.FindString(key);
+  int64_t micros = 0;
+  if (!text || !base::StringToInt64(*text, &micros) || micros < 0) {
+    return std::nullopt;
+  }
+  return base::Time::FromDeltaSinceWindowsEpoch(base::Microseconds(micros));
+}
+
+// The tabs, checked, in the shape Java restores them from.
+base::DictValue CheckTabs(const base::DictValue& in, int& count, int& refused) {
+  base::ListValue groups_out;
+  const base::ListValue* groups = in.FindList("groups");
+  int group_count = 0;
+  for (size_t i = 0; groups && i < groups->size() && group_count < kMaxGroups;
+       ++i) {
+    const base::DictValue* group = (*groups)[i].GetIfDict();
+    base::DictValue out;
+    const std::string* title = group ? group->FindString("title") : nullptr;
+    out.Set("title", title ? Cut(*title, kMaxGroupTitleBytes) : std::string());
+    int color = group ? group->FindInt("color").value_or(0) : 0;
+    out.Set("color", std::clamp(color, 0, kMaxGroupColor));
+    out.Set("collapsed",
+            group ? group->FindBool("collapsed").value_or(false) : false);
+    groups_out.Append(std::move(out));
+    ++group_count;
+  }
+
+  base::ListValue tabs_out;
+  bool selected_seen = false;
+  const base::ListValue* tabs = in.FindList("tabs");
+  for (size_t i = 0; tabs && i < tabs->size(); ++i) {
+    const base::DictValue* tab = (*tabs)[i].GetIfDict();
+    if (!tab) {
+      ++refused;
+      continue;
+    }
+    if (tabs_out.size() >= kMaxStateTabs) {
+      ++refused;
+      continue;
+    }
+    base::DictValue out;
+    if (tab->FindBool("ntp").value_or(false)) {
+      out.Set("ntp", true);
+    } else {
+      const std::string* url = tab->FindString("url");
+      const GURL gurl(url ? *url : std::string());
+      if (!url || url->size() > kMaxTabUrl || !IsRestorableUrl(gurl, kMaxTabUrl)) {
+        ++refused;
+        continue;
+      }
+      out.Set("url", gurl.spec());
+    }
+    const std::string* title = tab->FindString("title");
+    out.Set("title", title ? Cut(*title, kMaxTitleBytes) : std::string());
+    out.Set("pinned", tab->FindBool("pinned").value_or(false));
+    int group = tab->FindInt("group").value_or(-1);
+    out.Set("group", group >= 0 && group < group_count ? group : -1);
+    const bool selected = tab->FindBool("selected").value_or(false);
+    out.Set("selected", selected && !selected_seen);
+    selected_seen = selected_seen || selected;
+    tabs_out.Append(std::move(out));
+  }
+  count = static_cast<int>(tabs_out.size());
+  base::DictValue result;
+  result.Set("tabs", std::move(tabs_out));
+  result.Set("groups", std::move(groups_out));
+  return result;
+}
+
+std::optional<HistoryRow> CheckHistoryRow(const HistoryRow& in,
+                                          base::Time now) {
+  if (!IsRestorableUrl(in.url, kMaxHistoryUrl)) {
+    return std::nullopt;
+  }
+  HistoryRow row = in;
+  if (row.last_visit > now) {
+    row.last_visit = now;
+  }
+  if (row.last_visit.is_null() || row.last_visit < now - base::Days(kHistoryDays)) {
+    return std::nullopt;
+  }
+  row.title = Cut(row.title, kMaxTitleBytes);
+  row.visit_count = std::clamp(row.visit_count, 1, kMaxVisitCount);
+  row.typed_count =
+      std::clamp(row.typed_count, 0, std::min(row.visit_count, kMaxTypedCount));
+  return row;
+}
+
+bool CookieIsRestorable(const net::CanonicalCookie& cookie) {
+  if (cookie.Name().size() + cookie.Value().size() > kMaxCookieNameValue ||
+      cookie.Domain().size() > kMaxCookieDomainPath ||
+      cookie.Path().size() > kMaxCookieDomainPath) {
+    return false;
+  }
+  const net::CookieSourceScheme scheme = cookie.SourceScheme();
+  if (scheme != net::CookieSourceScheme::kSecure &&
+      scheme != net::CookieSourceScheme::kNonSecure) {
+    return false;
+  }
+  if (cookie.SecureAttribute() &&
+      scheme != net::CookieSourceScheme::kSecure) {
+    return false;
+  }
+  // Chromium refuses these when they are set; refusing them here keeps the
+  // counts true.
+  if (cookie.SameSite() == net::CookieSameSite::NO_RESTRICTION &&
+      !cookie.SecureAttribute()) {
+    return false;
+  }
+  std::string_view host = cookie.Domain();
+  if (host.starts_with('.')) {
+    host.remove_prefix(1);
+  }
+  if (host.empty() || url::HostIsIPAddress(host)) {
+    return false;
+  }
+  // A real registrable domain: not "com", "co.uk" or "localhost".
+  return !net::registry_controlled_domains::GetDomainAndRegistry(
+              host, net::registry_controlled_domains::INCLUDE_PRIVATE_REGISTRIES)
+              .empty();
+}

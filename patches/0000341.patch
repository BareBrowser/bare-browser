+}  // namespace
+
+CollectedState::CollectedState() = default;
+CollectedState::CollectedState(CollectedState&&) = default;
+CollectedState& CollectedState::operator=(CollectedState&&) = default;
+CollectedState::~CollectedState() = default;
+
+std::string HistoryRowToJsonLine(const HistoryRow& row) {
+  base::ListValue line;
+  line.Append(row.url.spec());
+  line.Append(row.title);
+  line.Append(static_cast<double>(row.last_visit.InMillisecondsSinceUnixEpoch()));
+  line.Append(row.visit_count);
+  line.Append(row.typed_count);
+  return base::WriteJson(line).value_or(std::string());
+}
+
+std::string CookieToJsonLine(const net::CanonicalCookie& cookie) {
+  base::expected<net::CookiePartitionKey::SerializedCookiePartitionKey,
+                 std::string>
+      partition = net::CookiePartitionKey::Serialize(cookie.PartitionKey());
+  if (!partition.has_value()) {
+    return std::string();
+  }
+  base::DictValue line;
+  line.Set("name", cookie.Name());
+  line.Set("value", cookie.Value());
+  line.Set("domain", cookie.Domain());
+  line.Set("path", cookie.Path());
+  line.Set("creation", TimeString(cookie.CreationDate()));
+  line.Set("expiry", TimeString(cookie.ExpiryDate()));
+  line.Set("last_access", TimeString(cookie.LastAccessDate()));
+  line.Set("last_update", TimeString(cookie.LastUpdateDate()));
+  line.Set("secure", cookie.SecureAttribute());
+  line.Set("httponly", cookie.IsHttpOnly());
+  line.Set("samesite", static_cast<int>(cookie.SameSite()));
+  line.Set("priority", static_cast<int>(cookie.Priority()));
+  line.Set("partition", partition->TopLevelSite());
+  line.Set("cross_site_ancestor", partition->has_cross_site_ancestor());
+  line.Set("source_scheme", static_cast<int>(cookie.SourceScheme()));
+  line.Set("source_port", cookie.SourcePort());
+  line.Set("source_type", static_cast<int>(cookie.SourceType()));
+  return base::WriteJson(line).value_or(std::string());
+}
+
+bool AddState(PackageWriter& writer,
+              const CollectedState& state,
+              base::Time now,
+              StateWriteResult& written,
+              std::vector<std::string>& sections) {
+  size_t budget = kStateBudget;
+
+  // Tabs first: small, and what the user notices most.
+  if (!state.tabs_json.empty()) {
+    std::optional<base::DictValue> tabs = base::JSONReader::ReadDict(
+        state.tabs_json, base::JSON_PARSE_RFC, kMaxJsonDepth);
+    if (tabs) {
+      int count = 0, refused = 0;
+      std::optional<std::string> text =
+          base::WriteJson(CheckTabs(*tabs, count, refused));
+      if (text && count > 0 && text->size() <= budget &&
+          writer.Add(kStateTabs, *text)) {
+        budget -= text->size();
+        written.tabs = count;
+        sections.push_back(kSectionTabs);
+      }
+    }
+  }
+
+  // History, newest first, so trimming to the budget drops the oldest.
+  std::vector<HistoryRow> rows;
+  for (const HistoryRow& row : state.history) {
+    if (std::optional<HistoryRow> checked = CheckHistoryRow(row, now)) {
+      rows.push_back(std::move(*checked));
+    }
+  }
+  std::ranges::sort(rows, [](const HistoryRow& a, const HistoryRow& b) {
+    return a.last_visit > b.last_visit;
+  });
+  if (rows.size() > kMaxHistoryRows) {
+    rows.resize(kMaxHistoryRows);
+  }
+  // Cookies, most recently used first.
+  std::vector<std::string> cookie_lines;
+  if (state.include_cookies) {
+    std::vector<const net::CanonicalCookie*> cookies;
+    for (const net::CanonicalCookie& cookie : state.cookies) {
+      if (!cookie.IsExpired(now) && CookieIsRestorable(cookie)) {
+        cookies.push_back(&cookie);
+      }
+    }
+    std::ranges::sort(cookies, [](const net::CanonicalCookie* a,
+                                  const net::CanonicalCookie* b) {
+      return a->LastAccessDate() > b->LastAccessDate();
+    });
+    for (const net::CanonicalCookie* cookie : cookies) {
+      if (cookie_lines.size() >= kMaxStateCookies) {
+        break;
+      }
+      std::string line = CookieToJsonLine(*cookie);
+      if (!line.empty()) {
+        cookie_lines.push_back(std::move(line));
+      }
+    }
+  }
+  std::vector<std::string> history_lines;
+  for (const HistoryRow& row : rows) {
+    history_lines.push_back(HistoryRowToJsonLine(row));
+  }
+
+  // Fit both into what is left: history gives way first, then cookies.
+  size_t total = 0;
+  for (const std::string& line : history_lines) total += line.size() + 1;
+  for (const std::string& line : cookie_lines) total += line.size() + 1;
+  while (total > budget && !history_lines.empty()) {
+    total -= history_lines.back().size() + 1;
+    history_lines.pop_back();
+  }
+  while (total > budget && !cookie_lines.empty()) {
+    total -= cookie_lines.back().size() + 1;
+    cookie_lines.pop_back();
+  }
+
+  const auto write_shards = [&](const std::vector<std::string>& lines,
+                                const char* prefix, size_t per_shard) {
+    int count = 0;
+    for (size_t start = 0; start < lines.size(); start += per_shard) {
+      std::string shard;
+      const size_t end = std::min(lines.size(), start + per_shard);
+      for (size_t i = start; i < end; ++i) {
+        shard += lines[i];
+        shard += '\n';
+      }
+      const std::string name =
+          base::StringPrintf("%s%04zu.jsonl", prefix, start / per_shard);
+      if (!writer.Add(name, shard)) {
+        break;
+      }
+      count += static_cast<int>(end - start);
+    }
+    return count;
+  };
+  written.history =
+      write_shards(history_lines, kStateHistoryPrefix, kHistoryRowsPerShard);
+  if (written.history > 0) {
+    sections.push_back(kSectionHistory);
+  }
+  written.cookies =
+      write_shards(cookie_lines, kStateCookiesPrefix, kCookiesPerShard);
+  if (written.cookies > 0) {
+    sections.push_back(kSectionCookies);
+  }
+  return true;
+}
+
+std::string ReadStateTabs(const Package& package, int& count, int& refused) {
+  count = 0;
+  refused = 0;
+  auto it = package.find(kStateTabs);
+  if (it == package.end()) {
+    return std::string();
+  }
+  std::optional<base::DictValue> tabs = base::JSONReader::ReadDict(
+      it->second, base::JSON_PARSE_RFC, kMaxJsonDepth);
+  if (!tabs) {
+    return std::string();
+  }
+  return base::WriteJson(CheckTabs(*tabs, count, refused))
+      .value_or(std::string());
+}
+
+std::vector<HistoryRow> ReadStateHistory(const Package& package,
+                                         base::Time now,
+                                         bool phone_has_history,
+                                         int& refused) {
+  refused = 0;
+  std::vector<HistoryRow> rows;
+  for (const std::string& name : ShardNames(package, kStateHistoryPrefix)) {
+    for (std::string_view line :
+         base::SplitStringPiece(package.at(name), "\n", base::KEEP_WHITESPACE,
+                                base::SPLIT_WANT_NONEMPTY)) {
+      if (rows.size() >= kMaxHistoryRows) {
+        ++refused;
+        continue;
+      }
+      std::optional<base::Value> value =
+          base::JSONReader::Read(line, base::JSON_PARSE_RFC, kMaxJsonDepth);
+      const base::ListValue* list = value ? value->GetIfList() : nullptr;
+      if (!list || list->size() != 5 || !(*list)[0].is_string() ||
+          !(*list)[1].is_string() ||
+          !((*list)[2].is_double() || (*list)[2].is_int()) ||
+          !(*list)[3].is_int() || !(*list)[4].is_int()) {
+        ++refused;
+        continue;
+      }
+      HistoryRow row;
+      row.url = GURL((*list)[0].GetString());
+      row.title = (*list)[1].GetString();
+      row.last_visit =
+          base::Time::FromMillisecondsSinceUnixEpoch((*list)[2].GetDouble());
+      row.visit_count = (*list)[3].GetInt();
+      row.typed_count = phone_has_history ? 0 : (*list)[4].GetInt();
+      std::optional<HistoryRow> checked = CheckHistoryRow(row, now);
+      if (!checked) {
+        ++refused;
+        continue;
+      }
+      rows.push_back(std::move(*checked));
+    }
+  }
+  return rows;
+}
+
+std::vector<std::unique_ptr<net::CanonicalCookie>> ReadStateCookies(
+    const Package& package,
+    base::Time now,
+    int& refused,
+    int& expired) {
+  refused = 0;
+  expired = 0;
+  std::vector<std::unique_ptr<net::CanonicalCookie>> cookies;
+  for (const std::string& name : ShardNames(package, kStateCookiesPrefix)) {
+    for (std::string_view line :
+         base::SplitStringPiece(package.at(name), "\n", base::KEEP_WHITESPACE,
+                                base::SPLIT_WANT_NONEMPTY)) {
+      if (cookies.size() >= kMaxStateCookies) {
+        ++refused;
+        continue;
+      }
+      std::optional<base::DictValue> dict = base::JSONReader::ReadDict(
+          line, base::JSON_PARSE_RFC, kMaxJsonDepth);
+      const std::string* cookie_name = dict ? dict->FindString("name") : nullptr;
+      const std::string* value = dict ? dict->FindString("value") : nullptr;
+      const std::string* domain = dict ? dict->FindString("domain") : nullptr;
+      const std::string* path = dict ? dict->FindString("path") : nullptr;
+      const std::string* partition =
+          dict ? dict->FindString("partition") : nullptr;
+      std::optional<base::Time> creation, expiry, last_access, last_update;
+      if (dict) {
+        creation = TimeFrom(*dict, "creation");
+        expiry = TimeFrom(*dict, "expiry");
+        last_access = TimeFrom(*dict, "last_access");
+        last_update = TimeFrom(*dict, "last_update");
+      }
+      if (!cookie_name || !value || !domain || !path || !partition ||
+          !creation || !expiry || !last_access || !last_update) {
+        ++refused;
+        continue;
+      }
+      if (!expiry->is_null() && *expiry <= now) {
+        // Expired since the backup was made: nothing to restore.
+        ++expired;
+        continue;
+      }
+      std::optional<net::CookiePartitionKey> key;
+      if (!partition->empty()) {
+        base::expected<std::optional<net::CookiePartitionKey>, std::string>
+            from = net::CookiePartitionKey::FromStorage(
+                *partition,
+                dict->FindBool("cross_site_ancestor").value_or(true));
+        if (!from.has_value() || !from->has_value()) {
+          ++refused;
+          continue;
+        }
+        key = **from;
+      }
+      const int same_site = dict->FindInt("samesite").value_or(-99);
+      const int priority = dict->FindInt("priority").value_or(-99);
+      const int source_scheme = dict->FindInt("source_scheme").value_or(-99);
+      const int source_type = dict->FindInt("source_type").value_or(-99);
+      if (same_site < static_cast<int>(net::CookieSameSite::UNSPECIFIED) ||
+          same_site > static_cast<int>(net::CookieSameSite::STRICT_MODE) ||
+          priority < net::COOKIE_PRIORITY_LOW ||
+          priority > net::COOKIE_PRIORITY_HIGH || source_scheme < 0 ||
+          source_scheme > static_cast<int>(net::CookieSourceScheme::kSecure) ||
+          source_type < static_cast<int>(net::CookieSourceType::kHTTP) ||
+          source_type > static_cast<int>(net::CookieSourceType::kMaxValue)) {
+        ++refused;
+        continue;
+      }
+      // Chromium allows at most 400 days from when a cookie was made.
+      const base::Time made = std::min(*creation, now);
+      std::unique_ptr<net::CanonicalCookie> cookie =
+          net::CanonicalCookie::FromStorage(
+              *cookie_name, *value, *domain, *path, made,
+              expiry->is_null() ? base::Time()
+                                : std::min(*expiry, made + kMaxCookieAge),
+              std::min(*last_access, now), std::min(*last_update, now),
+              dict->FindBool("secure").value_or(false),
+              dict->FindBool("httponly").value_or(false),
+              static_cast<net::CookieSameSite>(same_site),
+              static_cast<net::CookiePriority>(priority), key,
+              static_cast<net::CookieSourceScheme>(source_scheme),
+              dict->FindInt("source_port").value_or(url::PORT_UNSPECIFIED),
+              static_cast<net::CookieSourceType>(source_type),
+              net::CanonicalCookieFromStorageCallSite::
+                  kAndroidCookiesFetcherRestoreUtil);
+      if (!cookie || !cookie->IsCanonical() || !CookieIsRestorable(*cookie)) {
+        ++refused;
+        continue;
+      }
+      cookies.push_back(std::move(cookie));
+    }
+  }
+  return cookies;
+}
+
+}  // namespace bare::backup

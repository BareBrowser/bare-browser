From 6a519e373027f76b78276705c77515a9e4641b27 Mon Sep 17 00:00:00 2001
From: Bare <git@barebrowser.org>
Date: Mon, 12 Oct 2026 21:48:13 +0000
Subject: [PATCH] Open Developer tools on phones too

Chromium 156 turns the DevTools frontend on for desktop Android builds, but
DevToolsWindowAndroid.isDevToolsAvailable also requires a tablet-width window,
and the More tools submenu that holds the entry exists only where submenus are
on, which on Bare means tablets. On a phone there was no way in: no menu entry,
no View page source or Inspect in the context menu, and the keyboard shortcuts
did nothing. Upstream gives no reason for the width limit beyond keeping the
entry points consistent.

The width requirement is gone, and the phone menu, which has no submenus, gets
a Developer tools row of its own under the same conditions as the submenu's,
with the code icon Chromium already ships.

The frontend opens in its own full-screen activity, but it declares no
viewport, so a phone's mobile viewport style laid it out 980px wide and shrank
it to about 40%, too small to read. DevTools pages now get the default viewport
style tablets already use, which lays a page out at the screen's width, and
the frontend's own narrow layout takes it from there.

Measured on a Pixel 3 in portrait: the menu shows Developer tools on web pages
and not on native ones; the frontend lays out 392 CSS pixels wide at scale 1;
the Elements panel shows the tree with styles below it; the Console evaluates
document.title with the on-screen keyboard; Back closes DevTools and it opens
again. Landscape was not tried.
---
 .../TabbedAppMenuPropertiesDelegate.java      | 18 +++++++++++++++
 .../browser/chrome_content_browser_client.cc  | 22 +++++++++++++++++++
 .../devtools/DevToolsWindowAndroid.java       |  6 ++---
 3 files changed, 43 insertions(+), 3 deletions(-)

diff --git a/chrome/android/java/src/org/chromium/chrome/browser/tabbed_mode/TabbedAppMenuPropertiesDelegate.java b/chrome/android/java/src/org/chromium/chrome/browser/tabbed_mode/TabbedAppMenuPropertiesDelegate.java
index 7a28c7eea16..026dbf3dfdd 100644
--- a/chrome/android/java/src/org/chromium/chrome/browser/tabbed_mode/TabbedAppMenuPropertiesDelegate.java
+++ b/chrome/android/java/src/org/chromium/chrome/browser/tabbed_mode/TabbedAppMenuPropertiesDelegate.java
@@ -539,6 +539,12 @@ public class TabbedAppMenuPropertiesDelegate extends AppMenuPropertiesDelegateIm
             modelList.add(buildListenToFeedItem());
         }
 
+        // Bare: Developer tools. Without submenus there is no More tools to hold it, so the phone
+        // menu gets the entry itself, under the same conditions as the submenu's.
+        if (mMoreToolsItemBuilder.shouldShowDevToolsItem(currentTab)) {
+            modelList.add(buildDevToolsItem(shouldShowIconBeforeItem));
+        }
+
         // Divider Line
         AppMenuItemUtils.maybeAddDividerLine(modelList, R.id.divider_line_id);
 
@@ -1359,6 +1365,18 @@ public class TabbedAppMenuPropertiesDelegate extends AppMenuPropertiesDelegateIm
         return new ListItem(AppMenuHandler.AppMenuItemType.STANDARD, model);
     }
 
+    private ListItem buildDevToolsItem(boolean showIcon) {
+        return new ListItem(
+                AppMenuHandler.AppMenuItemType.STANDARD,
+                AppMenuItemUtils.buildModelForStandardMenuItem(
+                        mContext,
+                        getAppMenuItemTheme(),
+                        R.id.dev_tools,
+                        R.string.menu_dev_tools,
+                        showIcon ? R.drawable.code_24px : Resources.ID_NULL,
+                        isMenuIconAtStart()));
+    }
+
     private ListItem buildExitItem() {
         return new ListItem(
                 AppMenuHandler.AppMenuItemType.STANDARD,
diff --git a/chrome/browser/chrome_content_browser_client.cc b/chrome/browser/chrome_content_browser_client.cc
index 79a62e89029..9a48a6c35f9 100644
--- a/chrome/browser/chrome_content_browser_client.cc
+++ b/chrome/browser/chrome_content_browser_client.cc
@@ -4722,6 +4722,19 @@ bool ShouldReportVisibleForBackgroundMedia(WebContents* web_contents) {
 }  // namespace
 #endif  // BUILDFLAG(IS_ANDROID)
 
+#if BUILDFLAG(IS_ANDROID)
+namespace {
+// Bare: the DevTools frontend declares no viewport, so a phone's mobile
+// viewport style laid it out 980px wide and shrank it to fit, too small to
+// read. It gets the style tablets already use, which lays a page without a
+// viewport out at the screen's width, and its own layout adapts from there.
+bool IsDevToolsFrontend(WebContents* web_contents) {
+  return web_contents->GetPrimaryMainFrame()->GetLastCommittedURL().SchemeIs(
+      content::kChromeDevToolsScheme);
+}
+}  // namespace
+#endif  // BUILDFLAG(IS_ANDROID)
+
 void ChromeContentBrowserClient::OverrideWebPreferences(
     WebContents* web_contents,
     content::SiteInstance& main_frame_site,
@@ -4733,6 +4746,9 @@ void ChromeContentBrowserClient::OverrideWebPreferences(
 #if BUILDFLAG(IS_ANDROID)
   web_prefs->background_media_playback_enabled =
       ShouldReportVisibleForBackgroundMedia(web_contents);
+  if (IsDevToolsFrontend(web_contents)) {
+    web_prefs->viewport_style = blink::mojom::ViewportStyle::kDefault;
+  }
 #endif  // BUILDFLAG(IS_ANDROID)
 
 // Fill font preferences. These are not registered on Android unless we're built
@@ -5119,6 +5135,12 @@ bool ChromeContentBrowserClient::OverrideWebPreferencesAfterNavigation(
   prefs_changed |=
       (web_prefs->background_media_playback_enabled != background_media);
   web_prefs->background_media_playback_enabled = background_media;
+
+  if (IsDevToolsFrontend(web_contents) &&
+      web_prefs->viewport_style != blink::mojom::ViewportStyle::kDefault) {
+    web_prefs->viewport_style = blink::mojom::ViewportStyle::kDefault;
+    prefs_changed = true;
+  }
 #endif  // BUILDFLAG(IS_ANDROID)
 
 #if !BUILDFLAG(IS_ANDROID)
diff --git a/chrome/browser/devtools/android/java/src/org/chromium/chrome/browser/devtools/DevToolsWindowAndroid.java b/chrome/browser/devtools/android/java/src/org/chromium/chrome/browser/devtools/DevToolsWindowAndroid.java
index c96056e2843..a29841dc095 100644
--- a/chrome/browser/devtools/android/java/src/org/chromium/chrome/browser/devtools/DevToolsWindowAndroid.java
+++ b/chrome/browser/devtools/android/java/src/org/chromium/chrome/browser/devtools/DevToolsWindowAndroid.java
@@ -14,7 +14,6 @@ import org.chromium.chrome.browser.profiles.Profile;
 import org.chromium.content_public.browser.ContentFeatureList;
 import org.chromium.content_public.browser.ContentFeatureMap;
 import org.chromium.content_public.browser.WebContents;
-import org.chromium.ui.base.DeviceFormFactor;
 
 /** DevToolsWindowAndroid provides an interface to control DevTools windows. */
 @NullMarked
@@ -24,8 +23,9 @@ public class DevToolsWindowAndroid {
     private DevToolsWindowAndroid() {}
 
     public static boolean isDevToolsAvailable(Context context) {
-        return ContentFeatureMap.isEnabled(ContentFeatureList.ANDROID_DEV_TOOLS_FRONTEND)
-                && DeviceFormFactor.isNonMultiDisplayContextOnTablet(context);
+        // Bare: no tablet requirement. The frontend opens in its own full-screen activity, which
+        // fits a phone as well as a tablet, and upstream gives no other reason for the gate.
+        return ContentFeatureMap.isEnabled(ContentFeatureList.ANDROID_DEV_TOOLS_FRONTEND);
     }
 
     public static boolean isDevToolsAllowedFor(

+blink::UserAgentMetadata BrandedMetadata(const std::string& brand,
+                                         const std::string& platform,
+                                         const std::string& platform_version,
+                                         bool mobile) {
+  const std::string major(version_info::GetMajorVersionNumber());
+  const std::string full(version_info::GetVersionNumber());
+  int seed = 0;
+  base::StringToInt(major, &seed);
+
+  blink::UserAgentMetadata metadata;
+  metadata.brand_version_list = GenerateBrandVersionList(
+      seed, brand, major, blink::UserAgentBrandVersionType::kMajorVersion);
+  metadata.brand_full_version_list = GenerateBrandVersionList(
+      seed, brand, full, blink::UserAgentBrandVersionType::kFullVersion);
+  metadata.full_version = full;
+  metadata.platform = platform;
+  metadata.platform_version = platform_version;
+  metadata.mobile = mobile;
+  if (mobile) {
+    metadata.architecture = GetCpuArchitecture();
+    metadata.bitness = GetCpuBitness();
+    metadata.model = BuildModelInfo();
+  } else {
+    metadata.architecture = "x86";
+    metadata.bitness = "64";
+  }
+  metadata.form_factors = GetFormFactorsClientHint(metadata, mobile);
+  return metadata;
+}
+
+std::optional<UserAgentPreset> GetUserAgentPreset() {
+  const base::CommandLine* command_line =
+      base::CommandLine::ForCurrentProcess();
+  if (!command_line->HasSwitch(kBareUserAgentPreset)) {
+    return std::nullopt;
+  }
+  const std::string id = command_line->GetSwitchValueASCII(kBareUserAgentPreset);
+  const std::string chrome = GetProductAndVersion();
+  const std::string windows_ua =
+      BuildUserAgentFromOSAndProduct("Windows NT 10.0; Win64; x64", chrome);
+
+  if (id == "chrome-android") {
+    return UserAgentPreset{
+        BuildUserAgentFromOSAndProduct("Linux; Android 10; K",
+                                       chrome + " Mobile"),
+        BrandedMetadata("Google Chrome", "Android", GetPlatformVersion(),
+                        /*mobile=*/true)};
+  }
+  if (id == "chrome-linux") {
+    return UserAgentPreset{
+        BuildUserAgentFromOSAndProduct("X11; Linux x86_64", chrome),
+        BrandedMetadata("Google Chrome", "Linux", "", /*mobile=*/false)};
+  }
+  if (id == "chrome-windows") {
+    return UserAgentPreset{windows_ua,
+                           BrandedMetadata("Google Chrome", "Windows", "19.0.0",
+                                           /*mobile=*/false)};
+  }
+  if (id == "chrome-mac") {
+    return UserAgentPreset{
+        BuildUserAgentFromOSAndProduct("Macintosh; Intel Mac OS X 10_15_7",
+                                       chrome),
+        BrandedMetadata("Google Chrome", "macOS", "27.0.1", /*mobile=*/false)};
+  }
+  if (id == "chrome-chromeos") {
+    return UserAgentPreset{
+        BuildUserAgentFromOSAndProduct("X11; CrOS x86_64 14541.0.0", chrome),
+        BrandedMetadata("Google Chrome", "Chrome OS", "14541.0.0",
+                        /*mobile=*/false)};
+  }
+  if (id == "edge-windows") {
+    return UserAgentPreset{
+        base::StrCat({windows_ua, " Edg/",
+                      version_info::GetMajorVersionNumber(), ".0.0.0"}),
+        BrandedMetadata("Microsoft Edge", "Windows", "19.0.0",
+                        /*mobile=*/false)};
+  }
+  if (id == "firefox-windows") {
+    return UserAgentPreset{kFirefoxWindowsUserAgent, std::nullopt};
+  }
+  if (id == "firefox-android") {
+    return UserAgentPreset{kFirefoxAndroidUserAgent, std::nullopt};
+  }
+  if (id == "safari-mac") {
+    return UserAgentPreset{kSafariMacUserAgent, std::nullopt};
+  }
+  if (id == "safari-iphone") {
+    return UserAgentPreset{kSafariIPhoneUserAgent, std::nullopt};
+  }
+  if (id == "custom") {
+    std::string custom =
+        command_line->GetSwitchValueASCII(kBareUserAgentCustom);
+    base::TrimWhitespaceASCII(custom, base::TRIM_ALL, &custom);
+    if (!custom.empty() && net::HttpUtil::IsValidHeaderValue(custom)) {
+      return UserAgentPreset{custom, std::nullopt};
+    }
+    LOG(WARNING) << "Ignored invalid custom user agent";
+  }
+  return std::nullopt;
+}

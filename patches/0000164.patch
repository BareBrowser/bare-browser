+    private String userAgentLabel(String id, String custom) {
+        if (id.equals(UserAgentPresets.CUSTOM)) return custom;
+        return getString(UserAgentPresets.LABELS[UserAgentPresets.indexOf(id)]);
+    }
+
+    private void updateUserAgentSummary() {
+        Preference userAgent = findPreference(UI_PREF_USER_AGENT);
+        if (userAgent == null) return;
+        String saved = UserAgentPresets.getSaved();
+        String savedCustom = UserAgentPresets.getSavedCustom();
+        String label = userAgentLabel(saved, savedCustom);
+        boolean pending =
+                !saved.equals(UserAgentPresets.getActive())
+                        || (saved.equals(UserAgentPresets.CUSTOM)
+                                && !savedCustom.equals(UserAgentPresets.getActiveCustom()));
+        userAgent.setSummary(
+                pending ? getString(R.string.bare_user_agent_after_restart, label) : label);
+    }
+
+    private void showUserAgentChooser() {
+        String[] labels = new String[UserAgentPresets.LABELS.length];
+        for (int i = 0; i < labels.length; i++) {
+            labels[i] = getString(UserAgentPresets.LABELS[i]);
+        }
+        new AlertDialog.Builder(requireContext(), R.style.ThemeOverlay_BrowserUI_AlertDialog)
+                .setTitle(R.string.bare_user_agent_title)
+                .setSingleChoiceItems(
+                        labels,
+                        UserAgentPresets.indexOf(UserAgentPresets.getSaved()),
+                        (dialog, which) -> {
+                            dialog.dismiss();
+                            String id = UserAgentPresets.IDS[which];
+                            if (id.equals(UserAgentPresets.CUSTOM)) {
+                                showCustomUserAgentDialog();
+                            } else {
+                                onUserAgentChosen(id, null);
+                            }
+                        })
+                .setNegativeButton(android.R.string.cancel, null)
+                .show();
+    }
+
+    private void showCustomUserAgentDialog() {
+        Context context = requireContext();
+        EditText input = new EditText(context);
+        input.setInputType(InputType.TYPE_CLASS_TEXT | InputType.TYPE_TEXT_FLAG_MULTI_LINE);
+        input.setHint(R.string.bare_user_agent_custom_hint);
+        input.setText(UserAgentPresets.getSavedCustom());
+        FrameLayout container = new FrameLayout(context);
+        int padding =
+                context.getResources().getDimensionPixelSize(R.dimen.dialog_padding_sides);
+        container.setPadding(padding, 0, padding, 0);
+        container.addView(input);
+        new AlertDialog.Builder(context, R.style.ThemeOverlay_BrowserUI_AlertDialog)
+                .setTitle(R.string.bare_user_agent_other)
+                .setView(container)
+                .setPositiveButton(
+                        android.R.string.ok,
+                        (dialog, which) -> {
+                            String custom = input.getText().toString().trim();
+                            if (!UserAgentPresets.isValidCustom(custom)) {
+                                Toast.makeText(
+                                                context,
+                                                R.string.bare_user_agent_invalid,
+                                                Toast.LENGTH_LONG)
+                                        .show();
+                                return;
+                            }
+                            onUserAgentChosen(UserAgentPresets.CUSTOM, custom);
+                        })
+                .setNegativeButton(android.R.string.cancel, null)
+                .show();
+    }
+
+    private void onUserAgentChosen(String id, @Nullable String custom) {
+        UserAgentPresets.save(id, custom);
+        updateUserAgentSummary();
+        boolean matchesRunning =
+                id.equals(UserAgentPresets.getActive())
+                        && (!id.equals(UserAgentPresets.CUSTOM)
+                                || UserAgentPresets.getSavedCustom()
+                                        .equals(UserAgentPresets.getActiveCustom()));
+        if (matchesRunning) return;
+        new AlertDialog.Builder(requireContext(), R.style.ThemeOverlay_BrowserUI_AlertDialog)
+                .setMessage(R.string.bare_user_agent_restart_message)
+                .setPositiveButton(
+                        R.string.bare_user_agent_restart,
+                        (dialog, which) -> ApplicationLifetime.terminate(/* restart= */ true))
+                .setNegativeButton(R.string.bare_user_agent_later, null)
+                .show();
     }
 
     private static boolean shouldRemoveBetaStableHint() {
diff --git a/chrome/android/java/src/org/chromium/chrome/browser/tracing/settings/UserAgentPresets.java b/chrome/android/java/src/org/chromium/chrome/browser/tracing/settings/UserAgentPresets.java

 std::string GetUserAgent() {
   std::optional<std::string> custom_ua = GetUserAgentFromCommandLine();
   if (custom_ua.has_value()) {
     return custom_ua.value();
   }
 
+  if (std::optional<UserAgentPreset> preset = GetUserAgentPreset()) {
+    return preset->user_agent;
+  }
+
   return GetUserAgentInternal();
 }
 
+bool IsUserAgentPresetActive() {
+  return !GetUserAgentFromCommandLine().has_value() &&
+         GetUserAgentPreset().has_value();
+}

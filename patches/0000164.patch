+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.tracing.settings;
+
+import android.text.TextUtils;
+
+import org.chromium.base.CommandLine;
+import org.chromium.base.shared_preferences.SharedPreferencesManager;
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.chrome.R;
+import org.chromium.chrome.browser.preferences.ChromePreferenceKeys;
+import org.chromium.chrome.browser.preferences.ChromeSharedPreferences;
+
+/**
+ * The user agents offered in Developer options. The saved choice is passed to native code as a
+ * switch before it starts, so a change applies after a restart.
+ */
+@NullMarked
+public final class UserAgentPresets {
+    /** Same names as embedder_support::kBareUserAgentPreset and kBareUserAgentCustom. */
+    public static final String SWITCH_PRESET = "bare-user-agent-preset";
+
+    public static final String SWITCH_CUSTOM = "bare-user-agent-custom";
+
+    static final String DEFAULT = "";
+    static final String CUSTOM = "custom";
+
+    /** Menu order. Native code knows every id except the default. */
+    static final String[] IDS = {
+        DEFAULT,
+        "chrome-android",
+        "chrome-linux",
+        "chrome-windows",
+        "chrome-mac",
+        "chrome-chromeos",
+        "edge-windows",
+        "firefox-windows",
+        "firefox-android",
+        "safari-mac",
+        "safari-iphone",
+        CUSTOM,
+    };
+
+    static final int[] LABELS = {
+        R.string.bare_user_agent_default,
+        R.string.bare_user_agent_chrome_android,
+        R.string.bare_user_agent_chrome_linux,
+        R.string.bare_user_agent_chrome_windows,
+        R.string.bare_user_agent_chrome_mac,
+        R.string.bare_user_agent_chrome_chromeos,
+        R.string.bare_user_agent_edge_windows,
+        R.string.bare_user_agent_firefox_windows,
+        R.string.bare_user_agent_firefox_android,
+        R.string.bare_user_agent_safari_mac,
+        R.string.bare_user_agent_safari_iphone,
+        R.string.bare_user_agent_other,
+    };
+
+    private UserAgentPresets() {}
+
+    /** Adds the switches for the saved choice. Runs before native code is loaded. */
+    public static void appendSwitches() {
+        String id = getSaved();
+        if (id.equals(DEFAULT)) return;
+        CommandLine commandLine = CommandLine.getInstance();
+        if (id.equals(CUSTOM)) {
+            String custom = getSavedCustom();
+            if (!isValidCustom(custom)) return;
+            commandLine.appendSwitchWithValue(SWITCH_CUSTOM, custom);
+        }
+        commandLine.appendSwitchWithValue(SWITCH_PRESET, id);
+    }
+
+    /** Whether this process runs with a user agent other than the default. */
+    public static boolean isActive() {
+        return CommandLine.getInstance().hasSwitch(SWITCH_PRESET);
+    }
+
+    static String getActive() {
+        String id = CommandLine.getInstance().getSwitchValue(SWITCH_PRESET);
+        return id == null ? DEFAULT : id;
+    }
+
+    static String getActiveCustom() {
+        String custom = CommandLine.getInstance().getSwitchValue(SWITCH_CUSTOM);
+        return custom == null ? "" : custom;
+    }
+
+    static String getSaved() {
+        String id =
+                ChromeSharedPreferences.getInstance()
+                        .readString(ChromePreferenceKeys.BARE_USER_AGENT_PRESET, DEFAULT);
+        return id == null || indexOf(id) < 0 ? DEFAULT : id;
+    }
+
+    static String getSavedCustom() {
+        String custom =
+                ChromeSharedPreferences.getInstance()
+                        .readString(ChromePreferenceKeys.BARE_USER_AGENT_CUSTOM, "");
+        return custom == null ? "" : custom.trim();
+    }
+
+    static void save(String id, @Nullable String custom) {
+        SharedPreferencesManager prefs = ChromeSharedPreferences.getInstance();
+        prefs.writeString(ChromePreferenceKeys.BARE_USER_AGENT_PRESET, id);
+        if (custom != null) {
+            prefs.writeString(ChromePreferenceKeys.BARE_USER_AGENT_CUSTOM, custom.trim());
+        }
+    }
+
+    static int indexOf(String id) {
+        for (int i = 0; i < IDS.length; i++) {
+            if (IDS[i].equals(id)) return i;
+        }
+        return -1;
+    }
+
+    /** A user agent goes into an HTTP header, so printable ASCII only. */
+    static boolean isValidCustom(@Nullable String custom) {
+        if (TextUtils.isEmpty(custom)) return false;
+        for (int i = 0; i < custom.length(); i++) {
+            char c = custom.charAt(i);
+            if (c < 0x20 || c > 0x7e) return false;
+        }
+        return true;
+    }
+}

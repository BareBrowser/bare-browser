+bool HasBrand(const blink::UserAgentBrandList& brands,
+              const std::string& name) {
+  for (const auto& brand : brands) {
+    if (brand.brand == name) {
+      return true;
+    }
+  }
+  return false;
+}
+
+class BareUserAgentPresetTest : public testing::Test {
+ protected:
+  void SetSwitch(const char* name, const std::string& value) {
+    command_line_.GetProcessCommandLine()->AppendSwitchASCII(name, value);
+  }
+
+  base::test::ScopedCommandLine command_line_;
+};
+
+TEST_F(BareUserAgentPresetTest, NoPresetKeepsDefault) {
+  EXPECT_FALSE(IsUserAgentPresetActive());
+  EXPECT_EQ(GetUserAgentMetadata(), GetDefaultUserAgentMetadata());
+}
+
+TEST_F(BareUserAgentPresetTest, FirefoxSendsNoClientHints) {
+  SetSwitch(kBareUserAgentPreset, "firefox-windows");
+  EXPECT_TRUE(IsUserAgentPresetActive());
+  EXPECT_EQ(GetUserAgent(),
+            "Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:158.0) "
+            "Gecko/20100101 Firefox/158.0");
+  EXPECT_TRUE(GetUserAgentMetadata().brand_version_list.empty());
+  EXPECT_TRUE(GetUserAgentMetadata(true).brand_version_list.empty());
+  EXPECT_FALSE(GetDefaultUserAgentMetadata().brand_version_list.empty());
+}
+
+TEST_F(BareUserAgentPresetTest, ChromeWindowsMatchesItsClientHints) {
+  SetSwitch(kBareUserAgentPreset, "chrome-windows");
+  const std::string ua = GetUserAgent();
+  EXPECT_NE(ua.find("(Windows NT 10.0; Win64; x64)"), std::string::npos);
+  EXPECT_NE(ua.find(GetProductAndVersion()), std::string::npos);
+  EXPECT_EQ(ua.find("Mobile"), std::string::npos);
+
+  const blink::UserAgentMetadata metadata = GetUserAgentMetadata();
+  EXPECT_EQ(metadata.platform, "Windows");
+  EXPECT_FALSE(metadata.mobile);
+  EXPECT_TRUE(HasBrand(metadata.brand_version_list, "Google Chrome"));
+  EXPECT_TRUE(HasBrand(metadata.brand_version_list, "Chromium"));
+  EXPECT_TRUE(HasBrand(metadata.brand_full_version_list, "Google Chrome"));
+
+  const blink::UserAgentMetadata low_entropy = GetUserAgentMetadata(true);
+  EXPECT_EQ(low_entropy.platform, "Windows");
+  EXPECT_TRUE(low_entropy.full_version.empty());
+  EXPECT_TRUE(low_entropy.brand_full_version_list.empty());
+}
+
+TEST_F(BareUserAgentPresetTest, EdgeAddsItsToken) {
+  SetSwitch(kBareUserAgentPreset, "edge-windows");
+  EXPECT_TRUE(GetUserAgent().ends_with(base::StrCat(
+      {" Edg/", version_info::GetMajorVersionNumber(), ".0.0.0"})));
+  EXPECT_TRUE(
+      HasBrand(GetUserAgentMetadata().brand_version_list, "Microsoft Edge"));
+}
+
+TEST_F(BareUserAgentPresetTest, ChromeAndroidIsMobile) {
+  SetSwitch(kBareUserAgentPreset, "chrome-android");
+  EXPECT_TRUE(GetUserAgent().ends_with(" Mobile Safari/537.36"));
+  const blink::UserAgentMetadata metadata = GetUserAgentMetadata();
+  EXPECT_TRUE(metadata.mobile);
+  EXPECT_EQ(metadata.platform, "Android");
+}
+
+TEST_F(BareUserAgentPresetTest, CustomString) {
+  SetSwitch(kBareUserAgentPreset, "custom");
+  SetSwitch(kBareUserAgentCustom, "  Test/1.0 (Example)  ");
+  EXPECT_TRUE(IsUserAgentPresetActive());
+  EXPECT_EQ(GetUserAgent(), "Test/1.0 (Example)");
+  EXPECT_TRUE(GetUserAgentMetadata().brand_version_list.empty());
+}
+
+TEST_F(BareUserAgentPresetTest, InvalidCustomFallsBackToDefault) {
+  SetSwitch(kBareUserAgentPreset, "custom");
+  SetSwitch(kBareUserAgentCustom, "bad\nvalue");
+  EXPECT_FALSE(IsUserAgentPresetActive());
+  EXPECT_EQ(GetUserAgent().find("bad"), std::string::npos);
+}
+
+TEST_F(BareUserAgentPresetTest, UnknownPresetIsIgnored) {
+  SetSwitch(kBareUserAgentPreset, "netscape");
+  EXPECT_FALSE(IsUserAgentPresetActive());
+  EXPECT_EQ(GetUserAgentMetadata(), GetDefaultUserAgentMetadata());
+}
+
+TEST_F(BareUserAgentPresetTest, UserAgentSwitchWins) {
+  SetSwitch(kBareUserAgentPreset, "firefox-windows");
+  SetSwitch(kUserAgent, "Switch/1.0");
+  EXPECT_FALSE(IsUserAgentPresetActive());
+  EXPECT_EQ(GetUserAgent(), "Switch/1.0");
+}

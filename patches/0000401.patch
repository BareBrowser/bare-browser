+package org.chromium.chrome.browser.download.home.list;
+
+import org.chromium.build.annotations.NullMarked;
+
+/**
+ * Set when "Select" is chosen in the Downloads page menu: the next tap on a file selects it
+ * instead of opening it, which starts the page's usual multi-select.
+ */
+@NullMarked
+public final class BareDownloadSelect {
+    private BareDownloadSelect() {}
+
+    /** Whether the next tap on a row selects it. Read and written on the UI thread. */
+    public static boolean sArmed;
+}

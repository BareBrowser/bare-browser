+    /**
+     * Bare: the minimal bar's buttons are the toolbar's own and, unlike the bottom bar's, have no
+     * tick when pressed. The tick is given here, watching the touches on their way to the buttons
+     * without taking them: on touch down for the menu, which opens on touch down, and for the
+     * others when the finger lifts on the button it went down on.
+     */
+    private void tickForPress(MotionEvent ev) {
+        switch (ev.getActionMasked()) {
+            case MotionEvent.ACTION_DOWN:
+                mBarePressedButton = minimalButtonAt(ev);
+                if (mBarePressedButton != null && mBarePressedButton.getId() == R.id.menu_button) {
+                    ActionHaptics.tick(mBarePressedButton);
+                    mBarePressedButton = null;
+                }
+                break;
+            case MotionEvent.ACTION_UP:
+                View pressed = mBarePressedButton;
+                mBarePressedButton = null;
+                if (pressed != null && pressed == minimalButtonAt(ev)) ActionHaptics.tick(pressed);
+                break;
+            case MotionEvent.ACTION_CANCEL:
+                mBarePressedButton = null;
+                break;
+            default:
+                break;
+        }
+    }
+
+    private @Nullable View minimalButtonAt(MotionEvent ev) {
+        int[] at = new int[2];
+        getLocationInWindow(at);
+        float x = ev.getX() + at[0];
+        float y = ev.getY() + at[1];
+        int[] ids = {
+            R.id.home_button, R.id.optional_toolbar_button, R.id.tab_switcher_button, R.id.menu_button
+        };
+        for (int id : ids) {
+            View button = findViewById(id);
+            if (button == null || !button.isShown() || !button.isEnabled()) continue;
+            button.getLocationInWindow(at);
+            if (x >= at[0]
+                    && x < at[0] + button.getWidth()
+                    && y >= at[1]
+                    && y < at[1] + button.getHeight()) {
+                return button;
+            }
+        }
+        return null;
+    }

+import java.util.Locale;
+import java.util.Map;
+
+/**
+ * The task manager as a card from the bottom of the screen. It lists what the browser is running,
+ * with memory and processor use, and opens a row to show its process number and network use and to
+ * end it. The numbers are the ones the browser's own task manager keeps; this only draws them.
+ */
+@NullMarked
+public final class BareTaskManagerCard implements BottomSheetContent, TaskManagerObserver {
+    private static final int REFRESH_MS = 2000;
+    private static final int LIST_MAX_DP = 340;
+    private static final int RED = 0xFFC62828;
+
+    private static final class Task {
+        final long mId;
+        final int mType;
+        final boolean mKillable;
+        String mTitle = "";
+        long mMemory;
+        double mCpu;
+        long mNetwork;
+        long mProcessId;
+
+        Task(long id, int type, boolean killable) {
+            mId = id;
+            mType = type;
+            mKillable = killable;
+        }
+    }
+
+    /** A scroll view that stops growing at a set height, so the card never fills the screen. */
+    private static final class CappedScrollView extends ScrollView {
+        private final int mCap;
+
+        CappedScrollView(Context context, int cap) {
+            super(context);
+            mCap = cap;
+        }
+
+        @Override
+        protected void onMeasure(int widthMeasureSpec, int heightMeasureSpec) {
+            super.onMeasure(
+                    widthMeasureSpec, MeasureSpec.makeMeasureSpec(mCap, MeasureSpec.AT_MOST));
+        }
+    }
+
+    private static final BottomSheetType SHEET_TYPE =
+            new BottomSheetType.Builder().setUserInitiated(true).build();
+
+    private final Context mContext;
+    private final TaskManagerServiceBridge mBridge = new TaskManagerServiceBridge();
+    private final Map<Long, Task> mTasks = new LinkedHashMap<>();
+    private final LinearLayout mRoot;
+    private final TextView mSummary;
+    private final LinearLayout mRows;
+    private final TextView mMemoryChip;
+    private final TextView mCpuChip;
+    private boolean mSortByMemory = true;
+    private long mExpandedId = -1;
+    private TaskManagerServiceBridge.@Nullable ObserverHandle mHandle;
+
+    /** Shows the card on the given sheet controller. */
+    public static void show(Context context, BottomSheetController controller) {
+        controller.requestShowContent(new BareTaskManagerCard(context), true);
+    }
+
+    private BareTaskManagerCard(Context context) {
+        mContext = context;
+        mRoot = new LinearLayout(context);
+        mRoot.setOrientation(LinearLayout.VERTICAL);
+        mRoot.setPadding(0, dp(6), 0, dp(18));
+
+        LinearLayout heading = new LinearLayout(context);
+        heading.setOrientation(LinearLayout.HORIZONTAL);
+        heading.setGravity(Gravity.CENTER_VERTICAL);
+        heading.setPadding(dp(20), 0, dp(20), 0);
+        ImageView chip = new ImageView(context);
+        chip.setImageResource(R.drawable.ic_task_manager_chip);
+        chip.setColorFilter(SemanticColorUtils.getDefaultIconColorAccent1(context));
+        LinearLayout.LayoutParams chipParams = new LinearLayout.LayoutParams(dp(22), dp(22));
+        chipParams.setMarginEnd(dp(10));
+        heading.addView(chip, chipParams);
+        heading.addView(
+                text("Task manager", 17, true, SemanticColorUtils.getDefaultTextColor(context)));
+        mRoot.addView(heading);
+        mSummary = text("", 12, false, SemanticColorUtils.getDefaultTextColorSecondary(context));
+        mSummary.setPadding(dp(20), dp(2), dp(20), dp(8));
+        mRoot.addView(mSummary);
+
+        LinearLayout chips = new LinearLayout(context);
+        chips.setOrientation(LinearLayout.HORIZONTAL);
+        chips.setPadding(dp(20), 0, dp(20), dp(6));
+        mMemoryChip = chip("Memory");
+        mCpuChip = chip("CPU");
+        mMemoryChip.setOnClickListener(v -> setSort(true));
+        mCpuChip.setOnClickListener(v -> setSort(false));
+        chips.addView(mMemoryChip);
+        LinearLayout.LayoutParams cpuParams = new LinearLayout.LayoutParams(-2, -2);
+        cpuParams.setMarginStart(dp(6));
+        chips.addView(mCpuChip, cpuParams);
+        mRoot.addView(chips);
+
+        mRows = new LinearLayout(context);
+        mRows.setOrientation(LinearLayout.VERTICAL);
+        mRows.setPadding(dp(10), 0, dp(10), 0);
+        CappedScrollView scroll = new CappedScrollView(context, dp(LIST_MAX_DP));
+        scroll.addView(mRows);
+        mRoot.addView(scroll);
+        styleChips();
+
+        // The numbers come only while the card is on screen.
+        mRoot.addOnAttachStateChangeListener(
+                new View.OnAttachStateChangeListener() {
+                    @Override
+                    public void onViewAttachedToWindow(View view) {
+                        start();
+                    }
+
+                    @Override
+                    public void onViewDetachedFromWindow(View view) {
+                        stop();
+                    }
+                });
+    }
+
+    // The numbers.
+
+    private void start() {
+        if (mHandle != null) return;
+        mHandle =
+                mBridge.addObserver(
+                        this,
+                        REFRESH_MS,
+                        RefreshType.MEMORY_FOOTPRINT | RefreshType.CPU | RefreshType.NETWORK_USAGE);
+    }
+
+    private void stop() {
+        if (mHandle == null) return;
+        mBridge.removeObserver(mHandle);
+        mHandle = null;
+    }
+
+    private Task track(long id) {
+        Task task = mTasks.get(id);
+        if (task == null) {
+            task = new Task(id, mBridge.getType(id), mBridge.isTaskKillable(id));
+            mTasks.put(id, task);
+        }
+        task.mTitle = mBridge.getTitle(id);
+        // Negative until the first measurement arrives.
+        task.mMemory = Math.max(0, mBridge.getMemoryFootprintUsage(id));
+        double cpu = mBridge.getPlatformIndependentCpuUsage(id);
+        // Native reports NaN until it has two samples to compare.
+        task.mCpu = Double.isNaN(cpu) ? 0 : cpu;
+        task.mNetwork = mBridge.getNetworkUsage(id);
+        task.mProcessId = mBridge.getProcessId(id);
+        return task;
+    }
+
+    @Override
+    public void onTaskAdded(long id) {
+        track(id);
+        render();
+    }
+
+    @Override
+    public void onTaskToBeRemoved(long id) {
+        mTasks.remove(id);
+        if (mExpandedId == id) mExpandedId = -1;
+        render();
+    }
+
+    @Override
+    public void onTasksRefreshed(long[] taskIds) {
+        for (long id : taskIds) track(id);
+        render();
+    }
+
+    @Override
+    public void onTasksRefreshedWithBackgroundCalculations(long[] taskIds) {}
+
+    @Override
+    public void onTaskUnresponsive(long id) {}
+
+    // The card.
+
+    private void setSort(boolean byMemory) {
+        mSortByMemory = byMemory;
+        styleChips();
+        render();
+    }
+
+    private void render() {
+        ArrayList<Task> list = new ArrayList<>(mTasks.values());
+        long total = 0;
+        for (Task task : list) total += task.mMemory;
+        Collections.sort(
+                list,
+                (a, b) ->
+                        mSortByMemory
+                                ? Long.compare(b.mMemory, a.mMemory)
+                                : Double.compare(b.mCpu, a.mCpu));
+        mSummary.setText(
+                Formatter.formatShortFileSize(mContext, total)
+                        + " in use, "
+                        + list.size()
+                        + (list.size() == 1 ? " task" : " tasks"));
+        mRows.removeAllViews();
+        for (Task task : list) mRows.addView(row(task));
+    }
+
+    private View row(Task task) {
+        boolean open = task.mId == mExpandedId;
+        LinearLayout row = new LinearLayout(mContext);
+        row.setOrientation(LinearLayout.VERTICAL);
+        row.setPadding(dp(10), dp(8), dp(10), dp(8));
+        if (open) {
+            GradientDrawable background = new GradientDrawable();
+            background.setCornerRadius(dp(12));
+            background.setColor(SemanticColorUtils.getCardBackgroundColor(mContext));
+            row.setBackground(background);
+        }
+
+        LinearLayout top = new LinearLayout(mContext);
+        top.setOrientation(LinearLayout.HORIZONTAL);
+        top.setGravity(Gravity.CENTER_VERTICAL);
+        top.setMinimumHeight(dp(36));
+        LinearLayout names = new LinearLayout(mContext);
+        names.setOrientation(LinearLayout.VERTICAL);
+        TextView name =
+                text(displayName(task), 14, false, SemanticColorUtils.getDefaultTextColor(mContext));
+        name.setSingleLine(true);
+        name.setEllipsize(TextUtils.TruncateAt.END);
+        names.addView(name);
+        names.addView(
+                text(kind(task), 12, false, SemanticColorUtils.getDefaultTextColorSecondary(mContext)));
+        top.addView(names, new LinearLayout.LayoutParams(0, -2, 1f));
+
+        LinearLayout numbers = new LinearLayout(mContext);
+        numbers.setOrientation(LinearLayout.VERTICAL);
+        numbers.setGravity(Gravity.END);
+        String memory = Formatter.formatShortFileSize(mContext, task.mMemory);
+        String cpu = String.format(Locale.US, "%.1f%% CPU", task.mCpu);
+        numbers.addView(
+                text(
+                        mSortByMemory ? memory : cpu,
+                        13,
+                        false,
+                        SemanticColorUtils.getDefaultTextColor(mContext)));
+        numbers.addView(
+                text(
+                        mSortByMemory ? cpu : memory,
+                        11,
+                        false,
+                        SemanticColorUtils.getDefaultTextColorSecondary(mContext)));
+        top.addView(numbers);
+        row.addView(top);
+
+        if (open) {
+            LinearLayout more = new LinearLayout(mContext);
+            more.setOrientation(LinearLayout.HORIZONTAL);
+            more.setGravity(Gravity.CENTER_VERTICAL);
+            more.setPadding(0, dp(8), 0, 0);
+            TextView facts =
+                    text(
+                            "Process " + task.mProcessId
+                                    + "\nNetwork "
+                                    + Formatter.formatShortFileSize(mContext, task.mNetwork),
+                            12,
+                            false,
+                            SemanticColorUtils.getDefaultTextColorSecondary(mContext));
+            more.addView(facts, new LinearLayout.LayoutParams(0, -2, 1f));
+            if (task.mKillable) {
+                TextView end = text("End", 13, true, 0xFFFFFFFF);
+                end.setGravity(Gravity.CENTER);
+                end.setPadding(dp(20), dp(8), dp(20), dp(8));
+                GradientDrawable pill = new GradientDrawable();
+                pill.setColor(RED);
+                pill.setCornerRadius(dp(40));
+                end.setBackground(pill);
+                end.setOnClickListener(v -> end(task));
+                more.addView(end);
+            } else {
+                more.addView(
+                        text(
+                                "Needed by "
+                                        + appName(),
+                                12,
+                                false,
+                                SemanticColorUtils.getDefaultTextColorSecondary(mContext)));
+            }
+            row.addView(more);
+        }
+        row.setOnClickListener(
+                v -> {
+                    mExpandedId = open ? -1 : task.mId;
+                    render();
+                });
+        LinearLayout.LayoutParams params = new LinearLayout.LayoutParams(-1, -2);
+        params.bottomMargin = dp(2);
+        row.setLayoutParams(params);
+        return row;
+    }
+
+    private void end(Task task) {
+        String name = displayName(task);
+        mBridge.killTask(task.mId);
+        mExpandedId = -1;
+        Toast.makeText(mContext, "Ended " + name, Toast.LENGTH_SHORT).show();
+    }
+
+    private String displayName(Task task) {
+        String title = task.mTitle;
+        if (task.mType == TaskType.BROWSER) return appName();
+        if (task.mType == TaskType.GPU) return "Graphics";
+        if (title.toLowerCase(Locale.US).contains("spare")) return "Spare renderer";
+        for (String prefix : new String[] {"Tab: ", "Extension: ", "Background Page: "}) {
+            if (title.startsWith(prefix)) return title.substring(prefix.length());
+        }
+        return title;
+    }
+
+    private String kind(Task task) {
+        String title = task.mTitle.toLowerCase(Locale.US);
+        switch (task.mType) {
+            case TaskType.BROWSER:
+                return "Browser";
+            case TaskType.GPU:
+                return "Graphics process";
+            case TaskType.UTILITY:
+                return "Utility process";
+            case TaskType.EXTENSION:
+                return "Extension";
+            case TaskType.RENDERER:
+                if (title.contains("spare")) return "Ready for the next tab";
+                return title.startsWith("tab:") ? "Tab" : "Page process";
+            default:
+                return "Process";
+        }
+    }
+
+    private TextView chip(String label) {
+        TextView chip = text(label, 12, false, 0);
+        chip.setPadding(dp(14), dp(6), dp(14), dp(6));
+        return chip;
+    }
+
+    private void styleChips() {
+        style(mMemoryChip, mSortByMemory);
+        style(mCpuChip, !mSortByMemory);
+    }
+
+    private void style(TextView chip, boolean on) {
+        GradientDrawable background = new GradientDrawable();
+        background.setCornerRadius(dp(40));
+        background.setColor(
+                on
+                        ? SemanticColorUtils.getFilledButtonBgColor(mContext)
+                        : SemanticColorUtils.getCardBackgroundColor(mContext));
+        chip.setBackground(background);
+        chip.setTextColor(
+                on
+                        ? SemanticColorUtils.getDefaultIconColorOnAccent1(mContext)
+                        : SemanticColorUtils.getDefaultTextColor(mContext));
+    }
+
+    private TextView text(String value, float sp, boolean bold, int color) {
+        TextView view = new TextView(mContext);
+        view.setText(value);
+        view.setTextSize(TypedValue.COMPLEX_UNIT_SP, sp);
+        view.setTextColor(color);
+        if (bold) view.setTypeface(Typeface.DEFAULT_BOLD);
+        return view;
+    }
+
+    private String appName() {
+        return mContext.getApplicationInfo().loadLabel(mContext.getPackageManager()).toString();
+    }
+
+    private int dp(float value) {
+        return Math.round(value * mContext.getResources().getDisplayMetrics().density);
+    }
+
+    // BottomSheetContent
+
+    @Override
+    public View getContentView() {
+        return mRoot;
+    }
+
+    @Override
+    public @Nullable View getToolbarView() {
+        return null;
+    }
+
+    @Override
+    public int getVerticalScrollOffset() {
+        return 0;
+    }
+
+    @Override
+    public void destroy() {
+        stop();
+    }
+
+    @Override
+    public BottomSheetType getSheetType() {
+        return SHEET_TYPE;
+    }
+
+    @Override
+    public int getPriority() {
+        return ContentPriority.HIGH;
+    }
+
+    @Override
+    public boolean swipeToDismissEnabled() {
+        return true;
+    }
+
+    @Override
+    public boolean showHandlebar() {
+        return true;
+    }
+
+    @Override
+    public int getPeekHeight() {
+        return HeightMode.DISABLED;
+    }
+
+    @Override
+    public float getHalfHeightRatio() {
+        return HeightMode.DISABLED;
+    }
+
+    @Override
+    public float getFullHeightRatio() {
+        return HeightMode.WRAP_CONTENT;
+    }
+
+    @Override
+    public @Nullable String getSheetContentDescription(Context context) {
+        return "Task manager";
+    }
+
+    @Override
+    public int getSheetHalfHeightAccessibilityStringId() {
+        return R.string.menu_task_manager;
+    }
+
+    @Override
+    public int getSheetFullHeightAccessibilityStringId() {
+        return R.string.menu_task_manager;
+    }
+
+    @Override
+    public int getSheetClosedAccessibilityStringId() {
+        return R.string.menu_task_manager;
+    }
+}

From 2271c395b00af837cd2b288c8f417d688328e179 Mon Sep 17 00:00:00 2001
From: Bare <git@barebrowser.org>
Date: Thu, 10 Sep 2026 04:04:22 +0000
Subject: [PATCH] Let policy refuse a download before another app is offered it

The handoff to an installed download manager ran first in
InterceptDownloadIfApplicable, above the blocklist check it shares the method
with. A URL an administrator had blocked was therefore passed to another app and
reported as handled, so the block was answered by carrying the download out of
its reach. It runs after that check now. Nothing else about the handoff changes.

The chooser had the same shape of problem. The candidate list is built without
this browser, and the comment said so, but the chooser was created from the
original intent and resolves that intent again for itself, so Bare was offered
as somewhere to send its own download after all. The components that were
filtered out are now named in EXTRA_EXCLUDE_COMPONENTS, which the chooser reads.
---
 .../browser/download/DownloadController.java  | 27 ++++++++++++++-----
 .../chrome_download_manager_delegate.cc       | 24 ++++++++++-------
 2 files changed, 34 insertions(+), 17 deletions(-)

diff --git a/chrome/android/java/src/org/chromium/chrome/browser/download/DownloadController.java b/chrome/android/java/src/org/chromium/chrome/browser/download/DownloadController.java
index 268a7b6a44b..8cdbc819aab 100644
--- a/chrome/android/java/src/org/chromium/chrome/browser/download/DownloadController.java
+++ b/chrome/android/java/src/org/chromium/chrome/browser/download/DownloadController.java
@@ -47,9 +47,10 @@ public class DownloadController {
      * can take it. Returns true only if a chooser was actually shown, so that Chromium falls back
      * to downloading the file itself when no suitable app is installed.
      *
-     * <p>Chromium registers as a handler for http(s) ACTION_VIEW itself, so it is filtered out of
-     * the candidate list. Without that the chooser would offer this browser as a place to send its
-     * own download, which at best is confusing and at worst loops.
+     * <p>Chromium registers as a handler for http(s) ACTION_VIEW itself, so it is left out of the
+     * candidate list and named in EXTRA_EXCLUDE_COMPONENTS. Without both the chooser would offer
+     * this browser as a place to send its own download, which at best is confusing and at worst
+     * loops.
      *
      * <p>Known limitation: the interception point in ChromeDownloadManagerDelegate does not carry
      * the request cookie, so a download that depends on being signed in will fail in the external
@@ -85,13 +86,17 @@ public class DownloadController {
         // only the package leaves Android to ask which of them should handle it, defeating the
         // point of choosing one in settings.
         java.util.List<String> handlers = new java.util.ArrayList<>();
+        java.util.List<android.content.ComponentName> own = new java.util.ArrayList<>();
         for (ResolveInfo info : pm.queryIntentActivities(intent, 0)) {
             if (info.activityInfo == null) continue;
-            if (self.equals(info.activityInfo.packageName)) continue;
-            String component =
+            android.content.ComponentName name =
                     new android.content.ComponentName(
-                                    info.activityInfo.packageName, info.activityInfo.name)
-                            .flattenToString();
+                            info.activityInfo.packageName, info.activityInfo.name);
+            if (self.equals(info.activityInfo.packageName)) {
+                own.add(name);
+                continue;
+            }
+            String component = name.flattenToString();
             if (!handlers.contains(component)) handlers.add(component);
         }
 
@@ -122,6 +127,14 @@ public class DownloadController {
 
         Intent chooser = Intent.createChooser(intent, null);
         chooser.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK);
+        // Naming them here is what actually leaves them out. The list above is built without
+        // this browser, but the chooser resolves the intent again for itself, so filtering the
+        // list never reached it and Bare was offered its own download after all.
+        if (!own.isEmpty()) {
+            chooser.putExtra(
+                    Intent.EXTRA_EXCLUDE_COMPONENTS,
+                    own.toArray(new android.content.ComponentName[0]));
+        }
         try {
             context.startActivity(chooser);
             return true;
diff --git a/chrome/browser/download/chrome_download_manager_delegate.cc b/chrome/browser/download/chrome_download_manager_delegate.cc
index df3ffb37615..6022d7c02fc 100644
--- a/chrome/browser/download/chrome_download_manager_delegate.cc
+++ b/chrome/browser/download/chrome_download_manager_delegate.cc
@@ -1238,9 +1238,23 @@ bool ChromeDownloadManagerDelegate::InterceptDownloadIfApplicable(
     bool is_transient,
     bool is_content_initiated,
     content::WebContents* web_contents) {
+  PolicyBlocklistService* service =
+      ChromePolicyBlocklistServiceFactory::GetForProfile(profile_);
+  policy::URLBlocklist::URLBlocklistState blocklist_state =
+      service->GetURLBlocklistState(url);
+  if (blocklist_state ==
+      policy::URLBlocklist::URLBlocklistState::URL_IN_BLOCKLIST) {
+    LOG(WARNING) << "URL is blocked by a policy.";
+    return true;
+  }
+
 #if BUILDFLAG(IS_ANDROID)
   // De-Googled build: give an installed download manager first refusal.
   //
+  // Below the blocklist check, so a URL an administrator has blocked is refused
+  // here rather than handed to another app, which would have carried it out of
+  // reach of the policy that blocked it.
+  //
   // Returns false when no suitable app is installed, in which case the download
   // proceeds in the browser as usual. Note this hook carries no cookie, so a
   // download that depends on being signed in will fail in the external app.
@@ -1249,16 +1263,6 @@ bool ChromeDownloadManagerDelegate::InterceptDownloadIfApplicable(
   }
 #endif  // BUILDFLAG(IS_ANDROID)
 
-  PolicyBlocklistService* service =
-      ChromePolicyBlocklistServiceFactory::GetForProfile(profile_);
-  policy::URLBlocklist::URLBlocklistState blocklist_state =
-      service->GetURLBlocklistState(url);
-  if (blocklist_state ==
-      policy::URLBlocklist::URLBlocklistState::URL_IN_BLOCKLIST) {
-    LOG(WARNING) << "URL is blocked by a policy.";
-    return true;
-  }
-
 #if BUILDFLAG(ENABLE_OFFLINE_PAGES)
   DCHECK_CURRENTLY_ON(BrowserThread::UI);
   // For background service downloads we don't want offline pages backend to

+<?xml version="1.0" encoding="utf-8"?>
+<!--
+Copyright 2026 The Chromium Authors
+Use of this source code is governed by a BSD-style license that can be
+found in the LICENSE file.
+-->
+
+<resources>
+    <!-- Title of the storage page. %1$s is the browser name. -->
+    <string name="bare_storage_title">%1$s storage</string>
+    <!-- Heading of the card that lists the sites using the most space. -->
+    <string name="bare_storage_site_storage">Site storage</string>
+    <!-- Link that opens the full list of sites. -->
+    <string name="bare_storage_manage">Manage</string>
+    <!-- Label above the amount of data kept by sites that are rarely used. -->
+    <string name="bare_storage_sites_data">Sites data</string>
+    <!-- Button that clears the data of rarely used sites. -->
+    <string name="bare_storage_free_up">Free up space</string>
+    <!-- Button, and button of the confirmation, that clears all browser data. -->
+    <string name="bare_storage_clear_all">Clear all data</string>
+    <!-- Note under the Clear all data button. -->
+    <string name="bare_storage_clear_all_note">Clear all data also removes bookmarks, history, saved logins and settings, and signs you out of every site.</string>
+    <!-- Shown in the site card when no site stores anything. -->
+    <string name="bare_storage_nothing">Nothing stored.</string>
+    <!-- Row that adds up the sites not listed. %1$d is how many sites. -->
+    <string name="bare_storage_other">Other (%1$d)</string>
+    <!-- Toast when Free up space is tapped and there is nothing to clear. -->
+    <string name="bare_storage_nothing_to_free">Nothing to free up</string>
+    <!-- Toast after Free up space finished. %1$s is the amount, for example 12 MB. -->
+    <string name="bare_storage_freed">Freed %1$s</string>
+    <!-- Title of the confirmation before all data is cleared. -->
+    <string name="bare_storage_confirm_title">Clear all data?</string>
+    <!-- Body of the confirmation before all data is cleared. -->
+    <string name="bare_storage_confirm_body">This removes bookmarks, history, saved logins and settings, and signs you out of every site. It can\'t be undone.</string>
+    <!-- Site list name for the data of the uBlock Origin extension. uBlock is a product name. -->
+    <string name="bare_storage_ubo_data">uBlock Data</string>
+    <!-- Site list name for the data of an extension that is not uBlock Origin. -->
+    <string name="bare_storage_extension_data">Extension data</string>
+</resources>

diff --git a/chrome/browser/ui/android/bare_ubo_update.cc b/chrome/browser/ui/android/bare_ubo_update.cc
new file mode 100644
index 00000000000..2d366b2e73d
--- /dev/null
+++ b/chrome/browser/ui/android/bare_ubo_update.cc
@@ -0,0 +1,72 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include <list>
+#include <string>
+#include <utility>
+
+#include "base/android/jni_android.h"
+#include "base/android/scoped_java_ref.h"
+#include "base/functional/bind.h"
+#include "base/memory/weak_ptr.h"
+#include "chrome/browser/extensions/updater/extension_updater.h"
+#include "chrome/browser/profiles/profile.h"
+#include "extensions/browser/extension_registry.h"
+#include "extensions/common/extension.h"
+
+// Must come after all headers that specialize FromJniType() / ToJniType().
+#include "chrome/android/chrome_jni_headers/BareUboUpdate_jni.h"
+
+namespace {
+
+// The id uBlock Origin has when it is installed from its author's own CRX.
+constexpr char kUboId[] = "fkgkibajhfbepljeaefdnfnegdcjomkh";
+
+std::string InstalledVersion(Profile* profile) {
+  const extensions::Extension* extension =
+      extensions::ExtensionRegistry::Get(profile)->GetInstalledExtension(kUboId);
+  return extension ? extension->GetVersionForDisplay() : std::string();
+}
+
+void Report(base::android::ScopedJavaGlobalRef<jobject> callback,
+            std::string before,
+            base::WeakPtr<Profile> profile) {
+  // Once the check is over the profile may be gone; the version is then taken
+  // to be unchanged.
+  std::string after = profile ? InstalledVersion(profile.get()) : before;
+  Java_BareUboUpdate_onResult(base::android::AttachCurrentThread(), callback,
+                              before + "|" + after);
+}
+
+}  // namespace
+
+static void JNI_BareUboUpdate_CheckNow(
+    JNIEnv* env,
+    const base::android::JavaRef<jobject>& jprofile,
+    const base::android::JavaRef<jobject>& jcallback) {
+  Profile* profile = Profile::FromJavaObject(jprofile);
+  base::android::ScopedJavaGlobalRef<jobject> callback(jcallback);
+  if (!profile) {
+    Java_BareUboUpdate_onResult(env, callback, "|");
+    return;
+  }
+
+  std::string before = InstalledVersion(profile);
+  extensions::ExtensionUpdater* updater =
+      extensions::ExtensionUpdater::Get(profile);
+  if (before.empty() || !updater || !updater->enabled()) {
+    Java_BareUboUpdate_onResult(env, callback, before + "|" + before);
+    return;
+  }
+
+  extensions::ExtensionUpdater::CheckParams params;
+  params.ids = std::list<extensions::ExtensionId>{kUboId};
+  params.install_immediately = true;
+  params.fetch_priority = extensions::DownloadFetchPriority::kForeground;
+  params.callback = base::BindOnce(&Report, callback, before,
+                                   profile->GetWeakPtr());
+  updater->CheckNow(std::move(params));
+}
+
+DEFINE_JNI(BareUboUpdate)

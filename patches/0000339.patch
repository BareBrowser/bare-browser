diff --git a/chrome/browser/extensions/bare_filter_subscriber.cc b/chrome/browser/extensions/bare_filter_subscriber.cc
index 6d800bee8a6..61873af601d 100644
--- a/chrome/browser/extensions/bare_filter_subscriber.cc
+++ b/chrome/browser/extensions/bare_filter_subscriber.cc
@@ -86,6 +86,41 @@ constexpr char kScript[] = R"(
 })();
 )";
 
+// Runs inside uBlock Origin's background page once its filters are ready, the
+// first time only: turns on its phishing list for users who still have its two
+// default malware lists on. The list is recorded as offered before anything
+// else, so a failure can't repeat it and a list the user later turns off is
+// never turned back on.
+constexpr char kPhishingScript[] = R"(
+(function() {
+  var list = 'curben-phishing';
+  var tries = 0;
+  var timer = setInterval(function() {
+    var ub = window['µBlock'];
+    if (++tries > 120) { clearInterval(timer); return; }
+    if (!ub || !ub.readyToFilter) { return; }
+    clearInterval(timer);
+    chrome.storage.local.get('bareSeededLists', function(got) {
+      var seeded = got && Array.isArray(got.bareSeededLists) ?
+          got.bareSeededLists : [];
+      if (seeded.indexOf(list) !== -1) { return; }
+      seeded.push(list);
+      chrome.storage.local.set({ bareSeededLists: seeded }, function() {
+        var selected = ub.selectedFilterLists || [];
+        if (selected.indexOf(list) !== -1) { return; }
+        if (selected.indexOf('urlhaus-1') === -1 ||
+            selected.indexOf('ublock-badware') === -1) { return; }
+        if (!ub.availableFilterLists || !ub.availableFilterLists[list]) {
+          return;
+        }
+        ub.applyFilterListSelection({ toSelect: [list], merge: true });
+        ub.loadFilterLists();
+      });
+    });
+  }, 500);
+})();
+)";
+
 std::string BuildScript(bool want) {
   std::string script = kScript;
   size_t at = script.find("%URL%");
@@ -123,6 +158,9 @@ class BareFilterSubscriber : public ExtensionHostRegistry::Observer {
     host->host_contents()->GetPrimaryMainFrame()->ExecuteJavaScriptForTests(
         base::UTF8ToUTF16(BuildScript(want)), base::NullCallback(),
         content::ISOLATED_WORLD_ID_GLOBAL);
+    host->host_contents()->GetPrimaryMainFrame()->ExecuteJavaScriptForTests(
+        base::UTF8ToUTF16(std::string(kPhishingScript)), base::NullCallback(),
+        content::ISOLATED_WORLD_ID_GLOBAL);
   }
 
   base::ScopedObservation<ExtensionHostRegistry,

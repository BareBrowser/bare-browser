From 43b645ecf71343b38f22fc25eee01bf3b63e2404 Mon Sep 17 00:00:00 2001
From: Bare <git@barebrowser.org>
Date: Mon, 12 Oct 2026 21:42:03 +0000
Subject: [PATCH] Keep the built-in translate language list instead of fetching
 Google's

Opening Settings, Languages asks TranslateBridge for the language list, and
TranslateLanguageList::GetSupportedLanguages then fetches
translate.googleapis.com/translate_a/l whenever translate is allowed by
policy, which it is unless the pref is managed. Measured on a Pixel 3: a GET
with key=dummytoken, answered 200.

The list only serves page translation, and TranslateManager already refuses
to translate without a Google API key, which this build does not have. So the
fetch now returns without a request when no key is configured, and the screen
keeps using the list built into Chromium. Upstream's fetch test opts back in
through a testing hook, and a new test checks that nothing is requested
without a key.
---
 components/translate/core/browser/BUILD.gn    |  1 +
 .../core/browser/translate_language_list.cc   | 19 +++++++++++++
 .../core/browser/translate_language_list.h    |  4 +++
 .../translate_language_list_unittest.cc       | 28 +++++++++++++++++++
 4 files changed, 52 insertions(+)

diff --git a/components/translate/core/browser/BUILD.gn b/components/translate/core/browser/BUILD.gn
index 77e130e4088..fd9f3c6c4c5 100644
--- a/components/translate/core/browser/BUILD.gn
+++ b/components/translate/core/browser/BUILD.gn
@@ -145,6 +145,7 @@ source_set("unit_tests") {
     "//components/ukm:test_support",
     "//components/variations",
     "//components/variations:test_support",
+    "//google_apis",
     "//net:test_support",
     "//services/metrics/public/cpp:metrics_cpp",
     "//services/metrics/public/cpp:ukm_builders",
diff --git a/components/translate/core/browser/translate_language_list.cc b/components/translate/core/browser/translate_language_list.cc
index a99374b961e..b3c1863ae3a 100644
--- a/components/translate/core/browser/translate_language_list.cc
+++ b/components/translate/core/browser/translate_language_list.cc
@@ -33,6 +33,7 @@
 #include "components/translate/core/browser/translate_url_util.h"
 #include "components/translate/core/common/translate_language_matcher.h"
 #include "components/translate/core/common/translate_util.h"
+#include "google_apis/google_api_keys.h"
 #include "net/base/url_util.h"
 #include "ui/base/l10n/l10n_util.h"
 #include "url/gurl.h"
@@ -273,7 +274,25 @@ GURL TranslateLanguageList::TranslateLanguageUrl() {
                             kLanguageListFetchPath}));
 }
 
+namespace {
+bool g_ignore_missing_key_for_testing = false;
+}  // namespace
+
+// static
+void TranslateLanguageList::SetIgnoreMissingKeyForTesting(bool ignore) {
+  g_ignore_missing_key_for_testing = ignore;
+}
+
 void TranslateLanguageList::RequestLanguageList() {
+  // Bare: the list comes from translate.googleapis.com and is only of use to
+  // page translation, which TranslateManager already refuses without a Google
+  // API key. Without one, keep the built-in list rather than ask Google for it.
+  if (!g_ignore_missing_key_for_testing &&
+      !::google_apis::HasAPIKeyConfigured()) {
+    request_pending_ = false;
+    return;
+  }
+
   // If resource requests are not allowed, we'll get a callback when they are.
   if (!resource_requests_allowed_) {
     request_pending_ = true;
diff --git a/components/translate/core/browser/translate_language_list.h b/components/translate/core/browser/translate_language_list.h
index 7dcbe460515..fdb3624e116 100644
--- a/components/translate/core/browser/translate_language_list.h
+++ b/components/translate/core/browser/translate_language_list.h
@@ -65,8 +65,12 @@ class TranslateLanguageList {
 
   // Fetches the language list from the translate server if resource requests
   // are allowed, and otherwise keeps the request as pending until allowed.
+  // Bare: does nothing without a Google API key; see the .cc file.
   void RequestLanguageList();
 
+  // Bare: lets tests exercise the fetch in a build without a Google API key.
+  static void SetIgnoreMissingKeyForTesting(bool ignore);
+
   // Sets whether requests are allowed. If |allowed| is true, this resumes any
   // pending request.
   void SetResourceRequestsAllowed(bool allowed);
diff --git a/components/translate/core/browser/translate_language_list_unittest.cc b/components/translate/core/browser/translate_language_list_unittest.cc
index 0a5f9c2946b..412a8245396 100644
--- a/components/translate/core/browser/translate_language_list_unittest.cc
+++ b/components/translate/core/browser/translate_language_list_unittest.cc
@@ -18,6 +18,7 @@
 #include "components/translate/core/browser/translate_url_fetcher.h"
 #include "components/translate/core/browser/translate_url_util.h"
 #include "components/variations/scoped_variations_ids_provider.h"
+#include "google_apis/google_api_keys.h"
 #include "services/network/public/cpp/weak_wrapper_shared_url_loader_factory.h"
 #include "services/network/test/test_url_loader_factory.h"
 #include "testing/gmock/include/gmock/gmock.h"
@@ -338,6 +339,7 @@ TEST_F(TranslateLanguageListTest, GetSupportedPartialTranslateLanguages) {
 // Check that we contact the translate server to update the supported language
 // list when translate is enabled by policy.
 TEST_F(TranslateLanguageListTest, GetSupportedLanguagesFetch) {
+  TranslateLanguageList::SetIgnoreMissingKeyForTesting(true);
   // Set up fake network environment.
   base::test::TaskEnvironment task_environment;
   network::TestURLLoaderFactory test_url_loader_factory;
@@ -385,6 +387,32 @@ TEST_F(TranslateLanguageListTest, GetSupportedLanguagesFetch) {
   language_list.GetSupportedLanguages(true /* translate_allowed */, &languages);
   EXPECT_EQ(std::vector<std::string>(1, "it"), languages);
 
+  TranslateDownloadManager::GetInstance()->ResetForTesting();
+  TranslateLanguageList::SetIgnoreMissingKeyForTesting(false);
+}
+
+// Bare: without a Google API key nothing is fetched, even with translate
+// allowed, and the built-in list is still returned.
+TEST_F(TranslateLanguageListTest, GetSupportedLanguagesNoFetchWithoutApiKey) {
+  ASSERT_FALSE(::google_apis::HasAPIKeyConfigured());
+  base::test::TaskEnvironment task_environment;
+  network::TestURLLoaderFactory test_url_loader_factory;
+  scoped_refptr<network::SharedURLLoaderFactory> test_shared_loader_factory =
+      base::MakeRefCounted<network::WeakWrapperSharedURLLoaderFactory>(
+          &test_url_loader_factory);
+  TranslateDownloadManager::GetInstance()->set_application_locale("en");
+  TranslateDownloadManager::GetInstance()->set_url_loader_factory(
+      test_shared_loader_factory);
+
+  std::vector<std::string> languages;
+  TranslateLanguageList language_list;
+  language_list.SetResourceRequestsAllowed(true);
+  language_list.GetSupportedLanguages(true /* translate_allowed */, &languages);
+
+  EXPECT_FALSE(language_list.HasOngoingLanguageListLoadingForTesting());
+  EXPECT_TRUE(test_url_loader_factory.pending_requests()->empty());
+  EXPECT_FALSE(languages.empty());
+
   TranslateDownloadManager::GetInstance()->ResetForTesting();
 }
 

From c1ba735829842db42c291bb793632d6904039d08 Mon Sep 17 00:00:00 2001
From: Bare <git@barebrowser.org>
Date: Tue, 13 Oct 2026 01:43:52 +0000
Subject: [PATCH] Patch 0000154

---
 components/feed/core/v2/public/feed_service.cc | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/components/feed/core/v2/public/feed_service.cc b/components/feed/core/v2/public/feed_service.cc
index 6eafd73f819..01c5cd825f7 100644
--- a/components/feed/core/v2/public/feed_service.cc
+++ b/components/feed/core/v2/public/feed_service.cc
@@ -334,7 +334,13 @@ const std::string& FeedService::GetFeedLaunchCuiMetadata() const {
 
 // static
 bool FeedService::IsEnabled(const PrefService& pref_service) {
-  return pref_service.GetBoolean(feed::prefs::kEnableSnippets);
+  // Bare: no Discover. The feed asks discover-pa.googleapis.com for stories on
+  // every new tab page while Google is the search engine, and without a Google
+  // API key or a signed-in account the request can only fail, leaving a "Can't
+  // refresh Discover" card. The Java side asks this too, through
+  // FeedServiceBridge, so the new tab page leaves the feed out and nothing is
+  // fetched. The policy that used to switch it on has nothing to switch.
+  return false;
 }
 
 // static

diff --git a/chrome/android/java/src/org/chromium/chrome/browser/bare/settings/BareToolbarActionUi.java b/chrome/android/java/src/org/chromium/chrome/browser/bare/settings/BareToolbarActionUi.java
new file mode 100644
index 00000000000..3de2cad8289
--- /dev/null
+++ b/chrome/android/java/src/org/chromium/chrome/browser/bare/settings/BareToolbarActionUi.java
@@ -0,0 +1,94 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.bare.settings;
+
+import androidx.annotation.DrawableRes;
+import androidx.annotation.StringRes;
+
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.chrome.R;
+import org.chromium.chrome.browser.ui.actions.ActionId;
+import org.chromium.chrome.browser.ui.bottombar.BareToolbarSlot;
+
+/**
+ * What each toolbar button is called and what it looks like, for the screen that arranges them.
+ *
+ * <p>The icons are the ones the real bar uses, so the picture in settings is the toolbar rather
+ * than an illustration of it. They are named here rather than read from the bar because the bar
+ * gets them from the running browser: the providers behind Share, Translate and Bookmark exist
+ * only where there is a tab to act on, and settings has none.
+ *
+ * <p>The names are the buttons' names, not descriptions of what pressing them does. Someone
+ * arranging a toolbar is choosing between things to put in a row, and "Share this page" reads as
+ * an instruction rather than as the label of the thing being moved.
+ */
+@NullMarked
+public final class BareToolbarActionUi {
+    private BareToolbarActionUi() {}
+
+    /** The name shown for an action. */
+    public static @StringRes int labelFor(@ActionId int actionId) {
+        switch (actionId) {
+            case ActionId.HOME_BUTTON:
+                return R.string.bare_toolbar_action_home;
+            case ActionId.INCOGNITO:
+                return R.string.bare_toolbar_action_incognito;
+            case ActionId.APP_MENU:
+                return R.string.bare_toolbar_action_app_menu;
+            case ActionId.SHARE:
+                return R.string.bare_toolbar_action_share;
+            case ActionId.TRANSLATE:
+                // Already exactly this word in the adaptive toolbar's own chooser.
+                return R.string.adaptive_toolbar_button_preference_translate;
+            case ActionId.BOOKMARK:
+                return R.string.bare_toolbar_action_bookmark;
+            case ActionId.NEW_TAB:
+                return R.string.button_new_tab;
+            default:
+                return R.string.tab_switcher_button_label;
+        }
+    }
+
+    /** The icon shown for an action, the same drawable the toolbar itself uses. */
+    public static @DrawableRes int iconFor(@ActionId int actionId) {
+        switch (actionId) {
+            case ActionId.HOME_BUTTON:
+                return R.drawable.ic_home_24dp;
+            case ActionId.INCOGNITO:
+                return R.drawable.ic_incognito_24dp;
+            case ActionId.APP_MENU:
+                return R.drawable.ic_more_vert_24dp;
+            case ActionId.SHARE:
+                return R.drawable.ic_toolbar_share_offset_24dp;
+            case ActionId.TRANSLATE:
+                return R.drawable.ic_translate;
+            case ActionId.BOOKMARK:
+                // The empty star. Whether a page is bookmarked is a fact about a page, and this
+                // picture is not of any page.
+                return R.drawable.ic_star_24dp;
+            case ActionId.NEW_TAB:
+                return R.drawable.new_tab_icon;
+            default:
+                return R.drawable.btn_tabswitcher_modern;
+        }
+    }
+
+    /**
+     * What to call a position out loud.
+     *
+     * <p>Positions are described by where they are, because that is all they are to the person
+     * using them. The names the code uses for them say what they used to hold.
+     */
+    public static @StringRes int positionNameFor(@BareToolbarSlot int slot) {
+        switch (slot) {
+            case BareToolbarSlot.HOME:
+                return R.string.bare_toolbar_position_first;
+            case BareToolbarSlot.EXTRA:
+                return R.string.bare_toolbar_position_second;
+            default:
+                return R.string.bare_toolbar_position_last;
+        }
+    }
+}
diff --git a/chrome/android/java/src/org/chromium/chrome/browser/bare/settings/BareToolbarPreviewPreference.java b/chrome/android/java/src/org/chromium/chrome/browser/bare/settings/BareToolbarPreviewPreference.java
new file mode 100644
index 00000000000..a5c18ed4ec9
--- /dev/null
+++ b/chrome/android/java/src/org/chromium/chrome/browser/bare/settings/BareToolbarPreviewPreference.java
@@ -0,0 +1,130 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.bare.settings;
+
+import android.content.Context;
+import android.content.res.ColorStateList;
+import android.util.AttributeSet;
+import android.view.View;
+import android.widget.ImageView;
+
+import androidx.core.widget.ImageViewCompat;
+import androidx.preference.Preference;
+import androidx.preference.PreferenceViewHolder;
+
+import org.chromium.base.Callback;
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.chrome.R;
+import org.chromium.chrome.browser.ui.actions.ActionId;
+import org.chromium.chrome.browser.ui.bottombar.BareToolbarLayout;
+import org.chromium.chrome.browser.ui.bottombar.BareToolbarSlot;
+import org.chromium.components.browser_ui.styles.SemanticColorUtils;
+
+/**
+ * A picture of the bottom bar, with the three positions the user can change made pressable.
+ *
+ * <p>Shown instead of three rows naming three positions, because the thing being arranged is a row
+ * of buttons and a list is a poor drawing of one. Pressing a button in the picture is the same
+ * gesture as pressing it on the toolbar, which is where the user has seen it.
+ *
+ * <p>It is a picture and not the toolbar. The real buttons know whether the page is bookmarked and
+ * whether it can be translated; those answers belong to a tab, and there is no tab here. What it
+ * shows is which button is where.
+ */
+@NullMarked
+public class BareToolbarPreviewPreference extends Preference {
+
+    private static final @BareToolbarSlot int[] CONFIGURABLE_SLOTS = {
+        BareToolbarSlot.HOME, BareToolbarSlot.EXTRA, BareToolbarSlot.APP_MENU
+    };
+
+    private @Nullable Callback<Integer> mOnSlotClicked;
+    private @Nullable View mRoot;
+
+    public BareToolbarPreviewPreference(Context context, @Nullable AttributeSet attrs) {
+        super(context, attrs);
+        setLayoutResource(R.layout.bare_toolbar_preview);
+        setSelectable(false);
+    }
+
+    /** Called with the slot the user pressed. */
+    public void setOnSlotClicked(Callback<Integer> callback) {
+        mOnSlotClicked = callback;
+    }
+
+    /** Redraws from the current arrangement. */
+    public void refresh() {
+        if (mRoot != null) bind(mRoot);
+    }
+
+    @Override
+    public void onBindViewHolder(PreferenceViewHolder holder) {
+        super.onBindViewHolder(holder);
+        mRoot = holder.itemView;
+        bind(holder.itemView);
+    }
+
+    private void bind(View root) {
+        for (@BareToolbarSlot int slot : CONFIGURABLE_SLOTS) {
+            ImageView view = root.findViewById(viewIdForSlot(slot));
+            @ActionId int actionId = BareToolbarLayout.actionForSlot(slot);
+
+            setIcon(view, actionId);
+            view.setContentDescription(
+                    getContext()
+                            .getString(
+                                    R.string.bare_toolbar_position_description,
+                                    getContext()
+                                            .getString(
+                                                    BareToolbarActionUi.positionNameFor(slot)),
+                                    getContext()
+                                            .getString(
+                                                    BareToolbarActionUi.labelFor(actionId))));
+            view.setOnClickListener(
+                    v -> {
+                        if (mOnSlotClicked != null) mOnSlotClicked.onResult(slot);
+                    });
+        }
+
+        bindFixed(root, R.id.bare_preview_new_tab, ActionId.NEW_TAB);
+        bindFixed(root, R.id.bare_preview_tab_switcher, ActionId.TAB_SWITCHER);
+    }
+
+    /** The two positions the user cannot change are drawn, and say so if asked. */
+    private void bindFixed(View root, int viewId, @ActionId int actionId) {
+        ImageView view = root.findViewById(viewId);
+        setIcon(view, actionId);
+        view.setContentDescription(
+                getContext()
+                        .getString(
+                                R.string.bare_toolbar_position_fixed_description,
+                                getContext().getString(BareToolbarActionUi.labelFor(actionId))));
+    }
+
+    /**
+     * Draws one icon in the colour the toolbar's icons are drawn in.
+     *
+     * <p>Tinted rather than taken as-is because several of these are black assets that the real
+     * bar tints as it draws them; shown untinted they would be the only dark things on the page.
+     */
+    private void setIcon(ImageView view, @ActionId int actionId) {
+        view.setImageResource(BareToolbarActionUi.iconFor(actionId));
+        ImageViewCompat.setImageTintList(
+                view,
+                ColorStateList.valueOf(SemanticColorUtils.getDefaultIconColor(getContext())));
+    }
+
+    private static int viewIdForSlot(@BareToolbarSlot int slot) {
+        switch (slot) {
+            case BareToolbarSlot.HOME:
+                return R.id.bare_preview_slot_home;
+            case BareToolbarSlot.EXTRA:
+                return R.id.bare_preview_slot_extra;
+            default:
+                return R.id.bare_preview_slot_app_menu;
+        }
+    }
+}
diff --git a/chrome/android/java/src/org/chromium/chrome/browser/bare/settings/BareToolbarSettingsFragment.java b/chrome/android/java/src/org/chromium/chrome/browser/bare/settings/BareToolbarSettingsFragment.java
new file mode 100644
index 00000000000..3b4ef3689c9
--- /dev/null
+++ b/chrome/android/java/src/org/chromium/chrome/browser/bare/settings/BareToolbarSettingsFragment.java
@@ -0,0 +1,113 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.bare.settings;
+
+import android.content.Context;
+import android.os.Bundle;
+
+import androidx.appcompat.app.AlertDialog;
+import androidx.preference.Preference;
+
+import org.chromium.base.supplier.MonotonicObservableSupplier;
+import org.chromium.base.supplier.ObservableSuppliers;
+import org.chromium.base.supplier.SettableMonotonicObservableSupplier;
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.chrome.R;
+import org.chromium.chrome.browser.settings.ChromeBaseSettingsFragment;
+import org.chromium.chrome.browser.ui.actions.ActionId;
+import org.chromium.chrome.browser.ui.bottombar.BareToolbarDefaults;
+import org.chromium.chrome.browser.ui.bottombar.BareToolbarLayout;
+import org.chromium.chrome.browser.ui.bottombar.BareToolbarPrefs;
+import org.chromium.chrome.browser.ui.bottombar.BareToolbarSlot;
+import org.chromium.components.browser_ui.settings.SettingsUtils;
+
+/**
+ * Lets the user choose which button sits in each of the three positions the bottom bar leaves open.
+ *
+ * <p>The screen writes preferences and nothing else. The bar is listening for them and rebuilds
+ * itself, so there is no path from here into the browser and nothing to keep in step: what the
+ * user sees when they go back is the same arrangement read the same way.
+ *
+ * <p>Opening the screen writes nothing. An arrangement nobody has changed is the absence of any
+ * preference, and recording today's defaults would turn a build's opinion into the user's.
+ */
+@NullMarked
+public class BareToolbarSettingsFragment extends ChromeBaseSettingsFragment {
+
+    static final String PREF_PREVIEW = "bare_toolbar_preview";
+    static final String PREF_RESET = "bare_toolbar_reset";
+
+    private final SettableMonotonicObservableSupplier<String> mPageTitle =
+            ObservableSuppliers.createMonotonic();
+
+    private @Nullable BareToolbarPreviewPreference mPreview;
+
+    @Override
+    public void onCreatePreferences(@Nullable Bundle savedInstanceState, @Nullable String rootKey) {
+        mPageTitle.set(getTitle(getContext()));
+        SettingsUtils.addPreferencesFromResource(this, R.xml.bare_toolbar_preferences);
+
+        mPreview = (BareToolbarPreviewPreference) findPreference(PREF_PREVIEW);
+        assert mPreview != null;
+        mPreview.setOnSlotClicked(this::showActionChooser);
+
+        Preference reset = findPreference(PREF_RESET);
+        assert reset != null;
+        reset.setOnPreferenceClickListener(
+                pref -> {
+                    BareToolbarPrefs.resetAll();
+                    assert mPreview != null;
+                    mPreview.refresh();
+                    return true;
+                });
+    }
+
+    /**
+     * Offers the buttons that can go in a position, with the one already there marked.
+     *
+     * <p>A radio list rather than anything cleverer: there are six of them, exactly one can be
+     * chosen, and this is the shape settings uses everywhere else for that.
+     */
+    private void showActionChooser(@BareToolbarSlot int slot) {
+        @ActionId int[] catalogue = BareToolbarDefaults.CATALOGUE;
+        CharSequence[] labels = new CharSequence[catalogue.length];
+        int checked = -1;
+        @ActionId int current = BareToolbarLayout.actionForSlot(slot);
+        for (int i = 0; i < catalogue.length; i++) {
+            labels[i] = getString(BareToolbarActionUi.labelFor(catalogue[i]));
+            if (catalogue[i] == current) checked = i;
+        }
+
+        new AlertDialog.Builder(getContext(), R.style.ThemeOverlay_BrowserUI_AlertDialog)
+                .setTitle(R.string.bare_toolbar_settings_choose_action)
+                .setSingleChoiceItems(
+                        labels,
+                        checked,
+                        (dialog, which) -> {
+                            // Swaps when the chosen button is already somewhere else, so the bar
+                            // keeps the same buttons and only their order changes.
+                            BareToolbarPrefs.assignPrimaryAction(slot, catalogue[which]);
+                            if (mPreview != null) mPreview.refresh();
+                            dialog.dismiss();
+                        })
+                .setNegativeButton(R.string.cancel, null)
+                .show();
+    }
+
+    @Override
+    public MonotonicObservableSupplier<String> getPageTitle() {
+        return mPageTitle;
+    }
+
+    public static String getTitle(Context context) {
+        return context.getString(R.string.bare_toolbar_settings_title);
+    }
+
+    @Override
+    public @AnimationType int getAnimationType() {
+        return AnimationType.PROPERTY;
+    }
+}

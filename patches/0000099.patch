+    /**
+     * Puts an action in a slot, and moves whatever was there into the slot the action came from.
+     *
+     * <p>A swap rather than an overwrite, because the alternative is worse in both directions: the
+     * bar cannot show the same action twice, so overwriting would have to drop one of them, and
+     * dropping the one the user did not just touch is the surprising half of the choice. Swapping
+     * keeps the set of actions on the bar the same and only changes where they are, which is what
+     * dragging one onto another would do.
+     *
+     * <p>An action that is not currently on the bar simply takes the slot, and whatever was there
+     * leaves. Nothing is displaced because nothing has to be.
+     *
+     * <p>Both slots are written before anything is told to look again, so nobody sees the moment
+     * in between where the same action is in two places.
+     */
+    public static void assignPrimaryAction(@BareToolbarSlot int slot, @ActionId int actionId) {
+        if (!BareToolbarDefaults.isConfigurable(slot)) return;
+        if (!BareToolbarDefaults.isConfigurableAction(actionId)) return;
+
+        @ActionId int displaced = BareToolbarLayout.actionForSlot(slot);
+        if (displaced == actionId) return;
+
+        @BareToolbarSlot int cameFrom = BareToolbarLayout.slotForAction(actionId);
+
+        write(slot, actionId);
+        if (cameFrom != BareToolbarSlot.NONE
+                && cameFrom != slot
+                && BareToolbarDefaults.isConfigurable(cameFrom)) {
+            write(cameFrom, displaced);
+        }
+        BareToolbarLayout.invalidate();
+    }

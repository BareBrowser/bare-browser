+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.ui.bottombar;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertNotEquals;
+import static org.junit.Assert.assertTrue;
+
+import org.junit.After;
+import org.junit.Before;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+
+import org.chromium.base.shared_preferences.SharedPreferencesManager;
+import org.chromium.base.test.BaseRobolectricTestRunner;
+import org.chromium.chrome.browser.preferences.ChromePreferenceKeys;
+import org.chromium.chrome.browser.preferences.ChromeSharedPreferences;
+import org.chromium.chrome.browser.ui.actions.ActionId;
+
+/**
+ * Unit tests for {@link BareToolbarPrefs}, and in particular for what happens when the user picks
+ * a button that is already somewhere else.
+ */
+@RunWith(BaseRobolectricTestRunner.class)
+public class BareToolbarPrefsUnitTest {
+
+    private SharedPreferencesManager mPrefs;
+
+    @Before
+    public void setUp() {
+        mPrefs = ChromeSharedPreferences.getInstance();
+        clear();
+    }
+
+    @After
+    public void tearDown() {
+        clear();
+    }
+
+    private void clear() {
+        for (int slot = 0; slot < BareToolbarSlot.COUNT; slot++) {
+            mPrefs.removeKey(ChromePreferenceKeys.BOTTOM_BAR_SLOT_PRIMARY_ACTION.createKey(slot));
+        }
+        BareToolbarLayout.invalidate();
+    }
+
+    private void assertBar(int home, int extra, int appMenu) {
+        assertEquals(home, BareToolbarLayout.actionForSlot(BareToolbarSlot.HOME));
+        assertEquals(extra, BareToolbarLayout.actionForSlot(BareToolbarSlot.EXTRA));
+        assertEquals(appMenu, BareToolbarLayout.actionForSlot(BareToolbarSlot.APP_MENU));
+        assertNotEquals(home, extra);
+        assertNotEquals(home, appMenu);
+        assertNotEquals(extra, appMenu);
+    }
+
+    @Test
+    public void testChoosingAnUnusedActionJustTakesTheSlot() {
+        BareToolbarPrefs.assignPrimaryAction(BareToolbarSlot.HOME, ActionId.BOOKMARK);
+        assertBar(ActionId.BOOKMARK, ActionId.INCOGNITO, ActionId.APP_MENU);
+    }
+
+    @Test
+    public void testChoosingAnActionFromAnotherSlotSwapsThem() {
+        // Home | Incognito | App menu, then Share is put in the last slot and Home in the first is
+        // asked for Share: the two trade places rather than one of them disappearing.
+        BareToolbarPrefs.assignPrimaryAction(BareToolbarSlot.APP_MENU, ActionId.SHARE);
+        assertBar(ActionId.HOME_BUTTON, ActionId.INCOGNITO, ActionId.SHARE);
+
+        // Home and Share trade places: Share takes the first slot and Home goes to the one
+        // Share came from. The app menu is not involved; it left the bar when Share took its slot.
+        BareToolbarPrefs.assignPrimaryAction(BareToolbarSlot.HOME, ActionId.SHARE);
+        assertBar(ActionId.SHARE, ActionId.INCOGNITO, ActionId.HOME_BUTTON);
+    }
+
+    @Test
+    public void testSwappingWithADefaultThatWasNeverWritten() {
+        // Nothing is stored for the spare slot, so what it holds is only the default. Choosing
+        // that action elsewhere still has to move it, or the bar would show it twice.
+        BareToolbarPrefs.assignPrimaryAction(BareToolbarSlot.HOME, ActionId.INCOGNITO);
+        assertBar(ActionId.INCOGNITO, ActionId.HOME_BUTTON, ActionId.APP_MENU);
+    }
+
+    @Test
+    public void testNoSequenceOfChoicesCanProduceADuplicate() {
+        @ActionId int[] catalogue = BareToolbarDefaults.CATALOGUE;
+        @BareToolbarSlot int[] slots = {
+            BareToolbarSlot.HOME, BareToolbarSlot.EXTRA, BareToolbarSlot.APP_MENU
+        };
+        // Every action into every slot, in every order the loops produce.
+        for (int round = 0; round < 3; round++) {
+            for (@BareToolbarSlot int slot : slots) {
+                for (@ActionId int action : catalogue) {
+                    BareToolbarPrefs.assignPrimaryAction(slot, action);
+                    assertEquals(
+                            "the chosen action should be in the slot it was chosen for",
+                            action,
+                            BareToolbarLayout.actionForSlot(slot));
+                    assertBar(
+                            BareToolbarLayout.actionForSlot(BareToolbarSlot.HOME),
+                            BareToolbarLayout.actionForSlot(BareToolbarSlot.EXTRA),
+                            BareToolbarLayout.actionForSlot(BareToolbarSlot.APP_MENU));
+                }
+            }
+        }
+    }
+
+    @Test
+    public void testChoosingWhatIsAlreadyThereChangesNothing() {
+        BareToolbarPrefs.assignPrimaryAction(BareToolbarSlot.HOME, ActionId.HOME_BUTTON);
+        assertBar(ActionId.HOME_BUTTON, ActionId.INCOGNITO, ActionId.APP_MENU);
+        assertFalse(
+                "choosing the button already there should not record anything",
+                BareToolbarPrefs.hasPrimaryAction(BareToolbarSlot.HOME));
+    }
+
+    @Test
+    public void testAnActionBareDoesNotOfferIsRefused() {
+        BareToolbarPrefs.assignPrimaryAction(BareToolbarSlot.HOME, ActionId.GLIC);
+        BareToolbarPrefs.assignPrimaryAction(BareToolbarSlot.HOME, 99);
+        assertBar(ActionId.HOME_BUTTON, ActionId.INCOGNITO, ActionId.APP_MENU);
+        assertFalse(BareToolbarPrefs.hasPrimaryAction(BareToolbarSlot.HOME));
+    }
+
+    @Test
+    public void testAFixedSlotCannotBeAssigned() {
+        BareToolbarPrefs.assignPrimaryAction(BareToolbarSlot.NEW_TAB, ActionId.SHARE);
+        BareToolbarPrefs.assignPrimaryAction(BareToolbarSlot.TAB_SWITCHER, ActionId.SHARE);
+        assertEquals(ActionId.NEW_TAB, BareToolbarLayout.actionForSlot(BareToolbarSlot.NEW_TAB));
+        assertEquals(
+                ActionId.TAB_SWITCHER,
+                BareToolbarLayout.actionForSlot(BareToolbarSlot.TAB_SWITCHER));
+        assertFalse(BareToolbarPrefs.hasPrimaryAction(BareToolbarSlot.NEW_TAB));
+    }
+
+    @Test
+    public void testResetForgetsEveryChoice() {
+        BareToolbarPrefs.assignPrimaryAction(BareToolbarSlot.HOME, ActionId.BOOKMARK);
+        BareToolbarPrefs.assignPrimaryAction(BareToolbarSlot.EXTRA, ActionId.TRANSLATE);
+        BareToolbarPrefs.assignPrimaryAction(BareToolbarSlot.APP_MENU, ActionId.SHARE);
+        assertBar(ActionId.BOOKMARK, ActionId.TRANSLATE, ActionId.SHARE);
+
+        BareToolbarPrefs.resetAll();
+
+        for (int slot = 0; slot < BareToolbarSlot.COUNT; slot++) {
+            assertFalse(
+                    "reset should remove the key rather than record a default",
+                    mPrefs.contains(
+                            ChromePreferenceKeys.BOTTOM_BAR_SLOT_PRIMARY_ACTION.createKey(slot)));
+        }
+        assertBar(ActionId.HOME_BUTTON, ActionId.INCOGNITO, ActionId.APP_MENU);
+    }
+
+    @Test
+    public void testAWriteIsVisibleImmediately() {
+        // The resolved arrangement is held on to, so a write that did not clear it would not be
+        // seen until the next launch.
+        assertEquals(ActionId.HOME_BUTTON, BareToolbarLayout.actionForSlot(BareToolbarSlot.HOME));
+        BareToolbarPrefs.assignPrimaryAction(BareToolbarSlot.HOME, ActionId.SHARE);
+        assertEquals(ActionId.SHARE, BareToolbarLayout.actionForSlot(BareToolbarSlot.HOME));
+        assertTrue(BareToolbarPrefs.hasPrimaryAction(BareToolbarSlot.HOME));
+    }
+}

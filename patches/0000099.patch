+package org.chromium.chrome.browser.bare.settings;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertNotEquals;
+import static org.junit.Assert.assertNotNull;
+import static org.junit.Assert.assertTrue;
+
+import android.content.Context;
+import android.content.res.XmlResourceParser;
+import android.view.ContextThemeWrapper;
+import android.view.View;
+
+import androidx.test.core.app.ApplicationProvider;
+
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.xmlpull.v1.XmlPullParser;
+
+import org.chromium.base.test.BaseRobolectricTestRunner;
+import org.chromium.chrome.R;
+import org.chromium.chrome.browser.ui.actions.ActionId;
+import org.chromium.chrome.browser.ui.bottombar.BareToolbarDefaults;
+import org.chromium.chrome.browser.ui.bottombar.BareToolbarSlot;
+
+/** Unit tests for the toolbar settings screen's names, icons and entry point. */
+@RunWith(BaseRobolectricTestRunner.class)
+public class BareToolbarSettingsUnitTest {
+
+    private final Context mContext = ApplicationProvider.getApplicationContext();
+
+    @Test
+    public void testAppearanceOffersTheToolbarScreen() {
+        assertTrue(
+                "Appearance should have a Toolbar entry pointing at the toolbar screen",
+                appearanceXmlContains(
+                        "bare_toolbar", BareToolbarSettingsFragment.class.getName()));
+    }
+
+    /** Walks the Appearance screen's XML looking for a preference with the given key and fragment. */
+    private boolean appearanceXmlContains(String key, String fragment) {
+        try (XmlResourceParser parser =
+                mContext.getResources().getXml(R.xml.appearance_preferences)) {
+            int event = parser.getEventType();
+            while (event != XmlPullParser.END_DOCUMENT) {
+                if (event == XmlPullParser.START_TAG) {
+                    String foundKey = null;
+                    String foundFragment = null;
+                    for (int i = 0; i < parser.getAttributeCount(); i++) {
+                        String name = parser.getAttributeName(i);
+                        if ("key".equals(name)) foundKey = parser.getAttributeValue(i);
+                        if ("fragment".equals(name)) foundFragment = parser.getAttributeValue(i);
+                    }
+                    if (key.equals(foundKey) && fragment.equals(foundFragment)) return true;
+                }
+                event = parser.next();
+            }
+        } catch (Exception e) {
+            throw new AssertionError("could not read the Appearance screen", e);
+        }
+        return false;
+    }
+
+    @Test
+    public void testEveryActionTheUserCanChooseHasANameAndAnIcon() {
+        for (@ActionId int action : BareToolbarDefaults.CATALOGUE) {
+            String label = mContext.getString(BareToolbarActionUi.labelFor(action));
+            assertNotNull(label);
+            assertNotEquals("action " + action + " has no name", "", label.trim());
+            assertNotEquals(
+                    "action " + action + " has no icon",
+                    0,
+                    BareToolbarActionUi.iconFor(action));
+            assertNotNull(
+                    "action " + action + " icon does not resolve",
+                    mContext.getDrawable(BareToolbarActionUi.iconFor(action)));
+        }
+    }
+
+    @Test
+    public void testTheTwoFixedButtonsAreDrawnToo() {
+        for (@ActionId int action : new int[] {ActionId.NEW_TAB, ActionId.TAB_SWITCHER}) {
+            assertNotNull(mContext.getDrawable(BareToolbarActionUi.iconFor(action)));
+            assertNotEquals("", mContext.getString(BareToolbarActionUi.labelFor(action)).trim());
+        }
+    }
+
+    @Test
+    public void testNamesAreTheButtonsNamesRatherThanInternalOnes() {
+        assertEquals("Home", mContext.getString(BareToolbarActionUi.labelFor(ActionId.HOME_BUTTON)));
+        assertEquals(
+                "Incognito", mContext.getString(BareToolbarActionUi.labelFor(ActionId.INCOGNITO)));
+        assertEquals(
+                "App menu", mContext.getString(BareToolbarActionUi.labelFor(ActionId.APP_MENU)));
+        assertEquals("Share", mContext.getString(BareToolbarActionUi.labelFor(ActionId.SHARE)));
+        assertEquals(
+                "Translate", mContext.getString(BareToolbarActionUi.labelFor(ActionId.TRANSLATE)));
+        assertEquals(
+                "Bookmark", mContext.getString(BareToolbarActionUi.labelFor(ActionId.BOOKMARK)));
+    }
+
+    @Test
+    public void testPositionsAreDescribedByWhereTheyAreNotByWhatTheyUsedToHold() {
+        String first = mContext.getString(
+                BareToolbarActionUi.positionNameFor(BareToolbarSlot.HOME));
+        String second = mContext.getString(
+                BareToolbarActionUi.positionNameFor(BareToolbarSlot.EXTRA));
+        String last = mContext.getString(
+                BareToolbarActionUi.positionNameFor(BareToolbarSlot.APP_MENU));
+
+        assertNotEquals(first, second);
+        assertNotEquals(second, last);
+        for (String name : new String[] {first, second, last}) {
+            String lower = name.toLowerCase(java.util.Locale.US);
+            assertTrue("a position should be named by where it is: " + name,
+                    lower.contains("toolbar button"));
+            assertNotEquals("a position should not be named after an action", "extra", lower);
+        }
+
+        // The accessibility text a position ends up with reads as a place and a button.
+        String described =
+                mContext.getString(
+                        R.string.bare_toolbar_position_description,
+                        first,
+                        mContext.getString(BareToolbarActionUi.labelFor(ActionId.BOOKMARK)));
+        assertEquals("First toolbar button: Bookmark", described);
+    }
+
+    @Test
+    public void testTheFixedPositionsSayTheyCannotBeChanged() {
+        String described =
+                mContext.getString(
+                        R.string.bare_toolbar_position_fixed_description,
+                        mContext.getString(BareToolbarActionUi.labelFor(ActionId.NEW_TAB)));
+        assertTrue(described, described.contains("cannot be changed"));
+    }
+
+    @Test
+    public void testThePreviewLayoutHasAViewForEveryPosition() {
+        // A themed context, because the pressable positions take their ripple from the theme.
+        Context themed =
+                new ContextThemeWrapper(mContext, R.style.Theme_BrowserUI_DayNight);
+        View preview =
+                android.view.LayoutInflater.from(themed)
+                        .inflate(R.layout.bare_toolbar_preview, null, false);
+        assertNotNull(preview.findViewById(R.id.bare_preview_slot_home));
+        assertNotNull(preview.findViewById(R.id.bare_preview_slot_extra));
+        assertNotNull(preview.findViewById(R.id.bare_preview_slot_app_menu));
+        assertNotNull(preview.findViewById(R.id.bare_preview_new_tab));
+        assertNotNull(preview.findViewById(R.id.bare_preview_tab_switcher));
+
+        // The two the user cannot change do not respond to a press.
+        assertTrue(preview.findViewById(R.id.bare_preview_slot_home).isClickable());
+        assertTrue(!preview.findViewById(R.id.bare_preview_new_tab).isClickable());
+        assertTrue(!preview.findViewById(R.id.bare_preview_tab_switcher).isClickable());
+    }
+}

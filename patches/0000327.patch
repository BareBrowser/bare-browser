+            ReadError::kNotBare);
+}
+
+TEST_F(BackupFileTest, Versions) {
+  EXPECT_EQ(ParseFile(RawFile(2, 2, 0, kFullJson)).error(),
+            ReadError::kNewerVersion);
+  EXPECT_EQ(ParseFile(RawFile(0xffff, 1, 0, "")).error(),
+            ReadError::kNewerVersion);
+  EXPECT_EQ(ParseFile(RawFile(0, 2, 0, kFullJson)).error(),
+            ReadError::kBadHeader);
+  EXPECT_TRUE(ParseFile(RawFile(1, 2, 0, kFullJson)).has_value());
+}
+
+TEST_F(BackupFileTest, BadFixedHeader) {
+  EXPECT_EQ(ParseFile(RawFile(1, 3, 0, kFullJson)).error(),
+            ReadError::kBadHeader);
+  EXPECT_EQ(ParseFile(RawFile(1, 0, 0, kFullJson)).error(),
+            ReadError::kBadHeader);
+  EXPECT_EQ(ParseFile(RawFile(1, 2, 1, kFullJson)).error(),
+            ReadError::kBadHeader);
+  // Kind byte says setup, JSON says full.
+  EXPECT_EQ(ParseFile(RawFile(1, 1, 0, kFullJson)).error(),
+            ReadError::kBadHeader);
+  // Empty header, and a length past the end of the file.
+  EXPECT_EQ(ParseFile(RawFile(1, 2, 0, "")).error(), ReadError::kBadHeader);
+  std::vector<uint8_t> file = RawFile(1, 2, 0, kFullJson);
+  file[12] += 1;
+  EXPECT_EQ(ParseFile(file).error(), ReadError::kBadHeader);
+  // Header over the limit.
+  std::string big = std::string(kFullJson);
+  big.insert(big.size() - 1, ",\"pad\":\"" +
+                                 std::string(kMaxHeaderJsonSize, 'x') + "\"");
+  EXPECT_EQ(ParseFile(RawFile(1, 2, 0, big)).error(), ReadError::kBadHeader);
+}
+
+TEST_F(BackupFileTest, BadHeaderJson) {
+  const char* const kBad[] = {
+      "not json",
+      "[]",
+      R"({"kind":"full"})",
+      R"({"kind":"full","kdf":{"name":"pbkdf2","log2_n":15,"r":8,"p":1,)"
+      R"("salt":"AAAAAAAAAAAAAAAAAAAAAA=="},"aead":{"name":"aes-256-gcm",)"
+      R"("chunk":65536,"nonce_prefix":"AAAAAAAAAA=="}})",
+      // N far too large for a phone.
+      R"({"kind":"full","kdf":{"name":"scrypt","log2_n":30,"r":8,"p":1,)"
+      R"("salt":"AAAAAAAAAAAAAAAAAAAAAA=="},"aead":{"name":"aes-256-gcm",)"
+      R"("chunk":65536,"nonce_prefix":"AAAAAAAAAA=="}})",
+      R"({"kind":"full","kdf":{"name":"scrypt","log2_n":15,"r":0,"p":1,)"
+      R"("salt":"AAAAAAAAAAAAAAAAAAAAAA=="},"aead":{"name":"aes-256-gcm",)"
+      R"("chunk":65536,"nonce_prefix":"AAAAAAAAAA=="}})",
+      // Salt one byte short.
+      R"({"kind":"full","kdf":{"name":"scrypt","log2_n":15,"r":8,"p":1,)"
+      R"("salt":"AAAAAAAAAAAAAAAAAAAA"},"aead":{"name":"aes-256-gcm",)"
+      R"("chunk":65536,"nonce_prefix":"AAAAAAAAAA=="}})",
+      R"({"kind":"full","kdf":{"name":"scrypt","log2_n":15,"r":8,"p":1,)"
+      R"("salt":"AAAAAAAAAAAAAAAAAAAAAA=="},"aead":{"name":"aes-256-gcm",)"
+      R"("chunk":10,"nonce_prefix":"AAAAAAAAAA=="}})",
+      R"({"kind":"full","kdf":{"name":"scrypt","log2_n":15,"r":8,"p":1,)"
+      R"("salt":"AAAAAAAAAAAAAAAAAAAAAA=="},"aead":{"name":"chacha",)"
+      R"("chunk":65536,"nonce_prefix":"AAAAAAAAAA=="}})",
+      // Description fields of the wrong type.
+      R"({"kind":"full","device_label":7,"kdf":{"name":"scrypt","log2_n":15,)"
+      R"("r":8,"p":1,"salt":"AAAAAAAAAAAAAAAAAAAAAA=="},"aead":{"name":)"
+      R"("aes-256-gcm","chunk":65536,"nonce_prefix":"AAAAAAAAAA=="}})",
+      R"({"kind":"full","contents":{"bookmarks":-1},"kdf":{"name":"scrypt",)"
+      R"("log2_n":15,"r":8,"p":1,"salt":"AAAAAAAAAAAAAAAAAAAAAA=="},"aead":)"
+      R"({"name":"aes-256-gcm","chunk":65536,"nonce_prefix":"AAAAAAAAAA=="}})",
+  };
+  for (const char* json : kBad) {
+    EXPECT_EQ(ParseFile(RawFile(1, 2, 0, json)).error(), ReadError::kBadHeader)
+        << json;
+  }
+  // A setup file needs its checksum.
+  EXPECT_EQ(ParseFile(RawFile(1, 1, 0, R"({"kind":"setup"})")).error(),
+            ReadError::kBadHeader);
+  EXPECT_EQ(ParseFile(RawFile(1, 1, 0,
+                              R"({"kind":"setup","body_sha256":"00"})"))
+                .error(),
+            ReadError::kBadHeader);
+}

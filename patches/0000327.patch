index 00000000000..0a5c3f0bb68
--- /dev/null
+++ b/chrome/browser/bare/backup/backup_file.h
@@ -0,0 +1,180 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_BARE_BACKUP_BACKUP_FILE_H_
+#define CHROME_BROWSER_BARE_BACKUP_BACKUP_FILE_H_
+
+#include <stddef.h>
+#include <stdint.h>
+
+#include <array>
+#include <map>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/containers/span.h"
+#include "base/types/expected.h"
+
+// A .bare file:
+//
+//   offset  size  field
+//   0       8     magic "BAREBKUP"
+//   8       2     format version, little-endian
+//   10      1     kind: 1 = setup, 2 = full
+//   11      1     flags, 0
+//   12      4     header length H, little-endian
+//   16      H     header JSON, UTF-8
+//   16+H    ...   body: a zip for setup files, the encrypted zip for full ones
+//
+// The header can be read without the passphrase. In a full file the 16 fixed
+// bytes and the header JSON are the associated data of every body chunk, so a
+// change to any of them fails decryption.
+namespace bare::backup {
+
+enum class Kind : uint8_t {
+  kSetup = 1,
+  kFull = 2,
+};
+
+inline constexpr uint16_t kFormatVersion = 1;
+inline constexpr size_t kFixedHeaderSize = 16;
+inline constexpr size_t kMaxHeaderJsonSize = 64 * 1024;
+// Cap on the zip inside the file, before encryption.
+inline constexpr size_t kMaxBodySize = 64 * 1024 * 1024;
+
+inline constexpr size_t kKeySize = 32;
+inline constexpr size_t kSaltSize = 16;
+inline constexpr size_t kNoncePrefixSize = 7;
+inline constexpr size_t kTagSize = 16;
+inline constexpr size_t kDefaultChunkSize = 64 * 1024;
+inline constexpr uint8_t kDefaultLog2N = 15;
+inline constexpr uint32_t kDefaultR = 8;
+inline constexpr uint32_t kDefaultP = 1;
+
+enum class ReadError {
+  // Too short, or the magic is wrong.
+  kNotBare,
+  // The format version is newer than this build reads.
+  kNewerVersion,
+  // The fixed header or the header JSON is malformed or inconsistent.
+  kBadHeader,
+  // Larger than any file Bare writes.
+  kTooLarge,
+  // A full file failed to decrypt. A wrong passphrase and a damaged or edited
+  // file look the same here.
+  kWrongCodeOrDamaged,
+  // A setup file whose body doesn't match its checksum, or a full file whose
+  // body is not a whole number of chunks.
+  kDamaged,
+};
+
+struct KdfParams {
+  uint8_t log2_n = kDefaultLog2N;
+  uint32_t r = kDefaultR;
+  uint32_t p = kDefaultP;
+  std::array<uint8_t, kSaltSize> salt = {};
+};
+
+struct AeadParams {
+  uint32_t chunk_size = kDefaultChunkSize;
+  std::array<uint8_t, kNoncePrefixSize> nonce_prefix = {};
+};
+
+// What the restore screen shows before asking for anything.
+struct Description {
+  std::string created;
+  std::string bare_version;
+  int bare_version_code = 0;
+  // Build.MODEL only.
+  std::string device_label;
+  // Section name to item count, for example "bookmarks" -> 812.
+  std::map<std::string, int> contents;
+};
+
+struct ParsedFile {
+  ParsedFile();
+  ParsedFile(ParsedFile&&);
+  ParsedFile& operator=(ParsedFile&&);
+  ~ParsedFile();
+
+  Kind kind = Kind::kSetup;
+  uint16_t format_version = 0;
+  Description description;
+  // Full files only.
+  KdfParams kdf;
+  AeadParams aead;
+  // Setup files only: SHA-256 of the body.
+  std::array<uint8_t, 32> body_sha256 = {};
+
+  // Both point into the buffer given to ParseFile(), which must outlive this.
+  // `header` is the fixed part and the header JSON, the associated data.
+  base::span<const uint8_t> header;
+  base::span<const uint8_t> body;
+};
+
+// Holds a derived key and wipes it on destruction.
+class Key {
+ public:
+  Key();
+  Key(Key&& other);
+  Key& operator=(Key&& other);
+  Key(const Key&) = delete;
+  Key& operator=(const Key&) = delete;
+  ~Key();
+
+  base::span<const uint8_t, kKeySize> bytes() const { return bytes_; }
+
+ private:
+  friend std::optional<Key> DeriveKey(base::span<const uint8_t> passphrase,
+                                      const KdfParams& params);
+  std::array<uint8_t, kKeySize> bytes_ = {};
+};
+
+// Default cost with a fresh random salt.
+KdfParams NewKdfParams();
+
+// Fresh random nonce prefix, default chunk size.
+AeadParams NewAeadParams();
+
+// scrypt over `passphrase`. Returns nullopt if the parameters are out of the
+// range ParseFile() accepts or scrypt fails, for example on memory.
+std::optional<Key> DeriveKey(base::span<const uint8_t> passphrase,
+                             const KdfParams& params);
+
+// Reads the fixed header and the header JSON and checks them. Doesn't touch
+// the body beyond its size.
+base::expected<ParsedFile, ReadError> ParseFile(
+    base::span<const uint8_t> file);
+
+// Setup files: checks the body against its checksum and returns it.
+base::expected<std::string, ReadError> ReadSetupBody(const ParsedFile& file);
+
+// Full files: decrypts and authenticates every chunk. Returns the zip only if
+// all of them pass.
+base::expected<std::string, ReadError> DecryptBody(const ParsedFile& file,
+                                                   const Key& key);
+
+// Returns nullopt if `zip` is over kMaxBodySize.
+std::optional<std::vector<uint8_t>> WriteSetupFile(
+    const Description& description,
+    base::span<const uint8_t> zip);
+
+// `key` must come from DeriveKey() with `kdf`. Returns nullopt if `zip` is
+// over kMaxBodySize or the parameters are out of range.
+std::optional<std::vector<uint8_t>> WriteFullFile(
+    const Description& description,
+    const KdfParams& kdf,
+    const AeadParams& aead,
+    const Key& key,
+    base::span<const uint8_t> zip);
+
+// Clears a secret in place, then empties `bytes`. The vector keeps its
+// storage, so what it held is zeros rather than freed memory still holding
+// the secret.
+void WipeSecret(std::vector<uint8_t>& bytes);
+
+}  // namespace bare::backup
+
+#endif  // CHROME_BROWSER_BARE_BACKUP_BACKUP_FILE_H_

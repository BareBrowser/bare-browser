@@ -0,0 +1,131 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/bare/backup/backup_package.h"
+
+#include <algorithm>
+
+#include "base/strings/string_util.h"
+#include "base/strings/string_split.h"
+#include "third_party/zlib/google/zip_reader.h"
+
+namespace bare::backup {
+
+namespace {
+
+constexpr size_t kMaxNameLength = 512;
+
+bool IsNameChar(char c) {
+  return base::IsAsciiAlphaNumeric(c) || c == '.' || c == '_' || c == '-' ||
+         c == '/';
+}
+
+base::unexpected<PackageReadError> Fail(PackageError error,
+                                        std::string entry = std::string()) {
+  return base::unexpected(PackageReadError{error, std::move(entry)});
+}
+
+bool IsExtensionNameChar(char c) {
+  const auto byte = static_cast<unsigned char>(c);
+  return byte >= 0x20 && byte != 0x7f && c != '\\';
+}
+
+}  // namespace
+
+bool IsSafeEntryName(std::string_view name) {
+  if (name.empty() || name.size() > kMaxNameLength || name.front() == '/') {
+    return false;
+  }
+  if (name.starts_with(kExtensionFilesPrefix)) {
+    if (!base::IsStringUTF8(name) ||
+        !std::ranges::all_of(name, IsExtensionNameChar)) {
+      return false;
+    }
+  } else if (!std::ranges::all_of(name, IsNameChar)) {
+    return false;
+  }
+  if (name.back() == '/') {
+    name.remove_suffix(1);
+  }
+  for (std::string_view part : base::SplitStringPiece(
+           name, "/", base::KEEP_WHITESPACE, base::SPLIT_WANT_ALL)) {
+    if (part.empty() || part == "." || part == "..") {
+      return false;
+    }
+  }
+  return true;
+}
+
+base::expected<Package, PackageReadError> ReadPackage(
+    const std::string& zip,
+    const PackageLimits& limits) {
+  zip::ZipReader reader;
+  if (!reader.OpenFromString(zip)) {
+    return Fail(PackageError::kNotZip);
+  }
+  if (reader.num_entries() < 0 ||
+      static_cast<size_t>(reader.num_entries()) > limits.max_entries) {
+    return Fail(PackageError::kTooManyEntries);
+  }
+
+  const uint64_t ratio_budget = limits.max_ratio * zip.size();
+  Package package;
+  size_t entries = 0;
+  uint64_t total = 0;
+  while (const zip::ZipReader::Entry* entry = reader.Next()) {
+    if (++entries > limits.max_entries) {
+      return Fail(PackageError::kTooManyEntries);
+    }
+    const std::string& name = entry->path_in_original_encoding;
+    if (!IsSafeEntryName(name) || entry->is_unsafe) {
+      return Fail(PackageError::kBadName);
+    }
+    if (entry->is_symbolic_link) {
+      return Fail(PackageError::kLink, name);
+    }
+    if (entry->is_encrypted) {
+      return Fail(PackageError::kEncrypted, name);
+    }
+    if (entry->is_directory) {
+      continue;
+    }
+    if (package.contains(name)) {
+      return Fail(PackageError::kDuplicate, name);
+    }
+
+    // Whichever limit is closest decides how much may be read, and which error
+    // is reported if the entry goes past it.
+    uint64_t max_read = limits.max_file_size;
+    PackageError over = PackageError::kFileTooLarge;
+    if (limits.max_total_size - total < max_read) {
+      max_read = limits.max_total_size - total;
+      over = PackageError::kTotalTooLarge;
+    }
+    if (ratio_budget - total < max_read) {
+      max_read = ratio_budget - total;
+      over = PackageError::kRatioTooHigh;
+    }
+
+    // One byte past the limit tells "too big" apart from "exactly at the
+    // limit", and ExtractCurrentEntryToString() reads nothing at all when
+    // asked for 0 bytes.
+    std::string contents;
+    const bool complete =
+        reader.ExtractCurrentEntryToString(max_read + 1, &contents);
+    if (contents.size() > max_read) {
+      return Fail(over, name);
+    }
+    if (!complete) {
+      return Fail(PackageError::kDamaged, name);
+    }
+    total += contents.size();
+    package.emplace(name, std::move(contents));
+  }
+  if (!reader.ok()) {
+    return Fail(PackageError::kDamaged);
+  }
+  return package;
+}
+
+}  // namespace bare::backup
diff --git a/chrome/browser/bare/backup/backup_package.h b/chrome/browser/bare/backup/backup_package.h
new file mode 100644
index 00000000000..b532d6a7ded
--- /dev/null
+++ b/chrome/browser/bare/backup/backup_package.h
@@ -0,0 +1,69 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_BARE_BACKUP_BACKUP_PACKAGE_H_
+#define CHROME_BROWSER_BARE_BACKUP_BACKUP_PACKAGE_H_
+
+#include <stddef.h>
+#include <stdint.h>
+
+#include <map>
+#include <string>
+#include <string_view>
+
+#include "base/types/expected.h"
+
+// Reads the zip inside a .bare file into memory. The zip comes from a file the
+// user picked, so it is treated as hostile: names are checked, links and
+// encrypted entries are refused, and sizes are capped while extracting rather
+// than trusted from the zip's own metadata.
+namespace bare::backup {
+
+struct PackageLimits {
+  size_t max_entries = 2000;
+  uint64_t max_total_size = 64 * 1024 * 1024;
+  uint64_t max_file_size = 16 * 1024 * 1024;
+  // Unpacked bytes per byte of zip, over the whole package.
+  uint64_t max_ratio = 100;
+};
+
+enum class PackageError {
+  kNotZip,
+  kTooManyEntries,
+  kBadName,
+  kLink,
+  kEncrypted,
+  kDuplicate,
+  kFileTooLarge,
+  kTotalTooLarge,
+  kRatioTooHigh,
+  kDamaged,
+};
+
+struct PackageReadError {
+  PackageError error;
+  // The entry that failed, when there is one. Only names that passed
+  // IsSafeEntryName() are copied here.
+  std::string entry;
+};
+
+// Entry name to contents. Directory entries are left out.
+using Package = std::map<std::string, std::string>;
+
+// Holds the files of installed extensions, whose names Bare doesn't choose.
+inline constexpr char kExtensionFilesPrefix[] = "setup/extensions/";
+
+// Relative, no empty, "." or ".." part, at most 512 bytes, and a trailing "/"
+// only for a directory. Names are made of [A-Za-z0-9._/-], except under
+// kExtensionFilesPrefix, where any UTF-8 is allowed apart from control
+// characters and "\".
+bool IsSafeEntryName(std::string_view name);
+
+base::expected<Package, PackageReadError> ReadPackage(
+    const std::string& zip,
+    const PackageLimits& limits = PackageLimits());
+
+}  // namespace bare::backup
+
+#endif  // CHROME_BROWSER_BARE_BACKUP_BACKUP_PACKAGE_H_
diff --git a/chrome/browser/bare/backup/backup_package_unittest.cc b/chrome/browser/bare/backup/backup_package_unittest.cc
new file mode 100644
index 00000000000..0acdd4f2f78
--- /dev/null
+++ b/chrome/browser/bare/backup/backup_package_unittest.cc
@@ -0,0 +1,328 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/bare/backup/backup_package.h"
+
+#include <string>
+#include <vector>
+
+#include "base/check_op.h"
+#include "base/numerics/byte_conversions.h"
+#include "base/strings/string_number_conversions.h"
+#include "chrome/browser/bare/backup/backup_file.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "third_party/zlib/zlib.h"
+
+namespace bare::backup {
+namespace {
+
+// Writes zips by hand so the tests can make ones no zip tool would: unsafe
+// names, links, false sizes.
+struct TestEntry {
+  std::string name;
+  std::string data;
+  bool deflate = false;
+  uint16_t flags = 0;
+  // Unix mode in the high 16 bits, as Info-ZIP writes it.
+  uint32_t external_attr = 0100644u << 16;
+  // Overrides the uncompressed size written in the headers.
+  std::optional<uint32_t> claimed_size;
+  std::optional<uint32_t> claimed_crc;
+};
+
+std::string Deflate(const std::string& in) {
+  z_stream stream = {};
+  CHECK_EQ(deflateInit2(&stream, 9, Z_DEFLATED, -15, 8, Z_DEFAULT_STRATEGY),
+           Z_OK);
+  std::string out(deflateBound(&stream, in.size()), '\0');
+  stream.next_in = reinterpret_cast<Bytef*>(const_cast<char*>(in.data()));
+  stream.avail_in = in.size();
+  stream.next_out = reinterpret_cast<Bytef*>(out.data());
+  stream.avail_out = out.size();
+  CHECK_EQ(deflate(&stream, Z_FINISH), Z_STREAM_END);
+  out.resize(stream.total_out);
+  deflateEnd(&stream);
+  return out;
+}
+
+void Put16(std::string& out, uint16_t v) {
+  auto b = base::U16ToLittleEndian(v);
+  out.append(b.begin(), b.end());
+}
+
+void Put32(std::string& out, uint32_t v) {
+  auto b = base::U32ToLittleEndian(v);
+  out.append(b.begin(), b.end());
+}
+
+std::string BuildZip(const std::vector<TestEntry>& entries) {
+  std::string out;
+  std::string central;
+  for (const TestEntry& e : entries) {
+    const std::string body = e.deflate ? Deflate(e.data) : e.data;
+    const uint32_t crc = e.claimed_crc.value_or(static_cast<uint32_t>(
+        crc32(0, reinterpret_cast<const Bytef*>(e.data.data()),
+              e.data.size())));
+    const uint32_t size =
+        e.claimed_size.value_or(static_cast<uint32_t>(e.data.size()));
+    const uint16_t method = e.deflate ? 8 : 0;
+    const uint32_t offset = out.size();
+
+    Put32(out, 0x04034b50);
+    Put16(out, 20);
+    Put16(out, e.flags);
+    Put16(out, method);
+    Put16(out, 0);       // time
+    Put16(out, 0x21);    // 1980-01-01
+    Put32(out, crc);
+    Put32(out, body.size());
+    Put32(out, size);
+    Put16(out, e.name.size());
+    Put16(out, 0);
+    out += e.name;
+    out += body;
+
+    Put32(central, 0x02014b50);
+    Put16(central, (3 << 8) | 20);  // made on Unix
+    Put16(central, 20);
+    Put16(central, e.flags);
+    Put16(central, method);
+    Put16(central, 0);
+    Put16(central, 0x21);
+    Put32(central, crc);
+    Put32(central, body.size());
+    Put32(central, size);
+    Put16(central, e.name.size());
+    Put16(central, 0);  // extra
+    Put16(central, 0);  // comment
+    Put16(central, 0);  // disk
+    Put16(central, 0);  // internal attributes
+    Put32(central, e.external_attr);
+    Put32(central, offset);
+    central += e.name;
+  }
+  const uint32_t central_offset = out.size();
+  out += central;
+  Put32(out, 0x06054b50);
+  Put16(out, 0);
+  Put16(out, 0);
+  Put16(out, entries.size());
+  Put16(out, entries.size());
+  Put32(out, central.size());
+  Put32(out, central_offset);
+  Put16(out, 0);
+  return out;
+}
+
+PackageError ErrorOf(const std::vector<TestEntry>& entries,
+                     const PackageLimits& limits = PackageLimits()) {
+  auto result = ReadPackage(BuildZip(entries), limits);
+  return result.has_value() ? static_cast<PackageError>(-1)
+                            : result.error().error;
+}
+
+TEST(BackupPackageTest, ReadsEntries) {
+  const std::string json(5000, 'a');
+  auto package = ReadPackage(BuildZip({
+      {.name = "manifest.json", .data = "{\"schema\":1}"},
+      {.name = "setup/", .external_attr = 040755u << 16},
+      {.name = "setup/settings.json", .data = json, .deflate = true},
+      {.name = "setup/extensions/abc/_locales/en_GB/messages.json",
+       .data = "{}"},
+      {.name = "personal/empty.json", .data = ""},
+  }));
+  ASSERT_TRUE(package.has_value());
+  EXPECT_EQ(package->size(), 4u);
+  EXPECT_EQ(package->at("manifest.json"), "{\"schema\":1}");
+  EXPECT_EQ(package->at("setup/settings.json"), json);
+  EXPECT_EQ(package->at("setup/extensions/abc/_locales/en_GB/messages.json"),
+            "{}");
+  EXPECT_EQ(package->at("personal/empty.json"), "");
+  EXPECT_FALSE(package->contains("setup/"));
+}
+
+TEST(BackupPackageTest, SafeNames) {
+  for (const char* name :
+       {"a", "a.json", "setup/settings.json", "dir/", "a-b_c.D9/e",
+        "setup/extensions/abcdefghijklmnop/1.2.3_0/manifest.json", "..a",
+        "a..", ".hidden"}) {
+    EXPECT_TRUE(IsSafeEntryName(name)) << name;
+  }
+  for (const char* name :
+       {"", "/", "/etc/passwd", "../a", "a/../b", "a/..", "..", ".", "./a",
+        "a/./b", "a//b", "a\\b", "..\\a", "C:/a", "a b", "a\n", "caf\xc3\xa9",
+        "a/b//", "a%2f..", "~/a", "a:b", "a*", "a\x01"}) {
+    EXPECT_FALSE(IsSafeEntryName(name)) << name;
+  }
+  // Extension files keep the names their authors gave them.
+  for (const char* name :
+       {"setup/extensions/abc/icon@2x.png", "setup/extensions/abc/a b+c.js",
+        "setup/extensions/abc/caf\xc3\xa9.json", "setup/extensions/abc/C:x",
+        "setup/extensions/abc/%2e%2e/x"}) {
+    EXPECT_TRUE(IsSafeEntryName(name)) << name;
+  }
+  for (const char* name :
+       {"setup/extensions/abc/../x", "setup/extensions/../settings.json",
+        "setup/extensions/abc//x", "setup/extensions/abc/./x",
+        "setup/extensions/abc\\..\\x", "setup/extensions/abc/a\n",
+        "setup/extensions/abc/\x7f", "setup/extensions/abc/\xff\xfe",
+        "setup/extensionsx/a b", "personal/a b", "setup/a@b"}) {
+    EXPECT_FALSE(IsSafeEntryName(name)) << name;
+  }
+  EXPECT_TRUE(IsSafeEntryName(std::string(512, 'a')));
+  EXPECT_FALSE(IsSafeEntryName(std::string(513, 'a')));
+}
+
+TEST(BackupPackageTest, Traversal) {
+  for (const char* name : {"../evil", "/abs/path", "setup/../../evil",
+                           "..\\evil", "a//b", "./x"}) {
+    EXPECT_EQ(ErrorOf({{.name = "ok.json", .data = "{}"},
+                       {.name = name, .data = "x"}}),
+              PackageError::kBadName)
+        << name;
+  }
+}
+
+TEST(BackupPackageTest, ExtensionFileNames) {
+  auto package = ReadPackage(BuildZip({
+      {.name = "setup/extensions/abc/img/icon@2x.png", .data = "png"},
+      {.name = "setup/extensions/abc/My File.js", .data = "js"},
+  }));
+  ASSERT_TRUE(package.has_value());
+  EXPECT_EQ(package->at("setup/extensions/abc/My File.js"), "js");
+  EXPECT_EQ(ErrorOf({{.name = "setup/extensions/abc/../../x", .data = "x"}}),
+            PackageError::kBadName);
+}
+
+TEST(BackupPackageTest, NulInName) {
+  // minizip ends the name at the NUL. Whatever comes out must be a safe name.
+  auto package =
+      ReadPackage(BuildZip({{.name = std::string("a\0/../b", 6), .data = "x"}}));
+  if (package.has_value()) {
+    for (const auto& [name, contents] : *package) {
+      EXPECT_TRUE(IsSafeEntryName(name)) << name;
+      EXPECT_EQ(name.find('\0'), std::string::npos);
+    }
+  }
+}
+
+TEST(BackupPackageTest, Symlink) {
+  EXPECT_EQ(ErrorOf({{.name = "link",
+                      .data = "/data/data/org.barebrowser",
+                      .external_attr = 0120777u << 16}}),
+            PackageError::kLink);
+}
+
+TEST(BackupPackageTest, Encrypted) {
+  EXPECT_EQ(ErrorOf({{.name = "a.json", .data = "xxxxxxxxxxxx", .flags = 1}}),
+            PackageError::kEncrypted);
+}
+
+TEST(BackupPackageTest, Duplicate) {
+  EXPECT_EQ(ErrorOf({{.name = "a.json", .data = "1"},
+                     {.name = "a.json", .data = "2"}}),
+            PackageError::kDuplicate);
+}
+
+TEST(BackupPackageTest, TooManyEntries) {
+  std::vector<TestEntry> entries;
+  for (int i = 0; i < 2001; ++i) {
+    entries.push_back({.name = "f" + base::NumberToString(i)});
+  }
+  EXPECT_EQ(ErrorOf(entries), PackageError::kTooManyEntries);
+  entries.pop_back();
+  EXPECT_TRUE(ReadPackage(BuildZip(entries)).has_value());
+}
+
+TEST(BackupPackageTest, Bomb) {
+  // 20 MB of zeros deflate to about 20 KB.
+  const std::string zeros(20 * 1024 * 1024, '\0');
+  EXPECT_EQ(ErrorOf({{.name = "bomb", .data = zeros, .deflate = true}}),
+            PackageError::kRatioTooHigh);
+  // The same with headers that claim it is small. minizip stops at the
+  // claimed size and the checksum fails, or the cap is hit first.
+  EXPECT_FALSE(ReadPackage(BuildZip({{.name = "bomb",
+                                      .data = zeros,
+                                      .deflate = true,
+                                      .claimed_size = 100}}))
+                   .has_value());
+  // Budget used up by earlier entries: a later non-empty entry still fails.
+  PackageLimits limits;
+  limits.max_total_size = 10;
+  EXPECT_EQ(ErrorOf({{.name = "a", .data = std::string(10, 'x')},
+                     {.name = "b", .data = "y"}},
+                    limits),
+            PackageError::kTotalTooLarge);
+}
+
+TEST(BackupPackageTest, FileTooLarge) {
+  // Random-looking data, so the ratio stays low and the file cap is hit.
+  std::string data(16 * 1024 * 1024 + 1, '\0');
+  for (size_t i = 0; i < data.size(); ++i) {
+    data[i] = static_cast<char>((i * 2654435761u) >> 13);
+  }
+  EXPECT_EQ(ErrorOf({{.name = "big", .data = data}}),
+            PackageError::kFileTooLarge);
+  data.pop_back();
+  EXPECT_TRUE(ReadPackage(BuildZip({{.name = "big", .data = data}})).has_value());
+}
+
+TEST(BackupPackageTest, TotalTooLarge) {
+  PackageLimits limits;
+  limits.max_total_size = 100;
+  EXPECT_EQ(ErrorOf({{.name = "a", .data = std::string(60, 'x')},
+                     {.name = "b", .data = std::string(60, 'y')}},
+                    limits),
+            PackageError::kTotalTooLarge);
+  EXPECT_TRUE(ReadPackage(BuildZip({{.name = "a", .data = std::string(50, 'x')},
+                                    {.name = "b", .data = std::string(50, 'y')}}),
+                          limits)
+                  .has_value());
+}
+
+TEST(BackupPackageTest, DamagedEntry) {
+  EXPECT_EQ(ErrorOf({{.name = "a", .data = "hello", .claimed_crc = 1234}}),
+            PackageError::kDamaged);
+}
+
+TEST(BackupPackageTest, NotZip) {
+  EXPECT_EQ(ReadPackage("").error().error, PackageError::kNotZip);
+  EXPECT_EQ(ReadPackage("hello, not a zip").error().error,
+            PackageError::kNotZip);
+  std::string cut = BuildZip({{.name = "a", .data = "hello"}});
+  cut.resize(cut.size() - 10);
+  EXPECT_FALSE(ReadPackage(cut).has_value());
+}
+
+// The whole path a full backup takes: package, encrypt, parse, decrypt, read.
+TEST(BackupPackageTest, ThroughFullFile) {
+  std::string bookmarks;
+  for (int i = 0; bookmarks.size() < 300000; ++i) {
+    bookmarks += "{\"title\":\"Page " + base::NumberToString(i * 7919) +
+                 "\",\"url\":\"https://example.org/" +
+                 base::NumberToString(i * 104729 % 99991) + "\"},";
+  }
+  const std::string zip = BuildZip({
+      {.name = "manifest.json", .data = "{\"schema\":1}"},
+      {.name = "personal/bookmarks.json", .data = bookmarks, .deflate = true},
+  });
+  ASSERT_LT(bookmarks.size() / zip.size(), 100u);
+  const KdfParams kdf = NewKdfParams();
+  std::optional<Key> key = DeriveKey(base::as_byte_span(std::string_view("passphrase")), kdf);
+  ASSERT_TRUE(key);
+  std::optional<std::vector<uint8_t>> file = WriteFullFile(
+      Description(), kdf, NewAeadParams(), *key, base::as_byte_span(zip));
+  ASSERT_TRUE(file);
+
+  auto parsed = ParseFile(*file);
+  ASSERT_TRUE(parsed.has_value());
+  auto body = DecryptBody(*parsed, *key);
+  ASSERT_TRUE(body.has_value());
+  auto package = ReadPackage(*body);
+  ASSERT_TRUE(package.has_value());
+  EXPECT_EQ(package->at("personal/bookmarks.json"), bookmarks);
+}
+
+}  // namespace
+}  // namespace bare::backup

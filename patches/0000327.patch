+++ b/chrome/browser/bare/backup/backup_file.cc
@@ -0,0 +1,472 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/bare/backup/backup_file.h"
+
+#include <openssl/aead.h>
+#include <openssl/evp.h>
+#include <openssl/mem.h>
+#include <openssl/rand.h>
+#include <openssl/sha.h>
+
+#include <algorithm>
+#include <utility>
+
+#include "base/base64.h"
+#include "base/check.h"
+#include "base/containers/span_reader.h"
+#include "base/containers/span_writer.h"
+#include "base/json/json_reader.h"
+#include "base/json/json_writer.h"
+#include "base/numerics/byte_conversions.h"
+#include "base/numerics/safe_conversions.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_view_util.h"
+#include "base/values.h"
+
+namespace bare::backup {
+
+namespace {
+
+constexpr std::array<uint8_t, 8> kMagic = {'B', 'A', 'R', 'E',
+                                           'B', 'K', 'U', 'P'};
+
+constexpr size_t kNonceSize = 12;
+constexpr size_t kMaxJsonDepth = 4;
+constexpr size_t kMaxContentsEntries = 32;
+
+// Accepted scrypt range. The memory caps keep a hostile header from asking
+// for more than a phone has; scrypt needs 128 * r * N bytes for V and
+// 128 * r * p for B.
+constexpr uint8_t kMinLog2N = 14;
+constexpr uint8_t kMaxLog2N = 22;
+constexpr uint32_t kMaxR = 32;
+constexpr uint32_t kMaxP = 16;
+constexpr uint64_t kMaxScryptV = 256u * 1024 * 1024;
+constexpr uint64_t kMaxScryptB = 16u * 1024 * 1024;
+
+constexpr uint32_t kMinChunkSize = 1024;
+constexpr uint32_t kMaxChunkSize = 1024 * 1024;
+
+constexpr char kKdfName[] = "scrypt";
+constexpr char kAeadName[] = "aes-256-gcm";
+
+const char* KindName(Kind kind) {
+  return kind == Kind::kFull ? "full" : "setup";
+}
+
+bool KdfParamsInRange(const KdfParams& kdf) {
+  if (kdf.log2_n < kMinLog2N || kdf.log2_n > kMaxLog2N) {
+    return false;
+  }
+  if (kdf.r < 1 || kdf.r > kMaxR || kdf.p < 1 || kdf.p > kMaxP) {
+    return false;
+  }
+  const uint64_t n = uint64_t{1} << kdf.log2_n;
+  return 128 * uint64_t{kdf.r} * n <= kMaxScryptV &&
+         128 * uint64_t{kdf.r} * kdf.p <= kMaxScryptB;
+}
+
+bool AeadParamsInRange(const AeadParams& aead) {
+  return aead.chunk_size >= kMinChunkSize && aead.chunk_size <= kMaxChunkSize;
+}
+
+template <size_t N>
+bool DecodeFixed(const std::string* in, std::array<uint8_t, N>& out) {
+  if (!in) {
+    return false;
+  }
+  std::optional<std::vector<uint8_t>> bytes = base::Base64Decode(*in);
+  if (!bytes || bytes->size() != N) {
+    return false;
+  }
+  std::ranges::copy(*bytes, out.begin());
+  return true;
+}
+
+bool ReadDescription(const base::DictValue& json, Description& out) {
+  for (auto [key, field] : {std::pair{"created", &out.created},
+                            std::pair{"bare_version", &out.bare_version},
+                            std::pair{"device_label", &out.device_label}}) {
+    const base::Value* value = json.Find(key);
+    if (!value) {
+      continue;
+    }
+    if (!value->is_string()) {
+      return false;
+    }
+    *field = value->GetString();
+  }
+  if (const base::Value* code = json.Find("bare_version_code")) {
+    if (!code->is_int() || code->GetInt() < 0) {
+      return false;
+    }
+    out.bare_version_code = code->GetInt();
+  }
+  if (const base::Value* contents = json.Find("contents")) {
+    if (!contents->is_dict() ||
+        contents->GetDict().size() > kMaxContentsEntries) {
+      return false;
+    }
+    for (const auto [name, count] : contents->GetDict()) {
+      if (!count.is_int() || count.GetInt() < 0) {
+        return false;
+      }
+      out.contents[name] = count.GetInt();
+    }
+  }
+  return true;
+}
+
+bool ReadKdf(const base::DictValue* json, KdfParams& out) {
+  if (!json) {
+    return false;
+  }
+  const std::string* name = json->FindString("name");
+  std::optional<int> log2_n = json->FindInt("log2_n");
+  std::optional<int> r = json->FindInt("r");
+  std::optional<int> p = json->FindInt("p");
+  if (!name || *name != kKdfName || !log2_n || !r || !p || *log2_n < 0 ||
+      *log2_n > 255 || *r < 0 || *p < 0) {
+    return false;
+  }
+  out.log2_n = static_cast<uint8_t>(*log2_n);
+  out.r = static_cast<uint32_t>(*r);
+  out.p = static_cast<uint32_t>(*p);
+  return DecodeFixed(json->FindString("salt"), out.salt) &&
+         KdfParamsInRange(out);
+}
+
+bool ReadAead(const base::DictValue* json, AeadParams& out) {
+  if (!json) {
+    return false;
+  }
+  const std::string* name = json->FindString("name");
+  std::optional<int> chunk = json->FindInt("chunk");
+  if (!name || *name != kAeadName || !chunk || *chunk < 0) {
+    return false;
+  }
+  out.chunk_size = static_cast<uint32_t>(*chunk);
+  return DecodeFixed(json->FindString("nonce_prefix"), out.nonce_prefix) &&
+         AeadParamsInRange(out);
+}
+
+base::DictValue DescriptionToJson(const Description& description, Kind kind) {
+  base::DictValue contents;
+  for (const auto& [name, count] : description.contents) {
+    contents.Set(name, count);
+  }
+  base::DictValue json;
+  json.Set("created", description.created);
+  json.Set("bare_version", description.bare_version);
+  json.Set("bare_version_code", description.bare_version_code);
+  json.Set("device_label", description.device_label);
+  json.Set("kind", KindName(kind));
+  json.Set("contents", std::move(contents));
+  return json;
+}
+
+// Fixed header followed by the JSON.
+std::optional<std::vector<uint8_t>> BuildHeader(Kind kind,
+                                                const base::DictValue& json) {
+  std::optional<std::string> text = base::WriteJson(json);
+  if (!text || text->size() > kMaxHeaderJsonSize) {
+    return std::nullopt;
+  }
+  std::vector<uint8_t> out(kFixedHeaderSize + text->size());
+  auto writer = base::SpanWriter(base::span(out));
+  writer.Write(kMagic);
+  writer.WriteU16LittleEndian(kFormatVersion);
+  writer.WriteU8LittleEndian(static_cast<uint8_t>(kind));
+  writer.WriteU8LittleEndian(0);
+  writer.WriteU32LittleEndian(base::checked_cast<uint32_t>(text->size()));
+  writer.Write(base::as_byte_span(*text));
+  CHECK_EQ(writer.remaining(), 0u);
+  return out;
+}
+
+std::array<uint8_t, kNonceSize> ChunkNonce(const AeadParams& aead,
+                                           uint32_t index,
+                                           bool last) {
+  std::array<uint8_t, kNonceSize> nonce;
+  auto writer = base::SpanWriter(base::span(nonce));
+  writer.Write(aead.nonce_prefix);
+  writer.WriteU32BigEndian(index);
+  writer.WriteU8BigEndian(static_cast<uint8_t>(last));
+  return nonce;
+}
+
+// Number of chunks a body of `plain_size` bytes is cut into. An empty body is
+// one empty chunk, so a file always ends with a chunk marked last.
+size_t ChunkCount(size_t plain_size, size_t chunk_size) {
+  return std::max<size_t>(1, (plain_size + chunk_size - 1) / chunk_size);
+}
+
+}  // namespace
+
+ParsedFile::ParsedFile() = default;
+ParsedFile::ParsedFile(ParsedFile&&) = default;
+ParsedFile& ParsedFile::operator=(ParsedFile&&) = default;
+ParsedFile::~ParsedFile() = default;
+
+Key::Key() = default;
+
+Key::Key(Key&& other) : bytes_(other.bytes_) {
+  OPENSSL_cleanse(other.bytes_.data(), other.bytes_.size());
+}
+
+Key& Key::operator=(Key&& other) {
+  if (this != &other) {
+    bytes_ = other.bytes_;
+    OPENSSL_cleanse(other.bytes_.data(), other.bytes_.size());
+  }
+  return *this;
+}
+
+Key::~Key() {
+  OPENSSL_cleanse(bytes_.data(), bytes_.size());
+}
+
+KdfParams NewKdfParams() {
+  KdfParams kdf;
+  RAND_bytes(kdf.salt.data(), kdf.salt.size());
+  return kdf;
+}
+
+AeadParams NewAeadParams() {
+  AeadParams aead;
+  RAND_bytes(aead.nonce_prefix.data(), aead.nonce_prefix.size());
+  return aead;
+}
+
+std::optional<Key> DeriveKey(base::span<const uint8_t> passphrase,
+                             const KdfParams& params) {
+  if (!KdfParamsInRange(params)) {
+    return std::nullopt;
+  }
+  Key key;
+  const auto chars = base::as_chars(passphrase);
+  if (!EVP_PBE_scrypt(chars.data(), chars.size(), params.salt.data(),
+                      params.salt.size(), uint64_t{1} << params.log2_n,
+                      params.r, params.p,
+                      static_cast<size_t>(kMaxScryptV + 2 * kMaxScryptB),
+                      key.bytes_.data(), key.bytes_.size())) {
+    return std::nullopt;
+  }
+  return key;
+}
+
+base::expected<ParsedFile, ReadError> ParseFile(
+    base::span<const uint8_t> file) {
+  base::SpanReader reader(file);
+  std::optional<base::span<const uint8_t, 8>> magic = reader.Read<8>();
+  if (!magic || !std::ranges::equal(*magic, kMagic)) {
+    return base::unexpected(ReadError::kNotBare);
+  }
+  uint16_t version;
+  uint8_t kind_byte;
+  uint8_t flags;
+  uint32_t header_size;
+  if (!reader.ReadU16LittleEndian(version) ||
+      !reader.ReadU8LittleEndian(kind_byte) ||
+      !reader.ReadU8LittleEndian(flags) ||
+      !reader.ReadU32LittleEndian(header_size)) {
+    return base::unexpected(ReadError::kNotBare);
+  }
+  if (version > kFormatVersion) {
+    return base::unexpected(ReadError::kNewerVersion);
+  }
+  if (version == 0 || flags != 0 ||
+      (kind_byte != static_cast<uint8_t>(Kind::kSetup) &&
+       kind_byte != static_cast<uint8_t>(Kind::kFull)) ||
+      header_size == 0 || header_size > kMaxHeaderJsonSize) {
+    return base::unexpected(ReadError::kBadHeader);
+  }
+  std::optional<base::span<const uint8_t>> json_bytes =
+      reader.Read(header_size);
+  if (!json_bytes) {
+    return base::unexpected(ReadError::kBadHeader);
+  }
+
+  ParsedFile parsed;
+  parsed.kind = static_cast<Kind>(kind_byte);
+  parsed.format_version = version;
+  parsed.header = file.first(kFixedHeaderSize + header_size);
+  parsed.body = reader.remaining_span();
+
+  std::optional<base::DictValue> json = base::JSONReader::ReadDict(
+      base::as_string_view(*json_bytes), base::JSON_PARSE_RFC, kMaxJsonDepth);
+  if (!json) {
+    return base::unexpected(ReadError::kBadHeader);
+  }
+  const std::string* kind_name = json->FindString("kind");
+  if (!kind_name || *kind_name != KindName(parsed.kind) ||
+      !ReadDescription(*json, parsed.description)) {
+    return base::unexpected(ReadError::kBadHeader);
+  }
+
+  if (parsed.kind == Kind::kSetup) {
+    const std::string* sha = json->FindString("body_sha256");
+    if (!sha || sha->size() != 64 ||
+        !base::HexStringToSpan(*sha, parsed.body_sha256)) {
+      return base::unexpected(ReadError::kBadHeader);
+    }
+    if (parsed.body.size() > kMaxBodySize) {
+      return base::unexpected(ReadError::kTooLarge);
+    }
+    return parsed;
+  }
+
+  if (!ReadKdf(json->FindDict("kdf"), parsed.kdf) ||
+      !ReadAead(json->FindDict("aead"), parsed.aead)) {
+    return base::unexpected(ReadError::kBadHeader);
+  }
+  const size_t max_ciphertext =
+      kMaxBodySize +
+      ChunkCount(kMaxBodySize, parsed.aead.chunk_size) * kTagSize;
+  if (parsed.body.size() > max_ciphertext) {
+    return base::unexpected(ReadError::kTooLarge);
+  }
+  return parsed;
+}
+
+base::expected<std::string, ReadError> ReadSetupBody(const ParsedFile& file) {
+  CHECK(file.kind == Kind::kSetup);
+  std::array<uint8_t, SHA256_DIGEST_LENGTH> digest;
+  SHA256(file.body.data(), file.body.size(), digest.data());
+  if (digest != file.body_sha256) {
+    return base::unexpected(ReadError::kDamaged);
+  }
+  return std::string(base::as_string_view(file.body));
+}
+
+base::expected<std::string, ReadError> DecryptBody(const ParsedFile& file,
+                                                   const Key& key) {
+  CHECK(file.kind == Kind::kFull);
+  const size_t sealed_chunk = size_t{file.aead.chunk_size} + kTagSize;
+  const size_t whole = file.body.size() / sealed_chunk;
+  const size_t rest = file.body.size() % sealed_chunk;
+  if (file.body.empty() || (rest != 0 && rest < kTagSize)) {
+    return base::unexpected(ReadError::kDamaged);
+  }
+  const size_t chunks = whole + (rest ? 1 : 0);
+  const size_t plain_size = file.body.size() - chunks * kTagSize;
+  if (plain_size > kMaxBodySize) {
+    return base::unexpected(ReadError::kTooLarge);
+  }
+
+  bssl::ScopedEVP_AEAD_CTX ctx;
+  if (!EVP_AEAD_CTX_init(ctx.get(), EVP_aead_aes_256_gcm(), key.bytes().data(),
+                         key.bytes().size(), kTagSize, nullptr)) {
+    return base::unexpected(ReadError::kWrongCodeOrDamaged);
+  }
+
+  std::string out(plain_size, '\0');
+  base::span<uint8_t> out_span = base::as_writable_byte_span(out);
+  base::SpanReader reader(file.body);
+  for (size_t i = 0; i < chunks; ++i) {
+    const bool last = i + 1 == chunks;
+    base::span<const uint8_t> sealed =
+        *reader.Read(last ? reader.remaining() : sealed_chunk);
+    const auto nonce =
+        ChunkNonce(file.aead, base::checked_cast<uint32_t>(i), last);
+    base::span<uint8_t> dest =
+        out_span.subspan(i * file.aead.chunk_size, sealed.size() - kTagSize);
+    size_t written = 0;
+    if (!EVP_AEAD_CTX_open(ctx.get(), dest.data(), &written, dest.size(),
+                           nonce.data(), nonce.size(), sealed.data(),
+                           sealed.size(), file.header.data(),
+                           file.header.size()) ||
+        written != dest.size()) {
+      OPENSSL_cleanse(out.data(), out.size());
+      return base::unexpected(ReadError::kWrongCodeOrDamaged);
+    }
+  }
+  return out;
+}
+
+std::optional<std::vector<uint8_t>> WriteSetupFile(
+    const Description& description,
+    base::span<const uint8_t> zip) {
+  if (zip.size() > kMaxBodySize) {
+    return std::nullopt;
+  }
+  std::array<uint8_t, SHA256_DIGEST_LENGTH> digest;
+  SHA256(zip.data(), zip.size(), digest.data());
+  base::DictValue json = DescriptionToJson(description, Kind::kSetup);
+  json.Set("body_sha256", base::HexEncodeLower(digest));
+
+  std::optional<std::vector<uint8_t>> out = BuildHeader(Kind::kSetup, json);
+  if (!out) {
+    return std::nullopt;
+  }
+  out->insert(out->end(), zip.begin(), zip.end());
+  return out;
+}
+
+std::optional<std::vector<uint8_t>> WriteFullFile(
+    const Description& description,
+    const KdfParams& kdf,
+    const AeadParams& aead,
+    const Key& key,
+    base::span<const uint8_t> zip) {
+  if (zip.size() > kMaxBodySize || !KdfParamsInRange(kdf) ||
+      !AeadParamsInRange(aead)) {
+    return std::nullopt;
+  }
+  base::DictValue kdf_json;
+  kdf_json.Set("name", kKdfName);
+  kdf_json.Set("log2_n", static_cast<int>(kdf.log2_n));
+  kdf_json.Set("r", base::checked_cast<int>(kdf.r));
+  kdf_json.Set("p", base::checked_cast<int>(kdf.p));
+  kdf_json.Set("salt", base::Base64Encode(kdf.salt));
+  base::DictValue aead_json;
+  aead_json.Set("name", kAeadName);
+  aead_json.Set("chunk", base::checked_cast<int>(aead.chunk_size));
+  aead_json.Set("nonce_prefix", base::Base64Encode(aead.nonce_prefix));
+  base::DictValue json = DescriptionToJson(description, Kind::kFull);
+  json.Set("kdf", std::move(kdf_json));
+  json.Set("aead", std::move(aead_json));
+
+  std::optional<std::vector<uint8_t>> out = BuildHeader(Kind::kFull, json);
+  if (!out) {
+    return std::nullopt;
+  }
+  const size_t header_size = out->size();
+  const size_t chunks = ChunkCount(zip.size(), aead.chunk_size);
+  out->resize(header_size + zip.size() + chunks * kTagSize);
+
+  bssl::ScopedEVP_AEAD_CTX ctx;
+  if (!EVP_AEAD_CTX_init(ctx.get(), EVP_aead_aes_256_gcm(), key.bytes().data(),
+                         key.bytes().size(), kTagSize, nullptr)) {
+    return std::nullopt;
+  }
+  base::span<uint8_t> all(*out);
+  base::span<const uint8_t> header = all.first(header_size);
+  base::span<uint8_t> dest = all.subspan(header_size);
+  base::SpanReader plain(zip);
+  for (size_t i = 0; i < chunks; ++i) {
+    const bool last = i + 1 == chunks;
+    base::span<const uint8_t> in = *plain.Read(
+        last ? plain.remaining() : size_t{aead.chunk_size});
+    const auto nonce = ChunkNonce(aead, base::checked_cast<uint32_t>(i), last);
+    size_t written = 0;
+    if (!EVP_AEAD_CTX_seal(ctx.get(), dest.data(), &written, dest.size(),
+                           nonce.data(), nonce.size(), in.data(), in.size(),
+                           header.data(), header.size()) ||
+        written != in.size() + kTagSize) {
+      return std::nullopt;
+    }
+    dest = dest.subspan(written);
+  }
+  CHECK(dest.empty());
+  return out;
+}
+
+void WipeSecret(std::vector<uint8_t>& bytes) {
+  OPENSSL_cleanse(bytes.data(), bytes.size());
+  bytes.clear();
+}
+
+}  // namespace bare::backup
diff --git a/chrome/browser/bare/backup/backup_file.h b/chrome/browser/bare/backup/backup_file.h

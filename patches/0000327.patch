+TEST_F(BackupFileTest, NotBare) {
+  EXPECT_EQ(ParseFile({}).error(), ReadError::kNotBare);
+  EXPECT_EQ(ParseFile(Bytes("BAREBKU")).error(), ReadError::kNotBare);
+  EXPECT_EQ(ParseFile(Bytes("BAREBKUP\x01")).error(), ReadError::kNotBare);
+  EXPECT_EQ(ParseFile(Bytes("PK\x03\x04 a zip file, not a backup")).error(),

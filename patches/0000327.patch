+
+std::vector<uint8_t> Bytes(std::string_view s) {
+  auto span = base::as_byte_span(s);
+  return std::vector<uint8_t>(span.begin(), span.end());
+}
+
+Description TestDescription() {
+  Description d;
+  d.created = "2026-11-03T21:14:00Z";
+  d.bare_version = "2.1.0";
+  d.bare_version_code = 802100055;
+  d.device_label = "Pixel 3";
+  d.contents = {{"settings", 54}, {"bookmarks", 812}};
+  return d;
+}
+
+// A file with a hand-written header, for headers the writer never makes.
+std::vector<uint8_t> RawFile(uint16_t version,
+                             uint8_t kind,
+                             uint8_t flags,
+                             std::string_view json,
+                             std::string_view body = "") {
+  std::vector<uint8_t> out = Bytes("BAREBKUP");
+  auto u16 = base::U16ToLittleEndian(version);
+  out.insert(out.end(), u16.begin(), u16.end());
+  out.push_back(kind);
+  out.push_back(flags);
+  auto u32 = base::U32ToLittleEndian(static_cast<uint32_t>(json.size()));
+  out.insert(out.end(), u32.begin(), u32.end());
+  out.insert(out.end(), json.begin(), json.end());
+  out.insert(out.end(), body.begin(), body.end());
+  return out;
+}
+
+constexpr char kFullJson[] =
+    R"({"kind":"full","kdf":{"name":"scrypt","log2_n":15,"r":8,"p":1,)"
+    R"("salt":"AAAAAAAAAAAAAAAAAAAAAA=="},"aead":{"name":"aes-256-gcm",)"
+    R"("chunk":65536,"nonce_prefix":"AAAAAAAAAA=="}})";
+
+class BackupFileTest : public testing::Test {
+ protected:
+  static void SetUpTestSuite() {
+    kdf_ = new KdfParams(NewKdfParams());
+    key_ = new Key(*DeriveKey(Bytes(kPassphrase), *kdf_));
+  }
+  static void TearDownTestSuite() {
+    delete key_;
+    delete kdf_;
+  }
+
+  static std::vector<uint8_t> Full(base::span<const uint8_t> zip,
+                                   uint32_t chunk_size = kDefaultChunkSize) {
+    AeadParams aead = NewAeadParams();
+    aead.chunk_size = chunk_size;
+    return *WriteFullFile(TestDescription(), *kdf_, aead, *key_, zip);
+  }
+
+  // Opens `file` with `passphrase`. Without one, uses the suite's key when the
+  // file's KDF parameters are the suite's, since scrypt is slow on a phone.
+  static base::expected<std::string, ReadError> Open(
+      const std::vector<uint8_t>& file,
+      const char* passphrase = nullptr) {
+    ASSIGN_OR_RETURN(ParsedFile parsed, ParseFile(file));
+    const KdfParams& kdf = parsed.kdf;
+    if (!passphrase && kdf.log2_n == kdf_->log2_n && kdf.r == kdf_->r &&
+        kdf.p == kdf_->p && kdf.salt == kdf_->salt) {
+      return DecryptBody(parsed, *key_);
+    }
+    std::optional<Key> key =
+        DeriveKey(Bytes(passphrase ? passphrase : kPassphrase), kdf);
+    if (!key) {
+      return base::unexpected(ReadError::kBadHeader);
+    }
+    return DecryptBody(parsed, *key);
+  }
+
+  static size_t HeaderSize(const std::vector<uint8_t>& file) {
+    return ParseFile(file)->header.size();
+  }
+
+  static constexpr char kPassphrase[] = "ABCD-EFGH-JKMN-PQRS-TVWX-YZ23";
+  static inline KdfParams* kdf_ = nullptr;
+  static inline Key* key_ = nullptr;
+};
+
+TEST_F(BackupFileTest, SetupRoundTrip) {
+  const std::string zip = "PK not really a zip";
+  std::optional<std::vector<uint8_t>> file =
+      WriteSetupFile(TestDescription(), base::as_byte_span(zip));
+  ASSERT_TRUE(file);
+
+  auto parsed = ParseFile(*file);
+  ASSERT_TRUE(parsed.has_value());
+  EXPECT_EQ(parsed->kind, Kind::kSetup);
+  EXPECT_EQ(parsed->format_version, kFormatVersion);
+  EXPECT_EQ(parsed->description.created, "2026-11-03T21:14:00Z");
+  EXPECT_EQ(parsed->description.bare_version, "2.1.0");
+  EXPECT_EQ(parsed->description.bare_version_code, 802100055);
+  EXPECT_EQ(parsed->description.device_label, "Pixel 3");
+  EXPECT_EQ(parsed->description.contents.at("bookmarks"), 812);
+  EXPECT_EQ(ReadSetupBody(*parsed).value_or(""), zip);
+}
+
+TEST_F(BackupFileTest, SetupDamagedBody) {
+  std::vector<uint8_t> file =
+      *WriteSetupFile(TestDescription(), Bytes("zip bytes"));
+  file.back() ^= 1;
+  EXPECT_EQ(ReadSetupBody(*ParseFile(file)).error(), ReadError::kDamaged);
+
+  file.pop_back();
+  EXPECT_EQ(ReadSetupBody(*ParseFile(file)).error(), ReadError::kDamaged);
+}
+
+TEST_F(BackupFileTest, FullRoundTrip) {
+  // Empty, under one chunk, exactly two chunks, and a short last chunk.
+  for (size_t size : {size_t{0}, size_t{100}, 2 * kDefaultChunkSize,
+                      3 * kDefaultChunkSize + 17}) {
+    SCOPED_TRACE(size);
+    const std::vector<uint8_t> zip = base::RandBytesAsVector(size);
+    const std::vector<uint8_t> file = Full(zip);
+    auto parsed = ParseFile(file);
+    ASSERT_TRUE(parsed.has_value());
+    EXPECT_EQ(parsed->kind, Kind::kFull);
+    EXPECT_EQ(parsed->kdf.salt, kdf_->salt);
+    EXPECT_EQ(parsed->description.device_label, "Pixel 3");
+    auto body = DecryptBody(*parsed, *key_);
+    ASSERT_TRUE(body.has_value());
+    EXPECT_EQ(base::as_byte_span(*body), base::span(zip));
+  }
+}
+
+TEST_F(BackupFileTest, FullRoundTripRederivesKey) {
+  const std::vector<uint8_t> zip = Bytes("zip bytes");
+  EXPECT_EQ(Open(Full(zip), kPassphrase).value_or(""), "zip bytes");
+}
+
+TEST_F(BackupFileTest, WrongPassphrase) {
+  const std::vector<uint8_t> file = Full(Bytes("zip bytes"));
+  EXPECT_EQ(Open(file, "ABCD-EFGH-JKMN-PQRS-TVWX-YZ24").error(),
+            ReadError::kWrongCodeOrDamaged);
+  EXPECT_EQ(Open(file, "").error(), ReadError::kWrongCodeOrDamaged);
+}
+
+TEST_F(BackupFileTest, SaltChangesKey) {
+  KdfParams other = *kdf_;
+  other.salt[0] ^= 1;
+  std::optional<Key> key = DeriveKey(Bytes(kPassphrase), other);
+  ASSERT_TRUE(key);
+  EXPECT_NE(base::span(key->bytes()), base::span(key_->bytes()));
+
+  std::optional<Key> same = DeriveKey(Bytes(kPassphrase), *kdf_);
+  EXPECT_EQ(base::span(same->bytes()), base::span(key_->bytes()));
+}
+
+TEST_F(BackupFileTest, KeyMoveWipesSource) {
+  Key key = std::move(*DeriveKey(Bytes(kPassphrase), *kdf_));
+  Key moved(std::move(key));
+  const std::array<uint8_t, kKeySize> zero = {};
+  EXPECT_EQ(base::span(key.bytes()), base::span(zero));
+  EXPECT_NE(base::span(moved.bytes()), base::span(zero));
+}
+
+TEST_F(BackupFileTest, EveryHeaderByteIsAuthenticated) {
+  const std::vector<uint8_t> file = Full(Bytes("zip bytes"));
+  const size_t header_size = HeaderSize(file);
+  for (size_t i = 0; i < header_size; ++i) {
+    std::vector<uint8_t> edited = file;
+    edited[i] ^= 0x01;
+    // Either the header no longer parses, or the body no longer decrypts.
+    EXPECT_FALSE(Open(edited).has_value()) << "byte " << i;
+  }
+}
+
+TEST_F(BackupFileTest, HeaderEditKeepingValidJson) {
+  std::vector<uint8_t> file = Full(Bytes("zip bytes"));
+  std::string text(file.begin(), file.end());
+  const size_t at = text.find("Pixel 3");
+  ASSERT_NE(at, std::string::npos);
+  file[at + 6] = '4';
+  ASSERT_TRUE(ParseFile(file).has_value());
+  EXPECT_EQ(Open(file).error(), ReadError::kWrongCodeOrDamaged);
+}
+
+TEST_F(BackupFileTest, ChunksSwapped) {
+  const std::vector<uint8_t> file =
+      Full(base::RandBytesAsVector(3 * kDefaultChunkSize));
+  const size_t h = HeaderSize(file);
+  const size_t sealed = kDefaultChunkSize + kTagSize;
+  std::vector<uint8_t> swapped = file;
+  std::copy_n(file.begin() + h, sealed, swapped.begin() + h + sealed);
+  std::copy_n(file.begin() + h + sealed, sealed, swapped.begin() + h);
+  EXPECT_EQ(Open(swapped).error(), ReadError::kWrongCodeOrDamaged);
+}
+
+TEST_F(BackupFileTest, LastChunkMovedFirst) {
+  // Two full chunks, so both have the same size and only the nonce tells
+  // them apart.
+  const std::vector<uint8_t> file =
+      Full(base::RandBytesAsVector(2 * kDefaultChunkSize));
+  const size_t h = HeaderSize(file);
+  const size_t sealed = kDefaultChunkSize + kTagSize;
+  std::vector<uint8_t> swapped(file.begin(), file.begin() + h);
+  swapped.insert(swapped.end(), file.begin() + h + sealed, file.end());
+  swapped.insert(swapped.end(), file.begin() + h, file.begin() + h + sealed);
+  ASSERT_EQ(swapped.size(), file.size());
+  EXPECT_EQ(Open(swapped).error(), ReadError::kWrongCodeOrDamaged);
+}
+
+TEST_F(BackupFileTest, CutOff) {
+  const std::vector<uint8_t> file =
+      Full(base::RandBytesAsVector(2 * kDefaultChunkSize + 500));
+  const size_t h = HeaderSize(file);
+  const size_t sealed = kDefaultChunkSize + kTagSize;
+  // At a chunk boundary, so what is left is whole chunks, none marked last.
+  for (size_t keep : {h + 2 * sealed, h + sealed}) {
+    std::vector<uint8_t> cut(file.begin(), file.begin() + keep);
+    EXPECT_EQ(Open(cut).error(), ReadError::kWrongCodeOrDamaged) << keep;
+  }
+  // Inside the last chunk.
+  std::vector<uint8_t> cut(file.begin(), file.end() - 1);
+  EXPECT_EQ(Open(cut).error(), ReadError::kWrongCodeOrDamaged);
+  // Shorter than a tag after the last whole chunk.
+  cut.assign(file.begin(), file.begin() + h + 2 * sealed + 5);
+  EXPECT_EQ(Open(cut).error(), ReadError::kDamaged);
+  // Header only.
+  cut.assign(file.begin(), file.begin() + h);
+  EXPECT_EQ(Open(cut).error(), ReadError::kDamaged);
+  // Inside the header.
+  cut.assign(file.begin(), file.begin() + h - 1);
+  EXPECT_EQ(Open(cut).error(), ReadError::kBadHeader);
+}
+
+TEST_F(BackupFileTest, ExtraBytes) {
+  const std::vector<uint8_t> file =
+      Full(base::RandBytesAsVector(kDefaultChunkSize + 10));
+  for (size_t extra : {size_t{1}, kTagSize, kDefaultChunkSize + kTagSize}) {
+    std::vector<uint8_t> longer = file;
+    longer.resize(file.size() + extra, 0);
+    EXPECT_FALSE(Open(longer).has_value()) << extra;
+  }
+  // A copy of the last chunk appended.
+  std::vector<uint8_t> longer = file;
+  const size_t last = 10 + kTagSize;
+  longer.insert(longer.end(), file.end() - last, file.end());
+  EXPECT_FALSE(Open(longer).has_value());
+}
+
+TEST_F(BackupFileTest, BodyBitFlip) {
+  const std::vector<uint8_t> file =
+      Full(base::RandBytesAsVector(3 * kDefaultChunkSize));
+  for (size_t at : {HeaderSize(file), HeaderSize(file) + 100000,
+                    file.size() - 1}) {
+    std::vector<uint8_t> edited = file;
+    edited[at] ^= 0x80;
+    EXPECT_EQ(Open(edited).error(), ReadError::kWrongCodeOrDamaged) << at;
+  }
+}

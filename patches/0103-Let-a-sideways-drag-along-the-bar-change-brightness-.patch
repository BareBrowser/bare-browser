+        switch (action) {
+            case BareToolbarSwipeAction.BRIGHTNESS:
+                return R.string.bare_toolbar_swipe_brightness;
+            case BareToolbarSwipeAction.VOLUME:
+                return R.string.bare_toolbar_swipe_volume;
+            default:
+                return R.string.bare_toolbar_swipe_off;
+        }
+    }

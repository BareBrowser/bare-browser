+    private void initSwipeActionPref() {
+        ListPreference swipe = (ListPreference) findPreference(PREF_SWIPE);
+        assert swipe != null;
+
+        @BareToolbarSwipeAction int[] values = {
+            BareToolbarSwipeAction.OFF,
+            BareToolbarSwipeAction.BRIGHTNESS,
+            BareToolbarSwipeAction.VOLUME,
+        };
+        CharSequence[] labels = new CharSequence[values.length];
+        CharSequence[] stored = new CharSequence[values.length];
+        for (int i = 0; i < values.length; i++) {
+            labels[i] = getString(swipeLabel(values[i]));
+            stored[i] = String.valueOf(values[i]);
+        }
+
+        swipe.setPersistent(false);
+        swipe.setEntries(labels);
+        swipe.setEntryValues(stored);
+        swipe.setValue(String.valueOf(BareToolbarSwipePrefs.getAction()));
+        swipe.setSummary(getString(swipeLabel(BareToolbarSwipePrefs.getAction())));
+        swipe.setOnPreferenceChangeListener(
+                (pref, newValue) -> {
+                    @BareToolbarSwipeAction
+                    int chosen = Integer.parseInt((String) newValue);
+                    BareToolbarSwipePrefs.setAction(chosen);
+                    pref.setSummary(getString(swipeLabel(chosen)));
+                    return true;
+                });
+    }
+

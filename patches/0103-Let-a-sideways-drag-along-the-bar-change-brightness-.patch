+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.ui.bottombar;
+
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.chrome.browser.preferences.ChromePreferenceKeys;
+import org.chromium.chrome.browser.preferences.ChromeSharedPreferences;
+
+/**
+ * Stores what a sideways drag along the bottom bar does.
+ *
+ * <p>Read through rather than seeded, the same as the slot preferences: a profile that has never
+ * opened the setting holds nothing, and a gesture nobody asked for does nothing.
+ */
+@NullMarked
+public final class BareToolbarSwipePrefs {
+    private BareToolbarSwipePrefs() {}
+
+    /** What the gesture currently does. */
+    public static @BareToolbarSwipeAction int getAction() {
+        int stored =
+                ChromeSharedPreferences.getInstance()
+                        .readInt(
+                                ChromePreferenceKeys.BOTTOM_BAR_SWIPE_ACTION,
+                                BareToolbarSwipeAction.OFF);
+        switch (stored) {
+            case BareToolbarSwipeAction.BRIGHTNESS:
+            case BareToolbarSwipeAction.VOLUME:
+                return stored;
+            default:
+                // Includes a value written by a build that offered something this one does not.
+                return BareToolbarSwipeAction.OFF;
+        }
+    }
+
+    /** Records what the gesture should do. */
+    public static void setAction(@BareToolbarSwipeAction int action) {
+        if (action == BareToolbarSwipeAction.OFF) {
+            ChromeSharedPreferences.getInstance()
+                    .removeKey(ChromePreferenceKeys.BOTTOM_BAR_SWIPE_ACTION);
+            return;
+        }
+        ChromeSharedPreferences.getInstance()
+                .writeInt(ChromePreferenceKeys.BOTTOM_BAR_SWIPE_ACTION, action);
+    }
+}

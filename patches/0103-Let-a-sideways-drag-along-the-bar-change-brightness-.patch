+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.ui.bottombar;
+
+import android.app.Activity;
+import android.content.Context;
+import android.media.AudioManager;
+import android.provider.Settings;
+import android.view.Window;
+import android.view.WindowManager;
+
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+
+/**
+ * Turns a drag along the bottom bar into a change to brightness or volume.
+ *
+ * <p>Brightness here means Bare's own window and nothing else. Android will let an app change the
+ * screen brightness for the duration of its own window without any permission, and will let it
+ * change the device's brightness only with one the user has to grant on a separate settings
+ * screen. The second is a large thing to ask for a gesture on a toolbar, and it would leave the
+ * phone dimmed after Bare was closed, so this only ever sets the window's own value.
+ */
+@NullMarked
+public class BareToolbarSwipeAdjuster {
+
+    /**
+     * Never quite off.
+     *
+     * <p>Zero is a legal window brightness and on most phones it is not black, but it is dark
+     * enough that the toolbar the user is dragging becomes hard to see, and the way back is the
+     * gesture they can no longer find.
+     */
+    private static final float MIN_BRIGHTNESS = 0.02f;
+
+    /** What Android's brightness setting counts up to. */
+    private static final float SYSTEM_BRIGHTNESS_RANGE = 255f;
+
+    private final Context mContext;
+    private final @Nullable Activity mActivity;
+    private final @Nullable AudioManager mAudioManager;
+
+    public BareToolbarSwipeAdjuster(Context context, @Nullable Activity activity) {
+        mContext = context;
+        mActivity = activity;
+        mAudioManager = (AudioManager) context.getSystemService(Context.AUDIO_SERVICE);
+    }
+
+    /** Whether the given action can be carried out at all. */
+    public boolean canAdjust(@BareToolbarSwipeAction int action) {
+        switch (action) {
+            case BareToolbarSwipeAction.BRIGHTNESS:
+                return window() != null;
+            case BareToolbarSwipeAction.VOLUME:
+                return mAudioManager != null;
+            default:
+                return false;
+        }
+    }
+
+    /** Where the slider should start, as a fraction of the whole range. */
+    public float currentValue(@BareToolbarSwipeAction int action) {
+        if (action == BareToolbarSwipeAction.VOLUME) return currentVolume();
+        return currentBrightness();
+    }
+
+    /** Applies a new value. */
+    public void apply(@BareToolbarSwipeAction int action, float fraction) {
+        if (action == BareToolbarSwipeAction.VOLUME) {
+            applyVolume(fraction);
+        } else {
+            applyBrightness(fraction);
+        }
+    }
+
+    // Brightness.
+
+    /**
+     * The brightness the window is showing at.
+     *
+     * <p>A window that has not been given a value of its own reports a sentinel meaning "whatever
+     * the device is doing", so the first drag has to ask the device instead, or the slider would
+     * jump from nowhere to wherever the finger happens to be.
+     */
+    private float currentBrightness() {
+        @Nullable Window window = window();
+        if (window != null) {
+            float set = window.getAttributes().screenBrightness;
+            if (set >= 0f) return set;
+        }
+        try {
+            int system =
+                    Settings.System.getInt(
+                            mContext.getContentResolver(), Settings.System.SCREEN_BRIGHTNESS);
+            return clamp(system / SYSTEM_BRIGHTNESS_RANGE);
+        } catch (Settings.SettingNotFoundException e) {
+            // Nothing to read, which happens on a device brightening itself automatically.
+            return 0.5f;
+        }
+    }
+
+    private void applyBrightness(float fraction) {
+        @Nullable Window window = window();
+        if (window == null) return;
+        WindowManager.LayoutParams attributes = window.getAttributes();
+        attributes.screenBrightness = clamp(fraction);
+        window.setAttributes(attributes);
+    }
+
+    // Volume.
+
+    private float currentVolume() {
+        if (mAudioManager == null) return 0f;
+        int min = mAudioManager.getStreamMinVolume(AudioManager.STREAM_MUSIC);
+        int max = mAudioManager.getStreamMaxVolume(AudioManager.STREAM_MUSIC);
+        if (max <= min) return 0f;
+        int current = mAudioManager.getStreamVolume(AudioManager.STREAM_MUSIC);
+        return (float) (current - min) / (max - min);
+    }
+
+    /**
+     * Sets the media volume, in the steps the device actually has.
+     *
+     * <p>Without the system's own volume panel: the bar the user is dragging is the feedback, and
+     * a second slider appearing over it on every movement would be the louder of the two.
+     */
+    private void applyVolume(float fraction) {
+        if (mAudioManager == null) return;
+        int min = mAudioManager.getStreamMinVolume(AudioManager.STREAM_MUSIC);
+        int max = mAudioManager.getStreamMaxVolume(AudioManager.STREAM_MUSIC);
+        if (max <= min) return;
+        int index = min + Math.round(clamp01(fraction) * (max - min));
+        try {
+            mAudioManager.setStreamVolume(AudioManager.STREAM_MUSIC, index, /* flags= */ 0);
+        } catch (SecurityException e) {
+            // Do Not Disturb can forbid changing the volume. Refused rather than crashed.
+        }
+    }
+
+    private @Nullable Window window() {
+        return mActivity == null ? null : mActivity.getWindow();
+    }
+
+    private static float clamp(float value) {
+        return Math.max(MIN_BRIGHTNESS, Math.min(1f, value));
+    }
+
+    private static float clamp01(float value) {
+        return Math.max(0f, Math.min(1f, value));
+    }
+}

+package org.chromium.chrome.browser.ui.bottombar;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+
+import android.app.Activity;
+import android.view.LayoutInflater;
+import android.view.MotionEvent;
+import android.view.View;
+import android.view.ViewConfiguration;
+
+import androidx.test.ext.junit.rules.ActivityScenarioRule;
+
+import org.junit.After;
+import org.junit.Before;
+import org.junit.Rule;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+
+import org.chromium.base.test.BaseRobolectricTestRunner;
+import org.chromium.chrome.browser.preferences.ChromePreferenceKeys;
+import org.chromium.chrome.browser.preferences.ChromeSharedPreferences;
+import org.chromium.ui.base.TestActivity;
+
+/**
+ * Unit tests for the sideways drag along the bottom bar.
+ *
+ * <p>Mostly about when the bar takes the touch away from a button, which is the part that can make
+ * the toolbar feel broken if it is wrong.
+ */
+@RunWith(BaseRobolectricTestRunner.class)
+public class BareToolbarSwipeGestureUnitTest {
+    @Rule
+    public ActivityScenarioRule<TestActivity> mActivityScenarioRule =
+            new ActivityScenarioRule<>(TestActivity.class);
+
+    private Activity mActivity;
+    private BottomBarView mView;
+    private int mSlop;
+    private long mDownTime;
+
+    @Before
+    public void setUp() {
+        mActivityScenarioRule.getScenario().onActivity(this::onActivity);
+        clearPref();
+    }
+
+    @After
+    public void tearDown() {
+        clearPref();
+    }
+
+    private void onActivity(Activity activity) {
+        mActivity = activity;
+        mView =
+                (BottomBarView)
+                        LayoutInflater.from(activity)
+                                .inflate(R.layout.bottom_bar_layout, null, false);
+        mView.measure(
+                View.MeasureSpec.makeMeasureSpec(1080, View.MeasureSpec.EXACTLY),
+                View.MeasureSpec.makeMeasureSpec(160, View.MeasureSpec.EXACTLY));
+        mView.layout(0, 0, 1080, 160);
+        mView.setSwipeAdjuster(new BareToolbarSwipeAdjuster(activity, activity));
+        mSlop = ViewConfiguration.get(activity).getScaledTouchSlop();
+    }
+
+    private void clearPref() {
+        ChromeSharedPreferences.getInstance()
+                .removeKey(ChromePreferenceKeys.BOTTOM_BAR_SWIPE_ACTION);
+    }
+
+    private void setAction(@BareToolbarSwipeAction int action) {
+        BareToolbarSwipePrefs.setAction(action);
+    }
+
+    private boolean down(float x, float y) {
+        mDownTime = 1000L;
+        MotionEvent event =
+                MotionEvent.obtain(mDownTime, mDownTime, MotionEvent.ACTION_DOWN, x, y, 0);
+        boolean intercepted = mView.onInterceptTouchEvent(event);

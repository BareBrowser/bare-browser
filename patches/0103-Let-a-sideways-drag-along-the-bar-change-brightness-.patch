+package org.chromium.chrome.browser.ui.bottombar;
+
+import android.content.Context;
+import android.content.res.ColorStateList;
+import android.graphics.Canvas;
+import android.graphics.Paint;
+import android.graphics.RectF;
+import android.graphics.drawable.Drawable;
+import android.util.AttributeSet;
+import android.view.View;
+
+import androidx.annotation.ColorInt;
+import androidx.appcompat.content.res.AppCompatResources;
+import androidx.core.graphics.drawable.DrawableCompat;
+
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.components.browser_ui.styles.SemanticColorUtils;
+
+/**
+ * What the bottom bar looks like while a value is being dragged.
+ *
+ * <p>It takes the bar's place rather than appearing over it. The gesture starts on the bar and the
+ * bar is what the finger is on, so the thing that responds should be the same object; something
+ * floating above it would be a second surface to explain.
+ *
+ * <p>Drawn rather than assembled from widgets because it does not behave: it has no touch handling
+ * of its own, cannot be focused, and shows a number nobody typed. The bar owns the gesture and
+ * this shows where it has got to.
+ */
+@NullMarked
+public class BareToolbarSwipeSlider extends View {
+
+    private final Paint mPaint = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final RectF mTrack = new RectF();
+
+    private final int mTrackHeightPx;
+    private final int mHorizontalInsetPx;
+    private final int mIconGapPx;
+
+    private float mValue;
+    private @Nullable Drawable mIcon;
+
+    public BareToolbarSwipeSlider(Context context, @Nullable AttributeSet attrs) {
+        super(context, attrs);
+        float density = context.getResources().getDisplayMetrics().density;
+        mTrackHeightPx = Math.round(4 * density);
+        mHorizontalInsetPx = Math.round(24 * density);
+        mIconGapPx = Math.round(16 * density);
+        setWillNotDraw(false);
+    }
+
+    /**
+     * Shows the slider for one action, starting at the given value.
+     *
+     * @param action What is being changed, which decides the icon.
+     * @param value Where the value sits in its range, from zero to one.
+     */
+    /*package*/ void begin(@BareToolbarSwipeAction int action, float value) {
+        int iconRes =
+                action == BareToolbarSwipeAction.VOLUME
+                        ? R.drawable.ic_volume_up_fill_24dp
+                        : R.drawable.ic_brightness_medium_24dp;
+        mIcon = AppCompatResources.getDrawable(getContext(), iconRes);
+        if (mIcon != null) {
+            mIcon = DrawableCompat.wrap(mIcon.mutate());
+            DrawableCompat.setTint(mIcon, iconColor());
+        }
+        setValue(value);
+    }
+
+    /** Moves the filled part of the track. */
+    /*package*/ void setValue(float value) {
+        float clamped = Math.max(0f, Math.min(1f, value));
+        if (clamped == mValue) return;
+        mValue = clamped;
+        invalidate();
+    }
+
+    /*package*/ float getValue() {
+        return mValue;
+    }
+
+    @Override
+    protected void onDraw(Canvas canvas) {
+        super.onDraw(canvas);
+
+        int left = mHorizontalInsetPx;
+        int right = getWidth() - mHorizontalInsetPx;
+        int centerY = getHeight() / 2;
+
+        if (mIcon != null) {
+            int size = mIcon.getIntrinsicHeight();
+            int top = centerY - size / 2;
+            mIcon.setBounds(left, top, left + mIcon.getIntrinsicWidth(), top + size);
+            mIcon.draw(canvas);
+            left += mIcon.getIntrinsicWidth() + mIconGapPx;
+        }
+
+        if (right <= left) return;
+
+        float radius = mTrackHeightPx / 2f;
+        float top = centerY - radius;
+        float bottom = centerY + radius;
+
+        mPaint.setColor(trackColor());
+        mTrack.set(left, top, right, bottom);
+        canvas.drawRoundRect(mTrack, radius, radius, mPaint);
+
+        mPaint.setColor(fillColor());
+        mTrack.set(left, top, left + (right - left) * mValue, bottom);
+        canvas.drawRoundRect(mTrack, radius, radius, mPaint);
+    }
+
+    private @ColorInt int iconColor() {
+        return SemanticColorUtils.getDefaultIconColor(getContext());
+    }
+
+    private @ColorInt int fillColor() {
+        return SemanticColorUtils.getDefaultIconColor(getContext());
+    }
+
+    /** The unfilled part, kept low contrast so the filled part reads as the value. */
+    private @ColorInt int trackColor() {
+        ColorStateList tint = BottomBarUtils.getIconColorStateList(getContext(), mColorScheme);
+        int base = tint == null ? fillColor() : tint.getDefaultColor();
+        return (base & 0x00FFFFFF) | 0x3D000000;
+    }
+
+    private int mColorScheme;
+
+    /** Keeps the slider in step with the bar it replaces. */
+    /*package*/ void setColorScheme(int colorScheme) {
+        mColorScheme = colorScheme;
+        invalidate();
+    }
+}

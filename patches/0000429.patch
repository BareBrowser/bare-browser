+#ifndef CHROME_BROWSER_ANDROID_COMPOSITOR_SCENE_LAYER_BARE_STATUS_FADE_SCENE_LAYER_H_
+#define CHROME_BROWSER_ANDROID_COMPOSITOR_SCENE_LAYER_BARE_STATUS_FADE_SCENE_LAYER_H_
+
+#include <cstdint>
+
+#include "base/android/jni_android.h"
+#include "base/android/scoped_java_ref.h"
+#include "chrome/browser/ui/android/layouts/scene_layer.h"
+
+namespace cc::slim {
+class SolidColorLayer;
+}  // namespace cc::slim
+
+namespace android {
+
+// Page-colored fade over the status-bar inset. Shown while
+// page content is under the status bar, with "Keep status bar shown" on or
+// off and the address bar at the top or the bottom. Off for the tab switcher,
+// a full-screen scrim, and full-screen video.
+class BareStatusFadeSceneLayer : public SceneLayer {
+ public:
+  BareStatusFadeSceneLayer(JNIEnv* env,
+                           const base::android::JavaRef<jobject>& jobj);
+
+  BareStatusFadeSceneLayer(const BareStatusFadeSceneLayer&) = delete;
+  BareStatusFadeSceneLayer& operator=(const BareStatusFadeSceneLayer&) = delete;
+
+  ~BareStatusFadeSceneLayer() override;
+
+  // `height` is the status-bar inset in pixels. `color_argb` is the opaque
+  // page color. The mask supplies the only alpha.
+  void UpdateFade(JNIEnv* env,
+                  int32_t width,
+                  int32_t height,
+                  int32_t color_argb);
+
+  void SetContentTree(JNIEnv* env,
+                      const base::android::JavaRef<jobject>& jcontent_tree);
+
+  SkColor GetBackgroundColor() override;
+  bool ShouldShowBackground() override;
+
+ private:
+  bool should_show_background_{false};
+  SkColor background_color_{SK_ColorWHITE};
+  // Page color. Not contents-opaque: the gradient mask is the only alpha.
+  scoped_refptr<cc::slim::SolidColorLayer> fade_;
+};
+
+}  // namespace android
+
+#endif  // CHROME_BROWSER_ANDROID_COMPOSITOR_SCENE_LAYER_BARE_STATUS_FADE_SCENE_LAYER_H_

--- /dev/null
+++ b/chrome/android/java/src/org/chromium/chrome/browser/bare/BarePageColorSampler.java
@@ -0,0 +1,104 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.bare;
+
+import android.graphics.Color;
+import android.os.Handler;
+import android.os.Looper;
+
+import androidx.annotation.ColorInt;
+
+import org.jni_zero.JNINamespace;
+import org.jni_zero.NativeMethods;
+
+import org.chromium.base.Callback;
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.chrome.browser.tab.Tab;
+import org.chromium.content_public.browser.WebContents;
+
+/**
+ * Reads a 5-wide strip of the page surface under the status-bar fade. At most one readback is in
+ * flight. The browser window is not the source, so the fade cannot feed itself.
+ */
+@JNINamespace("android")
+@NullMarked
+public class BarePageColorSampler {
+    /** Euclidean RGB distance. Solid sections agree; a photograph does not. */
+    private static final int MAX_DISTANCE_SQ = 30 * 30;
+
+    private static final Handler HANDLER = new Handler(Looper.getMainLooper());
+    private static boolean sInFlight;
+
+    /**
+     * Starts a readback of the row at {@code sampleScreenY} in window pixels.
+     *
+     * @return false when a readback is already in flight or the tab has no page surface. The
+     *     callback receives five opaque colors, or an empty array when the readback fails.
+     */
+    public static boolean request(Tab tab, int sampleScreenY, Callback<int[]> callback) {
+        if (sInFlight) return false;
+        WebContents webContents = tab.getWebContents();
+        if (webContents == null || webContents.isDestroyed()) return false;
+        sInFlight = true;
+        BarePageColorSamplerJni.get()
+                .sample(
+                        tab,
+                        sampleScreenY,
+                        (int[] colors) ->
+                                HANDLER.post(
+                                        () -> {
+                                            sInFlight = false;
+                                            callback.onResult(colors);
+                                        }));
+        return true;
+    }
+
+    /**
+     * Average of the largest cluster when at least four of the five samples are within {@link
+     * #MAX_DISTANCE_SQ}. Returns null when they disagree, so the caller keeps the previous color.
+     */
+    public static @Nullable @ColorInt Integer agreedColor(@ColorInt int[] samples) {
+        if (samples.length != 5) return null;
+        int bestCount = 0;
+        int bestRed = 0;
+        int bestGreen = 0;
+        int bestBlue = 0;
+        for (int i = 0; i < 5; i++) {
+            int count = 0;
+            int red = 0;
+            int green = 0;
+            int blue = 0;
+            for (int j = 0; j < 5; j++) {
+                if (distanceSq(samples[i], samples[j]) <= MAX_DISTANCE_SQ) {
+                    count++;
+                    red += Color.red(samples[j]);
+                    green += Color.green(samples[j]);
+                    blue += Color.blue(samples[j]);
+                }
+            }
+            if (count > bestCount) {
+                bestCount = count;
+                bestRed = red;
+                bestGreen = green;
+                bestBlue = blue;
+            }
+        }
+        if (bestCount < 4) return null;
+        return Color.rgb(bestRed / bestCount, bestGreen / bestCount, bestBlue / bestCount);
+    }
+
+    private static int distanceSq(@ColorInt int a, @ColorInt int b) {
+        int dr = Color.red(a) - Color.red(b);
+        int dg = Color.green(a) - Color.green(b);
+        int db = Color.blue(a) - Color.blue(b);
+        return dr * dr + dg * dg + db * db;
+    }
+
+    @NativeMethods
+    interface Natives {
+        void sample(Tab tab, int sampleScreenY, Callback<int[]> callback);
+    }
+}

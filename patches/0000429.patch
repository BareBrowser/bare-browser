@@ -0,0 +1,85 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.bare;
+
+import android.app.Activity;
+import android.view.DisplayCutout;
+import android.view.WindowInsets;
+
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.chrome.browser.tab.Tab;
+import org.chromium.content_public.browser.WebContents;
+
+/**
+ * While the status bar is hidden, moves top-pinned, near-full-width fixed and sticky page elements
+ * down by the status-bar inset so they clear the camera cutout. Other page content stays full
+ * screen. The adjustment is removed when the status bar returns.
+ */
+@NullMarked
+public final class BarePinnedOffset {
+    private BarePinnedOffset() {}
+
+    /** Applies or clears the offset on the tab's main frame. Native pages have no site menus. */
+    public static void sync(Activity activity, @Nullable Tab tab, boolean hidden) {
+        if (tab == null || tab.isNativePage()) return;
+        WebContents webContents = tab.getWebContents();
+        if (webContents == null || webContents.isDestroyed()) return;
+        int insetCss = 0;
+        // No camera hole: leave pinned menus at the top edge. A hole uses the status-bar inset,
+        // which is the band that contains it.
+        if (hidden && cutoutTop(activity) > 0) {
+            float density = activity.getResources().getDisplayMetrics().density;
+            int physical = BareStatusBarLayer.statusBarHeight(activity);
+            insetCss = density > 0f ? Math.round(physical / density) : physical;
+        }
+        BareScriptBridge.evaluate(webContents, script(hidden, insetCss), null);
+    }
+
+
+    private static int cutoutTop(Activity activity) {
+        WindowInsets insets = activity.getWindow().getDecorView().getRootWindowInsets();
+        if (insets == null) return 0;
+        DisplayCutout cutout = insets.getDisplayCutout();
+        return cutout == null ? 0 : cutout.getSafeInsetTop();
+    }
+
+    // Runs in an isolated world. It records the inline top it replaces and puts that back.
+    private static String script(boolean hidden, int insetCss) {
+        return "(function(){try{"
+                + "var s=window.__barePin||(window.__barePin={list:[],map:new WeakMap(),listening:false,scheduled:false});"
+                + "s.hidden=" + (hidden ? "true" : "false") + ";s.inset=" + insetCss + ";"
+                + "function restore(el){var saved=s.map.get(el);if(!saved)return;"
+                + "if(saved.prev==='')el.style.removeProperty('top');"
+                + "else el.style.setProperty('top',saved.prev,saved.prevPri);s.map.delete(el);}"
+                + "function clearAll(){for(var i=0;i<s.list.length;i++)restore(s.list[i]);s.list=[];}"
+                + "function consider(el){if(!el||el===document.body||el===document.documentElement)return;"
+                + "var cs=getComputedStyle(el);var pos=cs.position;if(pos!=='fixed'&&pos!=='sticky')return;"
+                + "var r=el.getBoundingClientRect();if(r.width<innerWidth*0.65)return;"
+                + "if(r.height<8||r.height>innerHeight*0.4)return;"
+                + "var already=s.map.has(el);var band=already?s.inset+180:180;"
+                + "if(r.top<-8||r.top>band)return;if(cs.top==='auto')return;"
+                + "var topPx=parseFloat(cs.top);if(isNaN(topPx))return;"
+                + "if(!already&&topPx>180)return;if(already)return;if(topPx>=s.inset-1)return;"
+                + "s.map.set(el,{prev:el.style.getPropertyValue('top'),prevPri:el.style.getPropertyPriority('top')});"
+                + "s.list.push(el);el.style.setProperty('top',(topPx+s.inset)+'px','important');}"
+                + "function climb(node){var el=node;var guard=0;while(el&&guard++<16){consider(el);"
+                + "var root=el.getRootNode?el.getRootNode():null;"
+                + "el=el.parentElement||(root&&root.host)||null;}}"
+                + "function scan(){if(!s.hidden||s.inset<=0){clearAll();return;}"
+                + "var ys=[1,32,64,96,128];for(var i=0;i<ys.length;i++){var y=ys[i];"
+                + "var xs=[0.2,0.4,0.5,0.6,0.8];for(var j=0;j<xs.length;j++){"
+                + "var node=document.elementFromPoint(innerWidth*xs[j],y);if(node)climb(node);}}}"
+                + "if(!s.listening){s.listening=true;"
+                + "addEventListener('scroll',function(){if(!s.hidden||s.scheduled)return;"
+                + "s.scheduled=true;requestAnimationFrame(function(){s.scheduled=false;if(s.hidden)scan();});},"
+                + "{capture:true,passive:true});"
+                + "addEventListener('resize',function(){if(!s.hidden||s.scheduled)return;"
+                + "s.scheduled=true;requestAnimationFrame(function(){s.scheduled=false;if(s.hidden)scan();});},"
+                + "{passive:true});}"
+                + "scan();requestAnimationFrame(function(){requestAnimationFrame(scan);});"
+                + "}catch(e){}})();";
+    }
+}
diff --git a/chrome/android/java/src/org/chromium/chrome/browser/bare/BareStatusBarLayer.java b/chrome/android/java/src/org/chromium/chrome/browser/bare/BareStatusBarLayer.java
new file mode 100644
index 0000000000000..fa57bf1786498
--- /dev/null
+++ b/chrome/android/java/src/org/chromium/chrome/browser/bare/BareStatusBarLayer.java
@@ -0,0 +1,240 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.bare;
+
+import android.app.Activity;
+import android.content.SharedPreferences;
+import android.graphics.Color;
+import android.os.Build;
+import android.view.Gravity;
+import android.view.View;
+import android.view.ViewGroup;
+import android.view.WindowInsets;
+import android.widget.FrameLayout;
+
+import androidx.annotation.ColorInt;
+
+import org.chromium.base.ContextUtils;
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.chrome.browser.preferences.ChromePreferenceKeys;
+import org.chromium.ui.util.ColorUtils;
+import org.chromium.chrome.browser.browser_controls.BrowserControlsStateProvider;
+import org.chromium.chrome.browser.browser_controls.BrowserControlsStateProvider.ControlsPosition;
+import org.chromium.chrome.browser.browser_controls.TopControlLayer;
+import org.chromium.chrome.browser.browser_controls.TopControlsStacker;
+import org.chromium.chrome.browser.browser_controls.TopControlsStacker.TopControlType;
+import org.chromium.chrome.browser.browser_controls.TopControlsStacker.TopControlVisibility;
+import org.chromium.chrome.browser.tab.Tab;
+import org.chromium.chrome.browser.theme.ThemeColorProvider.ThemeColorObserver;
+import org.chromium.chrome.browser.theme.ThemeUtils;
+import org.chromium.chrome.browser.theme.TopUiThemeColorProvider;
+
+import java.util.function.Supplier;
+
+/**
+ * A top control as tall as the status bar. The page lays out below it and scrolls it away with the
+ * other browser controls. The strip stays clear so the page-colored fade shows
+ * through the inset, with the address bar on the top or the bottom and Keep
+ * status bar shown on or off. A sheet scrim still paints the toolbar color.
+ */
+@NullMarked
+public final class BareStatusBarLayer implements TopControlLayer, ThemeColorObserver {
+    private final Activity mActivity;
+    private final TopUiThemeColorProvider mThemeColorProvider;
+    private final BrowserControlsStateProvider mControls;
+    private final Supplier<@Nullable Tab> mTabSupplier;
+    private final View mStrip;
+    private int mHeight;
+    // The toolbar theme color. A scrim is only overlaid on top of it.
+    private @ColorInt int mBaseColor;
+    private @ColorInt int mScrimColor = Color.TRANSPARENT;
+    // 0 to 1. How much the strip paints the toolbar color while the top address bar is shown.
+    private float mToolbarCover;
+    private @ColorInt int mCoverColor;
+
+    // Held strongly: shared preferences keep only a weak reference to a listener.
+    private final SharedPreferences.OnSharedPreferenceChangeListener mKeepShownListener =
+            (prefs, key) -> {
+                if (ChromePreferenceKeys.BARE_KEEP_STATUS_BAR_SHOWN.equals(key)) {
+                    syncStrip();
+                }
+            };
+
+    public BareStatusBarLayer(
+            Activity activity,
+            TopControlsStacker stacker,
+            TopUiThemeColorProvider themeColorProvider,
+            BrowserControlsStateProvider controls,
+            Supplier<@Nullable Tab> tabSupplier) {
+        mActivity = activity;
+        mThemeColorProvider = themeColorProvider;
+        mControls = controls;
+        mTabSupplier = tabSupplier;
+        mHeight = statusBarHeight(activity);
+        mStrip = new View(activity);
+        mStrip.setClickable(false);
+        mStrip.setFocusable(false);
+        mStrip.setImportantForAccessibility(View.IMPORTANT_FOR_ACCESSIBILITY_NO);
+        // Drawn after the content child, which holds the compositor, without a shadow.
+        mStrip.setElevation(24f);
+        mStrip.setOutlineProvider(null);
+        // The decor is not padded once the window draws edge to edge, so a top-gravity child of
+        // this height sits in the status-bar inset. It is outside the padded content layout, so
+        // that layout's dispatchDraw clip cannot hide it.
+        View decor = activity.getWindow().getDecorView();
+        ((ViewGroup) decor)
+                .addView(
+                        mStrip,
+                        new FrameLayout.LayoutParams(
+                                ViewGroup.LayoutParams.MATCH_PARENT,
+                                Math.max(mHeight, 0),
+                                Gravity.TOP));
+        applyThemeColor();
+        mThemeColorProvider.addThemeColorObserver(this);
+        mControls.addObserver(
+                new BrowserControlsStateProvider.Observer() {
+                    @Override
+                    public void onControlsOffsetChanged(
+                            int topOffset,
+                            int topControlsMinHeightOffset,
+                            boolean topControlsMinHeightChanged,
+                            int bottomOffset,
+                            int bottomControlsMinHeightOffset,
+                            boolean bottomControlsMinHeightChanged,
+                            boolean requestNewFrame,
+                            boolean isVisibilityForced) {
+                        // Same offset BrowserControlsManager applies to the toolbar view.
+                        if (mStrip.getVisibility() == View.VISIBLE) {
+                            mStrip.setTranslationY(topOffset);
+                        }
+                    }
+
+                    @Override
+                    public void onControlsPositionChanged(
+                            @ControlsPosition int controlsPosition) {
+                        syncStrip();
+                    }
+                });
+        decor.addOnLayoutChangeListener(
+                (v, l, t, r, b, ol, ot, or, ob) -> {
+                    int height = statusBarHeight(mActivity);
+                    if (height != mHeight) {
+                        mHeight = height;
+                        FrameLayout.LayoutParams lp =
+                                (FrameLayout.LayoutParams) mStrip.getLayoutParams();
+                        lp.height = Math.max(mHeight, 0);
+                        mStrip.setLayoutParams(lp);
+                        stacker.requestLayerUpdatePost(false);
+                    }
+                    syncStrip();
+                });
+        org.chromium.chrome.browser.browser_controls.BareMenuScrim.setListener(
+                this::setScrimColor);
+        ContextUtils.getAppSharedPreferences()
+                .registerOnSharedPreferenceChangeListener(mKeepShownListener);
+        syncStrip();
+    }
+
+    /** Returns the status bar height, also while the status bar is hidden. */
+    public static int statusBarHeight(Activity activity) {
+        View decor = activity.getWindow().getDecorView();
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.R) {
+            WindowInsets insets = decor.getRootWindowInsets();
+            if (insets != null) {
+                int top = insets.getInsetsIgnoringVisibility(WindowInsets.Type.statusBars()).top;
+                if (top > 0) return top;
+            }
+        }
+        int id = activity.getResources().getIdentifier("status_bar_height", "dimen", "android");
+        return id > 0 ? activity.getResources().getDimensionPixelSize(id) : 0;
+    }
+
+    @Override
+    public @TopControlType int getTopControlType() {
+        return TopControlType.BARE_STATUS_BAR;
+    }
+
+    @Override
+    public int getTopControlHeight() {
+        return mHeight;
+    }
+
+    @Override
+    public @TopControlVisibility int getTopControlVisibility() {
+        return mHeight > 0 ? TopControlVisibility.VISIBLE : TopControlVisibility.HIDDEN;
+    }
+
+    @Override
+    public void onThemeColorChanged(int color, boolean shouldAnimate) {
+        // This is the color TopUiThemeColorProvider just fed to the toolbar background.
+        mBaseColor = color;
+        paint();
+    }
+
+    /**
+     * Blends the page scrim over the theme color while a bottom sheet's scrim is showing, and
+     * clears it when that scrim is gone. The theme color itself is unchanged.
+     */
+    public void setScrimColor(@ColorInt int scrimColor) {
+        if (mScrimColor == scrimColor) return;
+        mScrimColor = scrimColor;
+        paint();
+        syncStrip();
+    }
+
+    /**
+     * Paints {@code toolbarColor} at {@code cover} alpha while the top address bar is fully shown,
+     * crossfading with the page-colored fade. 0 leaves the strip clear. The color is the toolbar
+     * background, which on the new tab page differs from the theme color.
+     */
+    public void setToolbarCover(float cover, @ColorInt int toolbarColor) {
+        if (cover == mToolbarCover && toolbarColor == mCoverColor) return;
+        mToolbarCover = cover;
+        mCoverColor = toolbarColor;
+        paint();
+        syncStrip();
+    }
+
+    private void applyThemeColor() {
+        @Nullable Tab tab = mTabSupplier.get();
+        mBaseColor =
+                tab != null
+                        ? mThemeColorProvider.getToolbarBackgroundColor(tab)
+                        : mThemeColorProvider.getThemeColor();
+        paint();
+    }
+
+    private void paint() {
+        if (mToolbarCover > 0f && Color.alpha(mScrimColor) == 0) {
+            mStrip.setBackgroundColor(mCoverColor);
+            return;
+        }
+        int base = mBaseColor;
+        if (mControls.getControlsPosition() == ControlsPosition.BOTTOM) {
+            @Nullable Tab tab = mTabSupplier.get();
+            if (tab != null) {
+                int page = ThemeUtils.getBackgroundColor(tab);
+                if (Color.alpha(page) == 255) base = page;
+            }
+        }
+        mStrip.setBackgroundColor(ColorUtils.overlayColor(base, mScrimColor));
+    }
+
+    /**
+     * Leaves the strip clear so the page-colored fade shows. A sheet scrim still
+     * paints here, in both Keep status bar shown values and at either
+     * address-bar position. While the top address bar is fully shown the strip
+     * paints the toolbar color at the cover alpha.
+     */
+    private void syncStrip() {
+        boolean scrimShowing = Color.alpha(mScrimColor) > 0;
+        boolean show = mHeight > 0 && (scrimShowing || mToolbarCover > 0f);
+        mStrip.setVisibility(show ? View.VISIBLE : View.GONE);
+        if (!show) return;
+        mStrip.setAlpha(scrimShowing ? 1f : mToolbarCover);
+        mStrip.setTranslationY(mControls.getTopControlOffset());
+    }
+}

@@ -0,0 +1,124 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include <algorithm>
+#include <memory>
+
+#include "base/android/callback_android.h"
+#include "base/android/jni_android.h"
+#include "base/android/jni_array.h"
+#include "base/android/scoped_java_ref.h"
+#include "base/containers/span.h"
+#include "base/functional/bind.h"
+#include "base/time/time.h"
+#include "chrome/browser/android/tab_android.h"
+#include "components/viz/common/frame_sinks/copy_output_result.h"
+#include "content/public/browser/render_widget_host_view.h"
+#include "content/public/browser/web_contents.h"
+#include "third_party/skia/include/core/SkBitmap.h"
+#include "third_party/skia/include/core/SkColor.h"
+#include "ui/android/view_android.h"
+#include "ui/gfx/geometry/rect.h"
+#include "ui/gfx/geometry/size.h"
+
+// Must come after all headers that specialize FromJniType() / ToJniType().
+#include "chrome/android/chrome_jni_headers/BarePageColorSampler_jni.h"
+
+namespace android {
+namespace {
+
+// One readback at a time. A new request while this is set is dropped.
+bool g_in_flight = false;
+
+struct PendingSample {
+  base::android::ScopedJavaGlobalRef<jobject> callback;
+};
+
+void Deliver(const base::android::JavaRef<jobject>& callback,
+             base::span<const int32_t> samples) {
+  JNIEnv* env = base::android::AttachCurrentThread();
+  base::android::RunObjectCallbackAndroid(
+      callback, base::android::ToJavaIntArray(env, samples));
+}
+
+void OnCopyDone(std::unique_ptr<PendingSample> pending,
+                const content::CopyFromSurfaceResult& result) {
+  g_in_flight = false;
+  int32_t samples[5];
+  bool ok = false;
+  if (result.has_value() && !result->bitmap.empty()) {
+    const SkBitmap& bitmap = result->bitmap;
+    const int width = bitmap.width();
+    const int height = bitmap.height();
+    if (width > 0 && height > 0) {
+      base::span<int32_t> sample_span(samples);
+      const int y = height / 2;
+      for (size_t i = 0; i < sample_span.size(); ++i) {
+        const int x = width == 1 ? 0 : static_cast<int>(i) * (width - 1) / 4;
+        sample_span[i] = static_cast<int32_t>(bitmap.getColor(x, y));
+      }
+      ok = true;
+    }
+  }
+  if (!ok) {
+    Deliver(pending->callback, base::span<const int32_t>());
+    return;
+  }
+  Deliver(pending->callback, base::span(samples));
+}
+
+}  // namespace
+
+// Copies a 2 px row of the page compositor surface (not the browser window,
+// so the fade is not in the sample) and scales it to 5x1. `sample_screen_y`
+// is the glyph line in window pixels. The row is just below that line, in
+// the page view's pixel space.
+static void JNI_BarePageColorSampler_Sample(
+    JNIEnv* env,
+    const jni_zero::JavaRef<jobject>& j_tab,
+    int32_t sample_screen_y,
+    const jni_zero::JavaRef<jobject>& j_callback) {
+  if (g_in_flight) {
+    Deliver(j_callback, base::span<const int32_t>());
+    return;
+  }
+
+  TabAndroid* tab = TabAndroid::GetNativeTab(env, j_tab);
+  content::WebContents* web_contents = tab ? tab->web_contents() : nullptr;
+  content::RenderWidgetHostView* view =
+      web_contents ? web_contents->GetRenderWidgetHostView() : nullptr;
+  ui::ViewAndroid* native_view = view ? view->GetNativeView() : nullptr;
+  if (!view || !native_view || !view->IsSurfaceAvailableForCopy()) {
+    Deliver(j_callback, base::span<const int32_t>());
+    return;
+  }
+
+  const gfx::Size size = native_view->GetSizeDevicePx();
+  if (size.IsEmpty()) {
+    Deliver(j_callback, base::span<const int32_t>());
+    return;
+  }
+
+  const int view_top = native_view->GetLocationOfContainerViewInWindow().y();
+  int y = sample_screen_y - view_top;
+  if (y < 0) {
+    y = 0;
+  }
+  if (y >= size.height()) {
+    y = size.height() - 1;
+  }
+  const int row_height = std::min(2, size.height() - y);
+  const gfx::Rect src(0, y, size.width(), row_height);
+
+  g_in_flight = true;
+  auto pending = std::make_unique<PendingSample>();
+  pending->callback.Reset(env, j_callback);
+  // Short timeout: a stalled readback must not block the next sample.
+  view->CopyFromSurface(src, gfx::Size(5, 1), base::Milliseconds(250),
+                        base::BindOnce(&OnCopyDone, std::move(pending)));
+}
+
+}  // namespace android
+
+DEFINE_JNI(BarePageColorSampler)

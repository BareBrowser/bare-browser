+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/android/compositor/scene_layer/bare_status_fade_scene_layer.h"
+
+#include <algorithm>
+
+#include "cc/slim/solid_color_layer.h"
+#include "third_party/skia/include/core/SkColor.h"
+#include "ui/gfx/geometry/linear_gradient.h"
+#include "ui/gfx/geometry/point_f.h"
+#include "ui/gfx/geometry/size.h"
+
+// Must come after all headers that specialize FromJniType() / ToJniType().
+#include "chrome/android/chrome_jni_headers/BareStatusFadeSceneLayer_jni.h"
+
+using base::android::JavaRef;
+
+namespace android {
+namespace {
+
+// Smoothstep. 0 at the glyph line, 1 at the top of the eased region.
+float Smoothstep(float t) {
+  t = std::clamp(t, 0.f, 1.f);
+  return t * t * (3.f - 2.f * t);
+}
+
+// Angle 90 puts fraction 0 at the bottom of the layer and 1 at the top.
+// The top two pixels stay at 255 so text on that edge disappears. Below that
+// pin, seven smoothstep samples ease to 0 at the glyph line. LinearGradient
+// holds at most eight steps.
+gfx::LinearGradient FadeMask(int coverage) {
+  constexpr int kTopAlpha = 255;
+  constexpr int kEaseIntervals = 6;
+  const float two_px = 2.f / static_cast<float>(std::max(coverage, 1));
+  const float pin = std::clamp(1.f - two_px, 0.5f, 0.995f);
+  gfx::LinearGradient gradient(90);
+  for (int i = 0; i <= kEaseIntervals; ++i) {
+    const float u = static_cast<float>(i) / static_cast<float>(kEaseIntervals);
+    const float alpha = Smoothstep(u) * static_cast<float>(kTopAlpha);
+    gradient.AddStep(u * pin, static_cast<uint8_t>(alpha + 0.5f));
+  }
+  gradient.AddStep(1.f, static_cast<uint8_t>(kTopAlpha));
+  return gradient;
+}
+
+}  // namespace
+
+BareStatusFadeSceneLayer::BareStatusFadeSceneLayer(JNIEnv* env,
+                                                   const JavaRef<jobject>& jobj)
+    : SceneLayer(env, jobj), fade_(cc::slim::SolidColorLayer::Create()) {
+  layer()->SetIsDrawable(true);
+
+  fade_->SetIsDrawable(true);
+  fade_->SetPosition(gfx::PointF(0, 0));
+  // SetBackgroundColor() marks an opaque color contents-opaque. That draws a
+  // solid quad and hides the page under the mask. The mask is the coverage.
+  fade_->SetContentsOpaque(false);
+  layer()->AddChild(fade_);
+}
+
+BareStatusFadeSceneLayer::~BareStatusFadeSceneLayer() = default;
+
+void BareStatusFadeSceneLayer::UpdateFade(JNIEnv* env,
+                                          int32_t width,
+                                          int32_t height,
+                                          int32_t color_argb) {
+  if (width <= 0 || height <= 1) {
+    return;
+  }
+
+  // The status icons end at about 62% of the inset (107 of 173 px on a 173 px
+  // inset). The fade stops there. Nothing below the icons is covered.
+  constexpr float kGlyphBottom = 107.f / 173.f;
+  const int coverage =
+      std::max(1, static_cast<int>(height * kGlyphBottom + 0.5f));
+  fade_->SetBounds(gfx::Size(width, coverage));
+  fade_->SetBackgroundColor(SkColor4f::FromColor(color_argb));
+  fade_->SetContentsOpaque(false);
+  fade_->SetGradientMask(FadeMask(coverage));
+}
+
+void BareStatusFadeSceneLayer::SetContentTree(
+    JNIEnv* env,
+    const JavaRef<jobject>& jcontent_tree) {
+  SceneLayer* content_tree = FromJavaObject(env, jcontent_tree);
+  if (!content_tree || !content_tree->layer()) {
+    return;
+  }
+
+  if (!content_tree->layer()->parent() ||
+      content_tree->layer()->parent()->id() != layer_->id()) {
+    layer_->RemoveAllChildren();
+    layer_->AddChild(content_tree->layer());
+    layer_->AddChild(fade_);
+  }
+
+  should_show_background_ = content_tree->ShouldShowBackground();
+  background_color_ = content_tree->GetBackgroundColor();
+}
+
+SkColor BareStatusFadeSceneLayer::GetBackgroundColor() {
+  return background_color_;
+}
+
+bool BareStatusFadeSceneLayer::ShouldShowBackground() {
+  return should_show_background_;
+}
+
+static int64_t JNI_BareStatusFadeSceneLayer_Init(JNIEnv* env,
+                                                 const JavaRef<jobject>& jobj) {
+  BareStatusFadeSceneLayer* scene_layer =
+      new BareStatusFadeSceneLayer(env, jobj);
+  return reinterpret_cast<intptr_t>(scene_layer);
+}
+
+}  // namespace android

+<!-- A small picture of the fullscreen player, shown under the Bare Player row. Drawn from shapes
+     and the player's own icons; it is only illustrative and takes no touches. -->
+<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
+    android:layout_width="match_parent"

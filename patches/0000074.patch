Subject: [PATCH] Patch 0000074

---
 .../night_mode/WebContentsThemeClient.java    | 21 +++++++++++--------
 1 file changed, 12 insertions(+), 9 deletions(-)

diff --git a/chrome/browser/ui/android/night_mode/java/src/org/chromium/chrome/browser/night_mode/WebContentsThemeClient.java b/chrome/browser/ui/android/night_mode/java/src/org/chromium/chrome/browser/night_mode/WebContentsThemeClient.java
index bda8d2b45a6..2845a167de0 100644
--- a/chrome/browser/ui/android/night_mode/java/src/org/chromium/chrome/browser/night_mode/WebContentsThemeClient.java
+++ b/chrome/browser/ui/android/night_mode/java/src/org/chromium/chrome/browser/night_mode/WebContentsThemeClient.java
@@ -4,8 +4,6 @@
 
 package org.chromium.chrome.browser.night_mode;
 
-import android.content.Context;
-
 import org.jni_zero.CalledByNative;
 import org.jni_zero.JNINamespace;
 import org.jni_zero.JniType;
@@ -14,8 +12,6 @@ import org.chromium.build.annotations.NullMarked;
 import org.chromium.chrome.browser.flags.ChromeFeatureList;
 import org.chromium.chrome.browser.profiles.Profile;
 import org.chromium.content_public.browser.WebContents;
-import org.chromium.ui.base.WindowAndroid;
-import org.chromium.ui.util.ColorUtils;
 
 /** A client to provide dark mode information for a given WebContents. */
 @NullMarked
@@ -24,12 +20,19 @@ public class WebContentsThemeClient {
     @CalledByNative
     public static boolean isNightModeEnabled(
             @JniType("content::WebContents*") WebContents webContents) {
+        // De-Googled build: answer from the browser's own night mode rather than from a
+        // Context's configuration.
+        //
+        // This decides the colour the renderer fills with before a page paints its own
+        // background. Reading it from a Context means reading whichever configuration that
+        // Context carries, and the one reachable from a WebContents is not always the activity's,
+        // so a browser set to dark while the system is light was told light and filled white. The
+        // result was a white rectangle where the page was about to be, on every navigation.
+        //
+        // The global state has no such ambiguity: it is what the user chose, and it needs no
+        // Context to read.
         if (webContents == null) return false;
-        WindowAndroid window = webContents.getTopLevelNativeWindow();
-        if (window == null) return false;
-        Context context = window.getContext().get();
-        if (context == null) return false;
-        return ColorUtils.inNightMode(context);
+        return GlobalNightModeStateProviderHolder.getInstance().isInNightMode();
     }
 
     @CalledByNative

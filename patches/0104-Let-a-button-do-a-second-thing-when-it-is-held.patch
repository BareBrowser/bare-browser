+    public static int getSecondaryAction(@BareToolbarSlot int slot) {
+        if (!BareToolbarDefaults.isConfigurable(slot)) return BareToolbarDefaults.NO_ACTION;
+        int stored =
+                ChromeSharedPreferences.getInstance()
+                        .readInt(secondaryKey(slot), BareToolbarDefaults.NO_ACTION);

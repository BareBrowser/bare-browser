+    }
+
+    @Test
+    public void testTheHoldFollowsTheButtonThatIsThere() {
+        // The hold belongs to a position, so it hangs on whatever that position taps.
+        PropertyModel bookmark = register(ActionId.BOOKMARK, true);
+        register(ActionId.SHARE, true);
+        BareToolbarPrefs.assignPrimaryAction(BareToolbarSlot.HOME, ActionId.BOOKMARK);
+        BareToolbarPrefs.setSecondaryAction(BareToolbarSlot.HOME, ActionId.SHARE);
+
+        BareToolbarSecondaryActions actions = attach();
+        assertNotNull(bookmark.get(ActionProperties.ON_LONG_PRESS_CALLBACK));
+        hold(bookmark);
+        assertEquals(1, mInvokedCount);
+        actions.destroy();
+    }
+
+    @Test
+    public void testTakingTheHoldBackOffAgain() {
+        PropertyModel home = register(ActionId.HOME_BUTTON, true);
+        register(ActionId.SHARE, true);
+        BareToolbarPrefs.setSecondaryAction(BareToolbarSlot.HOME, ActionId.SHARE);
+
+        BareToolbarSecondaryActions actions = attach();
+        assertNotNull(home.get(ActionProperties.ON_LONG_PRESS_CALLBACK));

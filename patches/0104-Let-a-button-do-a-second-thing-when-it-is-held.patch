+        if (pressable) {
+            model.set(
+                    ActionProperties.ON_PRESS_CALLBACK, (Callback<View>) v -> mInvokedCount++);
+        }
+        mRegistry.register(actionId, model);
+        return model;
+    }
+
+    private BareToolbarSecondaryActions attach() {
+        return new BareToolbarSecondaryActions(mRegistry, () -> {});
+    }
+
+    private void hold(PropertyModel primaryModel) {

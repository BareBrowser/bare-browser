+     * is only ever asked of the one button being held.
+     */
+    public static void setSecondaryAction(@BareToolbarSlot int slot, int actionId) {
+        if (!BareToolbarDefaults.isConfigurable(slot)) return;
+        if (actionId == BareToolbarDefaults.NO_ACTION
+                || !BareToolbarDefaults.isConfigurableAction(actionId)) {
+            ChromeSharedPreferences.getInstance().removeKey(secondaryKey(slot));
+            return;
+        }
+        ChromeSharedPreferences.getInstance().writeInt(secondaryKey(slot), actionId);
+    }
+
+    /** Whether the user has said what holding this button does. */
+    public static boolean hasSecondaryAction(@BareToolbarSlot int slot) {
+        if (!BareToolbarDefaults.isConfigurable(slot)) return false;
+        return ChromeSharedPreferences.getInstance().contains(secondaryKey(slot));
+    }

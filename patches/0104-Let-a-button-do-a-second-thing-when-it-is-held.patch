+
+        BareToolbarSecondaryActions actions = attach();
+        hold(home);
+
+        assertEquals(0, mInvokedCount);
+        actions.destroy();
+    }
+
+    @Test
+    public void testTheActionIsLookedUpWhenHeldRatherThanWhenChosen() {
+        PropertyModel home = register(ActionId.HOME_BUTTON, true);
+        PropertyModel translate = register(ActionId.TRANSLATE, /* pressable= */ false);
+        BareToolbarPrefs.setSecondaryAction(BareToolbarSlot.HOME, ActionId.TRANSLATE);

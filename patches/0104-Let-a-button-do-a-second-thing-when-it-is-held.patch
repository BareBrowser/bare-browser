+    /**
+     * Offers what holding this button could do, including nothing.
+     *
+     * <p>No swapping and no uniqueness, unlike the tap. A hold is only ever asked of the button
+     * being held, so two buttons offering the same thing is not ambiguous, and a button offering
+     * on a hold what it already does on a tap is merely redundant rather than broken.
+     */
+    private void showSecondaryChooser(@BareToolbarSlot int slot) {
+        @ActionId int[] catalogue = BareToolbarDefaults.CATALOGUE;
+        CharSequence[] labels = new CharSequence[catalogue.length + 1];
+        int[] values = new int[catalogue.length + 1];
+        labels[0] = getString(R.string.bare_toolbar_action_none);
+        values[0] = BareToolbarDefaults.NO_ACTION;
+        for (int i = 0; i < catalogue.length; i++) {
+            labels[i + 1] = getString(BareToolbarActionUi.labelFor(catalogue[i]));
+            values[i + 1] = catalogue[i];
+        }
+
+        int current = BareToolbarPrefs.getSecondaryAction(slot);
+        int checked = 0;
+        for (int i = 0; i < values.length; i++) {
+            if (values[i] == current) checked = i;
+        }
+
+        new AlertDialog.Builder(getContext(), R.style.ThemeOverlay_BrowserUI_AlertDialog)
+                .setTitle(R.string.bare_toolbar_settings_choose_action)
+                .setSingleChoiceItems(
+                        labels,
+                        checked,
+                        (dialog, which) -> {
+                            BareToolbarPrefs.setSecondaryAction(slot, values[which]);
+                            dialog.dismiss();
+                        })
+                .setNegativeButton(R.string.cancel, null)
+                .show();
+    }

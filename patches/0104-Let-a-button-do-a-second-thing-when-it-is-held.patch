+        assertNotNull("nothing bound to the hold", longPress);
+        longPress.onResult(new View(mActivity));
+    }
+
+    // Preferences.
+
+    @Test
+    public void testNothingStoredMeansHoldingDoesNothing() {
+        for (int slot = 0; slot < BareToolbarSlot.COUNT; slot++) {
+            assertEquals(

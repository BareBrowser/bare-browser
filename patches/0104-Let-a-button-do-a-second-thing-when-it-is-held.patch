         } else {
             ActionButtonBinder.bind(model, view, propertyKey);
+            // The generic binder decides what a long press does from the press callbacks alone,
+            // and settles on swallowing it when nothing has claimed one. The home button has
+            // claimed one: its menu is not a callback on the model but a delegate the generic
+            // binder cannot see, so it has to be put back whenever that decision is made again.
+            //
+            // This is what makes the menu a property of the home button rather than of the order
+            // its properties happened to arrive in, and it is why choosing no second action gives
+            // the menu straight back instead of leaving the button doing nothing until the bar is
+            // next rebuilt.
+            if (touchesLongPress(propertyKey) && ownsLongPress(model)) {
+                bindMenu(model, view);
+            }
         }
     }
 
+    /** Whether binding this property re-decides what a long press does. */
+    private static boolean touchesLongPress(PropertyKey propertyKey) {
+        return propertyKey == ActionProperties.ON_PRESS_CALLBACK
+                || propertyKey == ActionProperties.BUTTON_STATE
+                || propertyKey == ActionProperties.ON_LONG_PRESS_CALLBACK;
+    }
+
+    /**
+     * Whether the home button's own menu is what a long press should do.
+     *
+     * <p>It is, unless something has been put on the model to run instead. A second action chosen
+     * for this position is exactly that, and it wins for as long as it is set.
+     */
+    private static boolean ownsLongPress(PropertyModel model) {
+        if (!model.containsKey(HomeActionProperties.LONG_PRESS_MENU_DELEGATE)) return false;
+        if (model.get(HomeActionProperties.LONG_PRESS_MENU_DELEGATE) == null) return false;
+        return !model.containsKey(ActionProperties.ON_LONG_PRESS_CALLBACK)
+                || model.get(ActionProperties.ON_LONG_PRESS_CALLBACK) == null;
+    }
+
+    private static void bindMenu(PropertyModel model, View view) {
+        ListMenuButton listMenuButton = resolveListMenuButton(view);
+        listMenuButton.setDelegate(model.get(HomeActionProperties.LONG_PRESS_MENU_DELEGATE), false);
+        listMenuButton.setOnLongClickListener(
+                v -> {
+                    if (listMenuButton.getVisibility() != View.VISIBLE) {
+                        return false;
+                    }
+                    listMenuButton.showMenu();
+                    return true;
+                });
+    }
+
     private static ListMenuButton resolveListMenuButton(View view) {
         View targetView = ActionButtonBinder.resolveView(view);
         assert targetView instanceof ListMenuButton : "View must be a ListMenuButton";

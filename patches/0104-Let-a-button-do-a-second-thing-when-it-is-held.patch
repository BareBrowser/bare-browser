+        assertNull(home.get(ActionProperties.ON_LONG_PRESS_CALLBACK));
+        actions.destroy();
+    }
+
+    @Test
+    public void testTheButtonIsStillRegisteredOnceUnderItsTap() {
+        // A hold is not a second button. Nothing new is registered for it.
+        register(ActionId.HOME_BUTTON, true);
+        register(ActionId.SHARE, true);
+        BareToolbarPrefs.setSecondaryAction(BareToolbarSlot.HOME, ActionId.SHARE);
+        BareToolbarSecondaryActions actions = attach();

+                "the held action is not put on the bar as well",
+                BareToolbarLayout.isPlaced(ActionId.SHARE));
+        actions.destroy();
+    }
+
+    @Test
+    public void testDestroyTakesTheHoldsOff() {
+        PropertyModel home = register(ActionId.HOME_BUTTON, true);
+        register(ActionId.SHARE, true);
+        BareToolbarPrefs.setSecondaryAction(BareToolbarSlot.HOME, ActionId.SHARE);
+
+        BareToolbarSecondaryActions actions = attach();
+        actions.destroy();
+
+        assertNull(home.get(ActionProperties.ON_LONG_PRESS_CALLBACK));
+        actions.destroy();
+    }
+}

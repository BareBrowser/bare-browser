+    private void showPositionConfig(@BareToolbarSlot int slot) {
+        @ActionId int primary = BareToolbarLayout.actionForSlot(slot);
+        int secondary = BareToolbarPrefs.getSecondaryAction(slot);
+
+        CharSequence[] rows = {
+            roleSummary(R.string.bare_toolbar_tap, getString(BareToolbarActionUi.labelFor(primary))),

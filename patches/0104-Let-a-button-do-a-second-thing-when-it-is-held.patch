+/** Unit tests for what holding a bottom bar button does. */
+@RunWith(BaseRobolectricTestRunner.class)
+public class BareToolbarSecondaryActionsUnitTest {
+    @Rule
+    public ActivityScenarioRule<TestActivity> mActivityScenarioRule =
+            new ActivityScenarioRule<>(TestActivity.class);
+
+    private Activity mActivity;
+    private ActionRegistry mRegistry;
+    private int mInvokedCount;
+
+    @Before
+    public void setUp() {
+        mActivityScenarioRule.getScenario().onActivity(activity -> mActivity = activity);
+        mRegistry = new ActionRegistry();
+        mInvokedCount = 0;
+        clearPrefs();
+    }
+
+    @After
+    public void tearDown() {
+        clearPrefs();
+    }
+
+    private void clearPrefs() {
+        for (int slot = 0; slot < BareToolbarSlot.COUNT; slot++) {
+            ChromeSharedPreferences.getInstance()
+                    .removeKey(ChromePreferenceKeys.BOTTOM_BAR_SLOT_PRIMARY_ACTION.createKey(slot));
+            ChromeSharedPreferences.getInstance()
+                    .removeKey(
+                            ChromePreferenceKeys.BOTTOM_BAR_SLOT_SECONDARY_ACTION.createKey(slot));
+        }
+        BareToolbarLayout.invalidate();
+    }
+
+    /** Registers an action whose press records that it ran. */
+    private PropertyModel register(@ActionId int actionId, boolean pressable) {

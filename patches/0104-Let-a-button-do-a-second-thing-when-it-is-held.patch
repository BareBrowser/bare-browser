+    /**
+     * Whether the home button gets its own long press back when nothing else wants it.
+     *
+     * <p>The three listeners that can end up on this button answer a long press differently, which
+     * is what lets the test tell them apart: the home button's own menu declines when the button
+     * is not visible, while both the generic swallow and a configured second action consume it. So
+     * the button is hidden and asked, and the answer says which one is in charge.
+     */
+    @Test
+    public void testHomeGetsItsOwnLongPressBackWhenNothingElseClaimsIt() {
+        View view = inflate(R.layout.bottom_bar_list_menu_template);
+        view.setVisibility(View.GONE);
+        // A parent, because a long press the listener declines falls through to the context menu,
+        // which asks the parent for one.
+        new android.widget.FrameLayout(mActivity).addView(view);
+
+        PropertyModel model = new PropertyModel.Builder(HomeActionProperties.ALL_KEYS).build();
+        model.set(HomeActionProperties.LONG_PRESS_MENU_DELEGATE, mock(ListMenuDelegate.class));
+        PropertyModelChangeProcessor.create(model, view, HomeActionButtonBinder::bind);
+
+        assertFalse(
+                "with nothing configured the home button's own menu should own the hold",
+                view.performLongClick());
+
+        int[] ran = new int[1];
+        model.set(ActionProperties.ON_PRESS_CALLBACK, (Callback<View>) v -> {});
+        assertFalse(
+                "binding the tap must not quietly take the hold away from home",
+                view.performLongClick());
+
+        model.set(ActionProperties.ON_LONG_PRESS_CALLBACK, (Callback<View>) v -> ran[0]++);
+        assertTrue("a configured second action should take the hold", view.performLongClick());
+        assertEquals(1, ran[0]);
+
+        model.set(ActionProperties.ON_LONG_PRESS_CALLBACK, null);
+        assertFalse(
+                "removing it should give the menu back, not leave the button swallowing",
+                view.performLongClick());
+        assertEquals("and the removed action should not run again", 1, ran[0]);
+    }
+
+    @Test
+    public void testAnOrdinaryActionStillSwallowsAHoldItHasNoUseFor() {
+        // The safeguard that stops a held button firing its tap late when the finger lifts.
+        View view = inflate(R.layout.bottom_bar_generic_template);
+        view.setVisibility(View.GONE);
+
+        PropertyModel model = new PropertyModel.Builder(ActionProperties.BASE_KEYS).build();
+        PropertyModelChangeProcessor.create(model, view, ActionButtonBinder::bind);
+        model.set(ActionProperties.ON_PRESS_CALLBACK, (Callback<View>) v -> {});
+
+        assertTrue("an ordinary action should swallow the hold", view.performLongClick());
+    }

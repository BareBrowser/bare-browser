+import org.chromium.build.annotations.Nullable;
+import org.chromium.chrome.browser.ui.actions.ActionId;
+import org.chromium.chrome.browser.ui.actions.ActionProperties;
+import org.chromium.chrome.browser.ui.actions.ActionRegistry;
+import org.chromium.ui.modelutil.PropertyModel;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * Gives a button a second thing to do when it is held.
+ *
+ * <p>The button is still one button. It is registered once, under the action it performs when
+ * tapped, and that does not change; what changes is that the model it already publishes is given
+ * something to run on a long press. Nothing about the bar's idea of which action lives where is
+ * involved, which is why two buttons may offer the same thing on a hold, and why a button may
+ * offer on a hold what it already does on a tap.
+ *
+ * <p>The action to run is looked up when the finger lifts, not when the preference was written. A
+ * button that offers Translate on a hold has to mean the Translate that applies to the page in
+ * front of the user, and on a page where Translate cannot run there is nothing to do rather than
+ * something stale to do.
+ */
+@NullMarked
+public class BareToolbarSecondaryActions implements Destroyable {
+
+    /** Told when a hold actually ran something, so the bar can stop reading the same touch. */
+    public interface Listener {
+        void onSecondaryActionInvoked();
+    }
+
+    /** One observed primary model, remembered so its callback can be taken back off. */
+    private static class Watched {
+        final NullableObservableSupplier<PropertyModel> mSupplier;
+        @Nullable Callback<@Nullable PropertyModel> mObserver;
+        @Nullable PropertyModel mModel;
+
+        Watched(NullableObservableSupplier<PropertyModel> supplier) {
+            mSupplier = supplier;
+        }
+    }
+
+    private final ActionRegistry mRegistry;
+    private final Listener mListener;
+    private final List<Watched> mWatched = new ArrayList<>();
+    private boolean mDestroyed;
+
+    public BareToolbarSecondaryActions(ActionRegistry registry, Listener listener) {
+        mRegistry = registry;
+        mListener = listener;
+        attach();
+    }
+
+    /**
+     * Reads the preferences again and rebinds.
+     *
+     * <p>The two halves are separate because the bar is rebuilt in between when the arrangement
+     * has changed: the callbacks have to come off before the rebuild, so that a button that is
+     * going back to doing nothing on a hold gets its own behaviour back from the rebuild rather
+     * than keeping ours.
+     */
+    public void refresh() {
+        if (mDestroyed) return;
+        clear();
+        apply();
+    }
+
+    /** Takes off every callback this put on. */
+    public void clear() {
+        if (mDestroyed) return;
+        detach();
+    }
+
+    /** Puts a callback on every position that has been given a hold. */
+    public void apply() {
+        if (mDestroyed) return;
+        attach();
+    }
+
+    /**
+     * Watches the model of whatever each configurable position taps, so a hold can be added to it.
+     *
+     * <p>Watched rather than read once: the models arrive as the browser starts, and the ones
+     * behind Share, Translate and Bookmark arrive later still, after the toolbar has been built.
+     */
+    private void attach() {
+        for (int slot = 0; slot < BareToolbarSlot.COUNT; slot++) {
+            if (!BareToolbarDefaults.isConfigurable(slot)) continue;
+            int secondary = BareToolbarPrefs.getSecondaryAction(slot);
+            if (secondary == BareToolbarDefaults.NO_ACTION) continue;
+
+            @ActionId int primary = BareToolbarLayout.actionForSlot(slot);
+            NullableObservableSupplier<PropertyModel> supplier = mRegistry.get(primary);
+            Watched entry = new Watched(supplier);
+            entry.mObserver = model -> watchedModel(entry, model, secondary);
+            mWatched.add(entry);
+            supplier.addSyncObserverAndCallIfNonNull(entry.mObserver);
+        }
+    }
+
+    private void watchedModel(Watched entry, @Nullable PropertyModel model, int secondary) {
+        entry.mModel = model;
+        if (model == null) return;
+        model.set(
+                ActionProperties.ON_LONG_PRESS_CALLBACK,
+                (Callback<View>) view -> invoke(secondary, view));
+    }
+
+    /**
+     * Takes back only what was put on.
+     *
+     * <p>A position left alone is never written to, because some buttons already do something when
+     * held — the home button offers its homepage menu — and clearing a callback nobody set would
+     * be taking that away.
+     */
+    private void detach() {
+        for (Watched entry : mWatched) {
+            if (entry.mObserver != null) entry.mSupplier.removeObserver(entry.mObserver);
+            if (entry.mModel != null) {
+                entry.mModel.set(ActionProperties.ON_LONG_PRESS_CALLBACK, null);
+            }
+        }
+        mWatched.clear();
+    }
+
+    /**
+     * Runs whatever the chosen action does right now.
+     *
+     * <p>Through the action's own registered model, so holding Bookmark bookmarks the page the
+     * same way pressing a Bookmark button would, down to the same listener. An action with nothing
+     * to press is an action that does not apply here: on a new tab page there is nothing to
+     * translate, and the hold does nothing rather than something invented.
+     */
+    private void invoke(int actionId, View view) {
+        @Nullable PropertyModel model = mRegistry.get(actionId).get();
+        if (model == null) return;
+        @Nullable Callback<View> press = model.get(ActionProperties.ON_PRESS_CALLBACK);
+        if (press == null) return;
+        mListener.onSecondaryActionInvoked();
+        press.onResult(view);
+    }
+
+    @Override
+    public void destroy() {
+        if (mDestroyed) return;
+        mDestroyed = true;
+        detach();
+    }
+}

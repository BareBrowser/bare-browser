diff --git a/chrome/browser/extensions/bare_filter_subscriber.cc b/chrome/browser/extensions/bare_filter_subscriber.cc
index 00bd0105200..6d800bee8a6 100644
--- a/chrome/browser/extensions/bare_filter_subscriber.cc
+++ b/chrome/browser/extensions/bare_filter_subscriber.cc
@@ -26,37 +26,62 @@ namespace {
 
 constexpr char kUBlockOriginId[] = "fkgkibajhfbepljeaefdnfnegdcjomkh";
 
-// Where uBlock Origin fetches BareFilter from.
+// The list uBlock Origin subscribes to. It refreshes it on its own schedule;
+// the file asks for about once a day.
 constexpr char kBareFilterUrl[] = "https://raw.githubusercontent.com/BareBrowser/bare-browser/main/filters/BareFilter.txt";
 
 // The on and off switch shown on the extensions page. On unless turned off.
 constexpr char kEnabledPref[] = "Chrome.Bare.BareFilterEnabled";
 
-// Runs inside the background page of uBlock Origin once its filters are ready,
-// and does what the import box of its lists page does: it adds or removes the
-// list through uBlock's own functions, then has it rebuild its lists. Its
-// saved copy of the available lists is only dropped by that rebuild, so a list
-// written into its storage from outside is never seen.
+// Runs inside the background page of uBlock Origin once its filters are ready.
+// It subscribes uBlock Origin to the list or drops the list and its copy, as
+// the switch says, and takes out the block of rules that 2.0.2 kept in My
+// filters, leaving the rest of My filters as it is. It also keeps the popup in
+// its one-column layout.
 constexpr char kScript[] = R"(
 (function() {
   var url = '%URL%';
   var want = %WANT%;
+  var begin = '! BareFilter begin';
+  var end = '! BareFilter end';
   var tries = 0;
   var timer = setInterval(function() {
     var ub = window['µBlock'];
     if (++tries > 120) { clearInterval(timer); return; }
     if (!ub || !ub.readyToFilter) { return; }
     clearInterval(timer);
-    var imported = ub.userSettings.importedLists.indexOf(url) !== -1;
-    var selected = ub.selectedFilterLists.indexOf(url) !== -1;
-    var known = !!ub.availableFilterLists[url];
-    if (want) {
-      if (!imported || !selected) { ub.applyFilterListSelection({ toImport: url }); }
-      if (!imported || !selected || !known) { ub.loadFilterLists(); }
-    } else if (imported || selected || known) {
-      ub.applyFilterListSelection({ toRemove: [url] });
-      ub.loadFilterLists();
+    // Bare reports a desktop browser, so uBlock Origin lays its popup out in
+    // two columns when the screen is wide enough, which leaves an empty column
+    // in the full-screen view. One column always fits. A layout the user chose
+    // in uBlock Origin's advanced settings is kept.
+    var hs = ub.hiddenSettings;
+    if (hs && hs.popupPanelOrientation === 'unset') {
+      hs.popupPanelOrientation = 'portrait';
+      ub.saveHiddenSettings();
     }
+    ub.loadUserFilters().then(function(saved) {
+      var text = (saved && saved.content) || '';
+      var a = text.indexOf(begin);
+      var b = a === -1 ? -1 : text.indexOf(end, a);
+      var done = Promise.resolve();
+      var changed = false;
+      if (a !== -1 && b > a) {
+        done = ub.saveUserFilters(
+            (text.slice(0, a) + text.slice(b + end.length)).trim());
+        changed = true;
+      }
+      var imported = ub.userSettings.importedLists.indexOf(url) !== -1;
+      var selected = ub.selectedFilterLists.indexOf(url) !== -1;
+      if (want && !(imported && selected)) {
+        ub.applyFilterListSelection({ toImport: url });
+        changed = true;
+      } else if (!want && (imported || selected || !!ub.availableFilterLists[url])) {
+        ub.applyFilterListSelection({ toRemove: [url] });
+        changed = true;
+      }
+      if (!changed) { return; }
+      done.then(function() { ub.loadFilterLists(); });
+    });
   }, 500);
 })();
 )";
diff --git a/chrome/browser/extensions/bare_filter_subscriber.h b/chrome/browser/extensions/bare_filter_subscriber.h
index 68d0c941c29..1f98841ee81 100644
--- a/chrome/browser/extensions/bare_filter_subscriber.h
+++ b/chrome/browser/extensions/bare_filter_subscriber.h
@@ -9,10 +9,11 @@ class Profile;
 
 namespace extensions {
 
-// Keeps uBlock Origin subscribed to BareFilter, the small list Bare hosts for
-// pages that get in the way. Once uBlock Origin has started, the list is
-// imported through its own functions, or removed again when the user has turned
-// BareFilter off. Safe to call once per profile at startup.
+// Subscribes uBlock Origin to BareFilter, the small list of rules for pages
+// that push you to an app, kept in Bare's repository on GitHub, or drops it and
+// its copy when the user has turned BareFilter off. uBlock Origin downloads and
+// refreshes the list itself; nothing is built in. Runs once uBlock Origin has
+// started. Safe to call once per profile at startup.
 void StartBareFilterSubscriber(Profile* profile);
 
 }  // namespace extensions

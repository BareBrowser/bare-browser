+// Runs inside the background page of uBlock Origin once its filters are ready.
+// It rewrites the block between the markers in My filters, adds or removes
+// that block as the switch says, and has uBlock Origin rebuild its lists.
 constexpr char kScript[] = R"(
 (function() {
-  var url = '%URL%';
+  var rules = '%RULES%';
   var want = %WANT%;
+  var begin = '! BareFilter begin';
+  var end = '! BareFilter end';
   var tries = 0;
   var timer = setInterval(function() {
     var ub = window['µBlock'];
     if (++tries > 120) { clearInterval(timer); return; }
     if (!ub || !ub.readyToFilter) { return; }
     clearInterval(timer);
-    var imported = ub.userSettings.importedLists.indexOf(url) !== -1;
-    var selected = ub.selectedFilterLists.indexOf(url) !== -1;
-    var known = !!ub.availableFilterLists[url];
-    if (want) {
-      if (!imported || !selected) { ub.applyFilterListSelection({ toImport: url }); }
-      if (!imported || !selected || !known) { ub.loadFilterLists(); }
-    } else if (imported || selected || known) {
-      ub.applyFilterListSelection({ toRemove: [url] });
-      ub.loadFilterLists();
-    }
+    ub.loadUserFilters().then(function(saved) {
+      var text = (saved && saved.content) || '';
+      var a = text.indexOf(begin);
+      var b = text.indexOf(end);
+      var rest = text;
+      if (a !== -1 && b > a) {
+        rest = text.slice(0, a) + text.slice(b + end.length);
+      }
+      rest = rest.trim();
+      var next = want ? (rest ? rest + '\n\n' : '') + begin + '\n' + rules + '\n' + end : rest;
+      var old = '%OLDURL%';
+      var oldImported = ub.userSettings.importedLists.indexOf(old) !== -1 ||

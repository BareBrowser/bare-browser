+      if (next === text.trim() && !oldImported) { return; }
+      if (oldImported) { ub.applyFilterListSelection({ toRemove: [old] }); }
+      if (want) {
+        ub.applyFilterListSelection({ toSelect: [ub.userFiltersPath], merge: true });
+      }
+      ub.saveUserFilters(next).then(function() { ub.loadFilterLists(); });
+    });
   }, 500);
 })();
 )";
 
+std::string Escaped(const std::string& text) {
+  std::string out;
+  for (char c : text) {
+    if (c == '\\') out += "\\\\";
+    else if (c == '\'') out += "\\'";
+    else if (c == '\n') out += "\\n";
+    else out += c;
+  }
+  return out;
+}
+
 std::string BuildScript(bool want) {
   std::string script = kScript;
-  size_t at = script.find("%URL%");
-  script.replace(at, 5, kBareFilterUrl);

+/**
+ * Bare: the "ask where to save" card. It rises from behind the address bar and shows the file,
+ * where it will be saved and Cancel / Start. When an external download manager could take the
+ * file instead, a switch at the top picks between saving in Bare and sending it to that app.
+ * Tapping "Save to" swaps in a short list of folders; the last folder chosen is remembered.
+ */
+@NullMarked
+public final class BareDownloadCard {
+    /** What the user decided. */
+    public interface Listener {
+        /**
+         * Start was tapped.
+         *
+         * @param location The folder to save in, for a save in Bare.
+         * @param sendToApp True when the file should go to the external download manager.
+         */
+        void onStart(String location, boolean sendToApp);
+
+        /** The card went away without Start. */
+        void onCancel();
+
+        /** An app in the list was tapped: the file goes to that app and nowhere else. */
+        default void onSendTo(ComponentName app) {}
+    }
+
+    /** An installed app that can take the download, as the card lists it. */
+    public static final class App {
+        public final ComponentName component;
+        public final CharSequence label;
+        public final @Nullable Drawable icon;
+
+        public App(ComponentName component, CharSequence label, @Nullable Drawable icon) {
+            this.component = component;
+            this.label = label;
+            this.icon = icon;
+        }
+    }
+
+    private static final String PREF_LAST = "bare_download_card_last";
+    private static final String LAST_TREE = "tree";
+
+    private static final class Row {
+        final String label;
+        final @Nullable String location;
+        final boolean tree;
+
+        Row(String label, @Nullable String location, boolean tree) {
+            this.label = label;
+            this.location = location;
+            this.tree = tree;
+        }
+
+        String key() {
+            return tree ? LAST_TREE : String.valueOf(location);
+        }
+    }
+
+    private static long sSkipUntil;
+
+    /**
+     * The next save prompt, if it comes within a few seconds, is skipped: the user has just
+     * answered it on this card.
+     */
+    public static void skipNextPrompt() {
+        sSkipUntil = android.os.SystemClock.uptimeMillis() + 8000;
+    }
+
+    /** Whether the prompt that is about to show was already answered. Counts once. */
+    static boolean consumeSkip() {
+        boolean skip = android.os.SystemClock.uptimeMillis() < sSkipUntil;
+        sSkipUntil = 0;
+        return skip;
+    }
+
+    private static boolean sOpen;
+
+    /** Whether a card is up and waiting for an answer. */
+    public static boolean isOpen() {
+        return sOpen;
+    }
+
+    private final Activity mActivity;
+    private final String mFileName;
+    private final long mTotalBytes;
+    private final @Nullable String mSite;
+    private final boolean mOfferApp;
+    private final List<App> mApps;
+    private final Listener mListener;
+    private final String mDefaultLocation;
+    private final List<Row> mRows = new ArrayList<>();
+    private int mSelected;
+    private boolean mSendToApp;
+    private boolean mAnswered;
+    private @Nullable RiseSheet mSheet;
+    private @Nullable View mMainPage;
+    private @Nullable View mListPage;
+    private @Nullable TextView mFolderLabel;
+    private @Nullable ActivityResultLauncher<Intent> mPicker;
+    private final @ColorInt int mInk;
+    private final @ColorInt int mSoft;
+    private final @ColorInt int mAccent;
+    private final @ColorInt int mOnAccent;
+    private final float mDensity;
+
+    /**
+     * Shows the card.
+     *
+     * @return false when it could not be shown, so the caller falls back to its own dialog.
+     */
+    public static boolean show(
+            Activity activity,
+            String fileName,
+            long totalBytes,
+            @Nullable String site,
+            List<DirectoryOption> dirs,
+            boolean offerApp,
+            Listener listener) {
+        return show(
+                activity,
+                fileName,
+                totalBytes,
+                site,
+                dirs,
+                offerApp,
+                Collections.<App>emptyList(),
+                listener);
+    }
+
+    /**
+     * Shows the card with the apps that can take the download listed on it, each one a tap away.
+     * With no apps the card has its Save in Bare / Send to app switch instead.
+     */
+    public static boolean show(
+            Activity activity,
+            String fileName,
+            long totalBytes,
+            @Nullable String site,
+            List<DirectoryOption> dirs,
+            boolean offerApp,
+            List<App> apps,
+            Listener listener) {
+        View root = activity.findViewById(android.R.id.content);
+        if (root == null || RiseSheet.isOpen()) return false;
+        String defaultLocation = null;
+        for (DirectoryOption dir : dirs) {
+            if (dir.type == DirectoryOption.DownloadLocationDirectoryType.DEFAULT
+                    && !TextUtils.isEmpty(dir.location)) {
+                defaultLocation = dir.location;
+                break;
+            }
+        }
+        if (defaultLocation == null) return false;
+        BareDownloadCard card =
+                new BareDownloadCard(
+                        activity,
+                        root,
+                        fileName,
+                        totalBytes,
+                        site,
+                        dirs,
+                        defaultLocation,
+                        offerApp,
+                        apps,
+                        listener);
+        return card.open(root);
+    }
+
+    private BareDownloadCard(
+            Activity activity,
+            View root,
+            String fileName,
+            long totalBytes,
+            @Nullable String site,
+            List<DirectoryOption> dirs,
+            String defaultLocation,
+            boolean offerApp,
+            List<App> apps,
+            Listener listener) {
+        mActivity = activity;
+        mFileName = fileName;
+        mTotalBytes = totalBytes;
+        mSite = site;
+        mOfferApp = offerApp;
+        mApps = apps;
+        mListener = listener;
+        mDefaultLocation = defaultLocation;
+        mDensity = activity.getResources().getDisplayMetrics().density;
+        int bar = RiseSheet.barColor(root);
+        boolean light = luminance(bar) > 150;
+        mInk = light ? 0xFF1B1B1F : 0xFFE6E6EA;
+        mSoft = (mInk & 0x00FFFFFF) | 0x14000000;
+        mAccent = SemanticColorUtils.getDefaultControlColorActive(activity);
+        mOnAccent = luminance(mAccent) > 150 ? 0xFF0B1B33 : Color.WHITE;
+        buildRows(dirs);
+    }
+
+    private void buildRows(List<DirectoryOption> dirs) {
+        Context context = mActivity;
+        mRows.add(
+                new Row(
+                        context.getString(R.string.bare_download_card_folder_downloads),
+                        mDefaultLocation,
+                        false));
+        for (DirectoryOption dir : dirs) {
+            if (dir.type == DirectoryOption.DownloadLocationDirectoryType.DEFAULT
+                    || TextUtils.isEmpty(dir.location)
+                    || dir.name == null) {
+                continue;
+            }
+            mRows.add(new Row(dir.name, dir.location, false));
+        }
+        addTreeRow();
+        selectRemembered();
+    }
+
+    private void addTreeRow() {
+        Uri tree = BareDownloadLocation.get();
+        if (tree == null) return;
+        mRows.add(new Row(folderName(tree), null, true));
+    }
+
+    private void selectRemembered() {
+        String last = prefs().getString(PREF_LAST, "");
+        mSelected = 0;
+        for (int i = 0; i < mRows.size(); i++) {
+            if (mRows.get(i).key().equals(last)) {
+                mSelected = i;
+                return;
+            }
+        }
+        if (BareDownloadLocation.get() != null) mSelected = mRows.size() - 1;
+    }
+
+    private static SharedPreferences prefs() {
+        return ContextUtils.getAppSharedPreferences();
+    }
+
+    private boolean open(View root) {
+        FrameLayout content = new FrameLayout(mActivity);
+        int side = dp(20);
+        content.setPadding(side, 0, side, dp(14));
+        mMainPage = buildMainPage();
+        mListPage = buildListPage();
+        content.addView(mMainPage);
+        content.addView(mListPage);
+        // The card is as tall as the taller of its two pages, so swapping them does not resize it.
+        int width = RiseSheet.cardWidth(root) - 2 * side;
+        int tallest = 0;
+        for (View page : new View[] {mMainPage, mListPage}) {
+            page.measure(
+                    View.MeasureSpec.makeMeasureSpec(width, View.MeasureSpec.EXACTLY),
+                    View.MeasureSpec.makeMeasureSpec(0, View.MeasureSpec.UNSPECIFIED));
+            tallest = Math.max(tallest, page.getMeasuredHeight());
+        }
+        content.setMinimumHeight(tallest + dp(14));
+        mListPage.setVisibility(View.GONE);
+        mSheet = RiseSheet.showCard(root, content, /* modal= */ true, 0, this::onDismissed);
+        sOpen = mSheet != null;
+        return sOpen;
+    }
+
+    private View buildMainPage() {
+        LinearLayout page = new LinearLayout(mActivity);
+        page.setOrientation(LinearLayout.VERTICAL);
+
+        LinearLayout head = new LinearLayout(mActivity);
+        head.setOrientation(LinearLayout.HORIZONTAL);
+        head.setGravity(Gravity.CENTER_VERTICAL);
+        TextView badge = label(extension(mFileName), 12, true);
+        badge.setGravity(Gravity.CENTER);
+        badge.setBackground(round(mSoft, 12));
+        head.addView(badge, new LinearLayout.LayoutParams(dp(44), dp(44)));
+        LinearLayout names = new LinearLayout(mActivity);
+        names.setOrientation(LinearLayout.VERTICAL);
+        TextView name = label(mFileName, 16, true);
+        name.setSingleLine();
+        name.setEllipsize(TextUtils.TruncateAt.MIDDLE);
+        names.addView(name);
+        String detail = detailLine();
+        if (!detail.isEmpty()) names.addView(label(detail, 13, false));
+        LinearLayout.LayoutParams namesParams =
+                new LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1f);
+        namesParams.leftMargin = dp(12);
+        head.addView(names, namesParams);
+        page.addView(head);
+
+        if (mOfferApp && !mApps.isEmpty()) {
+            page.addView(buildApps(), topMargin(10));
+        } else if (mOfferApp) {
+            page.addView(buildSwitch(), topMargin(10));
+        }
+
+        LinearLayout where = new LinearLayout(mActivity);
+        where.setOrientation(LinearLayout.HORIZONTAL);
+        where.setGravity(Gravity.CENTER_VERTICAL);
+        where.setBackground(round(mSoft, 12));
+        where.setPadding(dp(12), dp(10), dp(12), dp(10));
+        LinearLayout texts = new LinearLayout(mActivity);
+        texts.setOrientation(LinearLayout.VERTICAL);
+        texts.addView(label(mActivity.getString(R.string.bare_download_card_save_to), 14, true));
+        mFolderLabel = label(mRows.get(mSelected).label, 13, false);
+        texts.addView(mFolderLabel);
+        where.addView(texts, new LinearLayout.LayoutParams(0, -2, 1f));
+        where.addView(label("›", 22, false));
+        where.setOnClickListener(v -> showList());
+        where.setTag("where");
+        page.addView(where, topMargin(10));
+
+        LinearLayout buttons = new LinearLayout(mActivity);
+        buttons.setOrientation(LinearLayout.HORIZONTAL);
+        TextView cancel = button(mActivity.getString(R.string.cancel), false);
+        cancel.setOnClickListener(v -> cancel());
+        TextView start = button(mActivity.getString(R.string.bare_download_card_start), true);
+        start.setOnClickListener(v -> start());
+        LinearLayout.LayoutParams left = new LinearLayout.LayoutParams(0, dp(46), 1f);
+        left.rightMargin = dp(4);
+        LinearLayout.LayoutParams right = new LinearLayout.LayoutParams(0, dp(46), 1f);
+        right.leftMargin = dp(4);
+        buttons.addView(cancel, left);
+        buttons.addView(start, right);
+        page.addView(buttons, topMargin(12));
+        mWhere = where;
+        return page;
+    }
+
+    private @Nullable View mWhere;
+
+    /**
+     * The apps that can take this download, one row each, then the words that start the card's own
+     * save. A tap on an app sends the file there at once.
+     */
+    private View buildApps() {
+        LinearLayout block = new LinearLayout(mActivity);
+        block.setOrientation(LinearLayout.VERTICAL);
+        block.addView(
+                label(mActivity.getString(R.string.bare_download_card_send_to_app), 13, false));
+        int shown = Math.min(4, mApps.size());
+        for (int i = 0; i < shown; i++) {
+            App app = mApps.get(i);
+            LinearLayout row = new LinearLayout(mActivity);
+            row.setOrientation(LinearLayout.HORIZONTAL);
+            row.setGravity(Gravity.CENTER_VERTICAL);
+            row.setBackground(round(mSoft, 12));
+            row.setPadding(dp(12), dp(8), dp(12), dp(8));
+            ImageView icon = new ImageView(mActivity);
+            if (app.icon != null) icon.setImageDrawable(app.icon);
+            row.addView(icon, new LinearLayout.LayoutParams(dp(28), dp(28)));
+            TextView name = label(app.label.toString(), 15, true);
+            name.setSingleLine();
+            name.setEllipsize(TextUtils.TruncateAt.END);
+            LinearLayout.LayoutParams nameParams = new LinearLayout.LayoutParams(0, -2, 1f);
+            nameParams.leftMargin = dp(12);
+            row.addView(name, nameParams);
+            row.addView(label("›", 22, false));
+            row.setOnClickListener(v -> sendTo(app));
+            block.addView(row, topMargin(6));
+        }
+        block.addView(
+                label(mActivity.getString(R.string.bare_download_card_save_in_bare), 13, false),
+                topMargin(12));
+        return block;
+    }
+
+    private void sendTo(App app) {
+        if (mAnswered) return;
+        mAnswered = true;
+        mListener.onSendTo(app.component);
+        if (mSheet != null) mSheet.fold();
+    }
+
+    private View buildSwitch() {
+        LinearLayout seg = new LinearLayout(mActivity);
+        seg.setOrientation(LinearLayout.HORIZONTAL);
+        seg.setBackground(round(mSoft, 12));
+        seg.setPadding(dp(3), dp(3), dp(3), dp(3));
+        TextView save = label(mActivity.getString(R.string.bare_download_card_save_in_bare), 14, false);
+        TextView send = label(mActivity.getString(R.string.bare_download_card_send_to_app), 14, false);
+        for (TextView t : new TextView[] {save, send}) {
+            t.setGravity(Gravity.CENTER);
+            t.setPadding(0, dp(8), 0, dp(8));
+        }
+        Runnable paint =
+                () -> {
+                    save.setBackground(mSendToApp ? null : round(mSoft | 0x26000000, 9));
+                    send.setBackground(mSendToApp ? round(mSoft | 0x26000000, 9) : null);
+                    if (mWhere != null) mWhere.setVisibility(mSendToApp ? View.GONE : View.VISIBLE);
+                };
+        save.setOnClickListener(
+                v -> {
+                    mSendToApp = false;
+                    paint.run();
+                });
+        send.setOnClickListener(
+                v -> {
+                    mSendToApp = true;
+                    paint.run();
+                });
+        seg.addView(save, new LinearLayout.LayoutParams(0, -2, 1f));
+        seg.addView(send, new LinearLayout.LayoutParams(0, -2, 1f));
+        seg.post(paint);
+        return seg;
+    }
+
+    private View buildListPage() {
+        LinearLayout page = new LinearLayout(mActivity);
+        page.setOrientation(LinearLayout.VERTICAL);
+        TextView title = label("‹  " + mActivity.getString(R.string.bare_download_card_save_to), 16, true);
+        title.setPadding(0, dp(2), 0, dp(10));
+        title.setOnClickListener(v -> showMain());
+        page.addView(title);
+        for (int i = 0; i < mRows.size(); i++) {
+            int index = i;
+            page.addView(listRow(mRows.get(i).label, i == mSelected, v -> choose(index)), topMargin(6));
+        }
+        page.addView(
+                listRow(
+                        mActivity.getString(R.string.bare_download_location_choose_other),
+                        false,
+                        v -> pickFolder()),
+                topMargin(6));
+        return page;
+    }
+
+    private View listRow(String text, boolean checked, View.OnClickListener onClick) {
+        LinearLayout row = new LinearLayout(mActivity);
+        row.setOrientation(LinearLayout.HORIZONTAL);
+        row.setGravity(Gravity.CENTER_VERTICAL);
+        row.setBackground(round(checked ? (mSoft | 0x26000000) : mSoft, 12));
+        row.setPadding(dp(12), dp(11), dp(12), dp(11));
+        row.addView(label(text, 15, false), new LinearLayout.LayoutParams(0, -2, 1f));
+        if (checked) row.addView(label("✓", 16, true));
+        row.setOnClickListener(onClick);
+        return row;
+    }
+
+    private void rebuildList() {
+        if (mListPage == null || !(mListPage.getParent() instanceof FrameLayout parent)) return;
+        boolean visible = mListPage.getVisibility() == View.VISIBLE;
+        parent.removeView(mListPage);
+        mListPage = buildListPage();
+        mListPage.setVisibility(visible ? View.VISIBLE : View.GONE);
+        parent.addView(mListPage);
+    }
+
+    private void showList() {
+        if (mMainPage == null || mListPage == null) return;
+        mMainPage.setVisibility(View.GONE);
+        mListPage.setVisibility(View.VISIBLE);
+    }
+
+    private void showMain() {
+        if (mMainPage == null || mListPage == null) return;
+        mListPage.setVisibility(View.GONE);
+        mMainPage.setVisibility(View.VISIBLE);
+        if (mFolderLabel != null) mFolderLabel.setText(mRows.get(mSelected).label);
+    }
+
+    private void choose(int index) {
+        mSelected = index;
+        rebuildList();
+        showMain();
+    }
+
+    private void pickFolder() {
+        if (!(mActivity instanceof ComponentActivity componentActivity)) return;
+        Intent intent = new Intent(Intent.ACTION_OPEN_DOCUMENT_TREE);
+        intent.addFlags(
+                Intent.FLAG_GRANT_READ_URI_PERMISSION
+                        | Intent.FLAG_GRANT_WRITE_URI_PERMISSION
+                        | Intent.FLAG_GRANT_PERSISTABLE_URI_PERMISSION
+                        | Intent.FLAG_GRANT_PREFIX_URI_PERMISSION);
+        Uri current = BareDownloadLocation.get();
+        if (current != null) intent.putExtra(DocumentsContract.EXTRA_INITIAL_URI, current);
+        mPicker =
+                componentActivity
+                        .getActivityResultRegistry()
+                        .register(
+                                "bare_download_card_picker_" + System.nanoTime(),
+                                new ActivityResultContracts.StartActivityForResult(),
+                                this::onFolderPicked);
+        try {
+            mPicker.launch(intent);
+        } catch (RuntimeException e) {
+            Toast.makeText(mActivity, R.string.bare_download_location_no_picker, Toast.LENGTH_SHORT)
+                    .show();
+        }
+    }
+
+    private void onFolderPicked(ActivityResult result) {
+        if (mPicker != null) mPicker.unregister();
+        mPicker = null;
+        Intent data = result.getData();
+        if (result.getResultCode() != Activity.RESULT_OK || data == null) return;
+        Uri tree = data.getData();
+        if (tree == null) return;
+        try {
+            mActivity
+                    .getContentResolver()
+                    .takePersistableUriPermission(
+                            tree,
+                            Intent.FLAG_GRANT_READ_URI_PERMISSION
+                                    | Intent.FLAG_GRANT_WRITE_URI_PERMISSION);
+        } catch (SecurityException e) {
+            Toast.makeText(mActivity, R.string.bare_download_location_no_picker, Toast.LENGTH_SHORT)
+                    .show();
+            return;
+        }
+        Uri previous = BareDownloadLocation.get();
+        if (previous != null && !previous.equals(tree)) release(previous);
+        BareDownloadLocation.set(tree);
+        for (int i = mRows.size() - 1; i >= 0; i--) {
+            if (mRows.get(i).tree) mRows.remove(i);
+        }
+        addTreeRow();
+        mSelected = mRows.size() - 1;
+        rebuildList();
+        showMain();
+    }
+
+    private void release(Uri tree) {
+        try {
+            mActivity
+                    .getContentResolver()
+                    .releasePersistableUriPermission(
+                            tree,
+                            Intent.FLAG_GRANT_READ_URI_PERMISSION
+                                    | Intent.FLAG_GRANT_WRITE_URI_PERMISSION);
+        } catch (SecurityException e) {
+            // Already gone.
+        }
+    }
+
+    private void start() {
+        if (mAnswered) return;
+        mAnswered = true;
+        Row row = mRows.get(mSelected);
+        if (!mSendToApp) {
+            prefs().edit().putString(PREF_LAST, row.key()).apply();
+            if (!row.tree) {
+                Uri tree = BareDownloadLocation.get();
+                if (tree != null) {
+                    release(tree);
+                    BareDownloadLocation.clear();
+                }
+            }
+        }
+        String location = row.tree || row.location == null ? mDefaultLocation : row.location;
+        mListener.onStart(location, mSendToApp);
+        if (mSheet != null) mSheet.fold();
+    }
+
+    private void cancel() {
+        if (mSheet != null) mSheet.fold();
+    }
+
+    private void onDismissed() {
+        sOpen = false;
+        if (mPicker != null) mPicker.unregister();
+        if (mAnswered) return;
+        mAnswered = true;
+        mListener.onCancel();
+    }
+
+    private String detailLine() {
+        List<String> parts = new ArrayList<>();
+        if (mTotalBytes > 0) parts.add(DownloadUtils.getStringForBytes(mActivity, mTotalBytes));
+        if (!TextUtils.isEmpty(mSite)) parts.add(mSite);
+        return TextUtils.join(" · ", parts);
+    }
+
+    private String folderName(Uri tree) {
+        try {
+            String id = DocumentsContract.getTreeDocumentId(tree);
+            int colon = id.indexOf(':');
+            String path = colon >= 0 ? id.substring(colon + 1) : id;
+            if (path.isEmpty()) return id;
+            return path.replace("/", " / ");
+        } catch (IllegalArgumentException e) {
+            String last = tree.getLastPathSegment();
+            return last == null ? tree.toString() : last;
+        }
+    }
+
+    private static String extension(String fileName) {
+        int dot = fileName.lastIndexOf('.');
+        if (dot < 0 || dot == fileName.length() - 1) return "FILE";
+        String ext = fileName.substring(dot + 1).toUpperCase(java.util.Locale.ROOT);
+        return ext.length() > 4 ? ext.substring(0, 4) : ext;
+    }
+
+    private TextView label(String text, int sp, boolean strong) {
+        TextView view = new TextView(mActivity);
+        view.setText(text);
+        view.setTextSize(TypedValue.COMPLEX_UNIT_SP, sp);
+        view.setTextColor(strong ? mInk : ((mInk & 0x00FFFFFF) | 0xB3000000));
+        return view;
+    }
+
+    private TextView button(String text, boolean primary) {
+        TextView view = new TextView(mActivity);
+        view.setText(text);
+        view.setTextSize(TypedValue.COMPLEX_UNIT_SP, 15);
+        view.setGravity(Gravity.CENTER);
+        view.setTextColor(primary ? mOnAccent : mInk);
+        view.setBackground(round(primary ? mAccent : mSoft, 14));
+        return view;
+    }
+
+    private GradientDrawable round(@ColorInt int color, int radiusDp) {
+        GradientDrawable shape = new GradientDrawable();
+        shape.setColor(color);
+        shape.setCornerRadius(radiusDp * mDensity);
+        return shape;
+    }
+
+    private LinearLayout.LayoutParams topMargin(int dp) {
+        LinearLayout.LayoutParams params =
+                new LinearLayout.LayoutParams(
+                        ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT);
+        params.topMargin = dp(dp);
+        return params;
+    }
+
+    private int dp(int value) {
+        return Math.round(value * mDensity);
+    }
+
+    private static double luminance(@ColorInt int color) {
+        return 0.299 * Color.red(color) + 0.587 * Color.green(color) + 0.114 * Color.blue(color);
+    }
+}

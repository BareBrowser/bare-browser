From 97998f67dab954ffdb8b7bcf708d26d4a9ca0e89 Mon Sep 17 00:00:00 2001
From: Bare <git@barebrowser.org>
Date: Tue, 25 Aug 2026 16:08:31 +0000
Subject: [PATCH] Patch 0000090

---
 .../signin/public/base/signin_switches.cc     | 19 ++++++++++++++++++-
 .../identity_manager/identity_manager.cc      | 15 +++++++++------
 2 files changed, 27 insertions(+), 7 deletions(-)

diff --git a/components/signin/public/base/signin_switches.cc b/components/signin/public/base/signin_switches.cc
index e2d674d22c1..8ed63a3dbca 100644
--- a/components/signin/public/base/signin_switches.cc
+++ b/components/signin/public/base/signin_switches.cc
@@ -58,8 +58,25 @@ BASE_FEATURE(kAccountRetrievalWaitsForRestoration,
              base::FEATURE_ENABLED_BY_DEFAULT);
 #endif
 
+// De-Googled build: on by default, so reading the cookie jar never reaches
+// the network on its own.
+//
+// GetAccountsInCookieJar() fetches /ListAccounts from accounts.google.com
+// whenever its cached answer is stale, and the cache is always stale in a fresh
+// process. Two services ask for it while the profile is still being built, both
+// only to report metrics: AccountInvestigator, which exists to emit histograms
+// comparing the browser account with the content area, and
+// SyncSessionDurationsMetricsRecorder, reached from AndroidSessionDurationsService.
+// Neither has an answer to act on here, because this build has no browser
+// sign-in and no sync, so the fetch bought nothing and happened on every cold
+// start before the user had touched anything.
+//
+// Upstream is moving the same way for its own reasons: see the comment on
+// GetCachedAccountsInCookieJar() and crbug.com/517864199, which tracks removing
+// the implicit fetch entirely. Callers now get the cached answer, and the paths
+// that genuinely need a refresh still ask for one.
 BASE_FEATURE(kAvoidAutoTriggerListAccountsOnStale,
-             base::FEATURE_DISABLED_BY_DEFAULT);
+             base::FEATURE_ENABLED_BY_DEFAULT);
 
 #if BUILDFLAG(IS_WIN) || BUILDFLAG(IS_MAC) || BUILDFLAG(IS_LINUX)
 BASE_FEATURE(kBeforeFirstRunDesktopRefreshSurvey,
diff --git a/components/signin/public/identity_manager/identity_manager.cc b/components/signin/public/identity_manager/identity_manager.cc
index fb82df3c776..f51dc56ea05 100644
--- a/components/signin/public/identity_manager/identity_manager.cc
+++ b/components/signin/public/identity_manager/identity_manager.cc
@@ -460,12 +460,15 @@ void IdentityManager::RemoveDiagnosticsObserver(DiagnosticsObserver* observer) {
 void IdentityManager::OnNetworkInitialized() {
   gaia_cookie_manager_service_->InitCookieListener();
   account_fetcher_service_->OnNetworkInitialized();
-  // Trigger ListAccounts once the network is initialized to ensure the accounts
-  // in cookie jar are up to date.
-  if (base::FeatureList::IsEnabled(
-          switches::kAvoidAutoTriggerListAccountsOnStale)) {
-    gaia_cookie_manager_service_->ListAccounts();
-  }
+  // De-Googled build: no /ListAccounts here.
+  //
+  // Upstream pairs kAvoidAutoTriggerListAccountsOnStale with one deliberate
+  // fetch at this point, so that a browser which does support signing in still
+  // learns the cookie state once. Keeping it would have moved the startup
+  // request rather than removed it. Nothing in this build signs in to the
+  // browser, so the cookie jar is read from the cache, and the listener
+  // installed above still picks up a change if the user signs in to a Google
+  // site themselves.
 }
 
 CoreAccountId IdentityManager::PickAccountIdForAccount(

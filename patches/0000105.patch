+    @Test
+    @SmallTest
+    public void testAskBeforeLeavingForApp_StayHereKeepsTheChainInTheBrowser() {
+        // Declining the Open in app prompt resumes the interrupted load on the same chain. That
+        // load must not bring the prompt back, while a later link the user taps starts a new
+        // chain and is asked about again.
+        Intent testIntent = new Intent(mRealApplicationContext, BlankUiTestActivity.class);
+        testIntent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK);
+        Activity activity =
+                InstrumentationRegistry.getInstrumentation().startActivitySync(testIntent);
+        mDelegate.setContext(activity);
+        mDelegate.setCanLoadUrlInTab(true);
+        mDelegate.setShouldAskBeforeLeavingForApp(true);
+        mDelegate.add(new IntentActivity(YOUTUBE_URL, YOUTUBE_PACKAGE_NAME));
+        try {
+            RedirectHandler handler = redirectHandlerForLinkClick();
+            ThreadUtils.runOnUiThreadBlocking(
+                    () -> {
+                        checkUrl(YOUTUBE_URL, handler)
+                                .withHasUserGesture(true)
+                                .expecting(
+                                        OverrideUrlLoadingResultType.OVERRIDE_WITH_ASYNC_ACTION,
+                                        IGNORE);
+                        Assert.assertNotNull(
+                                "the prompt should be showing", mUrlHandler.mOpenInAppDialogDelegate);
+                        Assert.assertNull(mUrlHandler.mStartActivityIntent);
+                        Assert.assertFalse(handler.shouldNotOverrideUrlLoading());
+
+                        mUrlHandler.mOpenInAppDialogDelegate.performClick(
+                                ModalDialogProperties.ButtonType.NEGATIVE);
+                    });
+            // The decision callback is posted, so continue after it has run.
+            ThreadUtils.runOnUiThreadBlocking(
+                    () -> {
+                        Assert.assertEquals(YOUTUBE_URL, mUrlHandler.mNewUrlAfterClobbering);
+                        Assert.assertNull(mUrlHandler.mOpenInAppDialogDelegate);
+                        Assert.assertTrue(
+                                "the chain should now stay in the browser",
+                                handler.shouldNotOverrideUrlLoading());
+                        mUrlHandler.mNewUrlAfterClobbering = null;
+
+                        // The resumed load: same chain, renderer initiated, no fresh gesture.
+                        handler.updateNewUrlLoading(PageTransition.LINK, false, false, 0, false, true);
+                        checkUrl(YOUTUBE_URL, handler)
+                                .withHasUserGesture(false)
+                                .expecting(OverrideUrlLoadingResultType.NO_OVERRIDE, IGNORE);
+                        Assert.assertNull(
+                                "no second prompt for the same navigation",
+                                mUrlHandler.mOpenInAppDialogDelegate);
+                        Assert.assertNull(mUrlHandler.mStartActivityIntent);
+
+                        // A later link the user taps is a new chain and is asked about again.
+                        checkUrl(YOUTUBE_URL, redirectHandlerForLinkClick())
+                                .withHasUserGesture(true)
+                                .expecting(
+                                        OverrideUrlLoadingResultType.OVERRIDE_WITH_ASYNC_ACTION,
+                                        IGNORE);
+                        Assert.assertNotNull(mUrlHandler.mOpenInAppDialogDelegate);
+                        mUrlHandler.mOpenInAppDialogDelegate.cancelDialog();
+                    });
+        } finally {
+            activity.finish();
+        }
+    }
+

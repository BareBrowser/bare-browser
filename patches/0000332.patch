+// Opens a received transfer package with the same checks as a file's body.
+OpenResult OpenTransferOffThread(std::vector<uint8_t> transfer) {
+  OpenResult result;
+  if (transfer.empty() || transfer.size() - 1 > kMaxBodySize ||
+      (transfer[0] != static_cast<uint8_t>(Kind::kSetup) &&
+       transfer[0] != static_cast<uint8_t>(Kind::kFull))) {
+    result.error = "not_bare";
+    return result;
+  }
+  const Kind kind = static_cast<Kind>(transfer[0]);
+  std::string body(transfer.begin() + 1, transfer.end());
+  OPENSSL_cleanse(transfer.data(), transfer.size());
+  auto package = ReadPackage(body);
+  OPENSSL_cleanse(body.data(), body.size());
+  if (!package.has_value()) {
+    result.error = "damaged";
+    return result;
+  }
+  auto summary = ReadManifest(*package, kind);
+  if (!summary.has_value()) {
+    result.error = ContentsErrorName(summary.error());
+    return result;
+  }
+  result.package = std::move(*package);
+  result.summary = std::move(*summary);
+  return result;
+}

+// A package for a phone-to-phone transfer: the kind byte, then the same zip a
+// backup file carries. It travels inside TLS, so it isn't encrypted again.
+void OnCollectedForTransfer(base::WeakPtr<Profile> profile,
+                            Kind kind,
+                            ScopedJavaGlobalRef<jobject> callback,
+                            CollectedExtensions extensions) {
+  JNIEnv* env = AttachCurrentThread();
+  if (!profile) {
+    Java_BareBackupBridge_onBytes(env, callback, std::vector<uint8_t>());
+    return;
+  }
+  JavaAndroidPrefs android;
+  Sources sources = SourcesFor(profile.get(), &android);
+  sources.extensions = &extensions;
+  std::optional<BuiltPackage> built = BuildPackage(kind, sources);
+  if (!built || built->zip.size() > kMaxBodySize) {
+    Java_BareBackupBridge_onBytes(env, callback, std::vector<uint8_t>());
+    return;
+  }
+  std::vector<uint8_t> transfer;
+  transfer.reserve(built->zip.size() + 1);
+  transfer.push_back(static_cast<uint8_t>(kind));
+  transfer.insert(transfer.end(), built->zip.begin(), built->zip.end());
+  OPENSSL_cleanse(built->zip.data(), built->zip.size());
+  Java_BareBackupBridge_onBytes(env, callback, transfer);
+  OPENSSL_cleanse(transfer.data(), transfer.size());
+}

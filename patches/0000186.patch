+package org.chromium.chrome.browser.app.appmenu;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertNotNull;
+import static org.junit.Assert.assertNull;
+import static org.junit.Assert.assertTrue;
+
+import android.content.Context;
+
+import androidx.test.core.app.ApplicationProvider;
+
+import org.junit.After;
+import org.junit.Before;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+
+import org.chromium.base.test.BaseRobolectricTestRunner;
+import org.chromium.chrome.R;
+import org.chromium.chrome.browser.preferences.ChromePreferenceKeys;
+import org.chromium.chrome.browser.preferences.ChromeSharedPreferences;
+import org.chromium.chrome.browser.ui.appmenu.AppMenuHandler.AppMenuItemType;
+import org.chromium.chrome.browser.ui.appmenu.AppMenuItemProperties;
+import org.chromium.ui.modelutil.MVCListAdapter.ListItem;
+import org.chromium.ui.modelutil.MVCListAdapter.ModelList;
+import org.chromium.ui.modelutil.PropertyModel;
+
+/** Unit tests for {@link BareAppMenuCustomization}. */
+@RunWith(BaseRobolectricTestRunner.class)
+public class BareAppMenuCustomizationUnitTest {
+    private Context mContext;
+
+    @Before
+    public void setUp() {
+        mContext = ApplicationProvider.getApplicationContext();
+        BareAppMenuCustomization.setEditMode(false);
+    }
+
+    @After
+    public void tearDown() {
+        BareAppMenuCustomization.setEditMode(false);
+        ChromeSharedPreferences.getInstance()
+                .removeKey(ChromePreferenceKeys.BARE_APP_MENU_HIDDEN_ITEMS);
+        ChromeSharedPreferences.getInstance()
+                .removeKey(ChromePreferenceKeys.BARE_APP_MENU_EDIT_TIP_COUNT);
+    }
+
+    private static ListItem item(int id) {
+        PropertyModel model =
+                new PropertyModel.Builder(AppMenuItemProperties.ALL_KEYS)
+                        .with(AppMenuItemProperties.MENU_ITEM_ID, id)
+                        .with(AppMenuItemProperties.ENABLED, true)
+                        .build();
+        return new ListItem(AppMenuItemType.STANDARD_NO_ICON, model);
+    }
+
+    private static ListItem divider() {
+        PropertyModel model =
+                new PropertyModel.Builder(AppMenuItemProperties.ALL_KEYS)
+                        .with(AppMenuItemProperties.MENU_ITEM_ID, R.id.divider_line_id)
+                        .build();
+        return new ListItem(AppMenuItemType.DIVIDER, model);
+    }
+
+    private ModelList menu() {
+        ModelList list = new ModelList();
+        list.add(item(R.id.new_tab_menu_id));
+        list.add(divider());
+        list.add(item(R.id.share_menu_id));
+        list.add(item(R.id.print_id));
+        list.add(divider());
+        list.add(item(R.id.preferences_id));
+        return list;
+    }
+
+    private int idAt(ModelList list, int index) {
+        return list.get(index).model.get(AppMenuItemProperties.MENU_ITEM_ID);
+    }
+
+    private ModelList apply(ModelList list) {
+        return BareAppMenuCustomization.apply(
+                mContext,
+                new AppMenuItemTheme(mContext, /* tabModelSelector= */ null),
+                /* isIconAtStart= */ false,
+                list);
+    }
+
+    @Test
+    public void testNamesAreStableAndSettingsCannotBeHidden() {
+        assertEquals("share", BareAppMenuCustomization.keyFor(R.id.share_menu_id));
+        assertNull(BareAppMenuCustomization.keyFor(R.id.preferences_id));
+        assertNull(BareAppMenuCustomization.keyFor(R.id.bare_exit_id));
+        assertNull(BareAppMenuCustomization.keyFor(R.id.icon_row_menu_id));
+    }
+
+    @Test
+    public void testNothingHiddenLeavesTheMenuAlone() {
+        BareAppMenuCustomization.dismissTip();
+        ModelList list = apply(menu());
+        assertEquals(6, list.size());
+    }
+
+    @Test
+    public void testHiddenItemsAreLeftOut() {
+        BareAppMenuCustomization.dismissTip();
+        BareAppMenuCustomization.toggle(R.id.share_menu_id);
+        ModelList list = apply(menu());
+        assertEquals(5, list.size());
+        for (int i = 0; i < list.size(); i++) {
+            assertFalse(idAt(list, i) == R.id.share_menu_id);
+        }
+    }
+
+    @Test
+    public void testHidingTheWholeGroupDropsItsDividerToo() {
+        BareAppMenuCustomization.dismissTip();
+        BareAppMenuCustomization.toggle(R.id.share_menu_id);
+        BareAppMenuCustomization.toggle(R.id.print_id);
+        ModelList list = apply(menu());
+        // new tab, divider, settings: the second divider would have sat next to the first.
+        assertEquals(3, list.size());
+        assertEquals(AppMenuItemType.DIVIDER, list.get(1).type);
+    }
+
+    @Test
+    public void testNoDividerIsLeftAtTheEnds() {
+        BareAppMenuCustomization.dismissTip();
+        BareAppMenuCustomization.toggle(R.id.new_tab_menu_id);
+        ModelList list = apply(menu());
+        assertFalse(list.get(0).type == AppMenuItemType.DIVIDER);
+        assertFalse(list.get(list.size() - 1).type == AppMenuItemType.DIVIDER);
+    }
+
+    @Test
+    public void testTogglingTwiceShowsItAgain() {
+        BareAppMenuCustomization.toggle(R.id.share_menu_id);
+        BareAppMenuCustomization.toggle(R.id.share_menu_id);
+        assertTrue(BareAppMenuCustomization.getHidden().isEmpty());
+    }
+
+    @Test
+    public void testTheTipIsShownThreeTimesThenNever() {
+        for (int i = 0; i < 3; i++) {
+            assertTrue(BareAppMenuCustomization.shouldShowTip());
+            ModelList list = apply(menu());
+            assertEquals(7, list.size());
+            BareAppMenuCustomization.countTipShown();
+        }
+        assertFalse(BareAppMenuCustomization.shouldShowTip());
+        assertEquals(6, apply(menu()).size());
+    }
+
+    @Test
+    public void testTappingTheTipDismissesIt() {
+        PropertyModel tip = item(R.id.bare_menu_tip_id).model;
+        assertTrue(BareAppMenuCustomization.onRowClicked(tip));
+        assertFalse(BareAppMenuCustomization.shouldShowTip());
+    }
+
+    @Test
+    public void testLongPressOpensEditModeAndAnotherClosesIt() {
+        PropertyModel share = item(R.id.share_menu_id).model;
+        assertTrue(BareAppMenuCustomization.onRowLongPressed(share));
+        assertTrue(BareAppMenuCustomization.isEditMode());
+        assertTrue(BareAppMenuCustomization.onRowLongPressed(share));
+        assertFalse(BareAppMenuCustomization.isEditMode());
+    }
+
+    @Test
+    public void testLongPressOnAnythingElseDoesNotEdit() {
+        PropertyModel back = item(R.id.back_menu_id).model;
+        assertFalse(BareAppMenuCustomization.onRowLongPressed(back));
+        assertFalse(BareAppMenuCustomization.isEditMode());
+    }
+
+    @Test
+    public void testEditModeListsHiddenItemsAtTheEndAndTapsToggle() {
+        BareAppMenuCustomization.toggle(R.id.share_menu_id);
+        BareAppMenuCustomization.setEditMode(true);
+        ModelList list = apply(menu());
+        // Done and the help line, the visible items, a divider, a heading and the hidden one.
+        assertEquals(AppMenuItemType.STANDARD_NO_ICON, list.get(0).type);
+        assertEquals(R.id.bare_menu_done_id, idAt(list, 0));
+        assertEquals(R.id.share_menu_id, idAt(list, list.size() - 1));
+        assertNotNull(list.get(list.size() - 1).model.get(AppMenuItemProperties.END_ICON));
+
+        PropertyModel share = list.get(list.size() - 1).model;
+        assertTrue(BareAppMenuCustomization.onRowClicked(share));
+        assertTrue(BareAppMenuCustomization.getHidden().isEmpty());
+        // A tap on Done leaves edit mode.
+        assertTrue(BareAppMenuCustomization.onRowClicked(list.get(0).model));
+        assertFalse(BareAppMenuCustomization.isEditMode());
+    }
+
+    @Test
+    public void testTheTipIsNotShownWhileEditing() {
+        BareAppMenuCustomization.setEditMode(true);
+        assertFalse(BareAppMenuCustomization.shouldShowTip());
+    }
+}

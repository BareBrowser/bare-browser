index 00000000000..cb2d9f69598
--- /dev/null
+++ b/chrome/android/java/src/org/chromium/chrome/browser/app/appmenu/BareAppMenuCustomization.java
@@ -0,0 +1,343 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.app.appmenu;
+
+import android.content.Context;
+
+import androidx.appcompat.content.res.AppCompatResources;
+
+import org.chromium.base.ResettersForTesting;
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.chrome.R;
+import org.chromium.chrome.browser.preferences.ChromePreferenceKeys;
+import org.chromium.chrome.browser.preferences.ChromeSharedPreferences;
+import org.chromium.chrome.browser.ui.appmenu.AppMenuHandler.AppMenuItemType;
+import org.chromium.chrome.browser.ui.appmenu.AppMenuItemProperties;
+import org.chromium.ui.modelutil.MVCListAdapter.ListItem;
+import org.chromium.ui.modelutil.MVCListAdapter.ModelList;
+import org.chromium.ui.modelutil.PropertyModel;
+
+import java.util.ArrayList;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Set;
+
+/**
+ * Lets the user choose which items the three-dot menu shows.
+ *
+ * <p>Touching and holding an item switches the menu to edit mode, where each item that can be
+ * hidden carries an eye, tapping an item hides it or shows it again, and the items already hidden
+ * are listed together under their own heading. Touching and holding again, or Done, leaves edit
+ * mode. Outside edit mode the hidden items are simply left out. A short tip about this is shown on
+ * the first three times the menu opens.
+ *
+ * <p>Only the items on the list below can be hidden, and they are remembered by a name of their
+ * own rather than by their resource id, which is only stable within one build. Settings, Exit and
+ * the row of buttons at the top are never on it.
+ */
+@NullMarked
+public final class BareAppMenuCustomization {
+    private static final int TIP_LIMIT = 3;
+
+    /** The hideable items: a stable name, then the id the menu gives that item. */
+    private static final String[] KEYS = {
+        "new_tab",
+        "new_incognito_tab",
+        "new_window",
+        "new_incognito_window",
+        "move_to_other_window",
+        "manage_all_windows",
+        "history",
+        "quick_delete",
+        "page_info",
+        "homepage",
+        "downloads",
+        "recently_closed",
+        "extensions",
+        "zoom",
+        "share",
+        "download_page",
+        "print",
+        "find_in_page",
+        "translate",
+        "read_aloud",
+        "reader_mode",
+        "open_with",
+        "open_in_app",
+        "add_to_home_screen",
+        "request_desktop_site",
+        "dark_pages",
+        "developer_tools",
+        "help",
+        "lens",
+        "image_descriptions",
+        "listen_to_feed",
+    };
+
+    private static final int[] IDS = {
+        R.id.new_tab_menu_id,
+        R.id.new_incognito_tab_menu_id,
+        R.id.new_window_menu_id,
+        R.id.new_incognito_window_menu_id,
+        R.id.move_to_other_window_menu_id,
+        R.id.manage_all_windows_menu_id,
+        R.id.open_history_menu_id,
+        R.id.quick_delete_menu_id,
+        R.id.info_menu_id,
+        R.id.homepage_menu_id,
+        R.id.downloads_menu_id,
+        R.id.recent_tabs_menu_id,
+        R.id.extensions_menu_menu_id,
+        R.id.page_zoom_id,
+        R.id.share_menu_id,
+        R.id.offline_page_id,
+        R.id.print_id,
+        R.id.find_in_page_id,
+        R.id.translate_id,
+        R.id.readaloud_menu_id,
+        R.id.reader_mode_menu_id,
+        R.id.open_with_id,
+        R.id.open_in_app_menu_id,
+        R.id.universal_install,
+        R.id.request_desktop_site_id,
+        R.id.auto_dark_web_contents_id,
+        R.id.dev_tools,
+        R.id.help_id,
+        R.id.lens_overlay_menu_id,
+        R.id.get_image_descriptions_id,
+        R.id.listen_to_feed_id,
+    };
+
+    private static boolean sEditMode;
+    private static boolean sTipDisabledForTesting;
+
+    private BareAppMenuCustomization() {}
+
+    static @Nullable String keyFor(int id) {
+        for (int i = 0; i < IDS.length; i++) {
+            if (IDS[i] == id) return KEYS[i];
+        }
+        return null;
+    }
+
+    static boolean isHideable(int id) {
+        return keyFor(id) != null;
+    }
+
+    /** Whether a long press on this item should open edit mode (and not just show its name). */
+    static boolean opensEditMode(int id) {
+        return isHideable(id)
+                || id == R.id.preferences_id
+                || id == R.id.bare_exit_id
+                || id == R.id.bare_menu_tip_id
+                || id == R.id.bare_menu_done_id
+                || id == R.id.bare_menu_edit_help_id
+                || id == R.id.bare_menu_hidden_header_id;
+    }
+
+    /** Tests that count the menu's rows do not expect the tip. */
+    public static void setTipDisabledForTesting(boolean disabled) {
+        sTipDisabledForTesting = disabled;
+        ResettersForTesting.register(() -> sTipDisabledForTesting = false);
+    }
+
+    static boolean isEditMode() {
+        return sEditMode;
+    }
+
+    public static void setEditMode(boolean editMode) {
+        sEditMode = editMode;
+    }
+
+    static Set<String> getHidden() {
+        Set<String> stored =
+                ChromeSharedPreferences.getInstance()
+                        .readStringSet(ChromePreferenceKeys.BARE_APP_MENU_HIDDEN_ITEMS, null);
+        return stored == null ? new HashSet<>() : new HashSet<>(stored);
+    }
+
+    static void setHidden(Set<String> hidden) {
+        if (hidden.isEmpty()) {
+            ChromeSharedPreferences.getInstance()
+                    .removeKey(ChromePreferenceKeys.BARE_APP_MENU_HIDDEN_ITEMS);
+        } else {
+            ChromeSharedPreferences.getInstance()
+                    .writeStringSet(ChromePreferenceKeys.BARE_APP_MENU_HIDDEN_ITEMS, hidden);
+        }
+    }
+
+    /** Hides the item, or shows it again if it was hidden. */
+    static void toggle(int id) {
+        String key = keyFor(id);
+        if (key == null) return;
+        Set<String> hidden = getHidden();
+        if (!hidden.remove(key)) hidden.add(key);
+        setHidden(hidden);
+    }
+
+    public static boolean shouldShowTip() {
+        return !sEditMode
+                && !sTipDisabledForTesting
+                && ChromeSharedPreferences.getInstance()
+                                .readInt(ChromePreferenceKeys.BARE_APP_MENU_EDIT_TIP_COUNT, 0)
+                        < TIP_LIMIT;
+    }
+
+    public static void countTipShown() {
+        int shown =
+                ChromeSharedPreferences.getInstance()
+                        .readInt(ChromePreferenceKeys.BARE_APP_MENU_EDIT_TIP_COUNT, 0);
+        ChromeSharedPreferences.getInstance()
+                .writeInt(ChromePreferenceKeys.BARE_APP_MENU_EDIT_TIP_COUNT, shown + 1);
+    }
+
+    public static void dismissTip() {
+        ChromeSharedPreferences.getInstance()
+                .writeInt(ChromePreferenceKeys.BARE_APP_MENU_EDIT_TIP_COUNT, TIP_LIMIT);
+    }
+
+    /**
+     * Applies the user's choices to a freshly built menu, in place. Hidden items are removed
+     * (and, in edit mode, listed together at the end), dividers left stranded are dropped, and the
+     * tip or the edit-mode rows are added.
+     */
+    public static ModelList apply(
+            Context context, AppMenuItemTheme theme, boolean isIconAtStart, ModelList list) {
+        Set<String> hidden = getHidden();
+        List<ListItem> hiddenItems = new ArrayList<>();
+        for (int i = list.size() - 1; i >= 0; i--) {
+            ListItem item = list.get(i);
+            if (item.type != AppMenuItemType.STANDARD
+                    && item.type != AppMenuItemType.STANDARD_NO_ICON) {
+                continue;
+            }
+            String key = keyFor(item.model.get(AppMenuItemProperties.MENU_ITEM_ID));
+            if (key == null) continue;
+            boolean isHidden = hidden.contains(key);
+            if (sEditMode) {
+                item.model.set(
+                        AppMenuItemProperties.END_ICON,
+                        AppCompatResources.getDrawable(
+                                context,
+                                isHidden ? R.drawable.bare_menu_eye_off : R.drawable.bare_menu_eye));
+                if (isHidden) {
+                    list.removeAt(i);
+                    hiddenItems.add(0, item);
+                }
+            } else if (isHidden) {
+                list.removeAt(i);
+            }
+        }
+        removeStrandedDividers(list);
+
+        // Rows go after the button row at the top, if there is one.
+        int at = list.size() > 0 && list.get(0).type == AppMenuItemType.BUTTON_ROW ? 1 : 0;
+        if (sEditMode) {
+            list.add(
+                    at,
+                    textRow(
+                            context,
+                            theme,
+                            isIconAtStart,
+                            R.id.bare_menu_done_id,
+                            R.string.bare_menu_edit_done,
+                            true));
+            list.add(
+                    at + 1,
+                    textRow(
+                            context,
+                            theme,
+                            isIconAtStart,
+                            R.id.bare_menu_edit_help_id,
+                            R.string.bare_menu_edit_help,
+                            false));
+            if (!hiddenItems.isEmpty()) {
+                list.add(new ListItem(AppMenuItemType.DIVIDER, dividerModel()));
+                list.add(
+                        textRow(
+                                context,
+                                theme,
+                                isIconAtStart,
+                                R.id.bare_menu_hidden_header_id,
+                                R.string.bare_menu_hidden_heading,
+                                false));
+                for (ListItem item : hiddenItems) list.add(item);
+            }
+        } else if (shouldShowTip()) {
+            list.add(
+                    at,
+                    textRow(
+                            context,
+                            theme,
+                            isIconAtStart,
+                            R.id.bare_menu_tip_id,
+                            R.string.bare_menu_tip,
+                            true));
+        }
+        return list;
+    }
+
+    private static ListItem textRow(
+            Context context,
+            AppMenuItemTheme theme,
+            boolean isIconAtStart,
+            int id,
+            int titleRes,
+            boolean enabled) {
+        PropertyModel model =
+                AppMenuItemUtils.buildModelForStandardMenuItem(
+                        context, theme, id, titleRes, /* iconResId= */ 0, isIconAtStart);
+        model.set(AppMenuItemProperties.TITLE_MAX_LINES, 4);
+        model.set(AppMenuItemProperties.ENABLED, enabled);
+        return AppMenuItemUtils.createStandardListItem(model, /* showIcon= */ false);
+    }
+
+    private static PropertyModel dividerModel() {
+        return AppMenuItemUtils.buildModelForDivider(R.id.divider_line_id);
+    }
+
+    /** Drops dividers at the start or end of the list and any that follow another. */
+    private static void removeStrandedDividers(ModelList list) {
+        for (int i = list.size() - 1; i >= 0; i--) {
+            if (list.get(i).type != AppMenuItemType.DIVIDER) continue;
+            boolean first = i == 0;
+            boolean last = i == list.size() - 1;
+            boolean afterDivider = i > 0 && list.get(i - 1).type == AppMenuItemType.DIVIDER;
+            if (first || last || afterDivider) list.removeAt(i);
+        }
+    }
+
+    /** What the delegate does for a click while editing or on the tip. Returns whether handled. */
+    public static boolean onRowClicked(PropertyModel model) {
+        int id = model.get(AppMenuItemProperties.MENU_ITEM_ID);
+        if (sEditMode) {
+            if (id == R.id.bare_menu_done_id) {
+                sEditMode = false;
+            } else if (isHideable(id)) {
+                toggle(id);
+            }
+            return true;
+        }
+        if (id == R.id.bare_menu_tip_id) {
+            dismissTip();
+            return true;
+        }
+        return false;
+    }
+
+    /** What the delegate does for a long press. Returns whether the menu has to be rebuilt. */
+    public static boolean onRowLongPressed(PropertyModel model) {
+        int id = model.get(AppMenuItemProperties.MENU_ITEM_ID);
+        if (sEditMode) {
+            sEditMode = false;
+            return true;
+        }
+        if (!opensEditMode(id)) return false;
+        sEditMode = true;
+        dismissTip();
+        return true;
+    }
+}

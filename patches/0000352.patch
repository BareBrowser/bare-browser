+/**
+ * Bare: the box that holds the shortcut grid. It is as tall as two rows and scrolls up and down
+ * when there are more.
+ *
+ * <p>The page around it scrolls the same way, so the box has to decide who gets a swipe. On touch
+ * down it asks the page to wait. Once the finger has moved far enough: a mostly vertical swipe
+ * that the grid can still follow stays in the grid; anything else goes back to the page. When a
+ * tile drag has started (long press), the drag keeps the gesture.
+ */
+@NullMarked
+public class MostVisitedTilesScrollView extends ScrollView {
+    /** Number of rows shown before the grid has to scroll. */
+    static final int VISIBLE_ROWS = 2;
+
+    private final int mTouchSlop;
+    private float mDownX;
+    private float mDownY;
+    private boolean mHolding;
+    private boolean mDecided;
+    private boolean mChildHoldsGesture;
+
+    public MostVisitedTilesScrollView(Context context, @Nullable AttributeSet attrs) {
+        super(context, attrs);
+        mTouchSlop = ViewConfiguration.get(context).getScaledTouchSlop();
+        setFillViewport(false);
+    }
+
+    @Override
+    protected void onMeasure(int widthMeasureSpec, int heightMeasureSpec) {
+        super.onMeasure(widthMeasureSpec, heightMeasureSpec);
+        View child = getChildCount() > 0 ? getChildAt(0) : null;
+        if (!(child instanceof MostVisitedTilesLayout grid) || !grid.isGridMode()) return;
+        int height =
+                grid.getVisibleRowsHeight(VISIBLE_ROWS) + getPaddingTop() + getPaddingBottom();
+        int mode = MeasureSpec.getMode(heightMeasureSpec);
+        if (mode == MeasureSpec.EXACTLY) return;
+        if (mode == MeasureSpec.AT_MOST) {
+            height = Math.min(height, MeasureSpec.getSize(heightMeasureSpec));
+        }
+        setMeasuredDimension(getMeasuredWidth(), height);
+    }
+
+    @Override
+    protected void onLayout(boolean changed, int l, int t, int r, int b) {
+        super.onLayout(changed, l, t, r, b);
+        // Keep the scroll position valid when rows go away.
+        int maxScroll = Math.max(0, getScrollRange());
+        if (getScrollY() > maxScroll) scrollTo(0, maxScroll);
+    }
+
+    private int getScrollRange() {
+        if (getChildCount() == 0) return 0;
+        return getChildAt(0).getHeight() - (getHeight() - getPaddingTop() - getPaddingBottom());
+    }
+
+    /** Whether there are rows hidden above or below. */
+    boolean canScrollGrid() {
+        return canScrollVertically(1) || canScrollVertically(-1);
+    }
+
+    @Override
+    public void requestDisallowInterceptTouchEvent(boolean disallowIntercept) {
+        // A child (the tile drag) wants the gesture for itself.
+        if (disallowIntercept) mChildHoldsGesture = true;
+        super.requestDisallowInterceptTouchEvent(disallowIntercept);
+    }
+
+    @Override
+    public boolean dispatchTouchEvent(MotionEvent ev) {
+        switch (ev.getActionMasked()) {
+            case MotionEvent.ACTION_DOWN:
+                mDownX = ev.getX();
+                mDownY = ev.getY();
+                mDecided = false;
+                mChildHoldsGesture = false;
+                mHolding = canScrollGrid();
+                if (mHolding) holdParent(true);
+                break;
+            case MotionEvent.ACTION_MOVE:
+                if (mHolding && !mDecided) {
+                    float dx = ev.getX() - mDownX;
+                    float dy = ev.getY() - mDownY;
+                    if (Math.max(Math.abs(dx), Math.abs(dy)) > mTouchSlop) {
+                        mDecided = true;
+                        // Finger moving up scrolls the grid down, and the other way round.
+                        boolean gridCanFollow =
+                                Math.abs(dy) > Math.abs(dx)
+                                        && canScrollVertically(dy < 0 ? 1 : -1);
+                        if (!gridCanFollow && !mChildHoldsGesture) {
+                            mHolding = false;
+                            holdParent(false);
+                        }
+                    }
+                }
+                break;
+            case MotionEvent.ACTION_UP:
+            case MotionEvent.ACTION_CANCEL:
+                mHolding = false;
+                break;
+            default:
+                break;
+        }
+        return super.dispatchTouchEvent(ev);
+    }
+
+    private void holdParent(boolean hold) {
+        ViewParent parent = getParent();
+        if (parent != null) parent.requestDisallowInterceptTouchEvent(hold);
+    }
+}

+<?xml version="1.0" encoding="utf-8"?>
+<!--
+Copyright 2026 The Chromium Authors
+Use of this source code is governed by a BSD-style license that can be
+found in the LICENSE file.
+-->
+
+<!-- Bare: one shortcut in the new tab page grid. A rounded square icon with the name under
+     it. The ids are the ones TileView looks up. -->
+<org.chromium.chrome.browser.suggestions.tile.SuggestionsTileView
+    xmlns:android="http://schemas.android.com/apk/res/android"
+    xmlns:app="http://schemas.android.com/apk/res-auto"
+    xmlns:tools="http://schemas.android.com/tools"
+    android:layout_width="@dimen/bare_mvt_tile_width"
+    android:layout_height="wrap_content"
+    android:paddingStart="@dimen/bare_mvt_tile_padding_horizontal"
+    android:paddingEnd="@dimen/bare_mvt_tile_padding_horizontal"
+    android:paddingTop="@dimen/bare_mvt_tile_padding_vertical"
+    android:paddingBottom="@dimen/bare_mvt_tile_padding_vertical"
+    android:tag="bare_mvt_grid"
+    android:background="@drawable/tile_view_background_selector">
+
+    <View
+        android:id="@+id/tile_view_icon_background"
+        android:layout_width="@dimen/bare_mvt_tile_icon_size"
+        android:layout_height="@dimen/bare_mvt_tile_icon_size"
+        android:layout_gravity="top|center_horizontal"
+        android:background="@drawable/bare_mvt_tile_icon_bg" />
+
+    <ImageView
+        android:id="@+id/tile_view_icon"
+        android:layout_width="@dimen/bare_mvt_tile_favicon_size"
+        android:layout_height="@dimen/bare_mvt_tile_favicon_size"
+        android:layout_gravity="top|center_horizontal"
+        android:layout_marginTop="@dimen/bare_mvt_tile_favicon_margin_top"
+        android:scaleType="fitCenter"
+        tools:ignore="ContentDescription" />
+
+    <View
+        android:id="@+id/tile_view_highlight"
+        android:layout_width="@dimen/bare_mvt_tile_icon_size"
+        android:layout_height="@dimen/bare_mvt_tile_icon_size"
+        android:layout_gravity="top|center_horizontal"
+        android:background="@drawable/bare_mvt_tile_highlight" />
+
+    <ImageView
+        android:id="@+id/offline_badge"
+        android:layout_width="@dimen/tile_view_offline_badge_size_modern"
+        android:layout_height="@dimen/tile_view_offline_badge_size_modern"
+        android:layout_gravity="top|end"
+        android:visibility="gone"
+        android:contentDescription="@string/accessibility_ntp_offline_badge"
+        app:srcCompat="@drawable/ic_offline_pin_fill_24dp"
+        app:tint="@macro/default_icon_color_accent1" />
+
+    <!-- Kept for TileView; the grid never shows the pin. -->
+    <ImageView
+        android:id="@+id/pinned_shortcut_badge"
+        android:layout_width="6sp"
+        android:layout_height="10sp"
+        android:visibility="gone"
+        android:scaleType="matrix"
+        android:contentDescription="@string/accessibility_ntp_pinned_shortcut_badge"
+        app:srcCompat="@drawable/ic_keep_24dp"
+        tools:ignore="SmallSp" />
+
+    <org.chromium.ui.widget.TextViewWithLeading
+        android:id="@+id/tile_view_title"
+        android:layout_width="match_parent"
+        android:layout_height="wrap_content"
+        android:layout_marginTop="@dimen/bare_mvt_tile_title_margin_top"
+        android:ellipsize="end"
+        android:lines="2"
+        android:gravity="top|center_horizontal"
+        android:textAppearance="@style/TextAppearance.TextSmall.Primary"
+        app:leading="@dimen/text_size_small_leading" />
+</org.chromium.chrome.browser.suggestions.tile.SuggestionsTileView>

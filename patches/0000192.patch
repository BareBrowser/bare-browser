@@ -61,6 +61,9 @@ public class BareToolbarPreviewPreference extends Preference {
     @Override
     public void onBindViewHolder(PreferenceViewHolder holder) {
         super.onBindViewHolder(holder);
+        // The picture draws its own rounded card, so the preference's square one would only show
+        // as a rim around its corners.
+        holder.itemView.setBackground(null);
         mRoot = holder.itemView;
         bind(holder.itemView);
     }

From 59b9b9012205d5ca4aa61bf223c4ffbfe5cc6f22 Mon Sep 17 00:00:00 2001
From: Bare <git@barebrowser.org>
Date: Sat, 22 Aug 2026 19:11:04 +0000
Subject: [PATCH] Name the filter list that strips tracking from links

Copied links keep their tracking parameters. uBlock Origin can remove them, and
it already ships in the browser, but the list that does it is not one of the
nine enabled by default: adguard-spyware-url carries the removeparam rules and
arrives switched off, one of 62 that do. Nothing surfaces that, so nobody finds
it.

Privacy and security gains a row naming the list, saying who maintains it, and
saying where to turn it on.

The row explains rather than navigates. Opening uBlock Origin's own page from
here was the obvious design and does not work: chrome-extension is not among the
schemes an intent may carry, so the tap was silently dropped. That restriction
stops any application opening extension pages, which is worth more than a
shortcut, so the row says where to go instead.

A switch was the other obvious design and is also wrong. The state belongs to
the extension, which has its own page for it, and a copy kept alongside would
disagree the moment it was changed on the other side. A privacy screen that
confidently reports the wrong answer is worse than one that reports nothing.

The list is left off. Turning it on would mean deciding for people that a
third-party rule set should rewrite their URLs, and removeparam occasionally
breaks a site's own links. Nothing about uBlock Origin's configuration is
touched.
---
 chrome/android/java/res/xml/privacy_preferences.xml         | 5 +++++
 .../browser/ui/android/strings/android_chrome_strings.grd   | 6 ++++++
 2 files changed, 11 insertions(+)

diff --git a/chrome/android/java/res/xml/privacy_preferences.xml b/chrome/android/java/res/xml/privacy_preferences.xml
index 5c4464c45d6..ac72dc510f8 100644
--- a/chrome/android/java/res/xml/privacy_preferences.xml
+++ b/chrome/android/java/res/xml/privacy_preferences.xml
@@ -77,6 +77,11 @@ found in the LICENSE file.
         android:key="javascript_optimizer"
         android:title="@string/website_settings_privacy_and_security_javascript_optimizer_row_label"
         android:fragment="org.chromium.components.browser_ui.site_settings.SingleCategorySettings" />
+    <org.chromium.components.browser_ui.settings.ChromeBasePreference
+        android:key="bare_link_tracking"
+        android:selectable="false"
+        android:title="@string/bare_link_tracking_title"
+        android:summary="@string/bare_link_tracking_summary" />
     <org.chromium.components.browser_ui.settings.ChromeSwitchPreference
         android:key="can_make_payment"
         android:title="@string/can_make_payment_title"
diff --git a/chrome/browser/ui/android/strings/android_chrome_strings.grd b/chrome/browser/ui/android/strings/android_chrome_strings.grd
index 08aee43d654..ea6d8bb2065 100644
--- a/chrome/browser/ui/android/strings/android_chrome_strings.grd
+++ b/chrome/browser/ui/android/strings/android_chrome_strings.grd
@@ -3081,6 +3081,12 @@ To change this setting, <ph name="BEGIN_LINK">BEGIN_LINK</ph>delete the Chrome d
       <message name="IDS_BARE_WELCOME_VALUE_UPDATE_MANUAL_REMIND" desc="Update setting: manual, with a weekly local reminder that uses no network." translateable="false">
         Manually, remind me weekly
       </message>
+      <message name="IDS_BARE_LINK_TRACKING_TITLE" desc="Settings row that leads to the filter list which strips tracking parameters from links.">
+        Remove tracking from links
+      </message>
+      <message name="IDS_BARE_LINK_TRACKING_SUMMARY" desc="Explains where the tracking-parameter list comes from and that it is not enabled unless the user turns it on.">
+        Uses AdGuard's URL Tracking Protection list, maintained by AdGuard and applied by uBlock Origin. Off by default: turn it on in uBlock Origin, under Filter lists, Privacy.
+      </message>
       <message name="IDS_BARE_CHECK_FOR_UPDATES" desc="Title of the settings row that looks for a newer version of the browser on GitHub.">
         Check for updates
       </message>

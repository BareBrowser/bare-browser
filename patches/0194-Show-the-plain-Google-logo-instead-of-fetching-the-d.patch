From c70a77246a44f100198093b33693311e741cc9e0 Mon Sep 17 00:00:00 2001
From: Bare <git@barebrowser.org>
Date: Tue, 13 Oct 2026 01:44:03 +0000
Subject: [PATCH] Show the plain Google logo instead of fetching the doodle

With Google as the search engine, every new tab page asked
www.google.com/async/ddljson for the day's doodle. The page now shows
its built-in Google logo and makes no request for it.
---
 components/search_provider_logos/logo_service_impl.cc | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/components/search_provider_logos/logo_service_impl.cc b/components/search_provider_logos/logo_service_impl.cc
index 3dc91cd48b3..78f42431002 100644
--- a/components/search_provider_logos/logo_service_impl.cc
+++ b/components/search_provider_logos/logo_service_impl.cc
@@ -252,6 +252,13 @@ void LogoServiceImpl::GetLogo(LogoCallbacks callbacks,
   GURL doodle_url;
   is_google_ = template_url->url_ref().HasGoogleBaseURLs(
       template_url_service_->search_terms_data());
+  if (is_google_) {
+    // Bare: no doodle. Fetching it sent a request to www.google.com every time
+    // a new tab page opened. Without it the page shows its built-in Google
+    // logo.
+    RunCallbacksWithDisabled(std::move(callbacks));
+    return;
+  }
   if (is_google_) {
     // Note: Ideally the Google doodle URL would be specified in
     // prepopulated_engines.json, but there is some custom logic in

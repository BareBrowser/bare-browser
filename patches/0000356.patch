+// found in the LICENSE file.
+
+// Bare Run: one-tap endless runner. Shared by the network error page and
+// chrome://games. Canvas only; no network, no storage.
+(() => {
+'use strict';
+const registry = window.bareGamesRegistry || (window.bareGamesRegistry = {});
+
+// The runner: Bare wing body on two legs. stride moves the legs.
+function runner(g,kit,x,y,stride,wingScale){g.fillStyle=kit.INK;const r=(a,b,w,h)=>g.fillRect(Math.round(a),Math.round(b),Math.round(w),Math.round(h));r(x-7,y+23,4,7+stride);r(x+3,y+23,4,7-stride);r(x-10,y+28+stride,9,3);r(x+2,y+28-stride,9,3);kit.drawWing(g,x,y+12,-.35,wingScale)}
+
+registry.run = {
+// Card picture: the whole runner, wing and feet, centred in the icon.
+icon(c) {
+  const kit = window.bareGamesKit;
+  c.width = c.height = 48;
+  const s = kit.wingSprite(-.35, .045, 'game'), [l, t, r, b] = kit.spriteBounds(s);
+  const wx = Math.round(-s.size / 2), wy = Math.round(12 - s.size / 2);
+  const left = Math.min(wx + l, -10), right = Math.max(wx + r, 11);
+  const top = Math.min(wy + t, 23), bottom = Math.max(wy + b, 31);
+  runner(c.getContext('2d'), kit, Math.round((48 - (right - left)) / 2 - left),
+         Math.round((48 - (bottom - top)) / 2 - top), 0, .045);
+},
+
+create(host, ctx) {
+const kit=window.bareGamesKit,W=480,H=270,G=225;
+const ui=kit.shell(host,{width:W,height:H,label:'Bare Run. Tap or press space to jump.',strings:ctx.strings,exit:ctx.exit});
+const g=ui.g,L=ui.layout;
+let mode='ready',score=0,best=0,frame=0,speed=2.1,spawn=0,distance=0;
+let bird={x:95,y:G-29,vy:0,ground:true},obstacles=[],gems=[];
+const fmt=n=>String(n).padStart(5,'0');
+function rect(x,y,w,h){g.fillRect(Math.round(x),Math.round(y),Math.round(w),Math.round(h))}
+function intro(){ui.panel('BARE RUN',['RUN AUTOMATICALLY','TAP TO JUMP','COLLECT DIAMONDS ◆'],'▶ START RUNNING',false,'TAP · CLICK · SPACE')}
+function start(){mode='play';score=0;frame=0;speed=2.1;spawn=0;distance=0;bird={x:95,y:G-29,vy:0,ground:true};obstacles=[];gems=[];ui.score(fmt(0));ui.speed('1.0X');ui.hidePanel()}
+function jump(){if(mode==='ready'||mode==='dead'){start();return}if(mode==='paused'){resume();return}if(bird.ground){bird.vy=-7.8;bird.ground=false}}
+function resume(){mode='play';ui.hidePanel()}
+function pause(){if(mode==='play'){mode='paused';ui.panel('PAUSED',['READY TO CONTINUE?'],'▶ RESUME',true)}else if(mode==='paused')resume()}
+function die(){if(mode!=='play')return;mode='dead';best=Math.max(best,score);ui.best('HI '+fmt(best));ui.panel('GAME OVER',['SCORE '+fmt(score),'TRY AGAIN!'],'RUN AGAIN',false,'ONE TAP TO JUMP · ◆ +10')}
+// New obstacles start just past the right edge of the screen.
+function addObstacle(){const type=Math.random()<.6?'block':'spike';obstacles.push({x:W+20+L.ox,y:G-(type==='block'?22:17),w:type==='block'?22:24,h:type==='block'?22:17,type,passed:false});if(Math.random()<.8)gems.push({x:W+55+L.ox,y:G-48-Math.random()*35,got:false})}
+function render(){ui.begin(kit.SKY);const v=ui.view(),vw=v.x1-v.x0;
+ // Clouds and ground marks wrap across the whole screen.
+ g.fillStyle='#fff';const cspan=Math.max(620,vw+120),cn=Math.ceil(cspan/110);for(let i=0;i<cn;i++){const x=((i*110-distance*.13)%cspan+cspan)%cspan-40+v.x0;for(let row=0;42+i%3*22-row*80>v.y0;row++){const y=42+i%3*22-row*80;rect(x+row*55,y,32,2);rect(x+row*55+7,y-4,18,2)}}
+ g.fillStyle=kit.GRASS;rect(v.x0,G+3,vw,v.y1-G-3);g.fillStyle=kit.GRASS_TOP;rect(v.x0,G,vw,3);
+ const dspan=Math.max(585,vw+40),dn=Math.ceil(dspan/39);for(let i=0;i<dn;i++){const x=((i*39-distance)%dspan+dspan)%dspan-12+v.x0;rect(x,G+9,12,2)}
+ for(const o of obstacles){g.fillStyle=kit.INK;if(o.type==='block'){rect(o.x,o.y,o.w,o.h);g.fillStyle=kit.PANEL;rect(o.x+4,o.y+4,4,4);rect(o.x+14,o.y+12,4,4)}else{g.beginPath();g.moveTo(Math.round(o.x),G);g.lineTo(Math.round(o.x+o.w/2),o.y);g.lineTo(Math.round(o.x+o.w),G);g.closePath();g.fill()}}
+ for(const d of gems){if(d.got)continue;g.fillStyle=kit.INK;rect(d.x-3,d.y-8,6,3);rect(d.x-6,d.y-5,12,10);rect(d.x-3,d.y+5,6,3);g.fillStyle='#fff';rect(d.x-2,d.y-2,3,3)}
+ const stride=bird.ground?Math.sin(frame*.35)*4:0;runner(g,kit,bird.x,bird.y,stride,.045)}
+function update(dt){if(mode==='play'){frame+=dt;speed=Math.min(6,2.1+Math.floor(frame/600)*.25);ui.speed((speed/2.1).toFixed(1)+'X');distance+=speed*dt;bird.vy+=.38*dt;bird.y+=bird.vy*dt;if(bird.y>=G-29){bird.y=G-29;bird.vy=0;bird.ground=true}spawn+=dt;if(spawn>Math.max(62,105-speed*6)){spawn=0;addObstacle()}for(const o of obstacles){o.x-=speed*dt;if(!o.passed&&o.x+o.w<bird.x-10){o.passed=true;score++;ui.score(fmt(score))}if(bird.x+10>o.x+3&&bird.x-10<o.x+o.w-3&&bird.y+28>o.y+4&&bird.y+4<G)die()}for(const d of gems){d.x-=speed*dt;if(!d.got&&Math.abs(d.x-bird.x)<17&&Math.abs(d.y-(bird.y+12))<19){d.got=true;score+=10;ui.score(fmt(score))}}obstacles=obstacles.filter(o=>o.x>-40-L.ox);gems=gems.filter(d=>d.x>-20-L.ox&&!d.got)}render()}

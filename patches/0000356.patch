+}
+
+registry.racer = {
+// Card picture: the player's car with the Bare badge.
+icon(c) {
+  const g = c.getContext('2d');
+  art(g).drawCar(16, 22, .62, '#2876e4', true);
+},
+
+create(host, ctx) {

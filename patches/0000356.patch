index 247c4b30902..2654a2599da 100644
--- a/chrome/renderer/net/net_error_helper.cc
+++ b/chrome/renderer/net/net_error_helper.cc
@@ -98,6 +98,27 @@ bool IsRunningInForcedAppMode() {
       switches::kForceAppMode);
 }
 
+// neterror.html marks where the Bare games go. They are stored once in the
+// resource pack and shared with chrome://games, so the offline page gets them
+// here instead of having grit inline a second copy.
+constexpr std::string_view kBareGamesSlot = "<!--bare-games-->";
+
+void AddBareGames(std::string* html) {
+  const size_t pos = html->find(kBareGamesSlot);
+  if (pos == std::string::npos) {
+    return;
+  }
+  ui::ResourceBundle& bundle = ui::ResourceBundle::GetSharedInstance();
+  std::string games = base::StrCat(
+      {"<style>", bundle.LoadDataResourceString(IDR_BARE_GAMES_CSS),
+       "</style>\n<script>",
+       bundle.LoadDataResourceString(IDR_BARE_GAMES_FLY_JS), "\n",
+       bundle.LoadDataResourceString(IDR_BARE_GAMES_RUN_JS), "\n",
+       bundle.LoadDataResourceString(IDR_BARE_GAMES_RACER_JS), "\n",
+       bundle.LoadDataResourceString(IDR_BARE_GAMES_JS), "</script>"});
+  html->replace(pos, kBareGamesSlot.size(), games);
+}
+
 }  // namespace
 

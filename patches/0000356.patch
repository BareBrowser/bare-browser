diff --git a/components/neterror/resources/bare_games/bare_games.js b/components/neterror/resources/bare_games/bare_games.js
new file mode 100644
index 00000000000..9b3d809f5fc
--- /dev/null
+++ b/components/neterror/resources/bare_games/bare_games.js
@@ -0,0 +1,599 @@
+// Copyright 2026 The Bare Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Game list shared by the offline error page and chrome://games, plus the
+// small kit the games draw with. Load it after bare_fly.js, bare_run.js and
+// bare_racer.js. The error page calls window.bareGames.mount(host, strings)
+// itself; chrome://games marks its host with data-bare-games-auto and passes
+// the strings as data attributes. Nothing here loads anything from the
+// network or stores anything.
+(() => {
+'use strict';
+const registry = window.bareGamesRegistry || (window.bareGamesRegistry = {});
+
+const INK = '#0d0b1a';
+const SKY = '#8fd3ff';
+const GRASS = '#3b9b4a';
+const GRASS_TOP = '#2b7a37';
+const PANEL = '#e9f7ff';
+
+// 5x7 pixel font. Each glyph is seven rows of five bits, one base-32 digit
+// per row. Text with characters outside this set (most translations) falls
+// back to a chunky monospace style instead.
+const FONT = {
+  "A":"ehhvhhh", "B":"uhhuhhu", "C":"ehggghe", "D":"uhhhhhu", "E":"vgguggv",
+  "F":"vgguggg", "G":"ehgnhhf", "H":"hhhvhhh", "I":"e44444e", "J":"72222ic",
+  "K":"hikokih", "L":"ggggggv", "M":"hrllhhh", "N":"hhpljhh", "O":"ehhhhhe",
+  "P":"uhhuggg", "Q":"ehhhlid", "R":"uhhukih", "S":"fgge11u", "T":"v444444",
+  "U":"hhhhhhe", "V":"hhhhha4", "W":"hhhllla", "X":"hha4ahh", "Y":"hha4444",
+  "Z":"v1248gv", "0":"ehjlphe", "1":"4c4444e", "2":"eh1248v", "3":"v2421he",
+  "4":"26aiv22", "5":"vgu11he", "6":"68guhhe", "7":"v124888", "8":"ehhehhe",
+  "9":"ehhf12c", " ":"0000000", ".":"00000cc", ",":"0000c48", ":":"0cc0cc0",
+  "!":"4444404", "?":"eh12404", "-":"000e000", "+":"044v440", "/":"122488g",
+  "'":"4480000", "(":"2488842", ")":"8422248", "%":"pp248jj",
+  "\u00b7":"0004000", "\u25c6":"04eve40", "\u25b6":"8cefec8",
+  "\u25c0":"26eue62", "\u2039":"0248420", "\u00d7":"0ha4ah0",
+  "\u2016":"0aaaaa0",
+};
+const ADVANCE = 6;
+const LINE = 9;
+
+function el(tag, className) {
+  const node = document.createElement(tag);
+  if (className) {
+    node.className = className;
+  }
+  return node;
+}
+
+function canDraw(text) {
+  for (const ch of text) {
+    if (ch !== '\n' && !(ch in FONT)) {
+      return false;
+    }
+  }
+  return true;
+}
+
+// Draws one line with its top-left corner at x, y, one unit per font pixel.
+function drawText(g, text, x, y, color) {
+  g.fillStyle = color;
+  let left = x;
+  for (const ch of text) {
+    const rows = FONT[ch];
+    for (let r = 0; r < 7; r++) {
+      const bits = parseInt(rows[r], 32);
+      for (let c = 0; c < 5; c++) {
+        if (bits & (16 >> c)) {
+          g.fillRect(left + c, y + r, 1, 1);
+        }
+      }
+    }
+    left += ADVANCE;
+  }
+}
+
+// Shows `text` in `node` in the pixel font, `size` CSS px per font pixel.
+// Screen readers get the plain text.
+function setText(node, text, size, color) {
+  text = String(text || '');
+  const upper = text.toUpperCase();
+  node.textContent = '';
+  node.style.setProperty('--bg-px', size + 'px');
+  if (!canDraw(upper)) {
+    node.classList.add('bg-mono');
+    node.textContent = upper;
+    return;
+  }
+  node.classList.remove('bg-mono');
+  const lines = upper.split('\n');
+  const cols = Math.max(...lines.map(l => [...l].length));
+  const c = el('canvas', 'bg-text');
+  c.width = Math.max(1, cols * ADVANCE - 1);
+  c.height = lines.length * LINE - 2;
+  const g = c.getContext('2d');
+  lines.forEach((line, i) => {
+    const w = [...line].length * ADVANCE - 1;
+    drawText(g, line, Math.floor((c.width - w) / 2), i * LINE, color || INK);
+  });
+  c.style.width = c.width * size + 'px';
+  c.style.height = c.height * size + 'px';
+  c.setAttribute('aria-hidden', 'true');
+  const label = el('span', 'bg-sr');
+  label.textContent = text.replace(/\n/g, ' ');
+  node.append(label, c);
+}
+
+// The Bare wing as the games draw it: mirrored with scale(-1, 1) around the
+// artwork centre (500, 500) of a 1000-unit box.
+const WING_A = [[234, 842], [108, 584, 230, 356, 452, 266],
+                [561, 221, 690, 189, 772, 183], [804, 301, 730, 453, 656, 519],
+                [466, 559, 322, 667, 234, 842]];
+const WING_B = [[234, 842], [310, 634, 526, 467, 828, 520],
+                [718, 746, 512, 862, 234, 842]];
+const LOOKS = {
+  // In the games: dark shape, white shape with a dark outline.
+  game: {a: INK, b: '#fff', outline: true},
+  // On the list page: Bare's two blues.
+  blue: {a: '#3d5af1', b: '#7db8fa', outline: false},
+  // The list logo: the Bare logo's own pose, as on the new tab page, so not
+  // mirrored.
+  logo: {a: '#3d5af1', b: '#7db8fa', outline: false, mirror: false},
+};
+
+// Turns the bezier outline into a polygon (flat list of x, y pairs).
+function flatten(pts) {
+  const out = [pts[0][0], pts[0][1]];
+  let x = pts[0][0];
+  let y = pts[0][1];
+  for (let i = 1; i < pts.length; i++) {
+    const [c1x, c1y, c2x, c2y, ex, ey] = pts[i];
+    for (let k = 1; k <= 24; k++) {
+      const t = k / 24;
+      const u = 1 - t;
+      out.push(u * u * u * x + 3 * u * u * t * c1x + 3 * u * t * t * c2x +
+                   t * t * t * ex,
+               u * u * u * y + 3 * u * u * t * c1y + 3 * u * t * t * c2y +
+                   t * t * t * ey);
+    }
+    x = ex;
+    y = ey;
+  }
+  return out;
+}
+const POLY_A = flatten(WING_A);
+const POLY_B = flatten(WING_B);
+
+function inside(poly, x, y) {
+  let hit = false;
+  for (let i = 0, j = poly.length - 2; i < poly.length; j = i, i += 2) {
+    const yi = poly[i + 1];
+    const yj = poly[j + 1];
+    if ((yi > y) !== (yj > y) &&
+        x < (poly[j] - poly[i]) * (y - yi) / (yj - yi) + poly[i]) {
+      hit = !hit;
+    }
+  }
+  return hit;
+}
+
+function nearEdge(poly, x, y, r) {
+  for (let i = 0, j = poly.length - 2; i < poly.length; j = i, i += 2) {
+    const ax = poly[j];
+    const ay = poly[j + 1];
+    const dx = poly[i] - ax;
+    const dy = poly[i + 1] - ay;
+    const len = dx * dx + dy * dy;
+    const t = len ? Math.max(0, Math.min(1, ((x - ax) * dx + (y - ay) * dy) /
+                                                  len)) : 0;
+    const ex = ax + t * dx - x;
+    const ey = ay + t * dy - y;
+    if (ex * ex + ey * ey <= r * r) {
+      return true;
+    }
+  }
+  return false;
+}
+
+const sprites = new Map();
+
+// A pixel sprite of the wing, worked out with plain geometry: each pixel is
+// sampled 3 x 3 against the outline, kept when at least 4 of 9 samples hit
+// (about the old alpha 110 cut) and given the colour most samples hit. It
+// never reads canvas pixels back, so Bare's canvas reading block cannot
+// blank it. `scale` maps the 1000-unit artwork to pixels; the sprite is
+// centred on the artwork centre. Returns {size, runs: [x, y, width, colour]}.
+function wingSprite(rotation, scale, lookName, size) {
+  rotation = Math.round(rotation * 40) / 40;
+  const key = rotation + '|' + scale + '|' + lookName + '|' + size;
+  let sprite = sprites.get(key);
+  if (sprite) {
+    return sprite;
+  }
+  const look = LOOKS[lookName];
+  size = size || Math.ceil(900 * scale) + 2;
+  const cos = Math.cos(rotation);
+  const sin = Math.sin(rotation);
+  const stroke = look.outline ? Math.max(20, 1.2 / scale) / 2 : 0;
+  const flip = look.mirror === false ? -1 : 1;
+  const runs = [];
+  for (let py = 0; py < size; py++) {
+    let run = null;
+    for (let px = 0; px < size; px++) {
+      let dark = 0;
+      let light = 0;
+      for (let sy = 0; sy < 3; sy++) {
+        for (let sx = 0; sx < 3; sx++) {
+          const X = px + (sx + 0.5) / 3 - size / 2;
+          const Y = py + (sy + 0.5) / 3 - size / 2;
+          // Undo rotate, mirror and scale to get artwork coordinates.
+          const ax = 500 - flip * (X * cos + Y * sin) / scale;
+          const ay = 500 + (-X * sin + Y * cos) / scale;
+          if (stroke && nearEdge(POLY_B, ax, ay, stroke)) {
+            dark++;
+          } else if (inside(POLY_B, ax, ay)) {
+            light++;
+          } else if (inside(POLY_A, ax, ay)) {
+            dark++;
+          }
+        }
+      }
+      const color = dark + light < 4 ? null : (light > dark ? look.b : look.a);
+      if (run && run[3] === color) {
+        run[2]++;
+      } else {
+        if (run && run[3]) {
+          runs.push(run);
+        }
+        run = [px, py, 1, color];
+      }
+    }
+    if (run && run[3]) {
+      runs.push(run);
+    }
+  }
+  sprite = {size, runs};
+  sprites.set(key, sprite);
+  return sprite;
+}
+
+// Draws a sprite with its top-left corner at x, y; plain rectangles only.
+function drawSprite(g, sprite, x, y) {
+  for (const [rx, ry, w, color] of sprite.runs) {
+    g.fillStyle = color;
+    g.fillRect(x + rx, y + ry, w, 1);
+  }
+}
+
+// Draws the in-game wing centred on x, y.
+function drawWing(g, x, y, rotation, scale) {
+  const s = wingSprite(rotation, scale, 'game');
+  drawSprite(g, s, Math.round(x - s.size / 2), Math.round(y - s.size / 2));
+}
+
+// Bounds of the drawn pixels of a sprite: [left, top, right, bottom].
+function spriteBounds(sprite) {
+  let l = Infinity;
+  let t = Infinity;
+  let r = -Infinity;
+  let b = -Infinity;
+  for (const [x, y, w] of sprite.runs) {
+    l = Math.min(l, x);
+    r = Math.max(r, x + w);
+    t = Math.min(t, y);
+    b = Math.max(b, y + 1);
+  }
+  return [l, t, r, b];
+}
+
+function button(className, text, size, color, label) {
+  const b = el('button', className);
+  b.type = 'button';
+  setText(b, text, size, color);
+  if (label) {
+    b.setAttribute('aria-label', label);
+  }
+  return b;
+}
+
+// The full-screen frame every game uses: a canvas that covers the screen,
+// score and buttons in the corners, and a centred panel for start, pause
+// and game over.
+//
+// The game keeps its own W x H play area. That area is scaled to fit the
+// screen without changing its shape and stays centred; the canvas is made
+// big enough, in game pixels, to cover the rest of the screen, and the game
+// paints its sky and ground into that extra room. layout.ox/oy is where the
+// play area starts on the canvas, layout.cw/ch the canvas size.
+function shell(host, opts) {
+  const W = opts.width;
+  const H = opts.height;
+  const strings = opts.strings || {};
+  const root = el('div', 'bg-game');
+  root.tabIndex = 0;
+  root.setAttribute('aria-label', opts.label);
+  const canvas = el('canvas', 'bg-canvas');
+  const g = canvas.getContext('2d');
+
+  const hud = el('div', 'bg-hud');
+  const left = el('div', 'bg-hud-side');
+  const exit = button('bg-icon-btn', '‹', 3, INK, strings.back || 'Back');
+  const stats = el('div', 'bg-hud-stats');
+  const score = el('div', 'bg-score');
+  const speed = el('div', 'bg-speed');
+  stats.append(score, speed);
+  left.append(exit, stats);
+  const right = el('div', 'bg-hud-side bg-hud-right');
+  const best = el('div', 'bg-best');
+  const pause = button('bg-icon-btn', '‖', 3, INK, 'Pause');
+  right.append(best, pause);
+  hud.append(left, right);
+
+  const overlay = el('div', 'bg-overlay');
+  const panel = el('div', 'bg-panel');
+  const title = el('div', 'bg-title');
+  const message = el('div', 'bg-message');
+  const primary = el('button', 'bg-btn');
+  primary.type = 'button';
+  const restart = button('bg-btn bg-btn-2', 'RESTART', 2, INK);
+  const back = button(
+      'bg-btn bg-btn-2', '‹ ' + (strings.back || 'Back to games'), 2, INK);
+  const tiny = el('div', 'bg-tiny');
+  panel.append(title, message, primary, restart, back, tiny);
+  overlay.appendChild(panel);
+
+  root.append(canvas, overlay, hud);
+  host.appendChild(root);
+
+  const layout = {cw: W, ch: H, ox: 0, oy: 0, s: 1};
+  function fit() {
+    const vw = root.clientWidth || W;
+    const vh = root.clientHeight || H;
+    const s = Math.min(vw / W, vh / H);
+    const cw = Math.ceil(vw / s);
+    const ch = Math.ceil(vh / s);
+    if (canvas.width !== cw || canvas.height !== ch) {
+      canvas.width = cw;
+      canvas.height = ch;
+    }
+    canvas.style.width = cw * s + 'px';
+    canvas.style.height = ch * s + 'px';
+    canvas.style.left = (vw - cw * s) / 2 + 'px';
+    canvas.style.top = (vh - ch * s) / 2 + 'px';
+    layout.cw = cw;
+    layout.ch = ch;
+    layout.ox = Math.floor((cw - W) / 2);
+    layout.oy = Math.floor((ch - H) / 2);
+    layout.s = s;
+    g.imageSmoothingEnabled = false;
+  }
+  const observer = new ResizeObserver(fit);
+  observer.observe(root);
+  fit();
+
+  const shown = {};
+  function set(node, key, text, size) {
+    if (shown[key] === text) {
+      return;
+    }
+    shown[key] = text;
+    setText(node, text, size, INK);
+  }
+
+  const handlers = {primary: null, pause: null, restart: null};
+  for (const [node, name] of [[primary, 'primary'], [restart, 'restart'],
+                              [pause, 'pause']]) {
+    node.addEventListener('click', () => handlers[name] && handlers[name]());
+  }
+  exit.addEventListener('click', () => opts.exit && opts.exit());
+  back.addEventListener('click', () => opts.exit && opts.exit());
+
+  return {
+    root,
+    g,
+    layout,
+    // Resets the drawing state and fills the whole canvas with sky. The
+    // caller then draws in play-area coordinates.
+    begin(sky) {
+      g.setTransform(1, 0, 0, 1, 0, 0);
+      g.fillStyle = sky || SKY;
+      g.fillRect(0, 0, layout.cw, layout.ch);
+      g.translate(layout.ox, layout.oy);
+    },
+    // Visible area in play-area coordinates.
+    view() {
+      return {x0: -layout.ox, x1: layout.cw - layout.ox,
+              y0: -layout.oy, y1: layout.ch - layout.oy};
+    },
+    score(text) { set(score, 'score', text, 3); },
+    speed(text) { set(speed, 'speed', text, 2); },
+    best(text) { set(best, 'best', text, 2); },
+    on(name, fn) { handlers[name] = fn; },
+    // Shows the centred panel. `paused` adds the restart button.
+    panel(titleText, lines, primaryText, paused, tinyText) {
+      setText(title, titleText, 4, INK);
+      setText(message, lines.join('\n'), 2, INK);
+      setText(primary, primaryText, 2, PANEL);
+      restart.hidden = !paused;
+      tiny.hidden = !tinyText;
+      if (tinyText) {
+        setText(tiny, tinyText, 1.5, INK);
+      }
+      overlay.hidden = false;
+      setText(pause, paused ? '▶' : '‖', 3, INK);
+      pause.setAttribute('aria-label', paused ? 'Resume' : 'Pause');
+      pause.hidden = !paused;
+      primary.focus({preventScroll: true});
+    },
+    hidePanel() {
+      overlay.hidden = true;
+      setText(pause, '‖', 3, INK);
+      pause.setAttribute('aria-label', 'Pause');
+      pause.hidden = false;
+      root.focus({preventScroll: true});
+    },
+    focus() {
+      if (overlay.hidden) {
+        root.focus({preventScroll: true});
+      } else {
+        primary.focus({preventScroll: true});
+      }
+    },
+    destroy() {
+      observer.disconnect();
+      root.remove();
+    },
+  };
+}
+
+window.bareGamesKit = {
+  INK, SKY, GRASS, GRASS_TOP, PANEL, setText, drawWing, drawSprite, wingSprite,
+  spriteBounds, shell,
+};
+
+const GAMES = [
+  {id: 'fly', name: 'Bare Fly', descKey: 'flyDesc'},
+  {id: 'run', name: 'Bare Run', descKey: 'runDesc'},
+  {id: 'racer', name: 'Bare Racer', descKey: 'racerDesc'},
+];
+
+// The big wing at the top of the list: a 28 x 28 pixel grid in Bare's blues.
+function logo() {
+  const c = el('canvas', 'bare-games-logo');
+  c.width = c.height = 28;
+  drawSprite(c.getContext('2d'), wingSprite(0, 0.028, 'logo', 28), 0, 0);
+  c.setAttribute('aria-hidden', 'true');
+  return c;
+}
+
+let current = null;
+let lastCard = null;
+
+function stop() {
+  if (!current) {
+    return;
+  }
+  const playing = current;
+  current = null;
+  playing.game.destroy();
+  if (document.fullscreenElement === playing.frame && document.exitFullscreen) {
+    document.exitFullscreen().catch(() => {});
+  }
+  playing.frame.remove();
+  document.documentElement.classList.remove('bare-games-playing');
+  if (lastCard && lastCard.isConnected) {
+    lastCard.focus({preventScroll: true});
+  }
+}
+
+function play(entry, card, strings) {
+  if (current) {
+    stop();
+  }
+  lastCard = card;
+  const frame = el('div', 'bare-games-full');
+  document.body.appendChild(frame);
+  document.documentElement.classList.add('bare-games-playing');
+  const game = entry.create(frame, {strings, exit: stop});
+  current = {frame, game, fullscreen: false};
+  // Full screen needs the tap that opened the game. If the page may not go
+  // full screen, the frame still covers the whole page.
+  let request = null;
+  try {
+    request = frame.requestFullscreen &&
+        frame.requestFullscreen({navigationUI: 'hide'});
+  } catch (e) {
+    request = null;
+  }
+  if (request && request.catch) {
+    request.catch(() => frame.classList.add('bare-games-nofs'));
+  } else {
+    frame.classList.add('bare-games-nofs');
+  }
+  game.focus();
+}
+
+// Leaving full screen (Back on Android, Esc on desktop) leaves the game.
+document.addEventListener('fullscreenchange', () => {
+  if (!current) {
+    return;
+  }
+  if (document.fullscreenElement === current.frame) {
+    current.fullscreen = true;
+  } else if (current.fullscreen) {
+    current.game.pause();
+    stop();
+  }
+});
+
+document.addEventListener('keydown', e => {
+  if (current && !current.fullscreen && e.key === 'Escape') {
+    stop();
+  }
+});
+
+// Never keep a game running while the page is not visible.
+function pauseCurrent() {
+  if (current) {
+    current.game.pause();
+  }
+}
+document.addEventListener('visibilitychange', () => {
+  if (document.hidden) {
+    pauseCurrent();
+  }
+});
+window.addEventListener('pagehide', pauseCurrent);
+window.addEventListener('blur', pauseCurrent);
+
+// No context menu, callout, selection or dragging on the list or in a game.
+// In a game a long press is just a held tap.
+function inGames(e) {
+  return e.target instanceof Element &&
+      !!e.target.closest('.bare-games, .bare-games-full');
+}
+for (const type of ['contextmenu', 'selectstart', 'dragstart']) {
+  document.addEventListener(type, e => {
+    if (inGames(e)) {
+      e.preventDefault();
+    }
+  }, true);
+}
+
+function mount(host, strings) {
+  if (!host || host.dataset.bareGamesMounted) {
+    return;
+  }
+  host.dataset.bareGamesMounted = 'true';
+  host.classList.add('bare-games');
+  strings = strings || {};
+
+  const list = el('section', 'bare-games-list');
+  const title = el('h2', 'bare-games-title');
+  const pick = el('p', 'bare-games-pick');
+  const cards = el('div', 'bare-games-cards');
+  list.append(logo(), title, pick, cards);
+  const grass = el('div', 'bare-games-grass');
+  host.append(list, grass);
+  setText(title, 'BARE GAMES', 4, INK);
+  setText(pick, strings.heading || 'Pick a game', 2, INK);
+
+  for (const game of GAMES) {
+    const entry = registry[game.id];
+    if (!entry) {
+      continue;
+    }
+    const card = el('button', 'bare-games-card');
+    card.type = 'button';
+    const icon = el('canvas', 'bare-games-card-icon');
+    icon.width = icon.height = 32;
+    icon.setAttribute('aria-hidden', 'true');
+    entry.icon(icon);
+    const text = el('span', 'bare-games-card-text');
+    const name = el('span', 'bare-games-card-name');
+    const hint = el('span', 'bare-games-card-hint');
+    text.append(name, hint);
+    card.append(icon, text);
+    cards.appendChild(card);
+    setText(name, game.name, 3, INK);
+    setText(hint, strings[game.descKey] || '', 2, INK);
+    card.addEventListener('click', () => play(entry, card, strings));
+  }
+}
+
+window.bareGames = {mount};
+
+function autoMount() {
+  const host = document.querySelector('[data-bare-games-auto]');
+  if (host) {
+    mount(host, host.dataset);
+  }
+}
+
+if (document.readyState === 'loading') {
+  document.addEventListener('DOMContentLoaded', autoMount);
+} else {
+  autoMount();
+}
+})();

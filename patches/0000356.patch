diff --git a/components/neterror/resources/bare_games/bare_fly.js b/components/neterror/resources/bare_games/bare_fly.js
new file mode 100644
index 00000000000..8642b8420dc
--- /dev/null
+++ b/components/neterror/resources/bare_games/bare_fly.js
@@ -0,0 +1,68 @@
+// Copyright 2026 The Bare Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Bare Fly: flap the Bare wing through the gates. Shared by the network error
+// page and chrome://games. Everything is drawn on a canvas; no network, no
+// storage. bare_games.js runs one game at a time, full screen, calls pause()
+// when the page is hidden and destroy() when the player leaves.
+(() => {
+'use strict';
+const registry = window.bareGamesRegistry || (window.bareGamesRegistry = {});
+
+registry.fly = {
+// Card picture: the game's black and white pixel wing.
+icon(c) {
+  const kit = window.bareGamesKit;
+  kit.drawSprite(c.getContext('2d'), kit.wingSprite(-0.35, 0.03, 'game', 32), 0, 0);
+},
+
+create(host, ctx) {
+const kit=window.bareGamesKit,W=400,H=240;
+const ui=kit.shell(host,{width:W,height:H,label:'Bare Fly. Tap or press space to flap.',strings:ctx.strings,exit:ctx.exit});
+const g=ui.g,L=ui.layout;
+let mode='ready',score=0,best=0,tick=0,speed=1.35,spawn=0,bird={x:85,y:115,vy:0},pipes=[],gems=[];
+const clouds=[{x:70,y:38},{x:240,y:68},{x:360,y:30}];
+const fmt=n=>String(n).padStart(5,'0');
+function intro(){ui.panel('BARE FLY',['FLAP THROUGH THE GAPS','COLLECT DIAMONDS +5','SURVIVE THE SPEED'],'▶ START GAME',false,'TAP / CLICK / SPACE')}
+function start(){mode='play';score=0;tick=0;speed=1.35;spawn=0;bird={x:85,y:115,vy:-2};pipes=[];gems=[];ui.score(fmt(0));ui.speed('1.0X');ui.hidePanel()}
+function flap(){if(mode==='ready'||mode==='dead'){start();return}if(mode==='paused'){resume();return}bird.vy=-3.35}
+function resume(){mode='play';ui.hidePanel()}
+function pause(){if(mode==='play'){mode='paused';ui.panel('PAUSED',['READY TO CONTINUE?'],'▶ RESUME',true)}else if(mode==='paused')resume()}
+function die(){if(mode!=='play')return;mode='dead';best=Math.max(best,score);ui.best('HI '+fmt(best));ui.panel('GAME OVER',['SCORE '+fmt(score),'TRY AGAIN!'],'RETRY',false,'+1 GATE · +5 DIAMOND')}
+// New gates and diamonds start just past the right edge of the screen, which
+// is further out than the play area when the screen is wider.
+function addPipe(){const gap=Math.max(74,100-Math.floor(tick/700)*4),center=65+Math.random()*110;pipes.push({x:W+10+L.ox,w:31,top:center-gap/2,bottom:center+gap/2,passed:false});if(Math.random()<.8)gems.push({x:W+25+L.ox,y:center,active:true})}
+function rect(x,y,w,h){g.fillRect(Math.round(x),Math.round(y),Math.round(w),Math.round(h))}
+function cloud(x,y){rect(x,y,24,2);rect(x+5,y-4,14,2);rect(x+8,y-6,8,2)}
+function render(){
+ ui.begin(kit.SKY);const v=ui.view(),vw=v.x1-v.x0,span=vw+80;
+ // Clouds wrap across the whole screen; taller screens get more of them above.
+ g.fillStyle='#fff';for(const cl of clouds){const x=((cl.x-tick*.12)%span+span)%span-40+v.x0;cloud(x,cl.y);for(let row=1;cl.y-row*90>v.y0;row++)cloud(((x+row*130-v.x0)%span+span)%span-40+v.x0,cl.y-row*90)}
+ g.fillStyle=kit.GRASS;rect(v.x0,H-4,vw,v.y1-H+4);g.fillStyle=kit.GRASS_TOP;rect(v.x0,H-6,vw,2);
+ const n=Math.ceil(span/53),tufts=n*53;for(let i=0;i<n;i++){const x=((i*53-tick*.6)%tufts+tufts)%tufts-15+v.x0;rect(x,H-10,15,1)}
+ // Top pipes reach up to the top of the screen.
+ for(const p of pipes){g.fillStyle=kit.INK;rect(p.x,v.y0,p.w,p.top-v.y0);rect(p.x,p.bottom,p.w,H-p.bottom-6);rect(p.x-3,p.top-6,p.w+6,6);rect(p.x-3,p.bottom,p.w+6,6);g.fillStyle=kit.PANEL;rect(p.x+5,v.y0,2,p.top-6-v.y0);rect(p.x+5,p.bottom+6,2,H-p.bottom-12)}
+ for(const gem of gems){if(!gem.active)continue;g.fillStyle=kit.INK;const x=Math.round(gem.x),y=Math.round(gem.y);rect(x-3,y-7,6,3);rect(x-6,y-4,12,8);rect(x-3,y+4,6,3);g.fillStyle='#fff';rect(x-2,y-2,3,3)}
+ kit.drawWing(g,bird.x,bird.y,Math.max(-.65,Math.min(.05,bird.vy*.07-.35)),.055);
+}
+function update(dt){if(mode==='play'){
+ tick+=dt;speed=Math.min(3.8,1.35+Math.floor(tick/550)*.16);ui.speed((speed/1.35).toFixed(1)+'X');bird.vy+=.19*dt;bird.y+=bird.vy*dt;spawn+=dt;if(spawn>Math.max(75,115-speed*7)){spawn=0;addPipe()}
+ for(const p of pipes){p.x-=speed*dt;if(!p.passed&&p.x+p.w<bird.x){p.passed=true;score++;ui.score(fmt(score))}if(bird.x+10>p.x&&bird.x-10<p.x+p.w&&(bird.y-10<p.top||bird.y+10>p.bottom))die()}
+ for(const gem of gems){gem.x-=speed*dt;if(gem.active&&Math.hypot(gem.x-bird.x,gem.y-bird.y)<15){gem.active=false;score+=5;ui.score(fmt(score))}}
+ pipes=pipes.filter(p=>p.x>-40-L.ox);gems=gems.filter(gem=>gem.x>-20-L.ox&&gem.active);if(bird.y<10-L.oy||bird.y>H-17)die()
+}render()}
+let last=0,raf=0,alive=true;function loop(t){if(!alive)return;const dt=Math.min(2,(t-last)/16.67||1);last=t;update(dt);raf=requestAnimationFrame(loop)}
+ui.on('primary',()=>{if(mode==='paused')resume();else start()});ui.on('pause',pause);ui.on('restart',start);
+ui.root.addEventListener('pointerdown',e=>{if(e.target.closest('button'))return;if(mode==='play')flap()});
+const onKey=e=>{if(e.code==='Space'&&!e.repeat&&!['INPUT','TEXTAREA','BUTTON'].includes(document.activeElement?.tagName)){e.preventDefault();flap()}};
+document.addEventListener('keydown',onKey);
+ui.score(fmt(0));ui.speed('1.0X');ui.best('HI '+fmt(0));intro();render();raf=requestAnimationFrame(loop);
+return {
+  pause(){if(mode==='play')pause()},
+  focus(){ui.focus()},
+  destroy(){alive=false;cancelAnimationFrame(raf);document.removeEventListener('keydown',onKey);ui.destroy()},
+};
+},
+};
+})();

+// Copyright 2026 The Bare Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/webui/bare_games/bare_games_ui.h"
+
+#include "chrome/browser/profiles/profile.h"
+#include "components/grit/components_resources.h"
+#include "components/strings/grit/components_strings.h"
+#include "content/public/browser/web_ui.h"
+#include "content/public/browser/web_ui_data_source.h"
+#include "ui/base/webui/resource_path.h"
+#include "ui/base/webui/web_ui_util.h"
+
+BareGamesUI::BareGamesUI(content::WebUI* web_ui)
+    : content::WebUIController(web_ui) {
+  content::WebUIDataSource* source = content::WebUIDataSource::CreateAndAdd(
+      Profile::FromWebUI(web_ui), kBareGamesHost);
+
+  static constexpr webui::LocalizedString kStrings[] = {
+      {"bareGamesPageTitle", IDS_ERRORPAGES_BARE_GAMES_PAGE_TITLE},
+      {"bareGamesHeading", IDS_ERRORPAGES_BARE_GAMES_HEADING},
+      {"bareGamesBack", IDS_ERRORPAGES_BARE_GAMES_BACK},
+      {"bareGamesFlyDesc", IDS_ERRORPAGES_BARE_GAMES_FLY_DESC},
+      {"bareGamesRunDesc", IDS_ERRORPAGES_BARE_GAMES_RUN_DESC},
+      {"bareGamesRacerDesc", IDS_ERRORPAGES_BARE_GAMES_RACER_DESC},
+  };
+  source->AddLocalizedStrings(kStrings);
+
+  // The same files the offline error page uses.
+  static constexpr webui::ResourcePath kResources[] = {
+      {"bare_games.css", IDR_BARE_GAMES_CSS},
+      {"bare_games_page.css", IDR_BARE_GAMES_PAGE_CSS},
+      {"bare_games.js", IDR_BARE_GAMES_JS},
+      {"bare_fly.js", IDR_BARE_GAMES_FLY_JS},
+      {"bare_run.js", IDR_BARE_GAMES_RUN_JS},
+      {"bare_racer.js", IDR_BARE_GAMES_RACER_JS},
+  };
+  source->AddResourcePaths(kResources);
+  source->SetDefaultResource(IDR_BARE_GAMES_HTML);
+}
+
+BareGamesUI::~BareGamesUI() = default;

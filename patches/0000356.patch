+'use strict';
+const registry = window.bareGamesRegistry || (window.bareGamesRegistry = {});
+
+const logoA=new Path2D('M 235.0 840.7 C 199.5 766.9 187.8 680.1 204.1 599.0 C 220.3 517.8 264.6 442.2 323.8 383.9 C 383.0 325.7 457.2 284.7 533.9 253.2 C 610.5 221.7 689.7 199.7 771.6 183.3 C 790.3 242.4 776.4 305.9 754.7 364.8 C 732.9 423.6 703.2 477.8 653.7 519.1 Z');const logoB=new Path2D('M 235.0 840.7 C 255.8 785.4 285.6 731.8 325.4 685.7 C 365.2 639.6 415.0 600.9 469.8 573.3 C 524.6 545.7 584.2 529.1 644.7 520.5 C 705.2 511.9 766.4 511.3 827.1 520.7 C 807.1 565.1 783.7 607.4 754.6 646.0 C 725.5 684.6 690.6 719.5 651.2 747.7 C 611.9 776.0 568.1 797.7 521.9 811.4 C 494.2 819.6 465.6 824.9 436.8 828.5 C 412.7 831.4 388.5 833.1 364.4 831.8 C 345.1 830.7 325.8 827.7 306.7 828.7 C 282.7 830.1 258.7 837.9 235.0 840.7 Z');
+
+// Cars and roadside scenery, drawn on any 2D context.
+function art(g){
+function rect(x,y,w,h,color){g.fillStyle=color;g.fillRect(Math.round(x),Math.round(y),Math.round(w),Math.round(h))}
+function logoBadge(){g.save();g.fillStyle='#173e80';g.beginPath();g.arc(0,-2,10.8,0,Math.PI*2);g.fill();g.fillStyle='#fff';g.beginPath();g.arc(0,-2,9.4,0,Math.PI*2);g.fill();g.translate(0,-2);g.scale(.024,.024);g.translate(-530,-520);g.fillStyle='#3f70f5';g.fill(logoA);g.fillStyle='#73cdfa';g.fill(logoB);g.restore()}
+function drawCar(x,y,scale,color,player=false){g.save();g.translate(Math.round(x),Math.round(y));g.scale(scale,scale);if(player){rect(-22,-4,44,16,'#1d2433');rect(-18,-21,36,23,color);rect(-14,-19,28,9,'#a5dced');rect(-23,0,8,15,'#1d1d26');rect(15,0,8,15,'#1d1d26');rect(-18,-7,36,13,'#1854ac');rect(-19,-8,38,3,'#368df3');rect(-18,4,10,5,'#ff6a69');rect(8,4,10,5,'#ff6a69');rect(-13,10,26,4,'#2876e4');rect(-6,11,12,3,'#f5e5a7');logoBadge()}else{rect(-15,-4,30,13,'#202537');rect(-12,-17,24,15,color);rect(-8,-15,16,7,'#b6e9f5');rect(-19,0,7,12,'#1d1d26');rect(12,0,7,12,'#1d1d26');rect(-13,-3,7,5,'#f5a36b');rect(6,-3,7,5,'#f5a36b');rect(-10,7,20,4,color)}g.restore()}

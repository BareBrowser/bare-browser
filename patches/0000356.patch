+// to the sides.
+function draw(){ui.begin(kit.SKY);const v=ui.view(),vw=v.x1-v.x0;if(shake>0){g.translate((Math.random()-.5)*shake,(Math.random()-.5)*shake);shake*=.85;if(shake<.3)shake=0}rect(v.x0-10,78,vw+20,32,'#b5e5f5');g.fillStyle='#f6f0bd';g.beginPath();g.arc(375,57,22,0,Math.PI*2);g.fill();g.fillStyle='#7ca3b1';g.beginPath();const hx0=Math.floor((v.x0-10)/10)*10;g.moveTo(hx0,107);for(let x=hx0;x<=v.x1+10;x+=10)g.lineTo(x,93+Math.sin(x*.028)*15+Math.sin(x*.067)*5);g.lineTo(v.x1+10,130);g.lineTo(hx0,130);g.fill();for(let y=horizon;y<v.y1+10;y+=2){const tr=(y-horizon)/(H-horizon),t=Math.min(1,tr),a=roadAt(t),band=Math.floor(dist*.025+tr*15)%2;rect(v.x0-10,y,vw+20,2,band?'#3b9b4a':'#348c43');rect(a.center-a.width-9*t,y,2*a.width+18*t,2,band?'#f6eee7':'#e26e66');rect(a.center-a.width,y,2*a.width,2,band?'#555761':'#62636c');if(band&&t>.18){rect(a.center-a.width/3-1*t,y,2*t+1,2,'#f6ebc1');rect(a.center+a.width/3-1*t,y,2*t+1,2,'#f6ebc1')}}for(let i=19;i>=0;i--){const z=((i*115-dist*.7)%2300+2300)%2300/2300,t=1-z;if(t<.08)continue;const r=roadAt(t),y=horizon+t*t*(H-horizon),size=6+t*38,side=i%2?1:-1;if(L.ox>0)for(let k=1;k<4;k++){const x=r.center+(r.width+18+10*t+k*(90+150*t))*side;if(x>v.x0-60&&x<v.x1+60)scenery(x,y,size,(i+k)%5===0?1:0)}scenery(r.center+(r.width+18+10*t)*side,y,size,i%5===0?1:0)}for(const e of traffic.slice().sort((a,b)=>b.z-a.z)){const t=1-e.z;if(t<=0||t>=1)continue;const r=roadAt(t);drawCar(r.center+e.lane*r.width*.56,horizon+t*t*(H-horizon),.2+t*1.15,e.color)}const px=W/2+carX*125;rect(px-32,H-20,64,5,'#36383c55');drawCar(px,H-29,1.6,'#2876e4',true)}
+function update(dt){if(mode==='play'){frame+=dt;speed=Math.min(340,120+frame*.042);dist+=speed*.065*dt;if(keys.left)carX-=.029*dt;if(keys.right)carX+=.029*dt;carX=Math.max(-1.5,Math.min(1.5,carX));score=Math.floor(dist/8);ui.score(fmt(score));ui.speed(Math.floor(speed)+' KM/H');spawn+=dt;if(spawn>Math.max(36,95-speed*.12)){spawn=0;traffic.push({z:1,lane:[-.72,0,.72][Math.floor(Math.random()*3)],color:['#d85253','#f4bc48','#55aa98','#9b76ce'][Math.floor(Math.random()*4)]})}for(const e of traffic){e.z-=speed*.000033*dt;if(e.z<.12&&e.z>-.02&&Math.abs(carX-e.lane*.56)<.28)crash()}traffic=traffic.filter(e=>e.z>-.1);if(Math.abs(carX)>1.18)speed=Math.max(90,speed-.6*dt)}draw()}
+let last=0,raf=0,alive=true;function loop(t){if(!alive)return;const dt=Math.min(2,(t-last)/16.67||1);last=t;update(dt);raf=requestAnimationFrame(loop)}
+// Drag to steer, relative: the car moves by as much as the finger moves
+// sideways (times DRAG, in screen pixels), from wherever the touch started,
+// and stays on the road.

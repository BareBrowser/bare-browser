+/* Copyright 2026 The Bare Authors
+ * Use of this source code is governed by a BSD-style license that can be
+ * found in the LICENSE file. */
+
+/* Game list shared by the offline error page and chrome://games, and the
+ * full-screen game frame. Text is drawn by bare_games.js in a built-in pixel
+ * font; .bg-mono is the fallback for text the font cannot draw. The colours
+ * stay the same in dark mode. */
+
+.bare-games,
+.bare-games-full {
+  --bg-ink: #0d0b1a;
+  --bg-sky: #8fd3ff;
+  --bg-grass: #3b9b4a;
+  --bg-grass-top: #2b7a37;
+  --bg-panel: #e9f7ff;
+  color: var(--bg-ink);
+}
+
+.bare-games,
+.bare-games-full,
+.bare-games canvas,
+.bare-games-full canvas {
+  -webkit-touch-callout: none;
+  user-select: none;
+  -webkit-user-select: none;
+}
+
+.bare-games {
+  background: var(--bg-sky);
+  border: 3px solid var(--bg-ink);
+  box-sizing: border-box;
+  clear: both;
+  display: flex;
+  flex-direction: column;
+  margin: 32px auto 0;
+  max-width: 600px;
+  width: 100%;
+}
+
+.bare-games *,
+.bare-games *::before,
+.bare-games *::after,
+.bare-games-full *,
+.bare-games-full *::before,
+.bare-games-full *::after {
+  box-sizing: border-box;
+}
+
+/* The error page styles plain buttons; start from browser defaults. */
+.bare-games button,
+.bare-games-full button {
+  all: revert;
+}
+
+.bare-games [hidden],
+.bare-games-full [hidden] {
+  display: none !important;
+}
+
+.bg-text {
+  display: block;
+  image-rendering: pixelated;
+}
+
+.bg-sr {
+  clip-path: inset(50%);
+  height: 1px;
+  overflow: hidden;
+  position: absolute;
+  white-space: nowrap;
+  width: 1px;
+}
+
+.bg-mono {
+  font-family: monospace;
+  font-size: calc(var(--bg-px, 2px) * 7);
+  font-weight: 900;
+  letter-spacing: 0.04em;
+  line-height: 1.3;
+  white-space: pre-line;
+}
+
+/* The list */
+.bare-games-list {
+  align-items: center;
+  display: flex;
+  flex: 1;
+  flex-direction: column;
+  padding: 24px 16px;
+}
+
+.bare-games-logo {
+  display: block;
+  height: 96px;
+  image-rendering: pixelated;
+  width: 96px;
+}
+
+.bare-games-title {
+  margin: 12px 0 0;
+}
+
+.bare-games-pick {
+  margin: 12px 0 20px;
+  text-align: center;
+}
+
+.bare-games-cards {
+  display: grid;
+  gap: 12px;
+  max-width: 420px;
+  width: 100%;
+}
+
+.bare-games .bare-games-card {
+  align-items: center;
+  background: var(--bg-panel);
+  border: 3px solid var(--bg-ink);
+  border-radius: 0;
+  color: var(--bg-ink);
+  cursor: pointer;
+  display: flex;
+  gap: 14px;
+  margin: 0;
+  padding: 10px 12px;
+  text-align: start;
+  width: 100%;
+}
+
+.bare-games .bare-games-card:hover {
+  background: #fff;
+}
+
+.bare-games .bare-games-card:active {
+  transform: translate(1px, 1px);
+}
+
+.bare-games .bare-games-card:focus-visible,
+.bare-games-full button:focus-visible {
+  outline: 3px solid #3d5af1;
+  outline-offset: 2px;
+}
+
+.bare-games-card-icon {
+  flex: none;
+  height: 64px;
+  image-rendering: pixelated;
+  width: 64px;
+}
+
+.bare-games-card-text {
+  display: flex;
+  flex-direction: column;
+  gap: 8px;
+  min-width: 0;
+}
+
+.bare-games-grass {
+  background: linear-gradient(var(--bg-grass-top) 0 4px, var(--bg-grass) 4px);
+  flex: none;
+  height: 20px;
+}
+
+/* The game frame. bare_games.js asks for full screen on it; if the page may
+ * not go full screen it still covers the whole page. */
+html.bare-games-playing,
+html.bare-games-playing body {
+  overflow: hidden;
+}
+
+.bare-games-full {
+  -webkit-tap-highlight-color: transparent;
+  background: var(--bg-sky);
+  font-family: monospace;
+  inset: 0;
+  overflow: hidden;
+  position: fixed;
+  touch-action: none;
+  user-select: none;
+  -webkit-user-select: none;
+  z-index: 2147483647;
+}
+
+.bare-games-full:fullscreen {
+  height: 100%;
+  width: 100%;
+}
+
+.bare-games-full::backdrop {
+  background: #8fd3ff;
+}
+
+.bg-game {
+  inset: 0;
+  outline: none;
+  overflow: hidden;
+  position: absolute;
+}
+
+.bg-canvas {
+  display: block;
+  image-rendering: pixelated;
+  position: absolute;
+}
+
+.bg-hud {
+  align-items: flex-start;
+  display: flex;
+  justify-content: space-between;
+  left: 0;
+  padding: max(10px, env(safe-area-inset-top))
+      max(10px, env(safe-area-inset-right)) 0
+      max(10px, env(safe-area-inset-left));
+  pointer-events: none;
+  position: absolute;
+  right: 0;
+  top: 0;
+}
+
+.bg-hud-side {
+  align-items: flex-start;
+  display: flex;
+  gap: 10px;
+}
+
+.bg-hud-right {
+  align-items: center;
+}
+
+.bg-hud-stats {
+  display: flex;
+  flex-direction: column;
+  gap: 6px;
+  padding-top: 4px;
+}
+
+.bare-games-full .bg-icon-btn {
+  align-items: center;
+  background: var(--bg-panel);
+  border: 3px solid var(--bg-ink);
+  border-radius: 0;
+  cursor: pointer;
+  display: flex;
+  height: 44px;
+  justify-content: center;
+  margin: 0;
+  padding: 0;
+  pointer-events: auto;
+  width: 44px;
+}
+
+.bg-overlay {
+  align-items: center;
+  background: rgba(13, 11, 26, 0.12);
+  display: flex;
+  inset: 0;
+  justify-content: center;
+  padding: 64px 16px 16px;
+  position: absolute;
+}
+
+.bg-panel {
+  align-items: center;
+  background: var(--bg-panel);
+  border: 3px solid var(--bg-ink);
+  display: flex;
+  flex-direction: column;
+  gap: 10px;
+  max-height: 100%;
+  max-width: 100%;
+  overflow: auto;
+  padding: 16px 20px;
+  text-align: center;
+}
+
+.bg-message {
+  margin-bottom: 4px;
+}
+
+.bare-games-full .bg-btn {
+  background: var(--bg-ink);
+  border: 3px solid var(--bg-ink);
+  border-radius: 0;
+  color: var(--bg-panel);
+  cursor: pointer;
+  display: flex;
+  justify-content: center;
+  margin: 0;
+  min-width: 200px;
+  padding: 9px 14px;
+}
+
+.bare-games-full .bg-btn-2 {
+  background: transparent;
+  color: var(--bg-ink);
+}
+
+.bg-tiny {
+  opacity: 0.65;
+}

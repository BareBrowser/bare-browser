+ui.on('primary',()=>{if(mode==='paused')resume();else start()});ui.on('pause',pause);ui.on('restart',start);
+ui.root.addEventListener('pointerdown',e=>{if(e.target.closest('button'))return;if(mode==='play')jump()});
+const onKey=e=>{if(!ui.root.contains(document.activeElement))return;if(e.target.closest&&e.target.closest('button')&&e.code==='Space')return;if(e.code==='Space'||e.code==='ArrowUp'){e.preventDefault();if(!e.repeat)jump()}};
+window.addEventListener('keydown',onKey);
+ui.score(fmt(0));ui.speed('1.0X');ui.best('HI '+fmt(0));intro();render();raf=requestAnimationFrame(loop);
+return {
+  pause(){if(mode==='play')pause()},
+  focus(){ui.focus()},
+  destroy(){alive=false;cancelAnimationFrame(raf);window.removeEventListener('keydown',onKey);ui.destroy()},
+};
+},
+};
+})();

+
+/* Page frame for chrome://games: the list fills the page, sky on top and
+ * grass along the bottom. The list itself is in bare_games.css. */
+
+html {
+  background: #8fd3ff;
+}
+
+body {
+  display: flex;
+  flex-direction: column;
+  font-family: monospace;
+  margin: 0;
+  min-height: 100vh;
+  min-height: 100dvh;
+}
+
+.bare-games-page {
+  display: flex;
+  flex: 1;
+  flex-direction: column;

+const ui=kit.shell(host,{width:W,height:H,label:'Bare Racer. Drag left or right to steer.',strings:ctx.strings,exit:ctx.exit});
+const g=ui.g,L=ui.layout,stage=ui.root,{rect,drawCar,scenery}=art(g);
+let mode='ready',score=0,best=0,frame=0,speed=120,dist=0,carX=0,traffic=[],spawn=0,shake=0;const keys={left:false,right:false},fmt=n=>String(Math.floor(n)).padStart(5,'0');

+// A playlist or manifest is a text file listing where the pieces are; saving it
+// saves nothing anyone can play. A lone segment is no better. Both are refused
+// rather than offered as a download that would disappoint.
+//
+// Assembling a segmented stream into one file is a separate job that this class
+// does not do, and media behind DRM is out of scope entirely: nothing here
+// decrypts, and nothing here goes looking for a way around an access control.
+bool IsManifestOrSegment(std::string_view mime, const GURL& url) {
+  static constexpr auto kManifestTypes = std::to_array<std::string_view>({
+      "application/vnd.apple.mpegurl",
+      "application/x-mpegurl",
+      "audio/mpegurl",
+      "audio/x-mpegurl",
+      "application/dash+xml",
+      "video/vnd.mpeg.dash.mpd",
+  });
+  for (std::string_view type : kManifestTypes) {
+    if (base::EqualsCaseInsensitiveASCII(mime, type)) {
+      return true;
+    }
+  }
+  static constexpr auto kSuffixes = std::to_array<std::string_view>({
+      ".m3u8",
+      ".mpd",
+      ".m4s",
+      ".ts",
+  });
+  const std::string_view path = url.path();
+  for (std::string_view suffix : kSuffixes) {
+    if (base::EndsWith(path, suffix, base::CompareCase::INSENSITIVE_ASCII)) {
+      return true;
+    }
+  }
+  return false;
 }
 

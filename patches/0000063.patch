@@ -61,7 +89,79 @@ BareMediaRegistry::~BareMediaRegistry() = default;
 GURL BareMediaRegistry::NormalizeForDownload(const GURL& url) {
   GURL::Replacements strip_ref;
   strip_ref.ClearRef();
-  return url.ReplaceComponents(strip_ref);
+  GURL normalized = url.ReplaceComponents(strip_ref);
+
+  if (!normalized.has_query()) {
+    return normalized;
+  }
+
+  // Adaptive players usually ask for ranges with the Range header, in which
+  // case the URL already names the whole file and there is nothing to do. Some
+  // sites put the range in the query instead, and there the URL names a slice.
+  // Only one such convention is handled, the bytestart/byteend pair, because it
+  // is the only one that has been checked end to end: with those two removed
+  // the same URL returns 200 and the full Content-Length, so what comes back is
+  // the complete file rather than the piece the player wanted. Every other
+  // parameter is left exactly as it was.
+  bool found_range = false;
+  std::string rebuilt;
+  for (net::QueryIterator it(normalized); !it.IsAtEnd(); it.Advance()) {
+    const std::string_view key = it.GetKey();
+    if (key == "bytestart" || key == "byteend") {
+      found_range = true;
+      continue;
+    }
+    if (!rebuilt.empty()) {
+      rebuilt += "&";
+    }
+    rebuilt += std::string(it.GetKey()) + "=" + std::string(it.GetValue());
+  }
+  if (!found_range) {
+    return normalized;
+  }
+
+  GURL::Replacements set_query;
+  if (rebuilt.empty()) {
+    set_query.ClearQuery();
+  } else {
+    set_query.SetQueryStr(rebuilt);
+  }
+  return normalized.ReplaceComponents(set_query);
+}
+
+const BareMediaRegistry::Candidate* BareMediaRegistry::BestVideo() const {
+  const Candidate* best = nullptr;
+  for (const Candidate& candidate : candidates_) {
+    if (!base::StartsWith(candidate.mime_type, "video/",
+                          base::CompareCase::INSENSITIVE_ASCII)) {
+      continue;
+    }
+    if (!best || candidate.size > best->size) {
+      best = &candidate;
+    }
+  }
+  return best;
+}
+
+const BareMediaRegistry::Candidate* BareMediaRegistry::BestAudioFor(
+    const Candidate& video) const {
+  // Adaptive streaming splits a video into a silent video file and a separate
+  // audio file, served from the same host. When that is what happened, the
+  // video on its own is silent, and the audio track is worth offering too.
+  const Candidate* best = nullptr;
+  for (const Candidate& candidate : candidates_) {
+    if (!base::StartsWith(candidate.mime_type, "audio/",
+                          base::CompareCase::INSENSITIVE_ASCII)) {
+      continue;
+    }
+    if (candidate.url.host() != video.url.host()) {
+      continue;
+    }
+    if (!best || candidate.size > best->size) {
+      best = &candidate;
+    }
+  }
+  return best;
 }
 

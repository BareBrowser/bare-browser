+                        choices.downloadManagerComponent);
+        if (BareUpdateCheck.getMode() == BareUpdateCheck.UpdateMode.MANUAL) {
+            choices.updateChoice = BareUpdateCheck.isReminderEnabled() ? 2 : 1;
+        }
+        return choices;
+    }

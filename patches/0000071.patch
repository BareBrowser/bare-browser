+    private static final int TOOLBAR_BOTTOM_SETTINGS = 3;
+
+    /** Reads the address bar position through both the old boolean and the current int. */
+    private static boolean readAddressBarOnTop(SharedPreferencesManager prefs, boolean fallback) {
+        try {
+            return prefs.readBoolean(ChromePreferenceKeys.TOOLBAR_TOP_ANCHORED, fallback);
+        } catch (ClassCastException e) {
+            int value = prefs.readInt(ChromePreferenceKeys.TOOLBAR_TOP_ANCHORED, -1);
+            if (value < 0) return fallback;
+            // Even values are the top positions, odd the bottom ones, per
+            // ToolbarPositionAndSource: TOP_LONG_PRESS 0, TOP_SETTINGS 1,
+            // BOTTOM_LONG_PRESS 2, BOTTOM_SETTINGS 3.
+            return value <= TOOLBAR_TOP_SETTINGS;
+        }
+    }
+
+    private static int updateValueLabel(int choice) {

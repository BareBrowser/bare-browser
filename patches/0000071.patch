+     * The update row. Its summary is the only place a manual-mode user learns anything, so it
+     * says what is known rather than staying blank: the newest release seen, or that nothing has
+     * been looked for yet.
+     */
+    private void setUpUpdateRow() {
+        Preference row = findPreference(PREF_BARE_UPDATES);
+        if (row == null) return;
+        updateRowSummary(row);
+        row.setOnPreferenceClickListener(
+                pref -> {
+                    // Opening the row is acknowledgement, whether or not they go on to update.
+                    BareUpdateCheck.clearBadge();
+                    pref.setSummary(R.string.bare_update_checking);
+                    BareUpdateCheck.checkNow(
+                            found -> {
+                                if (found == null) return;
+                                updateRowSummary(pref);
+                            });
+                    return true;
+                });
+    }
+
+    private void updateRowSummary(Preference row) {
+        String latest = BareUpdateCheck.getLatestTag();
+        if (latest == null) {
+            row.setSummary(
+                    BareUpdateCheck.getLastCheckMs() == 0
+                            ? R.string.bare_update_never_checked
+                            : R.string.bare_update_check_failed);
+            return;
+        }
+        if (BareUpdateCheck.isNewerThanCurrent(latest)) {
+            row.setSummary(getString(R.string.bare_update_available, latest));
+        } else {
+            row.setSummary(R.string.bare_update_up_to_date);
+        }
+    }
+
     private void removePreferenceIfPresent(String key) {
         Preference preference = getPreferenceScreen().findPreference(key);
         if (preference != null) getPreferenceScreen().removePreference(preference);

new file mode 100644
index 00000000000..8564980e211
--- /dev/null
+++ b/chrome/android/java/src/org/chromium/chrome/browser/bare/BareUpdateCheck.java
@@ -0,0 +1,249 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.bare;
+
+import android.content.pm.PackageManager;
+
+import androidx.annotation.IntDef;
+
+import org.chromium.base.Callback;
+import org.chromium.base.ContextUtils;
+import org.chromium.base.ThreadUtils;
+import org.chromium.base.shared_preferences.SharedPreferencesManager;
+import org.chromium.base.task.PostTask;
+import org.chromium.base.task.TaskTraits;
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.chrome.browser.preferences.ChromePreferenceKeys;
+import org.chromium.chrome.browser.preferences.ChromeSharedPreferences;
+
+import java.io.BufferedReader;
+import java.io.InputStreamReader;
+import java.net.HttpURLConnection;
+import java.net.URL;
+import java.util.concurrent.TimeUnit;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+
+/**
+ * Looks for a newer Bare release on GitHub.
+ *
+ * <p>Bare ships outside any store. Nothing else tells a user that a fix exists, so this asks.
+ * It is also the only thing in the browser that contacts a server the user did not navigate to,
+ * which is why it stays small: one plain request to a public release feed, no identifier, no
+ * version number in the request, nothing scheduled in the background. A check happens while the
+ * browser is already open and already using the network, or when the user asks for one.
+ *
+ * <p>Manual mode means manual. Nothing leaves the device until the user taps, and the weekly
+ * reminder is a local timer, not a request.
+ */
+@NullMarked
+public class BareUpdateCheck {
+    @IntDef({UpdateMode.AUTOMATIC, UpdateMode.MANUAL})
+    public @interface UpdateMode {
+        int AUTOMATIC = 0;
+        int MANUAL = 1;
+    }
+
+    /** The public release feed. No API token, no rate limit worth worrying about. */
+    private static final String RELEASES_FEED =
+            "https://github.com/Shshtwy/bare-browser/releases.atom";
+
+    /** Where a user is sent to read about and download a release. */
+    public static final String RELEASES_PAGE =
+            "https://github.com/Shshtwy/bare-browser/releases/latest";
+
+    private static final long CHECK_INTERVAL_MS = TimeUnit.DAYS.toMillis(1);
+    private static final long REMINDER_INTERVAL_MS = TimeUnit.DAYS.toMillis(7);
+    private static final int TIMEOUT_MS = 15000;
+
+    /** Matches the tag out of a feed entry link, for example .../releases/tag/v1.0.0-alpha.2 */
+    private static final Pattern TAG_IN_LINK = Pattern.compile("/releases/tag/([^\"']+)");
+
+    /** MAJOR.MINOR.PATCH with an optional -channel.N suffix, which is Bare's own scheme. */
+    private static final Pattern VERSION =
+            Pattern.compile("v?(\\d+)\\.(\\d+)\\.(\\d+)(?:-([a-z]+)\\.(\\d+))?");
+
+    private BareUpdateCheck() {}
+
+    private static SharedPreferencesManager prefs() {
+        return ChromeSharedPreferences.getInstance();
+    }
+
+    public static @UpdateMode int getMode() {
+        return prefs().readInt(ChromePreferenceKeys.BARE_UPDATE_MODE, UpdateMode.AUTOMATIC);
+    }
+
+    public static void setMode(@UpdateMode int mode) {
+        prefs().writeInt(ChromePreferenceKeys.BARE_UPDATE_MODE, mode);
+    }
+
+    public static boolean isReminderEnabled() {
+        return prefs().readBoolean(ChromePreferenceKeys.BARE_UPDATE_REMINDER, false);
+    }
+
+    public static void setReminderEnabled(boolean enabled) {
+        prefs().writeBoolean(ChromePreferenceKeys.BARE_UPDATE_REMINDER, enabled);
+    }
+
+    /** The newest tag seen, or null if no check has found one. */
+    public static @Nullable String getLatestTag() {
+        String tag = prefs().readString(ChromePreferenceKeys.BARE_UPDATE_LATEST_TAG, "");
+        return tag.isEmpty() ? null : tag;
+    }
+
+    public static long getLastCheckMs() {
+        return prefs().readLong(ChromePreferenceKeys.BARE_UPDATE_LAST_CHECK_MS, 0);
+    }
+
+    /** Whether the menu, the settings row and the update row should carry a dot. */
+    public static boolean hasBadge() {
+        return prefs().readBoolean(ChromePreferenceKeys.BARE_UPDATE_BADGE, false);
+    }
+
+    /**
+     * Called when the user opens the update row: seeing it counts, acting on it is their
+     * choice.
+     */
+    public static void clearBadge() {
+        prefs().writeBoolean(ChromePreferenceKeys.BARE_UPDATE_BADGE, false);
+    }
+
+    /**
+     * Called when the browser comes to the foreground.
+     *
+     * <p>In automatic mode this checks at most once a day. In manual mode it never touches the
+     * network; it only decides whether the weekly nudge is due.
+     */
+    public static void onBrowserForegrounded() {
+        long since = System.currentTimeMillis() - getLastCheckMs();
+        if (getMode() == UpdateMode.MANUAL) {
+            if (isReminderEnabled() && since >= REMINDER_INTERVAL_MS) {
+                prefs().writeBoolean(ChromePreferenceKeys.BARE_UPDATE_BADGE, true);
+                touchLastCheck();
+            }
+            return;
+        }
+        if (since >= CHECK_INTERVAL_MS) check(null);
+    }
+
+    /** Asks now, whatever the mode. This is what the settings row calls. */
+    public static void checkNow(Callback<Boolean> onResult) {
+        check(onResult);
+    }
+
+    private static void check(@Nullable Callback<Boolean> onResult) {
+        PostTask.postTask(
+                TaskTraits.BEST_EFFORT_MAY_BLOCK,
+                () -> {
+                    String tag = fetchLatestTag();
+                    ThreadUtils.runOnUiThread(
+                            () -> {
+                                touchLastCheck();
+                                boolean newer = tag != null && isNewerThanCurrent(tag);
+                                if (tag != null) {
+                                    prefs().writeString(
+                                            ChromePreferenceKeys.BARE_UPDATE_LATEST_TAG, tag);
+                                }
+                                if (newer) {
+                                    prefs().writeBoolean(
+                                            ChromePreferenceKeys.BARE_UPDATE_BADGE, true);
+                                }
+                                if (onResult != null) onResult.onResult(newer);
+                            });
+                });
+    }
+
+    private static void touchLastCheck() {
+        prefs().writeLong(
+                ChromePreferenceKeys.BARE_UPDATE_LAST_CHECK_MS, System.currentTimeMillis());
+    }
+
+    /**
+     * Reads the first release tag out of the feed.
+     *
+     * <p>Deliberately plain: no cookies, no cache, no identifying header, and no version of its own
+     * in the request. The server learns an address asked for a public file, which is the least this
+     * can cost while still working.
+     */
+    private static @Nullable String fetchLatestTag() {
+        HttpURLConnection connection = null;
+        try {
+            connection = (HttpURLConnection) new URL(RELEASES_FEED).openConnection();
+            connection.setConnectTimeout(TIMEOUT_MS);
+            connection.setReadTimeout(TIMEOUT_MS);
+            connection.setInstanceFollowRedirects(true);
+            connection.setUseCaches(false);
+            connection.setRequestProperty("Accept", "application/atom+xml");
+            if (connection.getResponseCode() != HttpURLConnection.HTTP_OK) return null;
+            try (BufferedReader reader =
+                    new BufferedReader(new InputStreamReader(connection.getInputStream()))) {
+                String line;
+                // The feed is newest first, so the first tag link is the latest release.
+                while ((line = reader.readLine()) != null) {
+                    Matcher matcher = TAG_IN_LINK.matcher(line);
+                    if (matcher.find()) return matcher.group(1);
+                }
+            }
+            return null;
+        } catch (Exception e) {
+            // An update check is not worth reporting to the user or crashing over.
+            return null;
+        } finally {
+            if (connection != null) connection.disconnect();
+        }
+    }
+
+    /** True when the tag names a version above the running one. */
+    public static boolean isNewerThanCurrent(String tag) {
+        String current = currentVersion();
+        return current != null && compare(tag, current) > 0;
+    }
+
+    /**
+     * Bare's own version, read from the package.
+     *
+     * <p>Not VersionConstants.PRODUCT_VERSION, which carries Chromium's version, 153.0.7999.0.
+     * Bare's version reaches the build through android_override_version_name and only ever lands
+     * in the manifest, so comparing against the Chromium constant would answer "up to date"
+     * forever.
+     */
+    private static @Nullable String currentVersion() {
+        try {
+            var context = ContextUtils.getApplicationContext();
+            return context.getPackageManager().getPackageInfo(context.getPackageName(), 0)
+                    .versionName;
+        } catch (PackageManager.NameNotFoundException e) {
+            return null;
+        }
+    }
+
+    /**
+     * Orders two versions in Bare's scheme.
+     *
+     * <p>A release with no channel suffix outranks a prerelease of the same numbers, so 1.0.0 is
+     * newer than 1.0.0-alpha.9. Anything unparseable sorts as older, which means a tag this build
+     * does not understand never presents itself as an update.
+     */
+    static int compare(String left, String right) {
+        Matcher a = VERSION.matcher(left);
+        Matcher b = VERSION.matcher(right);
+        if (!a.find()) return -1;
+        if (!b.find()) return 1;
+        for (int group = 1; group <= 3; group++) {
+            int diff =
+                    Integer.compare(
+                            Integer.parseInt(a.group(group)), Integer.parseInt(b.group(group)));
+            if (diff != 0) return diff;
+        }
+        boolean aPre = a.group(4) != null;
+        boolean bPre = b.group(4) != null;
+        if (aPre != bPre) return aPre ? -1 : 1;
+        if (!aPre) return 0;
+        int channel = a.group(4).compareTo(b.group(4));
+        if (channel != 0) return channel;
+        return Integer.compare(Integer.parseInt(a.group(5)), Integer.parseInt(b.group(5)));
+    }
+}

From: Bare <git@barebrowser.org>
Date: Sun, 8 Nov 2026 06:52:11 +0000
Subject: [PATCH] Patch 0000012

---
 .../display_cutout/DisplayCutoutController.java   | 15 +++++++++++++++
 1 file changed, 15 insertions(+)

diff --git a/components/browser_ui/display_cutout/android/java/src/org/chromium/components/browser_ui/display_cutout/DisplayCutoutController.java b/components/browser_ui/display_cutout/android/java/src/org/chromium/components/browser_ui/display_cutout/DisplayCutoutController.java
index 4ca18055922..3460effcc6d 100644
--- a/components/browser_ui/display_cutout/android/java/src/org/chromium/components/browser_ui/display_cutout/DisplayCutoutController.java
+++ b/components/browser_ui/display_cutout/android/java/src/org/chromium/components/browser_ui/display_cutout/DisplayCutoutController.java
@@ -655,6 +655,21 @@ public class DisplayCutoutController implements InsetObserver.WindowInsetObserve
         if (shouldTreatViewportFitAsCover(mViewportFit)) {
             return LayoutParams.LAYOUT_IN_DISPLAY_CUTOUT_MODE_SHORT_EDGES;
         }
+        // Fullscreen video: draw into the cutout even when the page never asked to.
+        //
+        // Reaching here means viewport-fit is AUTO - the default, which video sites
+        // rarely override. Upstream then returns DEFAULT, and on a device with a
+        // camera cutout that letterboxes the window away from the cutout edge, so
+        // fullscreen video sits off-centre: pushed down in portrait, and sideways in
+        // landscape (the same physical edge). The system bars are already hidden in
+        // HTML fullscreen, so nothing in that strip needs protecting - use the whole
+        // display, the way native video players do.
+        //
+        // An explicit viewport-fit: contain is still honoured above, so a page that
+        // deliberately avoids the cutout keeps that behaviour.
+        if (isHtmlFullscreen) {
+            return LayoutParams.LAYOUT_IN_DISPLAY_CUTOUT_MODE_SHORT_EDGES;
+        }
         return LayoutParams.LAYOUT_IN_DISPLAY_CUTOUT_MODE_DEFAULT;
     }
 

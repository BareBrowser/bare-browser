diff --git a/chrome/android/java/src/org/chromium/chrome/browser/bare/BareWhatsNewOverlay.java b/chrome/android/java/src/org/chromium/chrome/browser/bare/BareWhatsNewOverlay.java
new file mode 100644
index 00000000000..a5f675cae45
--- /dev/null
+++ b/chrome/android/java/src/org/chromium/chrome/browser/bare/BareWhatsNewOverlay.java
@@ -0,0 +1,149 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.bare;
+
+import android.app.Activity;
+import android.content.SharedPreferences;
+import android.os.Build;
+import android.view.LayoutInflater;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.LinearLayout;
+import android.widget.TextView;
+
+import androidx.core.graphics.Insets;
+import androidx.core.view.ViewCompat;
+import androidx.core.view.WindowInsetsCompat;
+
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.base.version_info.VersionInfo;
+import org.chromium.chrome.R;
+
+/**
+ * What an update shows in place of the welcome: the logo, the version, a link to what changed and
+ * Continue. It is drawn over the browser, like the welcome, and shown once for each version.
+ */
+@NullMarked
+final class BareWhatsNewOverlay {
+    private static final String KEY_WHATS_NEW_FOR_VERSION = "whats_new_for_version";
+
+    private BareWhatsNewOverlay() {}
+
+    /** Shows the screen unless this version's has already been seen. */
+    static void maybeShow(Activity activity, SharedPreferences prefs, String version) {
+        if (version.equals(prefs.getString(KEY_WHATS_NEW_FOR_VERSION, ""))) return;
+        @Nullable ViewGroup root = activity.findViewById(android.R.id.content);
+        if (root == null) return;
+
+        View overlay =
+                LayoutInflater.from(activity).inflate(R.layout.bare_whats_new_overlay, root, false);
+        // Not part of the activity's saved state, like the welcome.
+        overlay.setSaveFromParentEnabled(false);
+        TextView versionView = overlay.findViewById(R.id.bare_whats_new_version);
+        versionView.setText(version);
+
+        TextView link = overlay.findViewById(R.id.bare_whats_new_link);
+        LinearLayout list = overlay.findViewById(R.id.bare_whats_new_list);
+        int[] lines = {
+            R.string.bare_whats_new_menu_left,
+            R.string.bare_whats_new_toolbar,
+            R.string.bare_whats_new_new_tab,
+        };
+        for (int line : lines) {
+            addLine(activity, list, activity.getString(line));
+        }
+        addLine(
+                activity,
+                list,
+                activity.getString(
+                        R.string.bare_whats_new_security, VersionInfo.getProductVersion()));
+        addLine(activity, list, activity.getString(R.string.bare_whats_new_more));
+        link.setOnClickListener(
+                v -> {
+                    link.setVisibility(View.GONE);
+                    list.setAlpha(0f);
+                    list.setVisibility(View.VISIBLE);
+                    list.animate().alpha(1f).setDuration(220).start();
+                });
+
+        View[] hiddenBehind = hideBrowserBehind(root);
+        Runnable dismiss =
+                () -> {
+                    prefs.edit().putString(KEY_WHATS_NEW_FOR_VERSION, version).apply();
+                    root.removeView(overlay);
+                    for (View behind : hiddenBehind) {
+                        behind.setImportantForAccessibility(View.IMPORTANT_FOR_ACCESSIBILITY_AUTO);
+                    }
+                };
+        overlay.findViewById(R.id.bare_whats_new_continue).setOnClickListener(v -> dismiss.run());
+
+        // The browser draws edge to edge, so keep the content clear of the system bars. The
+        // insets are read from the window, as the welcome does, because the browser consumes them.
+        overlay.addOnLayoutChangeListener(
+                (view, l, t, r, b, oldL, oldT, oldR, oldB) -> {
+                    WindowInsetsCompat insets = ViewCompat.getRootWindowInsets(view);
+                    if (insets == null) return;
+                    Insets bars =
+                            insets.getInsets(
+                                    WindowInsetsCompat.Type.systemBars()
+                                            | WindowInsetsCompat.Type.displayCutout());
+                    if (view.getPaddingTop() == bars.top
+                            && view.getPaddingBottom() == bars.bottom
+                            && view.getPaddingLeft() == bars.left
+                            && view.getPaddingRight() == bars.right) {
+                        return;
+                    }
+                    view.post(() -> view.setPadding(bars.left, bars.top, bars.right, bars.bottom));
+                });
+        root.addView(overlay);
+
+        // The system splash would otherwise fade out over the screen; drop it at once.
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S) {
+            activity.getSplashScreen()
+                    .setOnExitAnimationListener(splashView -> splashView.remove());
+        }
+    }
+
+    private static void addLine(Activity activity, LinearLayout list, String text) {
+        float density = activity.getResources().getDisplayMetrics().density;
+        LinearLayout row = new LinearLayout(activity);
+        row.setOrientation(LinearLayout.HORIZONTAL);
+        row.setGravity(android.view.Gravity.TOP);
+        LinearLayout.LayoutParams rowParams =
+                new LinearLayout.LayoutParams(
+                        ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT);
+        rowParams.topMargin = Math.round(12 * density);
+        View dot = new View(activity);
+        dot.setBackgroundResource(R.drawable.bare_welcome_dot_active);
+        dot.setImportantForAccessibility(View.IMPORTANT_FOR_ACCESSIBILITY_NO);
+        LinearLayout.LayoutParams dotParams =
+                new LinearLayout.LayoutParams(Math.round(6 * density), Math.round(6 * density));
+        dotParams.topMargin = Math.round(8 * density);
+        dotParams.setMarginEnd(Math.round(14 * density));
+        row.addView(dot, dotParams);
+        TextView label = new TextView(activity);
+        label.setText(text);
+        label.setTextColor(activity.getColor(R.color.bare_welcome_body));
+        label.setTextSize(15);
+        label.setLineSpacing(0, 1.15f);
+        row.addView(
+                label,
+                new LinearLayout.LayoutParams(
+                        0, ViewGroup.LayoutParams.WRAP_CONTENT, 1f));
+        list.addView(row, rowParams);
+    }
+
+    /** Keeps a screen reader on this screen, away from the browser it covers. */
+    private static View[] hideBrowserBehind(ViewGroup root) {
+        View[] behind = new View[root.getChildCount()];
+        for (int i = 0; i < behind.length; i++) {
+            behind[i] = root.getChildAt(i);
+            behind[i].setImportantForAccessibility(
+                    View.IMPORTANT_FOR_ACCESSIBILITY_NO_HIDE_DESCENDANTS);
+        }
+        return behind;
+    }
+}

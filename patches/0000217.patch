+<!-- Shown once after an update, in place of the welcome: the logo, the version, a link to
+     what changed, and Continue. The list is filled in code. -->
+<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
+    android:id="@+id/bare_whats_new_root"
+    android:layout_width="match_parent"
+    android:layout_height="match_parent"
+    android:background="@color/bare_welcome_bg"
+    android:clickable="true"
+    android:focusable="false">
+
+    <ScrollView
+        android:layout_width="match_parent"
+        android:layout_height="match_parent"
+        android:fillViewport="true">
+
+        <LinearLayout
+            android:layout_width="match_parent"
+            android:layout_height="wrap_content"
+            android:orientation="vertical"
+            android:gravity="center_horizontal|center_vertical"
+            android:paddingStart="32dp"
+            android:paddingTop="24dp"
+            android:paddingEnd="32dp"
+            android:paddingBottom="96dp">
+
+            <org.chromium.chrome.browser.logo.BareAnimatedLogoView
+                android:layout_width="96dp"
+                android:layout_height="96dp"
+                android:importantForAccessibility="no" />
+
+            <TextView
+                android:id="@+id/bare_whats_new_title"
+                android:layout_width="wrap_content"
+                android:layout_height="wrap_content"
+                android:layout_marginTop="28dp"
+                android:accessibilityHeading="true"
+                android:text="@string/bare_whats_new_title"
+                android:textColor="@color/bare_welcome_title"
+                android:textSize="30sp"
+                android:fontFamily="sans-serif-medium" />
+
+            <TextView
+                android:id="@+id/bare_whats_new_version"
+                android:layout_width="wrap_content"
+                android:layout_height="wrap_content"
+                android:layout_marginTop="6dp"
+                android:textColor="@color/bare_welcome_body"
+                android:textSize="14sp" />
+
+            <TextView
+                android:id="@+id/bare_whats_new_link"
+                android:layout_width="wrap_content"
+                android:layout_height="wrap_content"
+                android:minHeight="48dp"
+                android:layout_marginTop="10dp"
+                android:paddingStart="16dp"
+                android:paddingEnd="16dp"
+                android:gravity="center"
+                android:background="?attr/selectableItemBackground"
+                android:clickable="true"
+                android:focusable="true"
+                android:text="@string/bare_whats_new_link"
+                android:textColor="@color/bare_welcome_accent"
+                android:textSize="15sp"
+                android:fontFamily="sans-serif-medium" />
+
+            <LinearLayout
+                android:id="@+id/bare_whats_new_list"
+                android:layout_width="match_parent"
+                android:layout_height="wrap_content"
+                android:layout_marginTop="18dp"
+                android:orientation="vertical"
+                android:visibility="gone" />
+        </LinearLayout>
+    </ScrollView>
+
+    <Button
+        android:id="@+id/bare_whats_new_continue"
+        android:layout_width="match_parent"
+        android:layout_height="wrap_content"
+        android:layout_gravity="bottom"
+        android:layout_marginStart="24dp"
+        android:layout_marginEnd="24dp"
+        android:layout_marginBottom="24dp"
+        android:minHeight="52dp"
+        android:background="@drawable/bare_welcome_button_primary"
+        android:stateListAnimator="@null"
+        android:text="@string/bare_whats_new_continue"
+        android:textAllCaps="false"
+        android:textColor="@color/bare_welcome_on_accent"
+        android:textSize="15sp"
+        android:fontFamily="sans-serif-medium" />
+</FrameLayout>

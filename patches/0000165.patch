+    @Test
+    public void testObserver_AmoledWhenSystemDark() {
+        ChromeSharedPreferences.getInstance().writeInt(UI_THEME_SETTING, ThemeType.SYSTEM_DEFAULT);
+        setSystemNightMode(true);
+        mGlobalNightModeStateController.addObserver(mObserver);
+
+        // Night mode stays on, but the surfaces change, so observers still have to re-theme.
+        ChromeSharedPreferences.getInstance().writeBoolean(BARE_AMOLED_WHEN_SYSTEM_DARK, true);
+        assertTrue(mGlobalNightModeStateController.isInNightMode());
+        verify(mObserver, times(1)).onNightModeStateChanged();
+
+        // With the system light the setting has nothing to apply to, and night mode goes off.
+        setSystemNightMode(false);
+        assertFalse(mGlobalNightModeStateController.isInNightMode());
+        verify(mObserver, times(2)).onNightModeStateChanged();
+
+        // Flipping it while the system is light changes nothing anyone can see.
+        ChromeSharedPreferences.getInstance().writeBoolean(BARE_AMOLED_WHEN_SYSTEM_DARK, false);
+        verify(mObserver, times(2)).onNightModeStateChanged();
+    }

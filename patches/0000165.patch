 package org.chromium.chrome.browser.night_mode;
 
+import static org.chromium.chrome.browser.preferences.ChromePreferenceKeys.BARE_AMOLED_WHEN_SYSTEM_DARK;
 import static org.chromium.chrome.browser.preferences.ChromePreferenceKeys.UI_THEME_SETTING;
 
 import android.app.Activity;
@@ -102,12 +103,27 @@ public class NightModeUtils {
         wrapper.applyOverrideConfiguration(config);
         // After applyOverrideConfiguration: touching getTheme() earlier creates the
         // resources, and applyOverrideConfiguration throws once they exist.
-        if (getThemeSetting() == ThemeType.DARK_AMOLED) {
+        if (isAmoledActive(nightMode)) {
             wrapper.getTheme().applyStyle(R.style.ThemeOverlay_BrowserUI_Amoled, true);
         }
         return wrapper;
     }
 
+    /**
+     * Whether the flat dark surfaces should be true black. That is the Dark AMOLED theme, or the
+     * System default theme while the system is dark and the user has asked for black there.
+     *
+     * @param nightMode Whether the app is in night mode.
+     */
+    public static boolean isAmoledActive(boolean nightMode) {
+        int theme = getThemeSetting();
+        if (theme == ThemeType.DARK_AMOLED) return true;
+        return theme == ThemeType.SYSTEM_DEFAULT
+                && nightMode
+                && ChromeSharedPreferences.getInstance()
+                        .readBoolean(BARE_AMOLED_WHEN_SYSTEM_DARK, false);
+    }

 import java.util.HashSet;
 
 /** Unit tests for {@link NightModeUtils}. */
 @RunWith(BaseRobolectricTestRunner.class)
 public class NightModeUtilsTest {
+    @After
+    public void tearDown() {
+        ChromeSharedPreferences.getInstance().removeKey(UI_THEME_SETTING);
+        ChromeSharedPreferences.getInstance().removeKey(BARE_AMOLED_WHEN_SYSTEM_DARK);
+    }
+
+    @Test
+    public void testAmoledActive_DarkAmoledThemeAlways() {
+        ChromeSharedPreferences.getInstance().writeInt(UI_THEME_SETTING, ThemeType.DARK_AMOLED);
+        assertTrue(NightModeUtils.isAmoledActive(true));
+    }
+
+    @Test
+    public void testAmoledActive_SystemDefaultNeedsSwitchAndDarkSystem() {
+        ChromeSharedPreferences.getInstance().writeInt(UI_THEME_SETTING, ThemeType.SYSTEM_DEFAULT);
+        assertFalse(NightModeUtils.isAmoledActive(true));
+
+        ChromeSharedPreferences.getInstance().writeBoolean(BARE_AMOLED_WHEN_SYSTEM_DARK, true);
+        assertTrue(NightModeUtils.isAmoledActive(true));
+        assertFalse(NightModeUtils.isAmoledActive(false));
+    }
+
+    @Test
+    public void testAmoledActive_SwitchDoesNotAffectOtherThemes() {
+        ChromeSharedPreferences.getInstance().writeBoolean(BARE_AMOLED_WHEN_SYSTEM_DARK, true);
+        ChromeSharedPreferences.getInstance().writeInt(UI_THEME_SETTING, ThemeType.DARK);
+        assertFalse(NightModeUtils.isAmoledActive(true));
+        ChromeSharedPreferences.getInstance().writeInt(UI_THEME_SETTING, ThemeType.LIGHT);
+        assertFalse(NightModeUtils.isAmoledActive(false));
+    }
 
     @Test
     public void testThemeSettingTitles() {

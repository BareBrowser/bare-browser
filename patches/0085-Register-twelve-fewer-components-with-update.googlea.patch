+  // the set.
+  //
+  // Trust tokens, private verification tokens, First-Party Sets and the Privacy
+  // Sandbox attestations are all Privacy Sandbox plumbing. Without attestations
+  // the Sandbox APIs stay off, which is the wanted answer here.
+  //
+  // HistorySearchStrings feeds HistoryEmbeddingsService, the on-device AI history
+  // search, which this build does not offer.
   RegisterActorSafetyListsComponent(cus, base::OnceClosure());
-  if (history_embeddings::IsHistoryEmbeddingsFeatureEnabled()) {
-    RegisterHistorySearchStringsComponent(cus);
-  }

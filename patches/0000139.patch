+++ b/chrome/browser/extensions/api/tab_groups/tab_groups_api.cc
@@ -146,9 +146,12 @@ ExtensionFunction::ResponseAction TabGroupsQueryFunction::Run() {
           return true;
         }
 
-        if (!BrowserExtensionWindowController::From(browser_window_interface)
-                 ->IsVisibleToTabsAPIForExtension(
-                     extension(), /*allow_dev_tools_windows=*/false)) {
+        // Bare: skip a window without a controller rather than reading
+        // through null (crbug.com/501003339).
+        WindowController* controller =
+            BrowserExtensionWindowController::From(browser_window_interface);
+        if (!controller || !controller->IsVisibleToTabsAPIForExtension(
+                               extension(), /*allow_dev_tools_windows=*/false)) {
           return true;
         }
 
diff --git a/chrome/browser/extensions/api/tabs/tabs_api.cc b/chrome/browser/extensions/api/tabs/tabs_api.cc
index 8599fed2dfb..cace283ac02 100644
--- a/chrome/browser/extensions/api/tabs/tabs_api.cc
+++ b/chrome/browser/extensions/api/tabs/tabs_api.cc
@@ -939,9 +939,12 @@ ExtensionFunction::ResponseAction WindowsGetLastFocusedFunction::Run() {
   BrowserWindowInterface* last_focused_browser = nullptr;
   ForEachCurrentBrowserWindowInterfaceOrderedByActivation(
       [&](BrowserWindowInterface* browser) {
-        if (windows_util::CanOperateOnWindow(
-                this, BrowserExtensionWindowController::From(browser),
-                extractor.type_filters())) {
+        // Bare: some browser windows have no controller (crbug.com/501003339),
+        // as the query further down already allows for.
+        WindowController* controller =
+            BrowserExtensionWindowController::From(browser);
+        if (controller && windows_util::CanOperateOnWindow(
+                              this, controller, extractor.type_filters())) {
           last_focused_browser = browser;
           return false;  // Stop iterating.
         }

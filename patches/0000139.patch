@@ -303,6 +303,8 @@ import org.chromium.chrome.browser.tabmodel.ChromeTabCreator;
 import org.chromium.chrome.browser.tabmodel.IncognitoTabHost;
 import org.chromium.chrome.browser.tabmodel.IncognitoTabHostRegistry;
 import org.chromium.chrome.browser.tabmodel.IncognitoTabHostUtils;
+import org.chromium.chrome.browser.tabmodel.IncognitoTabModel;
+import org.chromium.chrome.browser.tabmodel.IncognitoTabModelObserver;
 import org.chromium.chrome.browser.tabmodel.MismatchedIndicesHandler;
 import org.chromium.chrome.browser.tabmodel.MultiTabMetadata;
 import org.chromium.chrome.browser.tabmodel.NextTabPolicy.NextTabPolicySupplier;
@@ -363,6 +365,8 @@ import org.chromium.chrome.browser.ui.browser_window.ChromeAndroidTaskFeatureKey
 import org.chromium.chrome.browser.ui.default_browser_promo.DefaultBrowserPromoUtils;
 import org.chromium.chrome.browser.ui.edge_to_edge.EdgeToEdgeUtils;
 import org.chromium.chrome.browser.ui.edge_to_edge.TransitiveTopInsetProvider;
+import org.chromium.chrome.browser.ui.extensions.windowing.ExtensionWindowControllerBridge;
+import org.chromium.chrome.browser.ui.extensions.windowing.ExtensionWindowControllerBridgeFactory;
 import org.chromium.chrome.browser.ui.searchactivityutils.SearchActivityClient;
 import org.chromium.chrome.browser.ui.searchactivityutils.SearchActivityExtras.IntentOrigin;
 import org.chromium.chrome.browser.ui.searchactivityutils.SearchActivityExtras.ResolutionType;
@@ -1061,6 +1065,51 @@ public class ChromeTabbedActivity extends ChromeActivity implements PreAttachInt
                         /* profile= */ null,
                         /* activityWindowAndroid= */ null),
                 () -> TabbedWindowStateTracker.create(mWindowId));
+
+        // Bare: on a phone, incognito tabs open in this activity, and the incognito tab model gets
+        // a browser window of its own. The features above are added for the regular profile only,
+        // so that window had no extension window controller: an extension's incognito instance
+        // calling chrome.windows.getLastFocused() crashed the browser on a null controller, and the
+        // tabs API could not find the incognito tab. An activity that is incognito by itself
+        // already has one from the call above.
+        if (!profile.isOffTheRecord()) {
+            addIncognitoExtensionWindowController(chromeAndroidTask, activityWindowAndroid);
+        }
+    }
+
+    private void addIncognitoExtensionWindowController(
+            ChromeAndroidTask chromeAndroidTask, ActivityWindowAndroid activityWindowAndroid) {
+        TabModel model = getTabModelSelector().getModel(/* incognito= */ true);
+        if (!(model instanceof IncognitoTabModel)) return;
+        IncognitoTabModel incognitoModel = (IncognitoTabModel) model;
+        Runnable add =
+                () -> {
+                    Profile incognitoProfile = incognitoModel.getProfile();
+                    if (incognitoProfile == null
+                            || chromeAndroidTask.getNativeBrowserWindowPtr(incognitoProfile, this)
+                                    == 0) {
+                        return;
+                    }
+                    // Keyed on the tab model, so the task removes it when the model empties and
+                    // its browser window goes.
+                    chromeAndroidTask.addFeature(
+                            new ChromeAndroidTaskFeatureKey(
+                                    ExtensionWindowControllerBridge.class,
+                                    incognitoProfile,
+                                    activityWindowAndroid,
+                                    incognitoModel),
+                            ExtensionWindowControllerBridgeFactory::create);
+                };
+        // The task's own observer was added first, and it is the one that creates the browser
+        // window.
+        incognitoModel.addIncognitoObserver(
+                new IncognitoTabModelObserver() {
+                    @Override
+                    public void onIncognitoModelCreated() {
+                        add.run();
+                    }
+                });
+        add.run();
     }
 
     boolean shouldRemoveWindowWithZeroTabs(@TabClosingSource int closingSource) {
diff --git a/chrome/android/java/src/org/chromium/chrome/browser/app/ChromeActivity.java b/chrome/android/java/src/org/chromium/chrome/browser/app/ChromeActivity.java
index 9167f52a01f..37593a4d0fe 100644
--- a/chrome/android/java/src/org/chromium/chrome/browser/app/ChromeActivity.java
+++ b/chrome/android/java/src/org/chromium/chrome/browser/app/ChromeActivity.java
@@ -1185,6 +1185,19 @@ public abstract class ChromeActivity extends AsyncInitializationActivity
             // TODO(crbug.com/491791326): Handle multiple profiles for mobile.
             Profile profile = tabModelSelector.getCurrentModel().getProfile();
             assert profile != null;
+            // Bare: an activity restored with incognito selected still has its regular browser
+            // window, and the windowing features belong to that one. Taking the current model's
+            // profile here left the regular window without an extension window controller, so
+            // chrome.windows.getLastFocused() from a regular extension context read through null.
+            // An activity that is incognito by itself has no regular window and keeps its profile.
+            if (profile.isOffTheRecord()) {
+                Profile regularProfile =
+                        tabModelSelector.getModel(/* incognito= */ false).getProfile();
+                if (regularProfile != null
+                        && chromeAndroidTask.getNativeBrowserWindowPtr(regularProfile, this) != 0) {
+                    profile = regularProfile;
+                }
+            }
             addWindowingFeatures(chromeAndroidTask, profile, activityWindowAndroid);
 
             // 4. Make the ChromeAndroidTask available via OneshotSupplier.
diff --git a/chrome/android/java/src/org/chromium/chrome/browser/toolbar/ToolbarManager.java b/chrome/android/java/src/org/chromium/chrome/browser/toolbar/ToolbarManager.java
index 2253f79a627..0a84b311405 100644
--- a/chrome/android/java/src/org/chromium/chrome/browser/toolbar/ToolbarManager.java
+++ b/chrome/android/java/src/org/chromium/chrome/browser/toolbar/ToolbarManager.java
@@ -2814,8 +2814,16 @@ public class ToolbarManager
             ChromeAndroidTask task = mChromeAndroidTaskSupplier.get();
             // ChromeAndroidTask is available only on Desktop Android.
             if (task != null) {
-                Profile tabModelProfile =
+                Profile currentModelProfile =
                         assertNonNull(mTabModelSelector.getCurrentModel().getProfile());
+                // Bare: the same applies to the extensions toolbar. Built for the incognito profile
+                // after an incognito restore, it answered every regular tab with the hidden
+                // incognito one. Use the regular profile whenever this activity has its window.
+                Profile tabModelProfile =
+                        currentModelProfile.isOffTheRecord()
+                                        && task.getNativeBrowserWindowPtr(profile, mActivity) != 0
+                                ? profile
+                                : currentModelProfile;
                 // Register as an Activity-scoped feature of {@link ChromeAndroidTask}. This ensures
                 // its C++ UnownedUserData objects are destroyed prior to the host (BWI) when a
                 // Profile is destroyed on mobile Android. Explicit destruction in
diff --git a/chrome/browser/extensions/api/tab_groups/tab_groups_api.cc b/chrome/browser/extensions/api/tab_groups/tab_groups_api.cc
index fb4007c635c..6f7127e8a65 100644
--- a/chrome/browser/extensions/api/tab_groups/tab_groups_api.cc
+++ b/chrome/browser/extensions/api/tab_groups/tab_groups_api.cc
@@ -146,9 +146,12 @@ ExtensionFunction::ResponseAction TabGroupsQueryFunction::Run() {
           return true;
         }
 
-        if (!BrowserExtensionWindowController::From(browser_window_interface)
-                 ->IsVisibleToTabsAPIForExtension(
-                     extension(), /*allow_dev_tools_windows=*/false)) {
+        // Bare: skip a window without a controller rather than reading
+        // through null (crbug.com/501003339).
+        WindowController* controller =
+            BrowserExtensionWindowController::From(browser_window_interface);
+        if (!controller || !controller->IsVisibleToTabsAPIForExtension(
+                               extension(), /*allow_dev_tools_windows=*/false)) {
           return true;
         }
 
diff --git a/chrome/browser/extensions/api/tabs/windows_api.cc b/chrome/browser/extensions/api/tabs/windows_api.cc
index f61a28afe90..2e55c2d9f71 100644
--- a/chrome/browser/extensions/api/tabs/windows_api.cc
+++ b/chrome/browser/extensions/api/tabs/windows_api.cc
@@ -455,9 +455,12 @@ ExtensionFunction::ResponseAction WindowsGetLastFocusedFunction::Run() {
   BrowserWindowInterface* last_focused_browser = nullptr;
   ForEachCurrentBrowserWindowInterfaceOrderedByActivation(
       [&](BrowserWindowInterface* browser) {
-        if (windows_util::CanOperateOnWindow(
-                this, BrowserExtensionWindowController::From(browser),
-                extractor.type_filters())) {
+        // Bare: some browser windows have no controller (crbug.com/501003339),
+        // as the query further down already allows for.
+        WindowController* controller =
+            BrowserExtensionWindowController::From(browser);
+        if (controller && windows_util::CanOperateOnWindow(
+                              this, controller, extractor.type_filters())) {
           last_focused_browser = browser;
           return false;  // Stop iterating.
         }

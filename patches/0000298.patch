+    /**
+     * Keeps the status bar transparent over the status bar top control, matches its icons to the
+     * page, and hides it while the top controls are scrolled away.
+     */
+    private void applyBareStatusBar(@ColorInt int themeColor, boolean forceLightIcons) {
+        @ColorInt int behind = themeColor;
+        if (mCurrentTab != null) {
+            @ColorInt
+            int pageColor =
+                    org.chromium.chrome.browser.theme.ThemeUtils.getBackgroundColor(mCurrentTab);
+            if (Color.alpha(pageColor) == 255) behind = pageColor;
+        }
+        // Alpha 1 draws nothing but keeps the RGB that the icon color is computed from, also when
+        // the edge-to-edge layout re-applies it after an inset change.
+        @ColorInt int nearlyClear = (behind & 0x00FFFFFF) | 0x01000000;
+        setStatusBarColor(mEdgeToEdgeSystemBarColorHelper, mActivity, nearlyClear, forceLightIcons);
+        mWindow.setStatusBarColor(Color.TRANSPARENT);
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.Q) {
+            mWindow.setStatusBarContrastEnforced(false);
+        }
+        UiUtils.setStatusBarIconColor(
+                mWindow.getDecorView().getRootView(),
+                !forceLightIcons && !ColorUtils.shouldUseLightForegroundOnBackground(behind));
+        setBareSystemStatusBarHidden(mBareStatusHidden);
+    }
+
+    private void setBareSystemStatusBarHidden(boolean hide) {
+        if (hide != mBareStatusHiddenApplied) {
+            mBareStatusHiddenApplied = hide;
+            View decor = mWindow.getDecorView();
+            decor.post(
+                    () -> {
+                        WindowInsetsController controller = decor.getWindowInsetsController();
+                        if (controller == null) return;
+                        controller.setSystemBarsBehavior(
+                                WindowInsetsController.BEHAVIOR_SHOW_TRANSIENT_BARS_BY_SWIPE);
+                        if (hide) {
+                            controller.hide(WindowInsets.Type.statusBars());
+                        } else {
+                            controller.show(WindowInsets.Type.statusBars());
+                        }
+                    });
+        }
+    }

+    /** Lets the first list in a settings page scroll behind the navigation bar and clear it. */
+    private static void padListForNavigationBar(View root) {
+        androidx.recyclerview.widget.RecyclerView list = findFirstList(root);
+        if (list == null || list.getTag(R.id.settings_content) != null) return;
+        list.setTag(R.id.settings_content, Boolean.TRUE);
+        int basePadding = list.getPaddingBottom();
+        list.setClipToPadding(false);
+        androidx.core.view.ViewCompat.setOnApplyWindowInsetsListener(
+                list,
+                (view, insets) -> {
+                    int navBar =
+                            insets.getInsets(
+                                            androidx.core.view.WindowInsetsCompat.Type
+                                                    .navigationBars())
+                                    .bottom;
+                    view.setPadding(
+                            view.getPaddingLeft(),
+                            view.getPaddingTop(),
+                            view.getPaddingRight(),
+                            basePadding + navBar);
+                    return insets;
+                });
+        androidx.core.view.ViewCompat.requestApplyInsets(list);
+    }
+
+    private static androidx.recyclerview.widget.@Nullable RecyclerView findFirstList(View view) {
+        if (view instanceof androidx.recyclerview.widget.RecyclerView list) return list;
+        if (!(view instanceof ViewGroup group)) return null;
+        for (int i = 0; i < group.getChildCount(); i++) {
+            androidx.recyclerview.widget.RecyclerView list = findFirstList(group.getChildAt(i));
+            if (list != null) return list;
+        }
+        return null;
+    }
+
     private boolean isForMainSettings() {
         return getIntent().getStringExtra(EXTRA_SHOW_FRAGMENT) == null;
     }

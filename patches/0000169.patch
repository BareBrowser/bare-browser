+                BareToolbarSwipeAction.SWITCH_TABS,
+            };
+            List<CharSequence> labels = new ArrayList<>();
+            int selected = 0;
+            for (int i = 0; i < actions.length; i++) {
+                labels.add(barSwipeLabel(actions[i]));
+                if (actions[i] == mChoices.barSwipe) selected = i;
+            }
+            showChooser(
+                    R.string.bare_welcome_opt_bar_swipe,
+                    labels,
+                    selected,
+                    index -> {
+                        mChoices.barSwipe = actions[index];
+                        value.setText(barSwipeLabel(mChoices.barSwipe));
+                        saveDraft();
+                    });
+        }

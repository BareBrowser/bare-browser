+         * <p>Choosing the action the other button already has swaps them, the same as the toolbar
+         * settings do, so the bar never shows one action twice.
+         */
+        private void chooseButton(@BareToolbarSlot int slot) {
+            @ActionId int[] catalogue = BareToolbarDefaults.CATALOGUE;
+            List<CharSequence> labels = new ArrayList<>();
+            @ActionId int current = slot == BareToolbarSlot.HOME ? mChoices.firstButton : mChoices.secondButton;
+            int selected = 0;
+            for (int i = 0; i < catalogue.length; i++) {
+                labels.add(buttonLabel(catalogue[i]));
+                if (catalogue[i] == current) selected = i;
+            }
+            showChooser(
+                    slot == BareToolbarSlot.HOME
+                            ? R.string.bare_welcome_opt_first_button
+                            : R.string.bare_welcome_opt_second_button,
+                    labels,
+                    selected,
+                    index -> {
+                        @ActionId int chosen = catalogue[index];
+                        if (slot == BareToolbarSlot.HOME) {
+                            if (chosen == mChoices.secondButton) {
+                                mChoices.secondButton = mChoices.firstButton;
+                            }
+                            mChoices.firstButton = chosen;
+                        } else {
+                            if (chosen == mChoices.firstButton) {
+                                mChoices.firstButton = mChoices.secondButton;
+                            }
+                            mChoices.secondButton = chosen;
+                        }
+                        mChoices.buttonsTouched = true;
+                        if (mFirstButtonValue != null) {
+                            mFirstButtonValue.setText(buttonLabel(mChoices.firstButton));
+                        }
+                        if (mSecondButtonValue != null) {
+                            mSecondButtonValue.setText(buttonLabel(mChoices.secondButton));
+                        }
+                        saveDraft();
+                    });
+        }

+
+package org.chromium.chrome.browser.bare;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+
+import org.junit.After;
+import org.junit.Before;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+
+import org.chromium.base.test.BaseRobolectricTestRunner;
+import org.chromium.chrome.browser.preferences.ChromePreferenceKeys;
+import org.chromium.chrome.browser.preferences.ChromeSharedPreferences;
+import org.chromium.chrome.browser.ui.actions.ActionId;
+import org.chromium.chrome.browser.ui.bottombar.BareToolbarLayout;
+import org.chromium.chrome.browser.ui.bottombar.BareToolbarPrefs;
+import org.chromium.chrome.browser.ui.bottombar.BareToolbarSlot;
+import org.chromium.chrome.browser.ui.bottombar.BareToolbarSwipeAction;
+import org.chromium.chrome.browser.ui.bottombar.BareToolbarSwipePrefs;
+
+/** Unit tests for the toolbar choices on the welcome's toolbar page. */
+@RunWith(BaseRobolectricTestRunner.class)
+public class BareWelcomeToolbarChoicesUnitTest {
+    @Before
+    public void setUp() {
+        reset();
+    }
+
+    @After
+    public void tearDown() {
+        reset();
+    }
+
+    private static void reset() {
+        BareToolbarPrefs.resetAll();
+        BareToolbarSwipePrefs.setAction(BareToolbarSwipeAction.OFF);
+        ChromeSharedPreferences.getInstance().removeKey(ChromePreferenceKeys.BARE_MINIMAL_LAYOUT);
+        ChromeSharedPreferences.getInstance()
+                .removeKey(ChromePreferenceKeys.BARE_ADDRESS_BAR_SWIPE_TABS);
+    }
+
+    @Test
+    public void testAFreshProfileStartsOnTheShippedArrangement() {
+        BareWelcomeOverlay.Choices choices = BareWelcomeOverlay.currentChoices(false);
+        assertFalse(choices.minimalLayout);
+        assertEquals(ActionId.HOME_BUTTON, choices.firstButton);
+        assertEquals(ActionId.INCOGNITO, choices.secondButton);
+        assertTrue(choices.addressBarSwipe);
+        assertEquals(BareToolbarSwipeAction.OFF, choices.barSwipe);
+    }
+
+    @Test
+    public void testAReviewShowsWhatTheUserAlreadyHas() {
+        BareToolbarPrefs.setPrimaryAction(BareToolbarSlot.HOME, ActionId.FIND_IN_PAGE);
+        BareToolbarPrefs.setPrimaryAction(BareToolbarSlot.EXTRA, ActionId.SEARCH);
+        BareToolbarSwipePrefs.setAction(BareToolbarSwipeAction.SWITCH_TABS);
+        ChromeSharedPreferences.getInstance()
+                .writeBoolean(ChromePreferenceKeys.BARE_ADDRESS_BAR_SWIPE_TABS, false);
+
+        BareWelcomeOverlay.Choices choices = BareWelcomeOverlay.currentChoices(true);
+        assertEquals(ActionId.FIND_IN_PAGE, choices.firstButton);
+        assertEquals(ActionId.SEARCH, choices.secondButton);
+        assertEquals(BareToolbarSwipeAction.SWITCH_TABS, choices.barSwipe);
+        assertFalse(choices.addressBarSwipe);
+    }
+
+    @Test
+    public void testStartWritesTheSwipeAndLayoutChoices() {
+        BareWelcomeOverlay.Choices choices = BareWelcomeOverlay.currentChoices(false);
+        choices.minimalLayout = true;
+        choices.addressBarSwipe = false;
+        choices.barSwipe = BareToolbarSwipeAction.SWITCH_TABS;
+        BareWelcomeOverlay.applyChoices(choices);
+
+        assertTrue(
+                ChromeSharedPreferences.getInstance()
+                        .readBoolean(ChromePreferenceKeys.BARE_MINIMAL_LAYOUT, false));
+        assertFalse(BareToolbarSwipePrefs.isAddressBarSwipeEnabled());
+        assertEquals(BareToolbarSwipeAction.SWITCH_TABS, BareToolbarSwipePrefs.getAction());
+    }
+
+    @Test
+    public void testUntouchedButtonsStayTheAbsenceOfAPreference() {
+        BareWelcomeOverlay.Choices choices = BareWelcomeOverlay.currentChoices(false);
+        BareWelcomeOverlay.applyChoices(choices);
+        assertFalse(BareToolbarPrefs.hasPrimaryAction(BareToolbarSlot.HOME));
+        assertFalse(BareToolbarPrefs.hasPrimaryAction(BareToolbarSlot.EXTRA));
+    }
+
+    @Test
+    public void testChosenButtonsAreStored() {
+        BareWelcomeOverlay.Choices choices = BareWelcomeOverlay.currentChoices(false);
+        choices.firstButton = ActionId.SEARCH;
+        choices.secondButton = ActionId.HOME_BUTTON;
+        choices.buttonsTouched = true;
+        BareWelcomeOverlay.applyChoices(choices);
+        assertEquals(ActionId.SEARCH, BareToolbarLayout.actionForSlot(BareToolbarSlot.HOME));
+        assertEquals(ActionId.HOME_BUTTON, BareToolbarLayout.actionForSlot(BareToolbarSlot.EXTRA));
+    }
+}

From a90a7b28242d3f909268fab9c92b851b51d5300e Mon Sep 17 00:00:00 2001
From: Bare <git@barebrowser.org>
Date: Tue, 13 Oct 2026 00:42:18 +0000
Subject: [PATCH] Do not flag the bundled uBlock Origin as being of unknown
 origin

Chromium's extension safety check warns about any packed extension that
does not update from the Chrome Web Store. The store no longer serves
uBlock Origin, so since 1.75.0 Bare ships the author's own build, which
updates from the author's release feed. Every profile was told that Bare
"can't verify where this extension comes from" about the blocker Bare
itself installed. Bare has no store API key, so the check had nothing
else to go on.

Skip that one check for an extension that Bare's own provider installed
and still offers. The provider names the id, and Chromium refuses a crx
for that id unless it is signed with the key the id comes from, both at
install and on update. A copy of uBlock Origin installed any other way,
an unpacked one, and every other extension still get the warning. The
Source line still reads "Not from Chrome Web Store", and Remove works as
before.
---
 .../bare_bundled_extensions_loader.cc         | 30 +++++++++++++++++++
 .../bare_bundled_extensions_loader.h          | 17 +++++++++++
 .../extension_safety_check_utils.cc           | 16 ++++++++++
 .../extensions/external_provider_impl.cc      |  1 +
 4 files changed, 64 insertions(+)

diff --git a/chrome/browser/extensions/bare_bundled_extensions_loader.cc b/chrome/browser/extensions/bare_bundled_extensions_loader.cc
index 8c53ace8bf0..52922927797 100644
--- a/chrome/browser/extensions/bare_bundled_extensions_loader.cc
+++ b/chrome/browser/extensions/bare_bundled_extensions_loader.cc
@@ -3,6 +3,7 @@
 // found in the LICENSE file.
 
 #include "base/memory/raw_ptr.h"
+#include "base/supports_user_data.h"
 #include "base/scoped_observation.h"
 #include "base/task/single_thread_task_runner.h"
 #include "chrome/browser/extensions/extension_util.h"
@@ -541,4 +542,33 @@ void BareBundledExtensionsLoader::OnPrefsBuilt(base::DictValue prefs) {
   LoadFinished(std::move(prefs));
 }
 
+namespace {
+
+const char kLoaderKey[] = "BareBundledExtensionsLoader";
+
+struct LoaderHolder : public base::SupportsUserData::Data {
+  explicit LoaderHolder(scoped_refptr<BareBundledExtensionsLoader> loader)
+      : loader(std::move(loader)) {}
+  scoped_refptr<BareBundledExtensionsLoader> loader;
+};
+
+}  // namespace
+
+void RememberBundledExtensionsLoader(
+    Profile* profile,
+    scoped_refptr<BareBundledExtensionsLoader> loader) {
+  profile->SetUserData(kLoaderKey,
+                       std::make_unique<LoaderHolder>(std::move(loader)));
+}
+
+bool IsProvisionedByBare(content::BrowserContext* context,
+                         const Extension& extension) {
+  if (extension.location() != mojom::ManifestLocation::kExternalPref) {
+    return false;
+  }
+  const auto* holder =
+      static_cast<const LoaderHolder*>(context->GetUserData(kLoaderKey));
+  return holder && holder->loader->ClaimsExtension(extension.id());
+}
+
 }  // namespace extensions
diff --git a/chrome/browser/extensions/bare_bundled_extensions_loader.h b/chrome/browser/extensions/bare_bundled_extensions_loader.h
index aa5166a3aca..4cdb650c7fb 100644
--- a/chrome/browser/extensions/bare_bundled_extensions_loader.h
+++ b/chrome/browser/extensions/bare_bundled_extensions_loader.h
@@ -5,6 +5,7 @@
 #ifndef CHROME_BROWSER_EXTENSIONS_BARE_BUNDLED_EXTENSIONS_LOADER_H_
 #define CHROME_BROWSER_EXTENSIONS_BARE_BUNDLED_EXTENSIONS_LOADER_H_
 
+#include "base/memory/scoped_refptr.h"
 #include "base/memory/weak_ptr.h"
 #include "base/values.h"
 #include "chrome/browser/extensions/external_loader.h"
@@ -19,6 +20,8 @@ class BrowserContext;
 
 namespace extensions {
 
+class Extension;
+
 // Offers the extensions Bare ships inside the apk to the external provider
 // machinery.
 //
@@ -54,6 +57,20 @@ class BareBundledExtensionsLoader : public ExternalLoader {
   base::DictValue last_prefs_;
 };
 
+// Keeps `loader` with `profile`, for IsProvisionedByBare(). Call once, when the
+// provider is created.
+void RememberBundledExtensionsLoader(
+    Profile* profile,
+    scoped_refptr<BareBundledExtensionsLoader> loader);
+
+// Whether `extension` is a copy that Bare's own provider installed in `context`
+// and still offers. The id comes from the provider's entry, and Chromium checks
+// that a crx installed or updated under that id is signed with the key the id
+// is derived from, so this is uBlock Origin as its author signs it. A copy the
+// user installed some other way, or one loaded unpacked, is not.
+bool IsProvisionedByBare(content::BrowserContext* context,
+                         const Extension& extension);
+
 // Gives the bundled blocker incognito access the first time it is seen, and
 // never again. Safe to call on every startup.
 void ApplyBundledExtensionIncognitoDefault(content::BrowserContext* context);
diff --git a/chrome/browser/extensions/extension_safety_check_utils.cc b/chrome/browser/extensions/extension_safety_check_utils.cc
index 5e61e9e45cc..947662bbbf5 100644
--- a/chrome/browser/extensions/extension_safety_check_utils.cc
+++ b/chrome/browser/extensions/extension_safety_check_utils.cc
@@ -4,9 +4,11 @@
 
 #include "chrome/browser/extensions/extension_safety_check_utils.h"
 
+#include "build/build_config.h"
 #include "chrome/browser/extensions/api/developer_private/developer_private_api.h"
 #include "chrome/browser/extensions/cws_info_service_factory.h"
 #include "chrome/browser/extensions/extension_management.h"
+#include "chrome/browser/profiles/profile.h"
 #include "chrome/common/chrome_features.h"
 #include "chrome/common/pref_names.h"
 #include "chrome/grit/branded_strings.h"
@@ -19,6 +21,10 @@
 #include "extensions/buildflags/buildflags.h"
 #include "ui/base/l10n/l10n_util.h"
 
+#if BUILDFLAG(IS_ANDROID)
+#include "chrome/browser/extensions/bare_bundled_extensions_loader.h"
+#endif
+
 static_assert(BUILDFLAG(ENABLE_EXTENSIONS_CORE));
 
 namespace extensions {
@@ -117,6 +123,16 @@ bool SafetyCheckShouldShowOffstoreExtension(
           features::kSafetyHubExtensionsOffStoreTrigger)) {
     return false;
   }
+#if BUILDFLAG(IS_ANDROID)
+  // Bare: the uBlock Origin Bare ships comes from its author's own releases
+  // and updates from there, so this check would always flag it, and it cannot
+  // tell that copy from one of unknown origin. Bare installed it and Chromium
+  // checked its signature, so leave it out. Every other extension, including
+  // another copy of uBlock Origin, is judged as upstream judges it.
+  if (IsProvisionedByBare(profile->GetOriginalProfile(), extension)) {
+    return false;
+  }
+#endif
   // Leave command-line extensions out for now since removing them is only
   // effective till the next browser session.
   if (extension.location() == mojom::ManifestLocation::kCommandLine) {
diff --git a/chrome/browser/extensions/external_provider_impl.cc b/chrome/browser/extensions/external_provider_impl.cc
index 57ea4ec4441..055119107ea 100644
--- a/chrome/browser/extensions/external_provider_impl.cc
+++ b/chrome/browser/extensions/external_provider_impl.cc
@@ -959,6 +959,7 @@ void ExternalProviderImpl::CreateExternalProviders(
       Extension::NO_FLAGS));
   ApplyBundledExtensionIncognitoDefault(profile);
   ApplyBundledExtensionCarryOver(profile);
+  RememberBundledExtensionsLoader(profile, bare_loader);
   StartBundledExtensionRecovery(profile, bare_loader);
 #endif
 

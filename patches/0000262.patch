+                customize = item;
+            } else if (id == R.id.preferences_id) {
+                settings = item;
+            } else if (id == R.id.bare_exit_id) {
+                exit = item;
+            } else {
+                rest.add(item);
+            }
+        }
+        if (exit == null || settings == null) return;
+        while (list.size() > 0) list.removeAt(list.size() - 1);

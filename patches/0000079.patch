From: Bare <git@barebrowser.org>
Date: Sun, 23 Aug 2026 17:17:00 +0000
Subject: [PATCH] Patch 0000079

---
 .../chrome_autocomplete_provider_client.cc          | 13 ++++++++-----
 1 file changed, 8 insertions(+), 5 deletions(-)

diff --git a/chrome/browser/autocomplete/chrome_autocomplete_provider_client.cc b/chrome/browser/autocomplete/chrome_autocomplete_provider_client.cc
index 18fc0f61918..2c438f8e48d 100644
--- a/chrome/browser/autocomplete/chrome_autocomplete_provider_client.cc
+++ b/chrome/browser/autocomplete/chrome_autocomplete_provider_client.cc
@@ -564,11 +564,14 @@ bool ChromeAutocompleteProviderClient::IsPersonalizedUrlDataCollectionActive()
 }
 
 bool ChromeAutocompleteProviderClient::IsAuthenticated() const {
-  const auto* identity_manager =
-      IdentityManagerFactory::GetForProfile(profile_);
-  return identity_manager && !identity_manager->GetAccountsInCookieJar()
-                                  .GetPotentiallyInvalidSignedInAccounts()
-                                  .empty();
+  // De-Googled build: nobody is ever signed in, so answer without asking.
+  //
+  // GetAccountsInCookieJar() reaches GaiaCookieManagerService::ListAccounts(),
+  // which fetches accounts.google.com when the cached answer is stale. The
+  // omnibox calls this while building suggestions, so a browser with no accounts
+  // at all was contacting Google on the typing path. The only thing the answer
+  // fed was whether to personalise suggestions, which this build does not do.
+  return false;
 }
 
 std::string ChromeAutocompleteProviderClient::ProfileUserName() const {

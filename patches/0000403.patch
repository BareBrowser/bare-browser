+++ b/chrome/android/java/src/org/chromium/chrome/browser/bare/player/BarePlayerController.java
@@ -66,6 +66,42 @@ public final class BarePlayerController implements FullscreenManager.Observer, B
     private static final WeakHashMap<Activity, BarePlayerController> sControllers =
             new WeakHashMap<>();
 
+    // Bare: a downloaded video opened from the Downloads page plays here even when the player is
+    // switched off. The address is held until that page has loaded; the page then counts as ours.
+    private static final long LOCAL_WAIT_MS = 20000;
+    private static @Nullable String sLocalUrl;
+    private static long sLocalAt;
+    private static @Nullable WeakReference<WebContents> sLocalContents;
+
+    /** Notes the address of a downloaded file about to open in a tab, to play when it loads. */
+    public static void armLocal(String url) {
+        sLocalUrl = url;
+        sLocalAt = android.os.SystemClock.uptimeMillis();
+    }
+
+    /** Called when a page has loaded in a tab of {@code activity}. */
+    public static void onPageLoaded(Activity activity, Tab tab, String url) {
+        String pending = sLocalUrl;
+        if (pending == null) return;
+        if (android.os.SystemClock.uptimeMillis() - sLocalAt > LOCAL_WAIT_MS) {
+            sLocalUrl = null;
+            return;
+        }
+        if (!pending.equals(url)) return;
+        sLocalUrl = null;
+        WebContents webContents = tab.getWebContents();
+        BarePlayerController controller = sControllers.get(activity);
+        if (webContents == null || controller == null) return;
+        sLocalContents = new WeakReference<>(webContents);
+        // The video document needs a moment before its video can be found.
+        controller.mHandler.postDelayed(() -> controller.lookOnPage(webContents), 700);
+    }
+
+    private static boolean isLocal(WebContents webContents) {
+        WeakReference<WebContents> local = sLocalContents;
+        return local != null && local.get() == webContents;
+    }
+

diff --git a/ui/events/gesture_detection/smooth_scrolling.cc b/ui/events/gesture_detection/smooth_scrolling.cc
new file mode 100644
index 00000000000..f0325a0209a
--- /dev/null
+++ b/ui/events/gesture_detection/smooth_scrolling.cc
@@ -0,0 +1,29 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "ui/events/gesture_detection/smooth_scrolling.h"
+
+#include <algorithm>
+
+namespace ui {
+
+BASE_FEATURE(kBareSmoothScrolling, base::FEATURE_ENABLED_BY_DEFAULT);
+
+namespace {
+
+constexpr float kSmoothMaxFlingVelocityDips = 3500.f;
+
+}  // namespace
+
+bool IsSmoothScrollingEnabled() {
+  return base::FeatureList::IsEnabled(kBareSmoothScrolling);
+}
+
+float LimitFlingVelocity(float max_velocity) {
+  return IsSmoothScrollingEnabled()
+             ? std::min(max_velocity, kSmoothMaxFlingVelocityDips)
+             : max_velocity;
+}
+
+}  // namespace ui
diff --git a/ui/events/gesture_detection/smooth_scrolling.h b/ui/events/gesture_detection/smooth_scrolling.h
new file mode 100644
index 00000000000..4418db95d22
--- /dev/null
+++ b/ui/events/gesture_detection/smooth_scrolling.h
@@ -0,0 +1,28 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef UI_EVENTS_GESTURE_DETECTION_SMOOTH_SCROLLING_H_
+#define UI_EVENTS_GESTURE_DETECTION_SMOOTH_SCROLLING_H_
+
+#include "base/feature_list.h"
+#include "ui/events/gesture_detection/gesture_detection_export.h"
+
+namespace ui {
+
+// Smooth scrolling makes a flick behave like one in a native Android list: it
+// cannot start faster than a set speed, it glides on the curve a native list
+// uses, and a flick while the page is still moving does not add its speed to
+// the one before. It is on unless the user turned it off in Settings; the
+// browser decides that at startup and every process is told the same.
+GESTURE_DETECTION_EXPORT BASE_DECLARE_FEATURE(kBareSmoothScrolling);
+
+GESTURE_DETECTION_EXPORT bool IsSmoothScrollingEnabled();
+
+// The fastest a flick may start, in dips per second. With smooth scrolling on
+// this is the lower of `max_velocity` and a fixed limit.
+GESTURE_DETECTION_EXPORT float LimitFlingVelocity(float max_velocity);
+
+}  // namespace ui
+
+#endif  // UI_EVENTS_GESTURE_DETECTION_SMOOTH_SCROLLING_H_

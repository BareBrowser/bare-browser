+        if (row == null) return;
+        boolean saved =
+                ChromeSharedPreferences.getInstance()
+                        .readBoolean(ChromePreferenceKeys.BARE_SMOOTH_SCROLLING, true);
+        // What the running browser uses is what the setting said when Bare started, which is what
+        // it says the first time this page opens, before it can be changed here.
+        if (sRunningSmoothScrolling == null) sRunningSmoothScrolling = saved;
+        row.setChecked(saved);
+        row.setOnPreferenceChangeListener(
+                (pref, newValue) -> {
+                    ChromeSharedPreferences.getInstance()
+                            .writeBoolean(

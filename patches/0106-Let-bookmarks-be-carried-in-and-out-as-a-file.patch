new file mode 100644
index 00000000000..fe6f9e50b9a
--- /dev/null
+++ b/chrome/browser/bookmarks/android/bookmark_html_bridge.cc
@@ -0,0 +1,177 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include <memory>
+#include <utility>
+
+#include "base/android/callback_android.h"
+#include "base/android/jni_android.h"
+#include "base/android/jni_string.h"
+#include "base/android/scoped_java_ref.h"
+#include "base/files/file_path.h"
+#include "base/functional/bind.h"
+#include "base/task/bind_post_task.h"
+#include "base/task/sequenced_task_runner.h"
+#include "base/task/task_traits.h"
+#include "base/task/thread_pool.h"
+#include "chrome/browser/bookmarks/bookmark_html_writer.h"
+#include "chrome/browser/bookmarks/bookmark_model_factory.h"
+#include "chrome/browser/bookmarks/imported_bookmark_merger.h"
+#include "chrome/browser/profiles/profile.h"
+#include "components/bookmarks/browser/bookmark_model.h"
+#include "components/user_data_importer/common/imported_bookmark_entry.h"
+#include "components/user_data_importer/utility/bookmark_parser.h"
+#include "content/public/browser/browser_thread.h"
+
+// Must come after all headers that specialize FromJniType() / ToJniType().
+#include "chrome/browser/bookmarks/android/jni_headers/BookmarkHtmlBridge_jni.h"
+
+using base::android::JavaRef;
+using base::android::ScopedJavaGlobalRef;
+using user_data_importer::BookmarkParser;
+
+namespace {
+
+// Reported to Java. Negative values are failures, so one int carries both "how
+// many" and "why not"; there is nothing a caller would do with a richer answer
+// than pick which sentence to show. Kept in step with BookmarkHtmlBridge.java.
+constexpr int kImportFailed = -1;
+constexpr int kImportFoundNothing = -2;
+
+// Where the document picker's answer goes.
+//
+// Android hands back a content:// URI rather than a path, and base::FilePath
+// carries one on this platform: opening it goes through the Storage Access
+// Framework, so the browser reads and writes exactly the one document the user
+// picked and nothing else. That is why neither the parser nor the writer below
+// needed changing.
+base::FilePath PathFromUri(JNIEnv* env, const JavaRef<jstring>& j_uri) {
+  return base::FilePath(base::android::ConvertJavaStringToUTF8(env, j_uri));
+}
+
+// Runs on the parsing sequence, and owns the parser for as long as the parse
+// takes. The parser must be used and destroyed on the sequence it runs on, and
+// it outlives this call, so ownership travels into its own callback.
+void ParseOnBackgroundSequence(std::unique_ptr<BookmarkParser> parser,
+                               const base::FilePath& path,
+                               BookmarkParser::BookmarkParsingCallback done) {
+  BookmarkParser* raw_parser = parser.get();
+  raw_parser->Parse(
+      path,
+      base::BindOnce(
+          [](std::unique_ptr<BookmarkParser> owned_parser,
+             BookmarkParser::BookmarkParsingCallback done,
+             BookmarkParser::BookmarkParsingResult result) {
+            // Destroyed on this sequence, as required, but not from inside the
+            // parser's own callback: it is still on the stack.
+            base::SequencedTaskRunner::GetCurrentDefault()->DeleteSoon(
+                FROM_HERE, std::move(owned_parser));
+            std::move(done).Run(std::move(result));
+          },
+          std::move(parser), std::move(done)));
+}
+
+// Runs on the UI thread once the file has been read and parsed.
+void MergeParsedBookmarks(base::WeakPtr<Profile> profile,
+                          std::u16string folder_name,
+                          ScopedJavaGlobalRef<jobject> j_callback,
+                          BookmarkParser::BookmarkParsingResult result) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+
+  if (!result.has_value() || !profile) {
+    base::android::RunIntCallbackAndroid(j_callback, kImportFailed);
+    return;
+  }
+
+  bookmarks::BookmarkModel* model =
+      BookmarkModelFactory::GetForBrowserContext(profile.get());
+  if (!model || !model->loaded()) {
+    base::android::RunIntCallbackAndroid(j_callback, kImportFailed);
+    return;
+  }
+
+  // A file that parsed but described no bookmarks is not an error and is not a
+  // success either. Nothing is written to the model, so whatever the user had
+  // is exactly what they still have.
+  if (result->bookmarks.empty()) {
+    base::android::RunIntCallbackAndroid(j_callback, kImportFoundNothing);
+    return;
+  }
+
+  const bookmark_import::MergeResult merged =
+      bookmark_import::MergeImportedBookmarks(model, result->bookmarks,
+                                              folder_name);
+
+  base::android::RunIntCallbackAndroid(j_callback,
+                                       static_cast<int>(merged.urls_added));
+}
+
+void OnExportFinished(ScopedJavaGlobalRef<jobject> j_callback,
+                      bookmark_html_writer::Result result) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  base::android::RunBooleanCallbackAndroid(
+      j_callback, result == bookmark_html_writer::Result::kSuccess);
+}
+
+}  // namespace
+
+static void JNI_BookmarkHtmlBridge_ImportFromUri(
+    JNIEnv* env,
+    const JavaRef<jobject>& j_profile,
+    const JavaRef<jstring>& j_uri,
+    const JavaRef<jstring>& j_folder_name,
+    const JavaRef<jobject>& j_callback) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  Profile* profile = Profile::FromJavaObject(j_profile);
+  ScopedJavaGlobalRef<jobject> callback(j_callback);
+
+  if (!profile) {
+    base::android::RunIntCallbackAndroid(callback, kImportFailed);
+    return;
+  }
+
+  // The file is read and parsed away from the browser, and only the result of
+  // that comes back here. Nothing touches the bookmark model until there is
+  // something valid to add to it, so a file that cannot be read or cannot be
+  // understood costs the user nothing.
+  scoped_refptr<base::SequencedTaskRunner> parsing_runner =
+      base::ThreadPool::CreateSequencedTaskRunner(
+          {base::MayBlock(), base::TaskPriority::USER_VISIBLE,
+           base::TaskShutdownBehavior::SKIP_ON_SHUTDOWN});
+
+  parsing_runner->PostTask(
+      FROM_HERE,
+      base::BindOnce(
+          &ParseOnBackgroundSequence, user_data_importer::MakeBookmarkParser(),
+          PathFromUri(env, j_uri),
+          base::BindPostTask(
+              content::GetUIThreadTaskRunner({}),
+              base::BindOnce(
+                  &MergeParsedBookmarks, profile->GetWeakPtr(),
+                  base::android::ConvertJavaStringToUTF16(env, j_folder_name),
+                  std::move(callback)))));
+}
+
+static void JNI_BookmarkHtmlBridge_ExportToUri(
+    JNIEnv* env,
+    const JavaRef<jobject>& j_profile,
+    const JavaRef<jstring>& j_uri,
+    const JavaRef<jobject>& j_callback) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  Profile* profile = Profile::FromJavaObject(j_profile);
+  ScopedJavaGlobalRef<jobject> callback(j_callback);
+
+  if (!profile) {
+    base::android::RunBooleanCallbackAndroid(callback, false);
+    return;
+  }
+
+  bookmark_html_writer::WriteBookmarks(
+      profile, PathFromUri(env, j_uri),
+      base::BindPostTask(
+          content::GetUIThreadTaskRunner({}),
+          base::BindOnce(&OnExportFinished, std::move(callback))));
+}
+
+DEFINE_JNI(BookmarkHtmlBridge)

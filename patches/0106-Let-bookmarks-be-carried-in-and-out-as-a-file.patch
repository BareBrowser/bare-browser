@@ -0,0 +1,68 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_BOOKMARKS_IMPORTED_BOOKMARK_MERGER_H_
+#define CHROME_BROWSER_BOOKMARKS_IMPORTED_BOOKMARK_MERGER_H_
+
+#include <stddef.h>
+
+#include <string>
+#include <vector>
+
+namespace bookmarks {
+class BookmarkModel;
+}
+
+namespace user_data_importer {
+struct ImportedBookmarkEntry;
+}
+
+namespace bookmark_import {
+
+// What a merge did. Reported rather than inferred, because the number of
+// bookmarks a file contains and the number that end up on the bar are not the
+// same: entries with unusable urls are skipped, and folders are reused when one
+// of the same name is already there.
+struct MergeResult {
+  size_t urls_added = 0;
+  size_t folders_added = 0;
+
+  // Whether what was merged came from another browser's toolbar and was put on
+  // this one's. The caller decides what, if anything, to do about that; showing
+  // the bookmarks bar needs a profile, and this does not have one.
+  bool imported_a_toolbar = false;
+};
+
+// Adds `bookmarks` to `model`.
+//
+// Only ever adds. Nothing already in the model is removed, moved or rewritten,
+// so importing a file twice leaves the user with two copies rather than with
+// none, and importing a file that turns out to be nonsense leaves them with
+// exactly what they had.
+//
+// The arrangement follows what the desktop importer has always done:
+//
+// (a) If the bookmarks bar is empty:
+//     (i) If `bookmarks` includes at least one bookmark that was originally
+//         located in a toolbar, all such bookmarks are imported directly to
+//         the toolbar; any other bookmarks are imported to a subfolder in
+//         the toolbar.
+//     (ii) If `bookmarks` includes no bookmarks that were originally located
+//         in a toolbar, all bookmarks are imported directly to the toolbar.
+// (b) If the bookmarks bar is not empty, all bookmarks are imported to a
+//     subfolder in the toolbar.
+//
+// In either case, if a subfolder is created, the name will be the value of
+// `top_level_folder_name`, unless a folder with this name already exists, in
+// which case the name is uniquified.
+//
+// Must be called on the UI thread, with a loaded model.
+MergeResult MergeImportedBookmarks(
+    bookmarks::BookmarkModel* model,
+    const std::vector<user_data_importer::ImportedBookmarkEntry>& bookmarks,
+    const std::u16string& top_level_folder_name);
+
+}  // namespace bookmark_import
+
+#endif  // CHROME_BROWSER_BOOKMARKS_IMPORTED_BOOKMARK_MERGER_H_
diff --git a/chrome/browser/bookmarks/imported_bookmark_merger_unittest.cc b/chrome/browser/bookmarks/imported_bookmark_merger_unittest.cc
new file mode 100644
index 00000000000..b75053dcc15
--- /dev/null
+++ b/chrome/browser/bookmarks/imported_bookmark_merger_unittest.cc
@@ -0,0 +1,241 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/bookmarks/imported_bookmark_merger.h"
+
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "base/strings/utf_string_conversions.h"
+#include "components/bookmarks/browser/bookmark_model.h"
+#include "components/bookmarks/browser/bookmark_node.h"
+#include "components/bookmarks/browser/bookmark_utils.h"
+#include "components/bookmarks/test/test_bookmark_client.h"
+#include "components/user_data_importer/common/imported_bookmark_entry.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "url/gurl.h"
+
+namespace bookmark_import {
+namespace {
+
+using bookmarks::BookmarkModel;
+using bookmarks::BookmarkNode;
+using user_data_importer::ImportedBookmarkEntry;
+
+ImportedBookmarkEntry MakeUrl(const std::string& title,
+                              const std::string& url,
+                              std::vector<std::u16string> path = {},
+                              bool in_toolbar = false) {
+  ImportedBookmarkEntry entry;
+  entry.is_folder = false;
+  entry.title = base::UTF8ToUTF16(title);
+  entry.url = GURL(url);
+  entry.path = std::move(path);
+  entry.in_toolbar = in_toolbar;
+  return entry;
+}
+
+ImportedBookmarkEntry MakeFolder(const std::string& title,
+                                 std::vector<std::u16string> path = {},
+                                 bool in_toolbar = false) {
+  ImportedBookmarkEntry entry;
+  entry.is_folder = true;
+  entry.title = base::UTF8ToUTF16(title);
+  entry.path = std::move(path);
+  entry.in_toolbar = in_toolbar;
+  return entry;
+}
+
+// Describes a subtree the way a person reading the bookmarks screen would, so a
+// failure names the arrangement rather than a node pointer.
+std::string Describe(const BookmarkNode* node) {
+  std::string out;
+  for (const auto& child : node->children()) {
+    if (!out.empty())
+      out += ", ";
+    out += base::UTF16ToUTF8(child->GetTitle());
+    if (child->is_folder()) {
+      out += "/{" + Describe(child.get()) + "}";
+    } else {
+      out += "=" + child->url().spec();
+    }
+  }
+  return out;
+}
+
+class ImportedBookmarkMergerTest : public testing::Test {
+ protected:
+  void SetUp() override {
+    model_ = bookmarks::TestBookmarkClient::CreateModel();
+  }
+
+  BookmarkModel* model() { return model_.get(); }
+  const BookmarkNode* bar() { return model_->bookmark_bar_node(); }
+
+  MergeResult Merge(const std::vector<ImportedBookmarkEntry>& entries) {
+    return MergeImportedBookmarks(model_.get(), entries, u"Imported");
+  }
+
+  std::unique_ptr<BookmarkModel> model_;
+};
+
+// The bar is empty and nothing claims to have come from a toolbar, so
+// everything lands on the bar rather than inside a folder nobody asked for.
+
+TEST_F(ImportedBookmarkMergerTest, EmptyInputChangesNothing) {
+  model()->AddURL(bar(), 0, u"A", GURL("https://a.example/"));
+  MergeResult result = Merge({});
+  EXPECT_EQ(0u, result.urls_added);
+  EXPECT_EQ("A=https://a.example/", Describe(bar()));
+}
+
+TEST_F(ImportedBookmarkMergerTest, AddsBookmarksToAnEmptyBar) {
+  MergeResult result = Merge({MakeUrl("One", "https://one.example/"),
+                              MakeUrl("Two", "https://two.example/")});
+  EXPECT_EQ(2u, result.urls_added);
+  EXPECT_EQ("One=https://one.example/, Two=https://two.example/",
+            Describe(bar()));
+}
+
+TEST_F(ImportedBookmarkMergerTest, KeepsTheOrderOfTheFile) {
+  Merge({MakeUrl("C", "https://c.example/"), MakeUrl("A", "https://a.example/"),
+         MakeUrl("B", "https://b.example/")});
+  EXPECT_EQ(
+      "C=https://c.example/, A=https://a.example/, B=https://b.example/",
+      Describe(bar()));
+}
+
+TEST_F(ImportedBookmarkMergerTest, BuildsNestedFolders) {
+  Merge({MakeUrl("Deep", "https://deep.example/", {u"Outer", u"Inner"})});
+  EXPECT_EQ("Outer/{Inner/{Deep=https://deep.example/}}", Describe(bar()));
+}
+
+TEST_F(ImportedBookmarkMergerTest, ReusesAFolderItAlreadyCreated) {
+  Merge({MakeUrl("One", "https://one.example/", {u"Test"}),
+         MakeUrl("Two", "https://two.example/", {u"Test"})});
+  EXPECT_EQ("Test/{One=https://one.example/, Two=https://two.example/}",
+            Describe(bar()));
+}
+
+TEST_F(ImportedBookmarkMergerTest, KeepsUnicodeTitles) {
+  ImportedBookmarkEntry entry =
+      MakeUrl("", "https://unicode.example/", {u"Ordner über"});
+  entry.title = u"日本語 — café";
+  Merge({entry});
+  EXPECT_EQ(
+      "Ordner über/{日本語 — "
+      "café=https://unicode.example/}",
+      Describe(bar()));
+}
+
+// Merging, which is the whole point: what was there stays there.
+
+TEST_F(ImportedBookmarkMergerTest, ExistingBookmarksSurviveAnImport) {
+  model()->AddURL(bar(), 0, u"A", GURL("https://a.example/"));
+  model()->AddURL(bar(), 1, u"B", GURL("https://b.example/"));
+
+  Merge({MakeUrl("C", "https://c.example/"),
+         MakeUrl("D", "https://d.example/", {u"Folder X"})});
+
+  // A and B are untouched. Because the bar was not empty, what arrived went
+  // into a folder of its own rather than being mixed in among them.
+  EXPECT_EQ(
+      "A=https://a.example/, B=https://b.example/, "
+      "Imported/{C=https://c.example/, Folder X/{D=https://d.example/}}",
+      Describe(bar()));
+}
+
+TEST_F(ImportedBookmarkMergerTest, ImportingTwiceKeepsBothCopies) {
+  const std::vector<ImportedBookmarkEntry> entries = {
+      MakeUrl("One", "https://one.example/")};
+
+  Merge(entries);
+  Merge(entries);
+
+  // Two copies rather than none. The second import cannot see the first as
+  // something to replace, and must not treat it as something to remove.
+  EXPECT_EQ("One=https://one.example/, Imported/{One=https://one.example/}",
+            Describe(bar()));
+}
+
+TEST_F(ImportedBookmarkMergerTest, ASecondImportUniquifiesItsFolder) {
+  model()->AddURL(bar(), 0, u"A", GURL("https://a.example/"));
+  Merge({MakeUrl("One", "https://one.example/")});
+  Merge({MakeUrl("Two", "https://two.example/")});
+
+  EXPECT_EQ(
+      "A=https://a.example/, Imported/{One=https://one.example/}, "
+      "Imported (1)/{Two=https://two.example/}",
+      Describe(bar()));
+}
+
+TEST_F(ImportedBookmarkMergerTest, NothingIsEverRemoved) {
+  const BookmarkNode* folder = model()->AddFolder(bar(), 0, u"Mine");
+  model()->AddURL(folder, 0, u"Kept", GURL("https://kept.example/"));
+  const int64_t folder_id = folder->id();
+
+  // An import naming a folder of the same name must not merge into, empty or
+  // replace the user's folder; it is inside the imported folder instead.
+  Merge({MakeUrl("Other", "https://other.example/", {u"Mine"})});
+
+  const BookmarkNode* still_there =
+      bookmarks::GetBookmarkNodeByID(model(), folder_id);
+  ASSERT_TRUE(still_there);
+  EXPECT_EQ("Kept=https://kept.example/", Describe(still_there));
+  EXPECT_EQ(
+      "Mine/{Kept=https://kept.example/}, "
+      "Imported/{Mine/{Other=https://other.example/}}",
+      Describe(bar()));
+}
+
+// Files that are not quite right.
+
+TEST_F(ImportedBookmarkMergerTest, SkipsEntriesWithUnusableUrls) {
+  MergeResult result = Merge({MakeUrl("Good", "https://good.example/"),
+                              MakeUrl("Bad", "not a url at all"),
+                              MakeUrl("Empty", "")});
+  EXPECT_EQ(1u, result.urls_added);
+  EXPECT_EQ("Good=https://good.example/", Describe(bar()));
+}
+
+TEST_F(ImportedBookmarkMergerTest, AFolderWithNoUrlIsStillAFolder) {
+  Merge({MakeFolder("Empty folder")});
+  EXPECT_EQ("Empty folder/{}", Describe(bar()));
+}
+
+// The toolbar folder, which is the one piece of structure the file format
+// names explicitly.
+
+TEST_F(ImportedBookmarkMergerTest, ToolbarEntriesGoStraightOntoTheBar) {
+  MergeResult result =
+      Merge({MakeUrl("Bar one", "https://bar1.example/", {u"Bookmarks bar"},
+                     /*in_toolbar=*/true),
+             MakeUrl("Elsewhere", "https://other.example/")});
+
+  // The toolbar entry keeps its place on the bar and loses the wrapper folder
+  // the file used to say so; everything else is filed under Imported.
+  EXPECT_TRUE(result.imported_a_toolbar);
+  EXPECT_EQ(
+      "Bar one=https://bar1.example/, "
+      "Imported/{Elsewhere=https://other.example/}",
+      Describe(bar()));
+}
+
+TEST_F(ImportedBookmarkMergerTest, ToolbarEntriesAreFiledWhenTheBarIsNotEmpty) {
+  model()->AddURL(bar(), 0, u"Existing", GURL("https://existing.example/"));
+
+  MergeResult result = Merge({MakeUrl("Bar one", "https://bar1.example/",
+                                      {u"Bookmarks bar"},
+                                      /*in_toolbar=*/true)});
+
+  EXPECT_FALSE(result.imported_a_toolbar);
+  EXPECT_EQ(
+      "Existing=https://existing.example/, "
+      "Imported/{Bookmarks bar/{Bar one=https://bar1.example/}}",
+      Describe(bar()));
+}
+
+}  // namespace
+}  // namespace bookmark_import

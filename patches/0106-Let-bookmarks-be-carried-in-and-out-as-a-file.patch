new file mode 100644
index 00000000000..17ae9d82b34
--- /dev/null
+++ b/chrome/browser/bookmarks/android/java/src/org/chromium/chrome/browser/bookmarks/BookmarkHtmlBridge.java
@@ -0,0 +1,84 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.bookmarks;
+
+import org.jni_zero.NativeMethods;
+
+import org.chromium.base.Callback;
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.chrome.browser.profiles.Profile;
+
+/**
+ * Reads and writes the bookmarks file every browser understands.
+ *
+ * <p>Both directions are already implemented in the browser and are reached from here rather than
+ * reimplemented: the file is parsed by the same code Chrome's desktop importer uses, in a sandboxed
+ * process because it came from somewhere else, and written by the same writer, which produces the
+ * Netscape bookmarks HTML that Firefox, Chrome, Safari and Brave all read.
+ *
+ * <p>The document is named by the URI the system file picker returned, not by a path. Nothing here
+ * has permission to look at storage; it has permission to look at the one document the user chose.
+ */
+@NullMarked
+public final class BookmarkHtmlBridge {
+    /** The import could not be done at all: the file was unreadable, or the browser is going away. */
+    public static final int IMPORT_FAILED = -1;
+
+    /** The file was read and understood, and described no bookmarks. Nothing was written. */
+    public static final int IMPORT_FOUND_NOTHING = -2;
+
+    private BookmarkHtmlBridge() {}
+
+    /**
+     * Adds the bookmarks in a document to the ones already saved.
+     *
+     * <p>Only adds. Whatever is already bookmarked stays exactly as it is, including when the file
+     * turns out to be unreadable or to contain nothing, so importing is never a way to lose
+     * bookmarks. Importing the same file twice leaves two copies rather than merging them; the same
+     * page can reasonably be filed in two places, and guessing which duplicates were unintended is
+     * not something this can do safely.
+     *
+     * @param profile The profile whose bookmarks are being added to.
+     * @param documentUri The content URI the document picker returned.
+     * @param importedFolderName What to call the folder the arriving bookmarks go in when they
+     *     cannot go straight onto the bookmarks bar. Passed in rather than looked up in the
+     *     browser, because the name is a translated string and those live on this side.
+     * @param callback Given the number of bookmarks added, or one of the constants above.
+     */
+    public static void importFromUri(
+            Profile profile,
+            String documentUri,
+            String importedFolderName,
+            Callback<Integer> callback) {
+        BookmarkHtmlBridgeJni.get()
+                .importFromUri(profile, documentUri, importedFolderName, callback);
+    }
+
+    /**
+     * Writes every saved bookmark to a document.
+     *
+     * <p>Managed bookmarks are not written. They are not the user's to take with them, and the
+     * writer has never included them.
+     *
+     * @param profile The profile whose bookmarks are being written.
+     * @param documentUri The content URI the document picker created.
+     * @param callback Given whether the document was written.
+     */
+    public static void exportToUri(
+            Profile profile, String documentUri, Callback<Boolean> callback) {
+        BookmarkHtmlBridgeJni.get().exportToUri(profile, documentUri, callback);
+    }
+
+    @NativeMethods
+    public interface Natives {
+        void importFromUri(
+                Profile profile,
+                String documentUri,
+                String importedFolderName,
+                Callback<Integer> callback);
+
+        void exportToUri(Profile profile, String documentUri, Callback<Boolean> callback);
+    }
+}
diff --git a/chrome/browser/bookmarks/android/java/src/org/chromium/chrome/browser/bookmarks/BookmarkHtmlTransferCoordinator.java b/chrome/browser/bookmarks/android/java/src/org/chromium/chrome/browser/bookmarks/BookmarkHtmlTransferCoordinator.java
new file mode 100644
index 00000000000..ba2f74a29d4
--- /dev/null
+++ b/chrome/browser/bookmarks/android/java/src/org/chromium/chrome/browser/bookmarks/BookmarkHtmlTransferCoordinator.java
@@ -0,0 +1,135 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.bookmarks;
+
+import android.app.Activity;
+import android.content.Context;
+import android.content.Intent;
+import android.net.Uri;
+
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.chrome.browser.profiles.Profile;
+import org.chromium.chrome.browser.ui.messages.snackbar.Snackbar;
+import org.chromium.chrome.browser.ui.messages.snackbar.SnackbarManager;
+import org.chromium.ui.base.WindowAndroid;
+
+/**
+ * Asks the system where a bookmarks file should be read from or written to, and reports what
+ * happened.
+ *
+ * <p>The picker is the system's, so the browser never asks for access to storage: the user chooses
+ * one document and the browser is handed that one document. Cancelling is a normal answer and says
+ * nothing.
+ *
+ * <p>Everything after the choice is done by {@link BookmarkHtmlBridge}. What is left here is which
+ * intent to send, and which sentence to show when it is over.
+ */
+@NullMarked
+public class BookmarkHtmlTransferCoordinator {
+    // Both are used rather than one, because pickers disagree about which they honour: some file
+    // providers filter on the MIME type and ignore the extension, others only understand the
+    // extension. Offering both is what makes a bookmarks file selectable in either.
+    private static final String HTML_MIME_TYPE = "text/html";
+    private static final String[] ACCEPTED_MIME_TYPES = {"text/html", "application/xhtml+xml"};
+
+    private final Context mContext;
+    private final Profile mProfile;
+    private final WindowAndroid mWindowAndroid;
+    private final SnackbarManager mSnackbarManager;
+
+    public BookmarkHtmlTransferCoordinator(
+            Context context,
+            Profile profile,
+            WindowAndroid windowAndroid,
+            SnackbarManager snackbarManager) {
+        mContext = context;
+        mProfile = profile;
+        mWindowAndroid = windowAndroid;
+        mSnackbarManager = snackbarManager;
+    }
+
+    /** Asks for a bookmarks file and adds what is in it to the bookmarks already saved. */
+    public void startImport() {
+        Intent intent = new Intent(Intent.ACTION_OPEN_DOCUMENT);
+        intent.addCategory(Intent.CATEGORY_OPENABLE);
+        intent.setType(HTML_MIME_TYPE);
+        intent.putExtra(Intent.EXTRA_MIME_TYPES, ACCEPTED_MIME_TYPES);
+
+        if (!mWindowAndroid.showIntent(intent, this::onImportDocumentChosen, null)) {
+            showSnackbar(mContext.getString(R.string.bare_bookmarks_import_failed));
+        }
+    }
+
+    /** Asks where to put a bookmarks file and writes every saved bookmark to it. */
+    public void startExport() {
+        Intent intent = new Intent(Intent.ACTION_CREATE_DOCUMENT);
+        intent.addCategory(Intent.CATEGORY_OPENABLE);
+        intent.setType(HTML_MIME_TYPE);
+        intent.putExtra(
+                Intent.EXTRA_TITLE, mContext.getString(R.string.bare_bookmarks_export_filename));
+
+        if (!mWindowAndroid.showIntent(intent, this::onExportDocumentChosen, null)) {
+            showSnackbar(mContext.getString(R.string.bare_bookmarks_export_failed));
+        }
+    }
+
+    private void onImportDocumentChosen(int resultCode, @Nullable Intent data) {
+        Uri uri = uriFrom(resultCode, data);
+        // Cancelling is an answer, not a failure. Nothing is said about it.
+        if (uri == null) return;
+
+        BookmarkHtmlBridge.importFromUri(
+                mProfile,
+                uri.toString(),
+                mContext.getString(R.string.bare_bookmarks_imported_folder),
+                this::onImportFinished);
+    }
+
+    private void onExportDocumentChosen(int resultCode, @Nullable Intent data) {
+        Uri uri = uriFrom(resultCode, data);
+        if (uri == null) return;
+
+        BookmarkHtmlBridge.exportToUri(mProfile, uri.toString(), this::onExportFinished);
+    }
+
+    private void onImportFinished(Integer added) {
+        final String message;
+        if (added == BookmarkHtmlBridge.IMPORT_FAILED) {
+            message = mContext.getString(R.string.bare_bookmarks_import_failed);
+        } else if (added == BookmarkHtmlBridge.IMPORT_FOUND_NOTHING) {
+            message = mContext.getString(R.string.bare_bookmarks_import_empty);
+        } else if (added == 1) {
+            message = mContext.getString(R.string.bare_bookmarks_import_one);
+        } else {
+            message = mContext.getString(R.string.bare_bookmarks_import_many, added);
+        }
+        showSnackbar(message);
+    }
+
+    private void onExportFinished(Boolean succeeded) {
+        showSnackbar(
+                mContext.getString(
+                        succeeded
+                                ? R.string.bare_bookmarks_export_done
+                                : R.string.bare_bookmarks_export_failed));
+    }
+
+    private static @Nullable Uri uriFrom(int resultCode, @Nullable Intent data) {
+        if (resultCode != Activity.RESULT_OK || data == null) return null;
+        return data.getData();
+    }
+
+    private void showSnackbar(String message) {
+        // No identifier, because the identifier exists to name the snackbar in a metric and this
+        // build reports none.
+        mSnackbarManager.showSnackbar(
+                Snackbar.make(
+                        message,
+                        /* controller= */ null,
+                        Snackbar.TYPE_NOTIFICATION,
+                        Snackbar.UMA_UNKNOWN));
+    }
+}

+
+/** Unit tests for the bookmarks import/export flow's use of the system document picker. */
+@RunWith(BaseRobolectricTestRunner.class)
+public class BookmarkHtmlTransferCoordinatorUnitTest {
+    @Rule public final MockitoRule mMockitoRule = MockitoJUnit.rule();
+
+    @Mock private Profile mProfile;
+    @Mock private WindowAndroid mWindowAndroid;
+    @Mock private SnackbarManager mSnackbarManager;
+    @Mock private BookmarkHtmlBridge.Natives mBridgeNatives;
+
+    @Captor private ArgumentCaptor<Intent> mIntentCaptor;
+    @Captor private ArgumentCaptor<WindowAndroid.IntentCallback> mIntentCallbackCaptor;
+    @Captor private ArgumentCaptor<Snackbar> mSnackbarCaptor;
+
+    private final Context mContext = ApplicationProvider.getApplicationContext();
+    private BookmarkHtmlTransferCoordinator mCoordinator;
+
+    @Before
+    public void setUp() {
+        BookmarkHtmlBridgeJni.setInstanceForTesting(mBridgeNatives);
+        when(mWindowAndroid.showIntent(
+                        any(Intent.class), any(WindowAndroid.IntentCallback.class), any()))
+                .thenReturn(true);
+        mCoordinator =
+                new BookmarkHtmlTransferCoordinator(
+                        mContext, mProfile, mWindowAndroid, mSnackbarManager);
+    }
+
+    private WindowAndroid.IntentCallback startAndCaptureCallback(Runnable start) {
+        start.run();
+        verify(mWindowAndroid)
+                .showIntent(mIntentCaptor.capture(), mIntentCallbackCaptor.capture(), any());
+        return mIntentCallbackCaptor.getValue();
+    }
+
+    private String lastSnackbarText() {
+        verify(mSnackbarManager).showSnackbar(mSnackbarCaptor.capture());
+        return String.valueOf(mSnackbarCaptor.getValue().getTextForTesting());
+    }
+
+    private static Intent resultWith(String uri) {
+        Intent data = new Intent();
+        data.setData(Uri.parse(uri));
+        return data;
+    }
+
+    // What the picker is asked for.
+
+    @Test
+    public void testImportAsksTheSystemToOpenAnHtmlDocument() {
+        startAndCaptureCallback(mCoordinator::startImport);
+
+        Intent intent = mIntentCaptor.getValue();
+        assertEquals(Intent.ACTION_OPEN_DOCUMENT, intent.getAction());
+        assertTrue(intent.getCategories().contains(Intent.CATEGORY_OPENABLE));
+        assertEquals("text/html", intent.getType());
+        String[] accepted = intent.getStringArrayExtra(Intent.EXTRA_MIME_TYPES);
+        assertNotNull(accepted);
+        assertEquals("text/html", accepted[0]);
+    }
+
+    @Test
+    public void testExportAsksTheSystemToCreateADocumentCalledBookmarksHtml() {
+        startAndCaptureCallback(mCoordinator::startExport);
+
+        Intent intent = mIntentCaptor.getValue();
+        assertEquals(Intent.ACTION_CREATE_DOCUMENT, intent.getAction());
+        assertEquals("text/html", intent.getType());
+        assertEquals("bookmarks.html", intent.getStringExtra(Intent.EXTRA_TITLE));
+    }
+
+    @Test
+    public void testNeitherFlowAsksForStoragePermission() {
+        // The whole point of going through the system picker. If either of these ever needed a
+        // permission, it would be requested around here.
+        startAndCaptureCallback(mCoordinator::startImport);
+        assertEquals(Intent.ACTION_OPEN_DOCUMENT, mIntentCaptor.getValue().getAction());
+        verify(mWindowAndroid, never()).hasPermission(any());
+        verify(mWindowAndroid, never())
+                .requestPermissions(any(String[].class), any());
+    }
+
+    // Cancelling.
+
+    @Test
+    public void testCancellingTheImportPickerDoesNothingAtAll() {
+        WindowAndroid.IntentCallback callback =
+                startAndCaptureCallback(mCoordinator::startImport);
+
+        callback.onIntentCompleted(Activity.RESULT_CANCELED, null);
+
+        verify(mBridgeNatives, never()).importFromUri(any(), any(), any(), any());
+        verify(mSnackbarManager, never()).showSnackbar(any());
+    }
+
+    @Test
+    public void testCancellingTheExportPickerWritesNothingAndSaysNothing() {
+        WindowAndroid.IntentCallback callback =
+                startAndCaptureCallback(mCoordinator::startExport);
+
+        callback.onIntentCompleted(Activity.RESULT_CANCELED, null);
+
+        verify(mBridgeNatives, never()).exportToUri(any(), any(), any());
+        verify(mSnackbarManager, never()).showSnackbar(any());
+    }
+
+    @Test
+    public void testAResultWithNoDocumentIsTreatedAsCancelled() {
+        WindowAndroid.IntentCallback callback =
+                startAndCaptureCallback(mCoordinator::startImport);
+
+        callback.onIntentCompleted(Activity.RESULT_OK, null);
+
+        verify(mBridgeNatives, never()).importFromUri(any(), any(), any(), any());
+        verify(mSnackbarManager, never()).showSnackbar(any());
+    }
+
+    // Handing the chosen document to the browser.
+
+    @Test
+    public void testTheChosenDocumentIsWhatIsImported() {
+        WindowAndroid.IntentCallback callback =
+                startAndCaptureCallback(mCoordinator::startImport);
+
+        callback.onIntentCompleted(
+                Activity.RESULT_OK, resultWith("content://docs/bookmarks.html"));
+
+        verify(mBridgeNatives)
+                .importFromUri(
+                        eq(mProfile), eq("content://docs/bookmarks.html"), any(), any());
+    }
+
+    @Test
+    public void testTheChosenDocumentIsWhatIsExportedTo() {
+        WindowAndroid.IntentCallback callback =
+                startAndCaptureCallback(mCoordinator::startExport);
+
+        callback.onIntentCompleted(Activity.RESULT_OK, resultWith("content://docs/out.html"));
+
+        verify(mBridgeNatives).exportToUri(eq(mProfile), eq("content://docs/out.html"), any());
+    }
+
+    // What the user is told.
+
+    @SuppressWarnings("unchecked")
+    private Callback<Integer> captureImportCallback() {
+        WindowAndroid.IntentCallback intentCallback =
+                startAndCaptureCallback(mCoordinator::startImport);
+        intentCallback.onIntentCompleted(Activity.RESULT_OK, resultWith("content://docs/b.html"));
+        ArgumentCaptor<Callback<Integer>> captor = ArgumentCaptor.forClass(Callback.class);
+        verify(mBridgeNatives).importFromUri(any(), any(), any(), captor.capture());
+        return captor.getValue();
+    }
+
+    @SuppressWarnings("unchecked")
+    private Callback<Boolean> captureExportCallback() {
+        WindowAndroid.IntentCallback intentCallback =
+                startAndCaptureCallback(mCoordinator::startExport);
+        intentCallback.onIntentCompleted(Activity.RESULT_OK, resultWith("content://docs/b.html"));
+        ArgumentCaptor<Callback<Boolean>> captor = ArgumentCaptor.forClass(Callback.class);
+        verify(mBridgeNatives).exportToUri(any(), any(), captor.capture());
+        return captor.getValue();
+    }
+
+    @Test
+    public void testImportingSeveralSaysHowMany() {
+        captureImportCallback().onResult(12);
+        assertEquals("12 bookmarks imported", lastSnackbarText());
+    }
+
+    @Test
+    public void testImportingOneSaysOne() {
+        captureImportCallback().onResult(1);
+        assertEquals("1 bookmark imported", lastSnackbarText());
+    }
+
+    @Test
+    public void testAFileWithNoBookmarksInItSaysSo() {
+        captureImportCallback().onResult(BookmarkHtmlBridge.IMPORT_FOUND_NOTHING);
+        assertEquals("No bookmarks found in that file", lastSnackbarText());
+    }
+
+    @Test
+    public void testAFileThatCouldNotBeReadSaysSo() {
+        captureImportCallback().onResult(BookmarkHtmlBridge.IMPORT_FAILED);
+        assertEquals("Couldn't import that file", lastSnackbarText());
+    }
+
+    @Test
+    public void testExportSaysWhenItWorked() {
+        captureExportCallback().onResult(true);
+        assertEquals("Bookmarks exported", lastSnackbarText());
+    }
+
+    @Test
+    public void testExportSaysWhenItDidNot() {
+        captureExportCallback().onResult(false);
+        assertEquals("Couldn't export bookmarks", lastSnackbarText());
+    }
+
+    @Test
+    public void testNoPickerMeansAnErrorRatherThanSilence() {
+        when(mWindowAndroid.showIntent(
+                        any(Intent.class), any(WindowAndroid.IntentCallback.class), any()))
+                .thenReturn(false);
+
+        mCoordinator.startImport();
+
+        assertEquals("Couldn't import that file", lastSnackbarText());
+        verify(mBridgeNatives, never()).importFromUri(any(), any(), any(), any());
+    }
+
+    @Test
+    public void testNothingIsShownBeforeTheUserHasChosen() {
+        mCoordinator.startImport();
+        mCoordinator.startExport();
+
+        verify(mSnackbarManager, never()).showSnackbar(any());
+        verify(mBridgeNatives, never()).importFromUri(any(), any(), any(), any());
+        verify(mBridgeNatives, never()).exportToUri(any(), any(), any());
+    }
+
+    @Test
+    public void testImportOnlyEverAddsToTheBookmarkModel() {
+        // There is one entry point into the bookmark model from here, and its name says it adds.
+        // Nothing in this class can ask for a wipe, because nothing offers one.
+        captureImportCallback().onResult(3);
+
+        verify(mBridgeNatives).importFromUri(any(), any(), any(), any());
+        verify(mBridgeNatives, never()).exportToUri(any(), any(), any());
+        assertEquals("3 bookmarks imported", lastSnackbarText());
+    }
+}

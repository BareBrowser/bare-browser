+    /**
+     * Saves a move: the item goes before or after the item now in the place it was dropped on,
+     * anywhere in the menu. Returns whether the order changed.
+     */
+    public static boolean onRowMoved(int movedItemId, int targetItemId, boolean after) {
+        if (!sEditMode) return false;
+        String moved = keyFor(movedItemId);
+        String target = keyFor(targetItemId);
+        if (moved == null || target == null || moved.equals(target)) return false;
+        List<String> shown = new ArrayList<>();
+        for (String key : sFullKeys) {
+            if (!sHiddenAtApply.contains(key)) shown.add(key);
+        }
+        if (!shown.contains(moved) || !shown.contains(target)) return false;
+        shown.remove(moved);
+        shown.add(shown.indexOf(target) + (after ? 1 : 0), moved);
+        List<String> full = new ArrayList<>(sFullKeys);
+        int next = 0;
+        for (int k = 0; k < full.size(); k++) {
+            if (!sHiddenAtApply.contains(full.get(k))) full.set(k, shown.get(next++));
+        }
+        if (full.equals(sFullKeys)) return false;
+        List<String> older = savedOrder();
+        if (older.isEmpty()) older = legacyOrder();
+        writeOrder(mergeOthers(full, older));
+        return true;
+    }

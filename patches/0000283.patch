+     * name before it in {@code older} that is already there, or first. Items another page has
+     * keep their place among the rest.
+     */
+    private static List<String> mergeOthers(List<String> order, List<String> older) {
+        List<String> result = new ArrayList<>(order);
+        String before = null;
+        for (String key : older) {
+            if (!result.contains(key)) {
+                int at = before == null ? 0 : result.indexOf(before) + 1;
+                result.add(at, key);
+            }
+            before = key;
+        }
+        return result;
+    }

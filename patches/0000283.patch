+    /** Puts the rows in the user's order over the places rows have, leaving the rest in place. */
+    private static void placeKeyed(ModelList list, List<String> order) {
+        List<Integer> places = places(list);
+        List<ListItem> items = new ArrayList<>();
+        List<String> keys = new ArrayList<>();
+        for (int place : places) {
+            items.add(list.get(place));
+            keys.add(assumeNonNull(keyOf(list.get(place))));
+        }
+        sFullKeys.clear();
+        if (order.isEmpty()) {
+            sFullKeys.addAll(keys);
+            return;
+        }
+        List<Integer> sorted = sortedIndexes(keys, order);
+        for (int k = 0; k < places.size(); k++) {
+            ListItem item = items.get(sorted.get(k));
+            sFullKeys.add(keys.get(sorted.get(k)));
+            if (item != list.get(places.get(k))) list.update(places.get(k), item);
+        }
+    }

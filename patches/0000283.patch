+    /**
+     * Ranks rows by {@code order}. A row the order does not name goes right after the row before
+     * it in the menu as built, so a new item shows where the menu puts it.
+     */
+    private static double[] ranks(List<String> keys, List<String> order) {
+        double[] ranks = new double[keys.size()];
+        double previous = -1;
+        for (int k = 0; k < keys.size(); k++) {
+            int at = order.indexOf(keys.get(k));
+            ranks[k] = at >= 0 ? at : previous + 0.001;
+            previous = ranks[k];
+        }
+        return ranks;
+    }
+
+    /** The keys of {@code keys} sorted by rank, stable. */
+    private static List<Integer> sortedIndexes(List<String> keys, List<String> order) {
+        double[] ranks = ranks(keys, order);
+        List<Integer> indexes = new ArrayList<>();
+        for (int k = 0; k < keys.size(); k++) indexes.add(k);
+        indexes.sort((a, b) -> Double.compare(ranks[a], ranks[b]));
+        return indexes;
+    }
+
+    /**
+     * The one order for the whole menu, from what 2.0.2 saved: each run sorted as 2.0.2 sorted it,
+     * the runs in the order they are shown, then the saved names this page does not have, each
+     * after the name it followed. Worked out each time and never written, so the old setting stays
+     * as it was for a downgrade.
+     */
+    private static List<String> legacyToGlobal(ModelList list, List<String> legacy) {
+        List<String> result = new ArrayList<>();
+        List<String> run = new ArrayList<>();
+        for (int i = 0; i <= list.size(); i++) {
+            boolean boundary = i == list.size() || list.get(i).type == AppMenuItemType.DIVIDER;
+            if (!boundary) {
+                String key = keyOf(list.get(i));
+                if (key != null) run.add(key);
+                continue;
+            }
+            for (int index : sortedIndexes(run, legacy)) result.add(run.get(index));
+            run.clear();
+        }
+        return mergeOthers(result, legacy);
+    }

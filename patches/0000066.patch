     <style name="TextAppearance.TextAccentMediumThick.ColorOnPrimaryContainer">
         <item name="android:textColor">?attr/colorOnPrimaryContainer</item>
     </style>
+    <!-- Bare: true-black surfaces for AMOLED panels, layered on top of the dark
+         theme when the user picks "Dark AMOLED". Only the flat, full-bleed
+         surfaces go to #000 so those pixels switch off entirely; the container
+         ramp keeps a small lift so menus, dialogs and sheets remain separable
+         from the content behind them. Foreground and accent colours are left to
+         the dark theme so contrast is unchanged. -->
+    <style name="ThemeOverlay.BrowserUI.Amoled" parent="">
+        <!-- Flat, full-bleed surfaces go fully black so the pixels switch off.
+             colorSurfaceContainerHigh is included because Chromium settings use
+             it for the page background, not for a raised surface. -->
+        <item name="android:colorBackground">#FF000000</item>
+        <item name="colorSurface">#FF000000</item>
+        <item name="colorSurfaceDim">#FF000000</item>
+        <item name="colorSurfaceContainerLow">#FF000000</item>
+        <item name="colorSurfaceContainer">#FF000000</item>
+        <item name="colorSurfaceContainerHigh">#FF000000</item>
+        <!-- Genuinely raised surfaces (cards, menus, sheets) keep a small lift so
+             they stay separable from the black behind them. -->
+        <item name="colorSurfaceContainerHighest">#FF141414</item>
+        <item name="colorSurfaceBright">#FF141414</item>
+        <!-- Incognito reaches these through attrs rather than the theme's own
+             surface tokens, so it needs its own pair. -->
+        <item name="colorIncognitoSurface">#FF000000</item>
+        <item name="colorIncognitoSurfaceRaised">#FF141414</item>
+    </style>
 </resources>

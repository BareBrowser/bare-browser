From 2efd206c1e90ea270335b300e2c9294823fd093f Mon Sep 17 00:00:00 2001
From: Bare <git@barebrowser.org>
Date: Sun, 8 Nov 2026 06:55:52 +0000
Subject: [PATCH] Patch 0000055

---
 chrome/common/extensions/api/api_sources.gni | 21 +++++++++++++++-----
 1 file changed, 16 insertions(+), 5 deletions(-)

diff --git a/chrome/common/extensions/api/api_sources.gni b/chrome/common/extensions/api/api_sources.gni
index acdc60b6758..dac5a25a49a 100644
--- a/chrome/common/extensions/api/api_sources.gni
+++ b/chrome/common/extensions/api/api_sources.gni
@@ -60,9 +60,25 @@ if (enable_guest_view) {
 # registration. These do not generate the strong C++ types.
 uncompiled_sources_ = [
   "action.json",
+  # Bare: browser_action and page_action are the MV2 spellings of action.json
+  # above. Upstream only bundles them when the full extensions system is built,
+  # but their API features are declared unconditionally, so on desktop-android
+  # the feature exists while the schema does not. GetAPISchema() in
+  # native_extension_bindings_system.cc turns that mismatch into
+  # LOG_IF(FATAL, !schema) << "Unknown API", so the renderer aborts the moment
+  # any MV2 extension touches chrome.browserAction. uBlock Origin does this from
+  # its background page, which showed up as the extension endlessly reloading
+  # and eventually took the browser process down with it.
+  #
+  # The implementation side is already present in this configuration
+  # (extension_action_api, extension_action_handler and the Android action UI
+  # under chrome/browser/ui/android/extensions), so only the schemas were
+  # missing.
+  "browser_action.json",
   "browsing_data.json",
   "commands.json",
   "extension.json",
+  "page_action.json",
   "top_sites.json",
 ]
 
@@ -150,11 +166,6 @@ if (enable_extensions) {
     schema_sources_ += [ "pdf_viewer_private.idl" ]
   }
 
-  uncompiled_sources_ += [
-    "browser_action.json",
-    "page_action.json",
-  ]
-
   if (is_chromeos) {
     uncompiled_sources_ += [
       "chromeos_info_private.json",

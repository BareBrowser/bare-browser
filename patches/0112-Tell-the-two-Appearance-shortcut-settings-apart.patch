From 639e7a3e3482129ffc85541272d7612b8e5873e2 Mon Sep 17 00:00:00 2001
From: Bare <git@barebrowser.org>
Date: Sun, 6 Sep 2026 19:58:37 +0000
Subject: [PATCH] Tell the two Appearance shortcut settings apart

Appearance listed "Toolbar shortcut" and "Toolbar" one after the other, and
the two names were close enough that neither told you which one you wanted.
They control different things: the first is the single configurable button
that sits in the address bar, the second is the row of buttons along the
bottom bar.

Renamed to "Address bar shortcut" and "Toolbar shortcuts", each naming where
its buttons live. Both ids already back every place their screen is titled,
so the row in Appearance, the sub-screen heading and the adaptive toolbar
on/off switch all follow from these two lines.

Labels only. No preference key, route, default or behaviour changes.
---
 .../browser/ui/android/strings/android_chrome_strings.grd   | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/chrome/browser/ui/android/strings/android_chrome_strings.grd b/chrome/browser/ui/android/strings/android_chrome_strings.grd
index 59fda4a1885..6d3b1d95791 100644
--- a/chrome/browser/ui/android/strings/android_chrome_strings.grd
+++ b/chrome/browser/ui/android/strings/android_chrome_strings.grd
@@ -4222,8 +4222,8 @@ To change this setting, <ph name="BEGIN_LINK">BEGIN_LINK</ph>delete the Chrome d
       <message name="IDS_ADAPTIVE_TOOLBAR_BUTTON_PREFERENCE_BASED_ON_WINDOW_WIDTH_DESCRIPTION" desc="Description for based window width option.">
         Hidden when the browser window is wide
       </message>
-      <message name="IDS_TOOLBAR_SHORTCUT" desc="Title for toolbar shortcut toggle button in adaptive toolbar button preference page.">
-        Toolbar shortcut
+      <message name="IDS_TOOLBAR_SHORTCUT" desc="Title for the address bar shortcut toggle button in adaptive toolbar button preference page.">
+        Address bar shortcut
       </message>
       <message name="IDS_BARE_OPEN_LINKS_IN_APPS_TITLE" desc="Title of the setting for whether a link that an installed app can handle opens in that app.">
         Open links in apps
@@ -4247,7 +4247,7 @@ To change this setting, <ph name="BEGIN_LINK">BEGIN_LINK</ph>delete the Chrome d
         List
       </message>
       <message name="IDS_BARE_TOOLBAR_SETTINGS_TITLE" desc="Title of the settings screen for choosing which buttons appear on the browser toolbar.">
-        Toolbar
+        Toolbar shortcuts
       </message>
       <message name="IDS_BARE_TOOLBAR_SETTINGS_CHOOSE_ACTION" desc="Title of the dialog for choosing which button goes in one toolbar position.">
         Choose a button

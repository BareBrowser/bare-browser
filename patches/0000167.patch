+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.bare;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertNotNull;
+
+import android.app.Activity;
+import android.view.View;
+
+import androidx.test.ext.junit.rules.ActivityScenarioRule;
+
+import org.junit.Before;
+import org.junit.Rule;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+
+import org.chromium.base.Callback;
+import org.chromium.base.test.BaseRobolectricTestRunner;
+import org.chromium.chrome.browser.ActivityTabProvider;
+import org.chromium.chrome.browser.ui.actions.ActionId;
+import org.chromium.chrome.browser.ui.actions.ActionProperties;
+import org.chromium.chrome.browser.ui.actions.ActionRegistry;
+import org.chromium.ui.base.TestActivity;
+import org.chromium.ui.modelutil.PropertyModel;
+
+/** Unit tests for the actions {@link BareToolbarActionCatalogue} registers itself. */
+@RunWith(BaseRobolectricTestRunner.class)
+public class BareToolbarActionCatalogueUnitTest {
+    @Rule
+    public ActivityScenarioRule<TestActivity> mActivityScenarioRule =
+            new ActivityScenarioRule<>(TestActivity.class);
+
+    private Activity mActivity;
+    private ActionRegistry mRegistry;
+    private int mFinds;
+    private int mSearches;
+
+    @Before
+    public void setUp() {
+        mActivityScenarioRule.getScenario().onActivity(activity -> mActivity = activity);
+        mRegistry = new ActionRegistry();
+        // No provider exists for any of the adapted actions here, which is the case where only the
+        // plain ones are published.
+        new BareToolbarActionCatalogue(
+                variant -> null,
+                new ActivityTabProvider(),
+                mRegistry,
+                mActivity,
+                () -> mFinds++,
+                () -> mSearches++);
+    }
+
+    private void press(@ActionId int action) {
+        PropertyModel model = mRegistry.get(action).get();
+        assertNotNull("action " + action + " is not registered", model);
+        Callback<View> callback = model.get(ActionProperties.ON_PRESS_CALLBACK);
+        assertNotNull(callback);
+        callback.onResult(new View(mActivity));
+    }
+
+    @Test
+    public void testFindInPageRunsItsHandler() {
+        press(ActionId.FIND_IN_PAGE);
+        assertEquals(1, mFinds);
+        assertEquals(0, mSearches);
+    }
+
+    @Test
+    public void testSearchRunsItsHandler() {
+        press(ActionId.SEARCH);
+        assertEquals(0, mFinds);
+        assertEquals(1, mSearches);
+    }
+}

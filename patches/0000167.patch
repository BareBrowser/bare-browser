+    /**
+     * Publishes an action that needs nothing from the page: pressing it just runs something.
+     *
+     * <p>Find in page and Search are always available. Neither depends on what the tab holds, and
+     * both have somewhere to go on the new tab page too, so there is no state to follow.
+     */
+    private static void registerPlain(
+            ActionRegistry registry,
+            @ActionId int actionId,
+            @DrawableRes int icon,
+            @StringRes int label,
+            Runnable onPress) {
+        ActionUtils.registerAction(
+                registry, actionId, ActionProperties.BASE_KEYS, icon, label, label);
+        PropertyModel model = registry.get(actionId).get();
+        if (model != null) {
+            model.set(ActionProperties.ON_PRESS_CALLBACK, (Callback<View>) v -> onPress.run());
+        }
+    }
+
     /**
      * Publishes one action, if the provider behind it exists.

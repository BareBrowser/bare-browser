+
+Presence PresenceOf(const ExtensionRegistry* registry, const ExtensionId& id) {
+  const Extension* extension = registry->GetInstalledExtension(id);
+  if (!extension) {
+    return Presence::kAbsent;
+  }
+  return extension->location() == mojom::ManifestLocation::kExternalPref
+             ? Presence::kInstalledByBare
+             : Presence::kInstalledElsewhere;
+}
+
+// Records what the user set on the store copy, everything Chromium keeps outside
+// the extension's own storage: whether it was switched off, incognito and file
+// access, its place among the pinned extensions, and site access.
+base::DictValue CaptureCarryOver(content::BrowserContext* context,
+                                 const ExtensionId& from) {
+  ExtensionPrefs* prefs = ExtensionPrefs::Get(context);
+  base::DictValue state;
+  state.Set(kKeyFrom, from);
+  state.Set(kKeyDisabledByUser,
+            prefs->HasDisableReason(from, disable_reason::DISABLE_USER_ACTION));
+  bool incognito = false;
+  if (prefs->ReadPrefAsBoolean(from, "incognito", &incognito)) {
+    state.Set(kKeyIncognito, incognito);
+  }
+  state.Set(kKeyFileAccess, prefs->AllowFileAccess(from));
+
+  const ExtensionIdList pinned = prefs->GetPinnedExtensions();
+  auto it = std::ranges::find(pinned, from);
+  if (it != pinned.end()) {
+    state.Set(kKeyPinnedIndex, static_cast<int>(it - pinned.begin()));
+  }
+
+  const Extension* extension =
+      ExtensionRegistry::Get(context)->GetInstalledExtension(from);
+  PermissionsManager* permissions = PermissionsManager::Get(context);
+  if (extension && permissions->CanAffectExtension(*extension) &&
+      permissions->HasWithheldHostPermissions(*extension)) {
+    state.Set(kKeyWithheld, true);
+    base::ListValue hosts;
+    std::unique_ptr<PermissionSet> granted =
+        permissions->GetRuntimePermissionsFromPrefs(*extension);
+    if (granted) {
+      for (const URLPattern& pattern : granted->explicit_hosts()) {
+        hosts.Append(pattern.GetAsString());
+      }
+    }
+    state.Set(kKeyGrantedHosts, std::move(hosts));
+  }
+  return state;
+}
+
+// Copies the store copy's chrome.storage.local, which is where uBlock Origin
+// keeps everything the user chose -- filter lists, their own filters, trusted
+// sites, dynamic rules -- to the shipped copy's id, then records the settings
+// held outside it. Runs on the storage backend's sequence, so no write from the
+// running extension lands halfway through the copy.
+//
+// The copy is left alone if the shipped copy already has storage, so a carry-
+// over interrupted after the copy is not repeated over what has happened since.
+bool CarryOverStorage(const base::FilePath& profile_dir,
+                      const ExtensionId& from,
+                      const ExtensionId& to,
+                      const base::FilePath& record,
+                      const std::string& record_json) {
+  const base::FilePath root =
+      profile_dir.Append(kLocalExtensionSettingsDirectoryName);
+  const base::FilePath source = root.AppendASCII(from);
+  const base::FilePath target = root.AppendASCII(to);
+  if (!base::PathExists(target) && base::PathExists(source)) {
+    const base::FilePath partial = root.AppendASCII(to + ".partial");
+    base::DeletePathRecursively(partial);
+    if (!base::CopyDirectory(source, partial, /*recursive=*/true) ||
+        !base::Move(partial, target)) {
+      LOG(ERROR) << "Bare: could not copy extension storage to " << target;
+      base::DeletePathRecursively(partial);
+      return false;
+    }
+  }
+  if (record.empty() || !base::CreateDirectory(record.DirName()) ||
+      !base::ImportantFileWriter::WriteFileAtomically(record, record_json)) {
+    LOG(ERROR) << "Bare: could not record the carried-over settings";
+    return false;
+  }
+  return true;
+}
+
+std::optional<base::DictValue> ReadCarryOver(const base::FilePath& record) {
+  std::string json;
+  if (record.empty() || !base::ReadFileToString(record, &json)) {
+    return std::nullopt;
+  }
+  std::optional<base::Value> value = base::JSONReader::Read(json);
+  if (!value || !value->is_dict()) {
+    return std::nullopt;
+  }
+  return std::move(value->GetDict());
+}
+
+base::FilePath CarryOverRecordPath() {
+  const base::FilePath dir = BundledDir();
+  return dir.empty() ? base::FilePath() : dir.Append(kCarryOverRecord);
 }
 

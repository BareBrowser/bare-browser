+// Once the shipped copy has loaded, gives it the settings the store copy had,
+// then forgets them. Nothing happens on a profile that was never carried over:
+// there is no record to read. Owns itself, like the applier above.
+class BundledCarryOverApplier : public ExtensionRegistryObserver {
+ public:
+  static void Start(content::BrowserContext* context) {
+    new BundledCarryOverApplier(context);  // Deletes itself.
+  }
+
+  BundledCarryOverApplier(const BundledCarryOverApplier&) = delete;
+  BundledCarryOverApplier& operator=(const BundledCarryOverApplier&) = delete;
+
+  ~BundledCarryOverApplier() override = default;
+
+ private:
+  explicit BundledCarryOverApplier(content::BrowserContext* context)
+      : context_(context) {
+    ExtensionRegistry* registry = ExtensionRegistry::Get(context_);
+    observation_.Observe(registry);
+    if (registry->enabled_extensions().GetByID(kUBlockOriginId)) {
+      ReadRecord();
+    }
+  }
+
+  void OnExtensionLoaded(content::BrowserContext* browser_context,
+                         const Extension* extension) override {
+    if (extension->id() == kUBlockOriginId) {
+      ReadRecord();
+    }
+  }
+
+  void OnShutdown(ExtensionRegistry* registry) override { Finish(); }
+
+  void ReadRecord() {
+    if (reading_) {
+      return;
+    }
+    // Detached for the same reason as the incognito default: what follows
+    // reloads the extension.
+    reading_ = true;
+    observation_.Reset();
+    base::ThreadPool::PostTaskAndReplyWithResult(
+        FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+        base::BindOnce(&ReadCarryOver, CarryOverRecordPath()),
+        base::BindOnce(&BundledCarryOverApplier::Apply,
+                       weak_factory_.GetWeakPtr()));
+  }
+
+  void Apply(std::optional<base::DictValue> state) {
+    if (!state) {
+      Finish();
+      return;
+    }
+    ExtensionRegistry* registry = ExtensionRegistry::Get(context_);
+    const Extension* extension =
+        registry->GetInstalledExtension(kUBlockOriginId);
+    if (!extension) {
+      Finish();  // Gone again. The record stays for the next launch.
+      return;
+    }
+
+    // Site access first: it needs the extension object, and the steps after it
+    // reload the extension and replace that object.
+    PermissionsManager* permissions = PermissionsManager::Get(context_);
+    if (state->FindBool(kKeyWithheld).value_or(false) &&
+        permissions->CanAffectExtension(*extension)) {
+      ScriptingPermissionsModifier modifier(context_,
+                                            base::WrapRefCounted(extension));
+      modifier.SetWithholdHostPermissions(true);
+      if (const base::ListValue* hosts = state->FindList(kKeyGrantedHosts)) {
+        for (const base::Value& host : *hosts) {
+          URLPattern pattern(Extension::kValidHostPermissionSchemes);
+          if (host.is_string() &&
+              pattern.Parse(host.GetString()) ==
+                  URLPattern::ParseResult::kSuccess) {
+            modifier.GrantHostPermission(pattern, base::DoNothing());
+          }
+        }
+      }
+    }
+
+    ExtensionPrefs* prefs = ExtensionPrefs::Get(context_);
+    if (std::optional<int> index = state->FindInt(kKeyPinnedIndex)) {
+      ExtensionIdList pinned = prefs->GetPinnedExtensions();
+      if (!std::ranges::contains(pinned, kUBlockOriginId)) {
+        const size_t at =
+            std::min(static_cast<size_t>(std::max(*index, 0)), pinned.size());
+        pinned.insert(pinned.begin() + at, kUBlockOriginId);
+        prefs->SetPinnedExtensions(pinned);
+      }
+    }
+
+    if (state->FindBool(kKeyFileAccess).value_or(false)) {
+      util::SetAllowFileAccess(kUBlockOriginId, context_, true);
+    }
+    if (std::optional<bool> incognito = state->FindBool(kKeyIncognito)) {
+      util::SetIsIncognitoEnabled(kUBlockOriginId, context_, *incognito);
+    }
+    // Last, since a disabled extension is no longer reloaded by the above.
+    if (state->FindBool(kKeyDisabledByUser).value_or(false)) {
+      ExtensionRegistrar::Get(context_)->DisableExtension(
+          kUBlockOriginId, {disable_reason::DISABLE_USER_ACTION});
+    }
+
+    LOG(WARNING) << "Bare: carried settings over from "
+                 << (state->FindString(kKeyFrom) ? *state->FindString(kKeyFrom)
+                                                 : std::string())
+                 << " to " << kUBlockOriginId;
+    base::ThreadPool::PostTask(
+        FROM_HERE, {base::MayBlock(), base::TaskPriority::BEST_EFFORT},
+        base::GetDeleteFileCallback(CarryOverRecordPath()));
+    Finish();
+  }
+
+  void Finish() {
+    observation_.Reset();
+    base::SingleThreadTaskRunner::GetCurrentDefault()->DeleteSoon(FROM_HERE,
+                                                                 this);
+  }
+
+  raw_ptr<content::BrowserContext> context_;
+  bool reading_ = false;
+  base::ScopedObservation<ExtensionRegistry, ExtensionRegistryObserver>
+      observation_{this};
+  base::WeakPtrFactory<BundledCarryOverApplier> weak_factory_{this};
+};
+
+void ApplyBundledExtensionCarryOver(content::BrowserContext* context) {
+  BundledCarryOverApplier::Start(context);
+}
+
+BareBundledExtensionsLoader::BareBundledExtensionsLoader(Profile* profile)
+    : profile_(profile->GetWeakPtr()) {}
 
 BareBundledExtensionsLoader::~BareBundledExtensionsLoader() = default;
 
 void BareBundledExtensionsLoader::StartLoading() {
+  if (!profile_) {
+    return;
+  }
+  ExtensionRegistry* registry = ExtensionRegistry::Get(profile_.get());
+  ExtensionPrefs* prefs = ExtensionPrefs::Get(profile_.get());
+
+  bare_bundled_extensions::ProfileState state;
+  // Bare: the welcome screen can decline the bundled ad blocker. Once it is not
+  // offered, the external provider treats it as withdrawn and uninstalls it on
+  // the next launch. That is the one case where leaving it out is meant.
+  base::android::SharedPreferencesManager shared_prefs =
+      android::shared_preferences::GetChromeSharedPreferences();
+  state.offer_enabled =
+      shared_prefs.ReadBoolean("Chrome.Bare.BundledAdBlockerEnabled", true);
+  state.current = PresenceOf(registry, kUBlockOriginId);
+  state.current_removed_by_user =
+      prefs->IsExternalExtensionUninstalled(kUBlockOriginId);
+  state.predecessor = PresenceOf(registry, kStoreUBlockOriginId);
+  state.predecessor_removed_by_user =
+      prefs->IsExternalExtensionUninstalled(kStoreUBlockOriginId);
+  const Plan plan = bare_bundled_extensions::DecidePlan(state);
+
+  if (plan != Plan::kCarryOverThenOfferCurrent) {
+    OnCarriedOver(plan, /*carried_over=*/false);
+    return;
+  }
+
+  std::optional<std::string> record_json = base::WriteJson(
+      CaptureCarryOver(profile_.get(), kStoreUBlockOriginId));
+  GetBackendTaskRunner()->PostTaskAndReplyWithResult(
+      FROM_HERE,
+      base::BindOnce(&CarryOverStorage, profile_->GetPath(),
+                     std::string(kStoreUBlockOriginId),
+                     std::string(kUBlockOriginId), CarryOverRecordPath(),
+                     record_json.value_or(std::string())),
+      base::BindOnce(&BareBundledExtensionsLoader::OnCarriedOver, this, plan));
+}
+
+void BareBundledExtensionsLoader::OnCarriedOver(Plan plan, bool carried_over) {
   // Unpacking 4MB out of the apk is file work, so keep it off the UI thread.
   base::ThreadPool::PostTaskAndReplyWithResult(
       FROM_HERE, {base::MayBlock(), base::TaskPriority::BEST_EFFORT},
-      base::BindOnce(&BuildPrefs),
+      base::BindOnce(&BuildPrefs, plan, carried_over),
       base::BindOnce(&BareBundledExtensionsLoader::OnPrefsBuilt, this));
 }
 

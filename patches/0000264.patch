diff --git a/chrome/browser/search_engines/android/java/src/org/chromium/chrome/browser/search_engines/settings/BareEngineLogos.java b/chrome/browser/search_engines/android/java/src/org/chromium/chrome/browser/search_engines/settings/BareEngineLogos.java
new file mode 100644
index 00000000000..9071a0f67aa
--- /dev/null
+++ b/chrome/browser/search_engines/android/java/src/org/chromium/chrome/browser/search_engines/settings/BareEngineLogos.java
@@ -0,0 +1,67 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.search_engines.settings;
+
+import android.content.Context;
+import android.graphics.Bitmap;
+import android.graphics.BitmapFactory;
+import android.net.Uri;
+
+import androidx.annotation.DrawableRes;
+
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.chrome.browser.search_engines.R;
+import org.chromium.url.GURL;
+
+import java.util.HashMap;
+import java.util.Map;
+
+/**
+ * The logos of the search engines Bare lists, kept in the app. Bare has no built-in icons and the
+ * favicon of an engine is not always stored, so without these every engine shows the same globe.
+ */
+@NullMarked
+public final class BareEngineLogos {
+    private static final Map<Integer, Bitmap> sCache = new HashMap<>();
+
+    private BareEngineLogos() {}
+
+    /** The logo for the engine whose search page is {@code url}, or null if Bare has none. */
+    public static @Nullable Bitmap get(Context context, GURL url) {
+        if (url == null || !url.isValid()) return null;
+        return get(context, url.getHost());
+    }
+
+    /**
+     * The logo for an engine given by its host or by a search address, which may hold a
+     * placeholder for the query. A host on a subdomain of the engine's own counts.
+     */
+    public static @Nullable Bitmap get(Context context, @Nullable String hostOrUrl) {
+        String host = hostOrUrl;
+        if (host != null && host.contains("/")) host = Uri.parse(host).getHost();
+        @DrawableRes int id = drawableFor(host);
+        if (id == 0) return null;
+        Bitmap cached = sCache.get(id);
+        if (cached != null) return cached;
+        Bitmap decoded = BitmapFactory.decodeResource(context.getResources(), id);
+        if (decoded != null) sCache.put(id, decoded);
+        return decoded;
+    }
+
+    private static @DrawableRes int drawableFor(@Nullable String host) {
+        if (host == null) return 0;
+        if (isOn(host, "google.com")) return R.drawable.bare_engine_google;
+        if (isOn(host, "bing.com")) return R.drawable.bare_engine_bing;
+        if (isOn(host, "duckduckgo.com")) return R.drawable.bare_engine_duckduckgo;
+        if (isOn(host, "ecosia.org")) return R.drawable.bare_engine_ecosia;
+        if (isOn(host, "brave.com")) return R.drawable.bare_engine_brave;
+        return 0;
+    }
+
+    private static boolean isOn(String host, String domain) {
+        return host.equals(domain) || host.endsWith("." + domain);
+    }
+}
diff --git a/chrome/browser/search_engines/android/java/src/org/chromium/chrome/browser/search_engines/settings/SearchEngineIconUtils.java b/chrome/browser/search_engines/android/java/src/org/chromium/chrome/browser/search_engines/settings/SearchEngineIconUtils.java
index 2d64ec37c6c..47f1b20e72a 100644
--- a/chrome/browser/search_engines/android/java/src/org/chromium/chrome/browser/search_engines/settings/SearchEngineIconUtils.java
+++ b/chrome/browser/search_engines/android/java/src/org/chromium/chrome/browser/search_engines/settings/SearchEngineIconUtils.java
@@ -43,6 +43,12 @@ public class SearchEngineIconUtils {
             GURL pageUrl,
             LargeIconBridge largeIconBridge,
             @Nullable Map<GURL, Bitmap> iconCache) {
+        // Bare: the engines it lists have logos of their own, kept in the app.
+        @Nullable Bitmap bundled = BareEngineLogos.get(context, pageUrl);

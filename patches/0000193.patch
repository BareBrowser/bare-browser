diff --git a/chrome/browser/ui/android/bottombar/java/src/org/chromium/chrome/browser/ui/bottombar/BottomBarConfigUtilsUnitTest.java b/chrome/browser/ui/android/bottombar/java/src/org/chromium/chrome/browser/ui/bottombar/BottomBarConfigUtilsUnitTest.java
index e9939d905b7..0e2b39d8945 100644
--- a/chrome/browser/ui/android/bottombar/java/src/org/chromium/chrome/browser/ui/bottombar/BottomBarConfigUtilsUnitTest.java
+++ b/chrome/browser/ui/android/bottombar/java/src/org/chromium/chrome/browser/ui/bottombar/BottomBarConfigUtilsUnitTest.java
@@ -295,6 +295,22 @@ public class BottomBarConfigUtilsUnitTest {
     @Test
     @DisableFeatures(ChromeFeatureList.ANDROID_BOTTOM_BAR)
     public void testShouldForceBothConstraints_BottomBarDisabled() {
+        // Bare does not turn the new tab page off for the bottom bar (disable_on_ntp is false by
+        // default), so a native page keeps its constraints whether or not the bar is on.
+        when(mTab.isIncognito()).thenReturn(false);
+        when(mTab.getNativePage()).thenReturn(mNativePage);
+        when(mNativePage.getHost()).thenReturn("newtab");
+        when(mTab.isNativePage()).thenReturn(true);
+
+        assertTrue(
+                BottomBarConfigUtils.shouldForceBothConstraintsForBottomControls(mTab, mContext));
+    }
+
+    @Test
+    @DisableFeatures(ChromeFeatureList.ANDROID_BOTTOM_BAR)
+    @EnableFeatures(ChromeFeatureList.ANDROID_BOTTOM_BAR + ":disable_on_ntp/true")
+    public void testShouldForceBothConstraints_NtpTurnedOffByParam() {
+        // The stock setting is still honoured when it is asked for.
         when(mTab.isIncognito()).thenReturn(false);
         when(mTab.getNativePage()).thenReturn(mNativePage);
         when(mNativePage.getHost()).thenReturn("newtab");

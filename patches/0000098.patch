+/** Unit tests for {@link BareButtonDataActionAdapter}. */
+@RunWith(BaseRobolectricTestRunner.class)
+public class BareButtonDataActionAdapterUnitTest {
+    @Rule public MockitoRule mMockitoRule = MockitoJUnit.rule().strictness(Strictness.LENIENT);
+
+    @Rule
+    public ActivityScenarioRule<TestActivity> mActivityScenarioRule =
+            new ActivityScenarioRule<>(TestActivity.class);
+
+    private Activity mActivity;
+    private ActivityTabProvider mTabProvider;
+    private ActionRegistry mRegistry;
+    private ButtonDataProvider mProvider;
+    private ButtonData mButtonData;
+
+    @Before
+    public void setUp() {
+        mActivityScenarioRule.getScenario().onActivity(activity -> mActivity = activity);
+        mTabProvider = new ActivityTabProvider();
+        mRegistry = new ActionRegistry();
+        mProvider = mock(ButtonDataProvider.class);
+        mButtonData = mock(ButtonData.class);
+        when(mProvider.get(null)).thenReturn(mButtonData);
+        when(mButtonData.canShow()).thenReturn(true);
+        when(mButtonData.isEnabled()).thenReturn(true);
+    }
+
+    private static ButtonSpec spec(Drawable drawable, boolean checked, boolean selected) {
+        return new ButtonSpec.Builder(drawable, "Share", /* supportsTinting= */ true)
+                .setOnClickListener(v -> {})
+                .setButtonVariant(AdaptiveToolbarButtonVariant.SHARE)
+                .setIsChecked(checked)
+                .setIsSelected(selected)
+                .build();
+    }
+
+    private BareButtonDataActionAdapter attach() {
+        return new BareButtonDataActionAdapter(
+                ActionId.SHARE, mProvider, mTabProvider, mRegistry, mActivity);
+    }
+
+    private PropertyModel model() {
+        PropertyModel model = mRegistry.get(ActionId.SHARE).get();
+        assertNotNull("the adapter should have published a model", model);
+        return model;
+    }
+
+    // ---- drawable isolation ------------------------------------------------------------------
+
+    @Test
+    public void testTheModelGetsACopyRatherThanTheProvidersOwnDrawable() {
+        Drawable source = new ColorDrawable(Color.RED);
+        when(mButtonData.getButtonSpec()).thenReturn(spec(source, false, false));
+
+        BareButtonDataActionAdapter adapter = attach();
+        Drawable published = model().get(ActionProperties.ICON_DRAWABLE);
+
+        assertNotNull(published);
+        assertNotSame(
+                "the bar must not be handed the provider's own Drawable", source, published);
+        assertNotSame(
+                "the copy must not share mutable state with the original",
+                source.getConstantState(),
+                published.getConstantState());
+        adapter.destroy();
+    }
+
+    @Test
+    public void testTheSameIconIsCopiedOnlyOnce() {
+        Drawable source = new ColorDrawable(Color.RED);
+        when(mButtonData.getButtonSpec()).thenReturn(spec(source, false, false));
+
+        BareButtonDataActionAdapter adapter = attach();
+        Drawable first = model().get(ActionProperties.ICON_DRAWABLE);
+
+        adapter.buttonDataChanged(true);
+        Drawable second = model().get(ActionProperties.ICON_DRAWABLE);
+
+        assertSame("a redraw should reuse the copy it already made", first, second);
+        adapter.destroy();
+    }
+
+    @Test
+    public void testAProviderWithTwoIconsGetsTwoStableCopies() {
+        // Bookmark swaps between an outline and a filled star, so the adapter sees two Drawables
+        // alternating and must keep a copy of each rather than rebuilding on every swap.
+        Drawable outline = new ColorDrawable(Color.RED);
+        Drawable filled = new ColorDrawable(Color.BLUE);
+
+        when(mButtonData.getButtonSpec()).thenReturn(spec(outline, false, false));
+        BareButtonDataActionAdapter adapter = attach();
+        Drawable outlineCopy = model().get(ActionProperties.ICON_DRAWABLE);
+
+        when(mButtonData.getButtonSpec()).thenReturn(spec(filled, false, false));
+        adapter.buttonDataChanged(true);
+        Drawable filledCopy = model().get(ActionProperties.ICON_DRAWABLE);
+
+        assertNotSame(outlineCopy, filledCopy);
+        assertNotSame(filled, filledCopy);
+
+        when(mButtonData.getButtonSpec()).thenReturn(spec(outline, false, false));
+        adapter.buttonDataChanged(true);
+        assertSame(
+                "returning to the first icon should return the first copy",
+                outlineCopy,
+                model().get(ActionProperties.ICON_DRAWABLE));
+        adapter.destroy();
+    }
+
+    // ---- selected / checked ------------------------------------------------------------------
+
+    @Test
+    public void testCheckedIsNotFoldedIntoSelected() {
+        // isChecked drives a contextual page action appearance the bottom bar has no equivalent
+        // for. Copying it into IS_SELECTED would draw a price-tracked page as selected.
+        Drawable source = new ColorDrawable(Color.RED);
+        when(mButtonData.getButtonSpec())
+                .thenReturn(spec(source, /* checked= */ true, /* selected= */ false));
+
+        BareButtonDataActionAdapter adapter = attach();
+        assertFalse(
+                "a checked action is not a selected one",
+                model().get(ActionProperties.IS_SELECTED));
+        adapter.destroy();
+    }
+
+    @Test
+    public void testSelectedIsCopied() {
+        Drawable source = new ColorDrawable(Color.RED);
+        when(mButtonData.getButtonSpec())
+                .thenReturn(spec(source, /* checked= */ false, /* selected= */ true));
+
+        BareButtonDataActionAdapter adapter = attach();
+        assertTrue(model().get(ActionProperties.IS_SELECTED));
+        adapter.destroy();
+    }
+
+    // ---- unavailable rather than absent ------------------------------------------------------
+
+    @Test
+    public void testAnActionThatCannotRunKeepsItsPlaceAndStopsResponding() {
+        Drawable source = new ColorDrawable(Color.RED);
+        when(mButtonData.getButtonSpec()).thenReturn(spec(source, false, false));
+        when(mButtonData.canShow()).thenReturn(false);
+
+        BareButtonDataActionAdapter adapter = attach();
+        PropertyModel model = model();
+
+        assertNull(
+                "an unavailable action should have nothing to press",
+                model.get(ActionProperties.ON_PRESS_CALLBACK));
+        assertNotNull(
+                "but it should still have an icon, so the bar does not reflow",
+                model.get(ActionProperties.ICON_DRAWABLE));
+        adapter.destroy();
+    }
+
+    @Test
+    public void testBecomingAvailableAgainRestoresThePress() {
+        Drawable source = new ColorDrawable(Color.RED);
+        when(mButtonData.getButtonSpec()).thenReturn(spec(source, false, false));
+        when(mButtonData.canShow()).thenReturn(false);
+
+        BareButtonDataActionAdapter adapter = attach();
+        assertNull(model().get(ActionProperties.ON_PRESS_CALLBACK));
+
+        when(mButtonData.canShow()).thenReturn(true);
+        adapter.buttonDataChanged(true);
+        assertNotNull(model().get(ActionProperties.ON_PRESS_CALLBACK));
+        adapter.destroy();
+    }
+
+    // ---- lifetime ----------------------------------------------------------------------------
+
+    @Test
+    public void testDestroyUnregistersAndIsSafeToRepeat() {
+        Drawable source = new ColorDrawable(Color.RED);
+        when(mButtonData.getButtonSpec()).thenReturn(spec(source, false, false));
+
+        BareButtonDataActionAdapter adapter = attach();
+        assertNotNull(mRegistry.get(ActionId.SHARE).get());
+
+        adapter.destroy();
+        assertNull(
+                "the action should no longer be offered", mRegistry.get(ActionId.SHARE).get());
+
+        adapter.destroy();
+    }
+
+    @Test
+    public void testTheProvidersContentDescriptionIsPublished() {
+        Drawable source = new ColorDrawable(Color.RED);
+        when(mButtonData.getButtonSpec()).thenReturn(spec(source, false, false));
+
+        BareButtonDataActionAdapter adapter = attach();
+        assertEquals(
+                "Share",
+                model()
+                        .get(ActionProperties.CONTENT_DESCRIPTION_RESOLVER)
+                        .resolve(mActivity)
+                        .toString());
+        adapter.destroy();
+    }
+
+    @Test
+    public void testPressingRunsTheProvidersOwnClickHandling() {
+        boolean[] clicked = new boolean[1];
+        Drawable source = new ColorDrawable(Color.RED);
+        ButtonSpec buttonSpec =
+                new ButtonSpec.Builder(source, "Share", /* supportsTinting= */ true)
+                        .setOnClickListener(v -> clicked[0] = true)
+                        .setButtonVariant(AdaptiveToolbarButtonVariant.SHARE)
+                        .build();
+        when(mButtonData.getButtonSpec()).thenReturn(buttonSpec);
+
+        BareButtonDataActionAdapter adapter = attach();
+        model().get(ActionProperties.ON_PRESS_CALLBACK).onResult(new View(mActivity));
+
+        assertTrue("the provider's own listener should have run", clicked[0]);
+        adapter.destroy();
+    }
+}

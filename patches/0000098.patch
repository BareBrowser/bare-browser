+package org.chromium.chrome.browser.ui.bottombar;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertNotEquals;
+import static org.junit.Assert.assertTrue;
+
+import org.junit.After;
+import org.junit.Before;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+
+import org.chromium.base.shared_preferences.SharedPreferencesManager;
+import org.chromium.base.test.BaseRobolectricTestRunner;
+import org.chromium.chrome.browser.preferences.ChromePreferenceKeys;
+import org.chromium.chrome.browser.preferences.ChromeSharedPreferences;
+import org.chromium.chrome.browser.ui.actions.ActionId;
+
+/** Unit tests for {@link BareToolbarLayout} and the arrangement it resolves. */
+@RunWith(BaseRobolectricTestRunner.class)
+public class BareToolbarLayoutUnitTest {
+
+    private SharedPreferencesManager mPrefs;
+
+    @Before
+    public void setUp() {
+        mPrefs = ChromeSharedPreferences.getInstance();
+        clearStored();
+    }
+
+    @After
+    public void tearDown() {
+        clearStored();
+    }
+
+    private void clearStored() {
+        for (int slot = 0; slot < BareToolbarSlot.COUNT; slot++) {
+            mPrefs.removeKey(key(slot));
+        }
+        BareToolbarLayout.invalidate();
+    }
+
+    private static String key(@BareToolbarSlot int slot) {
+        return ChromePreferenceKeys.BOTTOM_BAR_SLOT_PRIMARY_ACTION.createKey(slot);
+    }
+
+    /** Stores an arrangement and forgets whatever was resolved from the previous one. */
+    private void store(int home, int extra, int appMenu) {
+        if (home != UNSET) mPrefs.writeInt(key(BareToolbarSlot.HOME), home);
+        if (extra != UNSET) mPrefs.writeInt(key(BareToolbarSlot.EXTRA), extra);
+        if (appMenu != UNSET) mPrefs.writeInt(key(BareToolbarSlot.APP_MENU), appMenu);
+        BareToolbarLayout.invalidate();
+    }
+
+    private static final int UNSET = -1;
+
+    /** Asserts the three configurable positions, and that the two fixed ones did not move. */
+    private void assertBar(int home, int extra, int appMenu) {
+        assertEquals("home slot", home, BareToolbarLayout.actionForSlot(BareToolbarSlot.HOME));
+        assertEquals("extra slot", extra, BareToolbarLayout.actionForSlot(BareToolbarSlot.EXTRA));
+        assertEquals(
+                "app menu slot", appMenu, BareToolbarLayout.actionForSlot(BareToolbarSlot.APP_MENU));
+        assertEquals(
+                "new tab is fixed",
+                ActionId.NEW_TAB,
+                BareToolbarLayout.actionForSlot(BareToolbarSlot.NEW_TAB));
+        assertEquals(
+                "tab switcher is fixed",
+                ActionId.TAB_SWITCHER,
+                BareToolbarLayout.actionForSlot(BareToolbarSlot.TAB_SWITCHER));
+        assertDistinct(home, extra, appMenu);
+    }
+
+    /** The bar holds buttons in a map keyed by action, so a repeat is unrenderable, not just odd. */
+    private void assertDistinct(int home, int extra, int appMenu) {
+        assertNotEquals("home and extra hold the same action", home, extra);
+        assertNotEquals("home and app menu hold the same action", home, appMenu);
+        assertNotEquals("extra and app menu hold the same action", extra, appMenu);
+        for (int action : new int[] {home, extra, appMenu}) {
+            assertTrue(
+                    "resolved action " + action + " is not one Bare offers",
+                    BareToolbarDefaults.isConfigurableAction(action));
+        }
+    }
+
+    @Test
+    public void testNoPreferences_resolvesToTheArrangementBareShipped() {
+        assertBar(ActionId.HOME_BUTTON, ActionId.INCOGNITO, ActionId.APP_MENU);
+    }
+
+    @Test
+    public void testResolvingDoesNotWriteAnything() {
+        BareToolbarLayout.actionForSlot(BareToolbarSlot.HOME);
+        BareToolbarLayout.actionForSlot(BareToolbarSlot.EXTRA);
+        BareToolbarLayout.actionForSlot(BareToolbarSlot.APP_MENU);
+
+        for (int slot = 0; slot < BareToolbarSlot.COUNT; slot++) {
+            assertFalse(
+                    "resolving slot " + slot + " wrote a preference",
+                    mPrefs.contains(key(slot)));
+            assertFalse(BareToolbarPrefs.hasPrimaryAction(slot));
+        }
+    }
+
+    @Test
+    public void testResetRemovesKeysRatherThanRecordingTodaysDefaults() {
+        store(ActionId.SHARE, ActionId.TRANSLATE, ActionId.BOOKMARK);
+        assertTrue(BareToolbarPrefs.hasPrimaryAction(BareToolbarSlot.HOME));
+
+        BareToolbarPrefs.resetAll();
+        BareToolbarLayout.invalidate();
+
+        for (int slot = 0; slot < BareToolbarSlot.COUNT; slot++) {
+            assertFalse("reset left a key behind for slot " + slot, mPrefs.contains(key(slot)));
+        }
+        assertBar(ActionId.HOME_BUTTON, ActionId.INCOGNITO, ActionId.APP_MENU);
+    }
+

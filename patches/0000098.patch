+    }
+
+    @Test
+    public void testActionNotOnTheBarHasNoPosition() {
+        // Nothing should resolve to a container merely because it once lived there.
+        assertEquals(BareToolbarSlot.NONE, BareToolbarLayout.slotForAction(ActionId.GLIC));

+        assertBar(ActionId.SHARE, ActionId.INCOGNITO, ActionId.APP_MENU);
+    }
+
+    @Test
+    public void testTripleDuplicate_resolvesToThreeDistinctActions() {
+        store(ActionId.BOOKMARK, ActionId.BOOKMARK, ActionId.BOOKMARK);
+        assertBar(ActionId.BOOKMARK, ActionId.INCOGNITO, ActionId.APP_MENU);
+    }
+
+    @Test
+    public void testDuplicate_whenTheSlotDefaultIsAlsoTakenTheCatalogueDecides() {
+        // Incognito is both what is stored for the first slot and what the second falls back to,
+        // so the second has to look further: the first action in the catalogue nothing is using.
+        store(ActionId.INCOGNITO, ActionId.INCOGNITO, ActionId.APP_MENU);
+        assertBar(ActionId.INCOGNITO, ActionId.HOME_BUTTON, ActionId.APP_MENU);
+    }
+
+    @Test
+    public void testOnlyHomeStored() {
+        store(ActionId.TRANSLATE, UNSET, UNSET);
+        assertBar(ActionId.TRANSLATE, ActionId.INCOGNITO, ActionId.APP_MENU);
+    }
+
+    @Test
+    public void testOnlyExtraStored() {
+        store(UNSET, ActionId.SHARE, UNSET);
+        assertBar(ActionId.HOME_BUTTON, ActionId.SHARE, ActionId.APP_MENU);
+    }
+
+    @Test
+    public void testOnlyAppMenuStored() {
+        store(UNSET, UNSET, ActionId.BOOKMARK);
+        assertBar(ActionId.HOME_BUTTON, ActionId.INCOGNITO, ActionId.BOOKMARK);
+    }
+
+    @Test
+    public void testTwoStored() {
+        store(ActionId.TRANSLATE, UNSET, ActionId.BOOKMARK);
+        assertBar(ActionId.TRANSLATE, ActionId.INCOGNITO, ActionId.BOOKMARK);
+    }
+
+    @Test
+    public void testPartialStore_whereTheMissingSlotDefaultIsAlreadyTaken() {
+        // Nothing is stored for the spare slot, and what it does by default has been taken by the
+        // slot before it, so it too has to fall through to the catalogue.
+        store(ActionId.INCOGNITO, UNSET, UNSET);
+        assertBar(ActionId.INCOGNITO, ActionId.HOME_BUTTON, ActionId.APP_MENU);
+    }
+
+    @Test
+    public void testResolutionIsDeterministic() {
+        store(ActionId.BOOKMARK, ActionId.BOOKMARK, ActionId.BOOKMARK);
+        int home = BareToolbarLayout.actionForSlot(BareToolbarSlot.HOME);
+        int extra = BareToolbarLayout.actionForSlot(BareToolbarSlot.EXTRA);
+        int appMenu = BareToolbarLayout.actionForSlot(BareToolbarSlot.APP_MENU);
+
+        for (int i = 0; i < 5; i++) {
+            BareToolbarLayout.invalidate();
+            assertEquals(home, BareToolbarLayout.actionForSlot(BareToolbarSlot.HOME));
+            assertEquals(extra, BareToolbarLayout.actionForSlot(BareToolbarSlot.EXTRA));
+            assertEquals(appMenu, BareToolbarLayout.actionForSlot(BareToolbarSlot.APP_MENU));
+        }
+    }
+
+    @Test

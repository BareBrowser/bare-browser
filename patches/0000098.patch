+
+import org.chromium.base.test.BaseRobolectricTestRunner;
+import org.chromium.chrome.browser.ui.actions.ActionId;
+import org.chromium.chrome.browser.ui.actions.HomeActionProperties;
+import org.chromium.chrome.browser.ui.actions.appmenu.AppMenuActionProperties;
+import org.chromium.ui.base.TestActivity;
+import org.chromium.ui.listmenu.ListMenuDelegate;
+import org.chromium.ui.modelutil.PropertyKey;
+import org.chromium.ui.modelutil.PropertyModel;
+import org.chromium.ui.modelutil.PropertyModelChangeProcessor.ViewBinder;
+
+/**
+ * Unit tests for {@link BareToolbarActionRendering}.
+ *
+ * <p>These protect the rule that how a button is drawn is a fact about the action and not about
+ * where it sits, which is what lets the bar be rearranged at all.
+ */
+@RunWith(BaseRobolectricTestRunner.class)
+public class BareToolbarActionRenderingUnitTest {
+    @Rule
+    public ActivityScenarioRule<TestActivity> mActivityScenarioRule =
+            new ActivityScenarioRule<>(TestActivity.class);
+
+    private Activity mActivity;
+
+    @Before
+    public void setUp() {
+        mActivityScenarioRule.getScenario().onActivity(activity -> mActivity = activity);
+    }
+
+    private View inflate(int layout) {
+        return LayoutInflater.from(mActivity).inflate(layout, null, false);
+    }
+
+    // ---- templates -------------------------------------------------------------------------
+
+    @Test
+    public void testHomeNeedsAViewThatCanShowAMenu() {
+        assertEquals(
+                R.layout.bottom_bar_list_menu_template,
+                BareToolbarActionRendering.templateForAction(ActionId.HOME_BUTTON));
+    }
+
+    @Test
+    public void testOrdinaryActionsUseTheGenericTemplate() {
+        for (int action :
+                new int[] {
+                    ActionId.SHARE, ActionId.TRANSLATE, ActionId.BOOKMARK, ActionId.INCOGNITO
+                }) {
+            assertEquals(
+                    "action " + action + " should use the generic template",
+                    R.layout.bottom_bar_generic_template,
+                    BareToolbarActionRendering.templateForAction(action));
+        }
+    }
+
+    @Test
+    public void testAppMenuTemplateCarriesTheBadgeWhenThereIsOne() {
+        int template = BareToolbarActionRendering.templateForAction(ActionId.APP_MENU);
+        if (BottomBarConfigUtils.shouldShowAppMenuUpdateBadge()) {
+            assertEquals(R.layout.bottom_bar_app_menu_template, template);
+            assertNotEquals(
+                    "the badge template must not be the generic one",
+                    R.layout.bottom_bar_generic_template,
+                    template);
+        } else {
+            assertEquals(R.layout.bottom_bar_generic_template, template);
+        }
+    }
+
+    // ---- view ids --------------------------------------------------------------------------
+
+    @Test
+    public void testTheTwoIdsLookedUpElsewhereFollowTheirActions() {
+        assertEquals(
+                R.id.home_button, BareToolbarActionRendering.viewIdForAction(ActionId.HOME_BUTTON));
+        assertEquals(
+                R.id.menu_button, BareToolbarActionRendering.viewIdForAction(ActionId.APP_MENU));
+    }
+
+    @Test
+    public void testAnOrdinaryActionDoesNotInheritANameItIsNot() {
+        // A search across the activity for the menu button must not find Share because Share
+        // happens to be sitting where the menu button used to be.
+        for (int action : new int[] {ActionId.SHARE, ActionId.TRANSLATE, ActionId.BOOKMARK}) {
+            assertEquals(
+                    "action " + action + " should carry no id",
+                    View.NO_ID,
+                    BareToolbarActionRendering.viewIdForAction(action));
+        }
+    }
+
+    // ---- binders ---------------------------------------------------------------------------
+
+    // View.hasOnLongClickListeners arrived in T, and it is the only way to ask a view whether a
+    // listener was bound without also firing it. Firing it would open the menu, which needs a
+    // window this test does not have.
+    @Test
+    @Config(minSdk = VERSION_CODES.TIRAMISU)
+    public void testHomeKeepsItsLongPressMenuWhereverItIsPlaced() {
+        View view = inflate(R.layout.bottom_bar_list_menu_template);
+        PropertyModel model = new PropertyModel.Builder(HomeActionProperties.ALL_KEYS).build();
+        model.set(HomeActionProperties.LONG_PRESS_MENU_DELEGATE, mock(ListMenuDelegate.class));
+
+        ViewBinder<PropertyModel, View, PropertyKey> binder =
+                BareToolbarActionRendering.binderForAction(ActionId.HOME_BUTTON);
+        binder.bind(model, view, HomeActionProperties.LONG_PRESS_MENU_DELEGATE);
+
+        assertTrue(
+                "home should have bound a long press menu", view.hasOnLongClickListeners());
+    }
+
+    @Test
+    @Config(minSdk = VERSION_CODES.TIRAMISU)
+    public void testAnOrdinaryActionInHomesPositionDoesNotInheritHomesLongPress() {
+        View view = inflate(R.layout.bottom_bar_list_menu_template);
+        PropertyModel model = new PropertyModel.Builder(HomeActionProperties.ALL_KEYS).build();
+        model.set(HomeActionProperties.LONG_PRESS_MENU_DELEGATE, mock(ListMenuDelegate.class));
+
+        ViewBinder<PropertyModel, View, PropertyKey> binder =
+                BareToolbarActionRendering.binderForAction(ActionId.SHARE);
+        binder.bind(model, view, HomeActionProperties.LONG_PRESS_MENU_DELEGATE);
+
+        assertFalse(
+                "the generic binder should not act on a home-only property",
+                view.hasOnLongClickListeners());
+    }
+
+    @Test
+    public void testAppMenuKeepsItsBadgeWhereverItIsPlaced() {
+        BottomBarAppMenu view = (BottomBarAppMenu) inflate(R.layout.bottom_bar_app_menu_template);
+        View badge = view.findViewById(R.id.menu_badge);
+        PropertyModel model = new PropertyModel.Builder(AppMenuActionProperties.ALL_KEYS).build();
+
+        ViewBinder<PropertyModel, View, PropertyKey> binder =
+                BareToolbarActionRendering.binderForAction(ActionId.APP_MENU);
+        model.set(AppMenuActionProperties.SHOW_UPDATE_BADGE, true);
+        binder.bind(model, view, AppMenuActionProperties.SHOW_UPDATE_BADGE);
+
+        assertEquals("the badge should be showing", View.VISIBLE, badge.getVisibility());
+    }
+
+    @Test
+    public void testAnOrdinaryActionInTheAppMenusPositionShowsNoBadge() {
+        BottomBarAppMenu view = (BottomBarAppMenu) inflate(R.layout.bottom_bar_app_menu_template);
+        View badge = view.findViewById(R.id.menu_badge);
+        PropertyModel model = new PropertyModel.Builder(AppMenuActionProperties.ALL_KEYS).build();
+
+        ViewBinder<PropertyModel, View, PropertyKey> binder =
+                BareToolbarActionRendering.binderForAction(ActionId.BOOKMARK);
+        model.set(AppMenuActionProperties.SHOW_UPDATE_BADGE, true);
+        binder.bind(model, view, AppMenuActionProperties.SHOW_UPDATE_BADGE);
+
+        assertNotEquals(
+                "the generic binder should not raise the app menu badge",
+                View.VISIBLE,
+                badge.getVisibility());
+    }
+
+    // ---- who decides its own visibility ------------------------------------------------------
+
+    @Test

+namespace {
+
+const char kLoaderKey[] = "BareBundledExtensionsLoader";
+
+struct LoaderHolder : public base::SupportsUserData::Data {
+  explicit LoaderHolder(scoped_refptr<BareBundledExtensionsLoader> loader)
+      : loader(std::move(loader)) {}
+  scoped_refptr<BareBundledExtensionsLoader> loader;
+};
+
+}  // namespace
+
+void RememberBundledExtensionsLoader(
+    Profile* profile,
+    scoped_refptr<BareBundledExtensionsLoader> loader) {
+  profile->SetUserData(kLoaderKey,
+                       std::make_unique<LoaderHolder>(std::move(loader)));
+}
+
+bool IsProvisionedByBare(content::BrowserContext* context,
+                         const Extension& extension) {
+  if (extension.location() != mojom::ManifestLocation::kExternalPref) {
+    return false;
+  }
+  const auto* holder =
+      static_cast<const LoaderHolder*>(context->GetUserData(kLoaderKey));
+  return holder && holder->loader->ClaimsExtension(extension.id());
+}
+
 }  // namespace extensions

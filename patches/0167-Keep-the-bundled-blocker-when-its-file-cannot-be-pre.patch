+bool ExtractBundledCrx(const base::FilePath& crx) {
+  if (!base::CreateDirectory(crx.DirName())) {
+    LOG(ERROR) << "Bare: could not create " << crx.DirName();
+    return false;
   }
 
   base::MemoryMappedFile::Region region;
@@ -77,45 +81,50 @@ base::FilePath ExtractBundledCrx() {

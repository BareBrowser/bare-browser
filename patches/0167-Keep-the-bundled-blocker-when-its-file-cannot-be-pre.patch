+  // Bare: the welcome screen can decline the bundled ad blocker. Once it is not
+  // offered, the external provider treats it as withdrawn and uninstalls it on
+  // the next launch. That is the one case where leaving it out is meant.
   base::android::SharedPreferencesManager shared_prefs =
       android::shared_preferences::GetChromeSharedPreferences();
-  if (!shared_prefs.ReadBoolean("Chrome.Bare.BundledAdBlockerEnabled", true)) {
-    return prefs;
-  }
-
-  const base::FilePath crx = ExtractBundledCrx();
-  if (crx.empty()) {
-    return prefs;
-  }
-
-  base::DictValue entry;
-  entry.Set("external_crx", crx.value());
-  entry.Set("external_version", kUBlockOriginVersion);
-  prefs.Set(kUBlockOriginId, std::move(entry));
-  return prefs;
+  state.offer_enabled =
+      shared_prefs.ReadBoolean("Chrome.Bare.BundledAdBlockerEnabled", true);
+  const bare_bundled_extensions::Plan plan =
+      bare_bundled_extensions::DecidePlan(state);
+
+  const base::FilePath crx = BundledCrxPath();
+  const bool crx_ready = plan != bare_bundled_extensions::Plan::kOfferNothing &&

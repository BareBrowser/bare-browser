diff --git a/components/bare_bundled_extensions/bundled_extension_plan.cc b/components/bare_bundled_extensions/bundled_extension_plan.cc
new file mode 100644
index 00000000000..14accae62ad
--- /dev/null
+++ b/components/bare_bundled_extensions/bundled_extension_plan.cc
@@ -0,0 +1,60 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/bare_bundled_extensions/bundled_extension_plan.h"
+
+#include <utility>
+
+namespace bare_bundled_extensions {
+
+namespace {
+
+// Keys the external provider reads; see ExternalProviderImpl.
+constexpr char kExternalCrx[] = "external_crx";
+constexpr char kExternalVersion[] = "external_version";
+constexpr char kKeepIfPresent[] = "keep_if_present";
+
+base::DictValue Offer(const base::FilePath& crx, const std::string& version) {
+  base::DictValue entry;
+  entry.Set(kExternalCrx, crx.value());
+  entry.Set(kExternalVersion, version);
+  return entry;
+}
+
+// Claims an installed extension without asking for anything to be installed.
+// keep_if_present means nothing happens if it is absent, and version 0 is older
+// than any installed copy, so nothing is reinstalled over it either. Both keys
+// still have to be present: the provider only counts an entry carrying
+// external_crx and external_version as a claim.
+base::DictValue Keep(const base::FilePath& crx) {
+  base::DictValue entry;
+  entry.Set(kExternalCrx, crx.value());
+  entry.Set(kExternalVersion, "0");
+  entry.Set(kKeepIfPresent, true);
+  return entry;
+}
+
+}  // namespace
+
+Plan DecidePlan(const ProfileState& state) {
+  return state.offer_enabled ? Plan::kOfferCurrent : Plan::kOfferNothing;
+}
+
+base::DictValue BuildProviderPrefs(Plan plan,
+                                   const Ids& ids,
+                                   const base::FilePath& crx,
+                                   bool crx_ready) {
+  base::DictValue prefs;
+  switch (plan) {
+    case Plan::kOfferNothing:
+      break;
+    case Plan::kOfferCurrent:
+      prefs.Set(ids.current,
+                crx_ready ? Offer(crx, ids.current_version) : Keep(crx));
+      break;
+  }
+  return prefs;
+}
+
+}  // namespace bare_bundled_extensions
diff --git a/components/bare_bundled_extensions/bundled_extension_plan.h b/components/bare_bundled_extensions/bundled_extension_plan.h
new file mode 100644
index 00000000000..e1520adc236
--- /dev/null
+++ b/components/bare_bundled_extensions/bundled_extension_plan.h
@@ -0,0 +1,53 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef COMPONENTS_BARE_BUNDLED_EXTENSIONS_BUNDLED_EXTENSION_PLAN_H_
+#define COMPONENTS_BARE_BUNDLED_EXTENSIONS_BUNDLED_EXTENSION_PLAN_H_
+
+#include <string>
+
+#include "base/files/file_path.h"
+#include "base/values.h"
+
+namespace bare_bundled_extensions {
+
+// What the provider is told about the extension Bare ships.
+struct ProfileState {
+  // False once the welcome screen has declined the bundled blocker.
+  bool offer_enabled = true;
+};
+
+enum class Plan {
+  // Claim nothing. Anything Bare installed earlier is then withdrawn by the
+  // provider machinery, which is what declining is meant to do.
+  kOfferNothing,
+  // Offer the shipped extension.
+  kOfferCurrent,
+};
+
+Plan DecidePlan(const ProfileState& state);
+
+struct Ids {
+  std::string current;
+  std::string current_version;
+};
+
+// Builds the dictionary handed to the external provider once the file work for
+// `plan` has been attempted.
+//
+// `crx` is where the shipped crx is, or would be. `crx_ready` says whether it is
+// there and whole.
+//
+// A failure never shows up as a missing entry. A missing entry tells the
+// provider the extension was withdrawn, and it uninstalls it along with the
+// user's settings, so an I/O error would cost the user their blocker. A failure
+// claims what is installed instead, as something to keep but not to install.
+base::DictValue BuildProviderPrefs(Plan plan,
+                                   const Ids& ids,
+                                   const base::FilePath& crx,
+                                   bool crx_ready);
+
+}  // namespace bare_bundled_extensions
+
+#endif  // COMPONENTS_BARE_BUNDLED_EXTENSIONS_BUNDLED_EXTENSION_PLAN_H_
diff --git a/components/bare_bundled_extensions/bundled_extension_plan_unittest.cc b/components/bare_bundled_extensions/bundled_extension_plan_unittest.cc
new file mode 100644
index 00000000000..85db4715509
--- /dev/null
+++ b/components/bare_bundled_extensions/bundled_extension_plan_unittest.cc
@@ -0,0 +1,67 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/bare_bundled_extensions/bundled_extension_plan.h"
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace bare_bundled_extensions {
+namespace {
+
+const Ids kIds{"current", "1.2.3"};
+const base::FilePath kCrx(FILE_PATH_LITERAL("/data/bundled/current-1.2.3.crx"));
+
+bool Offers(const base::DictValue& prefs, const std::string& id) {
+  const base::DictValue* entry = prefs.FindDict(id);
+  return entry && entry->FindString("external_crx") &&
+         entry->FindString("external_version") &&
+         !entry->FindBool("keep_if_present").value_or(false) &&
+         *entry->FindString("external_version") != "0";
+}
+
+// A claim the provider honours without installing anything.
+bool Keeps(const base::DictValue& prefs, const std::string& id) {
+  const base::DictValue* entry = prefs.FindDict(id);
+  return entry && entry->FindString("external_crx") &&
+         entry->FindString("external_version") &&
+         *entry->FindString("external_version") == "0" &&
+         entry->FindBool("keep_if_present").value_or(false);
+}
+
+TEST(BundledExtensionPlanTest, AFreshProfileIsOfferedTheShippedExtension) {
+  EXPECT_EQ(Plan::kOfferCurrent, DecidePlan(ProfileState()));
+}
+
+TEST(BundledExtensionPlanTest, DecliningAtWelcomeOffersNothing) {
+  ProfileState state;
+  state.offer_enabled = false;
+  EXPECT_EQ(Plan::kOfferNothing, DecidePlan(state));
+}
+
+TEST(BundledExtensionPlanTest, OfferNothingIsAnEmptyDictionary) {
+  EXPECT_TRUE(BuildProviderPrefs(Plan::kOfferNothing, kIds, kCrx, true)
+                  .empty());
+}
+
+TEST(BundledExtensionPlanTest, AReadyCrxIsOfferedAtItsVersion) {
+  base::DictValue prefs =
+      BuildProviderPrefs(Plan::kOfferCurrent, kIds, kCrx, true);
+  ASSERT_TRUE(Offers(prefs, "current"));
+  EXPECT_EQ(kCrx.value(),
+            *prefs.FindDict("current")->FindString("external_crx"));
+  EXPECT_EQ("1.2.3",
+            *prefs.FindDict("current")->FindString("external_version"));
+  EXPECT_EQ(1u, prefs.size());
+}
+
+// The failure the provider used to read as a withdrawal.
+TEST(BundledExtensionPlanTest, AFileFailureKeepsTheInstalledCopy) {
+  base::DictValue prefs =
+      BuildProviderPrefs(Plan::kOfferCurrent, kIds, kCrx, false);
+  EXPECT_TRUE(Keeps(prefs, "current"));
+  EXPECT_EQ(1u, prefs.size());
+}
+
+}  // namespace
+}  // namespace bare_bundled_extensions

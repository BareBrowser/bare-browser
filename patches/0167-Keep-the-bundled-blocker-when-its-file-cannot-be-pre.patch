-  if (!base::WriteFile(crx, contents)) {
-    LOG(ERROR) << "Bare: could not write bundled extension to " << crx;
-    return base::FilePath();
+  // Already extracted by an earlier launch. Trust it only if it is the asset
+  // byte for byte; a file of the right size can still be torn or altered.
+  std::optional<std::vector<uint8_t>> existing = base::ReadFileToBytes(crx);

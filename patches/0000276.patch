@@ -0,0 +1,114 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/extensions/bare_filter_subscriber.h"
+
+#include <string>
+
+#include "base/functional/callback_helpers.h"
+#include "base/memory/raw_ptr.h"
+#include "base/scoped_observation.h"
+#include "base/strings/strcat.h"
+#include "base/strings/utf_string_conversions.h"
+#include "chrome/browser/preferences/android/chrome_shared_preferences.h"
+#include "chrome/browser/profiles/profile.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/common/isolated_world_ids.h"
+#include "extensions/browser/extension_host.h"
+#include "extensions/browser/extension_host_registry.h"
+#include "extensions/common/mojom/view_type.mojom.h"
+
+namespace extensions {
+
+namespace {
+
+constexpr char kUBlockOriginId[] = "fkgkibajhfbepljeaefdnfnegdcjomkh";
+
+// Where uBlock Origin fetches BareFilter from.
+constexpr char kBareFilterUrl[] = "https://raw.githubusercontent.com/BareBrowser/bare-browser/main/filters/BareFilter.txt";
+
+// The on and off switch shown on the extensions page. On unless turned off.
+constexpr char kEnabledPref[] = "Chrome.Bare.BareFilterEnabled";
+
+// Runs inside the background page of uBlock Origin once its filters are ready,
+// and does what the import box of its lists page does: it adds or removes the
+// list through uBlock's own functions, then has it rebuild its lists. Its
+// saved copy of the available lists is only dropped by that rebuild, so a list
+// written into its storage from outside is never seen.
+constexpr char kScript[] = R"(
+(function() {
+  var url = '%URL%';
+  var want = %WANT%;
+  var tries = 0;
+  var timer = setInterval(function() {
+    var ub = window['µBlock'];
+    if (++tries > 120) { clearInterval(timer); return; }
+    if (!ub || !ub.readyToFilter) { return; }
+    clearInterval(timer);
+    var imported = ub.userSettings.importedLists.indexOf(url) !== -1;
+    var selected = ub.selectedFilterLists.indexOf(url) !== -1;
+    var known = !!ub.availableFilterLists[url];
+    if (want) {
+      if (!imported || !selected) { ub.applyFilterListSelection({ toImport: url }); }
+      if (!imported || !selected || !known) { ub.loadFilterLists(); }
+    } else if (imported || selected || known) {
+      ub.applyFilterListSelection({ toRemove: [url] });
+      ub.loadFilterLists();
+    }
+  }, 500);
+})();
+)";
+
+std::string BuildScript(bool want) {
+  std::string script = kScript;
+  size_t at = script.find("%URL%");
+  script.replace(at, 5, kBareFilterUrl);
+  at = script.find("%WANT%");
+  script.replace(at, 6, want ? "true" : "false");
+  return script;
+}
+
+class BareFilterSubscriber : public ExtensionHostRegistry::Observer {
+ public:
+  explicit BareFilterSubscriber(Profile* profile) {
+    observation_.Observe(ExtensionHostRegistry::Get(profile));
+  }
+
+  BareFilterSubscriber(const BareFilterSubscriber&) = delete;
+  BareFilterSubscriber& operator=(const BareFilterSubscriber&) = delete;
+
+ private:
+  // ExtensionHostRegistry::Observer:
+  void OnExtensionHostCompletedFirstLoad(content::BrowserContext* context,
+                                         ExtensionHost* host) override {
+    if (host->extension_id() != kUBlockOriginId ||
+        host->extension_host_type() !=
+            mojom::ViewType::kExtensionBackgroundPage) {
+      return;
+    }
+    base::android::SharedPreferencesManager shared_prefs =
+        android::shared_preferences::GetChromeSharedPreferences();
+    const bool want = shared_prefs.ReadBoolean(kEnabledPref, true);
+    // uBlock Origin is shipped as its author signs it and keeps its code in
+    // its own page, so the page is the only place to reach it. The method is
+    // the one that runs script in the page's own world; its name is a test
+    // helper's, and there is no other way into that world from here.
+    host->host_contents()->GetPrimaryMainFrame()->ExecuteJavaScriptForTests(
+        base::UTF8ToUTF16(BuildScript(want)), base::NullCallback(),
+        content::ISOLATED_WORLD_ID_GLOBAL);
+  }
+
+  base::ScopedObservation<ExtensionHostRegistry,
+                          ExtensionHostRegistry::Observer>
+      observation_{this};
+};
+
+}  // namespace
+
+void StartBareFilterSubscriber(Profile* profile) {
+  new BareFilterSubscriber(profile);  // Owns itself.
+}
+
+}  // namespace extensions

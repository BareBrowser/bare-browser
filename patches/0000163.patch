   desktop_mode |= should_allow_on_external_display;
 
+  desktop_mode |= ShouldRequestDesktopWebStore(host_content_settings_map_, url);
+
   // Override UA for renderer initiated navigation only. UA override for browser
   // initiated navigation is handled on Java side. This is to workaround known
   // issues crbug.com/40801643 and crbug.com/40799177.
@@ -123,6 +127,34 @@ void RequestDesktopSiteWebContentsObserverAndroid::DidStartNavigation(
 
 WEB_CONTENTS_USER_DATA_KEY_IMPL(RequestDesktopSiteWebContentsObserverAndroid);
 
+// static
+bool RequestDesktopSiteWebContentsObserverAndroid::ShouldRequestDesktopWebStore(
+    HostContentSettingsMap* map,
+    const GURL& url) {
+  if (!url.SchemeIs(url::kHttpsScheme) ||
+      url.host() != "chromewebstore.google.com") {
+    return false;
+  }
+  content_settings::SettingInfo setting_info;
+  map->GetContentSetting(url, url, ContentSettingsType::REQUEST_DESKTOP_SITE,
+                         &setting_info);
+  return setting_info.primary_pattern.MatchesAllHosts();
+}
+
+// static
+bool RequestDesktopSiteWebContentsObserverAndroid::ShouldKeepWebStoreViewport(
+    content::WebContents* web_contents) {
+  content::NavigationEntry* entry =
+      web_contents->GetController().GetVisibleEntry();
+  if (!entry || !entry->GetIsOverridingUserAgent()) {
+    return false;
+  }
+  Profile* profile =
+      Profile::FromBrowserContext(web_contents->GetBrowserContext());
+  return ShouldRequestDesktopWebStore(
+      HostContentSettingsMapFactory::GetForProfile(profile), entry->GetURL());
+}
+
 bool RequestDesktopSiteWebContentsObserverAndroid::ShouldAllowOnExternalDisplay(
     bool is_global_setting) {
   // Disallow if feature is disabled.
diff --git a/chrome/browser/content_settings/request_desktop_site_web_contents_observer_android.h b/chrome/browser/content_settings/request_desktop_site_web_contents_observer_android.h
index 8d879692750..faede21f3af 100644
--- a/chrome/browser/content_settings/request_desktop_site_web_contents_observer_android.h
+++ b/chrome/browser/content_settings/request_desktop_site_web_contents_observer_android.h
@@ -29,6 +29,18 @@ class RequestDesktopSiteWebContentsObserverAndroid
   void DidStartNavigation(
       content::NavigationHandle* navigation_handle) override;
 
+  // The Chrome Web Store shows its install button only to a desktop user
+  // agent, so `url` on the store gets one unless the user has set desktop mode
+  // for it either way. DesktopSiteUtils.java makes the same call for
+  // navigations started from the browser.
+  static bool ShouldRequestDesktopWebStore(HostContentSettingsMap* map,
+                                           const GURL& url);
+
+  // Whether the page in `web_contents` is the store loaded under that rule.
+  // Such a page keeps its viewport tag, which a desktop user agent otherwise
+  // turns off, so it still lays out at phone width.
+  static bool ShouldKeepWebStoreViewport(content::WebContents* web_contents);
+
  private:
   explicit RequestDesktopSiteWebContentsObserverAndroid(
       content::WebContents* web_contents);

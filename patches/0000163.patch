+    private static boolean isChromeWebStore(@Nullable GURL url) {
+        return url != null
+                && "https".equals(url.getScheme())
+                && CHROME_WEB_STORE_HOST.equals(url.getHost());
+    }
+
+    /**
+     * Removes the domain level exception for {@link ContentSettingsType.REQUEST_DESKTOP_SITE} that
+     * covers |url|, whatever its value.
+     */
+    public static void removeRequestDesktopSiteDomainException(Profile profile, GURL url) {
+        WebsitePreferenceBridge.setContentSettingCustomScope(
+                profile,
+                ContentSettingsType.REQUEST_DESKTOP_SITE,

+package org.chromium.chrome.browser.bare;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+
+import android.content.Context;
+import android.graphics.Bitmap;
+import android.graphics.Canvas;
+import android.graphics.drawable.Animatable;
+import android.graphics.drawable.Drawable;
+
+import androidx.test.core.app.ApplicationProvider;
+
+import org.junit.Test;
+import org.junit.runner.RunWith;
+
+import org.chromium.base.test.BaseRobolectricTestRunner;
+import org.chromium.chrome.browser.logo.BareAnimatedLogo;
+
+/** Tests for the leaf with moving wings that replaces the still logo. */
+@RunWith(BaseRobolectricTestRunner.class)
+public class BareAnimatedLogoUnitTest {
+    private final Context mContext = ApplicationProvider.getApplicationContext();
+
+    private void drawOnce(Drawable drawable) {
+        Bitmap bitmap = Bitmap.createBitmap(300, 130, Bitmap.Config.ARGB_8888);
+        drawable.setBounds(0, 0, 300, 130);
+        drawable.draw(new Canvas(bitmap));
+    }
+
+    @Test
+    public void testTheWordmarkKeepsTheSizeOfTheStillOne() {
+        float density = mContext.getResources().getDisplayMetrics().density;
+        Drawable wordmark = BareAnimatedLogo.wordmark(mContext, false);
+        assertEquals(Math.round(150 * density), wordmark.getIntrinsicWidth());
+        assertEquals(Math.round(65 * density), wordmark.getIntrinsicHeight());
+        drawOnce(wordmark);
+        drawOnce(BareAnimatedLogo.wordmark(mContext, true));
+    }
+
+    @Test
+    public void testTheLeafKeepsTheSizeOfTheStillOne() {
+        float density = mContext.getResources().getDisplayMetrics().density;
+        Drawable leaf = BareAnimatedLogo.leaf(mContext);
+        assertEquals(Math.round(96 * density), leaf.getIntrinsicWidth());
+        assertEquals(Math.round(96 * density), leaf.getIntrinsicHeight());
+        drawOnce(leaf);
+    }
+
+    @Test
+    public void testItMovesWhileVisibleAndStopsWhenHidden() {
+        Drawable leaf = BareAnimatedLogo.leaf(mContext);
+        Animatable animatable = (Animatable) leaf;
+        assertFalse(animatable.isRunning());
+        leaf.setVisible(true, false);
+        assertTrue(animatable.isRunning());
+        leaf.setVisible(false, false);
+        assertFalse(animatable.isRunning());
+    }
+}

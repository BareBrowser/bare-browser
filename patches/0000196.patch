+import android.content.SharedPreferences;
+import android.view.View;
+
+import org.chromium.base.Callback;
+import org.chromium.base.ContextUtils;
+import org.chromium.base.lifetime.Destroyable;
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.chrome.browser.bare.settings.BareToolbarActionUi;
+import org.chromium.chrome.browser.preferences.ChromePreferenceKeys;
+import org.chromium.chrome.browser.toolbar.home_button.HomeButtonCoordinator;
+import org.chromium.chrome.browser.ui.actions.ActionId;
+import org.chromium.chrome.browser.ui.actions.ActionProperties;
+import org.chromium.chrome.browser.ui.actions.ActionRegistry;
+import org.chromium.chrome.browser.ui.bottombar.BareToolbarPrefs;
+import org.chromium.chrome.browser.ui.bottombar.BareToolbarSecondaryActions;
+import org.chromium.chrome.browser.ui.bottombar.BareToolbarSlot;
+import org.chromium.chrome.browser.ui.bottombar.BottomBarConfigUtils;
+import org.chromium.ui.modelutil.PropertyModel;
+import org.chromium.base.supplier.NullableObservableSupplier;
+
+/**
+ * Makes the button at the left of the minimal address bar do what the user chose for the first
+ * toolbar button, the same choice and the same press and hold the full bottom bar offers.
+ *
+ * <p>The minimal layout has no bottom bar, so that button is the browser's home button. When the
+ * choice is Home it is left exactly as it is. Otherwise it takes the chosen action's icon and name,
+ * runs the action when pressed, and runs the chosen hold action when held.
+ */
+@NullMarked
+public final class BareMinimalLeftButton
+        implements Destroyable, SharedPreferences.OnSharedPreferenceChangeListener {
+    private final HomeButtonCoordinator mCoordinator;
+    private final ActionRegistry mRegistry;
+    private final BareToolbarSecondaryActions mSecondary;
+
+    private @Nullable NullableObservableSupplier<PropertyModel> mSupplier;
+    private final Callback<@Nullable PropertyModel> mModelCallback = model -> mModel = model;
+    private @Nullable PropertyModel mModel;
+
+    /** Does nothing unless the minimal layout is on. */
+    public static @Nullable BareMinimalLeftButton maybeCreate(
+            HomeButtonCoordinator coordinator, @Nullable ActionRegistry registry) {
+        if (registry == null || !BottomBarConfigUtils.isMinimalLayout()) return null;
+        return new BareMinimalLeftButton(coordinator, registry);
+    }
+
+    private BareMinimalLeftButton(HomeButtonCoordinator coordinator, ActionRegistry registry) {
+        mCoordinator = coordinator;
+        mRegistry = registry;
+        // The hold on the button. The bottom bar normally attaches this and there is none here.
+        mSecondary = new BareToolbarSecondaryActions(registry, () -> {});
+        ContextUtils.getAppSharedPreferences().registerOnSharedPreferenceChangeListener(this);
+        bind();
+    }
+
+    private void bind() {
+        if (mSupplier != null) mSupplier.removeObserver(mModelCallback);
+        mSupplier = null;
+        mModel = null;
+
+        @ActionId int action = BareToolbarPrefs.getPrimaryAction(BareToolbarSlot.HOME);
+        if (action == ActionId.HOME_BUTTON) {
+            mCoordinator.setOverride(null, null, 0, 0);
+            return;
+        }
+        NullableObservableSupplier<PropertyModel> supplier = mRegistry.get(action);
+        mSupplier = supplier;
+        supplier.addSyncObserverAndCallIfNonNull(mModelCallback);
+        mCoordinator.setOverride(
+                v -> {
+                    PropertyModel model = mModel;
+                    Callback<View> press =
+                            model == null ? null : model.get(ActionProperties.ON_PRESS_CALLBACK);
+                    if (press != null) press.onResult(v);
+                },
+                v -> {
+                    PropertyModel model = mModel;
+                    Callback<View> hold =
+                            model == null
+                                    ? null
+                                    : model.get(ActionProperties.ON_LONG_PRESS_CALLBACK);
+                    if (hold == null) return false;
+                    hold.onResult(v);
+                    return true;
+                },
+                BareToolbarActionUi.iconFor(action),
+                BareToolbarActionUi.labelFor(action));
+    }
+
+    @Override
+    public void onSharedPreferenceChanged(SharedPreferences preferences, @Nullable String key) {
+        if (key == null) return;
+        boolean primary = ChromePreferenceKeys.BOTTOM_BAR_SLOT_PRIMARY_ACTION.hasGenerated(key);
+        boolean secondary = ChromePreferenceKeys.BOTTOM_BAR_SLOT_SECONDARY_ACTION.hasGenerated(key);
+        if (!primary && !secondary) return;
+        mSecondary.refresh();
+        bind();
+    }
+
+    @Override
+    public void destroy() {
+        ContextUtils.getAppSharedPreferences().unregisterOnSharedPreferenceChangeListener(this);
+        if (mSupplier != null) mSupplier.removeObserver(mModelCallback);
+        mSupplier = null;
+        mSecondary.destroy();
+        mCoordinator.setOverride(null, null, 0, 0);
+    }
+}

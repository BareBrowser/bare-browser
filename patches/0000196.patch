+        BareWelcomeOverlay.showBottomBarRows(page, false);
+
+        ViewGroup card = (ViewGroup) page.findViewById(R.id.bare_row_minimal).getParent();
+        int dividers = 0;
+        View last = null;
+        for (int i = 0; i < card.getChildCount(); i++) {
+            View child = card.getChildAt(i);
+            if (!shown(child)) continue;
+            last = child;
+            if (child.getId() == View.NO_ID && child.getClass() == View.class) dividers++;
+        }
+        assertEquals("the swipe row is the last thing shown", R.id.bare_row_address_swipe, last.getId());

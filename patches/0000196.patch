+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.compositor.layouts.phone;
+
+import android.content.Context;
+import android.graphics.Bitmap;
+import android.widget.FrameLayout;
+import android.widget.ImageView;
+
+import androidx.annotation.ColorInt;
+
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.chrome.browser.bare.BareNtpAppearance;
+
+/**
+ * A copy of the New tab page, drawn for the slide-up that opens a new tab: the wordmark and the
+ * search box, as the real page last showed them, on the page background. It swallows touches while
+ * it moves.
+ */
+@NullMarked
+final class BareNewTabRiseView extends FrameLayout {
+    /**
+     * @param originX Window x of this view's top left corner.
+     * @param originY Window y of this view's top left corner.
+     */
+    BareNewTabRiseView(
+            Context context,
+            @ColorInt int backgroundColor,
+            BareNtpAppearance.@org.chromium.build.annotations.Nullable Snapshot snapshot,
+            int originX,
+            int originY) {
+        super(context);
+        setBackgroundColor(backgroundColor);
+        setClickable(true);
+        if (snapshot == null) return;
+        add(snapshot.logo, snapshot.logoX - originX, snapshot.logoY - originY);
+        add(snapshot.box, snapshot.boxX - originX, snapshot.boxY - originY);
+    }
+
+    private void add(Bitmap bitmap, int x, int y) {
+        ImageView view = new ImageView(getContext());
+        view.setImageBitmap(bitmap);
+        view.setScaleType(ImageView.ScaleType.FIT_XY);
+        LayoutParams params = new LayoutParams(bitmap.getWidth(), bitmap.getHeight());
+        params.leftMargin = x;
+        params.topMargin = y;
+        addView(view, params);
+    }
+
+    @Override
+    public boolean performClick() {
+        return true;
+    }
+}

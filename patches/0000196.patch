diff --git a/chrome/android/java/res/layout/bare_incognito_page.xml b/chrome/android/java/res/layout/bare_incognito_page.xml
new file mode 100644
index 00000000000..6df87a77c8d
--- /dev/null
+++ b/chrome/android/java/res/layout/bare_incognito_page.xml
@@ -0,0 +1,107 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!--
+Copyright 2026 The Chromium Authors
+Use of this source code is governed by a BSD-style license that can be
+found in the LICENSE file.
+-->
+
+<!-- The Incognito New tab page: Bare's wings with the incognito badge, the name, and three plain
+     facts about what the mode does and does not do. -->
+<LinearLayout
+    xmlns:android="http://schemas.android.com/apk/res/android"
+    android:id="@+id/new_tab_incognito_container"
+    android:layout_width="match_parent"
+    android:layout_height="match_parent"
+    android:orientation="vertical"
+    android:gravity="center"
+    android:clipChildren="false"
+    android:paddingHorizontal="26dp"
+    android:paddingTop="22dp"
+    android:paddingBottom="40dp">
+
+    <FrameLayout
+        android:layout_width="100dp"
+        android:layout_height="100dp"
+        android:layout_marginBottom="14dp"
+        android:clipChildren="false">
+
+        <ImageView
+            android:id="@+id/bare_incognito_logo"
+            android:layout_width="match_parent"
+            android:layout_height="match_parent"
+            android:importantForAccessibility="no" />
+
+        <ImageView
+            android:layout_width="33dp"
+            android:layout_height="33dp"
+            android:layout_gravity="end|bottom"
+            android:layout_marginEnd="-3dp"
+            android:layout_marginBottom="4dp"
+            android:importantForAccessibility="no"
+            android:src="@drawable/ic_bare_incognito_badge" />
+    </FrameLayout>
+
+    <TextView
+        android:id="@+id/bare_incognito_brand"
+        android:layout_width="wrap_content"
+        android:layout_height="wrap_content"
+        android:layout_marginBottom="11dp"
+        android:fontFamily="sans-serif-black"
+        android:includeFontPadding="false"
+        android:letterSpacing="-0.064"
+        android:text="bare."
+        android:textColor="@color/bare_incognito_brand"
+        android:textSize="47sp" />
+
+    <TextView
+        android:id="@+id/bare_incognito_mode"
+        android:layout_width="wrap_content"
+        android:layout_height="wrap_content"
+        android:layout_marginBottom="34dp"
+        android:accessibilityHeading="true"
+        android:text="@string/bare_incognito_mode"
+        android:textColor="@color/bare_incognito_mode_text"
+        android:textSize="14sp" />
+
+    <LinearLayout
+        android:layout_width="280dp"
+        android:layout_height="wrap_content"
+        android:orientation="vertical">
+
+        <View
+            android:layout_width="match_parent"
+            android:layout_height="1dp"
+            android:layout_marginBottom="8dp"
+            android:background="@color/bare_incognito_divider" />
+
+        <LinearLayout
+            style="@style/BareIncognitoFactRow">
+            <ImageView
+                style="@style/BareIncognitoFactIcon"
+                android:src="@drawable/ic_bare_incognito_fact_cookie" />
+            <TextView
+                style="@style/BareIncognitoFactText"
+                android:text="@string/bare_incognito_fact_cookies" />
+        </LinearLayout>
+
+        <LinearLayout
+            style="@style/BareIncognitoFactRow">
+            <ImageView
+                style="@style/BareIncognitoFactIcon"
+                android:src="@drawable/ic_bare_incognito_fact_download" />
+            <TextView
+                style="@style/BareIncognitoFactText"
+                android:text="@string/bare_incognito_fact_downloads" />
+        </LinearLayout>
+
+        <LinearLayout
+            style="@style/BareIncognitoFactRow">
+            <ImageView
+                style="@style/BareIncognitoFactIcon"
+                android:src="@drawable/ic_bare_incognito_fact_eye" />
+            <TextView
+                style="@style/BareIncognitoFactText"
+                android:text="@string/bare_incognito_fact_visible" />
+        </LinearLayout>
+    </LinearLayout>
+</LinearLayout>

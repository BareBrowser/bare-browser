+    /** The panel itself, which lets a deliberate swipe to the left drag it shut. */
+    private static final class Panel extends LinearLayout {
+        interface Drag {
+            void onDrag(float dx);
+        }
+
+        interface Release {
+            void onRelease(float dx, float velocityX);
+        }
+
+        private final int mSlop;
+        private float mDownX;
+        private float mDownY;
+        private boolean mDragging;
+        private @Nullable VelocityTracker mTracker;
+        private @Nullable Runnable mDismiss;
+        private @Nullable Drag mDrag;
+        private @Nullable Release mRelease;
+
+        Panel(Context context) {
+            super(context);
+            mSlop = ViewConfiguration.get(context).getScaledTouchSlop();
+        }
+
+        void setOnDismissListener(Runnable dismiss) {
+            mDismiss = dismiss;
+        }
+
+        void setDragListener(Drag drag, Release release) {
+            mDrag = drag;
+            mRelease = release;
+        }
+
+        @Override
+        public boolean onInterceptTouchEvent(MotionEvent ev) {
+            switch (ev.getActionMasked()) {
+                case MotionEvent.ACTION_DOWN:
+                    mDownX = ev.getX();
+                    mDownY = ev.getY();
+                    mDragging = false;
+                    if (mTracker != null) mTracker.recycle();
+                    mTracker = VelocityTracker.obtain();
+                    mTracker.addMovement(ev);
+                    break;
+                case MotionEvent.ACTION_MOVE:
+                    if (mTracker != null) mTracker.addMovement(ev);
+                    float dx = ev.getX() - mDownX;
+                    float dy = ev.getY() - mDownY;
+                    // Only a clearly sideways move to the left: vertical scrolling is not taken.
+                    if (!mDragging && dx < -2 * mSlop && Math.abs(dx) > 1.6f * Math.abs(dy)) {
+                        mDragging = true;
+                        return true;
+                    }
+                    break;
+                default:
+                    break;
+            }
+            return false;
+        }
+
+        @Override
+        public boolean onTouchEvent(MotionEvent ev) {
+            if (mTracker != null) mTracker.addMovement(ev);
+            switch (ev.getActionMasked()) {
+                case MotionEvent.ACTION_MOVE:
+                    if (mDragging && mDrag != null) mDrag.onDrag(ev.getX() - mDownX);
+                    return true;
+                case MotionEvent.ACTION_UP:
+                case MotionEvent.ACTION_CANCEL:
+                    if (mDragging && mRelease != null) {
+                        float velocity = 0f;
+                        if (mTracker != null) {
+                            mTracker.computeCurrentVelocity(1000);
+                            velocity = mTracker.getXVelocity();
+                        }
+                        mRelease.onRelease(ev.getX() - mDownX, velocity);
+                    }
+                    mDragging = false;
+                    if (mTracker != null) {
+                        mTracker.recycle();
+                        mTracker = null;
+                    }
+                    return true;
+                default:
+                    return true;
+            }
+        }
+    }
+}

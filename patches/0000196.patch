+/**
+ * The sign-off at the bottom of Settings: the animated bridge over "Made with love in San
+ * Francisco". Not a setting, so it cannot be selected.
+ */
+@NullMarked
+public class BareMadeWithLovePreference extends Preference {
+    public BareMadeWithLovePreference(Context context, AttributeSet attrs) {
+        super(context, attrs);
+        setLayoutResource(R.layout.bare_made_with_love_preference);
+        setSelectable(false);
+        // A preference with no title hides the title view, which here is the sign-off line.
+        setTitle(R.string.bare_made_with_love);
+    }
+
+    @Override
+    public void onBindViewHolder(PreferenceViewHolder holder) {
+        super.onBindViewHolder(holder);

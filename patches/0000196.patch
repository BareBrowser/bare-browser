+    /** Keeps the header below the status bar and the footer above the navigation bar. */
+    private void applyInsets(WindowInsetsCompat insets) {
+        Insets bars =
+                insets.getInsets(
+                        WindowInsetsCompat.Type.systemBars()
+                                | WindowInsetsCompat.Type.displayCutout());
+        // This activity draws edge to edge and a parent may already have taken the insets, so the
+        // system's own bar sizes are the floor.
+        mTopInset = Math.max(bars.top, systemDimension("status_bar_height"));
+        mBottomInset = Math.max(bars.bottom, systemDimension("navigation_bar_height"));
+        LinearLayout header = mHeader;
+        LinearLayout footer = mFooter;
+        if (header != null) header.setPadding(dp(15), mTopInset + dp(12), dp(15), dp(6));
+        if (footer != null) footer.setPadding(dp(12), dp(12), dp(12), dp(20) + mBottomInset);
+    }
+
+    private int systemDimension(String name) {
+        int id = mActivity.getResources().getIdentifier(name, "dimen", "android");
+        return id > 0 ? mActivity.getResources().getDimensionPixelSize(id) : 0;
+    }
+
+    /**
+     * With the address bar at the bottom a list starts at the bottom. A grid cannot be stacked
+     * from the end, so it keeps its natural order and is scrolled to the newest tab instead.
+     */
+    private void stackFromBottomIfListed(LinearLayoutManager layoutManager) {
+        if (layoutManager instanceof GridLayoutManager) return;
+        layoutManager.setStackFromEnd(!AddressBarPreference.isToolbarConfiguredToShowOnTop());
+    }
+
+    /**
+     * With the address bar at the bottom the grid also starts at the bottom. A grid cannot be
+     * stacked from the end, so it is made as tall as its cards and held to the bottom of the space
+     * instead, which looks the same until it is taller than the space and scrolls.
+     */
+    private void applyListPlacement() {
+        RecyclerView list = mList;
+        if (list == null) return;
+        FrameLayout.LayoutParams params = (FrameLayout.LayoutParams) list.getLayoutParams();
+        boolean fromBottom = mGrid && !AddressBarPreference.isToolbarConfiguredToShowOnTop();
+        int height = fromBottom ? ViewGroup.LayoutParams.WRAP_CONTENT : ViewGroup.LayoutParams.MATCH_PARENT;
+        int gravity = fromBottom ? Gravity.BOTTOM : Gravity.NO_GRAVITY;
+        if (params.height == height && params.gravity == gravity) return;
+        params.height = height;
+        params.gravity = gravity;
+        list.setLayoutParams(params);
+    }
+
+    private LinearLayoutManager newLayoutManager() {
+        // Two to a row in the grid, one in the list.
+        return mGrid ? new GridLayoutManager(mActivity, 2) : new LinearLayoutManager(mActivity);
+    }
+
+    private void showViewMenu(View anchor) {
+        PopupMenu menu = new PopupMenu(mActivity, anchor);
+        menu.getMenu().add(0, 1, 0, R.string.bare_vtabs_list_view).setCheckable(true).setChecked(!mGrid);
+        menu.getMenu().add(0, 2, 1, R.string.bare_vtabs_grid_view).setCheckable(true).setChecked(mGrid);
+        menu.getMenu().setGroupCheckable(0, true, true);
+        menu.setOnMenuItemClickListener(
+                item -> {
+                    setGrid(item.getItemId() == 2);
+                    return true;
+                });
+        menu.show();
+    }
+
+    /** Switches between the list and the grid, and remembers which. */
+    private void setGrid(boolean grid) {
+        if (grid == mGrid) return;
+        mGrid = grid;
+        ChromeSharedPreferences.getInstance()
+                .writeBoolean(ChromePreferenceKeys.BARE_VERTICAL_TABS_GRID, grid);
+        RecyclerView list = mList;
+        TabAdapter adapter = mAdapter;
+        if (list == null || adapter == null) return;
+        LinearLayoutManager layoutManager = newLayoutManager();
+        stackFromBottomIfListed(layoutManager);
+        applyListPlacement();
+        list.setLayoutManager(layoutManager);
+        mLayoutManager = layoutManager;
+        // The rows and the cards are different views, so every one is made again.
+        list.setAdapter(adapter);
+        mScrollToSelected = true;
+        refresh();
+    }
+
+    /** Switches the view without going through the menu. */
+    void setGridForTesting(boolean grid) {
+        setGrid(grid);
+    }
+
+    private void sizePanel(int rootWidth) {
+        Panel panel = mPanel;
+        if (panel == null) return;
+        mPanelWidth = Math.min(Math.round(rootWidth * WIDTH_FRACTION), dp(MAX_WIDTH_DP));
+        FrameLayout.LayoutParams params = (FrameLayout.LayoutParams) panel.getLayoutParams();
+        if (params.width != mPanelWidth) {
+            params.width = mPanelWidth;
+            panel.setLayoutParams(params);
+        }
+        applyProgress(mProgress);
+    }

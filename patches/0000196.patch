+
+    @Test
+    public void testOpenLinksInAppsStartsAtNeverAndShowsWhatTheUserHas() {
+        assertEquals(
+                BareOpenInAppsMode.Mode.NEVER, BareWelcomeOverlay.currentChoices(false).openLinksInApps);

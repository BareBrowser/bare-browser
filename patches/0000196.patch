@@ -0,0 +1,65 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.search_engines.settings;
+
+import android.view.LayoutInflater;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.CompoundButton;
+
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.chrome.browser.preferences.Pref;
+import org.chromium.chrome.browser.profiles.Profile;
+import org.chromium.chrome.browser.search_engines.R;
+import org.chromium.components.prefs.PrefService;
+import org.chromium.components.user_prefs.UserPrefs;
+
+/**
+ * Two switches shown above the list of search engines: whether the address bar suggests searches
+ * as you type, and whether it suggests pages from the history. The first is Chromium's own
+ * setting, the same one Google services shows. The second is Bare's, read by the history,
+ * shortcuts and fuzzy history providers; the address bar still goes to what was typed either way.
+ */
+@NullMarked
+final class BareSuggestionSwitches {
+    /** Registered in browser_prefs.cc and read by the omnibox providers. On unless turned off. */
+    static final String PREF_SUGGEST_HISTORY_URLS = "bare.omnibox.suggest_history_urls";
+
+    private BareSuggestionSwitches() {}
+
+    static View create(LayoutInflater inflater, ViewGroup parent, Profile profile) {
+        View view = inflater.inflate(R.layout.bare_suggestion_switches, parent, false);
+        PrefService prefs = UserPrefs.get(profile);
+        bind(
+                view.findViewById(R.id.bare_search_suggestions_row),
+                view.findViewById(R.id.bare_search_suggestions_switch),
+                prefs.getBoolean(Pref.SEARCH_SUGGEST_ENABLED),
+                !prefs.isManagedPreference(Pref.SEARCH_SUGGEST_ENABLED),
+                checked -> prefs.setBoolean(Pref.SEARCH_SUGGEST_ENABLED, checked));
+        bind(
+                view.findViewById(R.id.bare_history_urls_row),
+                view.findViewById(R.id.bare_history_urls_switch),
+                prefs.getBoolean(PREF_SUGGEST_HISTORY_URLS),
+                true,
+                checked -> prefs.setBoolean(PREF_SUGGEST_HISTORY_URLS, checked));
+        return view;
+    }
+
+    private interface OnChanged {
+        void onChanged(boolean checked);
+    }
+
+    private static void bind(
+            View row, CompoundButton toggle, boolean initial, boolean enabled, OnChanged listener) {
+        toggle.setChecked(initial);
+        row.setEnabled(enabled);
+        toggle.setEnabled(enabled);
+        row.setOnClickListener(
+                view -> {
+                    toggle.setChecked(!toggle.isChecked());
+                    listener.onChanged(toggle.isChecked());
+                });
+    }
+}

@@ -0,0 +1,33 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.ui.actions;
+
+import android.view.HapticFeedbackConstants;
+import android.view.View;
+
+import org.chromium.base.ContextUtils;
+import org.chromium.build.annotations.NullMarked;
+
+/**
+ * The tick under a finger when a toolbar button is pressed. It follows the phone's own touch
+ * feedback setting, so a phone with that turned off stays quiet, and Bare's switch in Settings,
+ * Media and haptics, which is on until the user turns it off.
+ */
+@NullMarked
+public final class ActionHaptics {
+    /** The same key as {@code ChromePreferenceKeys.BARE_HAPTICS}, which this module cannot see. */
+    private static final String KEY = "Bare.Haptics";
+
+    private ActionHaptics() {}
+
+    public static boolean isEnabled() {
+        return ContextUtils.getAppSharedPreferences().getBoolean(KEY, true);
+    }
+
+    public static void tick(View view) {
+        if (!isEnabled()) return;
+        view.performHapticFeedback(HapticFeedbackConstants.KEYBOARD_TAP);
+    }
+}

+import org.chromium.chrome.R;
+
+/** Tests for the bridge drawn under "Made with love in San Francisco". */
+@RunWith(BaseRobolectricTestRunner.class)
+public class BareGoldenGateViewUnitTest {
+    private final Context mContext =
+            new ContextThemeWrapper(
+                    ApplicationProvider.getApplicationContext(), R.style.Theme_BrowserUI_DayNight);
+
+    private BareGoldenGateView measured(int widthPx) {
+        BareGoldenGateView view = new BareGoldenGateView(mContext, null);
+        view.measure(
+                View.MeasureSpec.makeMeasureSpec(widthPx, View.MeasureSpec.AT_MOST),
+                View.MeasureSpec.makeMeasureSpec(0, View.MeasureSpec.UNSPECIFIED));
+        view.layout(0, 0, view.getMeasuredWidth(), view.getMeasuredHeight());
+        return view;
+    }
+
+    @Test
+    public void testItKeepsTheDrawingsProportions() {
+        BareGoldenGateView view = measured(300);
+        assertEquals(300, view.getMeasuredWidth());
+        assertEquals(Math.round(300 * 56f / 150f), view.getMeasuredHeight());
+    }
+
+    @Test
+    public void testItIsNotStretchedAcrossAWideScreen() {
+        float density = mContext.getResources().getDisplayMetrics().density;
+        BareGoldenGateView view = measured(5000);
+        assertTrue(view.getMeasuredWidth() <= Math.round(150 * 2.2f * density));
+    }
+
+    @Test
+    public void testItDrawsAtAnyWidth() {
+        for (int width : new int[] {150, 330, 700}) {
+            BareGoldenGateView view = measured(width);
+            Bitmap bitmap =
+                    Bitmap.createBitmap(
+                            view.getMeasuredWidth(),
+                            view.getMeasuredHeight(),
+                            Bitmap.Config.ARGB_8888);
+            view.draw(new Canvas(bitmap));
+        }
+    }
+}
diff --git a/chrome/android/junit/src/org/chromium/chrome/browser/bare/BareLauncherIconUnitTest.java b/chrome/android/junit/src/org/chromium/chrome/browser/bare/BareLauncherIconUnitTest.java
new file mode 100644

+            /** Puts the page's saved picture behind the card's text, softened and darkened. */
+            private void showThumbnail(Tab tab) {
+                ImageView thumb = mThumb;
+                View scrim = mScrim;
+                if (thumb == null || scrim == null) return;
+                mBoundTabId = tab.getId();
+                thumb.setImageDrawable(null);
+                thumb.setVisibility(View.GONE);
+                scrim.setVisibility(View.GONE);
+                setTextOnPicture(false);
+                TabContentManager content = mContentSupplier.get();
+                if (content == null) return;
+                int width =
+                        mPanelWidth > 0
+                                ? (mPanelWidth - dp(18) - dp(16)) / 2
+                                : mActivity.getResources().getDisplayMetrics().widthPixels / 3;
+                int height = dp(120);
+                int tabId = tab.getId();
+                content.getTabThumbnailWithCallback(
+                        tabId,
+                        new Size(Math.max(width, 1), height),
+                        bitmap -> {
+                            if (bitmap == null || mBoundTabId != tabId || !mGrid) return;
+                            thumb.setImageBitmap(bitmap);
+                            thumb.post(() -> fitTop(thumb, bitmap));
+                            thumb.setVisibility(View.VISIBLE);
+                            scrim.setVisibility(View.VISIBLE);
+                            setTextOnPicture(true);
+                        });
+            }
+
+            /** Fills the card with the picture, starting from the top of the page. */
+            private void fitTop(ImageView thumb, Bitmap bitmap) {
+                int viewWidth = thumb.getWidth();
+                int viewHeight = thumb.getHeight();
+                if (viewWidth <= 0 || viewHeight <= 0) return;
+                float scale =
+                        Math.max(
+                                viewWidth / (float) bitmap.getWidth(),
+                                viewHeight / (float) bitmap.getHeight());
+                Matrix matrix = new Matrix();
+                matrix.setScale(scale, scale);
+                matrix.postTranslate((viewWidth - bitmap.getWidth() * scale) / 2f, 0f);
+                thumb.setImageMatrix(matrix);
+            }

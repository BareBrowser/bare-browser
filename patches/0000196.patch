@@ -0,0 +1,190 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.bare.settings;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertNotNull;
+import static org.junit.Assert.assertNull;
+import static org.junit.Assert.assertTrue;
+
+import android.content.Context;
+import android.content.res.XmlResourceParser;
+
+import androidx.test.core.app.ApplicationProvider;
+
+import org.junit.Test;
+import org.junit.runner.RunWith;
+
+import org.chromium.base.test.BaseRobolectricTestRunner;
+import org.chromium.chrome.R;
+
+import java.util.ArrayList;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Set;
+
+/** Unit tests for {@link BareSettingsLayout}: nothing the page offers goes missing. */
+@RunWith(BaseRobolectricTestRunner.class)
+public class BareSettingsLayoutUnitTest {
+    /** The key of every preference in main_preferences.xml, which is the page's own list. */
+    private List<String> keysInMainPreferences() throws Exception {
+        Context context = ApplicationProvider.getApplicationContext();
+        List<String> keys = new ArrayList<>();
+        try (XmlResourceParser parser = context.getResources().getXml(R.xml.main_preferences)) {
+            int event = parser.next();
+            while (event != XmlResourceParser.END_DOCUMENT) {
+                if (event == XmlResourceParser.START_TAG) {
+                    for (int i = 0; i < parser.getAttributeCount(); i++) {
+                        if ("key".equals(parser.getAttributeName(i))) {
+                            keys.add(parser.getAttributeValue(i));
+                        }
+                    }
+                }
+                event = parser.next();
+            }
+        }
+        return keys;
+    }
+
+    @Test
+    public void testEveryPreferenceOnThePageIsPlacedSomewhere() throws Exception {
+        Set<String> categorised = BareSettingsLayout.allCategorisedKeys();
+        List<String> keys = keysInMainPreferences();
+        assertFalse(keys.isEmpty());
+        for (String key : keys) {
+            assertTrue(
+                    "'" + key + "' is on the settings page but on no category and not set aside",
+                    categorised.contains(key) || BareSettingsLayout.isKeptOffCategoryScreens(key));
+        }
+    }
+
+    @Test
+    public void testEveryKeyACategoryListsIsAPreferenceTheRealPageHas() throws Exception {
+        Set<String> real = new HashSet<>(keysInMainPreferences());
+        for (String key : BareSettingsLayout.allCategorisedKeys()) {
+            assertTrue("'" + key + "' is listed but is not on the settings page", real.contains(key));
+        }
+    }
+
+    @Test
+    public void testNoSettingIsListedOnTwoCategories() {
+        Set<String> seen = new HashSet<>();
+        for (BareSettingsLayout.Group group : BareSettingsLayout.groups()) {
+            for (BareSettingsLayout.Entry entry : group.entries) {
+                for (String key : entry.keys) {
+                    assertTrue("'" + key + "' is on two categories", seen.add(key));
+                }
+            }
+        }
+    }
+
+    @Test
+    public void testTheHomepageHasTheThreeApprovedGroupsInOrder() {
+        List<BareSettingsLayout.Group> groups = BareSettingsLayout.groups();
+        assertEquals(3, groups.size());
+        assertEquals(R.string.bare_settings_group_browser, groups.get(0).label);
+        assertEquals(R.string.bare_settings_group_tools, groups.get(1).label);
+        assertEquals(R.string.bare_settings_group_bare, groups.get(2).label);
+        List<String> rows = BareSettingsLayout.homeRowIds();
+        assertEquals(
+                java.util.Arrays.asList(
+                        "appearance",
+                        "privacy",
+                        "extensions",
+                        "browsing",
+                        "languages",
+                        "autofill",
+                        "notifications",
+                        "accessibility",
+                        "developer",
+                        "about",
+                        "updates"),
+                rows);
+    }
+
+    @Test
+    public void testTheMappingFromTheHandoff() {
+        assertTrue(BareSettingsLayout.findCategory("appearance").keys.containsAll(
+                java.util.Arrays.asList(
+                        "bare_ui_theme",
+                        "address_bar",
+                        "homepage",
+                        "bare_toolbar_shortcut",
+                        "bare_toolbar",
+                        "bare_app_icon")));
+        assertTrue(BareSettingsLayout.findCategory("privacy").keys.containsAll(
+                java.util.Arrays.asList(
+                        "privacy",
+                        "safety_hub",
+                        "bare_security",
+                        "content_settings",
+                        "bare_open_links_in_apps",
+                        "default_browser")));
+        assertDirect("extensions", "bare_extensions");
+        assertEquals(
+                java.util.Arrays.asList("search_engine", "tabs", "media", "downloads"),
+                BareSettingsLayout.findCategory("browsing").keys);
+        assertEquals(
+                java.util.Arrays.asList("languages", "bare_translate"),
+                BareSettingsLayout.findCategory("languages").keys);
+        assertEquals(
+                java.util.Arrays.asList("notifications", "bare_push"),
+                BareSettingsLayout.findCategory("notifications").keys);
+        assertDirect("accessibility", "accessibility");
+    }
+
+    /** A row whose one setting is its page opens it from the homepage, with no screen between. */
+    private static void assertDirect(String id, String key) {
+        assertEquals(null, BareSettingsLayout.findCategory(id));
+        boolean found = false;
+        for (BareSettingsLayout.Group group : BareSettingsLayout.groups()) {
+            for (BareSettingsLayout.Entry entry : group.entries) {
+                if (!entry.id.equals(id)) continue;
+                found = true;
+                assertTrue(entry.direct);
+                assertFalse(entry.isCategory());
+                assertEquals(java.util.Arrays.asList(key), entry.keys);
+            }
+        }
+        assertTrue(found);
+    }
+
+    @Test
+    public void testTheHomepageShowsOnlyTheUpdateRowAndTheFooterOfTheOldSettings() {
+        Set<String> shown = BareSettingsLayout.keysShownOn(null);
+        assertEquals(2, shown.size());
+        assertTrue(shown.contains(BareSettingsLayout.KEY_UPDATES));
+        assertTrue(shown.contains(BareSettingsLayout.KEY_FOOTER));
+    }
+
+    @Test
+    public void testACategoryScreenShowsItsOwnSettingsAndNotTheFooter() {
+        Set<String> shown = BareSettingsLayout.keysShownOn("browsing");
+        assertTrue(shown.contains("search_engine"));
+        assertTrue(shown.contains("downloads"));
+        assertFalse(shown.contains("privacy"));
+        assertFalse(shown.contains(BareSettingsLayout.KEY_FOOTER));
+    }
+
+    @Test
+    public void testAnUnknownCategoryIsTheHomepage() {
+        assertNull(BareSettingsLayout.findCategory("nope"));
+        assertNull(BareSettingsLayout.findCategory(null));
+        assertEquals(BareSettingsLayout.keysShownOn(null), BareSettingsLayout.keysShownOn("nope"));
+    }
+
+    @Test
+    public void testEveryRowHasATitleAndAnIcon() {
+        Context context = ApplicationProvider.getApplicationContext();
+        for (BareSettingsLayout.Group group : BareSettingsLayout.groups()) {
+            assertFalse(context.getString(group.label).isEmpty());
+            for (BareSettingsLayout.Entry entry : group.entries) {
+                assertFalse(context.getString(entry.title).isEmpty());
+                assertNotNull(BareSettingsIcons.create(context, entry.icon));
+            }
+        }
+    }
+}

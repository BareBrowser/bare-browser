+
+    @Test
+    public void testTheAddressBarPreviewSitsUnderTheTopAndBottomControl() {
+        View page = inflate(R.layout.bare_welcome_page_yours);
+        View group = page.findViewById(R.id.bare_seg_group);
+        BareAddressBarPreviewView preview = page.findViewById(R.id.bare_address_bar_preview);
+        assertNotNull(preview);
+        assertTrue("under the control", preview.getTop() > ((View) group.getParent()).getBottom() - 1);
+        assertEquals(
+                "same card",
+                ((View) group.getParent()).getParent(),
+                preview.getParent());
+        assertEquals(View.IMPORTANT_FOR_ACCESSIBILITY_NO, preview.getImportantForAccessibility());
+    }
+
+    @Test
+    public void testThePreviewFollowsTheChoice() {
+        BareAddressBarPreviewView preview = new BareAddressBarPreviewView(mContext, null);
+        assertTrue(preview.isBarOnTop());
+        preview.setBarOnTop(false, false);
+        assertFalse(preview.isBarOnTop());
+        preview.setBarOnTop(true, false);
+        assertTrue(preview.isBarOnTop());
+    }
+
+    @Test
+    public void testThePreviewDrawsWithTheBarAtEitherEnd() {
+        BareAddressBarPreviewView preview = new BareAddressBarPreviewView(mContext, null);
+        preview.measure(
+                View.MeasureSpec.makeMeasureSpec(400, View.MeasureSpec.AT_MOST),

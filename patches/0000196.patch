+        root.setVisibility(View.VISIBLE);
+        root.requestApplyInsets();
+        if (mBackCallback != null) mBackCallback.setEnabled(true);
+        animateTo(1f, null);
+        Panel panel = mPanel;
+        if (panel != null) {
+            panel.announceForAccessibility(
+                    mActivity.getString(org.chromium.chrome.R.string.bare_vtabs_title));
+        }
+    }

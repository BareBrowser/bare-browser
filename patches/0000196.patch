+package org.chromium.chrome.browser.bare.settings;
+
+import android.app.Activity;
+import android.app.AlertDialog;
+import android.content.Context;
+import android.graphics.drawable.Drawable;
+import android.graphics.drawable.GradientDrawable;
+import android.view.Gravity;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.ImageView;
+import android.widget.LinearLayout;
+import android.widget.TextView;
+
+import androidx.annotation.DrawableRes;
+import androidx.annotation.StringRes;
+import androidx.appcompat.content.res.AppCompatResources;
+
+import org.chromium.base.Callback;
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.chrome.R;
+import org.chromium.chrome.browser.bare.BareLauncherIcon;
+import org.chromium.chrome.browser.bare.BareLauncherIcon.Choice;
+import org.chromium.components.browser_ui.styles.SemanticColorUtils;
+
+/** The three launcher icons, shown as they will look, to pick one from. */
+@NullMarked
+public final class BareIconChooser {
+    private BareIconChooser() {}
+
+    public static @StringRes int labelFor(@Choice int choice) {
+        switch (choice) {
+            case Choice.DARK:
+                return R.string.bare_app_icon_dark;
+            case Choice.RETRO:
+                return R.string.bare_app_icon_retro;
+            default:
+                return R.string.bare_app_icon_light;
+        }
+    }
+
+    private static @DrawableRes int previewFor(@Choice int choice) {
+        switch (choice) {
+            case Choice.DARK:
+                return R.mipmap.bare_icon_dark;
+            case Choice.RETRO:
+                return R.drawable.ic_launcher;
+            default:
+                return R.mipmap.bare_icon_v5;
+        }
+    }
+
+    /** Asks which icon to use, applies the answer, and tells {@code onChosen} what it was. */
+    public static void show(Activity activity, Callback<Integer> onChosen) {
+        float density = activity.getResources().getDisplayMetrics().density;
+        LinearLayout row = new LinearLayout(activity);
+        row.setOrientation(LinearLayout.HORIZONTAL);
+        row.setGravity(Gravity.CENTER);
+        int pad = Math.round(16 * density);
+        row.setPadding(pad, pad, pad, pad);
+
+        AlertDialog[] dialog = new AlertDialog[1];
+        @Choice int current = BareLauncherIcon.getChoice();
+        for (@Choice int choice = 0; choice < Choice.COUNT; choice++) {
+            row.addView(tile(activity, choice, choice == current, dialog, onChosen), tileParams(density));
+        }
+
+        dialog[0] =
+                new AlertDialog.Builder(activity, R.style.ThemeOverlay_BrowserUI_AlertDialog)
+                        .setTitle(R.string.bare_app_icon_title)
+                        .setView(row)
+                        .setNegativeButton(R.string.cancel, null)
+                        .create();
+        dialog[0].show();
+    }
+
+    private static LinearLayout.LayoutParams tileParams(float density) {
+        LinearLayout.LayoutParams params =
+                new LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1f);
+        params.setMargins(Math.round(4 * density), 0, Math.round(4 * density), 0);
+        return params;
+    }
+
+    private static View tile(
+            Activity activity,
+            @Choice int choice,
+            boolean selected,
+            AlertDialog[] dialog,
+            Callback<Integer> onChosen) {
+        Context context = activity;
+        float density = context.getResources().getDisplayMetrics().density;
+        LinearLayout tile = new LinearLayout(context);
+        tile.setOrientation(LinearLayout.VERTICAL);
+        tile.setGravity(Gravity.CENTER_HORIZONTAL);
+        int pad = Math.round(10 * density);
+        tile.setPadding(pad, pad, pad, pad);
+        GradientDrawable frame = new GradientDrawable();
+        frame.setCornerRadius(16 * density);
+        if (selected) {
+            frame.setStroke(
+                    Math.round(2 * density), SemanticColorUtils.getDefaultControlColorActive(context));
+        }
+        tile.setBackground(frame);
+
+        ImageView preview = new ImageView(context);
+        Drawable icon = AppCompatResources.getDrawable(context, previewFor(choice));
+        preview.setImageDrawable(icon);
+        int size = Math.round(64 * density);
+        tile.addView(preview, new LinearLayout.LayoutParams(size, size));
+
+        TextView label = new TextView(context);
+        label.setText(labelFor(choice));
+        label.setGravity(Gravity.CENTER);
+        label.setTextSize(14);
+        label.setPadding(0, Math.round(8 * density), 0, 0);
+        label.setTextColor(SemanticColorUtils.getDefaultTextColor(context));
+        tile.addView(label);
+
+        tile.setContentDescription(context.getString(labelFor(choice)));
+        tile.setClickable(true);
+        tile.setFocusable(true);
+        tile.setOnClickListener(
+                v -> {
+                    BareLauncherIcon.setChoice(context.getApplicationContext(), choice);
+                    if (dialog[0] != null) dialog[0].dismiss();
+                    onChosen.onResult(choice);
+                });
+        return tile;
+    }
+}

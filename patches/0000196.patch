diff --git a/chrome/browser/ui/android/favicon/java/src/org/chromium/chrome/browser/ui/favicon/BareLogoFavicon.java b/chrome/browser/ui/android/favicon/java/src/org/chromium/chrome/browser/ui/favicon/BareLogoFavicon.java
new file mode 100644
index 00000000000..91f2cda56d5
--- /dev/null
+++ b/chrome/browser/ui/android/favicon/java/src/org/chromium/chrome/browser/ui/favicon/BareLogoFavicon.java
@@ -0,0 +1,33 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.ui.favicon;
+
+import androidx.annotation.DrawableRes;
+
+import org.chromium.build.annotations.NullMarked;
+
+/**
+ * Picks the small logo shown as the favicon of Bare's own pages, such as the New tab page. It is
+ * Bare's leaf. Cached favicons built earlier in the session keep the logo they were made with
+ * until Bare is restarted.
+ */
+@NullMarked
+public final class BareLogoFavicon {
+    private BareLogoFavicon() {}
+
+    /** The drawable to use where the original logo was used: Bare's leaf. */
+    public static @DrawableRes int getChromeLogoResource() {
+        return R.drawable.bare_logo_favicon16;
+    }
+
+    /**
+     * Bare's leaf as a single colour on a clear background, for the places that draw a favicon in
+     * the colour of the surface they sit on, such as the tab switcher. The coloured leaf there
+     * came out as a flat square, because only its outline's transparency is kept.
+     */
+    public static @DrawableRes int getMonoLogoResource() {
+        return R.drawable.bare_logo_mono16;
+    }
+}

+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.bare;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertNotNull;
+import static org.junit.Assert.assertTrue;
+import static org.mockito.ArgumentMatchers.any;
+import static org.mockito.ArgumentMatchers.anyBoolean;
+import static org.mockito.ArgumentMatchers.eq;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.never;
+import static org.mockito.Mockito.verify;
+import static org.mockito.Mockito.when;
+
+import android.app.Activity;
+import android.graphics.Bitmap;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.TextView;
+
+import androidx.recyclerview.widget.RecyclerView;
+import androidx.test.ext.junit.rules.ActivityScenarioRule;
+
+import org.junit.Before;
+import org.junit.Rule;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.robolectric.Shadows;
+import org.robolectric.shadows.ShadowLooper;
+
+import org.chromium.base.test.BaseRobolectricTestRunner;
+import org.chromium.chrome.browser.tab.Tab;
+import org.chromium.chrome.browser.tab.TabFavicon;
+import org.chromium.chrome.browser.tab.TabSelectionType;
+import org.chromium.chrome.browser.tabmodel.TabCreator;
+import org.chromium.chrome.browser.tabmodel.TabCreatorManager;
+import org.chromium.chrome.browser.tabmodel.TabModel;
+import org.chromium.chrome.browser.tabmodel.TabModelSelector;
+import org.chromium.chrome.browser.tabmodel.TabRemover;
+import org.chromium.ui.base.TestActivity;
+import org.chromium.url.JUnitTestGURLs;
+
+/** Unit tests for {@link BareVerticalTabsDrawer}: what it lists and what its buttons do. */
+@RunWith(BaseRobolectricTestRunner.class)
+public class BareVerticalTabsDrawerUnitTest {
+    @Rule
+    public ActivityScenarioRule<TestActivity> mActivityScenarioRule =
+            new ActivityScenarioRule<>(TestActivity.class);
+
+    private Activity mActivity;
+    private TabModelSelector mSelector;
+    private TabModel mModel;
+    private TabRemover mRemover;
+    private TabCreatorManager mCreators;
+    private TabCreator mCreator;
+    private Tab mFirst;
+    private Tab mSecond;
+    private BareVerticalTabsDrawer mDrawer;
+
+    private Tab tab(int id, String title) {
+        Tab tab = mock(Tab.class);
+        when(tab.getId()).thenReturn(id);
+        when(tab.getTitle()).thenReturn(title);
+        when(tab.getUrl()).thenReturn(JUnitTestGURLs.URL_1);
+        return tab;
+    }
+
+    @Before
+    public void setUp() {
+        mActivityScenarioRule.getScenario().onActivity(activity -> mActivity = activity);
+        TabFavicon favicon = mock(TabFavicon.class);
+        TabFavicon.setInstanceForTesting(favicon);
+
+        mFirst = tab(1, "First");
+        mSecond = tab(2, "Second");
+        mRemover = mock(TabRemover.class);
+        mModel = mock(TabModel.class);
+        when(mModel.getCount()).thenReturn(2);
+        when(mModel.getTabAt(0)).thenReturn(mFirst);
+        when(mModel.getTabAt(1)).thenReturn(mSecond);
+        when(mModel.index()).thenReturn(1);
+        when(mModel.getTabRemover()).thenReturn(mRemover);
+        mSelector = mock(TabModelSelector.class);
+        when(mSelector.getCurrentModel()).thenReturn(mModel);
+        when(mSelector.getCurrentTabModelSupplier())
+                .thenReturn(org.chromium.base.supplier.ObservableSuppliers.createMonotonic(mModel));
+        mCreator = mock(TabCreator.class);
+        mCreators = mock(TabCreatorManager.class);
+        when(mCreators.getTabCreator(false)).thenReturn(mCreator);
+
+        mDrawer = new BareVerticalTabsDrawer(mActivity, () -> mSelector, () -> mCreators);
+    }
+
+    private ViewGroup content() {
+        return mActivity.findViewById(android.R.id.content);
+    }
+
+    private <T extends View> T find(View view, Class<T> type) {
+        if (type.isInstance(view)) return type.cast(view);
+        if (view instanceof ViewGroup group) {
+            for (int i = 0; i < group.getChildCount(); i++) {
+                T found = find(group.getChildAt(i), type);
+                if (found != null) return found;
+            }
+        }
+        return null;
+    }
+
+    private View button(String text) {
+        for (TextView view : texts(content())) {
+            if (text.contentEquals(view.getText())) return view;
+        }
+        return null;
+    }
+
+    private java.util.List<TextView> texts(View view) {
+        java.util.List<TextView> found = new java.util.ArrayList<>();
+        if (view instanceof TextView textView) found.add(textView);
+        if (view instanceof ViewGroup group) {
+            for (int i = 0; i < group.getChildCount(); i++) {
+                found.addAll(texts(group.getChildAt(i)));
+            }
+        }
+        return found;
+    }
+
+    private RecyclerView openAndGetList() {
+        mDrawer.open();
+        Shadows.shadowOf(android.os.Looper.getMainLooper()).idle();
+        RecyclerView list = find(content(), RecyclerView.class);
+        assertNotNull(list);
+        list.measure(
+                View.MeasureSpec.makeMeasureSpec(1000, View.MeasureSpec.EXACTLY),
+                View.MeasureSpec.makeMeasureSpec(2000, View.MeasureSpec.EXACTLY));
+        list.layout(0, 0, 1000, 2000);
+        return list;
+    }
+
+    @Test
+    public void testOpenListsTheTabsOfTheCurrentModel() {
+        RecyclerView list = openAndGetList();
+        assertTrue(mDrawer.isOpen());
+        assertEquals(2, list.getAdapter().getItemCount());
+        assertEquals(1L, list.getAdapter().getItemId(0));
+        assertEquals(2L, list.getAdapter().getItemId(1));
+    }
+
+    @Test
+    public void testToggleClosesAnOpenDrawer() {
+        openAndGetList();
+        mDrawer.toggle();
+        assertFalse(mDrawer.isOpen());
+        mDrawer.toggle();
+        assertTrue(mDrawer.isOpen());
+    }
+
+    @Test
+    public void testNothingOpensWithoutATabModelSelector() {
+        BareVerticalTabsDrawer drawer =
+                new BareVerticalTabsDrawer(mActivity, () -> null, () -> mCreators);
+        drawer.open();
+        assertFalse(drawer.isOpen());
+    }
+
+    @Test
+    public void testSelectingARowSelectsThatTabAndCloses() {
+        RecyclerView list = openAndGetList();
+        View row = list.findViewHolderForAdapterPosition(0).itemView;
+        row.performClick();
+        verify(mModel).setIndex(0, TabSelectionType.FROM_USER);
+        assertFalse(mDrawer.isOpen());
+    }
+
+    @Test
+    public void testTheCloseButtonOnARowClosesThatTabAndLeavesTheDrawerOpen() {
+        RecyclerView list = openAndGetList();
+        ViewGroup row = (ViewGroup) list.findViewHolderForAdapterPosition(0).itemView;
+        row.findViewWithTag("close").performClick();
+        verify(mRemover).closeTabs(any(), eq(true));
+        assertTrue(mDrawer.isOpen());
+    }
+
+    @Test
+    public void testNewTabOpensANewTabPageAndCloses() {
+        openAndGetList();
+        button("New tab").performClick();
+        verify(mCreator).launchNtp(org.chromium.chrome.browser.tab.TabLaunchType.FROM_CHROME_UI);
+        assertFalse(mDrawer.isOpen());
+    }
+
+    @Test
+    public void testCloseAllClosesEveryTabThroughTheTabRemover() {
+        openAndGetList();
+        button("Close all").performClick();
+        verify(mRemover).closeTabs(any(), eq(true));
+        assertFalse(mDrawer.isOpen());
+    }
+
+    @Test
+    public void testCloseAllDoesNothingWithNoTabs() {
+        when(mModel.getCount()).thenReturn(0);
+        openAndGetList();
+        button("Close all").performClick();
+        verify(mRemover, never()).closeTabs(any(), anyBoolean());
+    }
+
+    @Test
+    public void testSwitchingToTheGridWithTheAddressBarAtTheBottomDoesNotThrow() {
+        org.chromium.chrome.browser.preferences.ChromeSharedPreferences.getInstance()
+                .writeInt(
+                        org.chromium.chrome.browser.preferences.ChromePreferenceKeys
+                                .TOOLBAR_TOP_ANCHORED,
+                        3);
+        try {
+            // The grid is where it starts; the test begins from the list.
+            org.chromium.chrome.browser.preferences.ChromeSharedPreferences.getInstance()
+                    .writeBoolean(
+                            org.chromium.chrome.browser.preferences.ChromePreferenceKeys
+                                    .BARE_VERTICAL_TABS_GRID,
+                            false);
+            RecyclerView list = openAndGetList();
+            assertFalse(list.getLayoutManager() instanceof androidx.recyclerview.widget.GridLayoutManager);
+
+            mDrawer.setGridForTesting(true);
+            Shadows.shadowOf(android.os.Looper.getMainLooper()).idle();
+            assertTrue(list.getLayoutManager() instanceof androidx.recyclerview.widget.GridLayoutManager);
+            assertEquals(2, ((androidx.recyclerview.widget.GridLayoutManager) list.getLayoutManager()).getSpanCount());
+
+            mDrawer.setGridForTesting(false);
+            Shadows.shadowOf(android.os.Looper.getMainLooper()).idle();
+            assertFalse(list.getLayoutManager() instanceof androidx.recyclerview.widget.GridLayoutManager);
+        } finally {
+            org.chromium.chrome.browser.preferences.ChromeSharedPreferences.getInstance()
+                    .removeKey(
+                            org.chromium.chrome.browser.preferences.ChromePreferenceKeys
+                                    .TOOLBAR_TOP_ANCHORED);
+            org.chromium.chrome.browser.preferences.ChromeSharedPreferences.getInstance()
+                    .removeKey(
+                            org.chromium.chrome.browser.preferences.ChromePreferenceKeys
+                                    .BARE_VERTICAL_TABS_GRID);
+        }
+    }
+
+    @Test
+    public void testTheDrawerStartsAsAGrid() {
+        org.chromium.chrome.browser.preferences.ChromeSharedPreferences.getInstance()
+                .removeKey(
+                        org.chromium.chrome.browser.preferences.ChromePreferenceKeys
+                                .BARE_VERTICAL_TABS_GRID);
+        RecyclerView list = openAndGetList();
+        assertTrue(list.getLayoutManager() instanceof androidx.recyclerview.widget.GridLayoutManager);
+        assertEquals(
+                2,
+                ((androidx.recyclerview.widget.GridLayoutManager) list.getLayoutManager())
+                        .getSpanCount());
+    }
+}

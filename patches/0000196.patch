+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.bare;
+
+import android.graphics.Canvas;
+import android.graphics.ColorFilter;
+import android.graphics.Paint;
+import android.graphics.PixelFormat;
+import android.graphics.Rect;
+import android.graphics.Typeface;
+import android.graphics.drawable.Drawable;
+
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+
+/** A round badge with the first letter of a search engine, for engines with no icon of their own. */
+@NullMarked
+public class BareEngineLetterDrawable extends Drawable {
+    private final Paint mCircle = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint mText = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final String mLetter;
+
+    public BareEngineLetterDrawable(String name) {
+        mLetter = name.isEmpty() ? "?" : name.substring(0, 1).toUpperCase();
+        mCircle.setColor(0xFF3989FF);
+        mText.setColor(0xFFFFFFFF);
+        mText.setTypeface(Typeface.create(Typeface.DEFAULT, Typeface.BOLD));
+        mText.setTextAlign(Paint.Align.CENTER);
+    }
+
+    @Override
+    public void draw(Canvas canvas) {
+        Rect b = getBounds();
+        float r = Math.min(b.width(), b.height()) / 2f;
+        canvas.drawCircle(b.exactCenterX(), b.exactCenterY(), r, mCircle);
+        mText.setTextSize(r * 1.1f);
+        float y = b.exactCenterY() - (mText.descent() + mText.ascent()) / 2f;
+        canvas.drawText(mLetter, b.exactCenterX(), y, mText);
+    }
+
+    @Override
+    public void setAlpha(int alpha) {
+        mCircle.setAlpha(alpha);
+        mText.setAlpha(alpha);
+    }
+
+    @Override
+    public void setColorFilter(@Nullable ColorFilter colorFilter) {
+        mCircle.setColorFilter(colorFilter);
+        mText.setColorFilter(colorFilter);
+    }
+
+    @Override
+    public int getOpacity() {
+        return PixelFormat.TRANSLUCENT;
+    }
+}
diff --git a/chrome/android/java/src/org/chromium/chrome/browser/bare/BareGoldenGateView.java b/chrome/android/java/src/org/chromium/chrome/browser/bare/BareGoldenGateView.java
new file mode 100644
index 00000000000..684e8c2a4d4
--- /dev/null
+++ b/chrome/android/java/src/org/chromium/chrome/browser/bare/BareGoldenGateView.java
@@ -0,0 +1,213 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.bare;
+
+import android.animation.ValueAnimator;
+import android.content.Context;
+import android.graphics.Canvas;
+import android.graphics.Paint;
+import android.graphics.Path;
+import android.graphics.RectF;
+import android.os.SystemClock;
+import android.util.AttributeSet;
+import android.view.View;
+
+import androidx.annotation.ColorInt;
+
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.chrome.R;
+
+/**
+ * The sign-off drawn under "Made with love in San Francisco": a small Golden Gate Bridge with a
+ * car crossing it now and then, fog drifting across the towers and two slow waves of water. It is
+ * the same drawing, in the same proportions and timings, as the sign-off at the bottom of Settings
+ * in BareTube on iOS. It stands still when animations are turned off in Android's settings.
+ */
+@NullMarked
+public class BareGoldenGateView extends View {
+    /** The size the drawing was made at. Everything below is in these units and scaled up. */
+    private static final float DESIGN_WIDTH = 150f;
+
+    private static final float DESIGN_HEIGHT = 56f;
+
+    /** The moment shown while nothing moves: the car is on the bridge and the sun is mid-glow. */
+    private static final double STILL_TIME = 3.0;
+
+    private static final int ORANGE = 0xFFC73829;
+    private static final int SUN = 0xFFFFD60A;
+    private static final int WATER = 0xFF0A84FF;
+    private static final int CAR = 0xFF30B0C7;
+
+    private final Paint mPaint = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Path mPath = new Path();
+    private final RectF mRect = new RectF();
+    private final @ColorInt int mWheels;
+    private final long mStart = SystemClock.uptimeMillis();
+
+    public BareGoldenGateView(Context context, AttributeSet attrs) {
+        super(context, attrs);
+        mWheels = context.getColor(R.color.bare_welcome_body);
+    }
+
+    @Override
+    protected void onMeasure(int widthMeasureSpec, int heightMeasureSpec) {
+        // Keep the drawing's proportions, and no wider than it reads well at.
+        float density = getResources().getDisplayMetrics().density;
+        int width = MeasureSpec.getSize(widthMeasureSpec);
+        if (MeasureSpec.getMode(widthMeasureSpec) == MeasureSpec.UNSPECIFIED) {
+            width = Math.round(DESIGN_WIDTH * density);
+        }
+        int maxWidth = Math.round(DESIGN_WIDTH * 2.2f * density);
+        width = Math.min(width, maxWidth);
+        setMeasuredDimension(width, Math.round(width * DESIGN_HEIGHT / DESIGN_WIDTH));
+    }
+
+    private static boolean animated() {
+        return ValueAnimator.areAnimatorsEnabled();
+    }
+
+    private static @ColorInt int withAlpha(@ColorInt int color, float alpha) {
+        return (color & 0x00FFFFFF) | (Math.round(alpha * 255f) << 24);
+    }
+
+    private void stroke(Canvas canvas, Path path, @ColorInt int color, float width, Paint.Cap cap) {
+        mPaint.setStyle(Paint.Style.STROKE);
+        mPaint.setColor(color);
+        mPaint.setStrokeWidth(width);
+        mPaint.setStrokeCap(cap);
+        mPaint.setStrokeJoin(Paint.Join.ROUND);
+        canvas.drawPath(path, mPaint);
+    }
+
+    private void line(
+            Canvas canvas,
+            float x1,
+            float y1,
+            float x2,
+            float y2,
+            @ColorInt int color,
+            float width,
+            Paint.Cap cap) {
+        mPath.rewind();
+        mPath.moveTo(x1, y1);
+        mPath.lineTo(x2, y2);
+        stroke(canvas, mPath, color, width, cap);
+    }
+
+    private void fillOval(Canvas canvas, float l, float t, float w, float h, @ColorInt int color) {
+        mPaint.setStyle(Paint.Style.FILL);
+        mPaint.setColor(color);
+        mRect.set(l, t, l + w, t + h);
+        canvas.drawOval(mRect, mPaint);
+    }
+
+    @Override
+    protected void onDraw(Canvas canvas) {
+        boolean moving = animated();
+        double time = moving ? (SystemClock.uptimeMillis() - mStart) / 1000.0 : STILL_TIME;
+
+        canvas.save();
+        float scale = getWidth() / DESIGN_WIDTH;
+        canvas.scale(scale, scale);
+        float w = DESIGN_WIDTH;
+        float h = DESIGN_HEIGHT;
+        float deckY = h * 0.66f;
+        float[] towers = {w * 0.28f, w * 0.72f};
+        float towerTop = h * 0.10f;
+
+        // A pale sun behind the first tower, breathing a little.
+        float pulse = (float) (0.5 + 0.5 * Math.sin(time * 0.8));
+        fillOval(canvas, w * 0.10f, h * 0.06f, 22, 22, withAlpha(SUN, 0.22f + 0.1f * pulse));
+
+        // Water: two slow waves under the deck.
+        float[] offsets = {h * 0.84f, h * 0.93f};
+        for (int index = 0; index < 2; index++) {
+            mPath.rewind();
+            for (float x = 0; x <= w; x += 2) {
+                float y =
+                        (float)
+                                (offsets[index]
+                                        + Math.sin(x / 9 + time * (1.6 + index * 0.5) + index) * 1.4);
+                if (x == 0) {
+                    mPath.moveTo(x, y);
+                } else {
+                    mPath.lineTo(x, y);
+                }
+            }
+            stroke(canvas, mPath, withAlpha(WATER, index == 0 ? 0.45f : 0.28f), 1.4f, Paint.Cap.ROUND);
+        }
+
+        // Main cable and the two side spans.
+        mPath.rewind();
+        mPath.moveTo(0, deckY - 4);
+        mPath.quadTo(towers[0] * 0.55f, deckY - 4, towers[0], towerTop);
+        mPath.quadTo(w / 2, deckY - 2, towers[1], towerTop);
+        mPath.quadTo(towers[1] + (w - towers[1]) * 0.45f, deckY - 4, w, deckY - 4);
+        stroke(canvas, mPath, ORANGE, 1.6f, Paint.Cap.ROUND);
+
+        // Hangers between the towers, down from the cable to the deck.
+        for (float x = towers[0] + 6; x <= towers[1] - 6; x += 6) {
+            float t = (x - towers[0]) / (towers[1] - towers[0]);
+            // The middle curve above, at this fraction of the way across.
+            float cableY = towerTop + 2 * t * (1 - t) * (deckY - 2 - towerTop);
+            line(canvas, x, cableY + 1, x, deckY, withAlpha(ORANGE, 0.7f), 0.7f, Paint.Cap.BUTT);
+        }
+
+        // Deck.
+        line(canvas, 0, deckY, w, deckY, ORANGE, 2.6f, Paint.Cap.ROUND);
+
+        // Towers: two legs, cross beams.
+        for (float x : towers) {
+            for (float dx : new float[] {-2.6f, 2.6f}) {
+                line(canvas, x + dx, towerTop - 1, x + dx, deckY + 5, ORANGE, 2.2f, Paint.Cap.BUTT);
+            }
+            for (float fraction : new float[] {0f, 0.3f, 0.6f}) {
+                float y = towerTop + 5 + (deckY - towerTop - 10) * fraction;
+                line(canvas, x - 2.6f, y, x + 2.6f, y, ORANGE, 1.2f, Paint.Cap.BUTT);
+            }
+        }
+
+        // A little car crossing the deck, now and then.
+        double cycle = 9.0;
+        double travel = (time % cycle) / cycle * 1.6 - 0.3;
+        if (travel > -0.1 && travel < 1.1) {
+            float x = (float) (w * travel);
+            mPaint.setStyle(Paint.Style.FILL);
+            mPaint.setColor(CAR);
+            mRect.set(x - 4, deckY - 5, x + 4, deckY - 5 + 3.6f);
+            canvas.drawRoundRect(mRect, 1.5f, 1.5f, mPaint);
+            @ColorInt int wheel = withAlpha(mWheels, 0.7f);
+            fillOval(canvas, x - 3, deckY - 2, 2, 2, wheel);
+            fillOval(canvas, x + 1, deckY - 2, 2, 2, wheel);
+        }
+
+        // Fog drifting across the lower half of the towers.
+        double[] speeds = {14.0, 9.0};
+        for (int index = 0; index < 2; index++) {
+            double span = w + 60;
+            float x = (float) ((time * speeds[index] + index * 70) % span - 40);
+            mPaint.setStyle(Paint.Style.FILL);
+            mPaint.setColor(withAlpha(0xFFFFFFFF, 0.22f));
+            float top = h * (0.50f + 0.07f * index);
+            mRect.set(x, top, x + 46, top + 6);
+            canvas.drawRoundRect(mRect, 3, 3, mPaint);
+        }
+        canvas.restore();
+
+        if (moving && isShown()) postInvalidateOnAnimation();
+    }
+
+    @Override
+    protected void onVisibilityChanged(View changed, int visibility) {
+        super.onVisibilityChanged(changed, visibility);
+        if (visibility == VISIBLE) postInvalidateOnAnimation();
+    }
+
+    @Override
+    protected void onAttachedToWindow() {
+        super.onAttachedToWindow();
+        postInvalidateOnAnimation();
+    }
+}

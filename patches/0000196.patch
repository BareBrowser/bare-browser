diff --git a/chrome/android/java/src/org/chromium/chrome/browser/bare/BareAddressBarPreviewView.java b/chrome/android/java/src/org/chromium/chrome/browser/bare/BareAddressBarPreviewView.java
new file mode 100644
index 00000000000..f12df8d9e0e
--- /dev/null
+++ b/chrome/android/java/src/org/chromium/chrome/browser/bare/BareAddressBarPreviewView.java
@@ -0,0 +1,136 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.bare;
+
+import android.animation.ValueAnimator;
+import android.content.Context;
+import android.graphics.Canvas;
+import android.graphics.Paint;
+import android.graphics.RectF;
+import android.util.AttributeSet;
+import android.view.View;
+
+import androidx.annotation.ColorInt;
+
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.chrome.R;
+
+/**
+ * A small phone with a page on it and the address bar at the top or at the bottom, shown under the
+ * welcome's address bar choice. It draws the selected layout in the accent colour, the way the
+ * selected half of the Top and Bottom control is drawn, and slides the bar when the choice changes.
+ */
+@NullMarked
+public class BareAddressBarPreviewView extends View {
+    private static final long SLIDE_MS = 220;
+
+    private final Paint mPaint = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final RectF mRect = new RectF();
+    private final float mDensity;
+    private final @ColorInt int mAccent;
+    private final @ColorInt int mMuted;
+    private final @ColorInt int mSoft;
+
+    private boolean mBarOnTop = true;
+    // 0 with the bar at the top, 1 with it at the bottom. Between the two while it slides.
+    private float mPosition;
+    private ValueAnimator mSlide;
+
+    public BareAddressBarPreviewView(Context context, AttributeSet attrs) {
+        super(context, attrs);
+        mDensity = context.getResources().getDisplayMetrics().density;
+        mAccent = context.getColor(R.color.bare_welcome_accent);
+        mMuted = context.getColor(R.color.bare_welcome_body);
+        mSoft = context.getColor(R.color.bare_welcome_soft);
+    }
+
+    /** True when the bar is drawn at the top of the phone. */
+    public boolean isBarOnTop() {
+        return mBarOnTop;
+    }
+
+    /** Draws the bar at the top or the bottom, sliding it there unless {@code animate} is false. */
+    public void setBarOnTop(boolean onTop, boolean animate) {
+        if (mBarOnTop == onTop && mSlide == null) return;
+        mBarOnTop = onTop;
+        if (mSlide != null) mSlide.cancel();
+        float target = onTop ? 0f : 1f;
+        if (!animate || !isLaidOut()) {
+            mPosition = target;
+            invalidate();
+            return;
+        }
+        mSlide = ValueAnimator.ofFloat(mPosition, target);
+        mSlide.setDuration(SLIDE_MS);
+        mSlide.addUpdateListener(
+                animation -> {
+                    mPosition = (float) animation.getAnimatedValue();
+                    invalidate();
+                });
+        mSlide.start();
+    }
+
+    @Override
+    protected void onMeasure(int widthMeasureSpec, int heightMeasureSpec) {
+        int width = Math.round(104 * mDensity);
+        int height = Math.round(150 * mDensity);
+        setMeasuredDimension(resolveSize(width, widthMeasureSpec), resolveSize(height, heightMeasureSpec));
+    }
+
+    @Override
+    protected void onDetachedFromWindow() {
+        if (mSlide != null) mSlide.cancel();
+        mSlide = null;
+        super.onDetachedFromWindow();
+    }
+
+    private static @ColorInt int withAlpha(@ColorInt int color, int alpha) {
+        return (color & 0x00FFFFFF) | (alpha << 24);
+    }
+
+    @Override
+    protected void onDraw(Canvas canvas) {
+        float w = getWidth();
+        float h = getHeight();
+        float stroke = 2 * mDensity;
+
+        // The phone.
+        mRect.set(stroke / 2, stroke / 2, w - stroke / 2, h - stroke / 2);
+        float corner = 16 * mDensity;
+        mPaint.setStyle(Paint.Style.FILL);
+        mPaint.setColor(mSoft);
+        canvas.drawRoundRect(mRect, corner, corner, mPaint);
+        mPaint.setStyle(Paint.Style.STROKE);
+        mPaint.setStrokeWidth(stroke);
+        mPaint.setColor(mAccent);
+        canvas.drawRoundRect(mRect, corner, corner, mPaint);
+
+        // The page: lines of text, laid out for the bar at the top or at the bottom and kept clear
+        // of it. They follow the bar while it slides.
+        float pad = 12 * mDensity;
+        float barHeight = 16 * mDensity;
+        float gap = 9 * mDensity;
+        float topBar = pad;
+        float bottomBar = h - pad - barHeight;
+        float barTop = topBar + (bottomBar - topBar) * mPosition;
+        float contentTop = pad + 4 * mDensity + (barHeight + gap) * (1 - mPosition);
+        float contentBottom = h - pad - (barHeight + gap) * mPosition;
+        mPaint.setStyle(Paint.Style.FILL);
+        mPaint.setColor(withAlpha(mMuted, 70));
+        float lineHeight = 5 * mDensity;
+        float step = 11 * mDensity;
+        int index = 0;
+        for (float y = contentTop; y + lineHeight <= contentBottom; y += step, index++) {
+            float right = w - pad - (index % 3 == 2 ? 14 * mDensity : 0);
+            mRect.set(pad, y, right, y + lineHeight);
+            canvas.drawRoundRect(mRect, lineHeight / 2, lineHeight / 2, mPaint);
+        }
+
+        // The address bar.
+        mPaint.setColor(mAccent);
+        mRect.set(pad, barTop, w - pad, barTop + barHeight);
+        canvas.drawRoundRect(mRect, barHeight / 2, barHeight / 2, mPaint);
+    }
+}

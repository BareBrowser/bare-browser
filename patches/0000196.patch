+        View row = holder.itemView;
+        row.setContentDescription(
+                row.getContext().getString(R.string.bare_welcome_made_with_spoken));
+        row.setImportantForAccessibility(View.IMPORTANT_FOR_ACCESSIBILITY_YES);
+    }
+}

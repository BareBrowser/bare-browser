+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.omnibox;
+
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.components.search_engines.TemplateUrlService;
+import org.chromium.url.GURL;
+
+/**
+ * A search engine chosen for one New tab page only.
+ *
+ * <p>The page's search icon lets the user pick another engine. That choice does not touch the
+ * default. It is held here, tied to the page that made it, and applied once: when a search is sent
+ * from the address bar, its address, which the address bar built for the default engine, is
+ * rebuilt for the chosen one from the same query. The page clears it when it goes away.
+ */
+@NullMarked
+public final class BareSearchOverride {
+    private static @Nullable Object sOwner;
+    private static @Nullable String sTemplate;
+
+    private BareSearchOverride() {}
+
+    /** Searches from {@code owner} go to the engine whose address template is {@code template}. */
+    public static void set(Object owner, String template) {
+        sOwner = owner;
+        sTemplate = template;
+    }
+
+    /** Drops the choice if {@code owner} made it. */
+    public static void clear(Object owner) {
+        if (sOwner == owner) {
+            sOwner = null;
+            sTemplate = null;
+        }
+    }
+
+    public static boolean isActive() {
+        return sTemplate != null;
+    }
+
+    /**
+     * The address to load instead of {@code url}, or null to load {@code url} as it is.
+     *
+     * <p>Only a search results address for the default engine is rewritten, so typing a web address
+     * is never touched.
+     */
+    public static @Nullable String rewrite(@Nullable TemplateUrlService service, String url) {
+        String template = sTemplate;
+        if (template == null || service == null) return null;
+        GURL parsed = new GURL(url);
+        if (!service.isSearchResultsPageFromDefaultSearchProvider(parsed)) return null;
+        String query = service.getSearchQueryForUrl(parsed);
+        if (query == null || query.isEmpty()) return null;
+        @Nullable GURL expanded = service.expandUrlTemplate(template, query);
+        if (expanded == null) return null;
+        sOwner = null;
+        sTemplate = null;
+        return expanded.getSpec();
+    }
+}

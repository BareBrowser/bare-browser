+    /** Releases everything. Called when the activity goes away. */
+    public void destroy() {
+        if (mAnimator != null) mAnimator.cancel();
+        releaseObservers();
+        if (mBackCallback != null) mBackCallback.remove();
+        mBackCallback = null;
+        FrameLayout root = mRoot;
+        if (root != null && root.getParent() instanceof ViewGroup parent) {
+            parent.removeView(root);

+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.bare;
+
+import android.content.ComponentName;
+import android.content.Context;
+import android.content.pm.PackageManager;
+
+import androidx.annotation.IntDef;
+
+import org.chromium.base.task.PostTask;
+import org.chromium.base.task.TaskTraits;
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.chrome.browser.ChromeTabbedActivity;
+import org.chromium.chrome.browser.preferences.ChromePreferenceKeys;
+import org.chromium.chrome.browser.preferences.ChromeSharedPreferences;
+
+import java.lang.annotation.Retention;
+import java.lang.annotation.RetentionPolicy;
+
+/**
+ * Which launcher icon Bare shows: the leaf on light, which is the default, the leaf on dark, or the
+ * retro icon Bare shipped before.
+ *
+ * <p>Android has no call that swaps an app's icon. The way to show another one is a launcher entry
+ * for each, an alias of the main activity with its own icon, with exactly one enabled. The default
+ * entry, {@link ChromeTabbedActivity#MAIN_LAUNCHER_ACTIVITY_NAME}, is enabled in the manifest, so a
+ * build that never changes the choice behaves as it always has.
+ *
+ * <p>One caveat belongs to Android and not to Bare: a launcher may remove a shortcut that was
+ * placed on the home screen from the entry that has just been disabled. The app drawer shows the
+ * entry that is enabled.
+ */
+@NullMarked
+public final class BareLauncherIcon {
+    @IntDef({Choice.LIGHT, Choice.DARK, Choice.RETRO})
+    @Retention(RetentionPolicy.SOURCE)
+    public @interface Choice {
+        int LIGHT = 0;
+        int DARK = 1;
+        int RETRO = 2;
+        int COUNT = 3;
+    }
+
+    private BareLauncherIcon() {}
+
+    /** The icon in use. Anything unrecognised is the default. */
+    public static @Choice int getChoice() {
+        int stored =
+                ChromeSharedPreferences.getInstance()
+                        .readInt(ChromePreferenceKeys.BARE_LAUNCHER_ICON, Choice.LIGHT);
+        return stored >= 0 && stored < Choice.COUNT ? stored : Choice.LIGHT;
+    }
+
+    /** The launcher entry that shows this icon. */
+    public static String entryFor(@Choice int choice) {
+        switch (choice) {
+            case Choice.DARK:
+                return ChromeTabbedActivity.DARK_ICON_LAUNCHER_ACTIVITY_NAME;
+            case Choice.RETRO:
+                return ChromeTabbedActivity.RETRO_ICON_LAUNCHER_ACTIVITY_NAME;
+            default:
+                return ChromeTabbedActivity.MAIN_LAUNCHER_ACTIVITY_NAME;
+        }
+    }
+
+    /** Remembers the choice and shows it. */
+    public static void setChoice(Context context, @Choice int choice) {
+        ChromeSharedPreferences.getInstance()
+                .writeInt(ChromePreferenceKeys.BARE_LAUNCHER_ICON, choice);
+        // Changing a component's state is a system call that can block.
+        PostTask.postTask(TaskTraits.BEST_EFFORT_MAY_BLOCK, () -> apply(context));
+    }
+
+    /**
+     * Makes the enabled entries match the stored choice. The entry to be shown is enabled before
+     * the others are disabled, so there is never a moment with no launcher entry. Run at startup
+     * too, because clearing the app's data resets the stored choice but not the system's record.
+     */
+    public static void apply(Context context) {
+        @Choice int chosen = getChoice();
+        setEntry(context, entryFor(chosen), true, chosen == Choice.LIGHT);
+        for (@Choice int other = 0; other < Choice.COUNT; other++) {
+            if (other != chosen) setEntry(context, entryFor(other), false, other == Choice.LIGHT);
+        }
+        // The second icon of earlier builds is never the one shown now.
+        setEntry(context, ChromeTabbedActivity.LEGACY_ICON_LAUNCHER_ACTIVITY_NAME, false, false);
+    }
+
+    /** {@code manifestDefault} is the state the manifest gives the entry before any override. */
+    private static void setEntry(
+            Context context, String name, boolean enabled, boolean manifestDefault) {
+        PackageManager packageManager = context.getPackageManager();
+        ComponentName entry = new ComponentName(context.getPackageName(), name);
+        int wanted =
+                enabled
+                        ? PackageManager.COMPONENT_ENABLED_STATE_ENABLED
+                        : PackageManager.COMPONENT_ENABLED_STATE_DISABLED;
+        try {
+            int current = packageManager.getComponentEnabledSetting(entry);
+            if (current == PackageManager.COMPONENT_ENABLED_STATE_DEFAULT) {
+                if (enabled == manifestDefault) return;
+            } else if (current == wanted) {
+                return;
+            }
+            packageManager.setComponentEnabledSetting(entry, wanted, PackageManager.DONT_KILL_APP);
+        } catch (IllegalArgumentException | SecurityException e) {
+            // Not in this build's manifest.
+        }
+    }
+}

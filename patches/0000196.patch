+                }
+                mRow.setSelected(selected);
+                String label = title;
+                mRow.setContentDescription(
+                        selected
+                                ? mActivity.getString(R.string.bare_vtabs_row_current, label)
+                                : label);
+                mRow.setOnClickListener(v -> selectTab(tab));
+                mClose.setContentDescription(
+                        mActivity.getString(R.string.bare_vtabs_close_tab, label));
+                mClose.setOnClickListener(v -> closeTab(tab));
+            }

@@ -0,0 +1,160 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.bare;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+
+import static org.robolectric.Shadows.shadowOf;
+
+import android.content.ComponentName;
+import android.content.Context;
+import android.content.pm.PackageManager;
+
+import androidx.test.core.app.ApplicationProvider;
+
+import org.junit.After;
+import org.junit.Before;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+
+import org.chromium.base.test.BaseRobolectricTestRunner;
+import org.chromium.chrome.browser.ChromeTabbedActivity;
+import org.chromium.chrome.browser.bare.BareLauncherIcon.Choice;
+import org.chromium.chrome.browser.preferences.ChromePreferenceKeys;
+import org.chromium.chrome.browser.preferences.ChromeSharedPreferences;
+
+/** Tests for the three launcher icons and how one is chosen and switched to. */
+@RunWith(BaseRobolectricTestRunner.class)
+public class BareLauncherIconUnitTest {
+    private final Context mContext = ApplicationProvider.getApplicationContext();
+    private final ComponentName[] mEntries = new ComponentName[Choice.COUNT];
+
+    @Before
+    public void setUp() {
+        reset();
+        for (int choice = 0; choice < Choice.COUNT; choice++) {
+            mEntries[choice] =
+                    new ComponentName(mContext.getPackageName(), BareLauncherIcon.entryFor(choice));
+            shadowOf(mContext.getPackageManager()).addActivityIfNotPresent(mEntries[choice]);
+        }
+    }
+
+    @After
+    public void tearDown() {
+        reset();
+    }
+
+    private static void reset() {
+        ChromeSharedPreferences.getInstance().removeKey(ChromePreferenceKeys.BARE_LAUNCHER_ICON);
+    }
+
+    private int state(@Choice int choice) {
+        return mContext.getPackageManager().getComponentEnabledSetting(mEntries[choice]);
+    }
+
+    @Test
+    public void testTheLeafOnLightIsTheDefault() {
+        assertEquals(Choice.LIGHT, BareLauncherIcon.getChoice());
+        assertEquals(
+                ChromeTabbedActivity.MAIN_LAUNCHER_ACTIVITY_NAME,
+                BareLauncherIcon.entryFor(Choice.LIGHT));
+    }
+
+    @Test
+    public void testNothingChangesForAUserWhoNeverChose() {
+        BareLauncherIcon.apply(mContext);
+        for (int choice = 0; choice < Choice.COUNT; choice++) {
+            assertEquals(PackageManager.COMPONENT_ENABLED_STATE_DEFAULT, state(choice));
+        }
+    }
+
+    @Test
+    public void testChoosingDarkShowsOnlyTheDarkEntry() {
+        BareLauncherIcon.setChoice(mContext, Choice.DARK);
+        assertEquals(Choice.DARK, BareLauncherIcon.getChoice());
+        BareLauncherIcon.apply(mContext);
+        assertEquals(PackageManager.COMPONENT_ENABLED_STATE_ENABLED, state(Choice.DARK));
+        assertEquals(PackageManager.COMPONENT_ENABLED_STATE_DISABLED, state(Choice.LIGHT));
+        assertEquals(PackageManager.COMPONENT_ENABLED_STATE_DEFAULT, state(Choice.RETRO));
+    }
+
+    @Test
+    public void testChoosingRetroThenLightComesBackToTheDefault() {
+        BareLauncherIcon.setChoice(mContext, Choice.RETRO);
+        BareLauncherIcon.apply(mContext);
+        assertEquals(PackageManager.COMPONENT_ENABLED_STATE_ENABLED, state(Choice.RETRO));
+        assertEquals(PackageManager.COMPONENT_ENABLED_STATE_DISABLED, state(Choice.LIGHT));
+
+        BareLauncherIcon.setChoice(mContext, Choice.LIGHT);
+        BareLauncherIcon.apply(mContext);
+        assertEquals(PackageManager.COMPONENT_ENABLED_STATE_ENABLED, state(Choice.LIGHT));
+        assertEquals(PackageManager.COMPONENT_ENABLED_STATE_DISABLED, state(Choice.RETRO));
+        // Never switched on, so the system has no record for it: off by the manifest.
+        assertFalse(state(Choice.DARK) == PackageManager.COMPONENT_ENABLED_STATE_ENABLED);
+    }
+
+    @Test
+    public void testAStoredValueNobodyKnowsIsTheDefault() {
+        ChromeSharedPreferences.getInstance().writeInt(ChromePreferenceKeys.BARE_LAUNCHER_ICON, 99);
+        assertEquals(Choice.LIGHT, BareLauncherIcon.getChoice());
+    }
+
+    @Test
+    public void testStartupRepairsEntriesLeftOverFromClearedData() {
+        // The dark entry was enabled, then the app's data was cleared, so nothing says it is chosen.
+        mContext.getPackageManager()
+                .setComponentEnabledSetting(
+                        mEntries[Choice.DARK],
+                        PackageManager.COMPONENT_ENABLED_STATE_ENABLED,
+                        PackageManager.DONT_KILL_APP);
+        mContext.getPackageManager()
+                .setComponentEnabledSetting(
+                        mEntries[Choice.LIGHT],
+                        PackageManager.COMPONENT_ENABLED_STATE_DISABLED,
+                        PackageManager.DONT_KILL_APP);
+        BareLauncherIcon.apply(mContext);
+        assertEquals(PackageManager.COMPONENT_ENABLED_STATE_ENABLED, state(Choice.LIGHT));
+        assertEquals(PackageManager.COMPONENT_ENABLED_STATE_DISABLED, state(Choice.DARK));
+    }
+
+    @Test
+    public void testTheSecondIconOfEarlierBuildsIsSwitchedOffAndStillKnown() {
+        ComponentName legacy =
+                new ComponentName(
+                        mContext.getPackageName(),
+                        ChromeTabbedActivity.LEGACY_ICON_LAUNCHER_ACTIVITY_NAME);
+        shadowOf(mContext.getPackageManager()).addActivityIfNotPresent(legacy);
+        mContext.getPackageManager()
+                .setComponentEnabledSetting(
+                        legacy,
+                        PackageManager.COMPONENT_ENABLED_STATE_ENABLED,
+                        PackageManager.DONT_KILL_APP);
+        mContext.getPackageManager()
+                .setComponentEnabledSetting(
+                        mEntries[Choice.LIGHT],
+                        PackageManager.COMPONENT_ENABLED_STATE_DISABLED,
+                        PackageManager.DONT_KILL_APP);
+        BareLauncherIcon.apply(mContext);
+        assertEquals(
+                PackageManager.COMPONENT_ENABLED_STATE_DISABLED,
+                mContext.getPackageManager().getComponentEnabledSetting(legacy));
+        assertEquals(PackageManager.COMPONENT_ENABLED_STATE_ENABLED, state(Choice.LIGHT));
+        assertTrue(
+                ChromeTabbedActivity.isLauncherAlias(
+                        ChromeTabbedActivity.LEGACY_ICON_LAUNCHER_ACTIVITY_NAME));
+    }
+
+    @Test
+    public void testEveryEntryIsKnownAsTheMainActivity() {
+        for (int choice = 0; choice < Choice.COUNT; choice++) {
+            String name = BareLauncherIcon.entryFor(choice);
+            assertTrue(ChromeTabbedActivity.isLauncherAlias(name));
+            assertTrue(ChromeTabbedActivity.TABBED_MODE_COMPONENT_NAMES.contains(name));
+        }
+        assertFalse(ChromeTabbedActivity.isLauncherAlias(ChromeTabbedActivity.class.getName()));
+    }
+}

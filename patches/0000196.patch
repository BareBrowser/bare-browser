+
+    private View inflate(int layout) {
+        View page =
+                LayoutInflater.from(mContext).inflate(layout, new FrameLayout(mContext), false);
+        page.measure(
+                View.MeasureSpec.makeMeasureSpec(1080, View.MeasureSpec.EXACTLY),

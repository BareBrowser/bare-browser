+        assertTrue(shown(page.findViewById(R.id.bare_row_address_swipe)));
+        for (int id :
+                new int[] {
+                    R.id.bare_row_first_button,
+                    R.id.bare_divider_first_button,
+                    R.id.bare_row_second_button,
+                    R.id.bare_divider_second_button,
+                    R.id.bare_row_bar_swipe,
+                    R.id.bare_divider_bar_swipe
+                }) {
+            assertFalse(shown(page.findViewById(id)));
+        }
+    }
+
+    @Test
+    public void testTheFullLayoutKeepsEveryRowAndDivider() {
+        View page = inflate(R.layout.bare_welcome_page_toolbar);
+        BareWelcomeOverlay.showBottomBarRows(page, false);
+        BareWelcomeOverlay.showBottomBarRows(page, true);
+        ViewGroup card = (ViewGroup) page.findViewById(R.id.bare_row_minimal).getParent();

+    private void switchBareCategory(@Nullable String target, boolean forward) {
+        if (!mBareLayout || Objects.equals(target, mBareCategory)) return;
+        if (mBareAnimator != null) mBareAnimator.end();
+
+        var list = isAdded() && getView() != null ? getListView() : null;
+        var layoutManager = list != null ? list.getLayoutManager() : null;
+        if (forward && layoutManager != null) {
+            mBareHomeListState = layoutManager.onSaveInstanceState();
+        }
+
+        // A picture of what is there now, for the screen that is leaving.
+        Bitmap picture = null;
+        int background = bareBackgroundColor(list);
+        if (list != null
+                && list.isLaidOut()
+                && list.getWidth() > 0
+                && list.getHeight() > 0
+                && list.getParent() instanceof FrameLayout) {
+            picture = Bitmap.createBitmap(list.getWidth(), list.getHeight(), Bitmap.Config.ARGB_8888);
+            Canvas canvas = new Canvas(picture);
+            canvas.drawColor(background);
+            list.draw(canvas);
+        }
+
+        mBareCategory = target;
+        mPageTitle.set(bareTitle());
+        applyBareVisibility();
+        updateBareChrome();
+        if (getActivity() instanceof SettingsMenuHelper.Delegate delegate
+                && delegate.getSearchCoordinator() != null) {
+            // The search box belongs to the homepage only.
+            delegate.getSearchCoordinator().refreshSearchBoxVisibility();
+        }
+        // The cards are drawn from what is showing, so they are worked out again.
+        notifyPreferencesUpdated();
+
+        if (list == null) return;
+        if (target != null) {
+            list.scrollToPosition(0);
+        } else if (mBareHomeListState != null && layoutManager != null) {
+            layoutManager.onRestoreInstanceState(mBareHomeListState);
+            mBareHomeListState = null;
+        }
+        if (picture == null) return;
+
+        FrameLayout holder = (FrameLayout) list.getParent();
+        ImageView leaving = new ImageView(getContext());
+        leaving.setImageBitmap(picture);
+        FrameLayout.LayoutParams params =
+                new FrameLayout.LayoutParams(list.getWidth(), list.getHeight());
+        params.leftMargin = list.getLeft();
+        params.topMargin = list.getTop();
+        // Forward, the new screen is on top of the old one; back, the old one is on top.
+        holder.addView(leaving, forward ? holder.indexOfChild(list) : holder.getChildCount(), params);
+        android.graphics.drawable.Drawable listBackground = list.getBackground();
+        list.setBackgroundColor(background);
+
+        float width = list.getWidth();
+        ValueAnimator animator = ValueAnimator.ofFloat(0f, 1f);
+        animator.setDuration(BARE_TRANSITION_MS);
+        animator.setInterpolator(new android.view.animation.PathInterpolator(0.2f, 0.8f, 0.2f, 1f));
+        animator.addUpdateListener(
+                a -> {
+                    float t = (float) a.getAnimatedValue();
+                    if (forward) {
+                        list.setTranslationX(width * (1f - t));
+                        list.setAlpha(1f);
+                        leaving.setTranslationX(-BARE_BEHIND_SHIFT * width * t);
+                        leaving.setAlpha(1f - (1f - BARE_BEHIND_ALPHA) * t);
+                    } else {
+                        leaving.setTranslationX(width * t);
+                        leaving.setAlpha(1f);
+                        list.setTranslationX(-BARE_BEHIND_SHIFT * width * (1f - t));
+                        list.setAlpha(BARE_BEHIND_ALPHA + (1f - BARE_BEHIND_ALPHA) * t);
+                    }
+                });
+        animator.addListener(
+                new android.animation.AnimatorListenerAdapter() {
+                    private boolean mFinished;
+
+                    private void finish() {
+                        if (mFinished) return;
+                        mFinished = true;
+                        list.setTranslationX(0f);
+                        list.setAlpha(1f);
+                        list.setBackground(listBackground);
+                        holder.removeView(leaving);
+                        if (mBareAnimator == animator) mBareAnimator = null;
+                    }
+
+                    @Override
+                    public void onAnimationEnd(android.animation.Animator animation) {
+                        finish();
+                    }
+
+                    @Override
+                    public void onAnimationCancel(android.animation.Animator animation) {
+                        finish();
+                    }
+                });
+        // The first frame already shows the start of the move, so nothing flashes.
+        list.setTranslationX(forward ? width : -BARE_BEHIND_SHIFT * width);
+        mBareAnimator = animator;
+        animator.start();
     }
 

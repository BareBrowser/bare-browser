+    /** How long the finished glide is held before the copy is taken away. */
+    private static final long GLIDE_HOLD_MS = 220L;
+
+    /**
+     * Bare: the new tab glides in from the right like a card laid on a table, while the page it
+     * covers moves a quarter of the way out to the left. Both stay inside the page's own area, so
+     * the bars under the page, which are drawn from a picture of themselves for the length of the
+     * glide, never move.
+     *
+     * <p>The page that is leaving is a picture of the window taken as the glide starts, because
+     * the real page cannot be moved sideways from here; until the picture is ready it is the page
+     * colour. The page that arrives is a copy of the New tab page as it last looked. When the glide
+     * ends the copy is held in place for a moment while the real page is drawn under it, and then
+     * removed in one step, with no fade.
+     */
+    private void startRise(Rect finalRect) {
+        Context context = getContext();
+        int[] hostAt = new int[2];
+        getLocationInWindow(hostAt);
+        int height = finalRect.height();
+        int barsBottom = Integer.MAX_VALUE;
+        View bar = getRootView().findViewById(R.id.bottom_app_bar_container);
+        // The bar slides out of the way for the moment a tab is being made, so where it is drawn
+        // is not where it belongs. Where it is laid out, without its own movement, is where it
+        // comes back to, and the page stops there so it never runs over that space.
+        if (bar != null && bar.getHeight() > 0 && bar.getParent() instanceof View barParent) {
+            int[] parentAt = new int[2];
+            barParent.getLocationInWindow(parentAt);
+            int barTop = parentAt[1] + bar.getTop();
+            height = Math.min(height, barTop - hostAt[1] - finalRect.top);
+            barsBottom = parentAt[1] + bar.getBottom();
+        }
+        // With the address bar at the bottom the page is cut at the top of the address bar, not at
+        // the buttons under it, so it never draws over the bar.
+        View addressBar = getRootView().findViewById(R.id.control_container);
+        if (addressBar != null && addressBar.isShown() && addressBar.getHeight() > 0) {
+            int[] addressAt = new int[2];
+            addressBar.getLocationInWindow(addressAt);
+            if (addressAt[1] > hostAt[1] + getHeight() / 2) {
+                height = Math.min(height, addressAt[1] - hostAt[1] - finalRect.top);
+            }
+        }
+        final int viewportHeight = Math.max(height, 1);
+        final int viewportWidth = finalRect.width();
+        final int windowLeft = hostAt[0] + finalRect.left;
+        final int windowTop = hostAt[1] + finalRect.top;
+        final int lowestBarPixel = barsBottom;
+
+        FrameLayout viewport = new FrameLayout(context);
+        viewport.setClipChildren(true);
+        viewport.setClickable(true);
+        FrameLayout.LayoutParams params =
+                new FrameLayout.LayoutParams(viewportWidth, viewportHeight);
+        params.leftMargin = finalRect.left;
+        params.topMargin = finalRect.top;
+        addView(viewport, params);
+
+        // The page that is leaving. The page colour until its picture arrives, so that nothing
+        // shows through, then the picture itself.
+        ImageView previous = new ImageView(context);
+        previous.setBackgroundColor(mBackgroundColor);
+        previous.setScaleType(ImageView.ScaleType.MATRIX);
+        viewport.addView(
+                previous,
+                new FrameLayout.LayoutParams(
+                        ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT));
+
+        BareNewTabRiseView content =
+                new BareNewTabRiseView(
+                        context,
+                        mBackgroundColor,
+                        BareNtpAppearance.get(),
+                        windowLeft,
+                        windowTop);
+        viewport.addView(
+                content,
+                new FrameLayout.LayoutParams(
+                        ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT));
+        glide(content, previous, viewportWidth, viewportHeight);
+
+        @Nullable Activity activity = ContextUtils.activityFromContext(context);
+        @Nullable Window window = activity == null ? null : activity.getWindow();
+        View decor = window == null ? null : window.getDecorView();
+        if (window == null || decor == null || decor.getWidth() <= 0 || decor.getHeight() <= 0) {
+            return;
+        }
+        Bitmap shot =
+                Bitmap.createBitmap(decor.getWidth(), decor.getHeight(), Bitmap.Config.ARGB_8888);
+        PixelCopy.request(
+                window,
+                shot,
+                result -> {
+                    if (!isAttachedToWindow() || result != PixelCopy.SUCCESS) return;
+                    previous.setImageBitmap(shot);
+                    Matrix toPage = new Matrix();
+                    toPage.setTranslate(-windowLeft, -windowTop);
+                    previous.setImageMatrix(toPage);
+                    // The bars under the page: still, drawn from the picture, for the glide.
+                    int belowTop = windowTop + viewportHeight;
+                    int belowBottom = Math.min(shot.getHeight(), lowestBarPixel);
+                    if (belowBottom <= belowTop) return;
+                    ImageView bars = new ImageView(context);
+                    bars.setImageBitmap(shot);
+                    bars.setScaleType(ImageView.ScaleType.MATRIX);
+                    Matrix toBars = new Matrix();
+                    toBars.setTranslate(0, -belowTop);
+                    bars.setImageMatrix(toBars);
+                    FrameLayout.LayoutParams barsParams =
+                            new FrameLayout.LayoutParams(
+                                    ViewGroup.LayoutParams.MATCH_PARENT, belowBottom - belowTop);
+                    barsParams.topMargin = belowTop - getLocationOnWindowTop();
+                    addView(bars, barsParams);
+                },
+                new Handler(Looper.getMainLooper()));
+    }
+
+    private int getLocationOnWindowTop() {
+        int[] at = new int[2];
+        getLocationInWindow(at);
+        return at[1];
+    }
+
+    private void glide(
+            BareNewTabRiseView content, ImageView previous, int viewportWidth, int viewportHeight) {
+        float density = getContext().getResources().getDisplayMetrics().density;
+        // Starts off the right edge, a little low and turned a little, and turns about a point
+        // near the bottom of the page, as a card laid down by hand would.
+        content.setPivotX(viewportWidth * 0.5f);
+        content.setPivotY(viewportHeight * 0.8f);
+        content.setTranslationX(viewportWidth * 1.04f);
+        content.setTranslationY(12f * density);
+        content.setRotation(2.5f);
+
+        AnimatorSet glide = new AnimatorSet();
+        ObjectAnimator slideIn =
+                ObjectAnimator.ofFloat(content, View.TRANSLATION_X, viewportWidth * 1.04f, 0f);
+        glide.play(slideIn)
+                .with(ObjectAnimator.ofFloat(content, View.TRANSLATION_Y, 12f * density, 0f))
+                .with(ObjectAnimator.ofFloat(content, View.ROTATION, 2.5f, 0f))
+                .with(
+                        ObjectAnimator.ofFloat(
+                                previous, View.TRANSLATION_X, 0f, -viewportWidth * 0.24f));
+        glide.setDuration(RISE_DURATION_MS);
+        glide.setInterpolator(new PathInterpolator(0.16f, 1f, 0.3f, 1f));
+        mExpandAnimatorSet = glide;
+        glide.addListener(
+                new CancelAwareAnimatorListener() {
+                    @Override
+                    public void onEnd(Animator animation) {
+                        mExpandAnimatorSet = null;
+                        // The real tab is selected now. The copy stays exactly as it is while the
+                        // real page is drawn under it, then goes in one step.
+                        mListener.onExpandAnimationFinished();
+                        postDelayed(
+                                () -> {
+                                    if (isAttachedToWindow()) {
+                                        mListener.onForegroundAnimationFinished();
+                                    }
+                                },
+                                GLIDE_HOLD_MS);
+                    }
+
+                    @Override
+                    public void onCancel(Animator animation) {
+                        mExpandAnimatorSet = null;
+                        mFadeAnimator = null;
+                    }
+                });
+        glide.start();
+    }
+

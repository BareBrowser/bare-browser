+
+    @Test
+    public void testTheFinishPageDrawsTheBridgeItself() {
+        View page = inflate(R.layout.bare_welcome_page_finish);
+        assertTrue(page.findViewById(R.id.bare_bridge) instanceof BareGoldenGateView);
+        assertEquals(
+                "Made with love in San Francisco",
+                mContext.getString(R.string.bare_welcome_made_with_spoken));
+    }
+}

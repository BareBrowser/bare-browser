+package org.chromium.chrome.browser.bare.settings;
+
+import androidx.annotation.DrawableRes;
+import androidx.annotation.StringRes;
+
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.chrome.R;
+
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.Collections;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Set;
+
+/**
+ * How Settings is grouped: which settings sit under which category on the homepage.
+ *
+ * <p>Nothing here is a setting. Each setting is a preference the settings page already has, found
+ * by its key, and it keeps its own behaviour and its own destination. This only says where it is
+ * shown. A setting that is in {@code main_preferences.xml} and not named here is a setting that
+ * would have gone missing, which is what the unit test for this class exists to catch.
+ */
+@NullMarked
+public final class BareSettingsLayout {
+    /** The key of the row that checks for updates, which sits on the homepage itself. */
+    public static final String KEY_UPDATES = "bare_check_for_updates";
+
+    /** The footer with the bridge. */
+    public static final String KEY_FOOTER = "bare_made_with_love";
+
+    /** The two rows that open a page of their own from the homepage. */
+    public static final String KEY_DEVELOPER = "developer";
+
+    public static final String KEY_ABOUT = "about_chrome";
+
+    /** One row on the homepage. A category opens a screen of settings; the others open pages. */
+    public static final class Entry {
+        public final String id;
+        public final @StringRes int title;
+        public final @StringRes int summary;
+        public final @DrawableRes int icon;
+        /** The settings listed on the category's screen. Empty for a row that is not a category. */
+        public final List<String> keys;
+        /** A row that opens its one setting's page directly instead of a screen listing it. */
+        public final boolean direct;
+
+        Entry(
+                String id,
+                @StringRes int title,
+                @StringRes int summary,
+                @DrawableRes int icon,
+                String... keys) {
+            this(id, title, summary, icon, false, keys);
+        }
+
+        /** A row whose single setting is its page: it opens that page and has no screen between. */
+        static Entry direct(
+                String id, @StringRes int title, @StringRes int summary, @DrawableRes int icon, String key) {
+            return new Entry(id, title, summary, icon, true, key);
+        }
+
+        private Entry(
+                String id,
+                @StringRes int title,
+                @StringRes int summary,
+                @DrawableRes int icon,
+                boolean direct,
+                String... keys) {
+            this.direct = direct;
+            this.id = id;
+            this.title = title;
+            this.summary = summary;
+            this.icon = icon;
+            this.keys = Collections.unmodifiableList(Arrays.asList(keys));
+        }
+
+        public boolean isCategory() {
+            return !keys.isEmpty() && !direct;
+        }
+    }
+
+    /** A labelled card of rows. */
+    public static final class Group {
+        public final @StringRes int label;
+        public final List<Entry> entries;
+
+        Group(@StringRes int label, Entry... entries) {
+            this.label = label;
+            this.entries = Collections.unmodifiableList(Arrays.asList(entries));
+        }
+    }
+
+    private static final List<Group> GROUPS =
+            Collections.unmodifiableList(
+                    Arrays.asList(
+                            new Group(
+                                    R.string.bare_settings_group_browser,
+                                    new Entry(
+                                            "appearance",
+                                            R.string.bare_settings_cat_appearance,
+                                            R.string.bare_settings_cat_appearance_summary,
+                                            R.drawable.bare_settings_ic_palette,
+                                            "bare_ui_theme",
+                                            "address_bar",
+                                            "homepage",
+                                            "bare_toolbar_shortcut",
+                                            "bare_toolbar",
+                                            "bare_app_icon"),
+                                    new Entry(
+                                            "privacy",
+                                            R.string.bare_settings_cat_privacy,
+                                            R.string.bare_settings_cat_privacy_summary,
+                                            R.drawable.bare_settings_ic_shield,
+                                            "privacy",
+                                            "safety_hub",
+                                            "bare_security",
+                                            "content_settings",
+                                            "bare_open_links_in_apps",
+                                            "default_browser"),
+                                    Entry.direct(
+                                            "extensions",
+                                            R.string.bare_settings_cat_extensions,
+                                            R.string.bare_settings_cat_extensions_summary,
+                                            R.drawable.bare_settings_ic_puzzle,
+                                            "bare_extensions"),
+                                    new Entry(
+                                            "browsing",
+                                            R.string.bare_settings_cat_browsing,
+                                            R.string.bare_settings_cat_browsing_summary,
+                                            R.drawable.bare_settings_ic_sliders,
+                                            "search_engine",
+                                            "tabs",
+                                            "media",
+                                            "downloads")),
+                            new Group(
+                                    R.string.bare_settings_group_tools,
+                                    new Entry(
+                                            "languages",
+                                            R.string.bare_settings_cat_languages,
+                                            0,
+                                            R.drawable.bare_settings_ic_languages,
+                                            "languages",
+                                            "bare_translate"),
+                                    new Entry(
+                                            "autofill",
+                                            R.string.bare_settings_cat_autofill,
+                                            0,
+                                            R.drawable.bare_settings_ic_card,
+                                            "autofill_and_passwords",
+                                            "autofill_payment_methods",
+                                            "autofill_addresses",
+                                            "autofill_options"),
+                                    new Entry(
+                                            "notifications",
+                                            R.string.bare_settings_cat_notifications,
+                                            0,
+                                            R.drawable.bare_settings_ic_bell,
+                                            "notifications",
+                                            "bare_push"),
+                                    Entry.direct(
+                                            "accessibility",
+                                            R.string.bare_settings_cat_accessibility,
+                                            0,
+                                            R.drawable.bare_settings_ic_accessibility,
+                                            "accessibility")),
+                            new Group(
+                                    R.string.bare_settings_group_bare,
+                                    new Entry(
+                                            "developer",
+                                            R.string.bare_settings_cat_developer,
+                                            0,
+                                            R.drawable.bare_settings_ic_code),
+                                    new Entry(
+                                            "about",
+                                            R.string.bare_settings_cat_about,
+                                            0,
+                                            R.drawable.bare_settings_ic_info),
+                                    new Entry(
+                                            "updates",
+                                            R.string.bare_settings_cat_updates,
+                                            0,
+                                            R.drawable.bare_settings_ic_refresh))));
+
+    /**
+     * Settings kept in {@code main_preferences.xml} that no category lists, and why. The first four
+     * are not settings: headings and the promo card. Passwords, Google and the sign-in rows do not
+     * work in this build and are removed from the page. The rest are shown on the homepage rather
+     * than on a category screen.
+     */
+    private static final Set<String> NOT_ON_A_CATEGORY_SCREEN =
+            new HashSet<>(
+                    Arrays.asList(
+                            "settings_promo_card",
+                            "appearance",
+                            "basics_section",
+                            "autofill_section",
+                            "advanced_section",
+                            "passwords",
+                            "glic",
+                            "sign_in",
+                            "google_services",
+                            "account_and_google_services_section",
+                            KEY_DEVELOPER,
+                            KEY_ABOUT,
+                            KEY_UPDATES,
+                            KEY_FOOTER));
+
+    private BareSettingsLayout() {}
+
+    public static List<Group> groups() {
+        return GROUPS;
+    }
+
+    /** The category with this id, or null if there is none (or the id is for the homepage). */
+    public static @Nullable Entry findCategory(@Nullable String id) {
+        if (id == null) return null;
+        for (Group group : GROUPS) {
+            for (Entry entry : group.entries) {
+                if (entry.isCategory() && entry.id.equals(id)) return entry;
+            }
+        }
+        return null;
+    }
+
+    /**
+     * The existing settings to show: those of the category with this id, or, for the homepage, the
+     * ones that sit on it.
+     */
+    public static Set<String> keysShownOn(@Nullable String categoryId) {
+        Entry category = findCategory(categoryId);
+        Set<String> shown = new HashSet<>();
+        if (category == null) {
+            shown.add(KEY_UPDATES);
+            shown.add(KEY_FOOTER);
+        } else {
+            shown.addAll(category.keys);
+        }
+        return shown;
+    }
+
+    /** Every key a category lists, in no particular order. */
+    public static Set<String> allCategorisedKeys() {
+        Set<String> keys = new HashSet<>();
+        for (Group group : GROUPS) {
+            for (Entry entry : group.entries) keys.addAll(entry.keys);
+        }
+        return keys;
+    }
+
+    /** Whether a key is deliberately not on a category screen. */
+    public static boolean isKeptOffCategoryScreens(String key) {
+        return NOT_ON_A_CATEGORY_SCREEN.contains(key);
+    }
+
+    /** The ids of every row on the homepage, in order. */
+    public static List<String> homeRowIds() {
+        List<String> ids = new ArrayList<>();
+        for (Group group : GROUPS) {
+            for (Entry entry : group.entries) ids.add(entry.id);
+        }
+        return ids;
+    }
+}

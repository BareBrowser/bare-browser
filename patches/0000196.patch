@@ -0,0 +1,279 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.logo;
+
+import android.animation.ValueAnimator;
+import android.content.Context;
+import android.graphics.Canvas;
+import android.graphics.ColorFilter;
+import android.graphics.LinearGradient;
+import android.graphics.Paint;
+import android.graphics.Path;
+import android.graphics.PixelFormat;
+import android.graphics.Shader;
+import android.graphics.drawable.Animatable;
+import android.graphics.drawable.Drawable;
+import android.view.animation.LinearInterpolator;
+import android.view.animation.PathInterpolator;
+
+import androidx.annotation.ColorInt;
+import androidx.core.content.ContextCompat;
+import androidx.core.graphics.PathParser;
+
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+
+/**
+ * Bare's leaf with the two wings moving, as in the brand kit's animated logo: each wing turns a
+ * few degrees about the point where they meet and swells a little, and comes back, over a 4.2
+ * second loop. Drawn either alone, or after the word "bare", in the same place and at the same
+ * size as the still logo it replaces.
+ *
+ * <p>The motion runs while the drawable is visible and stops when it is not. A phone with
+ * animations turned off shows the leaf still.
+ */
+@NullMarked
+public final class BareAnimatedLogo extends Drawable implements Animatable {
+    private static final String BACK_WING =
+            "M 235.0 840.7 C 199.5 766.9 187.8 680.1 204.1 599.0 C 220.3 517.8 264.6 442.2 323.8"
+                + " 383.9 C 383.0 325.7 457.2 284.7 533.9 253.2 C 610.5 221.7 689.7 199.7 771.6"
+                + " 183.3 C 790.3 242.4 776.4 305.9 754.7 364.8 C 732.9 423.6 703.2 477.8 653.7"
+                + " 519.1 Z";
+    private static final String FRONT_WING =
+            "M 235.0 840.7 C 255.8 785.4 285.6 731.8 325.4 685.7 C 365.2 639.6 415.0 600.9 469.8"
+                + " 573.3 C 524.6 545.7 584.2 529.1 644.7 520.5 C 705.2 511.9 766.4 511.3 827.1"
+                + " 520.7 C 807.1 565.1 783.7 607.4 754.6 646.0 C 725.5 684.6 690.6 719.5 651.2"
+                + " 747.7 C 611.9 776.0 568.1 797.7 521.9 811.4 C 494.2 819.6 465.6 824.9 436.8"
+                + " 828.5 C 412.7 831.4 388.5 833.1 364.4 831.8 C 345.1 830.7 325.8 827.7 306.7"
+                + " 828.7 C 282.7 830.1 258.7 837.9 235.0 840.7 Z";
+
+    private static final float[] STOPS = {0f, 0.15f, 0.25f, 0.35f, 0.45f, 0.55f, 0.65f, 0.75f, 0.85f, 1f};
+    private static final @ColorInt int[] BACK_COLORS = {
+        0xFF73CDFA, 0xFF65BBF8, 0xFF5AACF7, 0xFF529BF6, 0xFF4987F6,
+        0xFF3F70F5, 0xFF385EF4, 0xFF3250F3, 0xFF2D41EF, 0xFF2B3CEA
+    };
+    private static final @ColorInt int[] FRONT_COLORS = {
+        0xFF3E6CF3, 0xFF437AF5, 0xFF4A8AF6, 0xFF5196F7, 0xFF56A0F6,
+        0xFF5EA8F7, 0xFF65B2F7, 0xFF6DB9F8, 0xFF75C3F8, 0xFF7FD0FA
+    };
+
+    /** Where the wings meet, in the logo's own units. */
+    private static final float PIVOT_X = 235.0f;
+    private static final float PIVOT_Y = 840.7f;
+
+    private static final long LOOP_MS = 4200L;
+    private static final PathInterpolator EASE_IN_OUT = new PathInterpolator(0.42f, 0f, 0.58f, 1f);
+
+    /** How the logo's own units map onto the drawable's bounds. */
+    private final float mViewportWidth;
+    private final float mViewportHeight;
+    private final float mOriginX;
+    private final float mOriginY;
+    private final float mScale;
+    private final int mIntrinsicWidth;
+    private final int mIntrinsicHeight;
+    /** The word, drawn first, or null when the leaf is alone. */
+    private final @Nullable Drawable mWord;
+
+    private final Path mBack = PathParser.createPathFromPathData(BACK_WING);
+    private final Path mFront = PathParser.createPathFromPathData(FRONT_WING);
+    private final Paint mBackPaint = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint mFrontPaint = new Paint(Paint.ANTI_ALIAS_FLAG);
+
+    private float mProgress;
+    private @Nullable ValueAnimator mAnimator;
+
+    private static final @ColorInt int[] INCOGNITO_BACK_COLORS = {0xFFA6C8E6, 0xFF657BAF};
+    private static final @ColorInt int[] INCOGNITO_FRONT_COLORS = {0xFF667EB9, 0xFFB1D4EC};
+    private static final float[] TWO_STOPS = {0f, 1f};
+
+    private BareAnimatedLogo(
+            @Nullable Drawable word,
+            float viewportWidth,
+            float viewportHeight,
+            float originX,
+            float originY,
+            float scale,
+            int intrinsicWidth,
+            int intrinsicHeight,
+            @ColorInt int[] backColors,
+            float[] backStops,
+            @ColorInt int[] frontColors,
+            float[] frontStops) {
+        mWord = word;
+        mViewportWidth = viewportWidth;
+        mViewportHeight = viewportHeight;
+        mOriginX = originX;
+        mOriginY = originY;
+        mScale = scale;
+        mIntrinsicWidth = intrinsicWidth;
+        mIntrinsicHeight = intrinsicHeight;
+        mBackPaint.setShader(
+                new LinearGradient(
+                        688.3f, 170.6f, 232.2f, 772.1f, backColors, backStops, Shader.TileMode.CLAMP));
+        mFrontPaint.setShader(
+                new LinearGradient(
+                        468.7f, 873.9f, 597.0f, 474.1f, frontColors, frontStops, Shader.TileMode.CLAMP));
+    }
+
+    /** The leaf alone, the size of the still leaf (96dp). */
+    public static Drawable leaf(Context context) {
+        float density = context.getResources().getDisplayMetrics().density;
+        int size = Math.round(96 * density);
+        // The still leaf is a 690 unit square, moved 170 units up and to the left.
+        return new BareAnimatedLogo(
+                null, 690f, 690f, -170f, -170f, 1f, size, size, BACK_COLORS, STOPS, FRONT_COLORS, STOPS);
+    }
+
+    /**
+     * The leaf on the brand kit's whole 1024 unit canvas, which leaves the margin the kit leaves
+     * around it, {@code sizeDp} square. In the colours of the Incognito page when asked.
+     */
+    public static Drawable canvasLeaf(Context context, int sizeDp, boolean incognito) {
+        float density = context.getResources().getDisplayMetrics().density;
+        int size = Math.round(sizeDp * density);
+        return new BareAnimatedLogo(
+                null,
+                1024f,
+                1024f,
+                0f,
+                0f,
+                1f,
+                size,
+                size,
+                incognito ? INCOGNITO_BACK_COLORS : BACK_COLORS,
+                incognito ? TWO_STOPS : STOPS,
+                incognito ? INCOGNITO_FRONT_COLORS : FRONT_COLORS,
+                incognito ? TWO_STOPS : STOPS);
+    }
+
+    /**
+     * The word "bare" with the leaf after it, the size of the still wordmark (150 by 65dp), the
+     * letters in the dark or the light colour of the page they sit on.
+     */
+    public static Drawable wordmark(Context context, boolean nightMode) {
+        float density = context.getResources().getDisplayMetrics().density;
+        Drawable word =
+                ContextCompat.getDrawable(
+                        context,
+                        nightMode ? R.drawable.bare_word_on_dark : R.drawable.bare_word_on_light);
+        assert word != null;
+        // The leaf sits in the wordmark's 507 by 220 units at (356.29, 37.17), at 0.1565 scale.
+        return new BareAnimatedLogo(
+                word.mutate(),
+                507f,
+                220f,
+                356.2913f,
+                37.1739f,
+                0.156522f,
+                Math.round(150 * density),
+                Math.round(65 * density),
+                BACK_COLORS,
+                STOPS,
+                FRONT_COLORS,
+                STOPS);
+    }
+
+    @Override
+    public int getIntrinsicWidth() {
+        return mIntrinsicWidth;
+    }
+
+    @Override
+    public int getIntrinsicHeight() {
+        return mIntrinsicHeight;
+    }
+
+    @Override
+    public void draw(Canvas canvas) {
+        if (getBounds().isEmpty()) return;
+        if (mWord != null) {
+            mWord.setBounds(getBounds());
+            mWord.draw(canvas);
+        }
+        canvas.save();
+        canvas.translate(getBounds().left, getBounds().top);
+        canvas.scale(getBounds().width() / mViewportWidth, getBounds().height() / mViewportHeight);
+        canvas.translate(mOriginX, mOriginY);
+        canvas.scale(mScale, mScale);
+        drawWing(canvas, mBack, mBackPaint, -3.4f * mProgress, 1f + 0.015f * mProgress);
+        drawWing(canvas, mFront, mFrontPaint, 2.8f * mProgress, 1f + 0.012f * mProgress);
+        canvas.restore();
+    }
+
+    private static void drawWing(Canvas canvas, Path wing, Paint paint, float degrees, float scale) {
+        canvas.save();
+        canvas.translate(PIVOT_X, PIVOT_Y);
+        canvas.rotate(degrees);
+        canvas.scale(scale, scale);
+        canvas.translate(-PIVOT_X, -PIVOT_Y);
+        canvas.drawPath(wing, paint);
+        canvas.restore();
+    }
+
+    @Override
+    public void setAlpha(int alpha) {
+        mBackPaint.setAlpha(alpha);
+        mFrontPaint.setAlpha(alpha);
+        if (mWord != null) mWord.setAlpha(alpha);
+        invalidateSelf();
+    }
+
+    @Override
+    public void setColorFilter(@Nullable ColorFilter colorFilter) {
+        mBackPaint.setColorFilter(colorFilter);
+        mFrontPaint.setColorFilter(colorFilter);
+    }
+
+    @Override
+    public int getOpacity() {
+        return PixelFormat.TRANSLUCENT;
+    }
+
+    @Override
+    public boolean setVisible(boolean visible, boolean restart) {
+        boolean changed = super.setVisible(visible, restart);
+        if (visible) {
+            start();
+        } else {
+            stop();
+        }
+        return changed;
+    }
+
+    @Override
+    public void start() {
+        if (mAnimator != null || !ValueAnimator.areAnimatorsEnabled()) return;
+        ValueAnimator animator = ValueAnimator.ofFloat(0f, 1f);
+        animator.setDuration(LOOP_MS);
+        animator.setInterpolator(new LinearInterpolator());
+        animator.setRepeatCount(ValueAnimator.INFINITE);
+        animator.addUpdateListener(
+                a -> {
+                    float t = (float) a.getAnimatedValue();
+                    // Out to the far pose at the middle of the loop and back, each way eased.
+                    float leg = t < 0.5f ? t * 2f : (1f - t) * 2f;
+                    mProgress = EASE_IN_OUT.getInterpolation(leg);
+                    invalidateSelf();
+                });
+        mAnimator = animator;
+        animator.start();
+    }
+
+    @Override
+    public void stop() {
+        ValueAnimator animator = mAnimator;
+        if (animator == null) return;
+        mAnimator = null;
+        animator.cancel();
+        mProgress = 0f;
+        invalidateSelf();
+    }
+
+    @Override
+    public boolean isRunning() {
+        return mAnimator != null;
+    }
+}

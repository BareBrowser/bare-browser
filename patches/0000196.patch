+    // Motion.
+
+    private void animateTo(float target, @Nullable Runnable onEnd) {
+        if (mAnimator != null) mAnimator.cancel();
+        ValueAnimator animator = ValueAnimator.ofFloat(mProgress, target);
+        animator.setDuration(Math.round(DURATION_MS * Math.abs(target - mProgress)));
+        animator.setInterpolator(new PathInterpolator(0.2f, 0.8f, 0.2f, 1f));
+        animator.addUpdateListener(a -> applyProgress((float) a.getAnimatedValue()));
+        animator.addListener(
+                new AnimatorListenerAdapter() {
+                    private boolean mCancelled;
+
+                    @Override
+                    public void onAnimationCancel(Animator animation) {
+                        mCancelled = true;
+                    }
+
+                    @Override
+                    public void onAnimationEnd(Animator animation) {
+                        if (mAnimator == animator) mAnimator = null;
+                        if (!mCancelled) {
+                            applyProgress(target);
+                            if (onEnd != null) onEnd.run();
+                        }
+                    }
+                });
+        mAnimator = animator;
+        animator.start();
+    }
+
+    /** 0 is closed and 1 is open. Drives the scrim, the panel and the shift of the page. */
+    private void applyProgress(float progress) {
+        mProgress = Math.max(0f, Math.min(1f, progress));
+        View scrim = mScrim;
+        Panel panel = mPanel;
+        if (scrim != null) scrim.setAlpha(mProgress);
+        if (panel != null) panel.setTranslationX(-(1f - mProgress) * (mPanelWidth > 0 ? mPanelWidth : panel.getWidth()));
+        View page = mActivity.findViewById(R.id.compositor_view_holder);
+        if (page != null) page.setTranslationX(mProgress * dp(PAGE_SHIFT_DP));
+    }
+
+    private void dragTo(float dx) {
+        if (mAnimator != null) mAnimator.cancel();
+        int width = mPanelWidth > 0 ? mPanelWidth : 1;
+        applyProgress(1f + Math.min(0f, dx) / width);
+    }
+
+    private void finishDrag(float dx, float velocityX) {
+        int width = mPanelWidth > 0 ? mPanelWidth : 1;
+        boolean closeIt = velocityX < -dp(600) || dx < -width * 0.3f;
+        if (closeIt) {
+            close();
+        } else {
+            animateTo(1f, null);
+        }
+    }
+
+    // Tabs.
+
+    private @Nullable TabModel currentModel() {
+        TabModelSelector selector = mSelectorSupplier.get();
+        return selector == null ? null : selector.getCurrentModel();
+    }
+
+    private void refreshSoon() {
+        if (mRefreshPosted || mRoot == null) return;
+        mRefreshPosted = true;
+        mRoot.post(
+                () -> {
+                    mRefreshPosted = false;
+                    if (mOpen) refresh();
+                });
+    }
+
+    private void refresh() {
+        TabAdapter adapter = mAdapter;
+        TextView count = mCount;
+        TextView empty = mEmpty;
+        TabModel model = currentModel();
+        if (adapter == null || count == null || empty == null || model == null) return;
+        List<Tab> tabs = new ArrayList<>();
+        for (int i = 0; i < model.getCount(); i++) {
+            Tab tab = model.getTabAt(i);
+            if (tab != null && !tab.isClosing()) tabs.add(tab);
+        }
+        @Nullable Tab selected = null;
+        int index = model.index();
+        if (index >= 0 && index < model.getCount()) selected = model.getTabAt(index);
+        adapter.submit(tabs, selected == null ? -1 : selected.getId());
+        if (mScrollToSelected) {
+            mScrollToSelected = false;
+            LinearLayoutManager layoutManager = mLayoutManager;
+            if (layoutManager != null && !tabs.isEmpty()) {
+                if (layoutManager.getStackFromEnd()
+                        || (layoutManager instanceof GridLayoutManager
+                                && !AddressBarPreference.isToolbarConfiguredToShowOnTop())) {
+                    // Starts at the bottom, with the newest tab beside the address bar.
+                    layoutManager.scrollToPositionWithOffset(tabs.size() - 1, 0);
+                } else if (selected != null && tabs.indexOf(selected) >= 0) {
+                    layoutManager.scrollToPositionWithOffset(tabs.indexOf(selected), dp(60));
+                }
+            }
+        }
+        int n = tabs.size();
+        count.setText(
+                model.isIncognito()
+                        ? mActivity.getResources()
+                                .getQuantityString(R.plurals.bare_vtabs_private_count, n, n)
+                        : mActivity.getResources()
+                                .getQuantityString(R.plurals.bare_vtabs_count, n, n));
+        empty.setVisibility(n == 0 ? View.VISIBLE : View.GONE);
+    }
+
+    private void selectTab(Tab tab) {
+        TabModel model = currentModel();
+        if (model == null) return;
+        for (int i = 0; i < model.getCount(); i++) {
+            if (model.getTabAt(i) == tab) {
+                model.setIndex(i, TabSelectionType.FROM_USER);
+                break;
+            }
+        }
+        close();
+    }
+
+    private void closeTab(Tab tab) {
+        TabModel model = currentModel();
+        if (model == null || tab.isClosing() || tab.isDestroyed()) return;
+        model.getTabRemover()
+                .closeTabs(TabClosureParams.closeTab(tab).allowUndo(true).build(), /* allowDialog= */ true);
+    }
+
+    private void addTab() {
+        TabModel model = currentModel();
+        TabCreatorManager creators = mCreatorsSupplier.get();
+        if (model == null || creators == null) return;
+        creators.getTabCreator(model.isIncognito()).launchNtp(TabLaunchType.FROM_CHROME_UI);
+        close();
+    }
+
+    private void closeAllTabs() {
+        TabModel model = currentModel();
+        if (model == null || model.getCount() == 0) return;
+        model.getTabRemover()
+                .closeTabs(TabClosureParams.closeAllTabs().build(), /* allowDialog= */ true);
+        close();
+    }
+
+    // Views for the rows.
+
+    private final class TabAdapter extends RecyclerView.Adapter<TabAdapter.Holder> {
+        private List<Tab> mTabs = new ArrayList<>();
+        private int mSelectedId = -1;
+
+        void submit(List<Tab> tabs, int selectedId) {
+            mTabs = tabs;
+            mSelectedId = selectedId;
+            notifyDataSetChanged();
+        }
+
+        @Override
+        public long getItemId(int position) {
+            return mTabs.get(position).getId();
+        }
+
+        @Override
+        public int getItemCount() {
+            return mTabs.size();
+        }
+
+        @Override
+        public int getItemViewType(int position) {
+            return mGrid ? 1 : 0;
+        }
+
+        @Override
+        public Holder onCreateViewHolder(ViewGroup parent, int viewType) {
+            return new Holder(viewType == 1 ? newCard() : newRow());
+        }
+
+        @Override
+        public void onBindViewHolder(Holder holder, int position) {
+            holder.bind(mTabs.get(position), mTabs.get(position).getId() == mSelectedId);
+        }
+
+        final class Holder extends RecyclerView.ViewHolder {
+            private final ViewGroup mRow;
+            private final ImageView mIcon;
+            private final TextView mLetter;
+            private final TextView mTitle;
+            private final TextView mUrl;
+            private final ImageButton mClose;
+            private final @Nullable ImageView mThumb;
+            private final @Nullable View mScrim;
+            private int mBoundTabId = -1;
+
+            Holder(ViewGroup row) {
+                super(row);
+                mRow = row;
+                mIcon = row.findViewWithTag("icon");
+                mLetter = row.findViewWithTag("letter");
+                mTitle = row.findViewWithTag("title");
+                mUrl = row.findViewWithTag("url");
+                mClose = row.findViewWithTag("close");
+                mThumb = row.findViewWithTag("thumb");
+                mScrim = row.findViewWithTag("scrim");
+            }
+
+            void bind(Tab tab, boolean selected) {
+                String url = tab.getUrl().getSpec();
+                boolean ntp = UrlUtilities.isNtpUrl(tab.getUrl());
+                String title = tab.getTitle();
+                if (TextUtils.isEmpty(title)) {
+                    title = ntp ? mActivity.getString(R.string.bare_vtabs_new_tab) : url;
+                }
+                mTitle.setText(title);
+                String host = tab.getUrl().getHost();
+                if (ntp || TextUtils.isEmpty(url)) {
+                    mUrl.setVisibility(View.GONE);
+                } else {
+                    mUrl.setVisibility(View.VISIBLE);
+                    mUrl.setText(TextUtils.isEmpty(host) ? url : host);
+                }
+                @Nullable Bitmap favicon = ntp ? null : TabFavicon.getBitmap(tab);
+                if (favicon != null) {
+                    mIcon.setImageBitmap(favicon);
+                    mIcon.setVisibility(View.VISIBLE);
+                    mLetter.setVisibility(View.GONE);
+                } else {
+                    mIcon.setVisibility(View.GONE);
+                    mLetter.setVisibility(View.VISIBLE);
+                    String basis = ntp ? "+" : (TextUtils.isEmpty(host) ? title : host);
+                    mLetter.setText(basis.isEmpty() ? "?" : basis.substring(0, 1).toUpperCase());
+                }
+                int radius = mGrid ? dp(16) : dp(13);
+                GradientDrawable fill = new GradientDrawable();
+                fill.setCornerRadius(radius);
+                GradientDrawable mask = new GradientDrawable();
+                mask.setCornerRadius(radius);
+                mask.setColor(Color.WHITE);
+                android.content.res.ColorStateList rippleColor =
+                        android.content.res.ColorStateList.valueOf(color(0x33FFFFFF, 0x22000000));
+                if (mGrid && mRow instanceof FrameLayout card) {
+                    // The picture covers the background, so the ring and the ripple are drawn
+                    // over it.
+                    fill.setColor(
+                            selected
+                                    ? color(0xFF303137, 0xFFE3E3E8)
+                                    : color(0xFF26262B, 0xFFE9E9EE));
+                    card.setBackground(fill);
+                    GradientDrawable ring = new GradientDrawable();
+                    ring.setCornerRadius(radius);
+                    ring.setColor(Color.TRANSPARENT);
+                    if (selected) ring.setStroke(dp(2), 0xFF3989FF);

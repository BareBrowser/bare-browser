+
+/**
+ * A picture of the New tab page's wordmark and search box, and where they sit in the window.
+ *
+ * <p>The slide-up shown when a new tab opens draws a copy of the page before the page itself is
+ * there. The page is not there to ask, so it leaves a picture of itself here each time it settles,
+ * and the slide-up draws that. The copy then matches the page exactly: same size, same icon, same
+ * words, same place.
+ */
+@NullMarked
+public final class BareNtpAppearance {
+    /** The two pictures and their top left corners, in window pixels. */
+    public static final class Snapshot {
+        public final Bitmap logo;
+        public final int logoX;
+        public final int logoY;
+        public final Bitmap box;
+        public final int boxX;
+        public final int boxY;
+
+        public Snapshot(Bitmap logo, int logoX, int logoY, Bitmap box, int boxX, int boxY) {
+            this.logo = logo;
+            this.logoX = logoX;
+            this.logoY = logoY;
+            this.box = box;
+            this.boxX = boxX;
+            this.boxY = boxY;
+        }
+    }
+
+    private static @Nullable Snapshot sSnapshot;
+
+    private BareNtpAppearance() {}
+
+    public static void remember(Snapshot snapshot) {
+        sSnapshot = snapshot;
+    }
+
+    /** The last picture a page left, or null if none has settled yet. */
+    public static @Nullable Snapshot get() {
+        return sSnapshot;
+    }
+}

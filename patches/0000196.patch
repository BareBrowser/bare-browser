+    public void close() {
+        if (!mOpen) return;
+        mOpen = false;
+        if (mBackCallback != null) mBackCallback.setEnabled(false);
+        animateTo(
+                0f,
+                () -> {
+                    FrameLayout root = mRoot;
+                    if (root != null && !mOpen) root.setVisibility(View.GONE);
+                    releaseObservers();
+                });

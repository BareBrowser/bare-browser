@@ -2351,8 +2351,23 @@ bool Document::IsPrefetchOnly() const {
   return no_state_prefetch_client && no_state_prefetch_client->IsPrefetchOnly();
 }
 
+// Bare Browser: whether this document should keep telling script it is
+// visible while the page is hidden.
+//
+// Some video sites pause playback themselves when they see the page hide, so
+// the media keeps playing only if the page never finds out. The browser
+// decides which sites this applies to and whether the user asked for it; all
+// this does is honour the resulting setting.
+//
+// Deliberately scoped to what script can see. Document::hidden() is left
+// alone, because Blink itself calls it for canvas font pruning, layout and
+// view transitions, and those should keep treating the page as hidden.
+bool Document::ReportsVisibleForBackgroundMedia() const {
+  return GetSettings() && GetSettings()->GetBackgroundMediaPlaybackEnabled();
+}
+
 V8VisibilityState Document::visibilityState() const {
-  if (hidden()) {
+  if (hidden() && !ReportsVisibleForBackgroundMedia()) {
     return V8VisibilityState(V8VisibilityState::Enum::kHidden);
   } else {
     return V8VisibilityState(V8VisibilityState::Enum::kVisible);
@@ -2387,10 +2402,15 @@ void Document::DidChangeVisibilityState() {
     // tab and update the visibility state.
     return;
   }
-  DispatchEvent(*Event::CreateBubble(event_type_names::kVisibilitychange));
-  // Also send out the deprecated version until it can be removed.
-  DispatchEvent(
-      *Event::CreateBubble(event_type_names::kWebkitvisibilitychange));
+  // Bare Browser: a document that keeps reporting itself visible must not
+  // announce a change that, as far as script is concerned, never happened.
+  // The housekeeping below still runs, since the page really is hidden.
+  if (!ReportsVisibleForBackgroundMedia()) {
+    DispatchEvent(*Event::CreateBubble(event_type_names::kVisibilitychange));
+    // Also send out the deprecated version until it can be removed.
+    DispatchEvent(
+        *Event::CreateBubble(event_type_names::kWebkitvisibilitychange));
+  }
 
   if (IsPageVisible())
     GetDocumentAnimations().MarkAnimationsCompositorPending();

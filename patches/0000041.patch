+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.media.settings;
+
+import android.content.Context;
+import android.os.Bundle;
+
+import org.chromium.base.supplier.MonotonicObservableSupplier;
+import org.chromium.base.supplier.ObservableSuppliers;
+import org.chromium.base.supplier.SettableMonotonicObservableSupplier;
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.chrome.R;
+import org.chromium.chrome.browser.preferences.Pref;
+import org.chromium.chrome.browser.settings.ChromeBaseSettingsFragment;
+import org.chromium.components.browser_ui.settings.ChromeSwitchPreference;
+import org.chromium.components.browser_ui.settings.SettingsUtils;
+import org.chromium.components.prefs.PrefService;
+import org.chromium.components.user_prefs.UserPrefs;
+
+/** Settings for how media behaves, such as whether it keeps playing in the background. */
+@NullMarked
+public class MediaSettingsFragment extends ChromeBaseSettingsFragment {
+
+    public static final String PREF_BACKGROUND_MEDIA_PLAYBACK = "background_media_playback";
+
+    private final SettableMonotonicObservableSupplier<String> mPageTitle =
+            ObservableSuppliers.createMonotonic();
+
+    @Override
+    public void onCreatePreferences(@Nullable Bundle savedInstanceState, @Nullable String rootKey) {
+        mPageTitle.set(getTitle(getContext()));
+        SettingsUtils.addPreferencesFromResource(this, R.xml.media_preferences);
+
+        ChromeSwitchPreference backgroundPlayback =
+                (ChromeSwitchPreference) findPreference(PREF_BACKGROUND_MEDIA_PLAYBACK);
+        assert backgroundPlayback != null;
+
+        PrefService prefs = UserPrefs.get(getProfile());
+        backgroundPlayback.setChecked(prefs.getBoolean(Pref.BACKGROUND_MEDIA_PLAYBACK));
+        backgroundPlayback.setOnPreferenceChangeListener(
+                (preference, newValue) -> {
+                    UserPrefs.get(getProfile())
+                            .setBoolean(Pref.BACKGROUND_MEDIA_PLAYBACK, (boolean) newValue);
+                    return true;
+                });
+    }
+
+    @Override
+    public MonotonicObservableSupplier<String> getPageTitle() {
+        return mPageTitle;
+    }
+
+    public static String getTitle(Context context) {
+        return context.getString(R.string.media_settings);
+    }
+
+    @Override
+    public @AnimationType int getAnimationType() {
+        return AnimationType.PROPERTY;
+    }
+
+    @Override
+    public @Nullable String getMainMenuKey() {
+        return "media";
+    }
+}
diff --git a/chrome/browser/chrome_content_browser_client.cc b/chrome/browser/chrome_content_browser_client.cc
index aa8b16f4672..7bca1fce1cb 100644
--- a/chrome/browser/chrome_content_browser_client.cc
+++ b/chrome/browser/chrome_content_browser_client.cc
@@ -4640,6 +4640,59 @@ content::TtsPlatform* ChromeContentBrowserClient::GetTtsPlatform() {
 #endif
 }
 
+#if BUILDFLAG(IS_ANDROID)
+namespace {
+
+// Bare Browser: sites allowed to keep playing media while the browser is in
+// the background, for users who have turned the setting on.
+//
+// Chromium already keeps background audio going on its own. These sites are
+// listed because they pause themselves once their page sees it was hidden, so
+// they keep playing only if they are never told. Everything is opt in and
+// listed explicitly, so no other site's visibility handling changes.
+//
+// To support another site, add its host and the path its player lives on, or
+// nullptr to match any path.
+struct BackgroundMediaSite {
+  const char* host;
+  const char* path;
+};
+
+constexpr BackgroundMediaSite kBackgroundMediaSites[] = {
+    {"m.youtube.com", "/watch"},
+    {"www.youtube.com", "/watch"},
+    {"youtube.com", "/watch"},
+    {"music.youtube.com", "/watch"},
+};
+
+bool IsBackgroundMediaSite(const GURL& url) {
+  if (!url.SchemeIsHTTPOrHTTPS()) {
+    return false;
+  }
+  for (const auto& site : kBackgroundMediaSites) {
+    if (url.host() != site.host) {
+      continue;
+    }
+    if (!site.path || url.path() == site.path) {
+      return true;
+    }
+  }
+  return false;
+}
+
+bool ShouldReportVisibleForBackgroundMedia(WebContents* web_contents) {
+  Profile* profile =
+      Profile::FromBrowserContext(web_contents->GetBrowserContext());
+  if (!profile ||
+      !profile->GetPrefs()->GetBoolean(prefs::kBackgroundMediaPlayback)) {
+    return false;
+  }
+  return IsBackgroundMediaSite(web_contents->GetLastCommittedURL());
+}
+
+}  // namespace
+#endif  // BUILDFLAG(IS_ANDROID)
+
 void ChromeContentBrowserClient::OverrideWebPreferences(
     WebContents* web_contents,
     content::SiteInstance& main_frame_site,
@@ -4648,6 +4701,11 @@ void ChromeContentBrowserClient::OverrideWebPreferences(
       Profile::FromBrowserContext(web_contents->GetBrowserContext());
   PrefService* prefs = profile->GetPrefs();
 
+#if BUILDFLAG(IS_ANDROID)
+  web_prefs->background_media_playback_enabled =
+      ShouldReportVisibleForBackgroundMedia(web_contents);
+#endif  // BUILDFLAG(IS_ANDROID)
+
 // Fill font preferences. These are not registered on Android unless we're built
 // with extensions (the chrome.fontSettings API can change these).
 // - http://crbug.com/40337093, http://crbug.com/41304476.
@@ -5024,6 +5082,18 @@ bool ChromeContentBrowserClient::OverrideWebPreferencesAfterNavigation(
   prefs_changed |= web_prefs->clipboard_focus_exempt != clipboard_focus_exempt;
   web_prefs->clipboard_focus_exempt = clipboard_focus_exempt;
 
+#if BUILDFLAG(IS_ANDROID)
+  // Whether a site is on the background media list depends on the URL, so this
+  // has to be recomputed once the navigation has committed. Web preferences are
+  // otherwise cached for the lifetime of the WebContents, which would leave a
+  // tab that started somewhere else holding a stale answer.
+  const bool background_media =
+      ShouldReportVisibleForBackgroundMedia(web_contents);
+  prefs_changed |=
+      (web_prefs->background_media_playback_enabled != background_media);
+  web_prefs->background_media_playback_enabled = background_media;
+#endif  // BUILDFLAG(IS_ANDROID)

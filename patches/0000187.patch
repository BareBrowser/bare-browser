diff --git a/chrome/android/java/src/org/chromium/chrome/browser/bare/BareSecurityChoices.java b/chrome/android/java/src/org/chromium/chrome/browser/bare/BareSecurityChoices.java
new file mode 100644
index 00000000000..aca90e5154b
--- /dev/null
+++ b/chrome/android/java/src/org/chromium/chrome/browser/bare/BareSecurityChoices.java
@@ -0,0 +1,76 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.bare;
+
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.chrome.browser.preferences.Pref;
+import org.chromium.chrome.browser.profiles.Profile;
+import org.chromium.components.browser_ui.site_settings.WebsitePreferenceBridge;
+import org.chromium.components.content_settings.ContentSettingsType;
+import org.chromium.components.content_settings.CookieControlsMode;
+import org.chromium.components.content_settings.PrefNames;
+import org.chromium.components.prefs.PrefService;
+import org.chromium.components.user_prefs.UserPrefs;
+
+/**
+ * The security choices Bare offers in one place, so that Settings and the welcome read and write
+ * the same preferences the same way. Each one is a setting Chromium already has; this only gives
+ * it a clear name and a single switch.
+ */
+@NullMarked
+public final class BareSecurityChoices {
+    /** The value the web RTC policy takes when local addresses are hidden from sites. */
+    static final String WEBRTC_PUBLIC_ONLY = "default_public_interface_only";
+
+    static final String WEBRTC_DEFAULT = "default";
+
+    private BareSecurityChoices() {}
+
+    /** Upgrade pages to https and warn before opening a plain http one. */
+    public static boolean isSecureConnections(Profile profile) {
+        return UserPrefs.get(profile).getBoolean(Pref.HTTPS_ONLY_MODE_ENABLED);
+    }
+
+    public static void setSecureConnections(Profile profile, boolean on) {
+        UserPrefs.get(profile).setBoolean(Pref.HTTPS_ONLY_MODE_ENABLED, on);
+    }
+
+    /** Block cookies set by sites other than the one being visited, in every tab. */
+    public static boolean isBlockThirdPartyCookies(Profile profile) {
+        return UserPrefs.get(profile).getInteger(PrefNames.COOKIE_CONTROLS_MODE)
+                == CookieControlsMode.BLOCK_THIRD_PARTY;
+    }
+
+    public static void setBlockThirdPartyCookies(Profile profile, boolean on) {
+        // Off goes back to Chromium's own default, which blocks them in Incognito only.
+        UserPrefs.get(profile)
+                .setInteger(
+                        PrefNames.COOKIE_CONTROLS_MODE,
+                        on ? CookieControlsMode.BLOCK_THIRD_PARTY : CookieControlsMode.INCOGNITO_ONLY);
+    }
+
+    /** Run JavaScript without the optimizing compiler, for every site. */
+    public static boolean isHardenedJavaScript(Profile profile) {
+        return !WebsitePreferenceBridge.isContentSettingEnabled(
+                profile, ContentSettingsType.JAVASCRIPT_OPTIMIZER);
+    }
+
+    public static void setHardenedJavaScript(Profile profile, boolean on) {
+        WebsitePreferenceBridge.setContentSettingEnabled(
+                profile, ContentSettingsType.JAVASCRIPT_OPTIMIZER, !on);
+    }
+
+    /** Keep a page from learning the phone's local network address through WebRTC. */
+    public static boolean isHideLocalAddress(Profile profile) {
+        PrefService prefs = UserPrefs.get(profile);
+        return !WEBRTC_DEFAULT.equals(prefs.getString(Pref.WEB_RTCIP_HANDLING_POLICY));
+    }
+
+    public static void setHideLocalAddress(Profile profile, boolean on) {
+        UserPrefs.get(profile)
+                .setString(
+                        Pref.WEB_RTCIP_HANDLING_POLICY, on ? WEBRTC_PUBLIC_ONLY : WEBRTC_DEFAULT);
+    }
+}

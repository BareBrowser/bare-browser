+// Bare Player's quality cap: limits the download speed of one frame's document
+// in the shown tab, so the site's own adaptive player settles on a lower quality.
+//
+// How: the network service already throttles requests that carry a throttling
+// profile id registered with NetworkContext::SetNetworkConditions(). Blink only
+// ever stamped one when DevTools was attached; here the browser makes up a token,
+// registers a download cap for it, and hands it to the frame, whose document
+// stamps it on its own requests (see BareSetThrottlingToken). No DevTools
+// session is involved. One per tab, and it takes itself off when the tab goes,
+// crashes or leaves that document.
+class BareNetworkCap : public content::WebContentsObserver,
+                       public content::WebContentsUserData<BareNetworkCap> {
+ public:
+  ~BareNetworkCap() override { Clear(); }
+
+  void Set(content::RenderFrameHost* frame, double bytes_per_second) {
+    if (active_ && frame->GetGlobalId() != frame_id_) {
+      Clear();
+    }
+    if (!active_) {
+      token_ = base::UnguessableToken::Create();
+      client_id_ = base::UnguessableToken::Create();
+      frame_id_ = frame->GetGlobalId();
+      frame_node_id_ = frame->GetFrameTreeNodeId();
+      partition_ = frame->GetStoragePartition();
+      active_ = true;
+    }
+    std::vector<network::mojom::MatchedNetworkConditionsPtr> conditions;
+    conditions.push_back(network::mojom::MatchedNetworkConditions::New(
+        /*pattern=*/std::string(),
+        network::mojom::NetworkConditions::New(
+            /*offline=*/false, /*latency=*/base::TimeDelta(),
+            /*download_throughput=*/bytes_per_second,
+            /*upload_throughput=*/0, /*packet_loss=*/0,
+            /*packet_queue_length=*/0, /*packet_reordering=*/false,
+            /*rule_id=*/std::nullopt)));
+    partition_->GetNetworkContext()->SetNetworkConditions(
+        token_, client_id_, std::move(conditions));
+    frame->BareSetThrottlingToken(token_);
+  }
+
+  // Takes the cap off: the frame stops stamping, then the network service
+  // forgets the token (an unknown token means no throttling).
+  void Clear() {
+    if (!active_) {
+      return;
+    }
+    active_ = false;
+    if (content::RenderFrameHost* frame =
+            content::RenderFrameHost::FromID(frame_id_)) {
+      frame->BareSetThrottlingToken(std::nullopt);
+    }
+    partition_->GetNetworkContext()->SetNetworkConditions(token_, client_id_,
+                                                          {});
+    partition_ = nullptr;
+  }
+
+  // WebContentsObserver:
+  void WebContentsDestroyed() override { Clear(); }
+  void RenderFrameDeleted(content::RenderFrameHost* frame) override {
+    if (active_ && frame->GetGlobalId() == frame_id_) {
+      Clear();
+    }
+  }
+  void DidFinishNavigation(content::NavigationHandle* handle) override {
+    if (active_ && handle->HasCommitted() && !handle->IsSameDocument() &&
+        handle->GetFrameTreeNodeId() == frame_node_id_) {
+      Clear();
+    }
+  }
+
+ private:
+  friend class content::WebContentsUserData<BareNetworkCap>;
+  explicit BareNetworkCap(content::WebContents* web_contents)
+      : content::WebContentsObserver(web_contents),
+        content::WebContentsUserData<BareNetworkCap>(*web_contents) {}
+
+  bool active_ = false;
+  base::UnguessableToken token_;
+  base::UnguessableToken client_id_;
+  content::GlobalRenderFrameHostId frame_id_;
+  content::FrameTreeNodeId frame_node_id_;
+  raw_ptr<content::StoragePartition> partition_ = nullptr;
+
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(BareNetworkCap);
+
 }  // namespace
 
+// Limits the page's download speed in one frame's document to
+// |bytes_per_second|, or takes the limit off when that is not above zero.
+static void JNI_BarePlayerBridge_SetNetworkCap(
+    JNIEnv* env,
+    const JavaRef<jobject>& jweb_contents,
+    jint frame_id,
+    jdouble bytes_per_second) {
+  content::WebContents* web_contents =
+      content::WebContents::FromJavaWebContents(jweb_contents);
+  if (!web_contents) {
+    return;
+  }
+  if (bytes_per_second <= 0) {
+    if (BareNetworkCap* cap = BareNetworkCap::FromWebContents(web_contents)) {
+      cap->Clear();
+    }
+    return;
+  }
+  content::RenderFrameHost* frame = FindFrame(jweb_contents, frame_id);
+  if (!frame || !frame->GetPage().IsPrimary()) {
+    return;
+  }
+  BareNetworkCap::CreateForWebContents(web_contents);
+  BareNetworkCap::FromWebContents(web_contents)->Set(frame, bytes_per_second);
+}

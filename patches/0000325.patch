--- /dev/null
+++ b/chrome/android/java/src/org/chromium/chrome/browser/bare/BareImmersive.java
@@ -0,0 +1,104 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.bare;
+
+import android.app.Activity;
+import android.view.View;
+import android.view.Window;
+import android.view.WindowManager.LayoutParams;
+
+import androidx.core.view.WindowCompat;
+import androidx.core.view.WindowInsetsCompat;
+import androidx.core.view.WindowInsetsControllerCompat;
+
+import org.chromium.base.supplier.ObservableSuppliers;
+import org.chromium.base.supplier.SettableNonNullObservableSupplier;
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.chrome.browser.display_cutout.ActivityDisplayCutoutModeSupplier;
+import org.chromium.chrome.browser.fullscreen.FullscreenManager;
+import org.chromium.chrome.browser.tab.Tab;
+import org.chromium.ui.base.WindowAndroid;
+
+import java.util.Collections;
+import java.util.Map;
+import java.util.Set;
+import java.util.WeakHashMap;
+
+/**
+ * Immersive in the three-dot menu: hides the status bar, and the page and the toolbar take its
+ * place. A swipe down from the top edge shows the bar for a moment. Off again when the menu item is
+ * tapped or Bare restarts, so the state lives in this process only.
+ */
+@NullMarked
+public final class BareImmersive {
+    private static boolean sOn;
+    private static final Set<FullscreenManager> sWatched =
+            Collections.newSetFromMap(new WeakHashMap<>());
+    private static final Map<Activity, SettableNonNullObservableSupplier<Integer>> sCutoutModes =
+            new WeakHashMap<>();
+
+    private BareImmersive() {}
+
+    public static boolean isOn() {
+        return sOn;
+    }
+
+    public static void toggle(Activity activity, FullscreenManager fullscreenManager) {
+        sOn = !sOn;
+        apply(activity);
+        // Leaving a fullscreen video shows every system bar again.
+        if (sWatched.add(fullscreenManager)) {
+            fullscreenManager.addObserver(
+                    new FullscreenManager.Observer() {
+                        @Override
+                        public void onExitFullscreen(Tab tab) {
+                            View decor = activity.getWindow().getDecorView();
+                            decor.post(() -> reapply(activity));
+                        }
+                    });
+        }
+    }
+
+    /** Hides the bar again if Android or Chromium brought it back while Immersive is on. */
+    public static void reapply(Activity activity) {
+        if (sOn) apply(activity);
+    }
+
+    private static void apply(Activity activity) {
+        // Installed web apps share this process but keep their own status bar.
+        if (!sCutoutModes.containsKey(activity)) return;
+        Window window = activity.getWindow();
+        WindowInsetsControllerCompat controller =
+                WindowCompat.getInsetsController(window, window.getDecorView());
+        if (sOn) {
+            controller.setSystemBarsBehavior(
+                    WindowInsetsControllerCompat.BEHAVIOR_SHOW_TRANSIENT_BARS_BY_SWIPE);
+            controller.hide(WindowInsetsCompat.Type.statusBars());
+        } else {
+            controller.setSystemBarsBehavior(WindowInsetsControllerCompat.BEHAVIOR_DEFAULT);
+            controller.show(WindowInsetsCompat.Type.statusBars());
+        }
+        SettableNonNullObservableSupplier<Integer> cutoutMode = sCutoutModes.get(activity);
+        if (cutoutMode != null) {
+            cutoutMode.set(
+                    sOn
+                            ? LayoutParams.LAYOUT_IN_DISPLAY_CUTOUT_MODE_ALWAYS
+                            : LayoutParams.LAYOUT_IN_DISPLAY_CUTOUT_MODE_DEFAULT);
+        }
+    }
+
+    /**
+     * Pages that don't ask to draw under the camera keep the window in the default cutout mode,
+     * where Chromium pads the top by the camera cutout: with the status bar hidden that is a band
+     * as tall as the bar. While Immersive is on, the browser asks for the whole screen instead.
+     */
+    public static void attachCutoutMode(Activity activity, WindowAndroid window) {
+        SettableNonNullObservableSupplier<Integer> cutoutMode =
+                ObservableSuppliers.createNonNull(
+                        LayoutParams.LAYOUT_IN_DISPLAY_CUTOUT_MODE_DEFAULT);
+        sCutoutModes.put(activity, cutoutMode);
+        ActivityDisplayCutoutModeSupplier.attach(window.getUnownedUserDataHost(), cutoutMode);
+    }
+}

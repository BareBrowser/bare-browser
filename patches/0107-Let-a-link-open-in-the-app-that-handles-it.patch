+package org.chromium.chrome.browser.bare;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+
+import org.junit.After;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+
+import org.chromium.base.test.BaseRobolectricTestRunner;
+import org.chromium.chrome.browser.preferences.ChromePreferenceKeys;
+import org.chromium.chrome.browser.preferences.ChromeSharedPreferences;
+
+/** Unit tests for how the Open links in apps setting is stored and read back. */
+@RunWith(BaseRobolectricTestRunner.class)
+public class BareOpenInAppsModeUnitTest {
+
+    @After
+    public void tearDown() {
+        ChromeSharedPreferences.getInstance()
+                .removeKey(ChromePreferenceKeys.BARE_OPEN_LINKS_IN_APPS);
+    }
+
+    private static void store(String value) {
+        ChromeSharedPreferences.getInstance()
+                .writeString(ChromePreferenceKeys.BARE_OPEN_LINKS_IN_APPS, value);
+    }
+
+    @Test
+    public void testDefaultIsNever() {
+        assertEquals(BareOpenInAppsMode.Mode.NEVER, BareOpenInAppsMode.get());
+    }
+
+    @Test
+    public void testEachModePersists() {
+        store(BareOpenInAppsMode.VALUE_ALWAYS);
+        assertEquals(BareOpenInAppsMode.Mode.ALWAYS, BareOpenInAppsMode.get());
+
+        store(BareOpenInAppsMode.VALUE_ASK);
+        assertEquals(BareOpenInAppsMode.Mode.ASK, BareOpenInAppsMode.get());
+
+        store(BareOpenInAppsMode.VALUE_NEVER);
+        assertEquals(BareOpenInAppsMode.Mode.NEVER, BareOpenInAppsMode.get());
+    }
+
+    @Test
+    public void testUnrecognisedValueFallsBackToNever() {
+        // A preference written by a later build, or corrupted, must not enable anything.
+        store("open-everything-immediately");
+        assertEquals(BareOpenInAppsMode.Mode.NEVER, BareOpenInAppsMode.get());
+
+        store("");
+        assertEquals(BareOpenInAppsMode.Mode.NEVER, BareOpenInAppsMode.get());
+    }
+
+    @Test
+    public void testValueIsCaseSensitiveAndNotGuessed() {
+        // "Always" is not "always". Anything not matched exactly is Never, which is the safe end.
+        store("ALWAYS");
+        assertEquals(BareOpenInAppsMode.Mode.NEVER, BareOpenInAppsMode.get());
+    }
+
+    @Test
+    public void testRoundTrip() {
+        int[] modes = {
+            BareOpenInAppsMode.Mode.NEVER, BareOpenInAppsMode.Mode.ASK,
+            BareOpenInAppsMode.Mode.ALWAYS,
+        };
+        for (int mode : modes) {
+            assertEquals(mode, BareOpenInAppsMode.fromValue(BareOpenInAppsMode.toValue(mode)));
+        }
+    }
+
+    @Test
+    public void testNeverKeepsEverythingHere() {
+        // The behaviour the browser had before the setting existed, and its default.
+        assertFalse(BareOpenInAppsMode.allowsHandoff(BareOpenInAppsMode.Mode.NEVER));
+        assertFalse(BareOpenInAppsMode.asksFirst(BareOpenInAppsMode.Mode.NEVER));
+    }
+
+    @Test
+    public void testAskAllowsHandoffAndAsksFirst() {
+        assertTrue(BareOpenInAppsMode.allowsHandoff(BareOpenInAppsMode.Mode.ASK));
+        assertTrue(BareOpenInAppsMode.asksFirst(BareOpenInAppsMode.Mode.ASK));
+    }
+
+    @Test
+    public void testAlwaysAllowsHandoffWithoutAsking() {
+        assertTrue(BareOpenInAppsMode.allowsHandoff(BareOpenInAppsMode.Mode.ALWAYS));
+        assertFalse(BareOpenInAppsMode.asksFirst(BareOpenInAppsMode.Mode.ALWAYS));
+    }
+
+    @Test
+    public void testAskIsTheOnlyModeThatPrompts() {
+        int prompting = 0;
+        int[] modes = {
+            BareOpenInAppsMode.Mode.NEVER, BareOpenInAppsMode.Mode.ASK,
+            BareOpenInAppsMode.Mode.ALWAYS,
+        };
+        for (int mode : modes) {
+            if (BareOpenInAppsMode.asksFirst(mode)) prompting++;
+        }
+        assertEquals(1, prompting);
+    }

+    @Test
+    public void testAskingImpliesHandoffIsAllowed() {
+        // A mode that asks but does not allow would put a question to the user that could only
+        // ever be answered one way.
+        int[] modes = {
+            BareOpenInAppsMode.Mode.NEVER, BareOpenInAppsMode.Mode.ASK,
+            BareOpenInAppsMode.Mode.ALWAYS,
+        };
+        for (int mode : modes) {
+            if (BareOpenInAppsMode.asksFirst(mode)) {
+                assertTrue(BareOpenInAppsMode.allowsHandoff(mode));
+            }
+        }
+    }
+
+    @Test
+    public void testUnrecognisedValueNeitherAllowsNorAsks() {
+        store("something-else");
+        int mode = BareOpenInAppsMode.get();
+        assertFalse(BareOpenInAppsMode.allowsHandoff(mode));
+        assertFalse(BareOpenInAppsMode.asksFirst(mode));
+    }
+
+    @Test
+    public void testModeAloneDecidesNothingAboutIncognito() {
+        // The setting is about ordinary browsing. Incognito is settled separately, in the
+        // delegate, where the tab is known: a page opened in incognito is never handed to another
+        // app on its own, whichever mode is stored. Nothing here should ever grow an incognito
+        // argument, because a mode is not enough information to answer that question.
+        for (String value :
+                new String[] {
+                    BareOpenInAppsMode.VALUE_NEVER,
+                    BareOpenInAppsMode.VALUE_ASK,
+                    BareOpenInAppsMode.VALUE_ALWAYS,
+                }) {
+            store(value);
+            int mode = BareOpenInAppsMode.get();
+            assertEquals(mode, BareOpenInAppsMode.fromValue(value));
+            assertEquals(
+                    BareOpenInAppsMode.allowsHandoff(mode),
+                    BareOpenInAppsMode.allowsHandoff(BareOpenInAppsMode.fromValue(value)));
+        }
+    }
+
+    @Test
+    public void testStoredValueStringsAreStable() {
+        // These strings are written into a preference and read back by later builds.
+        assertEquals("never", BareOpenInAppsMode.VALUE_NEVER);
+        assertEquals("ask", BareOpenInAppsMode.VALUE_ASK);
+        assertEquals("always", BareOpenInAppsMode.VALUE_ALWAYS);
+    }
+}

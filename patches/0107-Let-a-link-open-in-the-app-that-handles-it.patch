+        row.setPersistent(false);
+        row.setEntries(labels);
+        row.setEntryValues(values);
+
+        String current = BareOpenInAppsMode.toValue(BareOpenInAppsMode.get());
+        row.setValue(current);
+        row.setSummary(getString(openLinksInAppsLabel(current)));
+
+        row.setOnPreferenceChangeListener(
+                (pref, newValue) -> {
+                    String chosen = BareOpenInAppsMode.toValue(
+                            BareOpenInAppsMode.fromValue((String) newValue));
+                    ChromeSharedPreferences.getInstance()
+                            .writeString(ChromePreferenceKeys.BARE_OPEN_LINKS_IN_APPS, chosen);
+                    pref.setSummary(getString(openLinksInAppsLabel(chosen)));
+                    return true;
+                });

+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.bare;
+
+import androidx.annotation.IntDef;
+
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.chrome.browser.preferences.ChromePreferenceKeys;
+import org.chromium.chrome.browser.preferences.ChromeSharedPreferences;
+
+import java.lang.annotation.Retention;
+import java.lang.annotation.RetentionPolicy;
+
+/**
+ * How a link that an installed app could handle is treated.
+ *
+ * <p>The values are written into a preference and so have to stay stable. They are stored as
+ * strings because the setting is a list preference, which writes the value it was given.
+ */
+@NullMarked
+public final class BareOpenInAppsMode {
+    @IntDef({Mode.NEVER, Mode.ASK, Mode.ALWAYS})
+    @Retention(RetentionPolicy.SOURCE)
+    public @interface Mode {
+        int NEVER = 0;
+        int ASK = 1;
+        int ALWAYS = 2;
+    }
+
+    public static final String VALUE_NEVER = "never";
+    public static final String VALUE_ASK = "ask";
+    public static final String VALUE_ALWAYS = "always";
+
+    /**
+     * The mode the user has chosen.
+     *
+     * <p>Never is the answer for a preference that was never written, so an install that predates
+     * the setting keeps the behaviour it already had. It is also the answer for a value this build
+     * does not recognise, which covers a preference written by a later build and read back by this
+     * one.
+     */
+    public static @Mode int get() {
+        String value =
+                ChromeSharedPreferences.getInstance()
+                        .readString(ChromePreferenceKeys.BARE_OPEN_LINKS_IN_APPS, VALUE_NEVER);
+        return fromValue(value);
+    }
+
+    /** The mode a stored preference string names, or Never if it names nothing this build knows. */
+    public static @Mode int fromValue(String value) {
+        if (VALUE_ALWAYS.equals(value)) return Mode.ALWAYS;
+        if (VALUE_ASK.equals(value)) return Mode.ASK;
+        return Mode.NEVER;
+    }
+
+    /** The preference string for a mode. */
+    public static String toValue(@Mode int mode) {
+        switch (mode) {
+            case Mode.ALWAYS:
+                return VALUE_ALWAYS;
+            case Mode.ASK:
+                return VALUE_ASK;
+            default:
+                return VALUE_NEVER;
+        }
+    }
+
+    /**
+     * Whether a link an app could handle may leave the browser at all.
+     *
+     * <p>False is a decision to keep the page here. True is not a decision to launch anything: it
+     * only stops the suppression, and every check the browser already makes still runs afterwards.
+     */
+    public static boolean allowsHandoff(@Mode int mode) {
+        return mode != Mode.NEVER;
+    }
+
+    /**
+     * Whether the user is asked before a link leaves the browser.
+     *
+     * <p>Only reached for a navigation that was otherwise going to leave, so this turns a launch
+     * into a question rather than adding a way out.
+     */
+    public static boolean asksFirst(@Mode int mode) {
+        return mode == Mode.ASK;
+    }
+
+    private BareOpenInAppsMode() {}
+}

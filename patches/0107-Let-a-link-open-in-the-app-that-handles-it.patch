+        return BareOpenInAppsMode.allowsHandoff(BareOpenInAppsMode.get());
+    }
+
+    @Override
+    public boolean shouldAskBeforeLeavingForApp(GURL url) {
+        if (!OpenInAppUtils.isOpenInAppAvailable() || !UrlUtilities.isHttpOrHttps(url)) return false;
+
+        // Incognito never reaches the question: the navigation was already kept here above, and
+        // asking would offer something that is not on offer.
+        if (mTab.isOffTheRecord()) return false;
+
+        return BareOpenInAppsMode.asksFirst(BareOpenInAppsMode.get());
     }
 

     return false;
   }
 
-  // Force on if DefaultANGLEVulkan feature is enabled from command line.
   base::FeatureList* feature_list = base::FeatureList::GetInstance();
+  // Bare: the desktop Android block in chrome_browser_field_trials.cc turns
+  // this feature on with no field trial attached, so it counts as a command
+  // line override here and used to skip every device check below. Phones with
+  // an old Vulkan driver then got an ANGLE display that cannot create a
+  // context, and the browser stopped after three GPU process failures. On
+  // Android the checks always run.
+#if !BUILDFLAG(IS_ANDROID)
+  // Force on if DefaultANGLEVulkan feature is enabled from command line.
   if (feature_list && feature_list->IsFeatureOverriddenFromCommandLine(
                           features::kDefaultANGLEVulkan.name,
                           base::FeatureList::OVERRIDE_ENABLE_FEATURE)) {
     return true;
   }
+#endif  // !BUILDFLAG(IS_ANDROID)
 

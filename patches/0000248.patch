+    /**
+     * Leaves touches on {@code view} to it while the scrim shows. Bare moves the bottom address bar
+     * up over the scrim with the keyboard, where the scrim would otherwise take the touches meant
+     * for the text and close the bar.
+     */
+    public void setTouchPassThroughView(View view) {
+        int[] at = new int[2];
+        mScrimModel.set(
+                ScrimProperties.PASS_THROUGH_TOUCH,
+                event -> {
+                    if (!view.isShown()) return false;
+                    view.getLocationOnScreen(at);
+                    float x = event.getRawX();
+                    float y = event.getRawY();
+                    return x >= at[0]
+                            && x < at[0] + view.getWidth()
+                            && y >= at[1]
+                            && y < at[1] + view.getHeight();
+                });
+    }

+            // take.
             return false;
         } else if (key.equals(PREF_NOTIFICATIONS)) {
             Intent intent = new Intent();
@@ -919,16 +924,6 @@ public class MainSettings extends ChromeBaseSettingsFragment
         return false;
     }
 
-    private static void showPasswordSettings(

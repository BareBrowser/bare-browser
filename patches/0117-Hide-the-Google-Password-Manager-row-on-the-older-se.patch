+        //
+        // The row is hidden rather than removed from main_preferences.xml: findPreference
+        // and setManagedPreferenceDelegateForPreference both look it up by key and would
+        // return null if it were gone. No click listener is attached, so the entry point
+        // is gone as well as the row.
         PasswordsPreference passwordsPreference = findPreference(PREF_PASSWORDS);
         passwordsPreference.setProfile(getProfile());
-        passwordsPreference.setOnPreferenceClickListener(

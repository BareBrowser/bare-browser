+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.translate;
+
+import org.chromium.base.UserData;
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.chrome.browser.tab.EmptyTabObserver;
+import org.chromium.chrome.browser.tab.Tab;
+import org.chromium.content_public.browser.NavigationHandle;
+
+/**
+ * Keeps translation on for a tab once the user has translated a page in it. Each page the tab
+ * then loads is translated the same way, until the tab is closed.
+ */
+@NullMarked
+class TranslateSession extends EmptyTabObserver implements UserData {
+    private static final Class<TranslateSession> USER_DATA_KEY = TranslateSession.class;
+
+    private final Tab mTab;
+
+    private TranslateSession(Tab tab) {
+        mTab = tab;
+        tab.addObserver(this);
+    }
+
+    /** Starts keeping translation on for the tab. Does nothing if it already is. */
+    static void keepOn(Tab tab) {
+        if (tab.getUserDataHost().getUserData(USER_DATA_KEY) != null) return;
+        tab.getUserDataHost().setUserData(USER_DATA_KEY, new TranslateSession(tab));
+    }
+
+    @Override
+    public void onDidFinishNavigationInPrimaryMainFrame(Tab tab, NavigationHandle navigation) {
+        if (!navigation.hasCommitted()
+                || navigation.isSameDocument()
+                || navigation.isErrorPage()
+                || !isHttpOrHttps(navigation.getUrl().getScheme())
+                || tab.getWebContents() == null) {
+            return;
+        }
+        TranslateBridge.translateNow(tab);
+    }
+
+    private static boolean isHttpOrHttps(String scheme) {
+        return "http".equals(scheme) || "https".equals(scheme);
+    }
+
+    @Override
+    public void destroy() {
+        mTab.removeObserver(this);
+    }
+}

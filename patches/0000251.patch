@@ -0,0 +1,53 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.bare;
+
+import android.view.View;
+
+import org.chromium.build.annotations.NullMarked;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * Work that waits for the slide-up of a new tab to finish. The address bar of a new tab takes focus
+ * and the keyboard lifts it, so that is held until the page has risen and the bar has stood still
+ * for the whole of it.
+ */
+@NullMarked
+public final class BareNewTabRise {
+    private static int sRunning;
+    private static final List<Runnable> sWaiting = new ArrayList<>();
+
+    private BareNewTabRise() {}
+
+    /** A slide-up has started. */
+    public static void begin() {
+        sRunning++;
+    }
+
+    /** A slide-up is over. What waited for it runs on the next message of {@code view}. */
+    public static void end(View view) {
+        if (sRunning > 0) sRunning--;
+        if (sRunning == 0 && !sWaiting.isEmpty()) view.post(BareNewTabRise::runWaiting);
+    }
+
+    /** Runs {@code runnable} now, or once the slide-up running now has finished. */
+    public static void afterRise(Runnable runnable) {
+        if (sRunning == 0) {
+            runnable.run();
+            return;
+        }
+        sWaiting.add(runnable);
+    }
+
+    private static void runWaiting() {
+        // Another new tab may have started its own slide-up in the meantime.
+        if (sRunning > 0) return;
+        List<Runnable> waiting = new ArrayList<>(sWaiting);
+        sWaiting.clear();
+        for (Runnable runnable : waiting) runnable.run();
+    }
+}

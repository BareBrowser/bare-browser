diff --git a/chrome/browser/ui/android/bare_media_registry.cc b/chrome/browser/ui/android/bare_media_registry.cc
new file mode 100644
index 00000000000..93b22d8be34
--- /dev/null
+++ b/chrome/browser/ui/android/bare_media_registry.cc
@@ -0,0 +1,196 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/android/bare_media_registry.h"
+
+#include <algorithm>
+
+#include "base/android/jni_android.h"
+#include "base/android/jni_string.h"
+#include "base/android/scoped_java_ref.h"
+#include "base/strings/string_util.h"
+#include "content/public/browser/page.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/web_contents.h"
+#include "net/base/net_errors.h"
+#include "services/network/public/mojom/fetch_api.mojom-shared.h"
+#include "third_party/blink/public/mojom/loader/resource_load_info.mojom.h"
+
+// Must come after all headers that specialize FromJniType() / ToJniType().
+#include "chrome/android/chrome_jni_headers/BareMediaRegistryBridge_jni.h"
+
+namespace bare {
+
+namespace {
+
+// A tab left on a video heavy page must not accumulate an unbounded history.
+// Oldest entries are dropped once this many are held.
+constexpr size_t kMaxCandidates = 64;
+
+// Floors that keep ordinary page furniture out of the list. Sprites, icons,
+// tracking pixels and interface sounds all sit comfortably below these;
+// anything a person would actually mean to keep sits comfortably above.
+constexpr base::ByteSize kMinImageSize = base::KiB(40);
+constexpr base::ByteSize kMinAudioVideoSize = base::KiB(96);
+
+bool IsMediaMimeType(std::string_view mime) {
+  return base::StartsWith(mime, "video/",
+                          base::CompareCase::INSENSITIVE_ASCII) ||
+         base::StartsWith(mime, "audio/",
+                          base::CompareCase::INSENSITIVE_ASCII);
+}
+
+bool IsImageMimeType(std::string_view mime) {
+  // SVG is left out on purpose: it is almost always page furniture rather than
+  // something anyone means to save.
+  return base::StartsWith(mime, "image/",
+                          base::CompareCase::INSENSITIVE_ASCII) &&
+         !base::EqualsCaseInsensitiveASCII(mime, "image/svg+xml");
+}
+
+}  // namespace
+
+BareMediaRegistry::BareMediaRegistry(content::WebContents* web_contents)
+    : content::WebContentsObserver(web_contents),
+      content::WebContentsUserData<BareMediaRegistry>(*web_contents) {}
+
+BareMediaRegistry::~BareMediaRegistry() = default;
+
+// static
+GURL BareMediaRegistry::NormalizeForDownload(const GURL& url) {
+  GURL::Replacements strip_ref;
+  strip_ref.ClearRef();
+  return url.ReplaceComponents(strip_ref);
+}
+
+void BareMediaRegistry::ResourceLoadComplete(
+    content::RenderFrameHost* render_frame_host,
+    const content::GlobalRequestID& request_id,
+    const GURL& original_url,
+    const blink::mojom::ResourceLoadInfo& resource_load_info) {
+  // Prerendered and back forward cached pages load media the person never
+  // asked to see. Only what the visible page fetched is offered.
+  if (!render_frame_host || !render_frame_host->GetPage().IsPrimary()) {
+    return;
+  }
+  if (resource_load_info.net_error != net::OK) {
+    return;
+  }
+
+  const GURL& url = resource_load_info.final_url;
+
+  // Anything that cannot be fetched again on its own terms is not a download.
+  // blob: and data: in particular have nothing behind them to re-request.
+  if (!url.SchemeIsHTTPOrHTTPS()) {
+    return;
+  }
+  if (resource_load_info.method != "GET") {
+    return;
+  }
+
+  const auto destination = resource_load_info.request_destination;
+
+  // Scripts, styles, fonts and documents are never offered, whatever content
+  // type they happen to carry.
+  switch (destination) {
+    case network::mojom::RequestDestination::kScript:
+    case network::mojom::RequestDestination::kStyle:
+    case network::mojom::RequestDestination::kFont:
+    case network::mojom::RequestDestination::kDocument:
+    case network::mojom::RequestDestination::kIframe:
+    case network::mojom::RequestDestination::kFrame:
+    case network::mojom::RequestDestination::kFencedframe:
+    case network::mojom::RequestDestination::kManifest:
+    case network::mojom::RequestDestination::kWorker:
+    case network::mojom::RequestDestination::kSharedWorker:
+    case network::mojom::RequestDestination::kServiceWorker:
+    case network::mojom::RequestDestination::kReport:
+    case network::mojom::RequestDestination::kXslt:
+      return;
+    default:
+      break;
+  }
+
+  // Two ways in. The destination is the reliable signal for a <video>, <audio>
+  // or <img> element. Media assembled by script through Media Source arrives
+  // with an empty destination, because to the loader it is an ordinary fetch,
+  // so there the content type is the only thing that identifies it. That
+  // second case is the one this class exists for.
+  const std::string& mime = resource_load_info.mime_type;
+  const bool looks_like_media =
+      destination == network::mojom::RequestDestination::kVideo ||
+      destination == network::mojom::RequestDestination::kAudio ||
+      IsMediaMimeType(mime);
+  const bool looks_like_image =
+      destination == network::mojom::RequestDestination::kImage ||
+      IsImageMimeType(mime);
+
+  const base::ByteSize size = resource_load_info.total_received_bytes;
+  if (looks_like_media) {
+    if (size < kMinAudioVideoSize) {
+      return;
+    }
+  } else if (looks_like_image) {
+    if (size < kMinImageSize) {
+      return;
+    }
+  } else {
+    return;
+  }
+
+  Remember(url, mime, size);
+}
+
+void BareMediaRegistry::Remember(const GURL& url,
+                                 const std::string& mime_type,
+                                 base::ByteSize size) {
+  const GURL normalized = NormalizeForDownload(url);
+
+  // A file delivered in range requests completes once per range, so the same
+  // resource turns up again and again. Keep the largest sighting, which is the
+  // closest thing available to the real size.
+  auto existing = std::ranges::find_if(
+      candidates_,
+      [&normalized](const Candidate& c) { return c.url == normalized; });
+  if (existing != candidates_.end()) {
+    existing->size = std::max(existing->size, size);
+    return;
+  }
+
+  candidates_.push_back({normalized, mime_type, size});
+  while (candidates_.size() > kMaxCandidates) {
+    candidates_.pop_front();
+  }
+}
+
+void BareMediaRegistry::PrimaryPageChanged(content::Page& page) {
+  // What the previous page fetched is not offered for this one.
+  candidates_.clear();
+}
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(BareMediaRegistry);
+
+}  // namespace bare
+
+static void JNI_BareMediaRegistryBridge_GetCandidates(
+    JNIEnv* env,
+    const base::android::JavaRef<jobject>& jweb_contents,
+    const base::android::JavaRef<jobject>& jout) {
+  content::WebContents* web_contents =
+      content::WebContents::FromJavaWebContents(jweb_contents);
+  if (!web_contents) {
+    return;
+  }
+  auto* registry = bare::BareMediaRegistry::FromWebContents(web_contents);
+  if (!registry) {
+    return;
+  }
+  for (const auto& candidate : registry->candidates()) {
+    Java_BareMediaRegistryBridge_addCandidate(
+        env, jout, candidate.url.spec(), candidate.mime_type,
+        static_cast<int64_t>(candidate.size.InBytes()));
+  }
+}
+
+DEFINE_JNI(BareMediaRegistryBridge)

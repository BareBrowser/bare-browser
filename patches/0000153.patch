+        /** Grows the Start circle until it covers the screen, then drops the overlay. */
+        private void finish(Button circle) {
+            mRoot.getViewTreeObserver().removeOnGlobalLayoutListener(mHideBehind);
+            for (int i = 0; i < mHiddenBehind.size(); i++) {
+                mHiddenBehind.get(i).setImportantForAccessibility(mHiddenBehindWas.get(i));
+            }
+            if (mBackCallback != null) mBackCallback.remove();
+            mOverlay.getViewTreeObserver().removeOnWindowFocusChangeListener(mFocusListener);
+            if (!mAnimate) {
+                mRoot.removeView(mOverlay);
+                return;
+            }
+            float centreX = circle.getWidth() / 2f;
+            float centreY = circle.getHeight() / 2f;
+            int[] at = new int[2];
+            int[] overlayAt = new int[2];
+            circle.getLocationInWindow(at);
+            mOverlay.getLocationInWindow(overlayAt);
+            float x = at[0] - overlayAt[0] + centreX;
+            float y = at[1] - overlayAt[1] + centreY;
+            // Reach whichever corner is furthest away, so the circle covers the screen completely.
+            float toFurthestCorner =
+                    (float)
+                            Math.hypot(
+                                    Math.max(x, mOverlay.getWidth() - x),
+                                    Math.max(y, mOverlay.getHeight() - y));
+            float scale = (2f * toFurthestCorner) / circle.getWidth();
+            // The circle grows over everything else on the welcome, so nothing may clip it and
+            // nothing drawn after it may stay on top.
+            mOverlay.findViewById(R.id.bare_welcome_footer).setVisibility(View.INVISIBLE);
+            mProgress.setVisibility(View.INVISIBLE);
+            ViewParent parent = circle.getParent();
+            while (parent instanceof ViewGroup group) {
+                group.setClipChildren(false);
+                group.setClipToPadding(false);
+                if (group == mOverlay) break;
+                parent = group.getParent();
+            }
+            circle.setText("");
+
+            ObjectAnimator growX = ObjectAnimator.ofFloat(circle, View.SCALE_X, 1f, scale);
+            ObjectAnimator growY = ObjectAnimator.ofFloat(circle, View.SCALE_Y, 1f, scale);
+            ObjectAnimator vanish = ObjectAnimator.ofFloat(mOverlay, View.ALPHA, 1f, 0f);
+            vanish.setStartDelay(WIPE_MS - 120);
+            vanish.setDuration(120);
+
+            AnimatorSet wipe = new AnimatorSet();
+            wipe.playTogether(growX, growY, vanish);
+            wipe.setDuration(WIPE_MS);
+            wipe.setInterpolator(new AccelerateInterpolator(1.4f));
+            wipe.addListener(
+                    new AnimatorListenerAdapter() {
+                        @Override
+                        public void onAnimationEnd(Animator animation) {
+                            mRoot.removeView(mOverlay);
+                        }
+                    });
+            wipe.start();
+        }

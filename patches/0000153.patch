+            android:id="@+id/bare_finish_lead"
+            android:layout_width="match_parent"
+            android:layout_height="wrap_content"
+            android:orientation="vertical"
+            android:gravity="center">
+            <!-- Read as one line by a screen reader; the heart is spelt out there. -->
+            <LinearLayout
+                android:id="@+id/bare_page_title"
+                android:layout_width="wrap_content"
+                android:layout_height="wrap_content"
+                android:orientation="vertical"
+                android:gravity="center_horizontal"
+                android:accessibilityHeading="true"
+                android:focusable="true"
+                android:contentDescription="@string/bare_welcome_made_with_spoken">
+
+                <TextView
+                    android:layout_width="wrap_content"
+                    android:layout_height="wrap_content"
+                    android:importantForAccessibility="no"
+                    android:text="@string/bare_welcome_made_with"
+                    android:textColor="@color/bare_welcome_title"
+                    android:textSize="26sp"
+                    android:fontFamily="sans-serif-medium" />
+
+                <TextView
+                    android:layout_width="wrap_content"
+                    android:layout_height="wrap_content"
+                    android:layout_marginTop="2dp"
+                    android:importantForAccessibility="no"
+                    android:text="@string/bare_welcome_heart"
+                    android:textSize="26sp" />
+
+                <TextView
+                    android:layout_width="wrap_content"
+                    android:layout_height="wrap_content"
+                    android:layout_marginTop="2dp"
+                    android:importantForAccessibility="no"
+                    android:text="@string/bare_welcome_in_san_francisco"
+                    android:textColor="@color/bare_welcome_title"
+                    android:textSize="26sp"
+                    android:fontFamily="sans-serif-medium" />
+            </LinearLayout>
+            <!-- The bridge, with clouds and water glints as their own layers so they
+                 can drift. Every layer shares one viewport and so lines up. -->
+            <FrameLayout
+                android:id="@+id/bare_bridge"
+                android:layout_width="match_parent"
+                android:layout_height="wrap_content"
+                android:layout_marginTop="20dp"
+                android:importantForAccessibility="noHideDescendants">
+
+                <ImageView
+                    android:id="@+id/bare_bridge_base"
+                    android:layout_width="match_parent"
+                    android:layout_height="wrap_content"
+                    android:adjustViewBounds="true"
+                    android:src="@drawable/bare_welcome_bridge" />
+
+                <ImageView
+                    android:id="@+id/bare_bridge_cloud_a"
+                    android:layout_width="match_parent"
+                    android:layout_height="wrap_content"
+                    android:adjustViewBounds="true"
+                    android:src="@drawable/bare_welcome_bridge_cloud_a" />
+
+                <ImageView
+                    android:id="@+id/bare_bridge_cloud_b"
+                    android:layout_width="match_parent"
+                    android:layout_height="wrap_content"
+                    android:adjustViewBounds="true"
+                    android:src="@drawable/bare_welcome_bridge_cloud_b" />
+
+                <ImageView
+                    android:id="@+id/bare_bridge_waves_a"
+                    android:layout_width="match_parent"
+                    android:layout_height="wrap_content"
+                    android:adjustViewBounds="true"
+                    android:alpha="0.45"
+                    android:src="@drawable/bare_welcome_bridge_waves_a" />
+
+                <ImageView
+                    android:id="@+id/bare_bridge_waves_b"
+                    android:layout_width="match_parent"
+                    android:layout_height="wrap_content"
+                    android:adjustViewBounds="true"
+                    android:alpha="0.45"
+                    android:src="@drawable/bare_welcome_bridge_waves_b" />
+            </FrameLayout>
+        </LinearLayout>
+
+        <LinearLayout
+            android:id="@+id/bare_finish_action"
+            android:layout_width="match_parent"
+            android:layout_height="wrap_content"
+            android:layout_marginTop="-12dp"
+            android:orientation="vertical"
+            android:gravity="center">
+            <Button
+                android:id="@+id/bare_welcome_circle"

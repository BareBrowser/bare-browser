+        private static ValueAnimator drift(View view, float from, float to, long ms, long phase) {
+            ObjectAnimator animator = ObjectAnimator.ofFloat(view, View.TRANSLATION_X, from, to);
+            animator.setDuration(ms);
+            animator.setRepeatCount(ValueAnimator.INFINITE);
+            animator.setRepeatMode(ValueAnimator.REVERSE);
+            animator.setInterpolator(new PathInterpolator(0.42f, 0f, 0.58f, 1f));
+            animator.setCurrentPlayTime(phase);
+            return animator;
+        }
+
+        private static ValueAnimator glint(View view, long phase) {
+            ObjectAnimator fade = ObjectAnimator.ofFloat(view, View.ALPHA, 0.25f, 0.6f);
+            fade.setDuration(WAVE_MS);
+            fade.setRepeatCount(ValueAnimator.INFINITE);
+            fade.setRepeatMode(ValueAnimator.REVERSE);
+            fade.setCurrentPlayTime(phase);
+            return fade;
+        }

+        /** Lets the clouds drift and the water glint while the finish page is up. */
+        private void startBridge() {
+            if (!mAnimate || !mBridgeAnimators.isEmpty()) return;
+            View page = mPages[PAGE_FINISH];
+            View base = page.findViewById(R.id.bare_bridge_base);
+            float unit = base.getWidth() / BRIDGE_VIEWPORT_WIDTH;
+            if (unit <= 0) return;
+
+            mBridgeAnimators.add(
+                    drift(page.findViewById(R.id.bare_bridge_cloud_a), -5 * unit, 11 * unit, CLOUD_MS, 0));
+            mBridgeAnimators.add(
+                    drift(page.findViewById(R.id.bare_bridge_cloud_b), -5 * unit, 11 * unit, CLOUD_MS, 3000));
+            View wavesA = page.findViewById(R.id.bare_bridge_waves_a);
+            View wavesB = page.findViewById(R.id.bare_bridge_waves_b);
+            mBridgeAnimators.add(drift(wavesA, -5 * unit, 8 * unit, WAVE_MS, 0));
+            mBridgeAnimators.add(glint(wavesA, 0));
+            mBridgeAnimators.add(drift(wavesB, -5 * unit, 8 * unit, WAVE_MS, 1500));
+            mBridgeAnimators.add(glint(wavesB, 1500));
+            for (Animator animator : mBridgeAnimators) animator.start();
+        }
+
+        private void stopBridge() {
+            for (Animator animator : mBridgeAnimators) animator.cancel();
+            mBridgeAnimators.clear();
+        }

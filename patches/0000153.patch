+                android:background="@drawable/bare_start_circle"
+                android:elevation="6dp"
+                android:stateListAnimator="@null"
+                android:text="@string/bare_welcome_start"
+                android:textAllCaps="false"
+                android:textColor="@color/bare_welcome_on_accent"
+                android:textSize="18sp"
+                android:fontFamily="sans-serif-medium" />
+
+            <Button
+                android:id="@+id/bare_welcome_restart"
+                android:layout_width="wrap_content"
+                android:layout_height="wrap_content"
+                android:layout_marginTop="10dp"
+                android:minHeight="48dp"
+                android:paddingStart="16dp"
+                android:paddingEnd="16dp"
+                android:background="?attr/selectableItemBackground"
+                android:stateListAnimator="@null"
+                android:text="@string/bare_welcome_restart"
+                android:textAllCaps="false"
+                android:textColor="@color/bare_welcome_accent"
+                android:textSize="14sp"
+                android:fontFamily="sans-serif-medium" />
+
+            <TextView
+                android:layout_width="wrap_content"
+                android:layout_height="wrap_content"

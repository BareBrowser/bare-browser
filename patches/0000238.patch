+    /**
+     * Applies the embedder's open-in-apps rule to a launch the user has not confirmed.
+     *
+     * <p>Every launch made while a navigation is being decided passes through startActivity(), so
+     * this is where the rule holds for every kind of link: web pages, intent: URLs, schemes apps
+     * register, the Play Store for an app that is not installed, and store links the web check
+     * lets through. Links to a phone number, an email address or a text message, and intents back
+     * into this app, are not app links and go ahead.
+     *
+     * @return null to launch, or the result to return instead.
+     */
+    private @Nullable OverrideUrlLoadingResult holdUnconfirmedLaunch(
+            Intent intent,
+            ExternalNavigationParams params,
+            boolean requiresIntentChooser,
+            @Nullable QueryIntentActivitiesSupplier resolvingInfos,
+            @Nullable ResolveActivitySupplier resolveActivity,
+            @Nullable GURL browserFallbackUrl,
+            @Nullable GURL intentTargetUrl) {
+        if (!mDecidingNavigation || isLaunchOfSelf(intent) || isMessagingIntent(intent)) {
+            return null;
+        }
+        GURL fallbackUrl = browserFallbackUrl != null ? browserFallbackUrl : GURL.emptyGURL();
+        GURL targetUrl =
+                intentTargetUrl != null ? intentTargetUrl : new GURL(intent.getDataString());
+
+        if (!mDelegate.allowLinkToOpenApp()) {

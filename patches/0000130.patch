new file mode 100644
index 00000000000..07ef09b1813
--- /dev/null
+++ b/chrome/browser/extensions/bare_bundled_extension_recovery.cc
@@ -0,0 +1,147 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/extensions/bare_bundled_extension_recovery.h"
+
+#include <map>
+#include <memory>
+#include <set>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/logging.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/scoped_observation.h"
+#include "base/task/single_thread_task_runner.h"
+#include "chrome/browser/extensions/bare_bundled_extensions_loader.h"
+#include "chrome/browser/profiles/profile.h"
+#include "components/bare_bundled_extensions/recovery_policy.h"
+#include "extensions/browser/extension_prefs.h"
+#include "extensions/browser/extension_registrar.h"
+#include "extensions/browser/extension_registry.h"
+#include "extensions/browser/extension_registry_observer.h"
+#include "extensions/browser/unloaded_extension_reason.h"
+#include "extensions/browser/warning_service.h"
+#include "extensions/browser/warning_set.h"
+#include "extensions/common/extension.h"
+#include "extensions/common/mojom/manifest.mojom-shared.h"
+
+namespace extensions {
+
+namespace {
+
+// Lives as long as the profile's extension registry, then deletes itself.
+class BundledExtensionRecovery : public ExtensionRegistryObserver {
+ public:
+  BundledExtensionRecovery(Profile* profile,
+                           scoped_refptr<BareBundledExtensionsLoader> loader)
+      : profile_(profile), loader_(std::move(loader)) {
+    observation_.Observe(ExtensionRegistry::Get(profile_));
+  }
+
+  BundledExtensionRecovery(const BundledExtensionRecovery&) = delete;
+  BundledExtensionRecovery& operator=(const BundledExtensionRecovery&) = delete;
+
+  ~BundledExtensionRecovery() override = default;
+
+ private:
+  // ExtensionRegistryObserver:
+  void OnExtensionLoaded(content::BrowserContext* browser_context,
+                         const Extension* extension) override {
+    if (IsClaimed(*extension)) {
+      BackoffFor(extension->id()).OnLoaded();
+    }
+  }
+
+  void OnExtensionUnloaded(content::BrowserContext* browser_context,
+                           const Extension* extension,
+                           UnloadedExtensionReason reason) override {
+    // A disable, an update, a removal and a browser shutdown all arrive with
+    // other reasons, or not at all.
+    if (reason != UnloadedExtensionReason::TERMINATE ||
+        !IsClaimed(*extension)) {
+      return;
+    }
+    Schedule(extension->id());
+  }
+
+  void OnShutdown(ExtensionRegistry* registry) override {
+    observation_.Reset();
+    weak_factory_.InvalidateWeakPtrs();
+    base::SingleThreadTaskRunner::GetCurrentDefault()->DeleteSoon(FROM_HERE,
+                                                                 this);
+  }
+
+  bool IsClaimed(const Extension& extension) const {
+    return extension.location() == mojom::ManifestLocation::kExternalPref &&
+           loader_->ClaimsExtension(extension.id());
+  }
+
+  bare_bundled_extensions::RecoveryBackoff& BackoffFor(const ExtensionId& id) {
+    std::unique_ptr<bare_bundled_extensions::RecoveryBackoff>& backoff =
+        backoff_[id];
+    if (!backoff) {
+      backoff = std::make_unique<bare_bundled_extensions::RecoveryBackoff>();
+    }
+    return *backoff;
+  }
+
+  void Schedule(const ExtensionId& id) {
+    if (pending_.contains(id)) {
+      return;
+    }
+    bare_bundled_extensions::RecoveryBackoff& backoff = BackoffFor(id);
+    const base::TimeDelta delay = backoff.OnTerminated();
+    LOG(WARNING) << "Bare: " << id << " was terminated; loading it again in "
+                 << delay << " (attempt " << backoff.failure_count() << ")";
+    pending_.insert(id);
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+        FROM_HERE,
+        base::BindOnce(&BundledExtensionRecovery::Fire,
+                       weak_factory_.GetWeakPtr(), id),
+        delay);
+  }
+
+  void Fire(const ExtensionId& id) {
+    pending_.erase(id);
+    ExtensionRegistry* registry = ExtensionRegistry::Get(profile_);
+    ExtensionPrefs* prefs = ExtensionPrefs::Get(profile_);
+    const Extension* terminated = registry->terminated_extensions().GetByID(id);
+
+    bare_bundled_extensions::RecoveryFacts facts;
+    facts.still_terminated = terminated != nullptr;
+    facts.claimed_by_bare = terminated && IsClaimed(*terminated);
+    facts.removed_by_user = prefs->IsExternalExtensionUninstalled(id);
+    facts.has_disable_reasons = !prefs->GetDisableReasons(id).empty();
+    facts.reload_too_frequent =
+        WarningService::Get(profile_)
+            ->GetWarningTypesAffectingExtension(id)
+            .contains(Warning::kReloadTooFrequent);
+    if (!bare_bundled_extensions::ShouldRecover(facts)) {
+      return;
+    }
+    ExtensionRegistrar::Get(profile_)->ReloadExtensionWithQuietFailure(id);
+  }
+
+  raw_ptr<Profile> profile_;
+  scoped_refptr<BareBundledExtensionsLoader> loader_;
+  std::map<ExtensionId,
+           std::unique_ptr<bare_bundled_extensions::RecoveryBackoff>>
+      backoff_;
+  std::set<ExtensionId> pending_;
+  base::ScopedObservation<ExtensionRegistry, ExtensionRegistryObserver>
+      observation_{this};
+  base::WeakPtrFactory<BundledExtensionRecovery> weak_factory_{this};
+};
+
+}  // namespace
+
+void StartBundledExtensionRecovery(
+    Profile* profile,
+    scoped_refptr<BareBundledExtensionsLoader> loader) {
+  new BundledExtensionRecovery(profile, std::move(loader));  // Owns itself.
+}
+
+}  // namespace extensions
diff --git a/chrome/browser/extensions/bare_bundled_extension_recovery.h b/chrome/browser/extensions/bare_bundled_extension_recovery.h
new file mode 100644
index 00000000000..fafffd0bdcd
--- /dev/null
+++ b/chrome/browser/extensions/bare_bundled_extension_recovery.h
@@ -0,0 +1,37 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_EXTENSIONS_BARE_BUNDLED_EXTENSION_RECOVERY_H_
+#define CHROME_BROWSER_EXTENSIONS_BARE_BUNDLED_EXTENSION_RECOVERY_H_
+
+#include "base/memory/scoped_refptr.h"
+
+class Profile;
+
+namespace extensions {
+
+class BareBundledExtensionsLoader;
+
+// Loads an extension Bare provisioned again after Android has killed the
+// process its background page ran in.
+//
+// Chromium marks such an extension terminated, which is neither disabled nor
+// removed and leaves no trace in its preferences. Filtering stops, and nothing
+// on Android brings it back short of a browser restart: upstream's own recovery
+// needs a frame belonging to the extension, which cannot be created while it is
+// unloaded, and the service that restarts force-installed extensions on desktop
+// is compiled out here. Android reports a crash and an out-of-memory kill the
+// same way, so the guard against reloading a genuinely broken extension forever
+// is the backoff, not the cause.
+//
+// Only extensions `loader` still claims are touched. A disable, a removal, or
+// Chromium's own refusal to reload an extension that restarts itself too often
+// is never overridden. Safe to call once per profile at startup.
+void StartBundledExtensionRecovery(
+    Profile* profile,
+    scoped_refptr<BareBundledExtensionsLoader> loader);
+
+}  // namespace extensions
+
+#endif  // CHROME_BROWSER_EXTENSIONS_BARE_BUNDLED_EXTENSION_RECOVERY_H_

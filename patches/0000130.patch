diff --git a/components/bare_bundled_extensions/recovery_policy.cc b/components/bare_bundled_extensions/recovery_policy.cc
new file mode 100644
index 00000000000..32e40bd8b9a
--- /dev/null
+++ b/components/bare_bundled_extensions/recovery_policy.cc
@@ -0,0 +1,61 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/bare_bundled_extensions/recovery_policy.h"
+
+namespace bare_bundled_extensions {
+
+bool ShouldRecover(const RecoveryFacts& facts) {
+  return facts.claimed_by_bare && facts.still_terminated &&
+         !facts.removed_by_user && !facts.has_disable_reasons &&
+         !facts.reload_too_frequent;
+}
+
+const net::BackoffEntry::Policy kRecoveryBackoffPolicy = {
+    // num_errors_to_ignore
+    1,
+    // initial_delay_ms
+    100,
+    // multiply_factor
+    2,
+    // jitter_factor
+    0.1,
+    // maximum_backoff_ms (30 minutes)
+    1000 * 60 * 30,
+    // entry_lifetime_ms (6 hours)
+    1000 * 60 * 60 * 6,
+    // always_use_initial_delay
+    false,
+};
+
+RecoveryBackoff::RecoveryBackoff(const base::TickClock* clock)
+    : clock_(clock) {}
+
+RecoveryBackoff::~RecoveryBackoff() = default;
+
+void RecoveryBackoff::OnLoaded() {
+  loaded_at_ = Now();
+}
+
+base::TimeDelta RecoveryBackoff::OnTerminated() {
+  const bool stayed_up =
+      loaded_at_ && Now() - *loaded_at_ >= kHealthyUptime;
+  if (!entry_ || entry_->CanDiscard() || stayed_up) {
+    entry_ = std::make_unique<net::BackoffEntry>(&kRecoveryBackoffPolicy,
+                                                 clock_.get());
+  }
+  loaded_at_.reset();
+  entry_->InformOfRequest(false);
+  return entry_->GetTimeUntilRelease();
+}
+
+int RecoveryBackoff::failure_count() const {
+  return entry_ ? entry_->failure_count() : 0;
+}
+
+base::TimeTicks RecoveryBackoff::Now() const {
+  return clock_ ? clock_->NowTicks() : base::TimeTicks::Now();
+}
+
+}  // namespace bare_bundled_extensions
diff --git a/components/bare_bundled_extensions/recovery_policy.h b/components/bare_bundled_extensions/recovery_policy.h
new file mode 100644
index 00000000000..1ab2031ef4f
--- /dev/null
+++ b/components/bare_bundled_extensions/recovery_policy.h
@@ -0,0 +1,80 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef COMPONENTS_BARE_BUNDLED_EXTENSIONS_RECOVERY_POLICY_H_
+#define COMPONENTS_BARE_BUNDLED_EXTENSIONS_RECOVERY_POLICY_H_
+
+#include <memory>
+#include <optional>
+
+#include "base/memory/raw_ptr.h"
+#include "base/time/tick_clock.h"
+#include "base/time/time.h"
+#include "net/base/backoff_entry.h"
+
+namespace bare_bundled_extensions {
+
+// What is known about an extension when a reload is due.
+struct RecoveryFacts {
+  // Bare's provider still claims it, at the location it installs to.
+  bool claimed_by_bare = false;
+  // It is still in the terminated set. Disabling, removing or reloading it
+  // takes it out of that set.
+  bool still_terminated = false;
+  bool removed_by_user = false;
+  bool has_disable_reasons = false;
+  // Chromium terminated it on purpose because it reloaded itself too often.
+  bool reload_too_frequent = false;
+};
+
+// Whether a terminated extension should be loaded again. Only extensions Bare
+// provisioned qualify, and nothing that records a decision -- the user's, or
+// Chromium's own -- is overridden.
+bool ShouldRecover(const RecoveryFacts& facts);
+
+// The delays between attempts. The values are CorruptedExtensionReinstaller's:
+// the first attempt is immediate, later ones double from 100 ms up to 30
+// minutes, and an entry left alone for 6 hours is discarded, so an extension
+// killed once in a while is brought straight back while one that dies as soon as
+// it starts settles at one attempt every half hour.
+extern const net::BackoffEntry::Policy kRecoveryBackoffPolicy;
+
+// How long a reloaded extension has to stay up for its next death to count as
+// a fresh one rather than another turn of the same crash loop.
+inline constexpr base::TimeDelta kHealthyUptime = base::Minutes(1);
+
+// The delays for one extension. Android killing a working extension now and
+// then is answered at once every time: once a reload has stayed up for
+// kHealthyUptime, the next termination starts the backoff over. Only an
+// extension that keeps dying soon after each reload climbs towards the
+// half-hour ceiling.
+class RecoveryBackoff {
+ public:
+  // |clock| is for tests; null means the real clock.
+  explicit RecoveryBackoff(const base::TickClock* clock = nullptr);
+  RecoveryBackoff(const RecoveryBackoff&) = delete;
+  RecoveryBackoff& operator=(const RecoveryBackoff&) = delete;
+  ~RecoveryBackoff();
+
+  // The extension is loaded, whether at startup or after a reload.
+  void OnLoaded();
+
+  // The extension was terminated. Returns how long to wait before loading it
+  // again.
+  base::TimeDelta OnTerminated();
+
+  // Terminations counted by the current backoff run.
+  int failure_count() const;
+
+ private:
+  base::TimeTicks Now() const;
+
+  raw_ptr<const base::TickClock> clock_;
+  std::unique_ptr<net::BackoffEntry> entry_;
+  std::optional<base::TimeTicks> loaded_at_;
+};
+
+}  // namespace bare_bundled_extensions
+
+#endif  // COMPONENTS_BARE_BUNDLED_EXTENSIONS_RECOVERY_POLICY_H_
diff --git a/components/bare_bundled_extensions/recovery_policy_unittest.cc b/components/bare_bundled_extensions/recovery_policy_unittest.cc
new file mode 100644
index 00000000000..a321730abfb
--- /dev/null
+++ b/components/bare_bundled_extensions/recovery_policy_unittest.cc
@@ -0,0 +1,140 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/bare_bundled_extensions/recovery_policy.h"
+
+#include "base/test/simple_test_tick_clock.h"
+#include "base/time/time.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace bare_bundled_extensions {
+namespace {
+
+RecoveryFacts Recoverable() {
+  RecoveryFacts facts;
+  facts.claimed_by_bare = true;
+  facts.still_terminated = true;
+  return facts;
+}
+
+TEST(RecoveryPolicyTest, ABundledExtensionThatWasKilledIsRecovered) {
+  EXPECT_TRUE(ShouldRecover(Recoverable()));
+}
+
+TEST(RecoveryPolicyTest, OnlyWhatBareProvisionedIsTouched) {
+  RecoveryFacts facts = Recoverable();
+  facts.claimed_by_bare = false;
+  EXPECT_FALSE(ShouldRecover(facts));
+}
+
+TEST(RecoveryPolicyTest, AnExtensionNoLongerTerminatedIsLeftAlone) {
+  RecoveryFacts facts = Recoverable();
+  facts.still_terminated = false;
+  EXPECT_FALSE(ShouldRecover(facts));
+}
+
+TEST(RecoveryPolicyTest, ARemovalIsNotUndone) {
+  RecoveryFacts facts = Recoverable();
+  facts.removed_by_user = true;
+  EXPECT_FALSE(ShouldRecover(facts));
+}
+
+TEST(RecoveryPolicyTest, ADisableIsNotUndone) {
+  RecoveryFacts facts = Recoverable();
+  facts.has_disable_reasons = true;
+  EXPECT_FALSE(ShouldRecover(facts));
+}
+
+TEST(RecoveryPolicyTest, ChromiumsOwnReloadLoopGuardIsNotUndone) {
+  RecoveryFacts facts = Recoverable();
+  facts.reload_too_frequent = true;
+  EXPECT_FALSE(ShouldRecover(facts));
+}
+
+TEST(RecoveryPolicyTest, TheFirstAttemptIsImmediate) {
+  base::SimpleTestTickClock clock;
+  net::BackoffEntry entry(&kRecoveryBackoffPolicy, &clock);
+  entry.InformOfRequest(false);
+  EXPECT_EQ(base::TimeDelta(), entry.GetTimeUntilRelease());
+}
+
+TEST(RecoveryPolicyTest, RepeatedDeathsSettleAtHalfAnHour) {
+  base::SimpleTestTickClock clock;
+  net::BackoffEntry entry(&kRecoveryBackoffPolicy, &clock);
+  for (int i = 0; i < 40; ++i) {
+    entry.InformOfRequest(false);
+  }
+  EXPECT_LE(entry.GetTimeUntilRelease(), base::Minutes(30));
+  EXPECT_GE(entry.GetTimeUntilRelease(), base::Minutes(27));
+}
+
+// The case that used to climb: Android kills a working extension again and
+// again, minutes apart. Every recovery stays immediate.
+TEST(RecoveryPolicyTest, AKillAfterAHealthySpellIsRecoveredAtOnce) {
+  base::SimpleTestTickClock clock;
+  RecoveryBackoff backoff(&clock);
+  for (int i = 0; i < 12; ++i) {
+    backoff.OnLoaded();
+    clock.Advance(kHealthyUptime + base::Seconds(1));
+    EXPECT_EQ(base::TimeDelta(), backoff.OnTerminated()) << "kill " << i;
+  }
+}
+
+TEST(RecoveryPolicyTest, AnExtensionThatDiesRightAfterEachReloadBacksOff) {
+  base::SimpleTestTickClock clock;
+  RecoveryBackoff backoff(&clock);
+  base::TimeDelta previous;
+  for (int i = 0; i < 8; ++i) {
+    backoff.OnLoaded();
+    clock.Advance(base::Seconds(3));
+    const base::TimeDelta delay = backoff.OnTerminated();
+    if (i > 0) {
+      EXPECT_GT(delay, previous) << "death " << i;
+    }
+    previous = delay;
+    clock.Advance(delay);
+  }
+  EXPECT_GE(previous, base::Seconds(5));
+}
+
+TEST(RecoveryPolicyTest, AHealthySpellEndsACrashLoop) {
+  base::SimpleTestTickClock clock;
+  RecoveryBackoff backoff(&clock);
+  for (int i = 0; i < 10; ++i) {
+    backoff.OnLoaded();
+    clock.Advance(base::Seconds(2));
+    clock.Advance(backoff.OnTerminated());
+  }
+  EXPECT_EQ(10, backoff.failure_count());
+  backoff.OnLoaded();
+  clock.Advance(kHealthyUptime);
+  EXPECT_EQ(base::TimeDelta(), backoff.OnTerminated());
+  EXPECT_EQ(1, backoff.failure_count());
+}
+
+TEST(RecoveryPolicyTest, ADeathWithoutASeenLoadDoesNotReset) {
+  base::SimpleTestTickClock clock;
+  RecoveryBackoff backoff(&clock);
+  backoff.OnLoaded();
+  clock.Advance(base::Seconds(1));
+  backoff.OnTerminated();
+  clock.Advance(base::Minutes(5));
+  // Terminated again with no load in between: still the same run.
+  EXPECT_GT(backoff.OnTerminated(), base::TimeDelta());
+}
+
+TEST(RecoveryPolicyTest, AQuietSpellOfSixHoursStartsOver) {
+  base::SimpleTestTickClock clock;
+  net::BackoffEntry entry(&kRecoveryBackoffPolicy, &clock);
+  for (int i = 0; i < 10; ++i) {
+    entry.InformOfRequest(false);
+  }
+  clock.Advance(base::Hours(5));
+  EXPECT_FALSE(entry.CanDiscard());
+  clock.Advance(base::Hours(2));
+  EXPECT_TRUE(entry.CanDiscard());
+}

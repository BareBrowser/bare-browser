   if (!profile_) {
     return;
@@ -530,6 +537,7 @@ void BareBundledExtensionsLoader::OnCarriedOver(Plan plan, bool carried_over) {
 }
 
 void BareBundledExtensionsLoader::OnPrefsBuilt(base::DictValue prefs) {
+  last_prefs_ = prefs.Clone();
   LoadFinished(std::move(prefs));
 }
 

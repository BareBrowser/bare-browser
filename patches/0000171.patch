+// De-Googled build: give an installed download manager first refusal.
+//
+// Only a plain GET of a web address qualifies. Another app can fetch that
+// again; it cannot repeat a POST, and it cannot open a blob: or data: URL that
+// only exists inside this browser. The blocklist is checked here as well, so a
+// URL an administrator has blocked is refused by the normal path rather than
+// carried out of reach of the policy that blocked it.
+//
+// Returns false when no suitable app is installed, and the download carries on
+// in the browser. What the app receives is the page address and the browser's
+// user agent, so a site that checks them is satisfied. The user's cookies for
+// the file's site are added only when they have said so in Settings, and never
+// from an Incognito profile. Neither is logged.
+bool ChromeDownloadManagerDelegate::InterceptDownloadForExternalApp(
+    const GURL& url,
+    const GURL& referrer,
+    const std::string& method,
+    const std::string& user_agent,
+    const std::string& mime_type,
+    content::WebContents* web_contents) {
+#if BUILDFLAG(IS_ANDROID)
+  if (method != net::HttpRequestHeaders::kGetMethod ||
+      !url.SchemeIsHTTPOrHTTPS()) {
+    return false;
+  }
+  if (ChromePolicyBlocklistServiceFactory::GetForProfile(profile_)
+          ->GetURLBlocklistState(url) ==
+      policy::URLBlocklist::URLBlocklistState::URL_IN_BLOCKLIST) {
+    return false;
+  }
+  if (!DownloadController::CanSendToExternalDownloadManager(url, mime_type)) {
+    return false;
+  }
+
+  std::string agent = user_agent;
+  if (agent.empty() && web_contents &&
+      !web_contents->GetUserAgentOverride().ua_string_override.empty()) {
+    agent = web_contents->GetUserAgentOverride().ua_string_override;
+  }
+  if (agent.empty()) {
+    agent = embedder_support::GetUserAgent();
+  }
+
+  GURL page = referrer;
+  if (!page.is_valid() && web_contents) {
+    page = web_contents->GetLastCommittedURL();
+  }
+  const std::string page_spec =
+      page.is_valid() && page.SchemeIsHTTPOrHTTPS()
+          ? page.GetAsReferrer().spec()
+          : std::string();
+
+  if (profile_->IsOffTheRecord() ||
+      !DownloadController::ShouldSendSignInToExternalDownloadManager()) {
+    DownloadController::SendToExternalDownloadManager(url, mime_type, page_spec,
+                                                      agent, std::string());
+    return true;
+  }
+
+  profile_->GetDefaultStoragePartition()
+      ->GetCookieManagerForBrowserProcess()
+      ->GetCookieList(url, net::CookieOptions::MakeAllInclusive(),
+                      net::CookiePartitionKeyCollection::ContainsAll(),
+                      base::BindOnce(&SendWithCookies, url, mime_type,
+                                     page_spec, agent));
+  return true;
+#else
+  return false;
+#endif  // BUILDFLAG(IS_ANDROID)

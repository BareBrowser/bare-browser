+#if BUILDFLAG(IS_ANDROID)
+namespace {
+
+// Joins the cookies the browser would send to `url` into one Cookie header
+// value. Not logged anywhere: it is the user's sign-in.
+std::string JoinCookies(const net::CookieAccessResultList& cookies) {
+  std::string header;
+  for (const net::CookieWithAccessResult& entry : cookies) {
+    if (!entry.access_result.status.IsInclude()) {
+      continue;
+    }
+    if (!header.empty()) {
+      header += "; ";
+    }
+    header += entry.cookie.Name();
+    header += "=";
+    header += entry.cookie.Value();
+  }
+  return header;
+}
+
+void SendWithCookies(GURL url,
+                     std::string mime_type,
+                     std::string referrer,
+                     std::string user_agent,
+                     const net::CookieAccessResultList& cookies,
+                     const net::CookieAccessResultList& excluded_cookies) {
+  DownloadController::SendToExternalDownloadManager(
+      url, mime_type, referrer, user_agent, JoinCookies(cookies));
+}
+
+}  // namespace
+#endif  // BUILDFLAG(IS_ANDROID)
+
+// De-Googled build: give an installed download manager first refusal.
+//
+// Only a plain GET of a web address qualifies. Another app can fetch that
+// again; it cannot repeat a POST, and it cannot open a blob: or data: URL that
+// only exists inside this browser. The blocklist is checked here as well, so a
+// URL an administrator has blocked is refused by the normal path rather than
+// carried out of reach of the policy that blocked it.
+//
+// Returns false when no suitable app is installed, and the download carries on
+// in the browser. What the app receives is the page address and the browser's
+// user agent, so a site that checks them is satisfied. The user's cookies for
+// the file's site are added only when they have said so in Settings, and never
+// from an Incognito profile. Neither is logged.
+bool ChromeDownloadManagerDelegate::InterceptDownloadForExternalApp(
+    const download::DownloadCreateInfo& info,
+    const std::string& user_agent,
+    content::WebContents* web_contents) {
+#if BUILDFLAG(IS_ANDROID)
+  const GURL& url = info.url();
+  if (info.method != net::HttpRequestHeaders::kGetMethod ||
+      !url.SchemeIsHTTPOrHTTPS()) {
+    return false;
+  }
+  // Only a download the user started goes to the other app; anything a page
+  // starts by itself is downloaded by Bare. Incognito downloads stay in Bare.
+  if (!bare_download::ShouldHandOffToExternalApp(
+          info.download_source, info.has_user_gesture,
+          profile_->IsOffTheRecord(), web_contents != nullptr)) {
+    return false;
+  }
+  if (ChromePolicyBlocklistServiceFactory::GetForProfile(profile_)
+          ->GetURLBlocklistState(url) ==
+      policy::URLBlocklist::URLBlocklistState::URL_IN_BLOCKLIST) {
+    return false;
+  }
+  const std::string& mime_type = info.mime_type;
+  if (!DownloadController::CanSendToExternalDownloadManager(url, mime_type)) {
+    return false;
+  }
+
+  std::string agent = user_agent;
+  if (agent.empty() && web_contents &&
+      !web_contents->GetUserAgentOverride().ua_string_override.empty()) {
+    agent = web_contents->GetUserAgentOverride().ua_string_override;
+  }
+  if (agent.empty()) {
+    agent = embedder_support::GetUserAgent();
+  }
+  const std::string page_spec = bare_download::HandoffReferrer(info.referrer_url);
+
+  // Cookies go along only when the user allowed it and chose an app, and only
+  // the ones the browser itself would send on this request.
+  std::optional<bare_download::HandoffCookieOptions> cookie_options;
+  if (DownloadController::ShouldSendSignInToExternalDownloadManager()) {
+    cookie_options = bare_download::BuildHandoffCookieOptions(
+        url, info.url_chain, info.isolation_info, info.request_initiator);
+  }
+  if (!cookie_options) {
+    DownloadController::SendToExternalDownloadManager(url, mime_type, page_spec,
+                                                      agent, std::string());
+    return true;
+  }
+
+  profile_->GetDefaultStoragePartition()
+      ->GetCookieManagerForBrowserProcess()
+      ->GetCookieList(url, cookie_options->options, cookie_options->keys,
+                      base::BindOnce(&SendWithCookies, url, mime_type,
+                                     page_spec, agent));
+  return true;
+#else
+  return false;
+#endif  // BUILDFLAG(IS_ANDROID)
+}

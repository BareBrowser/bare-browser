index 00000000000..d2e77de95ed
--- /dev/null
+++ b/chrome/browser/download/bare_download_handoff_unittest.cc
@@ -0,0 +1,119 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/download/bare_download_handoff.h"
+
+#include "net/cookies/cookie_partition_key.h"
+#include "net/cookies/site_for_cookies.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace bare_download {
+namespace {
+
+using download::DownloadSource;
+using Context = net::CookieOptions::SameSiteCookieContext::ContextType;
+
+TEST(BareDownloadHandoffTest, OnlyWhatTheUserStarted) {
+  // A tap carries a gesture, whatever path the download takes.
+  EXPECT_TRUE(ShouldHandOffToExternalApp(DownloadSource::NAVIGATION, true,
+                                         false, true));
+  EXPECT_TRUE(ShouldHandOffToExternalApp(DownloadSource::FROM_RENDERER, true,
+                                         false, true));
+  // Script with no tap.
+  EXPECT_FALSE(ShouldHandOffToExternalApp(DownloadSource::NAVIGATION, false,
+                                          false, true));
+  EXPECT_FALSE(ShouldHandOffToExternalApp(DownloadSource::FROM_RENDERER, false,
+                                          false, true));
+  // The menus start downloads without a gesture.
+  EXPECT_TRUE(ShouldHandOffToExternalApp(DownloadSource::CONTEXT_MENU, false,
+                                         false, true));
+  EXPECT_TRUE(ShouldHandOffToExternalApp(DownloadSource::TOOLBAR_MENU, false,
+                                         false, true));
+  // Never these, gesture or not.
+  for (DownloadSource source :
+       {DownloadSource::EXTENSION_API, DownloadSource::EXTENSION_INSTALLER,
+        DownloadSource::RETRY, DownloadSource::RETRY_FROM_BUBBLE,
+        DownloadSource::OFFLINE_PAGE}) {
+    EXPECT_FALSE(ShouldHandOffToExternalApp(source, true, false, true))
+        << static_cast<int>(source);
+  }
+}
+
+TEST(BareDownloadHandoffTest, NeverFromIncognitoOrWithoutATab) {
+  EXPECT_FALSE(ShouldHandOffToExternalApp(DownloadSource::NAVIGATION, true,
+                                          true, true));
+  EXPECT_FALSE(ShouldHandOffToExternalApp(DownloadSource::CONTEXT_MENU, false,
+                                          true, true));
+  EXPECT_FALSE(ShouldHandOffToExternalApp(DownloadSource::NAVIGATION, true,
+                                          false, false));
+}
+
+net::IsolationInfo MainFrame(const url::Origin& top) {
+  return net::IsolationInfo::Create(net::IsolationInfo::RequestType::kMainFrame,
+                                    top, top,
+                                    net::SiteForCookies::FromOrigin(top));
+}
+
+net::IsolationInfo SubFrame(const url::Origin& top, const url::Origin& frame) {
+  return net::IsolationInfo::Create(net::IsolationInfo::RequestType::kSubFrame,
+                                    top, frame,
+                                    net::SiteForCookies::FromOrigin(top));
+}
+
+TEST(BareDownloadHandoffTest, NoIsolationInfoNoCookies) {
+  const GURL url("https://files.example/a.bin");
+  EXPECT_FALSE(BuildHandoffCookieOptions(url, {url}, std::nullopt,
+                                         url::Origin::Create(url)));
+}
+
+TEST(BareDownloadHandoffTest, SameSiteTapGetsStrictContextAndHttpOnly) {
+  const GURL url("https://files.example/a.bin");
+  const url::Origin site = url::Origin::Create(url);
+  auto options = BuildHandoffCookieOptions(url, {url}, MainFrame(site), site);
+  ASSERT_TRUE(options);
+  EXPECT_FALSE(options->options.exclude_httponly());
+  EXPECT_EQ(options->options.same_site_cookie_context().GetContextForCookieInclusion(),
+            Context::SAME_SITE_STRICT);
+}
+
+TEST(BareDownloadHandoffTest, CrossSiteTapIsNotStrict) {
+  // A link on another site: Strict cookies are not sent by the browser, so
+  // they don't go along either.
+  const GURL url("https://files.example/a.bin");
+  const url::Origin other = url::Origin::Create(GURL("https://other.test/"));
+  auto options = BuildHandoffCookieOptions(
+      url, {url}, MainFrame(url::Origin::Create(url)), other);
+  ASSERT_TRUE(options);
+  EXPECT_NE(options->options.same_site_cookie_context().GetContextForCookieInclusion(),
+            Context::SAME_SITE_STRICT);
+}
+
+TEST(BareDownloadHandoffTest, ThirdPartyFrameGetsNothing) {
+  const GURL url("https://files.example/a.bin");
+  const url::Origin top = url::Origin::Create(GURL("https://news.test/"));
+  EXPECT_FALSE(BuildHandoffCookieOptions(
+      url, {url}, SubFrame(top, url::Origin::Create(url)), top));
+}
+
+TEST(BareDownloadHandoffTest, FirstPartyFrameKeepsItsPartition) {
+  const GURL url("https://files.example/a.bin");
+  const url::Origin site = url::Origin::Create(url);
+  auto options = BuildHandoffCookieOptions(url, {url}, SubFrame(site, site), site);
+  ASSERT_TRUE(options);
+  EXPECT_FALSE(options->keys.ContainsAllKeys());
+}
+
+TEST(BareDownloadHandoffTest, Referrer) {
+  EXPECT_EQ(HandoffReferrer(GURL()), "");
+  EXPECT_EQ(HandoffReferrer(GURL("not a url")), "");
+  EXPECT_EQ(HandoffReferrer(GURL("ftp://files.example/")), "");
+  EXPECT_EQ(HandoffReferrer(GURL("data:text/plain,hi")), "");
+  EXPECT_EQ(HandoffReferrer(GURL("https://user:pw@site.example/page#frag")),
+            "https://site.example/page");
+  EXPECT_EQ(HandoffReferrer(GURL("http://site.example/a?b=1")),
+            "http://site.example/a?b=1");
+}
+
+}  // namespace
+}  // namespace bare_download

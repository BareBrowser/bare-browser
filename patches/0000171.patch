+std::string JoinCookies(const net::CookieAccessResultList& cookies) {
+  std::string header;
+  for (const net::CookieWithAccessResult& entry : cookies) {
+    if (!entry.access_result.status.IsInclude()) {
+      continue;
+    }
+    if (!header.empty()) {
+      header += "; ";
+    }
+    header += entry.cookie.Name();
+    header += "=";
+    header += entry.cookie.Value();
+  }
+  return header;
+}
+
+void SendWithCookies(GURL url,
+                     std::string mime_type,
+                     std::string referrer,
+                     std::string user_agent,
+                     const net::CookieAccessResultList& cookies,
+                     const net::CookieAccessResultList& excluded_cookies) {
+  DownloadController::SendToExternalDownloadManager(
+      url, mime_type, referrer, user_agent, JoinCookies(cookies));
+}

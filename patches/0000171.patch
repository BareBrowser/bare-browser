@@ -0,0 +1,82 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/download/bare_download_handoff.h"
+
+#include "net/base/schemeful_site.h"
+#include "net/cookies/cookie_partition_key.h"
+#include "net/cookies/cookie_util.h"
+#include "net/cookies/site_for_cookies.h"
+
+namespace bare_download {
+
+bool ShouldHandOffToExternalApp(download::DownloadSource source,
+                                bool has_user_gesture,
+                                bool is_off_the_record,
+                                bool has_web_contents) {
+  if (is_off_the_record || !has_web_contents) {
+    return false;
+  }
+  switch (source) {
+    case download::DownloadSource::CONTEXT_MENU:
+    case download::DownloadSource::TOOLBAR_MENU:
+      return true;
+    case download::DownloadSource::EXTENSION_API:
+    case download::DownloadSource::EXTENSION_INSTALLER:
+    case download::DownloadSource::RETRY:
+    case download::DownloadSource::RETRY_FROM_BUBBLE:
+    case download::DownloadSource::OFFLINE_PAGE:
+      return false;
+    default:
+      return has_user_gesture;
+  }
+}
+
+HandoffCookieOptions::HandoffCookieOptions() = default;
+HandoffCookieOptions::HandoffCookieOptions(const HandoffCookieOptions&) =
+    default;
+HandoffCookieOptions& HandoffCookieOptions::operator=(
+    const HandoffCookieOptions&) = default;
+HandoffCookieOptions::~HandoffCookieOptions() = default;
+
+std::optional<HandoffCookieOptions> BuildHandoffCookieOptions(
+    const GURL& url,
+    const std::vector<GURL>& url_chain,
+    const std::optional<net::IsolationInfo>& isolation_info,
+    const std::optional<url::Origin>& initiator) {
+  if (!isolation_info || !url.is_valid()) {
+    return std::nullopt;
+  }
+  const net::IsolationInfo& isolation = *isolation_info;
+  const bool main_frame =
+      isolation.request_type() == net::IsolationInfo::RequestType::kMainFrame;
+  // A frame from another site: nothing of the user's goes along.
+  if (!main_frame && !isolation.site_for_cookies().IsFirstParty(url)) {
+    return std::nullopt;
+  }
+  HandoffCookieOptions out;
+  out.options.set_include_httponly();
+  out.options.set_same_site_cookie_context(
+      net::cookie_util::ComputeSameSiteContextForRequest(
+          "GET", url_chain.empty() ? std::vector<GURL>{url} : url_chain,
+          isolation.site_for_cookies(), initiator, main_frame,
+          /*force_ignore_site_for_cookies=*/false,
+          /*ignore_unsafe_method_for_same_site_lax=*/false));
+  std::optional<net::CookiePartitionKey> key =
+      net::CookiePartitionKey::FromNetworkIsolationKey(
+          isolation.network_isolation_key(), isolation.site_for_cookies(),
+          net::SchemefulSite(url), main_frame);
+  out.keys = key ? net::CookiePartitionKeyCollection(*key)
+                 : net::CookiePartitionKeyCollection();
+  return out;
+}
+
+std::string HandoffReferrer(const GURL& referrer) {
+  if (!referrer.is_valid() || !referrer.SchemeIsHTTPOrHTTPS()) {
+    return std::string();
+  }
+  return referrer.GetAsReferrer().spec();
+}
+
+}  // namespace bare_download

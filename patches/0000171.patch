+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.download;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertNull;
+import static org.junit.Assert.assertTrue;
+
+import android.content.Intent;
+import android.net.Uri;
+import android.os.Bundle;
+import android.provider.Browser;
+
+import org.junit.Test;
+import org.junit.runner.RunWith;
+
+import org.chromium.base.test.BaseRobolectricTestRunner;
+
+/** Unit tests for the intent a download is handed to another app in. */
+@RunWith(BaseRobolectricTestRunner.class)
+public class DownloadControllerHandoffUnitTest {
+    private static final String URL = "https://files.example/get/report.zip";
+    private static final String PAGE = "https://files.example/account/";
+    private static final String AGENT = "Mozilla/5.0 (Linux; Android 12) TestBrowser";
+    private static final String COOKIE = "session=abc; theme=dark";
+
+    @Test
+    public void testTheAddressAndTypeAreAlwaysThere() {
+        Intent intent = DownloadController.buildHandoffIntent(URL, "application/zip", "", "", "");
+        assertEquals(Intent.ACTION_VIEW, intent.getAction());
+        assertEquals(Uri.parse(URL), intent.getData());
+        assertEquals("application/zip", intent.getType());
+    }
+
+    @Test
+    public void testNothingToSendMeansNoHeadersBundle() {
+        Intent intent = DownloadController.buildHandoffIntent(URL, "", "", "", "");
+        assertNull(intent.getBundleExtra(Browser.EXTRA_HEADERS));
+        assertNull(intent.getType());
+    }
+
+    @Test
+    public void testTheReferrerGoesInBothPlacesReadersLook() {
+        Intent intent = DownloadController.buildHandoffIntent(URL, "", PAGE, AGENT, "");
+        Bundle headers = intent.getBundleExtra(Browser.EXTRA_HEADERS);
+        assertEquals(PAGE, headers.getString("Referer"));
+        assertEquals(AGENT, headers.getString("User-Agent"));
+        assertEquals(Uri.parse(PAGE), intent.getParcelableExtra(Intent.EXTRA_REFERRER));
+    }
+
+    @Test
+    public void testNoCookieIsSentUnlessGiven() {
+        Intent intent = DownloadController.buildHandoffIntent(URL, "", PAGE, AGENT, "");
+        assertFalse(intent.getBundleExtra(Browser.EXTRA_HEADERS).containsKey("Cookie"));
+    }
+
+    @Test
+    public void testACookieTravelsInTheHeadersBundleOnly() {
+        Intent intent = DownloadController.buildHandoffIntent(URL, "", PAGE, AGENT, COOKIE);
+        Bundle headers = intent.getBundleExtra(Browser.EXTRA_HEADERS);
+        assertEquals(COOKIE, headers.getString("Cookie"));
+        // Not a top-level extra, and not in the address: either would show up in places a header
+        // does not.
+        assertFalse(intent.hasExtra("cookie"));
+        assertFalse(intent.getDataString().contains("session"));
+        assertTrue(intent.getExtras().keySet().contains(Browser.EXTRA_HEADERS));
+    }
+}

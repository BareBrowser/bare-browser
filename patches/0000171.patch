+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_DOWNLOAD_BARE_DOWNLOAD_HANDOFF_H_
+#define CHROME_BROWSER_DOWNLOAD_BARE_DOWNLOAD_HANDOFF_H_
+
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "components/download/public/common/download_source.h"
+#include "net/base/isolation_info.h"
+#include "net/cookies/cookie_options.h"
+#include "net/cookies/cookie_partition_key_collection.h"
+#include "url/gurl.h"
+#include "url/origin.h"
+
+// Bare: when a download may go to the user's other download app, and what may
+// go along with it.
+namespace bare_download {
+
+// Whether the user started this download, so it may go to another app: a tap
+// (the request carries a user gesture), or the long-press or toolbar menu,
+// which start downloads without one. Never from Incognito, never once the tab
+// it came from is gone, never for an extension's download or a retry.
+bool ShouldHandOffToExternalApp(download::DownloadSource source,
+                                bool has_user_gesture,
+                                bool is_off_the_record,
+                                bool has_web_contents);
+
+struct HandoffCookieOptions {
+  HandoffCookieOptions();
+  HandoffCookieOptions(const HandoffCookieOptions&);
+  HandoffCookieOptions& operator=(const HandoffCookieOptions&);
+  ~HandoffCookieOptions();
+
+  net::CookieOptions options;
+  net::CookiePartitionKeyCollection keys;
+};
+
+// What to ask the cookie store for so it returns the cookies the browser
+// itself would send on this request: its SameSite context, its partition, and
+// HttpOnly ones (the browser sends those too). nullopt means send none: the
+// request has no isolation info, or it comes from a third-party frame.
+std::optional<HandoffCookieOptions> BuildHandoffCookieOptions(
+    const GURL& url,
+    const std::vector<GURL>& url_chain,
+    const std::optional<net::IsolationInfo>& isolation_info,
+    const std::optional<url::Origin>& initiator);
+
+// The referrer to pass on: the request's own, which already follows the
+// page's referrer policy, as an http or https referrer; otherwise empty. The
+// page's address is never put in its place.
+std::string HandoffReferrer(const GURL& referrer);
+
+}  // namespace bare_download
+
+#endif  // CHROME_BROWSER_DOWNLOAD_BARE_DOWNLOAD_HANDOFF_H_

+    /** The name of a site as people say it: no scheme and no leading www. */
+    private static String plainName(String origin) {
+        String extension = "chrome-extension://";
+        if (origin.startsWith(extension)) {
+            String id = origin.substring(extension.length());
+            int slash = id.indexOf('/');
+            if (slash >= 0) id = id.substring(0, slash);
+            return id.equals("fkgkibajhfbepljeaefdnfnegdcjomkh") ? "uBlock Data" : "Extension data";
+        }
+        String name = origin;
+        int scheme = name.indexOf("://");
+        if (scheme >= 0) name = name.substring(scheme + 3);
+        if (name.startsWith("www.")) name = name.substring(4);
+        // An extension id on its own, without the scheme in front.
+        if (name.matches("[a-p]{32}")) {
+            return name.equals("fkgkibajhfbepljeaefdnfnegdcjomkh") ? "uBlock Data" : "Extension data";
+        }
+        return name;
+    }

+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.bare.backup;
+
+import android.app.Activity;
+import android.app.AlertDialog;
+import android.content.Context;
+import android.content.Intent;
+import android.net.Uri;
+import android.os.Bundle;
+
+import androidx.activity.OnBackPressedCallback;
+import androidx.activity.result.ActivityResult;
+import androidx.activity.result.ActivityResultLauncher;
+import androidx.activity.result.contract.ActivityResultContracts;
+import androidx.preference.CheckBoxPreference;
+import androidx.preference.Preference;
+import androidx.preference.PreferenceScreen;
+
+import org.chromium.base.supplier.MonotonicObservableSupplier;
+import org.chromium.base.supplier.ObservableSuppliers;
+import org.chromium.base.supplier.SettableMonotonicObservableSupplier;
+import org.chromium.base.task.PostTask;
+import org.chromium.base.task.TaskTraits;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.chrome.R;
+import org.chromium.chrome.browser.profiles.ProfileManager;
+import org.chromium.chrome.browser.settings.ChromeBaseSettingsFragment;
+import org.chromium.components.browser_ui.settings.TextMessagePreference;
+
+import java.util.Arrays;
+
+/**
+ * Settings > Backup and transfer > Automatic backup > Set up: how often, where, the passphrase,
+ * and a summary. Back goes one step back; leaving before the passphrase step writes nothing.
+ *
+ * <p>With {@link #ARG_MODE} it runs only part of the way: {@link #MODE_FOLDER} picks a new
+ * folder for backups that are on, {@link #MODE_PASSPHRASE} makes a new passphrase for them.
+ */
+public class BareAutoBackupSetupFragment extends ChromeBaseSettingsFragment {
+    static final String ARG_MODE = "mode";
+    static final String MODE_SETUP = "setup";
+    static final String MODE_FOLDER = "folder";
+    static final String MODE_PASSPHRASE = "passphrase";
+
+    private static final int STEP_RULE = 1;
+    private static final int STEP_FOLDER = 2;
+    private static final int STEP_PASSPHRASE = 3;
+    private static final int STEP_DONE = 4;
+
+    // The number shown in step 3, kept in memory only, so turning the phone shows the same one.
+    // Leaving the step forgets it, and coming back makes a new one.
+    private static @Nullable String sPendingCode;
+    // The mode asked for by the page that opens this one. Settings doesn't always pass a
+    // fragment's arguments on when it is opened from the browser, so it is handed over here too.
+    private static @Nullable String sNextMode;
+
+    private final SettableMonotonicObservableSupplier<String> mPageTitle =
+            ObservableSuppliers.createMonotonic();
+    private ActivityResultLauncher<Intent> mPicker;
+    private BareScreenLock mScreenLock;
+    private OnBackPressedCallback mBack;
+
+    private String mMode = MODE_SETUP;
+    private int mStep = STEP_RULE;
+    private int mRule = BareAutoBackup.RULE_WEEKLY;
+    private @Nullable Uri mFolder;
+    private String mFolderLabel = BareBackupFolder.DEFAULT_LABEL;
+    private boolean mIsCode = true;
+    private @Nullable String mFolderProblem;
+    private @Nullable AlertDialog mDialog;
+
+    @Override
+    public void onCreate(@Nullable Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+        mPicker =
+                registerForActivityResult(
+                        new ActivityResultContracts.StartActivityForResult(), this::onPicked);
+        mScreenLock = new BareScreenLock(this);
+        Bundle args = getArguments();
+        String requested = args == null ? null : args.getString(ARG_MODE);
+        if (requested == null && savedInstanceState == null) requested = sNextMode;
+        sNextMode = null;
+        if (requested != null) mMode = requested;
+        if (savedInstanceState != null) {
+            mStep = savedInstanceState.getInt("step", mStep);
+            mRule = savedInstanceState.getInt("rule", mRule);
+            String folder = savedInstanceState.getString("folder");
+            mFolder = folder == null ? null : Uri.parse(folder);
+            mFolderLabel = savedInstanceState.getString("label", mFolderLabel);
+        } else {
+            sPendingCode = null;
+            if (MODE_FOLDER.equals(mMode)) {
+                mStep = STEP_FOLDER;
+            } else if (MODE_PASSPHRASE.equals(mMode)) {
+                mStep = STEP_PASSPHRASE;
+            }
+            if (BareAutoBackup.rule() != BareAutoBackup.RULE_MANUAL) mRule = BareAutoBackup.rule();
+            String folder = BareAutoBackup.prefs().getString(BareAutoBackup.KEY_FOLDER, null);
+            if (folder != null && !MODE_FOLDER.equals(mMode)) {
+                // A folder chosen before is offered again, as long as Bare can still use it.
+                mFolder = Uri.parse(folder);
+                mFolderLabel =
+                        BareAutoBackup.prefs()
+                                .getString(BareAutoBackup.KEY_FOLDER_LABEL, mFolderLabel);
+            }
+        }
+        mBack =
+                new OnBackPressedCallback(true) {
+                    @Override
+                    public void handleOnBackPressed() {
+                        stepBack();
+                    }
+                };
+        requireActivity().getOnBackPressedDispatcher().addCallback(this, mBack);
+        // super.onCreate() built the screen before the step above was known.
+        render();
+    }
+
+    @Override
+    public void onSaveInstanceState(Bundle out) {
+        super.onSaveInstanceState(out);
+        out.putInt("step", mStep);
+        out.putInt("rule", mRule);
+        if (mFolder != null) out.putString("folder", mFolder.toString());
+        out.putString("label", mFolderLabel);
+    }
+
+    @Override
+    public void onCreatePreferences(@Nullable Bundle savedInstanceState, @Nullable String rootKey) {
+        mPageTitle.set(getString(R.string.bare_autobackup_title));
+        setPreferenceScreen(getPreferenceManager().createPreferenceScreen(getContext()));
+        render();
+    }
+
+    @Override
+    public void onDestroyView() {
+        if (mDialog != null) {
+            mDialog.dismiss();
+            mDialog = null;
+        }
+        super.onDestroyView();
+    }
+
+    private void stepBack() {
+        boolean partial = !MODE_SETUP.equals(mMode);
+        if (mStep == STEP_DONE || mStep == STEP_RULE || partial) {
+            sPendingCode = null;
+            leave();
+            return;
+        }
+        if (mStep == STEP_PASSPHRASE) sPendingCode = null;
+        mStep--;
+        render();
+    }
+
+    /** Opens this page, in {@code mode} if given. */
+    static void open(Context context, @Nullable String mode) {
+        sNextMode = mode;
+        Bundle args = new Bundle();
+        if (mode != null) args.putString(ARG_MODE, mode);
+        org.chromium.chrome.browser.settings.SettingsNavigationFactory.createSettingsNavigation()
+                .startSettings(context, BareAutoBackupSetupFragment.class, args);
+    }
+
+    /** Leaves the page as the Back button would, back to the page it was opened from. */
+    private void leave() {
+        Activity activity = getActivity();
+        if (activity == null) return;
+        mBack.setEnabled(false);
+        ((androidx.activity.ComponentActivity) activity).getOnBackPressedDispatcher().onBackPressed();
+    }
+
+    private void render() {
+        Context context = getContext();
+        if (context == null) return;
+        PreferenceScreen screen = getPreferenceScreen();
+        screen.removeAll();
+        switch (mStep) {
+            case STEP_RULE -> renderRule(context, screen);
+            case STEP_FOLDER -> renderFolder(context, screen);
+            case STEP_PASSPHRASE -> renderPassphrase(context, screen);
+            default -> renderDone(context, screen);
+        }
+    }
+
+    // Step 1.
+
+    private void renderRule(Context context, PreferenceScreen screen) {
+        heading(screen, R.string.bare_autobackup_step1_title);
+        int[] rules = {
+            BareAutoBackup.RULE_DAILY, BareAutoBackup.RULE_WEEKLY, BareAutoBackup.RULE_MONTHLY
+        };
+        int[] titles = {
+            R.string.bare_autobackup_every_day,
+            R.string.bare_autobackup_every_week,
+            R.string.bare_autobackup_every_month
+        };
+        CheckBoxPreference[] rows = new CheckBoxPreference[rules.length];
+        for (int i = 0; i < rules.length; i++) {
+            CheckBoxPreference row = new CheckBoxPreference(context);
+            row.setPersistent(false);
+            row.setTitle(titles[i]);
+            if (rules[i] == BareAutoBackup.RULE_WEEKLY) {
+                row.setSummary(R.string.bare_autobackup_recommended);
+            }
+            row.setChecked(rules[i] == mRule);
+            int rule = rules[i];
+            row.setOnPreferenceClickListener(
+                    p -> {
+                        mRule = rule;
+                        for (CheckBoxPreference other : rows) other.setChecked(other == p);
+                        return true;
+                    });
+            rows[i] = row;
+            screen.addPreference(row);
+        }
+        message(screen, R.string.bare_autobackup_step1_body);
+        button(screen, R.string.bare_autobackup_continue, () -> go(STEP_FOLDER));
+        Preference manual = new Preference(context);
+        manual.setTitle(R.string.bare_autobackup_manual_only);
+        manual.setOnPreferenceClickListener(
+                p -> {
+                    leave();
+                    return true;
+                });
+        screen.addPreference(manual);
+    }
+
+    // Step 2.
+
+    private void renderFolder(Context context, PreferenceScreen screen) {
+        heading(screen, R.string.bare_autobackup_step2_title);
+        Preference folder = new Preference(context);
+        folder.setTitle(mFolderLabel);
+        folder.setSummary(R.string.bare_autobackup_on_this_phone);
+        folder.setSelectable(false);
+        screen.addPreference(folder);
+        message(screen, R.string.bare_autobackup_step2_body);
+        if (mFolderProblem != null) {
+            TextMessagePreference problem = new TextMessagePreference(context, null);
+            problem.setSummary(mFolderProblem);
+            screen.addPreference(problem);
+        }
+        button(screen, R.string.bare_autobackup_continue, this::continueFromFolder);
+        Preference change = new Preference(context);
+        change.setTitle(R.string.bare_autobackup_change);
+        change.setOnPreferenceClickListener(
+                p -> {
+                    mPicker.launch(BareBackupFolder.pickerIntent());
+                    return true;
+                });
+        screen.addPreference(change);
+    }
+
+    private void continueFromFolder() {
+        if (mFolder == null) {
+            mPicker.launch(BareBackupFolder.pickerIntent());
+            return;
+        }
+        // A folder chosen before: check Bare can still write there.
+        checkFolder(mFolder);
+    }
+
+    private void onPicked(ActivityResult result) {
+        Intent data = result.getData();
+        if (result.getResultCode() != Activity.RESULT_OK || data == null || data.getData() == null) {
+            return;
+        }
+        checkFolder(data.getData());
+    }
+
+    private void checkFolder(Uri tree) {
+        Context context = getContext();
+        if (context == null) return;
+        BareBackupFolder folder = new BareBackupFolder(context, tree);
+        AlertDialog progress = BareBackupDialogs.progress(context, R.string.bare_autobackup_checking);
+        PostTask.postTask(
+                TaskTraits.USER_BLOCKING_MAY_BLOCK,
+                () -> {
+                    String problem = null;
+                    String label = null;
+                    if (!folder.keepGrant() && !folder.hasGrant()) {
+                        problem = context.getString(R.string.bare_autobackup_folder_unusable);
+                    } else if (folder.isTooHigh()) {
+                        problem = context.getString(R.string.bare_autobackup_folder_too_high);
+                    } else if (!folder.canHoldBackups()) {
+                        problem = context.getString(R.string.bare_autobackup_folder_unusable);
+                    } else {
+                        label = folder.label();
+                    }
+                    String found = problem;
+                    String name = label;
+                    PostTask.postTask(
+                            TaskTraits.UI_DEFAULT,
+                            () -> {
+                                progress.dismiss();
+                                mFolderProblem = found;
+                                if (found != null) {
+                                    mFolder = null;
+                                    render();
+                                    return;
+                                }
+                                mFolder = tree;
+                                mFolderLabel = name;
+                                if (MODE_FOLDER.equals(mMode)) {
+                                    BareAutoBackup.setFolder(tree, name);
+                                    mStep = STEP_DONE;
+                                    render();
+                                    return;
+                                }
+                                go(STEP_PASSPHRASE);
+                            });
+                });
+    }
+
+    // Step 3.
+
+    private void renderPassphrase(Context context, PreferenceScreen screen) {
+        heading(screen, R.string.bare_autobackup_step3_title);
+        message(screen, R.string.bare_autobackup_step3_body);
+        if (!BareScreenLock.isSet(context)) message(screen, R.string.bare_autobackup_no_lock_note);
+        button(screen, R.string.bare_autobackup_show_passphrase, this::askForPassphrase);
+        if (sPendingCode != null && mDialog == null) {
+            // Turned while the number was up: show the same one again.
+            showStep(sPendingCode);
+        }
+    }
+
+    private void askForPassphrase() {
+        if (sPendingCode != null) {
+            showStep(sPendingCode);
+            return;
+        }
+        Runnable show =
+                () -> {
+                    sPendingCode = BareBackupBridge.generateRecoveryCode();
+                    showStep(sPendingCode);
+                };
+        if (!BareScreenLock.isSet(getContext())) {
+            show.run();
+            return;
+        }
+        mScreenLock.confirm(
+                ok -> {
+                    if (ok && getContext() != null) show.run();
+                });
+    }
+
+    private void showStep(String code) {
+        Context context = getContext();
+        if (context == null) return;
+        mDialog =
+                BareBackupPassphraseStep.show(
+                        context,
+                        code,
+                        (secret, isCode) -> {
+                            mDialog = null;
+                            sPendingCode = null;
+                            keep(secret, isCode);
+                        },
+                        () -> {
+                            mDialog = null;
+                            sPendingCode = null;
+                        });
+    }
+
+    /** Derives the key, wraps it with the keystore and turns backups on. */
+    private void keep(byte[] secret, boolean isCode) {
+        Context context = getContext();
+        if (context == null) {
+            Arrays.fill(secret, (byte) 0);
+            return;
+        }
+        mIsCode = isCode;
+        AlertDialog progress = BareBackupDialogs.progress(context, R.string.bare_autobackup_securing);
+        BareBackupBridge.deriveStoredKey(
+                secret,
+                isCode,
+                stored -> {
+                    Arrays.fill(secret, (byte) 0);
+                    PostTask.postTask(
+                            TaskTraits.USER_BLOCKING_MAY_BLOCK,
+                            () -> {
+                                String wrapped =
+                                        stored == null || stored.length == 0
+                                                ? null
+                                                : BareBackupKeyStore.wrap(stored);
+                                if (stored != null) Arrays.fill(stored, (byte) 0);
+                                PostTask.postTask(
+                                        TaskTraits.UI_DEFAULT,
+                                        () -> {
+                                            progress.dismiss();
+                                            kept(wrapped);
+                                        });
+                            });
+                });
+    }
+
+    private void kept(@Nullable String wrapped) {
+        Context context = getContext();
+        if (wrapped == null || mFolder == null) {
+            if (context != null) {
+                BareBackupDialogs.message(context, R.string.bare_autobackup_no_keystore);
+            }
+            return;
+        }
+        BareAutoBackup.turnOn(mRule, mFolder, mFolderLabel, wrapped, mIsCode);
+        mStep = STEP_DONE;
+        render();
+    }
+
+    // Step 4.
+
+    private void renderDone(Context context, PreferenceScreen screen) {
+        mBack.setEnabled(true);
+        heading(screen, R.string.bare_autobackup_step4_title);
+        int ruleTitle =
+                switch (BareAutoBackup.rule()) {
+                    case BareAutoBackup.RULE_DAILY -> R.string.bare_autobackup_every_day;
+                    case BareAutoBackup.RULE_MONTHLY -> R.string.bare_autobackup_every_month;
+                    default -> R.string.bare_autobackup_every_week;
+                };
+        check(screen, getString(ruleTitle));
+        check(
+                screen,
+                BareAutoBackup.prefs()
+                        .getString(BareAutoBackup.KEY_FOLDER_LABEL, mFolderLabel));
+        check(screen, getString(R.string.bare_autobackup_done_passphrase));
+        message(screen, R.string.bare_autobackup_step4_body);
+        // A first install inside the welcome has nothing to back up yet, and the profile may not
+        // be up; the first backup then happens when the user leaves Bare.
+        if (ProfileManager.isInitialized()) {
+            button(screen, R.string.bare_autobackup_back_up_now, () -> backUpNow(context));
+        }
+        button(screen, R.string.bare_autobackup_done, this::leave);
+    }
+
+    static void backUpNow(Context context) {
+        AlertDialog progress = BareBackupDialogs.progress(context, R.string.bare_backup_working);
+        BareAutoBackup.runNow(
+                result -> {
+                    progress.dismiss();
+                    if (BareAutoBackup.ERROR_NONE.equals(result)) {
+                        android.widget.Toast.makeText(
+                                        context,
+                                        R.string.bare_backup_saved,
+                                        android.widget.Toast.LENGTH_SHORT)
+                                .show();
+                    } else if (BareAutoBackup.ERROR_BUSY.equals(result)) {
+                        BareBackupDialogs.message(context, R.string.bare_autobackup_busy);
+                    } else {
+                        BareBackupDialogs.message(context, BareAutoBackup.failureText(result));
+                    }
+                });
+    }
+
+    // Rows.
+
+    private void go(int step) {
+        mStep = step;
+        mFolderProblem = null;
+        render();
+    }
+
+    private void heading(PreferenceScreen screen, int title) {
+        Preference heading = new Preference(getContext());
+        heading.setTitle(title);
+        heading.setSelectable(false);
+        screen.addPreference(heading);
+    }
+
+    private void message(PreferenceScreen screen, int text) {
+        TextMessagePreference message = new TextMessagePreference(getContext(), null);
+        message.setSummary(text);
+        screen.addPreference(message);
+    }
+
+    private void check(PreferenceScreen screen, String text) {
+        Preference row = new Preference(getContext());
+        row.setTitle("✓  " + text);
+        row.setSelectable(false);
+        screen.addPreference(row);
+    }
+
+    private void button(PreferenceScreen screen, int title, Runnable action) {
+        BareBackupButtonPreference button = new BareBackupButtonPreference(getContext());
+        button.setTitle(title);
+        button.setOnClick(action);
+        screen.addPreference(button);
+    }
+
+    @Override
+    public MonotonicObservableSupplier<String> getPageTitle() {
+        return mPageTitle;
+    }
+
+    @Override
+    public @AnimationType int getAnimationType() {
+        return AnimationType.PROPERTY;
+    }
+}

--- /dev/null
+++ b/chrome/android/java/src/org/chromium/chrome/browser/bare/backup/BareAutoBackupFragment.java
@@ -0,0 +1,308 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.bare.backup;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+import android.os.Bundle;
+import android.text.format.DateUtils;
+import android.text.format.Formatter;
+
+import androidx.preference.Preference;
+import androidx.preference.PreferenceScreen;
+
+import org.chromium.base.supplier.MonotonicObservableSupplier;
+import org.chromium.base.supplier.ObservableSuppliers;
+import org.chromium.base.supplier.SettableMonotonicObservableSupplier;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.chrome.R;
+import org.chromium.chrome.browser.settings.ChromeBaseSettingsFragment;
+import org.chromium.components.browser_ui.settings.TextMessagePreference;
+
+/**
+ * Settings > Backup and transfer > Automatic backup: what was saved last, how often, and an
+ * Advanced section for the rest. Off, it offers setup.
+ */
+public class BareAutoBackupFragment extends ChromeBaseSettingsFragment {
+    private final SettableMonotonicObservableSupplier<String> mPageTitle =
+            ObservableSuppliers.createMonotonic();
+    private boolean mAdvancedOpen;
+
+    @Override
+    public void onCreatePreferences(@Nullable Bundle savedInstanceState, @Nullable String rootKey) {
+        mPageTitle.set(getString(R.string.bare_autobackup_title));
+        setPreferenceScreen(getPreferenceManager().createPreferenceScreen(getContext()));
+    }
+
+    @Override
+    public void onResume() {
+        super.onResume();
+        render();
+    }
+
+    /** The row on the Backup and transfer page: "Off", or the schedule and the last backup. */
+    static String summary(Context context) {
+        if (!BareAutoBackup.isOn()) return context.getString(R.string.bare_autobackup_off);
+        if (!BareAutoBackup.ERROR_NONE.equals(BareAutoBackup.lastError())) {
+            return context.getString(R.string.bare_autobackup_summary_failed);
+        }
+        String rule = context.getString(ruleName(BareAutoBackup.rule()));
+        long last = BareAutoBackup.prefs().getLong(BareAutoBackup.KEY_LAST_SUCCESS, 0);
+        if (last == 0) return context.getString(R.string.bare_autobackup_summary_never, rule);
+        long now = System.currentTimeMillis();
+        CharSequence when =
+                Math.abs(now - last) < DateUtils.MINUTE_IN_MILLIS
+                        ? context.getString(R.string.bare_autobackup_just_now)
+                        : DateUtils.getRelativeTimeSpanString(
+                                last, now, DateUtils.MINUTE_IN_MILLIS);
+        return context.getString(R.string.bare_autobackup_summary_on, rule, when);
+    }
+
+    static int ruleName(int rule) {
+        return switch (rule) {
+            case BareAutoBackup.RULE_DAILY -> R.string.bare_autobackup_daily;
+            case BareAutoBackup.RULE_MONTHLY -> R.string.bare_autobackup_monthly;
+            default -> R.string.bare_autobackup_weekly;
+        };
+    }
+
+    private void render() {
+        Context context = getContext();
+        if (context == null) return;
+        PreferenceScreen screen = getPreferenceScreen();
+        screen.removeAll();
+        if (!BareAutoBackup.isOn()) {
+            message(screen, getString(R.string.bare_autobackup_off_body));
+            button(screen, R.string.bare_autobackup_set_up, () -> openSetup(context, null));
+            return;
+        }
+        SharedPreferences prefs = BareAutoBackup.prefs();
+
+        Preference last = row(screen, R.string.bare_autobackup_last_backup, lastBackup(context));
+        last.setSelectable(false);
+        Preference where =
+                row(
+                        screen,
+                        R.string.bare_autobackup_saved_to,
+                        prefs.getString(BareAutoBackup.KEY_FOLDER_LABEL, ""));
+        where.setSelectable(false);
+
+        String error = BareAutoBackup.lastError();
+        if (!BareAutoBackup.ERROR_NONE.equals(error)) {
+            Preference fix =
+                    row(screen, R.string.bare_autobackup_fix_it, getString(BareAutoBackup.failureText(error)));
+            fix.setOnPreferenceClickListener(
+                    p -> {
+                        fix(context, error);
+                        return true;
+                    });
+        }
+
+        Preference often =
+                row(
+                        screen,
+                        R.string.bare_autobackup_how_often,
+                        getString(ruleName(BareAutoBackup.rule())));
+        often.setOnPreferenceClickListener(
+                p -> {
+                    chooseRule(context);
+                    return true;
+                });
+
+        Preference advanced = row(screen, R.string.bare_autobackup_advanced, null);
+        advanced.setOnPreferenceClickListener(
+                p -> {
+                    mAdvancedOpen = !mAdvancedOpen;
+                    render();
+                    return true;
+                });
+        if (mAdvancedOpen) {
+            int keep = BareAutoBackup.keep();
+            Preference keepRow =
+                    row(
+                            screen,
+                            R.string.bare_autobackup_keep,
+                            getString(
+                                    keep == 1
+                                            ? R.string.bare_autobackup_keep_1
+                                            : keep == 3
+                                                    ? R.string.bare_autobackup_keep_3
+                                                    : R.string.bare_autobackup_keep_5));
+            keepRow.setOnPreferenceClickListener(
+                    p -> {
+                        chooseKeep(context);
+                        return true;
+                    });
+            Preference folder =
+                    row(
+                            screen,
+                            R.string.bare_autobackup_folder,
+                            prefs.getString(BareAutoBackup.KEY_FOLDER_LABEL, ""));
+            folder.setOnPreferenceClickListener(
+                    p -> {
+                        openSetup(context, BareAutoBackupSetupFragment.MODE_FOLDER);
+                        return true;
+                    });
+            Preference passphrase =
+                    row(
+                            screen,
+                            R.string.bare_autobackup_change_passphrase,
+                            getString(R.string.bare_autobackup_change_passphrase_summary));
+            passphrase.setOnPreferenceClickListener(
+                    p -> {
+                        openSetup(context, BareAutoBackupSetupFragment.MODE_PASSPHRASE);
+                        return true;
+                    });
+            Preference now = row(screen, R.string.bare_autobackup_back_up_now, null);
+            now.setOnPreferenceClickListener(
+                    p -> {
+                        BareAutoBackupSetupFragment.backUpNow(context);
+                        return true;
+                    });
+            Preference off = row(screen, R.string.bare_autobackup_turn_off, null);
+            off.setOnPreferenceClickListener(
+                    p -> {
+                        confirmTurnOff(context);
+                        return true;
+                    });
+        }
+        message(screen, getString(R.string.bare_backup_footnote));
+    }
+
+    private String lastBackup(Context context) {
+        SharedPreferences prefs = BareAutoBackup.prefs();
+        long last = prefs.getLong(BareAutoBackup.KEY_LAST_SUCCESS, 0);
+        if (last == 0) return getString(R.string.bare_autobackup_never);
+        String when =
+                DateUtils.formatDateTime(
+                        context,
+                        last,
+                        DateUtils.FORMAT_SHOW_DATE
+                                | DateUtils.FORMAT_SHOW_TIME
+                                | DateUtils.FORMAT_ABBREV_MONTH);
+        long size = prefs.getLong(BareAutoBackup.KEY_LAST_SIZE, 0);
+        return size > 0
+                ? getString(
+                        R.string.bare_autobackup_last_value,
+                        when,
+                        Formatter.formatShortFileSize(context, size))
+                : when;
+    }
+
+    private void chooseRule(Context context) {
+        int[] rules = {
+            BareAutoBackup.RULE_DAILY,
+            BareAutoBackup.RULE_WEEKLY,
+            BareAutoBackup.RULE_MONTHLY,
+            BareAutoBackup.RULE_MANUAL
+        };
+        CharSequence[] labels = {
+            getString(R.string.bare_autobackup_daily),
+            getString(R.string.bare_autobackup_weekly),
+            getString(R.string.bare_autobackup_monthly),
+            getString(R.string.bare_autobackup_manual_off)
+        };
+        int current = BareAutoBackup.rule();
+        int checked = 1;
+        for (int i = 0; i < rules.length; i++) if (rules[i] == current) checked = i;
+        BareBackupDialogs.builder(context)
+                .setTitle(R.string.bare_autobackup_how_often)
+                .setSingleChoiceItems(
+                        labels,
+                        checked,
+                        (dialog, which) -> {
+                            dialog.dismiss();
+                            if (rules[which] == BareAutoBackup.RULE_MANUAL) {
+                                confirmTurnOff(context);
+                            } else {
+                                BareAutoBackup.setRule(rules[which]);
+                                render();
+                            }
+                        })
+                .setNegativeButton(android.R.string.cancel, null)
+                .show();
+    }
+
+    private void chooseKeep(Context context) {
+        int[] counts = {1, 3, 5};
+        CharSequence[] labels = {
+            getString(R.string.bare_autobackup_keep_1),
+            getString(R.string.bare_autobackup_keep_3),
+            getString(R.string.bare_autobackup_keep_5)
+        };
+        int keep = BareAutoBackup.keep();
+        BareBackupDialogs.builder(context)
+                .setTitle(R.string.bare_autobackup_keep)
+                .setSingleChoiceItems(
+                        labels,
+                        keep == 1 ? 0 : keep == 3 ? 1 : 2,
+                        (dialog, which) -> {
+                            dialog.dismiss();
+                            BareAutoBackup.setKeep(counts[which]);
+                            render();
+                        })
+                .setNegativeButton(android.R.string.cancel, null)
+                .show();
+    }
+
+    private void confirmTurnOff(Context context) {
+        BareBackupDialogs.builder(context)
+                .setTitle(R.string.bare_autobackup_turn_off)
+                .setMessage(R.string.bare_autobackup_turn_off_message)
+                .setNegativeButton(android.R.string.cancel, null)
+                .setPositiveButton(
+                        R.string.bare_autobackup_turn_off_button,
+                        (d, w) -> {
+                            BareAutoBackup.turnOff();
+                            render();
+                        })
+                .show();
+    }
+
+    /** Where Fix it leads for each failure. */
+    static void fix(Context context, String error) {
+        switch (error) {
+            case BareAutoBackup.ERROR_FOLDER_GONE, BareAutoBackup.ERROR_PERMISSION_LOST -> openSetup(
+                    context, BareAutoBackupSetupFragment.MODE_FOLDER);
+            case BareAutoBackup.ERROR_KEY_LOST -> openSetup(context, null);
+            default -> BareAutoBackupSetupFragment.backUpNow(context);
+        }
+    }
+
+    static void openSetup(Context context, @Nullable String mode) {
+        BareAutoBackupSetupFragment.open(context, mode);
+    }
+
+    private Preference row(PreferenceScreen screen, int title, @Nullable String summary) {
+        Preference row = new Preference(getContext());
+        row.setTitle(title);
+        if (summary != null) row.setSummary(summary);
+        screen.addPreference(row);
+        return row;
+    }
+
+    private void message(PreferenceScreen screen, String text) {
+        TextMessagePreference message = new TextMessagePreference(getContext(), null);
+        message.setSummary(text);
+        screen.addPreference(message);
+    }
+
+    private void button(PreferenceScreen screen, int title, Runnable action) {
+        BareBackupButtonPreference button = new BareBackupButtonPreference(getContext());
+        button.setTitle(title);
+        button.setOnClick(action);
+        screen.addPreference(button);
+    }
+
+    @Override
+    public MonotonicObservableSupplier<String> getPageTitle() {
+        return mPageTitle;
+    }
+
+    @Override
+    public @AnimationType int getAnimationType() {
+        return AnimationType.PROPERTY;
+    }

+/**
+ * The passphrase for a full backup: the 30-digit number Bare made, taken with "I saved it", or a
+ * passphrase of the user's own with a strength meter. Automatic backup setup and Create backup
+ * both use it. The dialog's window is left out of screenshots and the Recents thumbnail.
+ */
+final class BareBackupPassphraseStep {
+    /** What the person settled on. */
+    interface Result {
+        /** {@code secret} is the grouped number or the passphrase as typed, in UTF-8. */
+        void onChosen(byte[] secret, boolean isCode);
+    }
+
+    private static final long CLEAR_CLIPBOARD_MS = 60_000;
+    private static final int WEAK = 0;
+    private static final int STRONG = 2;
+
+    private final Context mContext;
+    private final String mCode;
+    private final Result mResult;
+    private final LinearLayout mBody;
+    private AlertDialog mDialog;
+
+    private BareBackupPassphraseStep(Context context, String code, Result result) {
+        mContext = context;
+        mCode = code;
+        mResult = result;
+        mBody = BareBackupDialogs.padded(context);
+    }
+
+    /**
+     * Shows the step for {@code code}, a number from {@link BareBackupBridge#generateRecoveryCode}.
+     * {@code cancelled} runs if the person backs out.
+     */
+    static AlertDialog show(Context context, String code, Result result, Runnable cancelled) {
+        BareBackupPassphraseStep step = new BareBackupPassphraseStep(context, code, result);
+        ScrollView scroll = new ScrollView(context);
+        scroll.addView(step.mBody);
+        step.mDialog =
+                BareBackupDialogs.builder(context)
+                        .setTitle(R.string.bare_autobackup_step3_title)
+                        .setView(scroll)
+                        .setCancelable(false)
+                        .setNegativeButton(android.R.string.cancel, (d, w) -> cancelled.run())
+                        .create();
+        step.showNumber();
+        return BareBackupDialogs.showSecure(step.mDialog);
+    }
+
+    private void showNumber() {
+        mBody.removeAllViews();
+        String[] groups = mCode.split("-");
+        TextView number = new TextView(mContext);
+        number.setText(
+                String.join("  ", Arrays.copyOfRange(groups, 0, 3))
+                        + "\n"
+                        + String.join("  ", Arrays.copyOfRange(groups, 3, groups.length)));
+        number.setTypeface(Typeface.MONOSPACE, Typeface.BOLD);
+        number.setTextSize(TypedValue.COMPLEX_UNIT_SP, 24);
+        number.setGravity(Gravity.CENTER);
+        number.setTextIsSelectable(true);
+        number.setContentDescription(String.join(" ", mCode.replace("-", "").split("")));
+        mBody.addView(number);
+        mBody.addView(text(R.string.bare_autobackup_code_message));
+        mBody.addView(text(R.string.bare_autobackup_code_warning));
+
+        Button copy = textButton(R.string.bare_autobackup_copy);
+        copy.setOnClickListener(v -> copy());
+        mBody.addView(copy);
+        Button saved = new Button(mContext);
+        saved.setText(R.string.bare_autobackup_saved_it);
+        saved.setAllCaps(false);
+        saved.setOnClickListener(
+                v -> {
+                    mDialog.dismiss();
+                    mResult.onChosen(mCode.getBytes(StandardCharsets.UTF_8), true);
+                });
+        mBody.addView(saved);
+        Button own = textButton(R.string.bare_autobackup_choose_own);
+        own.setOnClickListener(v -> showOwn());
+        mBody.addView(own);
+    }
+
+    private void showOwn() {
+        mBody.removeAllViews();
+        EditText first = field(R.string.bare_autobackup_own_hint);
+        EditText second = field(R.string.bare_autobackup_own_again);
+        CheckBox show = new CheckBox(mContext);
+        show.setText(R.string.bare_autobackup_show);
+        ProgressBar meter =
+                new ProgressBar(mContext, null, android.R.attr.progressBarStyleHorizontal);
+        meter.setMax(100);
+        TextView rating = text(R.string.bare_autobackup_meter_weak);
+        TextView mismatch = text(R.string.bare_autobackup_mismatch);
+        mismatch.setVisibility(View.GONE);
+        Button next = new Button(mContext);
+        next.setText(R.string.bare_autobackup_continue);
+        next.setAllCaps(false);
+        next.setEnabled(false);
+        Button number = textButton(R.string.bare_autobackup_use_number);
+        number.setOnClickListener(
+                v -> {
+                    first.getText().clear();
+                    second.getText().clear();
+                    showNumber();
+                });
+
+        TextWatcher watcher =
+                new TextWatcher() {
+                    @Override
+                    public void beforeTextChanged(CharSequence s, int a, int b, int c) {}
+
+                    @Override
+                    public void onTextChanged(CharSequence s, int a, int b, int c) {}
+
+                    @Override
+                    public void afterTextChanged(Editable s) {
+                        byte[] one = bytesOf(first.getText());
+                        int bits = BareBackupBridge.passphraseBits(one);
+                        int strength = BareBackupBridge.ratePassphrase(one);
+                        Arrays.fill(one, (byte) 0);
+                        meter.setProgress(Math.min(100, bits));
+                        int color =
+                                strength == WEAK
+                                        ? Color.rgb(0xD9, 0x30, 0x25)
+                                        : strength == STRONG
+                                                ? Color.rgb(0x1E, 0x8E, 0x3E)
+                                                : Color.rgb(0xE3, 0x74, 0x00);
+                        meter.setProgressTintList(ColorStateList.valueOf(color));
+                        rating.setText(
+                                strength == WEAK
+                                        ? R.string.bare_autobackup_meter_weak
+                                        : strength == STRONG
+                                                ? R.string.bare_autobackup_meter_strong
+                                                : R.string.bare_autobackup_meter_okay);
+                        boolean same = first.getText().toString().equals(second.getText().toString());
+                        mismatch.setVisibility(
+                                !same && second.getText().length() > 0 ? View.VISIBLE : View.GONE);
+                        next.setEnabled(same && strength != WEAK);
+                    }
+                };
+        first.addTextChangedListener(watcher);
+        second.addTextChangedListener(watcher);
+        show.setOnCheckedChangeListener(
+                (button, checked) -> {
+                    int type =
+                            InputType.TYPE_CLASS_TEXT
+                                    | InputType.TYPE_TEXT_FLAG_NO_SUGGESTIONS
+                                    | (checked
+                                            ? InputType.TYPE_TEXT_VARIATION_VISIBLE_PASSWORD
+                                            : InputType.TYPE_TEXT_VARIATION_PASSWORD);
+                    first.setInputType(type);
+                    second.setInputType(type);
+                });
+        next.setOnClickListener(
+                v -> {
+                    byte[] one = bytesOf(first.getText());
+                    first.getText().clear();
+                    second.getText().clear();
+                    mDialog.dismiss();
+                    mResult.onChosen(one, false);
+                });
+
+        mBody.addView(first);
+        mBody.addView(second);
+        mBody.addView(show);
+        mBody.addView(meter);
+        mBody.addView(rating);
+        mBody.addView(mismatch);
+        mBody.addView(text(R.string.bare_autobackup_code_warning));
+        mBody.addView(next);
+        mBody.addView(number);
+    }
+
+    /** Copies the number, marked sensitive so the keyboard doesn't show it, then clears it. */
+    private void copy() {
+        ClipboardManager clipboard = mContext.getSystemService(ClipboardManager.class);
+        if (clipboard == null) return;
+        ClipData clip = ClipData.newPlainText("", mCode);
+        PersistableBundle extras = new PersistableBundle();
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.TIRAMISU) {
+            extras.putBoolean(ClipDescription.EXTRA_IS_SENSITIVE, true);
+        } else {
+            extras.putBoolean("android.content.extra.IS_SENSITIVE", true);
+        }
+        clip.getDescription().setExtras(extras);
+        clipboard.setPrimaryClip(clip);
+        Toast.makeText(mContext, R.string.bare_autobackup_copied, Toast.LENGTH_SHORT).show();
+        String code = mCode;
+        new Handler(Looper.getMainLooper())
+                .postDelayed(
+                        () -> {
+                            ClipData now = clipboard.getPrimaryClip();
+                            if (now != null
+                                    && now.getItemCount() > 0
+                                    && code.contentEquals(
+                                            String.valueOf(now.getItemAt(0).getText()))) {
+                                clipboard.clearPrimaryClip();
+                            }
+                        },
+                        CLEAR_CLIPBOARD_MS);
+    }
+
+    private TextView text(int message) {
+        TextView view = new TextView(mContext);
+        view.setText(message);
+        view.setTextSize(TypedValue.COMPLEX_UNIT_SP, 15);
+        int gap = BareBackupDialogs.dp(mContext, 8);
+        view.setPadding(0, gap, 0, gap);
+        return view;
+    }
+
+    private Button textButton(int label) {
+        Button button = new Button(mContext, null, android.R.attr.borderlessButtonStyle);
+        button.setText(label);
+        button.setAllCaps(false);
+        return button;
+    }
+
+    private EditText field(int hint) {
+        return BareBackupDialogs.secretField(mContext, hint, false);
+    }
+
+    private static byte[] bytesOf(Editable text) {
+        return text.toString().getBytes(StandardCharsets.UTF_8);
+    }
+}

From 026dde57db400c4700b4b877c1cf8513aa0e6c32 Mon Sep 17 00:00:00 2001
From: Bare <git@barebrowser.org>
Date: Mon, 12 Oct 2026 22:38:08 +0000
Subject: [PATCH] Stop registering the Actor Safety Lists component

0085 left ActorSafetyLists registered with update.googleapis.com because its
purpose was not clear enough from the tree. It is now: its only consumer is
actor::SafetyListManager, the site allow and block lists of the Gemini agent,
read by the actor execution engine. 0171 keeps Glic off, so the component was
downloaded and kept up to date for nothing.

It is no longer registered. The components left are the ones listed in the
README.
---
 chrome/browser/component_updater/registration.cc | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/chrome/browser/component_updater/registration.cc b/chrome/browser/component_updater/registration.cc
index 985b66baa6d..13f6e6c60c8 100644
--- a/chrome/browser/component_updater/registration.cc
+++ b/chrome/browser/component_updater/registration.cc
@@ -34,7 +34,6 @@
 #include "chrome/common/pref_names.h"
 #include "components/autofill/core/common/autofill_payments_features.h"
 #include "components/component_updater/component_updater_service.h"
-#include "components/component_updater/installer_policies/actor_safety_lists_component_installer.h"
 #include "components/component_updater/installer_policies/history_search_strings_component_installer.h"
 #include "components/component_updater/installer_policies/safety_tips_component_installer.h"
 #include "components/on_device_translation/buildflags/buildflags.h"
@@ -167,7 +166,9 @@ void RegisterComponentsForUpdate() {
   //
   // HistorySearchStrings feeds HistoryEmbeddingsService, the on-device AI history
   // search, which this build does not offer.
-  RegisterActorSafetyListsComponent(cus, base::OnceClosure());
+  //
+  // ActorSafetyLists only feeds actor::SafetyListManager, the site lists of the
+  // Gemini agent, which this build keeps off.
   RegisterSSLErrorAssistantComponent(cus);
 
   RegisterIndigoComponent(cus);

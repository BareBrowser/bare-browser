@@ -72,6 +72,28 @@ public class BareUpdateCheckUnitTest {
         assertEquals(BareUpdateCheck.RELEASES_PAGE, BareUpdateCheck.releasePageFor(""));
     }
 
+    /**
+     * The alpha.2 to alpha.3 respin, which is the reason that version exists.
+     *
+     * <p>An installed alpha.2 has to read the alpha.3 tag as newer, and an installed alpha.3 has
+     * to read it as the one it is already running. Publishing the same bytes under a higher tag
+     * instead would have left the new build offering itself an update forever.
+     */
+    @Test
+    public void testAlphaThreeIsNewerThanAlphaTwoAndEqualToItself() {
+        assertTrue(BareUpdateCheck.compare("v1.0.0-alpha.3", "1.0.0-alpha.2") > 0);
+        assertEquals(0, BareUpdateCheck.compare("v1.0.0-alpha.3", "1.0.0-alpha.3"));
+        assertTrue(BareUpdateCheck.compare("v1.0.0-alpha.2", "1.0.0-alpha.3") < 0);
+    }
+
+    /** The tag grammar has to accept the tag this release will actually carry. */
+    @Test
+    public void testProductionTagIsAccepted() {
+        assertEquals(
+                "https://github.com/BareBrowser/bare-browser/releases/tag/v1.0.0-alpha.3",
+                BareUpdateCheck.releasePageFor("v1.0.0-alpha.3"));
+    }
+

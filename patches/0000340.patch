+    /**
+     * Bare: glides the page in the current tab to its top, fast at first and slowing into it, as
+     * a status bar tap does on other phones. Keeps the page's sideways position.
+     */
+    private void scrollActiveTabToTop() {
+        if (mScrollToTopAnimator != null) mScrollToTopAnimator.cancel();
+        Tab tab = mActivityTabProvider.get();
+        if (tab == null || tab.isNativePage()) return;
+        WebContents webContents = tab.getWebContents();
+        if (webContents == null) return;
+        RenderCoordinates coordinates = RenderCoordinates.fromWebContents(webContents);
+        int x = coordinates.getScrollXPixInt();
+        int from = coordinates.getScrollYPixInt();
+        if (from <= 0) return;
+        // From far down, skip to two screens above the top first: gliding past pages of
+        // content in a third of a second shows nothing but blank tiles.
+        int glide = Math.max(1, coordinates.getLastFrameViewportHeightPixInt()) * 2;
+        if (from > glide) {
+            webContents.getEventForwarder().scrollTo(x, glide);
+            from = glide;
+        }
+        float density = mActivity.getResources().getDisplayMetrics().density;
+        // About a third of a second, a little longer for a long way, never slow.
+        long duration = Math.min(450, 250 + Math.round(from / density / 40f));
+        ValueAnimator animator = ValueAnimator.ofInt(from, 0);
+        animator.setDuration(duration);
+        animator.setInterpolator(Interpolators.EMPHASIZED_DECELERATE);
+        animator.addUpdateListener(
+                animation -> {
+                    // The tab changed or went away while it was moving.
+                    if (mActivityTabProvider.get() != tab || tab.getWebContents() != webContents) {
+                        animation.cancel();
+                        return;
+                    }
+                    webContents
+                            .getEventForwarder()
+                            .scrollTo(x, (int) animation.getAnimatedValue());
+                });
+        mScrollToTopAnimator = animator;
+        animator.start();
+    }

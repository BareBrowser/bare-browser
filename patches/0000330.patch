+import androidx.preference.PreferenceViewHolder;
+
+import org.chromium.base.Callback;
+import org.chromium.chrome.R;
+
+/** The two option cards on the create page: Setup only, and Everything. */
+public class BareBackupKindPreference extends Preference {
+    private boolean mEverything;
+    private Callback<Boolean> mOnChange;
+
+    public BareBackupKindPreference(Context context, AttributeSet attrs) {
+        super(context, attrs);
+        setLayoutResource(R.layout.bare_backup_kind);
+        setSelectable(false);
+    }
+
+    void setOnChange(Callback<Boolean> onChange) {
+        mOnChange = onChange;
+    }
+
+    boolean isEverything() {
+        return mEverything;
+    }
+
+    @Override
+    public void onBindViewHolder(PreferenceViewHolder holder) {
+        super.onBindViewHolder(holder);
+        View setup = holder.findViewById(R.id.bare_backup_kind_setup);
+        View everything = holder.findViewById(R.id.bare_backup_kind_everything);
+        RadioButton setupRadio = (RadioButton) holder.findViewById(R.id.bare_backup_kind_setup_radio);
+        RadioButton everythingRadio =
+                (RadioButton) holder.findViewById(R.id.bare_backup_kind_everything_radio);
+        setupRadio.setChecked(!mEverything);
+        everythingRadio.setChecked(mEverything);
+        setup.setOnClickListener(v -> choose(false));
+        everything.setOnClickListener(v -> choose(true));
+        setupRadio.setOnClickListener(v -> choose(false));
+        everythingRadio.setOnClickListener(v -> choose(true));
+    }
+
+    private void choose(boolean everything) {
+        if (mEverything == everything) {
+            notifyChanged();
+            return;
+        }
+        mEverything = everything;
+        notifyChanged();
+        if (mOnChange != null) mOnChange.onResult(everything);
+    }
+}
diff --git a/chrome/android/java/src/org/chromium/chrome/browser/bare/backup/BareBackupRestoreFragment.java b/chrome/android/java/src/org/chromium/chrome/browser/bare/backup/BareBackupRestoreFragment.java

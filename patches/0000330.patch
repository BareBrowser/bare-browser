+// "2026-11-03T21:14:00Z".
+std::string UtcTimestamp(base::Time time) {
+  base::Time::Exploded utc;
+  time.UTCExplode(&utc);
+  return base::StringPrintf("%04d-%02d-%02dT%02d:%02d:%02dZ", utc.year,
+                            utc.month, utc.day_of_month, utc.hour, utc.minute,
+                            utc.second);
+}
+
+std::string ToJson(const base::Value& value) {
+  return base::WriteJson(value).value_or("{}");
+}
+
+// The bytes scrypt sees: the grouped form of a recovery code, or the user's
+// own passphrase exactly as typed.
+std::vector<uint8_t> SecretBytes(std::vector<uint8_t> typed, bool is_code) {
+  if (!is_code) {
+    return typed;
+  }
+  std::optional<std::string> code =
+      NormalizeRecoveryCode(base::as_string_view(typed));
+  WipeSecret(typed);
+  if (!code) {
+    return {};
+  }
+  std::vector<uint8_t> bytes(code->begin(), code->end());
+  OPENSSL_cleanse(code->data(), code->size());
+  return bytes;
+}
+
+const char* ReadErrorName(ReadError error) {
+  switch (error) {
+    case ReadError::kNotBare:
+      return "not_bare";
+    case ReadError::kNewerVersion:
+      return "newer";
+    case ReadError::kBadHeader:
+    case ReadError::kDamaged:
+      return "damaged";
+    case ReadError::kTooLarge:
+      return "too_large";
+    case ReadError::kWrongCodeOrDamaged:
+      return "wrong_code";
+  }
+}
+
+const char* ContentsErrorName(ContentsError error) {
+  return error == ContentsError::kNewerSchema ? "newer" : "damaged";
+}
+
+base::DictValue DescriptionJson(const ParsedFile& file) {
+  base::DictValue json;
+  json.Set("ok", true);
+  json.Set("kind", file.kind == Kind::kFull ? "full" : "setup");
+  json.Set("created", file.description.created);
+  json.Set("bare_version", file.description.bare_version);
+  json.Set("device_label", file.description.device_label);
+  json.Set("secret", file.description.secret);
+  base::DictValue contents;
+  for (const auto& [name, count] : file.description.contents) {
+    contents.Set(name, count);
+  }
+  json.Set("contents", std::move(contents));
+  return json;
+}
+
+base::DictValue ErrorJson(const char* error) {
+  base::DictValue json;
+  json.Set("ok", false);
+  json.Set("error", error);
+  return json;
+}

+// Matches the type numbers BareBackupBridge.java uses.
+int TypeToJava(SettingType type) {
+  switch (type) {
+    case SettingType::kBool:
+      return 0;
+    case SettingType::kInt:
+      return 1;
+    case SettingType::kString:
+      return 2;
+    case SettingType::kStringSet:
+      return 3;
+    default:
+      return -1;
+  }
+}
+
+// The app's SharedPreferences, through Java.
+class JavaAndroidPrefs : public AndroidPrefs {
+ public:
+  std::optional<base::Value> Get(const std::string& key,
+                                 SettingType type) const override {
+    const int java_type = TypeToJava(type);
+    if (java_type < 0) {
+      return std::nullopt;
+    }
+    JNIEnv* env = AttachCurrentThread();
+    if (!Java_BareBackupBridge_hasPref(env, key)) {
+      return std::nullopt;
+    }
+    const std::optional<std::string> text =
+        Java_BareBackupBridge_readPref(env, key, java_type);
+    switch (type) {
+      case SettingType::kBool:
+        return base::Value(*text == "true");
+      case SettingType::kInt: {
+        int value = 0;
+        if (!base::StringToInt(*text, &value)) {
+          return std::nullopt;
+        }
+        return base::Value(value);
+      }
+      case SettingType::kStringSet: {
+        std::optional<base::Value> list = base::JSONReader::Read(*text, 0);
+        if (!list || !list->is_list()) {
+          return std::nullopt;
+        }
+        return list;
+      }
+      default:
+        return base::Value(*text);
+    }
+  }
+
+  void Set(const std::string& key, const base::Value& value) override {
+    JNIEnv* env = AttachCurrentThread();
+    std::string text;
+    int java_type = 2;
+    if (value.is_bool()) {
+      java_type = 0;
+      text = value.GetBool() ? "true" : "false";
+    } else if (value.is_int()) {
+      java_type = 1;
+      text = base::NumberToString(value.GetInt());
+    } else if (value.is_list()) {
+      java_type = 3;
+      text = base::WriteJson(value).value_or("[]");
+    } else if (value.is_string()) {
+      text = value.GetString();
+    } else {
+      return;
+    }
+    Java_BareBackupBridge_writePref(env, key, java_type, text);
+    changed_.push_back(key);
+  }
+
+  void Remove(const std::string& key) override {
+    Java_BareBackupBridge_removePref(AttachCurrentThread(), key);
+    changed_.push_back(key);
+  }
+
+  const std::vector<std::string>& changed() const { return changed_; }
+
+ private:
+  std::vector<std::string> changed_;
+};

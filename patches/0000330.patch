+static std::string JNI_BareBackupBridge_Describe(JNIEnv* env, jlong handle) {
+  auto* backup = reinterpret_cast<bare_backup::OpenedBackup*>(handle);
+  auto parsed = backup->Parse();
+  base::DictValue json =
+      parsed.has_value()
+          ? bare_backup::DescriptionJson(*parsed)
+          : bare_backup::ErrorJson(bare_backup::ReadErrorName(parsed.error()));
+  return bare_backup::ToJson(base::Value(std::move(json)));
+}
+
+static void JNI_BareBackupBridge_Open(JNIEnv* env,
+                                      jlong handle,
+                                      const JavaRef<jobject>& jprofile,
+                                      std::vector<uint8_t> secret,
+                                      jboolean secret_is_code,
+                                      const JavaRef<jobject>& jcallback) {
+  auto* backup = reinterpret_cast<bare_backup::OpenedBackup*>(handle);
+  Profile* profile = Profile::FromJavaObject(jprofile);
+  ScopedJavaGlobalRef<jobject> callback(jcallback);
+  if (!profile) {
+    return;
+  }
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_BLOCKING},
+      base::BindOnce(&bare_backup::OpenOffThread, backup->file(),
+                     bare_backup::SecretBytes(std::move(secret),
+                                              secret_is_code)),
+      base::BindOnce(&bare_backup::OnOpened, backup->GetWeakPtr(),
+                     profile->GetWeakPtr(), std::move(callback)));
+}
+
+static void JNI_BareBackupBridge_Restore(
+    JNIEnv* env,
+    jlong handle,
+    const JavaRef<jobject>& jprofile,
+    jboolean settings,
+    jboolean search_engines,
+    jboolean site_settings,
+    jboolean bookmarks,
+    jboolean custom_dns,
+    jboolean lower_protection,
+    std::vector<std::string> approved_extensions,
+    std::u16string bookmark_folder_title,
+    const JavaRef<jobject>& jcallback) {
+  auto* backup = reinterpret_cast<bare_backup::OpenedBackup*>(handle);
+  Profile* profile = Profile::FromJavaObject(jprofile);
+  ScopedJavaGlobalRef<jobject> callback(jcallback);
+  if (!profile || !backup->opened()) {
+    Java_BareBackupBridge_onJson(env, callback, "{}");
+    return;
+  }
+  bare_backup::RestoreChoices choices;
+  choices.settings = settings;
+  choices.search_engines = search_engines;
+  choices.site_settings = site_settings;
+  choices.bookmarks = bookmarks;
+  choices.custom_dns_from_setup = custom_dns;
+  choices.lower_protection = lower_protection;
+
+  bare_backup::JavaAndroidPrefs android;
+  bare_backup::RestoreReport report = bare_backup::RestorePackage(
+      backup->package(), backup->summary(), choices,
+      bare_backup::SourcesFor(profile, &android), bookmark_folder_title);
+  base::DictValue json = bare_backup::ReportJson(report, android.changed());
+
+  bare_backup::InstallExtensions(
+      profile, backup->package(), backup->summary(), approved_extensions,
+      base::BindOnce(
+          [](ScopedJavaGlobalRef<jobject> callback, base::DictValue json,
+             bare_backup::ExtensionInstallResults results) {
+            base::DictValue extensions;
+            for (const auto& [id, error] : results) {
+              extensions.Set(id, error);
+            }
+            json.Set("extensions", std::move(extensions));
+            Java_BareBackupBridge_onJson(
+                AttachCurrentThread(), callback,
+                bare_backup::ToJson(base::Value(std::move(json))));
+          },
+          std::move(callback), std::move(json)));
+}
+
+static void JNI_BareBackupBridge_Close(JNIEnv* env, jlong handle) {
+  delete reinterpret_cast<bare_backup::OpenedBackup*>(handle);
+}

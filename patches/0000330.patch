index 00000000000..8fdfde0b444
--- /dev/null
+++ b/chrome/android/java/src/org/chromium/chrome/browser/bare/backup/BareBackupBridge.java
@@ -0,0 +1,271 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.bare.backup;
+
+import org.json.JSONArray;
+import org.json.JSONException;
+import org.jni_zero.CalledByNative;
+import org.jni_zero.JniType;
+import org.jni_zero.NativeMethods;
+
+import org.chromium.base.Callback;
+import org.chromium.base.shared_preferences.SharedPreferencesManager;
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.chrome.browser.preferences.ChromeSharedPreferences;
+import org.chromium.chrome.browser.profiles.Profile;
+
+import java.util.HashSet;
+import java.util.Set;
+
+/**
+ * Calls into the native backup code. Secrets go over as UTF-8 bytes so the caller can wipe its
+ * copy; results come back as bytes or small JSON strings.
+ */
+@NullMarked
+public final class BareBackupBridge {
+    // Must match TypeToJava() in bare_backup_bridge.cc.
+    private static final int TYPE_BOOLEAN = 0;
+    private static final int TYPE_INT = 1;
+    private static final int TYPE_STRING = 2;
+    private static final int TYPE_STRING_SET = 3;
+
+    private BareBackupBridge() {}
+
+    public static String generateRecoveryCode() {
+        return BareBackupBridgeJni.get().generateRecoveryCode();
+    }
+
+    /** The grouped code, or an empty string if {@code typed} isn't a recovery code. */
+    public static String normalizeRecoveryCode(String typed) {
+        return BareBackupBridgeJni.get().normalizeRecoveryCode(typed);
+    }
+
+    public static boolean isAcceptablePassphrase(byte[] passphrase) {
+        return BareBackupBridgeJni.get().isAcceptablePassphrase(passphrase);
+    }
+
+    /** The host of this phone's own Secure DNS server, or an empty string if it uses a built-in one. */
+    public static String customDnsHost() {
+        return BareBackupBridgeJni.get().customDnsHost();
+    }
+
+    /** Builds a backup. {@code done} gets the file's bytes, or an empty array on failure. */
+    public static void createBackup(
+            Profile profile,
+            boolean full,
+            byte[] secret,
+            boolean secretIsCode,
+            boolean includeCustomDns,
+            String deviceLabel,
+            String bareVersion,
+            int bareVersionCode,
+            Callback<byte[]> done) {
+        BareBackupBridgeJni.get()
+                .createBackup(
+                        profile,
+                        full,
+                        secret,
+                        secretIsCode,
+                        includeCustomDns,
+                        deviceLabel,
+                        bareVersion,
+                        bareVersionCode,
+                        done);
+    }
+
+    /** Opens {@code file} as a restore would, to check what was saved. */
+    public static void verifyBackup(
+            byte[] file, byte[] secret, boolean secretIsCode, Callback<Boolean> done) {
+        BareBackupBridgeJni.get().verifyBackup(file, secret, secretIsCode, done);
+    }
+
+    /** A backup being restored, held in native memory until {@link #close()}. */
+    public static final class Opened {
+        private long mHandle;
+
+        public Opened(byte[] file) {
+            mHandle = BareBackupBridgeJni.get().createOpened(file);
+        }
+
+        /** What the header says, as JSON; readable before any secret is asked for. */
+        public String describe() {
+            return BareBackupBridgeJni.get().describe(mHandle);
+        }
+
+        public void open(
+                Profile profile, byte[] secret, boolean secretIsCode, Callback<String> done) {
+            BareBackupBridgeJni.get().open(mHandle, profile, secret, secretIsCode, done);
+        }
+
+        public void restore(
+                Profile profile,
+                boolean settings,
+                boolean searchEngines,
+                boolean siteSettings,
+                boolean bookmarks,
+                boolean customDns,
+                boolean lowerProtection,
+                String[] approvedExtensions,
+                String bookmarkFolderTitle,
+                Callback<String> done) {
+            BareBackupBridgeJni.get()
+                    .restore(
+                            mHandle,
+                            profile,
+                            settings,
+                            searchEngines,
+                            siteSettings,
+                            bookmarks,
+                            customDns,
+                            lowerProtection,
+                            approvedExtensions,
+                            bookmarkFolderTitle,
+                            done);
+        }
+
+        public void close() {
+            if (mHandle != 0) {
+                BareBackupBridgeJni.get().close(mHandle);
+                mHandle = 0;
+            }
+        }
+    }
+
+    // The app's SharedPreferences, for the native allowlist.
+
+    @CalledByNative
+    private static boolean hasPref(@JniType("std::string") String key) {
+        return ChromeSharedPreferences.getInstance().contains(key);
+    }
+
+    @CalledByNative
+    private static @JniType("std::string") String readPref(
+            @JniType("std::string") String key, int type) {
+        SharedPreferencesManager prefs = ChromeSharedPreferences.getInstance();
+        try {
+            switch (type) {
+                case TYPE_BOOLEAN:
+                    return prefs.readBoolean(key, false) ? "true" : "false";
+                case TYPE_INT:
+                    return Integer.toString(prefs.readInt(key));
+                case TYPE_STRING_SET:
+                    return new JSONArray(prefs.readStringSet(key)).toString();
+                default:
+                    String value = prefs.readString(key, "");
+                    return value == null ? "" : value;
+            }
+        } catch (ClassCastException e) {
+            // Stored under another type than the list says; the native side
+            // then refuses the value.
+            return "";
+        }
+    }
+
+    @CalledByNative
+    private static void writePref(
+            @JniType("std::string") String key, int type, @JniType("std::string") String value) {
+        SharedPreferencesManager prefs = ChromeSharedPreferences.getInstance();
+        switch (type) {
+            case TYPE_BOOLEAN:
+                prefs.writeBoolean(key, "true".equals(value));
+                break;
+            case TYPE_INT:
+                prefs.writeInt(key, Integer.parseInt(value));
+                break;
+            case TYPE_STRING_SET:
+                Set<String> set = new HashSet<>();
+                try {
+                    JSONArray array = new JSONArray(value);
+                    for (int i = 0; i < array.length(); i++) set.add(array.getString(i));
+                } catch (JSONException e) {
+                    return;
+                }
+                prefs.writeStringSet(key, set);
+                break;
+            default:
+                prefs.writeString(key, value);
+        }
+    }
+
+    @CalledByNative
+    private static void removePref(@JniType("std::string") String key) {
+        ChromeSharedPreferences.getInstance().removeKey(key);
+    }
+
+    @CalledByNative
+    private static void onBytes(
+            Callback<byte[]> callback, @JniType("std::vector<uint8_t>") byte[] bytes) {
+        callback.onResult(bytes);
+    }
+
+    @CalledByNative
+    private static void onBoolean(Callback<Boolean> callback, boolean value) {
+        callback.onResult(value);
+    }
+
+    @CalledByNative
+    private static void onJson(Callback<String> callback, @JniType("std::string") String json) {
+        callback.onResult(json);
+    }
+
+    @NativeMethods
+    interface Natives {
+        @JniType("std::string")
+        String generateRecoveryCode();
+
+        @JniType("std::string")
+        String normalizeRecoveryCode(@JniType("std::string") String typed);
+
+        boolean isAcceptablePassphrase(@JniType("std::vector<uint8_t>") byte[] passphrase);
+
+        @JniType("std::string")
+        String customDnsHost();
+
+        void createBackup(
+                Profile profile,
+                boolean full,
+                @JniType("std::vector<uint8_t>") byte[] secret,
+                boolean secretIsCode,
+                boolean includeCustomDns,
+                @JniType("std::string") String deviceLabel,
+                @JniType("std::string") String bareVersion,
+                int bareVersionCode,
+                Callback<byte[]> done);
+
+        void verifyBackup(
+                @JniType("std::vector<uint8_t>") byte[] file,
+                @JniType("std::vector<uint8_t>") byte[] secret,
+                boolean secretIsCode,
+                Callback<Boolean> done);
+
+        long createOpened(@JniType("std::vector<uint8_t>") byte[] file);
+
+        @JniType("std::string")
+        String describe(long handle);
+
+        void open(
+                long handle,
+                Profile profile,
+                @JniType("std::vector<uint8_t>") byte[] secret,
+                boolean secretIsCode,
+                Callback<String> done);
+
+        void restore(
+                long handle,
+                Profile profile,
+                boolean settings,
+                boolean searchEngines,
+                boolean siteSettings,
+                boolean bookmarks,
+                boolean customDns,
+                boolean lowerProtection,
+                @JniType("std::vector<std::string>") String[] approvedExtensions,
+                @JniType("std::u16string") String bookmarkFolderTitle,
+                Callback<String> done);
+
+        void close(long handle);
+    }
+}

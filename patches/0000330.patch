+      local_state ? local_state->Find("dns_over_https.templates") : nullptr;
+  if (!templates || !templates->is_string() ||
+      BuiltInDohTemplates(*templates) || !DohTemplates(*templates)) {
+    return std::nullopt;
+  }
+  return TemplateHost(templates->GetString());
+}

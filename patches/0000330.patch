+Sources SourcesFor(Profile* profile, AndroidPrefs* android) {
+  Sources sources;
+  sources.settings.android = android;
+  sources.settings.profile = profile->GetPrefs();
+  sources.settings.local_state = g_browser_process->local_state();
+  sources.site_settings = HostContentSettingsMapFactory::GetForProfile(profile);
+  sources.search_engines = TemplateURLServiceFactory::GetForProfile(profile);
+  sources.bookmarks = BookmarkModelFactory::GetForBrowserContext(profile);
+  sources.reading_list = ReadingListModelFactory::GetForBrowserContext(profile);
+  return sources;
+}

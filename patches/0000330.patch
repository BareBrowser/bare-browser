@@ -0,0 +1,335 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.bare.backup;
+
+import android.app.AlertDialog;
+import android.content.Context;
+import android.graphics.Typeface;
+import android.net.Uri;
+import android.os.Bundle;
+import android.text.Editable;
+import android.util.TypedValue;
+import android.widget.EditText;
+import android.widget.LinearLayout;
+import android.widget.TextView;
+import android.widget.Toast;
+
+import androidx.activity.result.ActivityResultLauncher;
+import androidx.activity.result.contract.ActivityResultContracts;
+
+import org.chromium.base.supplier.MonotonicObservableSupplier;
+import org.chromium.base.supplier.ObservableSuppliers;
+import org.chromium.base.supplier.SettableMonotonicObservableSupplier;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.chrome.R;
+import org.chromium.chrome.browser.settings.ChromeBaseSettingsFragment;
+import org.chromium.components.browser_ui.settings.ChromeSwitchPreference;
+import org.chromium.components.browser_ui.settings.SettingsUtils;
+import org.chromium.components.browser_ui.settings.TextMessagePreference;
+
+import java.nio.charset.StandardCharsets;
+import java.util.Arrays;
+
+/** Settings > Backup and transfer > Create backup. */
+public class BareBackupCreateFragment extends ChromeBaseSettingsFragment {
+    private final SettableMonotonicObservableSupplier<String> mPageTitle =
+            ObservableSuppliers.createMonotonic();
+    private ActivityResultLauncher<String> mCreateDocument;
+    private BareScreenLock mScreenLock;
+
+    private BareBackupKindPreference mKind;
+    private ChromeSwitchPreference mOwnPassphrase;
+    private ChromeSwitchPreference mIncludeDns;
+    private TextMessagePreference mNoLock;
+    private String mCustomDnsHost = "";
+
+    // The secret for the backup in progress, wiped when it is done.
+    private byte @Nullable [] mSecret;
+    private boolean mSecretIsCode;
+    private boolean mFull;
+
+    @Override
+    public void onCreate(@Nullable Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+        mCreateDocument =
+                registerForActivityResult(
+                        new ActivityResultContracts.CreateDocument("application/octet-stream"),
+                        this::onDocumentChosen);
+        mScreenLock = new BareScreenLock(this);
+    }
+
+    @Override
+    public void onCreatePreferences(@Nullable Bundle savedInstanceState, @Nullable String rootKey) {
+        mPageTitle.set(getContext().getString(R.string.bare_backup_create));
+        SettingsUtils.addPreferencesFromResource(this, R.xml.bare_backup_create_preferences);
+        mKind = findPreference("bare_backup_kind");
+        mOwnPassphrase = findPreference("bare_backup_own_passphrase");
+        mIncludeDns = findPreference("bare_backup_include_dns");
+        mNoLock = findPreference("bare_backup_no_lock");
+        BareBackupButtonPreference save = findPreference("bare_backup_save");
+
+        mCustomDnsHost = BareBackupBridge.customDnsHost();
+        mIncludeDns.setSummary(mCustomDnsHost);
+        mIncludeDns.setChecked(false);
+        mOwnPassphrase.setChecked(false);
+        mKind.setOnChange(everything -> updateRows());
+        save.setOnClick(this::start);
+        updateRows();
+    }
+
+    private void updateRows() {
+        boolean everything = mKind.isEverything();
+        mOwnPassphrase.setVisible(everything);
+        mIncludeDns.setVisible(!everything && !mCustomDnsHost.isEmpty());
+        mNoLock.setVisible(everything && !BareScreenLock.isSet(getContext()));
+    }
+
+    private void start() {
+        mFull = mKind.isEverything();
+        if (!mFull) {
+            mSecret = null;
+            chooseFile();
+            return;
+        }
+        if (!BareScreenLock.isSet(getContext())) {
+            askForSecret();
+            return;
+        }
+        mScreenLock.confirm(
+                ok -> {
+                    if (ok && getContext() != null) askForSecret();
+                });
+    }
+
+    private void askForSecret() {
+        if (mOwnPassphrase.isChecked()) {
+            askForPassphrase();
+        } else {
+            showRecoveryCode(BareBackupBridge.generateRecoveryCode());
+        }
+    }
+
+    // The recovery code: shown once, then typed back.
+
+    private void showRecoveryCode(String code) {
+        Context context = getContext();
+        TextView codeView = new TextView(context);
+        codeView.setText(code);
+        codeView.setTextIsSelectable(true);
+        codeView.setTypeface(Typeface.MONOSPACE, Typeface.BOLD);
+        codeView.setTextSize(TypedValue.COMPLEX_UNIT_SP, 20);
+        LinearLayout layout = BareBackupDialogs.padded(context);
+        layout.addView(codeView);
+        BareBackupDialogs.showSecure(
+                BareBackupDialogs.builder(context)
+                .setTitle(R.string.bare_backup_code_title)
+                .setMessage(R.string.bare_backup_code_message)
+                .setView(layout)
+                .setCancelable(false)
+                .setNegativeButton(android.R.string.cancel, null)
+                .setPositiveButton(R.string.bare_backup_code_saved, (d, w) -> confirmRecoveryCode(code))
+                .create());
+    }
+
+    private void confirmRecoveryCode(String code) {
+        Context context = getContext();
+        EditText field = BareBackupDialogs.secretField(context, R.string.bare_backup_code_title, true);
+        LinearLayout layout = BareBackupDialogs.padded(context);
+        layout.addView(field);
+        AlertDialog dialog =
+                BareBackupDialogs.builder(context)
+                        .setTitle(R.string.bare_backup_code_confirm_title)
+                        .setMessage(R.string.bare_backup_code_confirm_message)
+                        .setView(layout)
+                        .setNegativeButton(
+                                android.R.string.cancel, (d, w) -> showRecoveryCode(code))
+                        .setPositiveButton(android.R.string.ok, null)
+                        .create();
+        dialog.setOnShowListener(
+                d ->
+                        dialog.getButton(AlertDialog.BUTTON_POSITIVE)
+                                .setOnClickListener(
+                                        v -> {
+                                            String typed =
+                                                    BareBackupBridge.normalizeRecoveryCode(
+                                                            field.getText().toString());
+                                            if (!code.equals(typed)) {
+                                                field.setError(
+                                                        context.getString(
+                                                                R.string
+                                                                        .bare_backup_code_mismatch));
+                                                return;
+                                            }
+                                            clear(field);
+                                            dialog.dismiss();
+                                            mSecret = code.getBytes(StandardCharsets.UTF_8);
+                                            mSecretIsCode = true;
+                                            chooseFile();
+                                        }));
+        BareBackupDialogs.showSecure(dialog);
+    }
+
+    // The user's own passphrase: typed twice.
+
+    private void askForPassphrase() {
+        Context context = getContext();
+        EditText first =
+                BareBackupDialogs.secretField(context, R.string.bare_backup_passphrase_hint, false);
+        EditText second =
+                BareBackupDialogs.secretField(context, R.string.bare_backup_passphrase_again, false);
+        LinearLayout layout = BareBackupDialogs.padded(context);
+        layout.addView(first);
+        layout.addView(second);
+        AlertDialog dialog =
+                BareBackupDialogs.builder(context)
+                        .setTitle(R.string.bare_backup_passphrase_title)
+                        .setView(layout)
+                        .setNegativeButton(android.R.string.cancel, null)
+                        .setPositiveButton(android.R.string.ok, null)
+                        .create();
+        dialog.setOnShowListener(
+                d ->
+                        dialog.getButton(AlertDialog.BUTTON_POSITIVE)
+                                .setOnClickListener(
+                                        v -> {
+                                            byte[] one = bytesOf(first.getText());
+                                            byte[] two = bytesOf(second.getText());
+                                            boolean same = Arrays.equals(one, two);
+                                            Arrays.fill(two, (byte) 0);
+                                            if (!BareBackupBridge.isAcceptablePassphrase(one)) {
+                                                Arrays.fill(one, (byte) 0);
+                                                first.setError(
+                                                        context.getString(
+                                                                R.string
+                                                                        .bare_backup_passphrase_short));
+                                                return;
+                                            }
+                                            if (!same) {
+                                                Arrays.fill(one, (byte) 0);
+                                                second.setError(
+                                                        context.getString(
+                                                                R.string
+                                                                        .bare_backup_passphrase_mismatch));
+                                                return;
+                                            }
+                                            clear(first);
+                                            clear(second);
+                                            dialog.dismiss();
+                                            mSecret = one;
+                                            mSecretIsCode = false;
+                                            chooseFile();
+                                        }));
+        BareBackupDialogs.showSecure(dialog);
+    }
+
+    // Saving.
+
+    private void chooseFile() {
+        int name = mFull ? R.string.bare_backup_file_full : R.string.bare_backup_file_setup;
+        mCreateDocument.launch(getContext().getString(name, BareBackupIo.today()));
+    }
+
+    private void onDocumentChosen(@Nullable Uri uri) {
+        Context context = getContext();
+        if (uri == null || context == null) {
+            wipeSecret();
+            return;
+        }
+        AlertDialog progress = BareBackupDialogs.progress(context, R.string.bare_backup_working);
+        byte[] secret = mSecret == null ? new byte[0] : mSecret;
+        BareBackupBridge.createBackup(
+                getProfile(),
+                mFull,
+                secret,
+                mSecretIsCode,
+                !mFull && mIncludeDns.isVisible() && mIncludeDns.isChecked(),
+                BareBackupIo.deviceLabel(),
+                BareBackupIo.bareVersion(context),
+                BareBackupIo.bareVersionCode(context),
+                bytes -> {
+                    if (bytes == null || bytes.length == 0) {
+                        finish(progress, R.string.bare_backup_save_failed);
+                        return;
+                    }
+                    BareBackupIo.write(
+                            context,
+                            uri,
+                            bytes,
+                            written -> {
+                                if (!written) {
+                                    finish(progress, R.string.bare_backup_save_failed);
+                                    return;
+                                }
+                                checkSaved(context, uri, progress);
+                            });
+                });
+    }
+
+    // Reads the file back from where it was saved and opens it as a restore would.
+    private void checkSaved(Context context, Uri uri, AlertDialog progress) {
+        BareBackupIo.read(
+                context,
+                uri,
+                saved -> {
+                    if (saved == null) {
+                        finish(progress, R.string.bare_backup_check_failed);
+                        return;
+                    }
+                    byte[] secret = mSecret == null ? new byte[0] : mSecret;
+                    BareBackupBridge.verifyBackup(
+                            saved,
+                            secret,
+                            mSecretIsCode,
+                            ok ->
+                                    finish(
+                                            progress,
+                                            ok
+                                                    ? R.string.bare_backup_saved
+                                                    : R.string.bare_backup_check_failed));
+                });
+    }
+
+    private void finish(AlertDialog progress, int message) {
+        wipeSecret();
+        progress.dismiss();
+        Context context = getContext();
+        if (context == null) return;
+        if (message == R.string.bare_backup_saved) {
+            Toast.makeText(context, message, Toast.LENGTH_SHORT).show();
+        } else {
+            BareBackupDialogs.message(context, message);
+        }
+    }
+
+    private void wipeSecret() {
+        if (mSecret != null) Arrays.fill(mSecret, (byte) 0);
+        mSecret = null;
+    }
+
+    private static byte[] bytesOf(Editable text) {
+        return text.toString().getBytes(StandardCharsets.UTF_8);
+    }
+
+    // Best effort: Android keeps its own copies of what was typed.
+    private static void clear(EditText field) {
+        field.getText().clear();
+    }
+
+    @Override
+    public void onDestroy() {
+        wipeSecret();
+        super.onDestroy();
+    }
+
+    @Override
+    public MonotonicObservableSupplier<String> getPageTitle() {
+        return mPageTitle;
+    }
+
+    @Override
+    public @AnimationType int getAnimationType() {
+        return AnimationType.PROPERTY;
+    }
+}

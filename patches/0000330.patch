+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.bare.backup;
+
+import android.app.Activity;
+import android.app.AlertDialog;
+import android.content.Context;
+import android.net.Uri;
+import android.os.Bundle;
+import android.widget.EditText;
+import android.widget.LinearLayout;
+
+import androidx.preference.Preference;
+import androidx.preference.PreferenceCategory;
+import androidx.preference.PreferenceScreen;
+
+import org.chromium.base.supplier.MonotonicObservableSupplier;
+import org.chromium.base.supplier.ObservableSuppliers;
+import org.chromium.base.supplier.SettableMonotonicObservableSupplier;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.chrome.R;
+import org.chromium.chrome.browser.bare.BareLauncherIcon;
+import org.chromium.chrome.browser.bare.BareWelcomeOverlay;
+import org.chromium.chrome.browser.homepage.HomepageManager;
+import org.chromium.chrome.browser.lifetime.ApplicationLifetime;
+import org.chromium.chrome.browser.preferences.ChromeSharedPreferences;
+import org.chromium.chrome.browser.search_engines.TemplateUrlServiceFactory;
+import org.chromium.chrome.browser.settings.ChromeBaseSettingsFragment;
+import org.chromium.chrome.browser.settings.SettingsNavigationFactory;
+import org.chromium.components.browser_ui.settings.ChromeSwitchPreference;
+import org.chromium.components.browser_ui.settings.TextMessagePreference;
+import org.chromium.components.search_engines.TemplateUrlService;
+
+import org.json.JSONArray;
+import org.json.JSONException;
+import org.json.JSONObject;
+
+import java.nio.charset.StandardCharsets;
+import java.text.DateFormat;
+import java.text.ParseException;
+import java.text.SimpleDateFormat;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.Date;
+import java.util.HashMap;
+import java.util.Iterator;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+import java.util.TimeZone;
+
+/** Settings > Backup and transfer > Restore from backup, once a file has been picked. */
+public class BareBackupRestoreFragment extends ChromeBaseSettingsFragment {
+    // The file picked on the previous page. A page can't take an object as an argument.
+    private static BareBackupBridge.@Nullable Opened sPending;
+    private static boolean sPendingFromWelcome;
+
+    private final SettableMonotonicObservableSupplier<String> mPageTitle =
+            ObservableSuppliers.createMonotonic();
+    private BareBackupBridge.@Nullable Opened mOpened;
+    private boolean mFromWelcome;
+    private boolean mRestoring;
+    private JSONObject mHeader = new JSONObject();
+
+    private final Map<String, ChromeSwitchPreference> mSections = new HashMap<>();
+    private @Nullable ChromeSwitchPreference mCustomDns;
+    private @Nullable ChromeSwitchPreference mLowering;
+    private final Map<String, ChromeSwitchPreference> mExtensions = new HashMap<>();
+    private final Map<String, String> mExtensionNames = new HashMap<>();
+
+    private static void setPending(BareBackupBridge.Opened opened, boolean fromWelcome) {
+        if (sPending != null) sPending.close();
+        sPending = opened;
+        sPendingFromWelcome = fromWelcome;
+    }
+
+    /**
+     * Reads a picked file and opens this page for it, or says why it can't. {@code fromWelcome}
+     * when it was picked on the welcome, which the restore then completes.
+     */
+    public static void openFile(Context context, Uri uri, boolean fromWelcome) {
+        AlertDialog progress = BareBackupDialogs.progress(context, R.string.bare_backup_reading);
+        BareBackupIo.read(
+                context,
+                uri,
+                bytes -> {
+                    progress.dismiss();
+                    if (context instanceof Activity activity
+                            && (activity.isFinishing() || activity.isDestroyed())) {
+                        return;
+                    }
+                    if (bytes == null) {
+                        BareBackupDialogs.message(context, R.string.bare_backup_unreadable);
+                        return;
+                    }
+                    BareBackupBridge.Opened opened = new BareBackupBridge.Opened(bytes);
+                    try {
+                        JSONObject header = new JSONObject(opened.describe());
+                        if (!header.optBoolean("ok")) {
+                            opened.close();
+                            BareBackupDialogs.message(
+                                    context,
+                                    BareBackupDialogs.errorMessage(header.optString("error")));
+                            return;
+                        }
+                    } catch (JSONException e) {
+                        opened.close();
+                        return;
+                    }
+                    setPending(opened, fromWelcome);
+                    SettingsNavigationFactory.createSettingsNavigation()
+                            .startSettings(context, BareBackupRestoreFragment.class, null);
+                });
+    }
+
+    @Override
+    public void onCreatePreferences(@Nullable Bundle savedInstanceState, @Nullable String rootKey) {
+        mPageTitle.set(getContext().getString(R.string.bare_backup_restore));
+        mOpened = sPending;
+        mFromWelcome = sPendingFromWelcome;
+        sPending = null;
+        sPendingFromWelcome = false;
+        PreferenceScreen screen = getPreferenceManager().createPreferenceScreen(getContext());
+        setPreferenceScreen(screen);
+        if (mOpened == null) {
+            // Recreated after Android discarded the page; the file is gone with it.
+            return;
+        }
+        try {
+            mHeader = new JSONObject(mOpened.describe());
+        } catch (JSONException e) {
+            return;
+        }
+        showHeader();
+        if ("full".equals(mHeader.optString("kind"))) {
+            BareBackupButtonPreference enter = new BareBackupButtonPreference(getContext());
+            enter.setKey("enter");
+            enter.setTitle(
+                    "passphrase".equals(mHeader.optString("secret"))
+                            ? R.string.bare_backup_enter_passphrase
+                            : R.string.bare_backup_enter_code);
+            enter.setOnClick(this::askForSecret);
+            screen.addPreference(enter);
+        } else {
+            open(new byte[0], false);
+        }
+    }
+
+    private void showHeader() {
+        Context context = getContext();
+        PreferenceScreen screen = getPreferenceScreen();
+        TextMessagePreference about = new TextMessagePreference(context, null);
+        about.setTitle(
+                "full".equals(mHeader.optString("kind"))
+                        ? R.string.bare_backup_kind_full
+                        : R.string.bare_backup_kind_setup);
+        StringBuilder summary =
+                new StringBuilder(
+                        context.getString(
+                                R.string.bare_backup_made,
+                                localDate(mHeader.optString("created")),
+                                mHeader.optString("bare_version"),
+                                mHeader.optString("device_label")));
+        JSONObject contents = mHeader.optJSONObject("contents");
+        if (contents != null) {
+            List<String> parts = new ArrayList<>();
+            addCount(context, parts, contents, "settings", R.string.bare_backup_section_settings);
+            addCount(context, parts, contents, "bookmarks", R.string.bare_backup_section_bookmarks);
+            addCount(context, parts, contents, "site_settings", R.string.bare_backup_section_site_settings);
+            addCount(context, parts, contents, "extensions", R.string.bare_backup_extensions);
+            if (!parts.isEmpty()) summary.append("\n").append(String.join(" · ", parts));
+        }
+        about.setSummary(summary.toString());
+        screen.addPreference(about);
+    }
+
+    // The header has UTC; the user wants the day it was where they are.
+    private static String localDate(String created) {
+        SimpleDateFormat utc = new SimpleDateFormat("yyyy-MM-dd'T'HH:mm:ss'Z'", Locale.US);
+        utc.setTimeZone(TimeZone.getTimeZone("UTC"));
+        try {
+            Date date = utc.parse(created);
+            if (date != null) return DateFormat.getDateInstance(DateFormat.MEDIUM).format(date);
+        } catch (ParseException e) {
+            // Shown as written below.
+        }
+        return created;
+    }
+
+    private static void addCount(
+            Context context, List<String> parts, JSONObject contents, String key, int label) {
+        if (contents.has(key)) parts.add(context.getString(label) + ": " + contents.optInt(key));
+    }
+
+    private void askForSecret() {
+        Context context = getContext();
+        boolean passphrase = "passphrase".equals(mHeader.optString("secret"));
+        EditText field =
+                BareBackupDialogs.secretField(
+                        context,
+                        passphrase
+                                ? R.string.bare_backup_enter_passphrase
+                                : R.string.bare_backup_enter_code,
+                        !passphrase);
+        LinearLayout layout = BareBackupDialogs.padded(context);
+        layout.addView(field);
+        BareBackupDialogs.showSecure(
+                BareBackupDialogs.builder(context)
+                .setTitle(
+                        passphrase
+                                ? R.string.bare_backup_enter_passphrase
+                                : R.string.bare_backup_enter_code)
+                .setView(layout)
+                .setNegativeButton(android.R.string.cancel, null)
+                .setPositiveButton(
+                        R.string.bare_backup_open,
+                        (d, w) -> {
+                            String typed = field.getText().toString();
+                            field.getText().clear();
+                            // A file that doesn't say is taken as a code when it reads as one.
+                            boolean isCode =
+                                    !passphrase
+                                            && !BareBackupBridge.normalizeRecoveryCode(typed)
+                                                    .isEmpty();
+                            open(typed.getBytes(StandardCharsets.UTF_8), isCode);
+                        })
+                .create());
+    }
+
+    private void open(byte[] secret, boolean isCode) {
+        if (mOpened == null) return;
+        AlertDialog progress = BareBackupDialogs.progress(getContext(), R.string.bare_backup_reading);
+        mOpened.open(
+                getProfile(),
+                secret,
+                isCode,
+                json -> {
+                    Arrays.fill(secret, (byte) 0);
+                    progress.dismiss();
+                    if (getContext() == null) return;
+                    try {
+                        JSONObject result = new JSONObject(json);
+                        if (!result.optBoolean("ok")) {
+                            BareBackupDialogs.message(
+                                    getContext(),
+                                    BareBackupDialogs.errorMessage(result.optString("error")));
+                            return;
+                        }
+                        showChoices(result);
+                    } catch (JSONException e) {
+                        BareBackupDialogs.message(getContext(), R.string.bare_backup_damaged);
+                    }
+                });
+    }
+
+    private void showChoices(JSONObject result) throws JSONException {
+        Context context = getContext();
+        PreferenceScreen screen = getPreferenceScreen();
+        Preference enter = screen.findPreference("enter");
+        if (enter != null) screen.removePreference(enter);
+
+        PreferenceCategory what = new PreferenceCategory(context);
+        what.setTitle(R.string.bare_backup_what);
+        screen.addPreference(what);
+        JSONArray sections = result.getJSONArray("sections");
+        for (int i = 0; i < sections.length(); i++) {
+            String section = sections.getString(i);
+            int title;
+            int summary = 0;
+            switch (section) {
+                case "settings":
+                    title = R.string.bare_backup_section_settings;
+                    summary = R.string.bare_backup_section_settings_summary;
+                    break;
+                case "search_engines":
+                    title = R.string.bare_backup_section_search_engines;
+                    break;
+                case "site_settings":
+                    title = R.string.bare_backup_section_site_settings;
+                    break;
+                case "bookmarks":
+                    title = R.string.bare_backup_section_bookmarks;
+                    summary = R.string.bare_backup_section_bookmarks_summary;
+                    break;
+                default:
+                    continue;
+            }
+            ChromeSwitchPreference row = new ChromeSwitchPreference(context);
+            row.setPersistent(false);
+            row.setTitle(title);
+            if (summary != 0) row.setSummary(summary);
+            row.setChecked(true);
+            what.addPreference(row);
+            mSections.put(section, row);
+        }
+        String dnsHost = result.optString("custom_dns_host");
+        if (!dnsHost.isEmpty()) {
+            mCustomDns = new ChromeSwitchPreference(context);
+            mCustomDns.setPersistent(false);
+            mCustomDns.setTitle(context.getString(R.string.bare_backup_dns_from_file, dnsHost));
+            mCustomDns.setSummary(R.string.bare_backup_dns_from_file_summary);
+            mCustomDns.setChecked(false);
+            what.addPreference(mCustomDns);
+        }
+
+        // Settings in the file that would leave this phone less protected wait for their own
+        // row. In a Move, which brings everything and then erases the other phone, it is on
+        // and locked like the rest, with the same warning.
+        String lowering = loweringNames(result.optJSONArray("lowering"));
+        if (!lowering.isEmpty() && mSections.containsKey("settings")) {
+            mLowering = new ChromeSwitchPreference(context);
+            mLowering.setPersistent(false);
+            mLowering.setTitle(R.string.bare_backup_lowering);
+            mLowering.setSummary(context.getString(R.string.bare_backup_lowering_summary, lowering));
+            mLowering.setChecked(mMove != null);
+            mLowering.setEnabled(mMove == null);
+            what.addPreference(mLowering);
+        }
+
+        JSONArray extensions = result.optJSONArray("extensions");
+        if (extensions != null && extensions.length() > 0) {
+            PreferenceCategory list = new PreferenceCategory(context);
+            list.setTitle(R.string.bare_backup_extensions);
+            screen.addPreference(list);
+            Preference unverified = new Preference(context);
+            unverified.setSummary(R.string.bare_backup_ext_unverified);
+            unverified.setSelectable(false);
+            list.addPreference(unverified);
+            for (int i = 0; i < extensions.length(); i++) {
+                addExtension(list, extensions.getJSONObject(i));
+            }
+        }
+
+        BareBackupButtonPreference restore = new BareBackupButtonPreference(context);
+        restore.setTitle(R.string.bare_backup_restore_button);
+        restore.setOnClick(this::restore);
+        screen.addPreference(restore);
+    }
+
+    private void addExtension(PreferenceCategory list, JSONObject extension) {
+        Context context = getContext();
+        String id = extension.optString("id");
+        String name = extension.optString("name");
+        mExtensionNames.put(id, name);
+        if (extension.optBoolean("can_install")) {
+            ChromeSwitchPreference row = new ChromeSwitchPreference(context);
+            row.setPersistent(false);
+            row.setTitle(name);
+            JSONArray permissions = extension.optJSONArray("permissions");
+            List<String> lines = new ArrayList<>();
+            for (int i = 0; permissions != null && i < permissions.length(); i++) {
+                lines.add(permissions.optString(i));
+            }
+            row.setSummary(
+                    lines.isEmpty()
+                            ? context.getString(R.string.bare_backup_ext_permissions_none)
+                            : String.join("\n", lines));
+            row.setChecked(true);
+            list.addPreference(row);
+            mExtensions.put(id, row);
+            return;
+        }
+        Preference row = new Preference(context);
+        row.setTitle(name);
+        row.setSelectable(false);
+        String host = extension.optString("update_host");
+        if (extension.optBoolean("installed_here")) {
+            row.setSummary(R.string.bare_backup_ext_installed);
+        } else if (extension.optBoolean("unpacked")) {
+            row.setSummary(R.string.bare_backup_ext_by_hand);
+        } else if (extension.optBoolean("problem")) {
+            row.setSummary(R.string.bare_backup_ext_cant);
+        } else if (!host.isEmpty()) {
+            row.setSummary(context.getString(R.string.bare_backup_ext_get_again, host));
+        } else {
+            row.setSummary(R.string.bare_backup_ext_get_again_unknown);
+        }
+        list.addPreference(row);
+    }
+
+    // Plain names for the "store:key" labels native lists, one per kind of change.
+    private String loweringNames(@Nullable JSONArray labels) {
+        List<String> names = new ArrayList<>();
+        for (int i = 0; labels != null && i < labels.length(); i++) {
+            String label = labels.optString(i);
+            String key = label.substring(label.indexOf(':') + 1);
+            int name =
+                    switch (key) {
+                        case "Bare.Extensions.QuickCrx" -> R.string.bare_backup_lowering_quick_crx;
+                        case "Bare.Downloads.ExternalSignIn" -> R.string
+                                .bare_backup_lowering_external_sign_in;
+                        case "https_only_mode_enabled" -> R.string.bare_backup_lowering_https_only;
+                        case "profile.cookie_controls_mode" -> R.string.bare_backup_lowering_cookies;
+                        case "webrtc.ip_handling_policy" -> R.string.bare_backup_lowering_webrtc;
+                        case "dns_over_https.mode" -> R.string.bare_backup_lowering_dns;
+                        case "Chrome.Bare.BundledAdBlockerEnabled" -> R.string
+                                .bare_backup_lowering_ad_blocker;
+                        case "Chrome.Bare.BareFilterEnabled" -> R.string
+                                .bare_backup_lowering_barefilter;
+                        case "bare.ubo_auto_update" -> R.string.bare_backup_lowering_ubo_updates;
+                        case "Bare.Incognito.BiometricOnly",
+                                "Bare.Incognito.BlockScreenshots",
+                                "Bare.Incognito.WipeAfter" -> R.string
+                                .bare_backup_lowering_incognito;
+                        case "Chrome.Bare.UpdateReminder" -> R.string
+                                .bare_backup_lowering_update_reminder;
+                        default -> 0;
+                    };
+            if (name == 0) continue;
+            String text = getContext().getString(name);
+            // Later items are mid-sentence: "Install" becomes "install", while names such as
+            // BareFilter, HTTPS-only or WebRTC keep their capitals.
+            if (!names.isEmpty()) {
+                String word = text.split(" ", 2)[0];
+                if (word.substring(1).equals(word.substring(1).toLowerCase(Locale.ROOT))) {
+                    text = Character.toLowerCase(text.charAt(0)) + text.substring(1);
+                }
+            }
+            if (!names.contains(text)) names.add(text);
+        }
+        return String.join(", ", names);
+    }
+
+    private boolean chosen(String section) {
+        ChromeSwitchPreference row = mSections.get(section);
+        return row != null && row.isChecked();
+    }
+
+    private void restore() {
+        if (mOpened == null || mRestoring) return;
+        mRestoring = true;
+        if (mFromWelcome) BareWelcomeOverlay.completeForRestore();
+        // Search engines are restored straight into the service, so it has to be loaded first.
+        // From the welcome this also puts the restore after the default engine just written.
+        TemplateUrlService service = TemplateUrlServiceFactory.getForProfile(getProfile());
+        if (service.isLoaded()) {
+            runRestore();
+            return;
+        }
+        service.registerLoadListener(
+                new TemplateUrlService.LoadListener() {
+                    @Override
+                    public void onTemplateUrlServiceLoaded() {
+                        service.unregisterLoadListener(this);
+                        if (getContext() != null) runRestore();
+                    }
+                });
+        service.load();
+    }
+
+    private void runRestore() {
+        if (mOpened == null) return;
+        Context context = getContext();
+        List<String> approved = new ArrayList<>();
+        for (Map.Entry<String, ChromeSwitchPreference> entry : mExtensions.entrySet()) {
+            if (entry.getValue().isChecked()) approved.add(entry.getKey());
+        }
+        AlertDialog progress = BareBackupDialogs.progress(context, R.string.bare_backup_restoring);
+        mOpened.restore(
+                getProfile(),
+                chosen("settings"),
+                chosen("search_engines"),
+                chosen("site_settings"),
+                chosen("bookmarks"),
+                mCustomDns != null && mCustomDns.isChecked(),
+                mLowering != null && mLowering.isChecked(),
+                approved.toArray(new String[0]),
+                context.getString(R.string.bare_backup_restored_folder, BareBackupIo.today()),
+                json -> {
+                    progress.dismiss();
+                    if (mOpened != null) {
+                        mOpened.close();
+                        mOpened = null;
+                    }
+                    if (getContext() == null) return;
+                    try {
+                        JSONObject report = new JSONObject(json);
+                        applyAfterRestore(report.optJSONArray("android_changed"));
+                        showReport(report);
+                    } catch (JSONException e) {
+                        BareBackupDialogs.message(getContext(), R.string.bare_backup_damaged);
+                    }
+                });
+    }
+
+    // Settings that other parts of Bare only pick up through their own setters.
+    private void applyAfterRestore(@Nullable JSONArray changed) {
+        if (changed == null) return;
+        List<String> keys = new ArrayList<>();
+        for (int i = 0; i < changed.length(); i++) keys.add(changed.optString(i));
+        if (keys.contains("Chrome.Bare.LauncherIcon")) {
+            BareLauncherIcon.setChoice(
+                    getContext(),
+                    ChromeSharedPreferences.getInstance().readInt("Chrome.Bare.LauncherIcon"));
+        }
+        boolean homepage = false;
+        for (String key : keys) {
+            homepage |= key.equals("homepage") || key.startsWith("Chrome.Homepage.")
+                    || key.equals("homepage_partner_enabled");
+        }
+        if (homepage) {
+            HomepageManager manager = HomepageManager.getInstance();
+            manager.setPrefHomepageEnabled(
+                    ChromeSharedPreferences.getInstance().readBoolean("homepage", true));
+            manager.setHomepageSelection(
+                    manager.getPrefHomepageUseChromeNtp(),
+                    manager.getPrefHomepageUseDefaultUri(),
+                    manager.getPrefHomepageCustomGurl());
+        }
+    }
+
+    private void showReport(JSONObject report) {
+        Context context = getContext();
+        PreferenceScreen screen = getPreferenceManager().createPreferenceScreen(context);
+        setPreferenceScreen(screen);
+        TextMessagePreference heading = new TextMessagePreference(context, null);
+        heading.setTitle(R.string.bare_backup_report_title);
+        screen.addPreference(heading);
+
+        List<String> applied = new ArrayList<>();
+        JSONArray appliedJson = report.optJSONArray("applied");
+        for (int i = 0; appliedJson != null && i < appliedJson.length(); i++) {
+            applied.add(appliedJson.optString(i));
+        }
+        if (applied.contains("settings")) {
+            int skipped = report.optInt("settings_skipped");
+            line(
+                    skipped == 0
+                            ? context.getString(
+                                    R.string.bare_backup_report_settings,
+                                    report.optInt("settings_applied"))
+                            : context.getString(
+                                    R.string.bare_backup_report_settings_skipped,
+                                    report.optInt("settings_applied"),
+                                    skipped));
+        }
+        if (applied.contains("settings") && report.optInt("settings_held_back") > 0) {
+            line(
+                    context.getString(
+                            R.string.bare_backup_report_held_back,
+                            report.optInt("settings_held_back")));
+        }
+        if (applied.contains("search_engines") && report.optInt("search_engines") > 0) {
+            line(
+                    context.getString(
+                            R.string.bare_backup_report_search_engines,
+                            report.optInt("search_engines")));
+        }
+        if (applied.contains("site_settings") && report.optInt("site_settings") > 0) {
+            line(
+                    context.getString(
+                            R.string.bare_backup_report_site_settings,
+                            report.optInt("site_settings")));
+        }
+        if (applied.contains("bookmarks") && report.optInt("bookmarks") > 0) {
+            String folder = report.optString("bookmarks_folder");
+            line(
+                    folder.isEmpty()
+                            ? context.getString(
+                                    R.string.bare_backup_report_bookmarks,
+                                    report.optInt("bookmarks"))
+                            : context.getString(
+                                    R.string.bare_backup_report_bookmarks_folder,
+                                    report.optInt("bookmarks"),
+                                    folder));
+        }
+        if (applied.contains("bookmarks")) {
+            if (report.optInt("reading_list") > 0) {
+                line(
+                        context.getString(
+                                R.string.bare_backup_report_reading_list,
+                                report.optInt("reading_list")));
+            }
+        }
+        JSONObject extensions = report.optJSONObject("extensions");
+        if (extensions != null) {
+            Iterator<String> ids = extensions.keys();
+            while (ids.hasNext()) {
+                String id = ids.next();
+                String name = mExtensionNames.containsKey(id) ? mExtensionNames.get(id) : id;
+                String error = extensions.optString(id);
+                line(
+                        error.isEmpty()
+                                ? context.getString(R.string.bare_backup_report_extension_ok, name)
+                                : context.getString(
+                                        R.string.bare_backup_report_extension_failed,
+                                        name,
+                                        error));
+            }
+        }
+        int failed = sectionLabel(report.optString("failed"));
+        if (failed != 0) {
+            line(context.getString(R.string.bare_backup_report_stopped, context.getString(failed)));
+        }
+
+        BareBackupButtonPreference done = new BareBackupButtonPreference(context);
+        done.setTitle(R.string.bare_backup_done);
+        done.setOnClick(
+                () -> {
+                    if (getActivity() != null) getActivity().finish();
+                });
+        screen.addPreference(done);
+
+        if (report.optBoolean("needs_restart")) {
+            BareBackupDialogs.builder(context)
+                    .setMessage(R.string.bare_backup_report_restart)
+                    .setPositiveButton(
+                            R.string.bare_user_agent_restart,
+                            (d, w) -> ApplicationLifetime.terminate(/* restart= */ true))
+                    .setNegativeButton(R.string.bare_user_agent_later, null)
+                    .show();
+        }
+    }
+
+    private static int sectionLabel(String section) {
+        switch (section) {
+            case "settings":
+                return R.string.bare_backup_section_settings;
+            case "search_engines":
+                return R.string.bare_backup_section_search_engines;
+            case "site_settings":
+                return R.string.bare_backup_section_site_settings;
+            case "bookmarks":
+                return R.string.bare_backup_section_bookmarks;
+            default:
+                return 0;
+        }
+    }
+
+    private void line(String text) {
+        TextMessagePreference row = new TextMessagePreference(getContext(), null);
+        row.setSummary(text);
+        getPreferenceScreen().addPreference(row);
+    }
+
+    @Override
+    public void onDestroy() {
+        if (mOpened != null) {
+            mOpened.close();
+            mOpened = null;
+        }
+        super.onDestroy();
+    }
+
+    @Override
+    public MonotonicObservableSupplier<String> getPageTitle() {
+        return mPageTitle;
+    }
+
+    @Override
+    public @AnimationType int getAnimationType() {
+        return AnimationType.PROPERTY;
+    }
+}

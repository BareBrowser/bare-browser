diff --git a/chrome/browser/bare/backup/backup_recovery_code.cc b/chrome/browser/bare/backup/backup_recovery_code.cc
new file mode 100644
index 00000000000..fb2945dc694
--- /dev/null
+++ b/chrome/browser/bare/backup/backup_recovery_code.cc
@@ -0,0 +1,82 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/bare/backup/backup_recovery_code.h"
+
+#include <openssl/rand.h>
+
+#include <array>
+
+#include "base/strings/string_util.h"
+#include "base/strings/utf_string_conversions.h"
+
+namespace bare::backup {
+
+namespace {
+
+constexpr char kAlphabet[] = "0123456789ABCDEFGHJKMNPQRSTVWXYZ";
+constexpr size_t kGroupSize = 4;
+
+std::string Group(std::string_view code) {
+  std::string grouped;
+  for (size_t i = 0; i < code.size(); ++i) {
+    if (i && i % kGroupSize == 0) {
+      grouped += '-';
+    }
+    grouped += code[i];
+  }
+  return grouped;
+}
+
+}  // namespace
+
+std::string GenerateRecoveryCode() {
+  std::array<uint8_t, kRecoveryCodeLength * 5 / 8> bytes;
+  RAND_bytes(bytes.data(), bytes.size());
+  std::string code;
+  uint32_t buffer = 0;
+  int bits = 0;
+  for (uint8_t byte : bytes) {
+    buffer = (buffer << 8) | byte;
+    bits += 8;
+    while (bits >= 5) {
+      bits -= 5;
+      code += kAlphabet[(buffer >> bits) & 31];
+    }
+  }
+  return Group(code);
+}
+
+std::optional<std::string> NormalizeRecoveryCode(std::string_view typed) {
+  std::string code;
+  for (char c : typed) {
+    if (c == ' ' || c == '-' || c == '\t' || c == '\n') {
+      continue;
+    }
+    c = base::ToUpperASCII(c);
+    if (c == 'O') {
+      c = '0';
+    } else if (c == 'I' || c == 'L') {
+      c = '1';
+    }
+    if (std::string_view(kAlphabet).find(c) == std::string_view::npos) {
+      return std::nullopt;
+    }
+    code += c;
+  }
+  if (code.size() != kRecoveryCodeLength) {
+    return std::nullopt;
+  }
+  return Group(code);
+}
+
+bool IsAcceptablePassphrase(std::string_view passphrase) {
+  if (!base::IsStringUTF8(passphrase) ||
+      base::TrimWhitespaceASCII(passphrase, base::TRIM_ALL).empty()) {
+    return false;
+  }
+  return base::UTF8ToUTF16(passphrase).size() >= kMinPassphraseLength;
+}
+
+}  // namespace bare::backup

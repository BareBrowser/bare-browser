+          : nullptr;
+  if (!pref || !pref->GetValue()->is_string() ||
+      BuiltInDohTemplates(*pref->GetValue())) {
+    return std::nullopt;
+  }
+  return TemplateHost(pref->GetValue()->GetString());
+}
+
+std::optional<std::string> CustomDnsHostIn(const base::DictValue& json) {
+  const base::DictValue* local_state = json.FindDict("local_state");

+// One case per setting that can lower protection: the phone has the
+// stronger value, the file the weaker one.
+struct LoweringCase {
+  SettingStore store;
+  const char* key;
+  base::Value strong;
+  base::Value weak;
+};
+
+std::vector<LoweringCase> LoweringCases() {
+  std::vector<LoweringCase> cases;
+  const auto add = [&](SettingStore store, const char* key, base::Value strong,
+                       base::Value weak) {
+    cases.push_back({store, key, std::move(strong), std::move(weak)});
+  };
+  const SettingStore A = SettingStore::kAndroid;
+  const SettingStore P = SettingStore::kProfile;
+  add(A, "Bare.Extensions.QuickCrx", base::Value(false), base::Value(true));
+  add(A, "Bare.Downloads.ExternalSignIn", base::Value(false),
+      base::Value(true));
+  add(P, "https_only_mode_enabled", base::Value(true), base::Value(false));
+  add(P, "profile.cookie_controls_mode", base::Value(2), base::Value(0));
+  add(P, "profile.cookie_controls_mode", base::Value(1), base::Value(0));
+  add(P, "webrtc.ip_handling_policy", base::Value("disable_non_proxied_udp"),
+      base::Value("default"));
+  add(SettingStore::kLocalState, "dns_over_https.mode",
+      base::Value("automatic"), base::Value("off"));
+  add(A, "Chrome.Bare.BundledAdBlockerEnabled", base::Value(true),
+      base::Value(false));
+  add(A, "Chrome.Bare.BareFilterEnabled", base::Value(true),
+      base::Value(false));
+  add(P, "bare.ubo_auto_update", base::Value(true), base::Value(false));
+  add(A, "Bare.Incognito.BiometricOnly", base::Value(true),
+      base::Value(false));
+  add(A, "Bare.Incognito.BlockScreenshots", base::Value(true),
+      base::Value(false));
+  add(A, "Bare.Incognito.WipeAfter", base::Value(3), base::Value(5));
+  add(A, "Bare.Incognito.WipeAfter", base::Value(5), base::Value(0));
+  add(A, "Chrome.Bare.UpdateReminder", base::Value(true), base::Value(false));
+  return cases;
+}
+
+const char* StoreKey(SettingStore store) {
+  return store == SettingStore::kAndroid   ? "android"
+         : store == SettingStore::kProfile ? "profile"
+                                           : "local_state";
+}
+
+void SetOn(Phone& phone, SettingStore store, const char* key,
+           const base::Value& value) {
+  if (store == SettingStore::kAndroid) {
+    phone.android.Set(key, value);
+  } else if (store == SettingStore::kProfile) {
+    phone.profile.Set(key, value.Clone());
+  } else {
+    phone.local_state.Set(key, value.Clone());
+  }
+}
+
+base::Value ValueOn(Phone& phone, SettingStore store, const char* key) {
+  if (store == SettingStore::kAndroid) {
+    return phone.android.values_.at(key).Clone();
+  }
+  PrefService& prefs = store == SettingStore::kProfile
+                           ? static_cast<PrefService&>(phone.profile)
+                           : phone.local_state;
+  return prefs.GetValue(key).Clone();
+}
+
+base::DictValue FileWith(SettingStore store, const char* key,
+                         const base::Value& value) {
+  base::DictValue section;
+  section.Set(key, value.Clone());
+  base::DictValue json;
+  json.Set(StoreKey(store), std::move(section));
+  return json;
+}
+
+TEST(BackupSettingsTest, WeakerValuesHeldBack) {
+  for (const LoweringCase& c : LoweringCases()) {
+    SCOPED_TRACE(c.key);
+    // Weaker than the phone: held back, listed, the phone keeps its value.
+    {
+      Phone phone;
+      SetOn(phone, c.store, c.key, c.strong);
+      const base::DictValue file = FileWith(c.store, c.key, c.weak);
+      EXPECT_EQ(LoweringSettings(file, phone.stores()).size(), 1u);
+      SettingsRestoreResult result =
+          RestoreSettings(SettingGroup::kSetup, file, phone.stores());
+      EXPECT_EQ(result.applied, 0u);
+      ASSERT_EQ(result.held_back.size(), 1u);
+      EXPECT_EQ(result.held_back[0], std::string(StoreKey(c.store)) + ":" + c.key);
+      EXPECT_EQ(ValueOn(phone, c.store, c.key), c.strong);
+      // With the row on, it applies.
+      SettingsOptions lower;
+      lower.lower_protection = true;
+      result = RestoreSettings(SettingGroup::kSetup, file, phone.stores(), lower);
+      EXPECT_EQ(result.applied, 1u);
+      EXPECT_TRUE(result.held_back.empty());
+      EXPECT_EQ(ValueOn(phone, c.store, c.key), c.weak);
+    }
+    // Equal to the phone, or stronger: restores with the Settings row.
+    for (const base::Value* phone_value : {&c.strong, &c.weak}) {
+      Phone phone;
+      SetOn(phone, c.store, c.key, *phone_value);
+      const base::DictValue file = FileWith(c.store, c.key, c.strong);
+      EXPECT_TRUE(LoweringSettings(file, phone.stores()).empty());
+      SettingsRestoreResult result =
+          RestoreSettings(SettingGroup::kSetup, file, phone.stores());
+      EXPECT_EQ(result.applied, 1u);
+      EXPECT_TRUE(result.held_back.empty());
+      EXPECT_EQ(ValueOn(phone, c.store, c.key), c.strong);
+    }
+  }
+}
+

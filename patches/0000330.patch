+// --------------------------------------------------------------- restoring
+
+base::DictValue ReportJson(const RestoreReport& report,
+                           const std::vector<std::string>& android_changed) {
+  base::DictValue json;
+  base::ListValue applied;
+  for (const std::string& section : report.sections_applied) {
+    applied.Append(section);
+  }
+  json.Set("applied", std::move(applied));
+  json.Set("failed", report.section_failed.value_or(""));
+  base::ListValue not_run;
+  for (const std::string& section : report.sections_not_run) {
+    not_run.Append(section);
+  }
+  json.Set("not_run", std::move(not_run));
+  json.Set("settings_applied", static_cast<int>(report.settings.applied));
+  json.Set("settings_skipped",
+           static_cast<int>(report.settings.skipped.size() +
+                            report.settings.unknown.size()));
+  json.Set("needs_restart", report.settings.needs_restart);
+  json.Set("bookmarks", static_cast<int>(report.bookmarks.urls));
+  json.Set("bookmark_folders", static_cast<int>(report.bookmarks.folders));
+  json.Set("bookmarks_skipped", static_cast<int>(report.bookmarks.skipped));
+  json.Set("bookmarks_folder", base::UTF16ToUTF8(report.bookmarks.folder_title));
+  json.Set("reading_list", static_cast<int>(report.reading_list.added));
+  json.Set("site_settings", static_cast<int>(report.site_exceptions.applied +
+                                             report.site_defaults.applied));
+  json.Set("search_engines", static_cast<int>(report.search_engines.added));
+  json.Set("ignored", static_cast<int>(report.ignored_entries.size()));
+  base::ListValue changed;
+  for (const std::string& key : android_changed) {
+    changed.Append(key);
+  }
+  json.Set("android_changed", std::move(changed));
+  return json;
+}

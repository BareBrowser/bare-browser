+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/bare/backup/backup_recovery_code.h"
+
+#include <set>
+#include <string>
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace bare::backup {
+namespace {
+
+TEST(BackupRecoveryCodeTest, Shape) {
+  std::set<std::string> seen;
+  for (int i = 0; i < 200; ++i) {
+    const std::string code = GenerateRecoveryCode();
+    ASSERT_EQ(code.size(), 29u) << code;
+    for (size_t j = 0; j < code.size(); ++j) {
+      if (j % 5 == 4) {
+        EXPECT_EQ(code[j], '-') << code;
+      } else {
+        EXPECT_NE(std::string("0123456789ABCDEFGHJKMNPQRSTVWXYZ").find(code[j]),
+                  std::string::npos)
+            << code;
+      }
+    }
+    EXPECT_EQ(NormalizeRecoveryCode(code), code);
+    seen.insert(code);
+  }
+  EXPECT_EQ(seen.size(), 200u);
+}
+
+TEST(BackupRecoveryCodeTest, ForgivingInput) {
+  const std::string code = "7KQ2-M9XD-0011-ABCD-EFGH-JKMN";
+  for (const char* typed :
+       {"7KQ2-M9XD-0011-ABCD-EFGH-JKMN", "7kq2m9xd0011abcdefghjkmn",
+        " 7KQ2 M9XD OOIL ABCD EFGH JKMN ", "7kq2-m9xd-oo11-abcd-efgh-jkmn\n"}) {
+    EXPECT_EQ(NormalizeRecoveryCode(typed), code) << typed;
+  }
+  for (const char* typed :
+       {"", "7KQ2-M9XD-0011-ABCD-EFGH-JKM", "7KQ2-M9XD-0011-ABCD-EFGH-JKMNP",
+        "7KQ2-M9XD-0011-ABCD-EFGH-JKMU", "my own passphrase here",
+        "7KQ2_M9XD_0011_ABCD_EFGH_JKMN"}) {
+    EXPECT_FALSE(NormalizeRecoveryCode(typed)) << typed;
+  }
+}
+
+TEST(BackupRecoveryCodeTest, Passphrase) {
+  EXPECT_TRUE(IsAcceptablePassphrase("correct horse"));
+  EXPECT_TRUE(IsAcceptablePassphrase("éééééé"
+                                     "éééééé"));
+  EXPECT_FALSE(IsAcceptablePassphrase("short"));
+  EXPECT_FALSE(IsAcceptablePassphrase("elevenchars"));
+  EXPECT_FALSE(IsAcceptablePassphrase("              "));
+  EXPECT_FALSE(IsAcceptablePassphrase("\xff\xfe\xfd\xfc\xfb\xfa\xf9\xf8\xf7"
+                                      "\xf6\xf5\xf4"));
+}
+
+}  // namespace
+}  // namespace bare::backup

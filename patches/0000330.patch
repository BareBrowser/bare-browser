+// ---------------------------------------------------------------- creating
+
+struct BuiltFile {
+  std::vector<uint8_t> bytes;
+};
+
+std::vector<uint8_t> EncryptOffThread(Kind kind,
+                                      Description description,
+                                      std::string zip,
+                                      std::vector<uint8_t> secret) {
+  std::optional<std::vector<uint8_t>> file;
+  if (kind == Kind::kSetup) {
+    file = WriteSetupFile(description, base::as_byte_span(zip));
+  } else {
+    const KdfParams kdf = NewKdfParams();
+    std::optional<Key> key = DeriveKey(secret, kdf);
+    WipeSecret(secret);
+    if (key) {
+      file = WriteFullFile(description, kdf, NewAeadParams(), *key,
+                           base::as_byte_span(zip));
+    }
+  }
+  OPENSSL_cleanse(zip.data(), zip.size());
+  return file.value_or(std::vector<uint8_t>());
+}
+
+void OnCollected(base::WeakPtr<Profile> profile,
+                 Kind kind,
+                 bool include_custom_dns,
+                 Description description,
+                 std::vector<uint8_t> secret,
+                 ScopedJavaGlobalRef<jobject> callback,
+                 CollectedExtensions extensions) {
+  JNIEnv* env = AttachCurrentThread();
+  if (!profile) {
+    Java_BareBackupBridge_onBytes(env, callback, std::vector<uint8_t>());
+    return;
+  }
+  JavaAndroidPrefs android;
+  Sources sources = SourcesFor(profile.get(), &android);
+  sources.extensions = &extensions;
+  sources.settings_options.custom_dns_in_setup =
+      kind == Kind::kSetup && include_custom_dns;
+  std::optional<BuiltPackage> built = BuildPackage(kind, sources);
+  if (!built) {
+    Java_BareBackupBridge_onBytes(env, callback, std::vector<uint8_t>());
+    return;
+  }
+  for (const auto& [name, count] : built->counts) {
+    description.contents[name] = count;
+  }
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_BLOCKING},
+      base::BindOnce(&EncryptOffThread, kind, std::move(description),
+                     std::move(built->zip), std::move(secret)),
+      base::BindOnce(
+          [](ScopedJavaGlobalRef<jobject> callback,
+             std::vector<uint8_t> bytes) {
+            Java_BareBackupBridge_onBytes(AttachCurrentThread(), callback,
+                                          bytes);
+          },
+          std::move(callback)));
+}
+
+// Opens `file` the way a restore would and checks every part of it.
+bool VerifyOffThread(std::vector<uint8_t> file, std::vector<uint8_t> secret) {
+  auto parsed = ParseFile(file);
+  if (!parsed.has_value()) {
+    WipeSecret(secret);
+    return false;
+  }
+  base::expected<std::string, ReadError> body =
+      base::unexpected(ReadError::kDamaged);
+  if (parsed->kind == Kind::kFull) {
+    std::optional<Key> key = DeriveKey(secret, parsed->kdf);
+    if (key) {
+      body = DecryptBody(*parsed, *key);
+    }
+  } else {
+    body = ReadSetupBody(*parsed);
+  }
+  WipeSecret(secret);
+  if (!body.has_value()) {
+    return false;
+  }
+  auto package = ReadPackage(*body);
+  OPENSSL_cleanse(body->data(), body->size());
+  return package.has_value() &&
+         ReadManifest(*package, parsed->kind).has_value();
+}
+
+// ----------------------------------------------------------------- opening
+
+// A backup being restored. Lives until Java closes it.
+class OpenedBackup {
+ public:
+  explicit OpenedBackup(std::vector<uint8_t> file) : file_(std::move(file)) {}
+  ~OpenedBackup() { WipePackage(); }
+
+  base::expected<ParsedFile, ReadError> Parse() const {
+    return ParseFile(file_);
+  }
+
+  bool opened() const { return package_.has_value(); }
+  const Package& package() const { return *package_; }
+  const PackageSummary& summary() const { return summary_; }
+
+  void SetOpened(Package package, PackageSummary summary) {
+    package_ = std::move(package);
+    summary_ = std::move(summary);
+  }
+
+  const std::vector<uint8_t> file() const { return file_; }
+
+  base::WeakPtr<OpenedBackup> GetWeakPtr() {
+    return weak_factory_.GetWeakPtr();
+  }
+
+ private:
+  void WipePackage() {
+    if (!package_) {
+      return;
+    }
+    for (auto& [name, contents] : *package_) {
+      OPENSSL_cleanse(contents.data(), contents.size());
+    }
+    package_.reset();
+  }
+
+  std::vector<uint8_t> file_;
+  std::optional<Package> package_;
+  PackageSummary summary_;
+  base::WeakPtrFactory<OpenedBackup> weak_factory_{this};
+};
+
+struct OpenResult {
+  OpenResult() = default;
+  OpenResult(OpenResult&&) = default;
+  OpenResult& operator=(OpenResult&&) = default;
+
+  std::optional<Package> package;
+  PackageSummary summary;
+  const char* error = nullptr;
+};
+
+OpenResult OpenOffThread(std::vector<uint8_t> file,
+                         std::vector<uint8_t> secret) {
+  OpenResult result;
+  auto parsed = ParseFile(file);
+  if (!parsed.has_value()) {
+    WipeSecret(secret);
+    result.error = ReadErrorName(parsed.error());
+    return result;
+  }
+  base::expected<std::string, ReadError> body =
+      base::unexpected(ReadError::kWrongCodeOrDamaged);
+  if (parsed->kind == Kind::kFull) {
+    if (std::optional<Key> key = DeriveKey(secret, parsed->kdf)) {
+      body = DecryptBody(*parsed, *key);
+    }
+  } else {
+    body = ReadSetupBody(*parsed);
+  }
+  WipeSecret(secret);
+  if (!body.has_value()) {
+    result.error = ReadErrorName(body.error());
+    return result;
+  }
+  auto package = ReadPackage(*body);
+  OPENSSL_cleanse(body->data(), body->size());
+  if (!package.has_value()) {
+    result.error = "damaged";
+    return result;
+  }
+  auto summary = ReadManifest(*package, parsed->kind);
+  if (!summary.has_value()) {
+    result.error = ContentsErrorName(summary.error());
+    return result;
+  }
+  result.package = std::move(*package);
+  result.summary = std::move(*summary);
+  return result;
+}
+
+std::string UpdateHost(const std::string& update_url) {
+  const GURL url(update_url);
+  return url.is_valid() ? url.GetHost() : std::string();
+}
+
+void OnOpened(base::WeakPtr<OpenedBackup> backup,
+              base::WeakPtr<Profile> profile,
+              ScopedJavaGlobalRef<jobject> callback,
+              OpenResult result) {
+  JNIEnv* env = AttachCurrentThread();
+  if (!backup || !profile) {
+    return;
+  }
+  if (result.error) {
+    Java_BareBackupBridge_onJson(env, callback,
+                                 ToJson(base::Value(ErrorJson(result.error))));
+    return;
+  }
+  backup->SetOpened(std::move(*result.package), std::move(result.summary));
+
+  base::DictValue json = ErrorJson("");
+  json.Set("ok", true);
+  base::ListValue sections;
+  for (const std::string& section : backup->summary().sections) {
+    sections.Append(section);
+  }
+  json.Set("sections", std::move(sections));
+  if (std::optional<std::string> host =
+          CustomDnsHostInPackage(backup->package())) {
+    json.Set("custom_dns_host", *host);
+  }
+  {
+    JavaAndroidPrefs android;
+    base::ListValue lowering;
+    for (const std::string& label : LoweringSettingsInPackage(
+             backup->package(), backup->summary(),
+             SourcesFor(profile.get(), &android).settings)) {
+      lowering.Append(label);
+    }
+    json.Set("lowering", std::move(lowering));
+  }
+  base::ListValue extensions;
+  for (const ExtensionReviewItem& item : DescribeExtensionsForRestore(
+           profile.get(), backup->package(), backup->summary())) {
+    base::DictValue entry;
+    entry.Set("id", item.record.id);
+    entry.Set("name", item.record.name);
+    entry.Set("version", item.record.version);
+    entry.Set("unpacked", item.record.kind == ExtensionKind::kUnpacked);
+    entry.Set("files", item.record.files);
+    entry.Set("installed_here", item.installed_here);
+    entry.Set("can_install", item.CanInstall());
+    entry.Set("problem", item.problem.has_value());
+    entry.Set("update_host", UpdateHost(item.record.update_url));
+    base::ListValue permissions;
+    for (const std::u16string& permission : item.permissions) {
+      permissions.Append(base::UTF16ToUTF8(permission));
+    }
+    entry.Set("permissions", std::move(permissions));
+    extensions.Append(std::move(entry));
+  }
+  json.Set("extensions", std::move(extensions));
+  Java_BareBackupBridge_onJson(env, callback, ToJson(base::Value(std::move(json))));
+}

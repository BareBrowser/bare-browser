+
+package org.chromium.chrome.browser.bare.backup;
+
+import android.app.AlertDialog;
+import android.content.Context;
+import android.text.InputType;
+import android.view.Gravity;
+import android.view.Window;
+import android.view.WindowManager;
+import android.widget.EditText;
+import android.widget.LinearLayout;
+import android.widget.ProgressBar;
+import android.widget.TextView;
+
+import androidx.annotation.StringRes;
+
+import org.chromium.chrome.R;
+
+/** The small dialogs the backup pages share. */
+final class BareBackupDialogs {
+    private BareBackupDialogs() {}
+
+    static AlertDialog.Builder builder(Context context) {
+        return new AlertDialog.Builder(context, R.style.ThemeOverlay_BrowserUI_AlertDialog);
+    }
+
+    /** A dialog with a spinner that the caller dismisses. */
+    static AlertDialog progress(Context context, @StringRes int message) {
+        LinearLayout row = new LinearLayout(context);
+        int padding = dp(context, 24);
+        row.setPadding(padding, padding, padding, padding);
+        row.setGravity(Gravity.CENTER_VERTICAL);
+        row.addView(new ProgressBar(context));
+        TextView text = new TextView(context);
+        text.setText(message);
+        text.setPadding(padding, 0, 0, 0);
+        row.addView(text);
+        AlertDialog dialog = builder(context).setView(row).setCancelable(false).create();
+        dialog.show();
+        return dialog;
+    }
+
+    /**
+     * Shows a dialog that holds a code or passphrase. Its window is left out of screenshots, screen
+     * recordings and the Recents thumbnail.
+     */
+    static AlertDialog showSecure(AlertDialog dialog) {
+        Window window = dialog.getWindow();
+        if (window != null) window.addFlags(WindowManager.LayoutParams.FLAG_SECURE);
+        dialog.show();
+        return dialog;
+    }
+
+    static void message(Context context, @StringRes int message) {
+        builder(context).setMessage(message).setPositiveButton(android.R.string.ok, null).show();
+    }
+
+    /** A single-line field for a code or passphrase, hidden as typed unless {@code visible}. */
+    static EditText secretField(Context context, @StringRes int hint, boolean visible) {
+        EditText field = new EditText(context);
+        field.setHint(hint);
+        field.setSingleLine(true);
+        field.setInputType(
+                InputType.TYPE_CLASS_TEXT
+                        | InputType.TYPE_TEXT_FLAG_NO_SUGGESTIONS
+                        | (visible
+                                ? InputType.TYPE_TEXT_VARIATION_VISIBLE_PASSWORD
+                                : InputType.TYPE_TEXT_VARIATION_PASSWORD));
+        return field;
+    }
+
+    static LinearLayout padded(Context context) {
+        LinearLayout layout = new LinearLayout(context);
+        layout.setOrientation(LinearLayout.VERTICAL);
+        int side = dp(context, 24);
+        layout.setPadding(side, dp(context, 8), side, 0);
+        return layout;
+    }
+
+    static @StringRes int errorMessage(String error) {
+        switch (error) {
+            case "wrong_code":
+                return R.string.bare_backup_wrong_code;
+            case "newer":
+                return R.string.bare_backup_newer;
+            case "not_bare":
+                return R.string.bare_backup_not_bare;
+            default:
+                return R.string.bare_backup_damaged;
+        }
+    }
+
+    static int dp(Context context, int dp) {
+        return Math.round(dp * context.getResources().getDisplayMetrics().density);
+    }
+}
diff --git a/chrome/android/java/src/org/chromium/chrome/browser/bare/backup/BareBackupIo.java b/chrome/android/java/src/org/chromium/chrome/browser/bare/backup/BareBackupIo.java
new file mode 100644
index 00000000000..92b95fa13da
--- /dev/null
+++ b/chrome/android/java/src/org/chromium/chrome/browser/bare/backup/BareBackupIo.java
@@ -0,0 +1,104 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.bare.backup;
+
+import android.content.Context;
+import android.content.pm.PackageInfo;
+import android.content.pm.PackageManager;
+import android.net.Uri;
+import android.os.Build;
+
+import org.chromium.base.Callback;
+import org.chromium.base.task.PostTask;
+import org.chromium.base.task.TaskTraits;
+
+import java.io.ByteArrayOutputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.OutputStream;
+import java.text.SimpleDateFormat;
+import java.util.Date;
+import java.util.Locale;
+
+/** Reads and writes backup files through the document picker's Uri, off the UI thread. */
+final class BareBackupIo {
+    // A package is at most 64 MB, plus the header and 16 bytes per 64 KB chunk.
+    private static final int MAX_FILE_BYTES = 80 * 1024 * 1024;
+
+    private BareBackupIo() {}
+
+    static void write(Context context, Uri uri, byte[] bytes, Callback<Boolean> done) {
+        Context app = context.getApplicationContext();
+        PostTask.postTask(
+                TaskTraits.USER_BLOCKING_MAY_BLOCK,
+                () -> {
+                    boolean ok;
+                    try (OutputStream out = app.getContentResolver().openOutputStream(uri, "wt")) {
+                        if (out == null) throw new IOException();
+                        out.write(bytes);
+                        ok = true;
+                    } catch (IOException | SecurityException e) {
+                        ok = false;
+                    }
+                    final boolean result = ok;
+                    PostTask.postTask(TaskTraits.UI_DEFAULT, () -> done.onResult(result));
+                });
+    }
+
+    /** Passes the file's bytes, or null if it can't be read or is larger than any backup. */
+    static void read(Context context, Uri uri, Callback<byte[]> done) {
+        Context app = context.getApplicationContext();
+        PostTask.postTask(
+                TaskTraits.USER_BLOCKING_MAY_BLOCK,
+                () -> {
+                    byte[] bytes = null;
+                    try (InputStream in = app.getContentResolver().openInputStream(uri)) {
+                        if (in == null) throw new IOException();
+                        ByteArrayOutputStream out = new ByteArrayOutputStream();
+                        byte[] buffer = new byte[64 * 1024];
+                        int total = 0;
+                        int n;
+                        while ((n = in.read(buffer)) > 0) {
+                            total += n;
+                            if (total > MAX_FILE_BYTES) throw new IOException();
+                            out.write(buffer, 0, n);
+                        }
+                        bytes = out.toByteArray();
+                    } catch (IOException | SecurityException e) {
+                        bytes = null;
+                    }
+                    final byte[] result = bytes;
+                    PostTask.postTask(TaskTraits.UI_DEFAULT, () -> done.onResult(result));
+                });
+    }
+
+    static String today() {
+        return new SimpleDateFormat("yyyy-MM-dd", Locale.US).format(new Date());
+    }
+
+    /** The phone's model, never the name its owner gave it. */
+    static String deviceLabel() {
+        return Build.MODEL;
+    }
+
+    // Bare's version is only in the manifest, so it comes from the package, as in BareUpdateCheck.
+    static String bareVersion(Context context) {
+        PackageInfo info = packageInfo(context);
+        return info == null || info.versionName == null ? "" : info.versionName;
+    }
+
+    static int bareVersionCode(Context context) {
+        PackageInfo info = packageInfo(context);
+        return info == null ? 0 : (int) info.getLongVersionCode();
+    }
+
+    private static PackageInfo packageInfo(Context context) {
+        try {
+            return context.getPackageManager().getPackageInfo(context.getPackageName(), 0);
+        } catch (PackageManager.NameNotFoundException e) {
+            return null;
+        }
+    }
+}

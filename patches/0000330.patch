+static void JNI_BareBackupBridge_CreateBackup(
+    JNIEnv* env,
+    const JavaRef<jobject>& jprofile,
+    jboolean full,
+    std::vector<uint8_t> secret,
+    jboolean secret_is_code,
+    jboolean include_custom_dns,
+    std::string device_label,
+    std::string bare_version,
+    jint bare_version_code,
+    const JavaRef<jobject>& jcallback) {
+  ScopedJavaGlobalRef<jobject> callback(jcallback);
+  Profile* profile = Profile::FromJavaObject(jprofile);
+  std::vector<uint8_t> key_input =
+      full ? bare_backup::SecretBytes(std::move(secret), secret_is_code)
+           : std::vector<uint8_t>();
+  if (!profile || (full && key_input.empty())) {
+    Java_BareBackupBridge_onBytes(env, callback, std::vector<uint8_t>());
+    return;
+  }
+  bare_backup::Description description;
+  description.created = bare_backup::UtcTimestamp(base::Time::Now());
+  description.bare_version = bare_version;
+  description.bare_version_code = bare_version_code;
+  description.device_label = device_label;
+  if (full) {
+    description.secret = secret_is_code ? "code" : "passphrase";
+  }
+  const bare_backup::Kind kind =
+      full ? bare_backup::Kind::kFull : bare_backup::Kind::kSetup;
+  bare_backup::CollectExtensions(
+      profile, /*with_files=*/full,
+      base::BindOnce(&bare_backup::OnCollected, profile->GetWeakPtr(), kind,
+                     static_cast<bool>(include_custom_dns),
+                     std::move(description), std::move(key_input),
+                     std::move(callback)));
+}
+
+static void JNI_BareBackupBridge_VerifyBackup(
+    JNIEnv* env,
+    std::vector<uint8_t> file,
+    std::vector<uint8_t> secret,
+    jboolean secret_is_code,
+    const JavaRef<jobject>& jcallback) {
+  ScopedJavaGlobalRef<jobject> callback(jcallback);
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_BLOCKING},
+      base::BindOnce(&bare_backup::VerifyOffThread, std::move(file),
+                     bare_backup::SecretBytes(std::move(secret),
+                                              secret_is_code)),
+      base::BindOnce(
+          [](ScopedJavaGlobalRef<jobject> callback, bool ok) {
+            Java_BareBackupBridge_onBoolean(AttachCurrentThread(), callback,
+                                            ok);
+          },
+          std::move(callback)));
+}

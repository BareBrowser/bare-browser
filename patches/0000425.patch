+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.bare;
+
+import android.content.Context;
+import android.graphics.Bitmap;
+import android.graphics.Outline;
+import android.text.format.DateUtils;
+import android.text.format.Formatter;
+import android.util.TypedValue;
+import android.view.Gravity;
+import android.view.View;
+import android.view.ViewGroup;
+import android.view.ViewOutlineProvider;
+import android.widget.Button;
+import android.widget.ImageView;
+import android.widget.LinearLayout;
+import android.widget.ScrollView;
+import android.widget.TextView;
+
+import org.chromium.base.Callback;
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.chrome.R;
+import org.chromium.components.browser_ui.styles.SemanticColorUtils;
+import org.chromium.components.browser_ui.widget.RiseSheet;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Locale;
+
+/**
+ * The card that asks which file to save when more than one file on the page fits the pressed
+ * video. It rises from behind the address bar like Bare's other cards. It shows the picture the
+ * video was showing when it was pressed, and the length, picture size and file size of the best
+ * fit, with Save, and "Choose another file" for the others.
+ */
+@NullMarked
+final class BareVideoSheet {
+    private BareVideoSheet() {}
+
+    static void show(
+            View root, BareVideoMatch.Result result, Callback<BareVideoMatch.Option> chosen) {
+        Context context = root.getContext();
+        List<BareVideoMatch.Option> options = result.options;
+        BareVideoMatch.Option best = options.get(0);
+        List<BareVideoMatch.Option> picked = new ArrayList<>(1);
+
+        LinearLayout card = new LinearLayout(context);
+        card.setOrientation(LinearLayout.VERTICAL);
+        card.setPadding(0, dp(context, 6), 0, dp(context, 18));
+
+        TextView title =
+                text(context, context.getString(R.string.bare_video_confirm_title), 17, true);
+        title.setPadding(dp(context, 20), 0, dp(context, 20), dp(context, 2));
+        card.addView(title);
+        TextView summary = text(context, context.getString(R.string.bare_video_confirm_summary), 13,
+                false);
+        summary.setTextColor(SemanticColorUtils.getDefaultTextColorSecondary(context));
+        summary.setPadding(dp(context, 20), 0, dp(context, 20), dp(context, 12));
+        card.addView(summary);
+
+        LinearLayout body = new LinearLayout(context);
+        body.setOrientation(LinearLayout.VERTICAL);
+        body.setPadding(dp(context, 20), 0, dp(context, 20), 0);
+        body.setClipToPadding(false);
+        ScrollView scroll = new ScrollView(context);
+        scroll.addView(body);
+        card.addView(scroll, new LinearLayout.LayoutParams(-1, 0, 1f));
+
+        // The best fit, beside the picture of the pressed video.
+        LinearLayout first = new LinearLayout(context);
+        first.setOrientation(LinearLayout.HORIZONTAL);
+        first.setGravity(Gravity.CENTER_VERTICAL);
+        Bitmap thumbnail = result.thumbnail;
+        if (thumbnail != null) {
+            ImageView picture = new ImageView(context);
+            picture.setImageBitmap(thumbnail);
+            picture.setScaleType(ImageView.ScaleType.CENTER_CROP);
+            picture.setClipToOutline(true);
+            picture.setOutlineProvider(
+                    new ViewOutlineProvider() {
+                        @Override
+                        public void getOutline(View view, Outline outline) {
+                            outline.setRoundRect(
+                                    0, 0, view.getWidth(), view.getHeight(), dp(context, 10));
+                        }
+                    });
+            int width = dp(context, 96);
+            int height =
+                    Math.min(
+                            dp(context, 160),
+                            Math.round(width * thumbnail.getHeight() / (float) thumbnail.getWidth()));
+            LinearLayout.LayoutParams params = new LinearLayout.LayoutParams(width, height);
+            params.setMarginEnd(dp(context, 16));
+            first.addView(picture, params);
+        }
+        LinearLayout details = new LinearLayout(context);
+        details.setOrientation(LinearLayout.VERTICAL);
+        details.addView(text(context, headline(best), 16, true));
+        TextView size = text(context, sizeLine(context, best), 14, false);
+        size.setTextColor(SemanticColorUtils.getDefaultTextColorSecondary(context));
+        details.addView(size);
+        first.addView(details, new LinearLayout.LayoutParams(0, -2, 1f));
+        body.addView(first);
+
+        // The others, shown on request, each a tap to save.
+        LinearLayout others = new LinearLayout(context);
+        others.setOrientation(LinearLayout.VERTICAL);
+        others.setVisibility(View.GONE);
+        others.setPadding(0, dp(context, 12), 0, 0);
+        for (int i = 1; i < options.size(); i++) {
+            BareVideoMatch.Option option = options.get(i);
+            LinearLayout row = new LinearLayout(context);
+            row.setOrientation(LinearLayout.VERTICAL);
+            row.setPadding(0, dp(context, 10), 0, dp(context, 10));
+            row.addView(text(context, headline(option), 15, false));
+            TextView rowSize = text(context, sizeLine(context, option), 13, false);
+            rowSize.setTextColor(SemanticColorUtils.getDefaultTextColorSecondary(context));
+            row.addView(rowSize);
+            TypedValue ripple = new TypedValue();
+            context.getTheme()
+                    .resolveAttribute(android.R.attr.selectableItemBackground, ripple, true);
+            row.setBackgroundResource(ripple.resourceId);
+            row.setClickable(true);
+            row.setOnClickListener(
+                    v -> {
+                        picked.add(option);
+                        RiseSheet.closeActive();
+                    });
+            others.addView(row, new LinearLayout.LayoutParams(-1, -2));
+        }
+        body.addView(others, new LinearLayout.LayoutParams(-1, -2));
+
+        LinearLayout buttons = new LinearLayout(context);
+        buttons.setOrientation(LinearLayout.HORIZONTAL);
+        buttons.setGravity(Gravity.CENTER_VERTICAL);
+        buttons.setPadding(0, dp(context, 8), 0, 0);
+        Button another = button(context, context.getString(R.string.bare_video_choose_another));
+        Button save = button(context, context.getString(R.string.bare_video_save));
+        another.setOnClickListener(
+                v -> {
+                    others.setVisibility(View.VISIBLE);
+                    another.setVisibility(View.INVISIBLE);
+                });
+        save.setOnClickListener(
+                v -> {
+                    picked.add(best);
+                    RiseSheet.closeActive();
+                });
+        buttons.addView(another);
+        buttons.addView(new View(context), new LinearLayout.LayoutParams(0, 1, 1f));
+        buttons.addView(save);
+        // Right under the best fit, so they show while the card is only part way up. The
+        // buttons' own padding is pulled into the margin so their text lines up with the rows.
+        LinearLayout.LayoutParams buttonsParams = new LinearLayout.LayoutParams(-1, -2);
+        buttonsParams.setMarginStart(-dp(context, 16));
+        buttonsParams.setMarginEnd(-dp(context, 16));
+        body.addView(buttons, 1, buttonsParams);
+
+        // The download starts once this card has gone: its save card cannot show while another
+        // card is still folding away, and would be skipped.
+        RiseSheet.show(
+                root,
+                card,
+                scroll,
+                () -> {
+                    if (!picked.isEmpty()) chosen.onResult(picked.get(0));
+                });
+    }
+
+    /** "1:07 · 720 × 1280" */
+    private static String headline(BareVideoMatch.Option option) {
+        StringBuilder out = new StringBuilder();
+        if (option.durationSeconds > 0) {
+            out.append(DateUtils.formatElapsedTime(Math.round(option.durationSeconds)));
+        }
+        if (option.width > 0 && option.height > 0) {
+            if (out.length() > 0) out.append(" · ");
+            out.append(String.format(Locale.getDefault(), "%d × %d", option.width, option.height));
+        }
+        return out.toString();
+    }
+
+    /** The download size, the sound file included. Empty when the page did not say. */
+    private static String sizeLine(Context context, BareVideoMatch.Option option) {
+        long total = option.bytes + option.audioBytes;
+        return total > 0 ? Formatter.formatShortFileSize(context, total) : "";
+    }
+
+    private static TextView text(Context context, String value, int sp, boolean bold) {
+        TextView view = new TextView(context);
+        view.setText(value);
+        view.setTextSize(TypedValue.COMPLEX_UNIT_SP, sp);
+        view.setTextColor(SemanticColorUtils.getDefaultTextColor(context));
+        if (bold) view.setTypeface(view.getTypeface(), android.graphics.Typeface.BOLD);
+        return view;
+    }
+
+    private static Button button(Context context, String label) {
+        Button button = new Button(context, null, android.R.attr.borderlessButtonStyle);
+        button.setText(label);
+        button.setAllCaps(false);
+        button.setTextSize(TypedValue.COMPLEX_UNIT_SP, 15);
+        button.setTextColor(SemanticColorUtils.getDefaultControlColorActive(context));
+        // A fixed side padding, so the text lines up with the rows under the margin pulled in
+        // below; the theme's own can be smaller and cut the first letter off.
+        int side = dp(context, 16);
+        button.setPaddingRelative(side, button.getPaddingTop(), side, button.getPaddingBottom());
+        button.setLayoutParams(
+                new LinearLayout.LayoutParams(
+                        ViewGroup.LayoutParams.WRAP_CONTENT, ViewGroup.LayoutParams.WRAP_CONTENT));
+        return button;
+    }
+
+    private static int dp(Context context, float value) {
+        return Math.round(value * context.getResources().getDisplayMetrics().density);
+    }
+}

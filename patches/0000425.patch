+      if (seen[k]) return;
+      seen[k] = true;
+      options.push(o);
+    }
+
+    matched.forEach(function (m) {
+      // The page's data names a file with sound for this same media: same address path.
+      for (var bi = 0; bi < blocks.length; bi++) {
+        var bl = blocks[bi];
+        for (var ui = 0; ui < bl.urls.length; ui++) {
+          if (path(bl.urls[ui].url) === path(m.url)) {
+            var best = bl.urls[0];
+            add({video: best.url, audio: '', width: best.width, height: best.height,
+                 duration: m.duration || bl.duration, bytes: 0, audioBytes: 0, sound: true, from: 'page'});
+            return;
+          }
+        }
+      }
+      // The player switches quality as it goes, so the pressed element may be showing a smaller
+      // copy of a bigger file the page also fetched. A copy of the same shape and the same length
+      // is the same video.
+      var pick = m;
+      if (m.duration > 0) {
+        pictures.forEach(function (p) {
+          if (sameShape(p.width, p.height, m.width, m.height) && near(p.duration, m.duration, 0.15) &&
+              p.width * p.height > pick.width * pick.height) pick = p;
+        });
+      }
+      // The sound of the same video has the same length. Two posts can share a length, so among
+      // those the one the player started fetching together with this picture is taken.
+      var audio = null;
+      if (!pick.sound && pick.duration > 0) {
+        sounds.forEach(function (s) {
+          if (!near(s.duration, pick.duration, lengthTolerance(pick.duration))) return;
+          if (!audio || Math.abs(s.first - m.first) < Math.abs(audio.first - m.first)) audio = s;
+        });
+      }
+      add({video: pick.url, audio: audio ? audio.url : '', width: pick.width, height: pick.height,
+           duration: pick.duration, bytes: pick.bytes, audioBytes: audio ? audio.bytes : 0,
+           sound: pick.sound, from: 'fetched'});
+    });
+
+    if (options.length) return options;
+
+    // A page with one video, whose picture size is not known yet: its one fetched picture file
+    // cannot belong to another video.
+    if (!pressed.width && sizeableVideos() === 1 && pictures.length === 1) {
+      var only = pictures[0], onlySound = null;
+      sounds.forEach(function (s) {
+        if (near(s.duration, only.duration, lengthTolerance(only.duration)) && !onlySound) onlySound = s;
+      });
+      add({video: only.url, audio: !only.sound && onlySound ? onlySound.url : '', width: only.width,
+           height: only.height, duration: only.duration, bytes: only.bytes,
+           audioBytes: !only.sound && onlySound ? onlySound.bytes : 0, sound: only.sound, from: 'fetched'});
+      return options;
+    }
+
+    // Nothing fetched fits, so go by the page's data alone. A site serves a smaller copy of the
+    // same shape to the player, so a block of the same shape counts, and its length decides.
+    var shaped = blocks.filter(function (bl) {
+      return bl.urls.some(function (u) {
+        return (u.width === pressed.width && u.height === pressed.height) ||
+               sameShape(u.width, u.height, pressed.width, pressed.height);
+      });
+    });
+    return Promise.all(shaped.map(function (bl) {
+      var best = bl.urls[0];
+      return head(best.url, false).then(function (info) {
+        return {video: best.url, audio: '', width: best.width, height: best.height,
+                duration: (info && info.duration) || bl.duration, bytes: info ? info.bytes : 0,
+                audioBytes: 0, sound: !info || !!trackOf(info, 'soun'), from: 'page'};
+      });
+    })).then(function (list) {
+      if (pressed.duration && list.some(function (o) { return o.duration > 0; })) {
+        list = list.filter(function (o) {
+          return near(o.duration, pressed.duration, lengthTolerance(pressed.duration));
+        });
+      }
+      list.forEach(add);
+      if (!options.length && sizeableVideos() === 1) {
+        // Older page layouts name the file of their one video under one of these keys.
+        var named = namedAddress();
+        if (named) add({video: named, audio: '', width: pressed.width, height: pressed.height,
+                        duration: pressed.duration, bytes: 0, audioBytes: 0, sound: true, from: 'page'});
+      }
+      return options;
+    });
+  }).then(function (options) {
+    // The sheet shows each file's size, so fill in the ones not known yet.
+    return Promise.all(options.map(function (o) {
+      return o.bytes ? o : sizeOf(o.video).then(function (b) { o.bytes = b; return o; });
+    }));
+  }).then(function (options) {
+    state.options = options;
+    done(options.length ? '' : (segmentsOnly() ? 'stream' : 'nothing'));
+  }, function () { done('nothing'); });
+  return 'started';
+})

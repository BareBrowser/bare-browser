+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.bare;
+
+import android.app.Activity;
+import android.view.View;
+
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.chrome.R;
+import org.chromium.components.browser_ui.widget.RiseSheet;
+import org.chromium.url.GURL;
+
+import java.util.List;
+
+/**
+ * Saves the video that was pressed, from what {@link BareVideoMatch} found.
+ *
+ * <p>One file that fits is saved at once, since a signed address soon expires. Several are shown
+ * on a card for the user to choose. None gives an honest message and saves nothing. When the
+ * site keeps the sound in a file of its own, that file is downloaded as well.
+ */
+@NullMarked
+public final class BareVideoSaver {
+    private BareVideoSaver() {}
+
+    /** Starts the download of one address through the browser's own download path. */
+    public interface Downloader {
+        void download(GURL url);
+    }
+
+    /** Acts on what the page said about the press. */
+    public static void handle(Activity activity, BareVideoMatch.Result result, Downloader downloader) {
+        View root = activity.getWindow().getDecorView();
+        List<BareVideoMatch.Option> options = result.options;
+        if (options.isEmpty()) {
+            tell(root, messageFor(result.why));
+            return;
+        }
+        if (options.size() == 1) {
+            save(options.get(0), downloader);
+            return;
+        }
+        BareVideoSheet.show(root, result, option -> save(option, downloader));
+    }
+
+    static int messageFor(String why) {
+        switch (why) {
+            case BareVideoMatch.PROTECTED:
+                return R.string.bare_video_protected;
+            case BareVideoMatch.STREAM:
+                return R.string.bare_video_stream_only;
+            default:
+                return R.string.bare_video_which_one;
+        }
+    }
+
+    private static void save(BareVideoMatch.Option option, Downloader downloader) {
+        GURL video = new GURL(option.video);
+        String audioAddress = option.audio;
+        if (audioAddress == null) {
+            downloader.download(video);
+            return;
+        }
+        // The site keeps the sound in a file of its own, so it is saved too.
+        downloader.download(video);
+        downloader.download(new GURL(audioAddress));
+    }
+
+    private static void tell(View root, int message) {
+        RiseSheet.showMessage(root, root.getContext().getString(message), null, null, null);
+    }
+}

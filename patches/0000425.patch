new file mode 100644
index 00000000000..606121f7dad
--- /dev/null
+++ b/chrome/android/java/src/org/chromium/chrome/browser/bare/BareVideoMatch.java
@@ -0,0 +1,226 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.bare;
+
+import android.graphics.Bitmap;
+import android.graphics.BitmapFactory;
+import android.graphics.Color;
+import android.os.SystemClock;
+import android.util.Base64;
+
+import org.json.JSONArray;
+import org.json.JSONException;
+import org.json.JSONObject;
+
+import org.chromium.base.Callback;
+import org.chromium.base.task.PostTask;
+import org.chromium.base.task.TaskTraits;
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.chrome.R;
+import org.chromium.content_public.browser.WebContents;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+
+/**
+ * Finds the file that holds the video under a press.
+ *
+ * <p>A feed plays most of its videos from a blob, so the pressed element has no file address, and
+ * the page has fetched files for several videos at once. The script, {@code
+ * res/raw/bare_video_match.js}, matches the pressed video to a file by its picture size and then by
+ * its length, which it reads from the start of each file. It also finds the separate sound file
+ * when the site keeps picture and sound apart. Only files that fit the pressed video are returned;
+ * when none fit, nothing is.
+ */
+@NullMarked
+public final class BareVideoMatch {
+    private BareVideoMatch() {}
+
+    private static final long POLL_MS = 150;
+    private static final long MAX_WAIT_MS = 10_000;
+    private static final int MAX_OPTIONS = 8;
+
+    /** Why there is nothing to save. */
+    public static final String NOTHING = "nothing";
+
+    /** Two videos lie under the press. */
+    public static final String TWO = "two";
+
+    /** The video is protected (DRM) and is not saved. */
+    public static final String PROTECTED = "protected";
+
+    /** The page fetched only a playlist and its pieces, never a whole file. */
+    public static final String STREAM = "stream";
+
+    /** One file that could be the pressed video. */
+    public static final class Option {
+        public final String video;
+
+        /** The separate sound file to join to the video, or null when there is none. */
+        public final @Nullable String audio;
+
+        public final int width;
+        public final int height;
+        public final double durationSeconds;
+        public final long bytes;
+        public final long audioBytes;
+
+        /** Whether the video file has its own sound. */
+        public final boolean sound;
+
+        Option(
+                String video,
+                @Nullable String audio,
+                int width,
+                int height,
+                double durationSeconds,
+                long bytes,
+                long audioBytes,
+                boolean sound) {
+            this.video = video;
+            this.audio = audio;
+            this.width = width;
+            this.height = height;
+            this.durationSeconds = durationSeconds;
+            this.bytes = bytes;
+            this.audioBytes = audioBytes;
+            this.sound = sound;
+        }
+    }
+
+    /** What the page said. */
+    public static final class Result {
+        public final String why;
+        public final List<Option> options;
+
+        /** The pressed video's current picture, or null when the page could not draw it. */
+        public final @Nullable Bitmap thumbnail;
+
+        Result(String why, List<Option> options, @Nullable Bitmap thumbnail) {
+            this.why = why;
+            this.options = options;
+            this.thumbnail = thumbnail;
+        }
+
+        static Result nothing() {
+            return new Result(NOTHING, Collections.emptyList(), null);
+        }
+    }
+
+    /**
+     * Asks the page which file holds the video at the press, and passes on the answer. The answer
+     * comes within a few seconds; a page that does not answer in time gives nothing.
+     */
+    public static void find(
+            @Nullable WebContents webContents, int xDp, int yDp, Callback<Result> done) {
+        String script = BareMediaProbe.readRaw(R.raw.bare_video_match);
+        if (webContents == null || webContents.isDestroyed() || script.isEmpty()) {
+            done.onResult(Result.nothing());
+            return;
+        }
+        long deadline = SystemClock.uptimeMillis() + MAX_WAIT_MS;
+        BareScriptBridge.evaluate(
+                webContents,
+                script + "(" + xDp + "," + yDp + ")",
+                ignored -> poll(webContents, deadline, done));
+    }
+
+    private static void poll(WebContents webContents, long deadline, Callback<Result> done) {
+        if (webContents.isDestroyed()) {
+            done.onResult(Result.nothing());
+            return;
+        }
+        // Only the finished answer is sent back, as it carries a small picture.
+        BareScriptBridge.evaluate(
+                webContents,
+                "(function(){var s=window.__bareVideoMatch;"
+                        + "return JSON.stringify(s&&s.state==='done'?s:{state:'running'});})()",
+                json -> {
+                    Result result = parse(json);
+                    if (result != null) {
+                        done.onResult(result);
+                        return;
+                    }
+                    if (SystemClock.uptimeMillis() >= deadline) {
+                        done.onResult(Result.nothing());
+                        return;
+                    }
+                    PostTask.postDelayedTask(
+                            TaskTraits.UI_DEFAULT,
+                            () -> poll(webContents, deadline, done),
+                            POLL_MS);
+                });
+    }
+
+    /** Reads the script's answer; null while it is still working. */
+    static @Nullable Result parse(@Nullable String scriptResult) {
+        if (scriptResult == null) return Result.nothing();
+        try {
+            Object decoded = new org.json.JSONTokener(scriptResult).nextValue();
+            if (!(decoded instanceof String)) return Result.nothing();
+            JSONObject state = new JSONObject((String) decoded);
+            if (!state.optString("state", "").equals("done")) return null;
+            List<Option> options = new ArrayList<>();
+            JSONArray list = state.optJSONArray("options");
+            for (int i = 0; list != null && i < list.length() && options.size() < MAX_OPTIONS; i++) {
+                JSONObject o = list.getJSONObject(i);
+                String video = o.optString("video", "");
+                String audio = o.optString("audio", "");
+                // The same rule as every other address taken from a page: a web file, or a file
+                // on this machine for a local test page. Anything else is dropped.
+                if (!BareMediaProbe.isFileAddress(video)) continue;
+                boolean hasAudio = !audio.isEmpty() && BareMediaProbe.isFileAddress(audio);
+                options.add(
+                        new Option(
+                                video,
+                                hasAudio ? audio : null,
+                                o.optInt("width", 0),
+                                o.optInt("height", 0),
+                                o.optDouble("duration", 0),
+                                o.optLong("bytes", 0),
+                                hasAudio ? o.optLong("audioBytes", 0) : 0,
+                                o.optBoolean("sound", true)));
+            }
+            String why = options.isEmpty() ? state.optString("why", NOTHING) : "";
+            if (options.isEmpty() && why.isEmpty()) why = NOTHING;
+            JSONObject pressed = state.optJSONObject("pressed");
+            Bitmap thumbnail = pressed == null ? null : decodeThumbnail(pressed.optString("thumb"));
+            return new Result(why, options, thumbnail);
+        } catch (JSONException e) {
+            return Result.nothing();
+        }
+    }
+
+    private static @Nullable Bitmap decodeThumbnail(String dataUrl) {
+        String prefix = "data:image/jpeg;base64,";
+        if (!dataUrl.startsWith(prefix) || dataUrl.length() > 200_000) return null;
+        try {
+            byte[] bytes = Base64.decode(dataUrl.substring(prefix.length()), Base64.DEFAULT);
+            Bitmap bitmap = BitmapFactory.decodeByteArray(bytes, 0, bytes.length);
+            return bitmap == null || isDark(bitmap) ? null : bitmap;
+        } catch (IllegalArgumentException e) {
+            return null;
+        }
+    }
+
+    /**
+     * Whether a picture is black, or all but black, all over. A phone can hand the page a black
+     * frame instead of the video's picture; the card then shows its placeholder, not a black box.
+     */
+    private static boolean isDark(Bitmap bitmap) {
+        int width = bitmap.getWidth();
+        int height = bitmap.getHeight();
+        for (int y = 0; y < 8; y++) {
+            for (int x = 0; x < 8; x++) {
+                int pixel = bitmap.getPixel(x * (width - 1) / 7, y * (height - 1) / 7);
+                int light = Color.red(pixel) * 3 + Color.green(pixel) * 6 + Color.blue(pixel);
+                if (light > 240) return false;
+            }
+        }
+        return true;
+    }
+}

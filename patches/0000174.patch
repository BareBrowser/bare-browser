diff --git a/chrome/android/junit/src/org/chromium/chrome/browser/bare/translate/BareTranslateProtocolUnitTest.java b/chrome/android/junit/src/org/chromium/chrome/browser/bare/translate/BareTranslateProtocolUnitTest.java

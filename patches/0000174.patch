+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.bare.translate;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+
+import org.junit.After;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+
+import org.chromium.base.test.BaseRobolectricTestRunner;
+import org.chromium.chrome.browser.preferences.ChromePreferenceKeys;
+import org.chromium.chrome.browser.preferences.ChromeSharedPreferences;
+
+/** Unit tests for {@link BareTranslateSettings}. */
+@RunWith(BaseRobolectricTestRunner.class)
+public class BareTranslateSettingsUnitTest {
+    @After
+    public void tearDown() {
+        ChromeSharedPreferences.getInstance().removeKey(ChromePreferenceKeys.BARE_TRANSLATE_ENDPOINT);
+        ChromeSharedPreferences.getInstance().removeKey(ChromePreferenceKeys.BARE_TRANSLATE_API_KEY);
+        ChromeSharedPreferences.getInstance().removeKey(ChromePreferenceKeys.BARE_TRANSLATE_TARGET);
+        ChromeSharedPreferences.getInstance()
+                .removeKey(ChromePreferenceKeys.BARE_TRANSLATE_CONSENT_HOST);
+    }
+
+    @Test
+    public void testNothingIsConfiguredUntilTheUserSetsAnAddress() {
+        assertFalse(BareTranslateSettings.isConfigured());
+        assertEquals("", BareTranslateSettings.getEndpoint());
+    }
+
+    @Test
+    public void testAnAddressTurnsItOnAndAnUnusableOneDoesNot() {
+        BareTranslateSettings.setEndpoint("  https://t.example.com  ");
+        assertTrue(BareTranslateSettings.isConfigured());
+        assertEquals("https://t.example.com", BareTranslateSettings.getEndpoint());
+
+        BareTranslateSettings.setEndpoint("http://t.example.com");
+        assertFalse(BareTranslateSettings.isConfigured());
+
+        BareTranslateSettings.setEndpoint("");
+        assertFalse(BareTranslateSettings.isConfigured());
+    }
+
+    @Test
+    public void testTheTargetFallsBackToEnglishForAnUnknownCode() {
+        BareTranslateSettings.setTargetLanguage("xx");
+        assertTrue(BareTranslateSettings.TARGET_LANGUAGES.contains(BareTranslateSettings.getTargetLanguage()));
+        BareTranslateSettings.setTargetLanguage("es");
+        assertEquals("es", BareTranslateSettings.getTargetLanguage());
+    }
+
+    @Test
+    public void testConsentBelongsToOneHost() {
+        BareTranslateSettings.setEndpoint("https://one.example.com");
+        assertFalse(BareTranslateSettings.hasConsent());
+        BareTranslateSettings.setConsentedHost("one.example.com");
+        assertTrue(BareTranslateSettings.hasConsent());
+
+        // Pointing it somewhere else asks again.
+        BareTranslateSettings.setEndpoint("https://two.example.com");
+        assertFalse(BareTranslateSettings.hasConsent());
+    }
+
+    @Test
+    public void testTheKeyIsKeptAndCleared() {
+        BareTranslateSettings.setApiKey("abc");
+        assertEquals("abc", BareTranslateSettings.getApiKey());
+        BareTranslateSettings.setApiKey("");
+        assertEquals("", BareTranslateSettings.getApiKey());
+    }
+}

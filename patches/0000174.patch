diff --git a/chrome/browser/ui/android/bare_script_bridge.cc b/chrome/browser/ui/android/bare_script_bridge.cc
new file mode 100644
index 00000000000..e91952294d8
--- /dev/null
+++ b/chrome/browser/ui/android/bare_script_bridge.cc
@@ -0,0 +1,61 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "base/android/jni_android.h"
+#include "base/android/jni_string.h"
+#include "base/android/scoped_java_ref.h"
+#include "base/functional/bind.h"
+#include "base/json/json_writer.h"
+#include "base/values.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/common/isolated_world_ids.h"
+
+// Must come after all headers that specialize FromJniType() / ToJniType().
+#include "chrome/android/chrome_jni_headers/BareScriptBridge_jni.h"
+
+namespace {
+
+// One world for everything Bare runs in a page, apart from the store's layout
+// script, which has its own. A world keeps the variables a script leaves, which
+// is what lets a page be read in one call and written back in a later one.
+constexpr int32_t kBareWorld = content::ISOLATED_WORLD_ID_CONTENT_END + 1;
+
+void OnResult(base::android::ScopedJavaGlobalRef<jobject> callback,
+              base::Value value) {
+  std::string json;
+  if (std::optional<std::string> written = base::WriteJson(value)) {
+    json = std::move(*written);
+  }
+  Java_BareScriptBridge_onResult(base::android::AttachCurrentThread(),
+                                 callback, json);
+}
+
+}  // namespace
+
+static void JNI_BareScriptBridge_Evaluate(
+    JNIEnv* env,
+    const base::android::JavaRef<jobject>& jweb_contents,
+    const base::android::JavaRef<jstring>& jscript,
+    const base::android::JavaRef<jobject>& jcallback) {
+  content::WebContents* web_contents =
+      content::WebContents::FromJavaWebContents(jweb_contents);
+  if (!web_contents) {
+    return;
+  }
+  content::RenderFrameHost* frame = web_contents->GetPrimaryMainFrame();
+  if (!frame || !frame->IsRenderFrameLive()) {
+    return;
+  }
+  content::RenderFrameHost::JavaScriptResultCallback callback;
+  if (jcallback) {
+    callback = base::BindOnce(
+        &OnResult, base::android::ScopedJavaGlobalRef<jobject>(jcallback));
+  }
+  frame->ExecuteJavaScriptInIsolatedWorld(
+      base::android::ConvertJavaStringToUTF16(env, jscript),
+      std::move(callback), kBareWorld);
+}
+
+DEFINE_JNI(BareScriptBridge)

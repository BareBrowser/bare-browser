@@ -0,0 +1,59 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.bare;
+
+import org.jni_zero.CalledByNative;
+import org.jni_zero.JniType;
+import org.jni_zero.NativeMethods;
+
+import org.chromium.base.Callback;
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.content_public.browser.WebContents;
+
+/**
+ * Runs a script in a page's main frame, in a world of its own.
+ *
+ * <p>WebContents.evaluateJavaScript runs in the page's own world and is refused for web pages: the
+ * browser stops if it is asked to. This runs the script in an isolated world instead, which sees
+ * the page's DOM but not its variables, and which the page cannot see or change. Variables the
+ * script leaves behind stay in that world, so a later call finds what an earlier one set up.
+ *
+ * <p>The result comes back as JSON text, the same shape evaluateJavaScript returns: a string
+ * comes back as a quoted JSON string.
+ */
+@NullMarked
+public final class BareScriptBridge {
+    private BareScriptBridge() {}
+
+    /**
+     * Runs {@code script}, and passes its result to {@code callback} if one is given. The callback
+     * gets null if there is no page to run it in.
+     */
+    public static void evaluate(
+            @Nullable WebContents webContents,
+            String script,
+            @Nullable Callback<@Nullable String> callback) {
+        if (webContents == null || webContents.isDestroyed()) {
+            if (callback != null) callback.onResult(null);
+            return;
+        }
+        BareScriptBridgeJni.get().evaluate(webContents, script, callback);
+    }
+
+    @CalledByNative
+    private static void onResult(
+            Callback<@Nullable String> callback, @JniType("std::string") String json) {
+        callback.onResult(json);
+    }
+
+    @NativeMethods
+    interface Natives {
+        void evaluate(
+                WebContents webContents,
+                String script,
+                @Nullable Callback<@Nullable String> callback);
+    }
+}
diff --git a/chrome/android/java/src/org/chromium/chrome/browser/bare/translate/BarePageTranslator.java b/chrome/android/java/src/org/chromium/chrome/browser/bare/translate/BarePageTranslator.java
new file mode 100644
index 00000000000..f858a82a4b3
--- /dev/null
+++ b/chrome/android/java/src/org/chromium/chrome/browser/bare/translate/BarePageTranslator.java
@@ -0,0 +1,241 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.bare.translate;
+
+import android.app.Activity;
+import android.content.Context;
+import android.widget.Toast;
+
+import androidx.appcompat.app.AlertDialog;
+
+import org.json.JSONArray;
+import org.json.JSONException;
+import org.json.JSONTokener;
+
+import org.chromium.base.Log;
+import org.chromium.base.task.PostTask;
+import org.chromium.base.task.TaskTraits;
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.chrome.R;
+import org.chromium.chrome.browser.bare.BareScriptBridge;
+import org.chromium.chrome.browser.tab.Tab;
+import org.chromium.content_public.browser.WebContents;
+
+import java.io.ByteArrayOutputStream;
+import java.io.InputStream;
+import java.io.OutputStream;
+import java.net.HttpURLConnection;
+import java.net.URL;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+
+/**
+ * Translates the text of a page by sending it to the server the user chose, and puts the result
+ * back in place.
+ *
+ * <p>The page is read through a script that collects its visible text nodes, the text goes to the
+ * server in batches, and each batch is written straight back into the nodes it came from, so the
+ * page fills in as the answers arrive and keeps its own layout, links and scripts. The original
+ * text is kept in the page so that translating again restores it.
+ *
+ * <p>What is sent is the text of the page and the target language, with the API key if the user
+ * gave one. No cookies, address, or identifier are sent, and nothing is sent until the user has
+ * agreed, once for each server, to sending page text to it.
+ */
+@NullMarked
+public final class BarePageTranslator {
+    private static final String TAG = "BareTranslate";
+
+    /** The tabs showing a translation, by tab id, with the address that was translated. */
+    private static final Map<Integer, String> sTranslated = new HashMap<>();
+
+    private BarePageTranslator() {}
+
+    /**
+     * Collects the text nodes of the page. Returns the strings as JSON and keeps the nodes in a
+     * page-side object that the later calls write into.
+     */
+    static final String COLLECT_SCRIPT =
+            "(function(){var SKIP={SCRIPT:1,STYLE:1,NOSCRIPT:1,CODE:1,PRE:1,TEXTAREA:1,SVG:1,"
+                    + "IFRAME:1};var nodes=[],texts=[];function ok(n){for(var p=n.parentElement;p;"
+                    + "p=p.parentElement){if(SKIP[p.tagName]||p.isContentEditable||"
+                    + "p.getAttribute('translate')==='no')return false;}return true;}"
+                    + "var w=document.createTreeWalker(document.body||document.documentElement,"
+                    + "NodeFilter.SHOW_TEXT);var total=0;while(w.nextNode()&&nodes.length<4000"
+                    + "&&total<300000){var n=w.currentNode,t=n.nodeValue;if(t.trim().length<2||"
+                    + "!/\\p{L}/u.test(t)||!ok(n))continue;nodes.push(n);texts.push(t);"
+                    + "total+=t.length;}var orig=texts.slice();window.__bareTr={nodes:nodes,"
+                    + "orig:orig,apply:function(s,a){for(var i=0;i<a.length;i++){var n=nodes[s+i];"
+                    + "if(!n||typeof a[i]!=='string')continue;var o=orig[s+i];"
+                    + "n.nodeValue=o.match(/^\\s*/)[0]+a[i].trim()+o.match(/\\s*$/)[0];}return 1;},"
+                    + "restore:function(){for(var i=0;i<nodes.length;i++)nodes[i].nodeValue="
+                    + "orig[i];window.__bareTr=null;return 1;}};return JSON.stringify(texts.map("
+                    + "function(t){return t.trim();}));})()";
+
+    static final String RESTORE_SCRIPT =
+            "(function(){return window.__bareTr?window.__bareTr.restore():0;})()";
+
+    /** Whether the tab is showing a translation of its current page. */
+    public static boolean isTranslated(@Nullable Tab tab) {
+        if (tab == null) return false;
+        String url = sTranslated.get(tab.getId());
+        return url != null && url.equals(tab.getUrl().getSpec());
+    }
+
+    /** What the menu item does: translates the page, or puts the original back. */
+    public static void onMenuItemClicked(Activity activity, Tab tab) {
+        WebContents webContents = tab.getWebContents();
+        if (webContents == null) return;
+        if (isTranslated(tab)) {
+            BareScriptBridge.evaluate(webContents, RESTORE_SCRIPT, null);
+            sTranslated.remove(tab.getId());
+            return;
+        }
+        if (!BareTranslateSettings.isConfigured()) {
+            Toast.makeText(activity, R.string.bare_translate_not_set_up, Toast.LENGTH_LONG).show();
+            return;
+        }
+        if (BareTranslateSettings.hasConsent()) {
+            start(activity, tab);
+            return;
+        }
+        String host = BareTranslateSettings.getEndpointHost();
+        new AlertDialog.Builder(activity, R.style.ThemeOverlay_BrowserUI_AlertDialog)
+                .setTitle(R.string.bare_translate_consent_title)
+                .setMessage(activity.getString(R.string.bare_translate_consent_message, host))
+                .setPositiveButton(
+                        R.string.bare_translate_consent_ok,
+                        (dialog, which) -> {
+                            BareTranslateSettings.setConsentedHost(host);
+                            start(activity, tab);
+                        })
+                .setNegativeButton(R.string.cancel, null)
+                .show();
+    }
+
+    private static void start(Context context, Tab tab) {
+        WebContents webContents = tab.getWebContents();
+        if (webContents == null) return;
+        final String url = tab.getUrl().getSpec();
+        final int tabId = tab.getId();
+        Toast.makeText(context, R.string.bare_translate_working, Toast.LENGTH_SHORT).show();
+        BareScriptBridge.evaluate(
+                webContents,
+                COLLECT_SCRIPT,
+                result -> {
+                    List<String> texts = decodeCollected(result);
+                    if (texts == null || texts.isEmpty()) {
+                        Toast.makeText(context, R.string.bare_translate_nothing, Toast.LENGTH_LONG)
+                                .show();
+                        return;
+                    }
+                    List<int[]> batches =
+                            BareTranslateProtocol.batches(
+                                    texts,
+                                    BareTranslateProtocol.MAX_ITEMS_PER_REQUEST,
+                                    BareTranslateProtocol.MAX_CHARS_PER_REQUEST);
+                    String endpoint = BareTranslateSettings.getEndpoint();
+                    String key = BareTranslateSettings.getApiKey();
+                    String target = BareTranslateSettings.getTargetLanguage();
+                    sTranslated.put(tabId, url);
+                    PostTask.postTask(
+                            TaskTraits.BEST_EFFORT_MAY_BLOCK,
+                            () -> run(context, webContents, texts, batches, endpoint, key, target));
+                });
+    }
+
+    /** Reads the string the collect script returned: a JSON string holding a JSON array. */
+    static @Nullable List<String> decodeCollected(@Nullable String result) {
+        if (result == null) return null;
+        try {
+            Object value = new JSONTokener(result).nextValue();
+            if (!(value instanceof String)) return null;
+            JSONArray array = new JSONArray((String) value);
+            List<String> texts = new ArrayList<>();
+            for (int i = 0; i < array.length(); i++) texts.add(array.getString(i));
+            return texts;
+        } catch (JSONException e) {
+            return null;
+        }
+    }
+
+    /** Runs on a background thread: one request per batch, each written back as it arrives. */
+    private static void run(
+            Context context,
+            WebContents webContents,
+            List<String> texts,
+            List<int[]> batches,
+            String endpoint,
+            String key,
+            String target) {
+        for (int[] range : batches) {
+            List<String> chunk = texts.subList(range[0], range[1]);
+            @Nullable List<String> translated;
+            try {
+                translated = post(endpoint, key, target, chunk);
+            } catch (Exception e) {
+                Log.w(TAG, "Translation request failed: %s", e.getClass().getSimpleName());
+                translated = null;
+            }
+            if (translated == null) {
+                PostTask.postTask(
+                        TaskTraits.UI_DEFAULT,
+                        () ->
+                                Toast.makeText(
+                                                context,
+                                                R.string.bare_translate_failed,
+                                                Toast.LENGTH_LONG)
+                                        .show());
+                return;
+            }
+            final String script =
+                    "window.__bareTr&&window.__bareTr.apply("
+                            + range[0]
+                            + ","
+                            + new JSONArray(translated)
+                            + ")";
+            PostTask.postTask(
+                    TaskTraits.UI_DEFAULT, () -> BareScriptBridge.evaluate(webContents, script, null));
+        }
+    }
+
+    private static @Nullable List<String> post(
+            String endpoint, String key, String target, List<String> chunk) throws Exception {
+        HttpURLConnection connection =
+                (HttpURLConnection)
+                        new URL(BareTranslateProtocol.translateUrl(endpoint)).openConnection();
+        try {
+            connection.setRequestMethod("POST");
+            connection.setConnectTimeout(15000);
+            connection.setReadTimeout(30000);
+            connection.setDoOutput(true);
+            connection.setRequestProperty("Content-Type", "application/json; charset=utf-8");
+            byte[] body =
+                    BareTranslateProtocol.requestBody(chunk, target, key)
+                            .getBytes(StandardCharsets.UTF_8);
+            try (OutputStream out = connection.getOutputStream()) {
+                out.write(body);
+            }
+            if (connection.getResponseCode() != HttpURLConnection.HTTP_OK) return null;
+            return BareTranslateProtocol.parseResponse(readAll(connection), chunk.size());
+        } finally {
+            connection.disconnect();
+        }
+    }
+
+    private static String readAll(HttpURLConnection connection) throws Exception {
+        try (InputStream in = connection.getInputStream();
+                ByteArrayOutputStream out = new ByteArrayOutputStream()) {
+            byte[] buffer = new byte[8192];
+            int read;
+            while ((read = in.read(buffer)) > 0) out.write(buffer, 0, read);
+            return out.toString("UTF-8");
+        }
+    }
+}

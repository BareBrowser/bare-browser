+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.bare.translate;
+
+import android.app.AlertDialog;
+import android.content.Context;
+import android.os.Bundle;
+import android.text.InputType;
+import android.widget.EditText;
+import android.widget.FrameLayout;
+
+import androidx.preference.ListPreference;
+import androidx.preference.Preference;
+
+import org.chromium.base.supplier.MonotonicObservableSupplier;
+import org.chromium.base.supplier.ObservableSuppliers;
+import org.chromium.base.supplier.SettableMonotonicObservableSupplier;
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.chrome.R;
+import org.chromium.chrome.browser.settings.ChromeBaseSettingsFragment;
+import org.chromium.components.browser_ui.settings.SettingsUtils;
+
+import java.util.Locale;
+
+/** Settings for translating pages through a server the user chooses. */
+@NullMarked
+public class BareTranslateSettingsFragment extends ChromeBaseSettingsFragment {
+    static final String PREF_SERVER = "bare_translate_server";
+    static final String PREF_KEY = "bare_translate_key";
+    static final String PREF_TARGET = "bare_translate_target";
+
+    private final SettableMonotonicObservableSupplier<String> mPageTitle =
+            ObservableSuppliers.createMonotonic();
+
+    @Override
+    public void onCreatePreferences(@Nullable Bundle savedInstanceState, @Nullable String rootKey) {
+        mPageTitle.set(getTitle(getContext()));
+        SettingsUtils.addPreferencesFromResource(this, R.xml.bare_translate_preferences);
+
+        Preference server = findPreference(PREF_SERVER);
+        assert server != null;
+        server.setOnPreferenceClickListener(
+                preference -> {
+                    askForText(
+                            R.string.bare_translate_server_title,
+                            R.string.bare_translate_server_hint,
+                            BareTranslateSettings.getEndpoint(),
+                            InputType.TYPE_TEXT_VARIATION_URI,
+                            value -> {
+                                BareTranslateSettings.setEndpoint(value);
+                                updateSummaries();
+                            });
+                    return true;
+                });
+        Preference key = findPreference(PREF_KEY);
+        assert key != null;
+        key.setOnPreferenceClickListener(
+                preference -> {
+                    askForText(
+                            R.string.bare_translate_key_title,
+                            R.string.bare_translate_key_hint,
+                            BareTranslateSettings.getApiKey(),
+                            InputType.TYPE_TEXT_VARIATION_PASSWORD,
+                            value -> {
+                                BareTranslateSettings.setApiKey(value.trim());
+                                updateSummaries();
+                            });
+                    return true;
+                });
+
+        ListPreference target = findPreference(PREF_TARGET);
+        assert target != null;
+        target.setPersistent(false);
+        int count = BareTranslateSettings.TARGET_LANGUAGES.size();
+        CharSequence[] names = new CharSequence[count];
+        CharSequence[] codes = new CharSequence[count];
+        for (int i = 0; i < count; i++) {
+            String code = BareTranslateSettings.TARGET_LANGUAGES.get(i);
+            Locale locale = Locale.forLanguageTag(code);
+            names[i] = locale.getDisplayLanguage(locale) + " (" + code + ")";
+            codes[i] = code;
+        }
+        target.setEntries(names);
+        target.setEntryValues(codes);
+        target.setValue(BareTranslateSettings.getTargetLanguage());
+        target.setOnPreferenceChangeListener(
+                (preference, newValue) -> {
+                    BareTranslateSettings.setTargetLanguage((String) newValue);
+                    updateSummaries();
+                    return true;
+                });
+        updateSummaries();
+    }
+
+    private void updateSummaries() {
+        Preference server = findPreference(PREF_SERVER);
+        Preference key = findPreference(PREF_KEY);
+        ListPreference target = findPreference(PREF_TARGET);
+        if (server == null || key == null || target == null) return;
+        String endpoint = BareTranslateSettings.getEndpoint();
+        if (endpoint.isEmpty()) {
+            server.setSummary(R.string.bare_translate_server_unset);
+        } else if (!BareTranslateSettings.isConfigured()) {
+            server.setSummary(getString(R.string.bare_translate_server_refused, endpoint));
+        } else {
+            server.setSummary(endpoint);
+        }
+        key.setSummary(
+                BareTranslateSettings.getApiKey().isEmpty()
+                        ? R.string.bare_translate_key_unset
+                        : R.string.bare_translate_key_set);
+        target.setSummary(target.getEntry());
+    }
+
+    private interface OnText {
+        void onText(String value);
+    }
+
+    private void askForText(int titleRes, int hintRes, String current, int inputType, OnText done) {
+        Context context = requireContext();
+        EditText input = new EditText(context);
+        input.setInputType(InputType.TYPE_CLASS_TEXT | inputType);
+        input.setHint(hintRes);
+        input.setText(current);
+        input.setSingleLine(true);
+        FrameLayout frame = new FrameLayout(context);
+        int pad = Math.round(20 * context.getResources().getDisplayMetrics().density);
+        frame.setPadding(pad, pad / 2, pad, 0);
+        frame.addView(input);
+        new AlertDialog.Builder(context, R.style.ThemeOverlay_BrowserUI_AlertDialog)
+                .setTitle(titleRes)
+                .setView(frame)
+                .setPositiveButton(
+                        android.R.string.ok,
+                        (dialog, which) -> done.onText(input.getText().toString()))
+                .setNegativeButton(android.R.string.cancel, null)
+                .show();
+    }
+
+    @Override
+    public MonotonicObservableSupplier<String> getPageTitle() {
+        return mPageTitle;
+    }
+
+    public static String getTitle(Context context) {
+        return context.getString(R.string.bare_translate_settings_title);
+    }
+
+    @Override
+    public @AnimationType int getAnimationType() {
+        return AnimationType.PROPERTY;
+    }
+
+    @Override
+    public @Nullable String getMainMenuKey() {
+        return "bare_translate";
+    }
+}

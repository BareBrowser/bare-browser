@@ -0,0 +1,155 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.bare.translate;
+
+import android.net.Uri;
+
+import org.json.JSONArray;
+import org.json.JSONException;
+import org.json.JSONObject;
+
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Locale;
+
+/**
+ * The request and response of a LibreTranslate-style server, which is a plain JSON POST that takes
+ * a list of strings and returns a list of strings. Kept free of Android networking so that it can
+ * be tested without a server.
+ */
+@NullMarked
+public final class BareTranslateProtocol {
+    /** Most strings sent in one request. */
+    public static final int MAX_ITEMS_PER_REQUEST = 40;
+
+    /** Most characters sent in one request, counted before escaping. */
+    public static final int MAX_CHARS_PER_REQUEST = 4000;
+
+    private BareTranslateProtocol() {}
+
+    /**
+     * Whether an address is one text may be sent to.
+     *
+     * <p>https is required, because the text of a page is the user's. Plain http is accepted for
+     * the addresses that stay on the user's own network, which is where a server run at home or
+     * on a laptop lives.
+     */
+    public static boolean isAllowedEndpoint(String endpoint) {
+        if (endpoint.isEmpty()) return false;
+        Uri uri = Uri.parse(endpoint);
+        String scheme = uri.getScheme();
+        String host = uri.getHost();
+        if (scheme == null || host == null || host.isEmpty()) return false;
+        scheme = scheme.toLowerCase(Locale.ROOT);
+        if (scheme.equals("https")) return true;
+        return scheme.equals("http") && isLocalHost(host);
+    }
+
+    static boolean isLocalHost(String host) {
+        String h = host.toLowerCase(Locale.ROOT);
+        if (h.equals("localhost") || h.endsWith(".local") || h.endsWith(".lan")) return true;
+        if (h.startsWith("127.") || h.startsWith("10.") || h.startsWith("192.168.")) return true;
+        if (h.startsWith("172.")) {
+            String[] parts = h.split("\\.");
+            if (parts.length == 4) {
+                try {
+                    int second = Integer.parseInt(parts[1]);
+                    return second >= 16 && second <= 31;
+                } catch (NumberFormatException e) {
+                    return false;
+                }
+            }
+        }
+        return false;
+    }
+
+    /** The address requests are posted to, whether or not the user typed the /translate part. */
+    public static String translateUrl(String endpoint) {
+        String base = endpoint.trim();
+        while (base.endsWith("/")) base = base.substring(0, base.length() - 1);
+        return base.endsWith("/translate") ? base : base + "/translate";
+    }
+
+    /**
+     * Splits strings into requests.
+     *
+     * @return Pairs of start index and end index (exclusive) into {@code texts}, in order. A single
+     *     string longer than the limit goes alone.
+     */
+    public static List<int[]> batches(List<String> texts, int maxItems, int maxChars) {
+        List<int[]> result = new ArrayList<>();
+        int start = 0;
+        int chars = 0;
+        for (int i = 0; i < texts.size(); i++) {
+            int length = texts.get(i).length();
+            boolean full = i - start >= maxItems || (i > start && chars + length > maxChars);
+            if (full) {
+                result.add(new int[] {start, i});
+                start = i;
+                chars = 0;
+            }
+            chars += length;
+        }
+        if (start < texts.size()) result.add(new int[] {start, texts.size()});
+        return result;
+    }
+
+    /** The JSON body asking for a translation of {@code strings} into {@code target}. */
+    public static String requestBody(List<String> strings, String target, String apiKey) {
+        try {
+            JSONObject body = new JSONObject();
+            body.put("q", new JSONArray(strings));
+            body.put("source", "auto");
+            body.put("target", target);
+            body.put("format", "text");
+            if (!apiKey.isEmpty()) body.put("api_key", apiKey);
+            return body.toString();
+        } catch (JSONException e) {
+            throw new IllegalStateException(e);
+        }
+    }
+
+    /**
+     * Reads the translated strings out of a response.
+     *
+     * @return The strings, or null if the response is not a list of exactly {@code expected}.
+     */
+    public static @Nullable List<String> parseResponse(String body, int expected) {
+        try {
+            JSONObject json = new JSONObject(body);
+            JSONArray array = json.optJSONArray("translatedText");
+            if (array == null) {
+                // A single string back for a single string sent.
+                String single = json.optString("translatedText", "");
+                if (expected == 1 && !single.isEmpty()) {
+                    List<String> one = new ArrayList<>();
+                    one.add(single);
+                    return one;
+                }
+                return null;
+            }
+            if (array.length() != expected) return null;
+            List<String> result = new ArrayList<>();
+            for (int i = 0; i < array.length(); i++) {
+                result.add(array.getString(i));
+            }
+            return result;
+        } catch (JSONException e) {
+            return null;
+        }
+    }
+
+    /** The message a server put in an error response, if it did. */
+    public static String errorMessage(String body) {
+        try {
+            return new JSONObject(body).optString("error", "");
+        } catch (JSONException e) {
+            return "";
+        }
+    }
+}

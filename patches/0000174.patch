@@ -0,0 +1,110 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.bare.translate;
+
+import android.net.Uri;
+
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.chrome.browser.preferences.ChromePreferenceKeys;
+import org.chromium.chrome.browser.preferences.ChromeSharedPreferences;
+
+import java.util.Arrays;
+import java.util.List;
+import java.util.Locale;
+
+/**
+ * Where page translation sends its text, and into which language.
+ *
+ * <p>Bare ships no translation service and no default address for one. Nothing is translated and
+ * the menu item stays hidden until the user has entered the address of a server of their own
+ * choosing, so no page text leaves the device by default.
+ */
+@NullMarked
+public final class BareTranslateSettings {
+    /** The languages offered as a target, as the codes the server expects. */
+    public static final List<String> TARGET_LANGUAGES =
+            Arrays.asList(
+                    "en", "ar", "az", "zh", "cs", "da", "nl", "eo", "fi", "fr", "de", "el", "he",
+                    "hi", "hu", "id", "ga", "it", "ja", "ko", "fa", "pl", "pt", "ru", "sk", "es",
+                    "sv", "tr", "uk", "vi");
+
+    private BareTranslateSettings() {}
+
+    /** The address the user entered, or empty. */
+    public static String getEndpoint() {
+        return ChromeSharedPreferences.getInstance()
+                .readString(ChromePreferenceKeys.BARE_TRANSLATE_ENDPOINT, "")
+                .trim();
+    }
+
+    public static void setEndpoint(String endpoint) {
+        String trimmed = endpoint.trim();
+        if (trimmed.isEmpty()) {
+            ChromeSharedPreferences.getInstance()
+                    .removeKey(ChromePreferenceKeys.BARE_TRANSLATE_ENDPOINT);
+        } else {
+            ChromeSharedPreferences.getInstance()
+                    .writeString(ChromePreferenceKeys.BARE_TRANSLATE_ENDPOINT, trimmed);
+        }
+    }
+
+    public static String getApiKey() {
+        return ChromeSharedPreferences.getInstance()
+                .readString(ChromePreferenceKeys.BARE_TRANSLATE_API_KEY, "");
+    }
+
+    public static void setApiKey(String key) {
+        if (key.isEmpty()) {
+            ChromeSharedPreferences.getInstance()
+                    .removeKey(ChromePreferenceKeys.BARE_TRANSLATE_API_KEY);
+        } else {
+            ChromeSharedPreferences.getInstance()
+                    .writeString(ChromePreferenceKeys.BARE_TRANSLATE_API_KEY, key);
+        }
+    }
+
+    /** The language to translate into: the one chosen, else the device's, else English. */
+    public static String getTargetLanguage() {
+        String stored =
+                ChromeSharedPreferences.getInstance()
+                        .readString(ChromePreferenceKeys.BARE_TRANSLATE_TARGET, "");
+        if (TARGET_LANGUAGES.contains(stored)) return stored;
+        String device = Locale.getDefault().getLanguage();
+        return TARGET_LANGUAGES.contains(device) ? device : "en";
+    }
+
+    public static void setTargetLanguage(String language) {
+        ChromeSharedPreferences.getInstance()
+                .writeString(ChromePreferenceKeys.BARE_TRANSLATE_TARGET, language);
+    }
+
+    /** Whether there is a usable address, which is what turns the feature on. */
+    public static boolean isConfigured() {
+        return BareTranslateProtocol.isAllowedEndpoint(getEndpoint());
+    }
+
+    /** The host the user has agreed to send page text to, or empty. */
+    public static String getConsentedHost() {
+        return ChromeSharedPreferences.getInstance()
+                .readString(ChromePreferenceKeys.BARE_TRANSLATE_CONSENT_HOST, "");
+    }
+
+    public static void setConsentedHost(String host) {
+        ChromeSharedPreferences.getInstance()
+                .writeString(ChromePreferenceKeys.BARE_TRANSLATE_CONSENT_HOST, host);
+    }
+
+    /** The host of the configured address, or empty. */
+    public static String getEndpointHost() {
+        String host = Uri.parse(getEndpoint()).getHost();
+        return host == null ? "" : host;
+    }
+
+    /** Whether the user has already agreed to send text to the configured host. */
+    public static boolean hasConsent() {
+        String host = getEndpointHost();
+        return !host.isEmpty() && host.equals(getConsentedHost());
+    }
+}

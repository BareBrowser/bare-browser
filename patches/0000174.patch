index 00000000000..07c147208dd
--- /dev/null
+++ b/chrome/android/junit/src/org/chromium/chrome/browser/bare/translate/BareTranslateProtocolUnitTest.java
@@ -0,0 +1,151 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.bare.translate;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertNotNull;
+import static org.junit.Assert.assertNull;
+import static org.junit.Assert.assertTrue;
+
+import org.json.JSONArray;
+import org.json.JSONObject;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+
+import org.chromium.base.test.BaseRobolectricTestRunner;
+
+import java.util.Arrays;
+import java.util.Collections;
+import java.util.List;
+
+/** Unit tests for {@link BareTranslateProtocol}. */
+@RunWith(BaseRobolectricTestRunner.class)
+public class BareTranslateProtocolUnitTest {
+    @Test
+    public void testHttpsIsAllowedAnywhere() {
+        assertTrue(BareTranslateProtocol.isAllowedEndpoint("https://translate.example.com"));
+        assertTrue(BareTranslateProtocol.isAllowedEndpoint("https://203.0.113.5:5000/translate"));
+    }
+
+    @Test
+    public void testPlainHttpOnlyOnTheUsersOwnNetwork() {
+        assertTrue(BareTranslateProtocol.isAllowedEndpoint("http://localhost:5000"));
+        assertTrue(BareTranslateProtocol.isAllowedEndpoint("http://127.0.0.1:8001"));
+        assertTrue(BareTranslateProtocol.isAllowedEndpoint("http://192.168.1.20:5000"));
+        assertTrue(BareTranslateProtocol.isAllowedEndpoint("http://10.0.0.4"));
+        assertTrue(BareTranslateProtocol.isAllowedEndpoint("http://172.20.1.1"));
+        assertTrue(BareTranslateProtocol.isAllowedEndpoint("http://nas.local:5000"));
+        assertFalse(BareTranslateProtocol.isAllowedEndpoint("http://172.32.1.1"));
+        assertFalse(BareTranslateProtocol.isAllowedEndpoint("http://translate.example.com"));
+        assertFalse(BareTranslateProtocol.isAllowedEndpoint("http://8.8.8.8"));
+    }
+
+    @Test
+    public void testNothingElseIsAllowed() {
+        assertFalse(BareTranslateProtocol.isAllowedEndpoint(""));
+        assertFalse(BareTranslateProtocol.isAllowedEndpoint("translate.example.com"));
+        assertFalse(BareTranslateProtocol.isAllowedEndpoint("ftp://translate.example.com"));
+        assertFalse(BareTranslateProtocol.isAllowedEndpoint("https://"));
+    }
+
+    @Test
+    public void testTheTranslatePathIsAddedOnce() {
+        assertEquals(
+                "https://t.example.com/translate",
+                BareTranslateProtocol.translateUrl("https://t.example.com"));
+        assertEquals(
+                "https://t.example.com/translate",
+                BareTranslateProtocol.translateUrl("https://t.example.com///"));
+        assertEquals(
+                "https://t.example.com/translate",
+                BareTranslateProtocol.translateUrl("https://t.example.com/translate"));
+        assertEquals(
+                "https://t.example.com/api/translate",
+                BareTranslateProtocol.translateUrl("https://t.example.com/api"));
+    }
+
+    @Test
+    public void testBatchesRespectBothLimits() {
+        List<String> texts = Arrays.asList("aaaa", "bbbb", "cccc", "dddd", "eeee");
+        List<int[]> byItems = BareTranslateProtocol.batches(texts, 2, 1000);
+        assertEquals(3, byItems.size());
+        assertEquals(0, byItems.get(0)[0]);
+        assertEquals(2, byItems.get(0)[1]);
+        assertEquals(4, byItems.get(2)[0]);
+        assertEquals(5, byItems.get(2)[1]);
+
+        List<int[]> byChars = BareTranslateProtocol.batches(texts, 100, 9);
+        assertEquals(3, byChars.size());
+        assertEquals(2, byChars.get(0)[1]);
+    }
+
+    @Test
+    public void testOneLongStringGoesAlone() {
+        List<String> texts = Arrays.asList("x", "yyyyyyyyyyyy", "z");
+        List<int[]> batches = BareTranslateProtocol.batches(texts, 10, 5);
+        assertEquals(3, batches.size());
+        assertEquals(1, batches.get(1)[0]);
+        assertEquals(2, batches.get(1)[1]);
+    }
+
+    @Test
+    public void testNoTextsMeansNoRequests() {
+        assertTrue(
+                BareTranslateProtocol.batches(Collections.<String>emptyList(), 10, 100).isEmpty());
+    }
+
+    @Test
+    public void testRequestBodyCarriesTheTextAndTheLanguageOnly() throws Exception {
+        JSONObject body =
+                new JSONObject(
+                        BareTranslateProtocol.requestBody(Arrays.asList("hola", "adios"), "en", ""));
+        JSONArray q = body.getJSONArray("q");
+        assertEquals("hola", q.getString(0));
+        assertEquals("adios", q.getString(1));
+        assertEquals("auto", body.getString("source"));
+        assertEquals("en", body.getString("target"));
+        assertFalse(body.has("api_key"));
+        assertEquals(4, body.length());
+    }
+
+    @Test
+    public void testTheKeyIsSentOnlyWhenGiven() throws Exception {
+        JSONObject body =
+                new JSONObject(
+                        BareTranslateProtocol.requestBody(Arrays.asList("hola"), "en", "k-123"));
+        assertEquals("k-123", body.getString("api_key"));
+    }
+
+    @Test
+    public void testAnAnswerOfTheRightLengthIsRead() {
+        List<String> parsed =
+                BareTranslateProtocol.parseResponse("{\"translatedText\":[\"hello\",\"bye\"]}", 2);
+        assertNotNull(parsed);
+        assertEquals("hello", parsed.get(0));
+        assertEquals("bye", parsed.get(1));
+    }
+
+    @Test
+    public void testAnAnswerOfTheWrongLengthIsRefused() {
+        assertNull(BareTranslateProtocol.parseResponse("{\"translatedText\":[\"hello\"]}", 2));
+        assertNull(BareTranslateProtocol.parseResponse("{\"error\":\"nope\"}", 1));
+        assertNull(BareTranslateProtocol.parseResponse("not json", 1));
+    }
+
+    @Test
+    public void testASingleStringAnswerIsAcceptedForOne() {
+        List<String> parsed =
+                BareTranslateProtocol.parseResponse("{\"translatedText\":\"hello\"}", 1);
+        assertNotNull(parsed);
+        assertEquals("hello", parsed.get(0));
+    }
+
+    @Test
+    public void testErrorMessagesAreRead() {
+        assertEquals("rate limited", BareTranslateProtocol.errorMessage("{\"error\":\"rate limited\"}"));
+        assertEquals("", BareTranslateProtocol.errorMessage("oops"));
+    }
+}

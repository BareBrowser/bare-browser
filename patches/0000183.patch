     /**
      * Whether fullscreen video follows the phone's orientation (the default) instead of the
@@ -1351,6 +1356,7 @@ public final class ChromePreferenceKeys {
                 DOWNLOAD_USE_EXTERNAL_DOWNLOAD_MANAGER,
                 DOWNLOAD_EXTERNAL_SEND_SIGN_IN,
                 BARE_USER_AGENT_CUSTOM,
+                BARE_USER_AGENT_FIT_PHONE,
                 BARE_MEDIA_FULLSCREEN_FOLLOWS_PHONE,
                 BARE_USER_AGENT_PRESET,
                 BARE_ADDRESS_BAR_SWIPE_TABS,
diff --git a/chrome/browser/ui/android/strings/android_chrome_strings.grd b/chrome/browser/ui/android/strings/android_chrome_strings.grd
index 1947a7f31a2..aeff51f8b03 100644
--- a/chrome/browser/ui/android/strings/android_chrome_strings.grd
+++ b/chrome/browser/ui/android/strings/android_chrome_strings.grd
@@ -4510,6 +4510,12 @@ To change this setting, <ph name="BEGIN_LINK">BEGIN_LINK</ph>delete the Chrome d
       <message name="IDS_BARE_MEDIA_FULLSCREEN_ORIENTATION_SUMMARY" desc="Summary of the setting that stops pages from forcing landscape in fullscreen video.">
         Fullscreen video turns only when the phone does, and respects your rotation lock. Turn this off to let a page switch to landscape itself.
       </message>
+      <message name="IDS_BARE_USER_AGENT_FIT_TITLE" desc="Developer option: keep pages to the phone's width with the chosen user agent. [CHAR_LIMIT=48]">
+        Fit page to phone width
+      </message>
+      <message name="IDS_BARE_USER_AGENT_FIT_SUMMARY" desc="Summary: with a chosen user agent, lay pages out at the phone's width. Applies after a restart.">
+        Keeps the chosen user agent but lays pages out at the phone’s own width instead of a wide desktop-sized one. Applies after a restart.
+      </message>
       <message name="IDS_BARE_MINIMAL_LAYOUT_USE_MINIMAL" desc="Address bar long press menu item that switches to the minimal toolbar. [CHAR_LIMIT=40]">
         Use minimal toolbar
       </message>
diff --git a/content/browser/web_contents/web_contents_impl.cc b/content/browser/web_contents/web_contents_impl.cc
index f038e08ea02..997632f7d14 100644
--- a/content/browser/web_contents/web_contents_impl.cc
+++ b/content/browser/web_contents/web_contents_impl.cc
@@ -4102,6 +4102,18 @@ const blink::web_pref::WebPreferences WebContentsImpl::ComputeWebPreferences(
 #endif
   }
 
+#if BUILDFLAG(IS_ANDROID)
+  // Bare: with a user agent chosen in Developer options, "Fit page to phone width" lays pages
+  // out at the phone's own width. Without it a page that has no viewport tag gets the wide
+  // default viewport. The user agent string is not touched.
+  if (command_line.HasSwitch("bare-user-agent-fit-phone")) {
+    // The default viewport style lays a page with no viewport tag out at the device width, which
+    // is how a tablet shows desktop pages; the mobile style gives it a wide one.
+    prefs.viewport_style = blink::mojom::ViewportStyle::kDefault;
+    prefs.viewport_meta_enabled = true;
+  }
+#endif
+
   prefs.spatial_navigation_enabled =
       command_line.HasSwitch(switches::kEnableSpatialNavigation);
 

diff --git a/chrome/android/java/src/org/chromium/chrome/browser/tracing/settings/DeveloperSettings.java b/chrome/android/java/src/org/chromium/chrome/browser/tracing/settings/DeveloperSettings.java
index c5b2dd38545..deb014d7d82 100644
--- a/chrome/android/java/src/org/chromium/chrome/browser/tracing/settings/DeveloperSettings.java
+++ b/chrome/android/java/src/org/chromium/chrome/browser/tracing/settings/DeveloperSettings.java
@@ -31,6 +31,7 @@ import org.chromium.chrome.browser.preferences.ChromePreferenceKeys;
 import org.chromium.chrome.browser.preferences.ChromeSharedPreferences;
 import org.chromium.chrome.browser.settings.ChromeBaseSettingsFragment;
 import org.chromium.chrome.browser.settings.search.ChromeBaseSearchIndexProvider;
+import org.chromium.components.browser_ui.settings.ChromeSwitchPreference;
 import org.chromium.components.browser_ui.settings.EmbeddableSettingsPage;
 import org.chromium.components.browser_ui.settings.SettingsUtils;
 import org.chromium.components.browser_ui.settings.search.SettingsIndexData;
@@ -41,6 +42,7 @@ public class DeveloperSettings extends ChromeBaseSettingsFragment
         implements EmbeddableSettingsPage {
     private static final String UI_PREF_BETA_STABLE_HINT = "beta_stable_hint";
     private static final String UI_PREF_USER_AGENT = "user_agent";
+    private static final String UI_PREF_USER_AGENT_FIT = "user_agent_fit_phone";
 
     // Non-translated strings:
     private static final String MSG_DEVELOPER_OPTIONS_TITLE = "Developer options";
@@ -86,6 +88,16 @@ public class DeveloperSettings extends ChromeBaseSettingsFragment
                     });
         }
         updateUserAgentSummary();
+
+        ChromeSwitchPreference fit = findPreference(UI_PREF_USER_AGENT_FIT);
+        if (fit != null) {
+            fit.setChecked(UserAgentPresets.isFitPhoneSaved());
+            fit.setOnPreferenceChangeListener(
+                    (preference, newValue) -> {
+                        UserAgentPresets.saveFitPhone((boolean) newValue);
+                        return true;
+                    });
+        }
     }
 
     private String userAgentLabel(String id, String custom) {
diff --git a/chrome/android/java/src/org/chromium/chrome/browser/tracing/settings/UserAgentPresets.java b/chrome/android/java/src/org/chromium/chrome/browser/tracing/settings/UserAgentPresets.java
index d887ebb5a68..67a684dde1a 100644
--- a/chrome/android/java/src/org/chromium/chrome/browser/tracing/settings/UserAgentPresets.java
+++ b/chrome/android/java/src/org/chromium/chrome/browser/tracing/settings/UserAgentPresets.java
@@ -25,6 +25,9 @@ public final class UserAgentPresets {
 
     public static final String SWITCH_CUSTOM = "bare-user-agent-custom";
 
+    /** Read by content/browser/web_contents/web_contents_impl.cc under the same name. */
+    public static final String SWITCH_FIT_PHONE = "bare-user-agent-fit-phone";
+
     static final String DEFAULT = "";
     static final String CUSTOM = "custom";
 
@@ -72,6 +75,18 @@ public final class UserAgentPresets {
             commandLine.appendSwitchWithValue(SWITCH_CUSTOM, custom);
         }
         commandLine.appendSwitchWithValue(SWITCH_PRESET, id);
+        if (isFitPhoneSaved()) commandLine.appendSwitch(SWITCH_FIT_PHONE);
+    }
+
+    /** Whether the saved choice keeps pages to the phone's width. */
+    static boolean isFitPhoneSaved() {
+        return ChromeSharedPreferences.getInstance()
+                .readBoolean(ChromePreferenceKeys.BARE_USER_AGENT_FIT_PHONE, false);
+    }
+
+    static void saveFitPhone(boolean fit) {
+        ChromeSharedPreferences.getInstance()
+                .writeBoolean(ChromePreferenceKeys.BARE_USER_AGENT_FIT_PHONE, fit);
     }
 
     /** Whether this process runs with a user agent other than the default. */

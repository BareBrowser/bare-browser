From f2e4d23331ba1f3fd4a2f5923d5bf0e203c75a50 Mon Sep 17 00:00:00 2001
From: Bare <git@barebrowser.org>
Date: Sat, 22 Aug 2026 08:30:01 +0000
Subject: [PATCH] Patch 0000072

---
 .../theme/android/java/res/values-night/colors.xml |  3 ++-
 .../theme/android/java/res/values/colors.xml       | 14 +++++++++++++-
 2 files changed, 15 insertions(+), 2 deletions(-)

diff --git a/components/browser_ui/theme/android/java/res/values-night/colors.xml b/components/browser_ui/theme/android/java/res/values-night/colors.xml
index d9d57a8d63e..7e555e7531e 100644
--- a/components/browser_ui/theme/android/java/res/values-night/colors.xml
+++ b/components/browser_ui/theme/android/java/res/values-night/colors.xml
@@ -8,5 +8,6 @@ found in the LICENSE file.
 <resources>
     <!-- This points to a system color resource in API 31+. However, it's unclear what its value is
          on devices that don't support dynamic colors. -->
-    <color name="splash_screen_bg">@color/system_neutral1_900</color>
+    <!-- Matches the light variant: see the note there. -->
+    <color name="splash_screen_bg">#FF000000</color>
 </resources>
diff --git a/components/browser_ui/theme/android/java/res/values/colors.xml b/components/browser_ui/theme/android/java/res/values/colors.xml
index c9a18294126..5a104f07058 100644
--- a/components/browser_ui/theme/android/java/res/values/colors.xml
+++ b/components/browser_ui/theme/android/java/res/values/colors.xml
@@ -8,5 +8,17 @@ found in the LICENSE file.
 <resources>
     <!-- This points to a system color resource in API 31+. However, it's unclear what its value is
          on devices that don't support dynamic colors. -->
-    <color name="splash_screen_bg">@color/system_neutral1_10</color>
+    <!--
+      De-Googled build: the splash is dark whatever the system is set to.
+
+      Android draws this before any of the app runs, resolving the theme against the system's
+      night mode rather than the browser's own. Someone running the system in light mode with
+      Bare set to Dark or Dark AMOLED therefore got a near-white splash on every cold start,
+      held for as long as startup takes, and then a black browser. No code can correct it later
+      because nothing of ours has started yet.
+
+      So it is fixed rather than adaptive. The cost is a dark splash ahead of the light theme,
+      which is a far smaller jolt than a white one at night, and the blue mark reads on both.
+    -->
+    <color name="splash_screen_bg">#FF000000</color>
 </resources>

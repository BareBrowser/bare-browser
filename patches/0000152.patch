From 141850b620cdb165bde46c2be44c91564a2eb779 Mon Sep 17 00:00:00 2001
From: Bare <git@barebrowser.org>
Date: Tue, 13 Oct 2026 00:42:19 +0000
Subject: [PATCH] Patch 0000152

---
 .../resources/extensions/detail_view.css      | 17 ++++++++++++
 .../resources/extensions/extensions.html      |  1 +
 chrome/browser/resources/extensions/item.css  | 23 ++++++++++++++++
 .../resources/extensions/item_list.css        | 17 ++++++++++++
 .../extensions/keyboard_shortcuts.css         | 17 ++++++++++++
 .../browser/resources/extensions/manager.css  |  8 ++++++
 .../resources/extensions/shared_vars.css      |  9 +++++++
 .../site_permissions/site_permissions.css     |  9 +++++++
 .../browser/resources/extensions/toolbar.css  | 27 +++++++++++++++++++
 9 files changed, 128 insertions(+)

diff --git a/chrome/browser/resources/extensions/detail_view.css b/chrome/browser/resources/extensions/detail_view.css
index 78bfa9d7db5..cd5a8d2936d 100644
--- a/chrome/browser/resources/extensions/detail_view.css
+++ b/chrome/browser/resources/extensions/detail_view.css
@@ -222,3 +222,20 @@ extensions-toggle-row {
   display: flex;
   flex-direction: row;
 }
+
+/* Bare: on a phone, a message's buttons go under its text rather than
+ * squeezing it into a narrow column. */
+@media (max-width: 599px) {
+  .message-container {
+    flex-wrap: wrap;
+    row-gap: 12px;
+  }
+
+  .message-text {
+    flex-basis: calc(100% - 51px);
+  }
+
+  .message-container > cr-button:first-of-type {
+    margin-inline-start: auto;
+  }
+}
diff --git a/chrome/browser/resources/extensions/extensions.html b/chrome/browser/resources/extensions/extensions.html
index ac398cfc332..cd5563609bf 100644
--- a/chrome/browser/resources/extensions/extensions.html
+++ b/chrome/browser/resources/extensions/extensions.html
@@ -3,6 +3,7 @@
     class="loading $i18n{loadTimeClasses}" $i18n{webuiRefresh2026} $i18n{roundedIconsAttribute} $i18n{webuiRoundedIconsAttribute}>
 <head>
   <meta charset="utf8">
+  <meta name="viewport" content="width=device-width, initial-scale=1">
   <meta name="color-scheme" content="light dark">
   <title>$i18n{title}</title>
   <base href="chrome://extensions">
diff --git a/chrome/browser/resources/extensions/item.css b/chrome/browser/resources/extensions/item.css
index 00c280284be..b4d8faf687c 100644
--- a/chrome/browser/resources/extensions/item.css
+++ b/chrome/browser/resources/extensions/item.css
@@ -255,3 +255,26 @@ cr-tooltip {
   height: 0;
   overflow: hidden;
 }
+
+/* Bare: upstream sizes the card for desktop text. On a phone at a large zoom,
+ * let it grow with its content and wrap the switch under the buttons. */
+@media (max-width: 599px) {
+  #card,
+  #card.review-prompting-enabled,
+  #card.dev-mode,
+  #card.dev-mode.review-prompting-enabled {
+    height: auto;
+    min-height: var(--extensions-card-height);
+  }
+
+  #button-strip {
+    flex-wrap: wrap;
+    height: auto;
+    min-height: var(--cr-section-min-height);
+    row-gap: 8px;
+  }
+
+  #button-strip > cr-toggle {
+    margin-inline-start: auto;
+  }
+}
diff --git a/chrome/browser/resources/extensions/item_list.css b/chrome/browser/resources/extensions/item_list.css
index 05cc88e7a72..5ddb01be862 100644
--- a/chrome/browser/resources/extensions/item_list.css
+++ b/chrome/browser/resources/extensions/item_list.css
@@ -120,3 +120,20 @@ managed-footnote {
    * is clickable. */
   z-index: 1;
 }
+
+/* Bare: one card per row, as wide as the screen, on a phone. */
+@media (max-width: 599px) {
+  .items-container,
+  #content-wrapper {
+    --extensions-card-width: 100%;
+  }
+
+  #content-wrapper {
+    min-width: 0;
+    padding: 16px 12px 64px;
+  }
+
+  .items-container {
+    grid-template-columns: minmax(0, 1fr);
+  }
+}
diff --git a/chrome/browser/resources/extensions/keyboard_shortcuts.css b/chrome/browser/resources/extensions/keyboard_shortcuts.css
index 075b92d90a3..0a8b65d79c7 100644
--- a/chrome/browser/resources/extensions/keyboard_shortcuts.css
+++ b/chrome/browser/resources/extensions/keyboard_shortcuts.css
@@ -103,3 +103,20 @@
   margin-inline-end: 20px;
   margin-inline-start: 60px;
 }
+
+/* Bare: on a phone, put each command's name above its controls. */
+@media (max-width: 599px) {
+  .card-controls {
+    margin-inline-start: 20px;
+  }
+
+  .command-entry {
+    flex-wrap: wrap;
+    row-gap: 8px;
+  }
+
+  .command-name {
+    flex-basis: 100%;
+    margin-inline-end: 0;
+  }
+}
diff --git a/chrome/browser/resources/extensions/manager.css b/chrome/browser/resources/extensions/manager.css
index e13459ca14e..e5d4d875ae7 100644
--- a/chrome/browser/resources/extensions/manager.css
+++ b/chrome/browser/resources/extensions/manager.css
@@ -87,3 +87,11 @@ picture[slot='header-icon'] img {
   width: 100%;
 }
 
+/* Bare: on a phone, wrap a long notice instead of cutting it off at the
+ * screen edge. */
+@media (max-width: 599px) {
+  cr-toast-manager {
+    --cr-toast-max-width: calc(100vw - 48px);
+    --cr-toast-white-space: normal;
+  }
+}
diff --git a/chrome/browser/resources/extensions/shared_vars.css b/chrome/browser/resources/extensions/shared_vars.css
index 2c4ab4018cf..69a51030b9c 100644
--- a/chrome/browser/resources/extensions/shared_vars.css
+++ b/chrome/browser/resources/extensions/shared_vars.css
@@ -30,3 +30,12 @@ html {
     --warning-color: var(--google-yellow-300);
   }
 }
+
+/* Bare: the pages are 680px wide and dialogs 512px. Below that, use the width
+ * there is. */
+@media (max-width: 719px) {
+  html {
+    --cr-dialog-width: min(512px, calc(100vw - 32px));
+    --cr-toolbar-field-width: 100%;
+  }
+}
diff --git a/chrome/browser/resources/extensions/site_permissions/site_permissions.css b/chrome/browser/resources/extensions/site_permissions/site_permissions.css
index 32570ae3f7a..73aeb93aa93 100644
--- a/chrome/browser/resources/extensions/site_permissions/site_permissions.css
+++ b/chrome/browser/resources/extensions/site_permissions/site_permissions.css
@@ -38,3 +38,12 @@
 cr-link-row {
   padding-inline-end: 28px;
 }
+
+/* Bare: the heading would otherwise touch the screen edge once the page is
+ * full width. */
+@media (max-width: 719px) {
+  #header {
+    box-sizing: border-box;
+    padding-inline: var(--cr-section-padding);
+  }
+}
diff --git a/chrome/browser/resources/extensions/toolbar.css b/chrome/browser/resources/extensions/toolbar.css
index 881317e1cfe..93b4c3f355b 100644
--- a/chrome/browser/resources/extensions/toolbar.css
+++ b/chrome/browser/resources/extensions/toolbar.css
@@ -97,3 +97,30 @@ picture[slot='product-logo'] img {
   width: 100%;
 }
 
+/* Bare: keep the toolbar controls on screen on a phone. At a large zoom, the
+ * Developer mode switch moves under the title. The drawer has a fixed height,
+ * so its button row scrolls sideways when it is too long. */
+@media (max-width: 599px) {
+  cr-toolbar {
+    flex-wrap: wrap;
+    height: auto;
+    min-height: var(--cr-toolbar-height);
+  }
+
+  .more-actions {
+    min-height: var(--cr-toolbar-height);
+  }
+
+  #buttonStrip {
+    box-sizing: border-box;
+    display: flex;
+    margin-inline-start: 0;
+    overflow-x: auto;
+    padding-inline: 12px;
+  }
+
+  #buttonStrip cr-button {
+    flex-shrink: 0;
+    margin-inline-end: 8px;
+  }
+}

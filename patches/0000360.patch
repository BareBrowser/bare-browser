+    /**
+     * Bare: Preload pages is a switch, off unless the user turns it on. Chromium's default is
+     * standard preloading, so a profile that never set it is set to off. Extended preloading is
+     * not offered any more and becomes standard. A value set by policy is left alone.
+     */
+    private static void applyBarePreloadPagesDefaults(Profile profile) {
+        if (profile.isOffTheRecord()) return;
+        if (PreloadPagesSettingsBridge.isNetworkPredictionManaged(profile)) return;
+        if (UserPrefs.get(profile).isDefaultValuePreference("net.network_prediction_options")) {
+            PreloadPagesSettingsBridge.setState(profile, PreloadPagesState.NO_PRELOADING);
+            return;
+        }
+        if (PreloadPagesSettingsBridge.getState(profile)
+                == PreloadPagesState.EXTENDED_PRELOADING) {
+            PreloadPagesSettingsBridge.setState(profile, PreloadPagesState.STANDARD_PRELOADING);
+        }
+    }

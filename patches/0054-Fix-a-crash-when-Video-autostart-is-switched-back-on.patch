From 2325cc8bbb7a6536c38d47cb307762c51a4a7b06 Mon Sep 17 00:00:00 2001
From: Bare <git@barebrowser.org>
Date: Wed, 19 Aug 2026 07:20:00 +0000
Subject: [PATCH] Fix a crash when Video autostart is switched back on

---
 .../site_settings/android/website_preference_bridge.cc       | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/components/browser_ui/site_settings/android/website_preference_bridge.cc b/components/browser_ui/site_settings/android/website_preference_bridge.cc
index c70accf64ea..423f8e25c21 100644
--- a/components/browser_ui/site_settings/android/website_preference_bridge.cc
+++ b/components/browser_ui/site_settings/android/website_preference_bridge.cc
@@ -1083,6 +1083,11 @@ static void JNI_WebsitePreferenceBridge_SetContentSettingEnabled(
         break;
       case ContentSettingsType::ADS:
       case ContentSettingsType::ANTI_ABUSE:
+      // Bare: the Video autostart category. Without this the NOTREACHED below
+      // aborts the browser whenever the category is switched back on. Turning
+      // it off never hit it, because `value` already starts as BLOCK and this
+      // switch only runs for `allow`.
+      case ContentSettingsType::AUTOPLAY:
       case ContentSettingsType::AUTO_DARK_WEB_CONTENT:
       case ContentSettingsType::AUTO_PICTURE_IN_PICTURE:
       case ContentSettingsType::BACKGROUND_SYNC:

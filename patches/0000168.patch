+    @Test
+    @EnableFeatures(ChromeFeatureList.ANDROID_BOTTOM_BAR)
+    public void testMinimalLayoutTakesTheBottomBarAway() {
+        BottomBarConfigUtils.setMinimalLayoutForTesting(true);
+        assertFalse(BottomBarConfigUtils.isBottomBarEnabled(mContext));
+        BottomBarConfigUtils.setMinimalLayoutForTesting(false);
+        assertTrue(BottomBarConfigUtils.isBottomBarEnabled(mContext));
+    }
+
+    @Test
+    public void testMinimalLayoutIsReadOnceAtStart() {
+        BottomBarConfigUtils.setMinimalLayoutForTesting(null);
+        ChromeSharedPreferences.getInstance()
+                .writeBoolean(ChromePreferenceKeys.BARE_MINIMAL_LAYOUT, true);
+        assertTrue(BottomBarConfigUtils.isMinimalLayout());
+
+        // A later change waits for the next start, and says so.
+        ChromeSharedPreferences.getInstance()
+                .writeBoolean(ChromePreferenceKeys.BARE_MINIMAL_LAYOUT, false);
+        assertTrue(BottomBarConfigUtils.isMinimalLayout());
+        assertTrue(BottomBarConfigUtils.isMinimalLayoutChangePending());
+
+        ChromeSharedPreferences.getInstance()
+                .writeBoolean(ChromePreferenceKeys.BARE_MINIMAL_LAYOUT, true);
+        assertFalse(BottomBarConfigUtils.isMinimalLayoutChangePending());
+
+        ChromeSharedPreferences.getInstance().removeKey(ChromePreferenceKeys.BARE_MINIMAL_LAYOUT);
+        BottomBarConfigUtils.setMinimalLayoutForTesting(null);
+    }
+
+    @Test
+    public void testMinimalLayoutIsOffUntilChosen() {
+        BottomBarConfigUtils.setMinimalLayoutForTesting(null);
+        ChromeSharedPreferences.getInstance().removeKey(ChromePreferenceKeys.BARE_MINIMAL_LAYOUT);
+        assertFalse(BottomBarConfigUtils.isMinimalLayout());
+        assertFalse(BottomBarConfigUtils.isMinimalLayoutChangePending());
+    }
+

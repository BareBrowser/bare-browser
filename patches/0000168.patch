+    /**
+     * The switch for the minimal layout, which leaves out the bottom bar.
+     *
+     * <p>Phones only, since tablets never had the bar. The layout is read when the process starts,
+     * so a change asks for a restart rather than rebuilding the toolbar under the user.
+     */
+    private void initMinimalLayoutPref() {
+        ChromeSwitchPreference minimal = findPreference(PREF_MINIMAL_LAYOUT);
+        if (minimal == null) return;
+        if (DeviceFormFactor.isNonMultiDisplayContextOnTablet(getContext())) {
+            removePreference(PREF_MINIMAL_LAYOUT);
+            return;
+        }
+        // The bar's own shortcuts mean nothing in the layout that has no bar.
+        if (BottomBarConfigUtils.isMinimalLayout()) removePreference(PREF_BARE_TOOLBAR);
+
+        minimal.setChecked(
+                ChromeSharedPreferences.getInstance()
+                        .readBoolean(ChromePreferenceKeys.BARE_MINIMAL_LAYOUT, false));
+        minimal.setOnPreferenceChangeListener(
+                (preference, newValue) -> {
+                    ChromeSharedPreferences.getInstance()
+                            .writeBoolean(
+                                    ChromePreferenceKeys.BARE_MINIMAL_LAYOUT, (boolean) newValue);
+                    if (BottomBarConfigUtils.isMinimalLayoutChangePending()) {
+                        new AlertDialog.Builder(
+                                        requireContext(),
+                                        R.style.ThemeOverlay_BrowserUI_AlertDialog)
+                                .setMessage(R.string.bare_minimal_layout_restart_message)
+                                .setPositiveButton(
+                                        R.string.bare_minimal_layout_restart,
+                                        (dialog, which) ->
+                                                ApplicationLifetime.terminate(/* restart= */ true))
+                                .setNegativeButton(R.string.bare_minimal_layout_later, null)
+                                .show();
+                    }
+                    return true;
+                });
+    }
+
     private void removePreference(String prefKey) {
         getPreferenceScreen().removePreference(findPreference(prefKey));
     }

@@ -27,11 +27,43 @@ public class BottomBarConfigUtils {
 
     private BottomBarConfigUtils() {}
 
+    /** What the minimal layout setting said when the process started. */
+    private static @Nullable Boolean sMinimalLayout;
+
+    /**
+     * Whether the user chose the minimal layout, which drops the bottom bar and leaves the address
+     * bar as the only strip of controls.
+     *
+     * <p>Answered once, from what was stored when the process started. The bar is built at startup
+     * and everything that asks whether it exists has to keep getting the same answer, so a change
+     * made in Settings waits for the next start.
+     */
+    public static boolean isMinimalLayout() {
+        if (sMinimalLayout == null) {
+            sMinimalLayout =
+                    ChromeSharedPreferences.getInstance()
+                            .readBoolean(ChromePreferenceKeys.BARE_MINIMAL_LAYOUT, false);
+        }
+        return sMinimalLayout;
+    }
+
+    /** Whether the stored choice is different from the layout this process started with. */
+    public static boolean isMinimalLayoutChangePending() {
+        return ChromeSharedPreferences.getInstance()
+                        .readBoolean(ChromePreferenceKeys.BARE_MINIMAL_LAYOUT, false)
+                != isMinimalLayout();
+    }
+
+    public static void setMinimalLayoutForTesting(@Nullable Boolean minimal) {
+        sMinimalLayout = minimal;
+    }
+
     // LINT.IfChange(isBottomBarEnabled)
     /** Whether the bottom bar is enabled. */
     public static boolean isBottomBarEnabled(Context context) {
         return !DeviceFormFactor.isNonMultiDisplayContextOnTablet(context)
                 && !DeviceInfo.isAutomotive()
+                && !isMinimalLayout()
                 && ChromeFeatureList.sAndroidBottomBar.isEnabled();
     }

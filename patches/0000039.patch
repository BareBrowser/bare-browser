From 5e95c0c22d81b33769e134e0922764ec3e35b014 Mon Sep 17 00:00:00 2001
From: Bare <git@barebrowser.org>
Date: Tue, 18 Aug 2026 20:21:19 +0000
Subject: [PATCH] Patch 0000039

---
 .../chrome/browser/firstrun/FirstRunStatus.java  | 16 ++++++++++++++--
 1 file changed, 14 insertions(+), 2 deletions(-)

diff --git a/chrome/browser/first_run/android/java/src/org/chromium/chrome/browser/firstrun/FirstRunStatus.java b/chrome/browser/first_run/android/java/src/org/chromium/chrome/browser/firstrun/FirstRunStatus.java
index ae781f16eb4..9e97876d0a1 100644
--- a/chrome/browser/first_run/android/java/src/org/chromium/chrome/browser/firstrun/FirstRunStatus.java
+++ b/chrome/browser/first_run/android/java/src/org/chromium/chrome/browser/firstrun/FirstRunStatus.java
@@ -52,8 +52,20 @@ public class FirstRunStatus {
      * includes ToS and Sign In pages if necessary.
      */
     public static boolean getFirstRunFlowComplete() {
-        return ChromeSharedPreferences.getInstance()
-                .readBoolean(ChromePreferenceKeys.FIRST_RUN_FLOW_COMPLETE, false);
+        // Bare Browser: there is no first run experience, so report it as already done.
+        //
+        // FirstRunFlowSequencer.checkIfFirstRunIsNecessary() returns early on this, so
+        // FirstRunActivity is never started. Without it the first launch after install opened
+        // that activity, showed an icon and a spinner, then handed off to the browser, which
+        // ran two window-open animations back to back and looked like a second app starting.
+        //
+        // Patch 0015 already emptied the flow of anything to show by removing the sign in page
+        // and accepting the terms, so the activity only cost that animation.
+        //
+        // The terms still get accepted: FirstRunUtils.cacheFirstRunPrefs(), called from
+        // ChromeCachedFlags at startup, calls setEulaAccepted() when the flow reads complete and
+        // the native pref is not set yet.
+        return true;
     }
 
     /**

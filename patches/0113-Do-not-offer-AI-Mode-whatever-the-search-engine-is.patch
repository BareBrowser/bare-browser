From af3abaee75d432b55d595812a8352b8e221b17b2 Mon Sep 17 00:00:00 2001
From: Bare <git@barebrowser.org>
Date: Mon, 7 Sep 2026 07:19:57 +0000
Subject: [PATCH] Do not offer AI Mode, whatever the search engine is

Upstream ships kOmniboxMultimodalInput enabled and leaves the AI Mode entry
points to decide for themselves, and every one of them decides by asking whether
the default search engine is Google. With DuckDuckGo nothing appears, which is
why none of this is visible today, but the protection is a user setting rather
than a decision this browser has made. Changing the search engine back to Google
removes all of it at once.

There is also a path that does not involve Google at all. omnibox_field_trial.cc
offers the entrypoint to a third party engine on the strength of kAim3pEntrypoint
and the policy checks alone, so a non-Google engine is not on its own a reason
the feature stays away.

Both defaults go to disabled. That covers the five callers of
OmniboxFeatures.isMultimodalInputEnabled: the fusebox coordinator and its NTP
plus button stop being built, the composeplate button falls through to its URL
instead of asking for AI mode, ToolbarPhone returns to the optional button
behaviour it had before the fusebox, and the scrim call is behind a tablet check
that a phone never passes.

The Java cached flag has to say the same thing. It answers from its own default
until the native value has been cached, so leaving it enabled would have left the
first run after an install uncovered.

This is the same answer 0019 and 0025 already gave for the AI Mode bottom bar
button.
---
 .../components/omnibox/OmniboxFeatures.java        |  5 ++++-
 components/omnibox/common/omnibox_features.cc      | 14 ++++++++++----
 2 files changed, 14 insertions(+), 5 deletions(-)

diff --git a/components/omnibox/common/android/java/src/org/chromium/components/omnibox/OmniboxFeatures.java b/components/omnibox/common/android/java/src/org/chromium/components/omnibox/OmniboxFeatures.java
index 8efdc931668..5ac564ba28c 100644
--- a/components/omnibox/common/android/java/src/org/chromium/components/omnibox/OmniboxFeatures.java
+++ b/components/omnibox/common/android/java/src/org/chromium/components/omnibox/OmniboxFeatures.java
@@ -164,8 +164,11 @@ public class OmniboxFeatures {
                     OmniboxFeatureList.SUPPRESS_STATUS_ICON_DURING_HTTP_NAVIGATION,
                     FeatureState.ENABLED_IN_PROD);
 
+    // Held off in Java as well as in omnibox_features.cc: this cached flag answers
+    // from its Java default until the native value has been cached, so a native
+    // change on its own would leave the first run after an install uncovered.
     private static final CachedFlag sOmniboxMultimodalInput =
-            newFlag(OmniboxFeatureList.OMNIBOX_MULTIMODAL_INPUT, FeatureState.ENABLED_IN_PROD);
+            newFlag(OmniboxFeatureList.OMNIBOX_MULTIMODAL_INPUT, FeatureState.DISABLED);
 
     public static final CachedFlag sOmniboxFuseboxPopupVariations =
             newFlag(
diff --git a/components/omnibox/common/omnibox_features.cc b/components/omnibox/common/omnibox_features.cc
index 5da1084a4dd..dad40a60cff 100644
--- a/components/omnibox/common/omnibox_features.cc
+++ b/components/omnibox/common/omnibox_features.cc
@@ -194,7 +194,11 @@ BASE_FEATURE(kHideAimEntrypointOnUserInput,
 BASE_FEATURE(kHideAimEntrypointForUrlSuggestions, ENABLED);
 
 // When enabled, the multimodal input button is shown in the Omnibox.
-BASE_FEATURE(kOmniboxMultimodalInput, ENABLED);
+// Bare turns this off. Upstream enables it and leaves it to the entry points to
+// ask whether the default search engine is Google, which means the feature is
+// only ever one settings change away from appearing. This is the same answer
+// patches 0019 and 0025 gave for the AI Mode bottom bar button.
+BASE_FEATURE(kOmniboxMultimodalInput, DISABLED);
 
 // Enables popup variations (e.g. accordion menu) for mobile Fusebox.
 BASE_FEATURE(kOmniboxFuseboxPopupVariations, DISABLED);
@@ -204,9 +208,11 @@ BASE_FEATURE(kOmniboxFuseboxPopupVariations, DISABLED);
 // attached.
 BASE_FEATURE(kOmniboxDisableTabsForCanvas, ENABLED);
 
-// Enables the AIM entrypoint for third party search engines. Held dark on
-// Android until the Android entrypoint UI is implemented.
-BASE_FEATURE(kAim3pEntrypoint, enable_if(!IS_ANDROID));
+// Enables the AIM entrypoint for third party search engines.
+// Bare turns this off too. With it enabled, omnibox_field_trial.cc offers the
+// entrypoint to a non-Google engine on the strength of the flag and the policy
+// checks alone, so DuckDuckGo is not the protection it looks like.
+BASE_FEATURE(kAim3pEntrypoint, DISABLED);
 const base::FeatureParam<bool> kAim3pEntrypointDebug{
     &kAim3pEntrypoint, "Aim3pEntrypointDebug", false};
 

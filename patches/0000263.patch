+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.components.page_info;
+
+import android.content.Context;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.FrameLayout;
+
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.components.browser_ui.bottomsheet.BottomSheetContent;
+import org.chromium.components.browser_ui.bottomsheet.BottomSheetType;
+import org.chromium.components.browser_ui.widget.FadingEdgeScrollView;
+
+/**
+ * The site settings panel shown as a card from the bottom of the screen, like the menu and the
+ * extensions, wherever the address bar is.
+ */
+@NullMarked
+class PageInfoSheetContent implements BottomSheetContent {
+    private static final BottomSheetType SHEET_TYPE =
+            new BottomSheetType.Builder().setUserInitiated(true).build();
+    private static final int BOTTOM_PADDING_DP = 16;
+
+    private final FrameLayout mContainer;
+    private final FadingEdgeScrollView mScrollView;
+    private final String mTitle;
+
+    PageInfoSheetContent(Context context, FadingEdgeScrollView scrollView) {
+        mScrollView = scrollView;
+        mTitle = context.getString(R.string.bare_page_info_title);
+        mContainer = new FrameLayout(context);
+        mContainer.addView(
+                scrollView,
+                new FrameLayout.LayoutParams(
+                        ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT));
+        float density = context.getResources().getDisplayMetrics().density;
+        mContainer.setPadding(0, 0, 0, Math.round(BOTTOM_PADDING_DP * density));
+    }
+
+    /** Hands the scroll view back once the card has gone. */
+    void release() {
+        mContainer.removeAllViews();
+    }
+
+    @Override
+    public View getContentView() {
+        return mContainer;
+    }
+
+    @Override
+    public @Nullable View getToolbarView() {
+        return null;
+    }
+
+    @Override
+    public int getVerticalScrollOffset() {
+        return mScrollView.getScrollY();
+    }
+
+    @Override
+    public void destroy() {}
+
+    @Override
+    public BottomSheetType getSheetType() {
+        return SHEET_TYPE;
+    }
+
+    @Override
+    public int getPriority() {
+        return ContentPriority.HIGH;
+    }
+
+    @Override
+    public boolean swipeToDismissEnabled() {
+        return true;
+    }
+
+    @Override
+    public boolean showHandlebar() {
+        return true;
+    }
+
+    @Override
+    public int getPeekHeight() {
+        return HeightMode.DISABLED;
+    }
+
+    @Override
+    public float getHalfHeightRatio() {
+        return HeightMode.DISABLED;
+    }
+
+    @Override
+    public float getFullHeightRatio() {
+        return HeightMode.WRAP_CONTENT;
+    }
+
+    @Override
+    public @Nullable String getSheetContentDescription(Context context) {
+        return mTitle;
+    }
+
+    @Override
+    public int getSheetHalfHeightAccessibilityStringId() {
+        return R.string.bare_page_info_title;
+    }
+
+    @Override
+    public int getSheetFullHeightAccessibilityStringId() {
+        return R.string.bare_page_info_title;
+    }
+
+    @Override
+    public int getSheetClosedAccessibilityStringId() {
+        return R.string.bare_page_info_title;
+    }
+}

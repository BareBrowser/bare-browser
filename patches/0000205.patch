+    /** Bare: with frosted glass on, the page behind the menu is blurred and a little dimmed. */
+    private static void blurPageBehind(PopupWindow popup) {
+        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.S) return;
+        View content = popup.getContentView();
+        if (content == null) return;
+        Context context = content.getContext();
+        if (!ContextUtils.getAppSharedPreferences().getBoolean("Bare.Glass", true)) return;
+        WindowManager windowManager = context.getSystemService(WindowManager.class);
+        if (windowManager == null || !windowManager.isCrossWindowBlurEnabled()) return;
+        View decor = content.getRootView();
+        if (!(decor.getLayoutParams() instanceof WindowManager.LayoutParams params)) return;
+        params.flags |=
+                WindowManager.LayoutParams.FLAG_BLUR_BEHIND
+                        | WindowManager.LayoutParams.FLAG_DIM_BEHIND;
+        params.dimAmount = 0.14f;
+        params.setBlurBehindRadius(
+                Math.round(18 * context.getResources().getDisplayMetrics().density));
+        try {
+            windowManager.updateViewLayout(decor, params);
+        } catch (IllegalArgumentException e) {
+            // The window is already gone; nothing to blur.
+        }
+    }

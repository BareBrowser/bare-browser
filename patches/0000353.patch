@@ -0,0 +1,69 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.omnibox;
+
+import android.text.TextUtils;
+
+import org.chromium.base.ContextUtils;
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.chrome.browser.profiles.Profile;
+import org.chromium.chrome.browser.search_engines.TemplateUrlServiceFactory;
+import org.chromium.components.search_engines.TemplateUrl;
+import org.chromium.components.search_engines.TemplateUrlService;
+import org.chromium.url.GURL;
+
+/**
+ * The search engine Incognito uses.
+ *
+ * <p>Incognito shares the regular profile's engines and its default, so its own pick is kept here,
+ * by keyword, and outlives Incognito tabs and restarts. A search sent from an Incognito address bar
+ * is built for the default engine first and then rebuilt for this one from the same query. With no
+ * pick, or when the picked engine has been deleted, Incognito follows the default.
+ */
+@NullMarked
+public final class BareIncognitoEngine {
+    /** Also listed in the Bare backup (chrome/browser/bare/backup/backup_settings.cc). */
+    private static final String KEY = "Bare.Incognito.SearchEngine";
+
+    private BareIncognitoEngine() {}
+
+    /** The picked engine, or null with no pick or when it no longer exists. */
+    public static @Nullable TemplateUrl get(@Nullable TemplateUrlService service) {
+        if (service == null || !service.isLoaded()) return null;
+        String keyword = ContextUtils.getAppSharedPreferences().getString(KEY, null);
+        if (TextUtils.isEmpty(keyword)) return null;
+        return service.getTemplateUrlForKeyword(keyword);
+    }
+
+    /** As {@link #get}, for the address bar of {@code profile}; null outside Incognito. */
+    public static @Nullable TemplateUrl forProfile(@Nullable Profile profile) {
+        if (profile == null || !profile.isIncognitoBranded()) return null;
+        return get(TemplateUrlServiceFactory.getForProfile(profile));
+    }
+
+    /** Makes {@code engine} the one Incognito searches with. */
+    public static void set(TemplateUrl engine) {
+        ContextUtils.getAppSharedPreferences().edit().putString(KEY, engine.getKeyword()).apply();
+        BareSearchOverride.notifyObservers();
+    }
+
+    /**
+     * The address to load instead of {@code url}, or null to load it as it is. Only a search
+     * results address for the default engine is rewritten, so a typed web address is never touched.
+     */
+    public static @Nullable String rewrite(@Nullable TemplateUrlService service, String url) {
+        @Nullable TemplateUrl engine = get(service);
+        if (engine == null || service == null) return null;
+        GURL parsed = new GURL(url);
+        if (!service.isSearchResultsPageFromDefaultSearchProvider(parsed)) return null;
+        @Nullable TemplateUrl defaultEngine = service.getDefaultSearchEngineTemplateUrl();
+        if (defaultEngine != null && defaultEngine.getURL().equals(engine.getURL())) return null;
+        String query = service.getSearchQueryForUrl(parsed);
+        if (query == null || query.isEmpty()) return null;
+        @Nullable GURL expanded = service.expandUrlTemplate(engine.getURL(), query);
+        return expanded == null ? null : expanded.getSpec();
+    }
+}

diff --git a/chrome/browser/ui/android/omnibox/java/src/org/chromium/chrome/browser/omnibox/BareIncognitoEngine.java b/chrome/browser/ui/android/omnibox/java/src/org/chromium/chrome/browser/omnibox/BareIncognitoEngine.java

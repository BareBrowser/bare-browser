+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.bare.notices;
+
+import android.app.Activity;
+
+import org.chromium.base.ObserverList;
+import org.chromium.base.ThreadUtils;
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.chrome.browser.app.ChromeActivity;
+import org.chromium.chrome.browser.preferences.ChromePreferenceKeys;
+import org.chromium.chrome.browser.preferences.ChromeSharedPreferences;
+import org.chromium.chrome.browser.tab.Tab;
+import org.chromium.chrome.browser.ui.messages.snackbar.SnackbarManager;
+import org.chromium.url.GURL;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+
+/**
+ * Where the short messages at the bottom of the screen go when they are not shown.
+ *
+ * <p>With Settings, Appearance, Snackbar notifications off (the default), no snackbar is drawn.
+ * Each one is treated as shown and left to time out, so whatever asked for it carries on as if
+ * the user had let it pass, and its text is kept here for the Notifications page. The list lives
+ * in memory only: it is gone when Bare exits, and nothing from an incognito tab is kept.
+ */
+@NullMarked
+public final class BareNotices {
+    private BareNotices() {}
+
+    /** The most messages kept; older ones drop off. */
+    private static final int LIMIT = 200;
+
+    /** One message. */
+    public static final class Entry {
+        public final long id;
+        public final long time;
+        public final String message;
+        public final @Nullable String source;
+
+        Entry(long id, long time, String message, @Nullable String source) {
+            this.id = id;
+            this.time = time;
+            this.message = message;
+            this.source = source;
+        }
+    }
+
+    private static final List<Entry> sEntries = new ArrayList<>();
+    private static final ObserverList<Runnable> sObservers = new ObserverList<>();
+    private static long sNextId;
+    private static boolean sInstalled;
+
+    /** Starts routing snackbars through here. Safe to call more than once. */
+    public static void install() {
+        if (sInstalled) return;
+        sInstalled = true;
+        SnackbarManager.setInterceptor(BareNotices::intercept);
+    }
+
+    /** True when snackbars are drawn as usual. Off unless the user turns it on. */
+    public static boolean areSnackbarsShown() {
+        return ChromeSharedPreferences.getInstance()
+                .readBoolean(ChromePreferenceKeys.BARE_SNACKBARS_SHOWN, false);
+    }
+
+    public static void setSnackbarsShown(boolean shown) {
+        ChromeSharedPreferences.getInstance()
+                .writeBoolean(ChromePreferenceKeys.BARE_SNACKBARS_SHOWN, shown);
+    }
+
+    private static boolean intercept(Activity activity, CharSequence message) {
+        if (areSnackbarsShown()) return false;
+        String text = message.toString().trim();
+        if (text.isEmpty()) return true;
+        String source = null;
+        if (activity instanceof ChromeActivity chromeActivity) {
+            if (!chromeActivity.areTabModelsInitialized()
+                    || chromeActivity.getTabModelSelector().isIncognitoSelected()) {
+                return true;
+            }
+            Tab tab = chromeActivity.getActivityTab();
+            if (tab != null) {
+                if (tab.isIncognitoBranded()) return true;
+                source = hostOf(tab.getUrl());
+            }
+        }
+        record(text, source);
+        return true;
+    }
+
+    private static @Nullable String hostOf(@Nullable GURL url) {
+        if (url == null || !url.isValid()) return null;
+        String scheme = url.getScheme();
+        if (!scheme.equals("http") && !scheme.equals("https")) return null;
+        String host = url.getHost();
+        if (host.startsWith("www.")) host = host.substring(4);
+        return host.isEmpty() ? null : host;
+    }
+
+    private static void record(String message, @Nullable String source) {
+        ThreadUtils.assertOnUiThread();
+        sEntries.add(new Entry(sNextId++, System.currentTimeMillis(), message, source));
+        if (sEntries.size() > LIMIT) sEntries.remove(0);
+        for (Runnable observer : sObservers) observer.run();
+    }
+
+    /** The messages, newest first. */
+    public static List<Entry> entries() {
+        List<Entry> copy = new ArrayList<>(sEntries);
+        Collections.reverse(copy);
+        return copy;
+    }
+
+    public static void clear() {
+        sEntries.clear();
+        for (Runnable observer : sObservers) observer.run();
+    }
+
+    public static void addObserver(Runnable observer) {
+        sObservers.addObserver(observer);
+    }
+
+    public static void removeObserver(Runnable observer) {
+        sObservers.removeObserver(observer);
+    }
+}
diff --git a/chrome/android/java/src/org/chromium/chrome/browser/bare/notices/BareNoticesFragment.java b/chrome/android/java/src/org/chromium/chrome/browser/bare/notices/BareNoticesFragment.java

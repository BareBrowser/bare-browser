@@ -0,0 +1,197 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.bare.notices;
+
+import android.content.Context;
+import android.os.Bundle;
+import android.text.format.DateUtils;
+import android.view.Gravity;
+import android.view.LayoutInflater;
+import android.view.Menu;
+import android.view.MenuInflater;
+import android.view.MenuItem;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.ImageView;
+import android.widget.TextView;
+
+import androidx.preference.PreferenceScreen;
+import androidx.recyclerview.widget.RecyclerView;
+
+import org.chromium.base.supplier.MonotonicObservableSupplier;
+import org.chromium.base.supplier.ObservableSuppliers;
+import org.chromium.base.supplier.SettableMonotonicObservableSupplier;
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.chrome.R;
+import org.chromium.chrome.browser.settings.ChromeBaseSettingsFragment;
+import org.chromium.components.browser_ui.widget.DateDividedAdapter;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * The Notifications page: messages that would have popped up at the bottom of the screen, newest
+ * first under date headings. It is built from the same parts as the downloads and history pages
+ * (the date-divided list, the date heading and the list row), so it looks like them.
+ */
+@NullMarked
+public class BareNoticesFragment extends ChromeBaseSettingsFragment {
+    private static final int MENU_CLEAR = Menu.FIRST + 7;
+
+    private final SettableMonotonicObservableSupplier<String> mPageTitle =
+            ObservableSuppliers.createMonotonic();
+    private final Runnable mObserver = this::refresh;
+    private @Nullable NoticesAdapter mAdapter;
+    private @Nullable TextView mEmptyView;
+
+    @Override
+    public void onCreatePreferences(@Nullable Bundle savedInstanceState, @Nullable String rootKey) {
+        mPageTitle.set(getString(R.string.bare_notices_title));
+        setPreferenceScreen(getPreferenceManager().createPreferenceScreen(getContext()));
+        setHasOptionsMenu(true);
+        BareNotices.addObserver(mObserver);
+    }
+
+    @Override
+    public void onDestroy() {
+        BareNotices.removeObserver(mObserver);
+        super.onDestroy();
+    }
+
+    @Override
+    protected RecyclerView.Adapter onCreateAdapter(PreferenceScreen preferenceScreen) {
+        mAdapter = new NoticesAdapter();
+        mAdapter.show(BareNotices.entries());
+        return mAdapter;
+    }
+
+    @Override
+    public View onCreateView(
+            LayoutInflater inflater, @Nullable ViewGroup container, @Nullable Bundle state) {
+        View view = super.onCreateView(inflater, container, state);
+        ViewGroup list = view.findViewById(android.R.id.list_container);
+        if (list != null) {
+            Context context = view.getContext();
+            TextView empty = new TextView(context);
+            empty.setText(R.string.bare_notices_empty);
+            empty.setTextAppearance(R.style.TextAppearance_TextMedium_Secondary);
+            empty.setGravity(Gravity.CENTER);
+            int pad = Math.round(48 * context.getResources().getDisplayMetrics().density);
+            empty.setPadding(pad, pad, pad, pad);
+            list.addView(
+                    empty,
+                    new ViewGroup.LayoutParams(
+                            ViewGroup.LayoutParams.MATCH_PARENT,
+                            ViewGroup.LayoutParams.WRAP_CONTENT));
+            mEmptyView = empty;
+        }
+        refresh();
+        return view;
+    }
+
+    @Override
+    public void onCreateOptionsMenu(Menu menu, MenuInflater inflater) {
+        super.onCreateOptionsMenu(menu, inflater);
+        menu.add(Menu.NONE, MENU_CLEAR, Menu.NONE, R.string.bare_notices_clear)
+                .setShowAsAction(MenuItem.SHOW_AS_ACTION_IF_ROOM);
+    }
+
+    @Override
+    public boolean onOptionsItemSelected(MenuItem item) {
+        if (item.getItemId() == MENU_CLEAR) {
+            BareNotices.clear();
+            return true;
+        }
+        return super.onOptionsItemSelected(item);
+    }
+
+    private void refresh() {
+        List<BareNotices.Entry> entries = BareNotices.entries();
+        if (mAdapter != null) mAdapter.show(entries);
+        if (mEmptyView != null) {
+            mEmptyView.setVisibility(entries.isEmpty() ? View.VISIBLE : View.GONE);
+        }
+    }
+
+    @Override
+    public MonotonicObservableSupplier<String> getPageTitle() {
+        return mPageTitle;
+    }
+
+    @Override
+    public @AnimationType int getAnimationType() {
+        return AnimationType.PROPERTY;
+    }
+
+    private static final class NoticeItem extends DateDividedAdapter.TimedItem {
+        final BareNotices.Entry mEntry;
+
+        NoticeItem(BareNotices.Entry entry) {
+            mEntry = entry;
+        }
+
+        @Override
+        public long getTimestamp() {
+            return mEntry.time;
+        }
+
+        @Override
+        public long getStableId() {
+            return mEntry.id;
+        }
+    }
+
+    /** Rows like a download or a history entry, under Today, Yesterday and dated headings. */
+    private static final class NoticesAdapter extends DateDividedAdapter {
+        void show(List<BareNotices.Entry> entries) {
+            clear(false);
+            if (entries.isEmpty()) {
+                notifyDataSetChanged();
+                return;
+            }
+            List<NoticeItem> items = new ArrayList<>();
+            for (BareNotices.Entry entry : entries) items.add(new NoticeItem(entry));
+            loadItems(items);
+        }
+
+        @Override
+        protected RecyclerView.ViewHolder createViewHolder(ViewGroup parent) {
+            View row =
+                    LayoutInflater.from(parent.getContext())
+                            .inflate(R.layout.modern_list_item_view, parent, false);
+            return new BasicViewHolder(row);
+        }
+
+        @Override
+        protected void bindViewHolderForTimedItem(
+                RecyclerView.ViewHolder viewHolder, TimedItem item) {
+            BareNotices.Entry entry = ((NoticeItem) item).mEntry;
+            View row = viewHolder.itemView;
+            Context context = row.getContext();
+            TextView title = row.findViewById(R.id.title);
+            TextView description = row.findViewById(R.id.description);
+            ImageView icon = row.findViewById(R.id.start_icon);
+            View end = row.findViewById(R.id.end_button);
+            title.setText(entry.message);
+            title.setSingleLine(false);
+            title.setMaxLines(3);
+            String time =
+                    DateUtils.formatDateTime(context, entry.time, DateUtils.FORMAT_SHOW_TIME);
+            description.setText(entry.source == null ? time : entry.source + " · " + time);
+            description.setVisibility(View.VISIBLE);
+            if (icon != null) {
+                icon.setImageResource(R.drawable.notifications_active);
+                icon.setVisibility(View.VISIBLE);
+            }
+            if (end != null) end.setVisibility(View.GONE);
+        }
+
+        @Override
+        protected int getTimedItemViewResId() {
+            return R.layout.date_view;
+        }
+    }
+}

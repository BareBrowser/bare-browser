diff --git a/chrome/browser/bare/background_audio/background_audio_tracker.cc b/chrome/browser/bare/background_audio/background_audio_tracker.cc
new file mode 100644
index 00000000000..b9b539cb483
--- /dev/null
+++ b/chrome/browser/bare/background_audio/background_audio_tracker.cc
@@ -0,0 +1,72 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/bare/background_audio/background_audio_tracker.h"
+
+#include "base/functional/bind.h"
+#include "base/time/time.h"
+#include "content/public/browser/navigation_handle.h"
+#include "content/public/browser/web_contents.h"
+
+namespace bare {
+
+namespace {
+
+// How long it stays on after the audio stops.
+constexpr base::TimeDelta kLingerTime = base::Seconds(30);
+
+}  // namespace
+
+BackgroundAudioTracker::BackgroundAudioTracker(
+    content::WebContents* web_contents)
+    : content::WebContentsObserver(web_contents),
+      content::WebContentsUserData<BackgroundAudioTracker>(*web_contents),
+      active_(web_contents->IsCurrentlyAudible()) {}
+
+BackgroundAudioTracker::~BackgroundAudioTracker() = default;
+
+// static
+bool BackgroundAudioTracker::IsActive(content::WebContents* web_contents) {
+  BackgroundAudioTracker::CreateForWebContents(web_contents);
+  return BackgroundAudioTracker::FromWebContents(web_contents)->active_;
+}
+
+void BackgroundAudioTracker::OnAudioStateChanged(bool audible) {
+  if (audible) {
+    linger_timer_.Stop();
+    SetActive(true);
+  } else if (active_) {
+    linger_timer_.Start(FROM_HERE, kLingerTime,
+                        base::BindOnce(&BackgroundAudioTracker::OnLingerTimeout,
+                                       base::Unretained(this)));
+  }
+}
+
+void BackgroundAudioTracker::DidFinishNavigation(
+    content::NavigationHandle* handle) {
+  if (!handle->IsInPrimaryMainFrame() || !handle->HasCommitted() ||
+      handle->IsSameDocument()) {
+    return;
+  }
+  // A new page starts from scratch. If it plays sound, the audio state change
+  // turns this back on.
+  linger_timer_.Stop();
+  active_ = false;
+}
+
+void BackgroundAudioTracker::OnLingerTimeout() {
+  SetActive(false);
+}
+
+void BackgroundAudioTracker::SetActive(bool active) {
+  if (active_ == active) {
+    return;
+  }
+  active_ = active;
+  web_contents()->NotifyPreferencesChanged();
+}
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(BackgroundAudioTracker);
+
+}  // namespace bare
diff --git a/chrome/browser/bare/background_audio/background_audio_tracker.h b/chrome/browser/bare/background_audio/background_audio_tracker.h

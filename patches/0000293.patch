diff --git a/chrome/android/BUILD.gn b/chrome/android/BUILD.gn
index 0311f7c7395d524caf49449169bcbfc2938f4bf5..28ebd0c7d7111123873e915e9236e3030b644031 100644
--- a/chrome/android/BUILD.gn
+++ b/chrome/android/BUILD.gn
@@ -49,6 +49,7 @@ if (_is_default_toolchain) {
   import("channel.gni")
   import("java_sources.gni")
   import("static_initializers.gni")
+  import("bare_diagnostics.gni")
   import("trichrome.gni")
 }
 
@@ -189,6 +190,7 @@ if (_is_default_toolchain) {
       "java/res_chromium_base/mipmap-anydpi-v26/bare_icon_dark.xml",
       "java/res_chromium_base/mipmap-anydpi-v26/bare_icon_dark_round.xml",
       "java/res_chromium_base/values/bare_icon_v5_colors.xml",
+      "java/res_chromium_base/values/bare_launcher_label.xml",
       "java/res_chromium_base/values/channel_constants.xml",
     ]
   }
@@ -919,6 +921,7 @@ if (_is_default_toolchain) {
       "//components/sharing_message:sharing_send_message_result_generated_enum",
       "//components/supervised_user/core/browser:supervised_user_utils_enum_javagen",
       "//components/touch_to_search/core/browser:quick_action_category_enum_javagen",
+      ":bare_diag_buildflags",
     ]
 
     # From java_sources.gni.
@@ -1007,6 +1010,15 @@ if (_is_default_toolchain) {
     }
   }
 
+  # Carries bare_diagnostics into Java as a constant, so a build without it has
+  # none of the logging code to run.
+  java_cpp_template("bare_diag_buildflags") {
+    sources = [ "java/src/org/chromium/chrome/browser/bare/BareDiagBuildflags.template" ]
+    if (bare_diagnostics) {
+      defines = [ "BARE_DIAGNOSTICS" ]
+    }
+  }
+
   generate_product_config_srcjar("chrome_product_config") {
     java_package = "org.chromium.chrome.browser"
   }
@@ -1880,6 +1892,7 @@ if (_is_default_toolchain) {
       "java/res_chromium_base/mipmap-anydpi-v26/bare_icon_dark.xml",
       "java/res_chromium_base/mipmap-anydpi-v26/bare_icon_dark_round.xml",
       "java/res_chromium_base/values/bare_icon_v5_colors.xml",
+      "java/res_chromium_base/values/bare_launcher_label.xml",
       "java/res_chromium_base/values/channel_constants.xml",
     ]
 
@@ -1887,6 +1900,21 @@ if (_is_default_toolchain) {
     deps = [ ":chrome_base_module_resources" ]
   }
 
+  # Bare CrashLab's launcher icon and label, laid over the ones above. Only the
+  # CrashLab build depends on it.
+  android_resources("bare_crashlab_resources") {
+    resource_overlay = true
+    sources = [
+      "java/res_bare_crashlab/mipmap-hdpi/bare_icon_v5_foreground.png",
+      "java/res_bare_crashlab/mipmap-mdpi/bare_icon_v5_foreground.png",
+      "java/res_bare_crashlab/mipmap-xhdpi/bare_icon_v5_foreground.png",
+      "java/res_bare_crashlab/mipmap-xxhdpi/bare_icon_v5_foreground.png",
+      "java/res_bare_crashlab/mipmap-xxxhdpi/bare_icon_v5_foreground.png",
+      "java/res_bare_crashlab/values/bare_launcher_label.xml",
+    ]
+    deps = [ ":chrome_public_apk_base_module_resources" ]
+  }
+
   version_resource_dir = "$target_gen_dir/templates/chrome_version_xml/res"
   version_resource_file = "$version_resource_dir/values/strings.xml"
 
diff --git a/chrome/android/bare_diagnostics.gni b/chrome/android/bare_diagnostics.gni
new file mode 100644
index 0000000000000000000000000000000000000000..dc6563eade1d2cc9f5b9585396852a7e04d0940c
--- /dev/null
+++ b/chrome/android/bare_diagnostics.gni
@@ -0,0 +1,10 @@
+# Copyright 2026 The Chromium Authors
+# Use of this source code is governed by a BSD-style license that can be
+# found in the LICENSE file.
+
+declare_args() {
+  # Builds Bare CrashLab, the variant that keeps a log of each session in
+  # Downloads. It is meant to be built with its own chrome_public_manifest_package
+  # so that it installs beside Bare.
+  bare_diagnostics = false
+}

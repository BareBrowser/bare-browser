diff --git a/chrome/android/java/src/org/chromium/chrome/browser/bare/BareDiagnostics.java b/chrome/android/java/src/org/chromium/chrome/browser/bare/BareDiagnostics.java
new file mode 100644
index 0000000000000000000000000000000000000000..fda50c99beed005209591fad72f5da6f8f7a688f
--- /dev/null
+++ b/chrome/android/java/src/org/chromium/chrome/browser/bare/BareDiagnostics.java
@@ -0,0 +1,433 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.bare;
+
+import android.app.Activity;
+import android.app.ActivityManager;
+import android.app.ApplicationExitInfo;
+import android.app.Application;
+import android.content.ComponentCallbacks2;
+import android.content.ContentValues;
+import android.content.Context;
+import android.content.res.Configuration;
+import android.net.Uri;
+import android.os.Build;
+import android.os.Bundle;
+import android.os.Debug;
+import android.os.PowerManager;
+import android.os.Process;
+import android.os.SystemClock;
+import android.provider.MediaStore;
+
+import androidx.annotation.RequiresApi;
+
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+
+import java.io.BufferedReader;
+import java.io.BufferedWriter;
+import java.io.IOException;
+import java.io.InputStreamReader;
+import java.io.OutputStream;
+import java.io.OutputStreamWriter;
+import java.io.PrintWriter;
+import java.io.StringWriter;
+import java.nio.charset.StandardCharsets;
+import java.text.SimpleDateFormat;
+import java.util.Date;
+import java.util.List;
+import java.util.Locale;
+import java.util.concurrent.Executors;
+import java.util.concurrent.ScheduledExecutorService;
+import java.util.concurrent.TimeUnit;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+
+/**
+ * The log Bare CrashLab keeps of a session.
+ *
+ * <p>Started once from the application, only in a build made with bare_diagnostics. It copies the
+ * app's own logcat into a file in Downloads as it happens, so the file is already there when the
+ * browser is closed, killed or crashes. A Java crash is written straight to the file; a native
+ * crash cannot run any Java, so the next start adds how the last session ended, when Android says.
+ *
+ * <p>Page addresses are cut down to scheme and host before anything is written. Nothing leaves the
+ * phone: the file is for the person who owns it to read or send.
+ */
+@NullMarked
+public final class BareDiagnostics {
+    private static final Pattern URL =
+            Pattern.compile(
+                    "([A-Za-z][A-Za-z0-9+.-]*://)(?:[^/\\s\"'<>?#@]*@)?"
+                            + "([^/\\s\"'<>?#]+)[^\\s\"'<>]*");
+    private static final long FLUSH_SECONDS = 2;
+    private static final long HEARTBEAT_SECONDS = 30;
+
+    private static final Object sLock = new Object();
+    private static @Nullable BufferedWriter sWriter;
+    private static boolean sStarted;
+    private static int sStartedActivities;
+
+    private BareDiagnostics() {}
+
+    /** Opens the log and starts copying into it. Safe to call more than once. */
+    public static void start(Application app) {
+        synchronized (sLock) {
+            if (sStarted) return;
+            sStarted = true;
+        }
+        long now = System.currentTimeMillis();
+        long sinceStart = SystemClock.elapsedRealtime() - Process.getStartElapsedRealtime();
+        long processStart = now - Math.max(0, sinceStart);
+        if (!open(app, now)) return;
+
+        writeHeader(app, processStart);
+        installCrashHandler();
+        registerLifecycle(app);
+
+        ScheduledExecutorService timer =
+                Executors.newSingleThreadScheduledExecutor(
+                        runnable -> new Thread(runnable, "BareDiagnostics"));
+        timer.scheduleWithFixedDelay(
+                BareDiagnostics::flush, FLUSH_SECONDS, FLUSH_SECONDS, TimeUnit.SECONDS);
+        timer.scheduleWithFixedDelay(
+                () -> heartbeat(app), HEARTBEAT_SECONDS, HEARTBEAT_SECONDS, TimeUnit.SECONDS);
+        startLogcat(processStart);
+    }
+
+    private static boolean open(Context context, long now) {
+        try {
+            String stamp = new SimpleDateFormat("yyyyMMdd-HHmmss", Locale.US).format(new Date(now));
+            ContentValues values = new ContentValues();
+            values.put(MediaStore.Downloads.DISPLAY_NAME, "bare-crashlab-" + stamp + ".txt");
+            values.put(MediaStore.Downloads.MIME_TYPE, "text/plain");
+            values.put(MediaStore.Downloads.RELATIVE_PATH, "Download/");
+            Uri uri =
+                    context.getContentResolver()
+                            .insert(MediaStore.Downloads.EXTERNAL_CONTENT_URI, values);
+            if (uri == null) return false;
+            OutputStream out = context.getContentResolver().openOutputStream(uri);
+            if (out == null) return false;
+            synchronized (sLock) {
+                sWriter =
+                        new BufferedWriter(
+                                new OutputStreamWriter(out, StandardCharsets.UTF_8), 16 * 1024);
+            }
+            return true;
+        } catch (IOException | RuntimeException e) {
+            return false;
+        }
+    }
+
+    private static void writeHeader(Application app, long processStart) {
+        ActivityManager am = (ActivityManager) app.getSystemService(Context.ACTIVITY_SERVICE);
+        ActivityManager.MemoryInfo memory = new ActivityManager.MemoryInfo();
+        if (am != null) am.getMemoryInfo(memory);
+        String version = "unknown";
+        try {
+            android.content.pm.PackageInfo info =
+                    app.getPackageManager().getPackageInfo(app.getPackageName(), 0);
+            version = info.versionName + " (" + info.getLongVersionCode() + ")";
+        } catch (android.content.pm.PackageManager.NameNotFoundException e) {
+            // Keeps "unknown".
+        }
+        line("Bare CrashLab log");
+        line("Started: " + stamp(processStart));
+        line("Bare: " + version + " " + app.getPackageName());
+        line(
+                "Device: "
+                        + Build.MANUFACTURER
+                        + " "
+                        + Build.MODEL
+                        + ", Android "
+                        + Build.VERSION.RELEASE
+                        + " (API "
+                        + Build.VERSION.SDK_INT
+                        + "), "
+                        + Build.SUPPORTED_ABIS[0]);
+        line(
+                "Memory: total "
+                        + memory.totalMem / (1024 * 1024)
+                        + " MB, free "
+                        + memory.availMem / (1024 * 1024)
+                        + " MB, class "
+                        + (am != null ? am.getMemoryClass() : 0)
+                        + " MB");
+        line("Previous session: " + previousExit(app, am));
+        line("Page addresses are cut to scheme and host in this file.");
+        line("");
+    }
+
+    private static String previousExit(Context context, @Nullable ActivityManager am) {
+        if (am == null || Build.VERSION.SDK_INT < Build.VERSION_CODES.R) {
+            return "not reported by this Android version";
+        }
+        return ExitReasons.last(context, am);
+    }
+
+    @RequiresApi(Build.VERSION_CODES.R)
+    private static final class ExitReasons {
+        static String last(Context context, ActivityManager am) {
+            try {
+                // Renderer and GPU processes leave records too; the browser process is the
+                // one named after the package.
+                List<ApplicationExitInfo> exits =
+                        am.getHistoricalProcessExitReasons(context.getPackageName(), 0, 20);
+                ApplicationExitInfo last = null;
+                for (ApplicationExitInfo info : exits) {
+                    if (context.getPackageName().equals(info.getProcessName())) {
+                        last = info;
+                        break;
+                    }
+                }
+                if (last == null) return "none recorded";
+                return stamp(last.getTimestamp())
+                        + " "
+                        + name(last.getReason())
+                        + ", importance "
+                        + last.getImportance()
+                        + ", "
+                        + (last.getDescription() == null ? "" : last.getDescription());
+            } catch (RuntimeException e) {
+                return "unreadable";
+            }
+        }
+
+        private static String name(int reason) {
+            switch (reason) {
+                case ApplicationExitInfo.REASON_EXIT_SELF:
+                    return "exited by itself";
+                case ApplicationExitInfo.REASON_SIGNALED:
+                    return "killed by a signal";
+                case ApplicationExitInfo.REASON_LOW_MEMORY:
+                    return "killed for memory";
+                case ApplicationExitInfo.REASON_CRASH:
+                    return "Java crash";
+                case ApplicationExitInfo.REASON_CRASH_NATIVE:
+                    return "native crash";
+                case ApplicationExitInfo.REASON_ANR:
+                    return "not responding";
+                case ApplicationExitInfo.REASON_INITIALIZATION_FAILURE:
+                    return "failed to start";
+                case ApplicationExitInfo.REASON_PERMISSION_CHANGE:
+                    return "permission changed";
+                case ApplicationExitInfo.REASON_EXCESSIVE_RESOURCE_USAGE:
+                    return "used too many resources";
+                case ApplicationExitInfo.REASON_USER_REQUESTED:
+                    return "stopped by the user";
+                case ApplicationExitInfo.REASON_USER_STOPPED:
+                    return "user stopped";
+                case ApplicationExitInfo.REASON_DEPENDENCY_DIED:
+                    return "a dependency died";
+                default:
+                    return "other (" + reason + ")";
+            }
+        }
+    }
+
+    private static void startLogcat(long processStart) {
+        Thread reader =
+                new Thread(
+                        () -> {
+                            try {
+                                String since =
+                                        new SimpleDateFormat("MM-dd HH:mm:ss.SSS", Locale.US)
+                                                .format(new Date(processStart));
+                                java.lang.Process logcat =
+                                        new ProcessBuilder(
+                                                        "logcat", "-v", "threadtime", "-T", since)
+                                                .redirectErrorStream(true)
+                                                .start();
+                                try (BufferedReader in =
+                                        new BufferedReader(
+                                                new InputStreamReader(
+                                                        logcat.getInputStream(),
+                                                        StandardCharsets.UTF_8))) {
+                                    String text;
+                                    while ((text = in.readLine()) != null) {
+                                        line(text);
+                                        if (isError(text)) flush();
+                                    }
+                                }
+                            } catch (IOException | RuntimeException e) {
+                                line("logcat stopped: " + e.getClass().getSimpleName());
+                            }
+                        },
+                        "BareDiagnosticsLogcat");
+        reader.setDaemon(true);
+        reader.start();
+    }
+
+    // A threadtime line has the level after the thread id: "date time pid tid L tag: message".
+    private static boolean isError(String text) {
+        String[] parts = text.split("\\s+", 7);
+        return parts.length > 5 && (parts[4].equals("E") || parts[4].equals("F"));
+    }
+
+    private static void installCrashHandler() {
+        Thread.UncaughtExceptionHandler current = Thread.getDefaultUncaughtExceptionHandler();
+        if (current instanceof CrashHandler) return;
+        Thread.setDefaultUncaughtExceptionHandler(new CrashHandler(current));
+    }
+
+    private static final class CrashHandler implements Thread.UncaughtExceptionHandler {
+        private final Thread.@Nullable UncaughtExceptionHandler mNext;
+
+        CrashHandler(Thread.@Nullable UncaughtExceptionHandler next) {
+            mNext = next;
+        }
+
+        @Override
+        public void uncaughtException(Thread thread, Throwable error) {
+            StringWriter trace = new StringWriter();
+            error.printStackTrace(new PrintWriter(trace));
+            line("");
+            line(
+                    "JAVA CRASH on thread "
+                            + thread.getName()
+                            + " at "
+                            + stamp(System.currentTimeMillis()));
+            for (String text : trace.toString().split("\n")) line(text);
+            flush();
+            if (mNext != null) mNext.uncaughtException(thread, error);
+        }
+    }
+
+    private static void registerLifecycle(Application app) {
+        app.registerActivityLifecycleCallbacks(
+                new Application.ActivityLifecycleCallbacks() {
+                    @Override
+                    public void onActivityCreated(Activity activity, @Nullable Bundle state) {
+                        // Chromium may set its own handler after this one; wrap it again.
+                        installCrashHandler();
+                        event(activity, "created" + (state != null ? " (restored)" : ""));
+                    }
+
+                    @Override
+                    public void onActivityStarted(Activity activity) {
+                        sStartedActivities++;
+                        event(activity, "started");
+                    }
+
+                    @Override
+                    public void onActivityResumed(Activity activity) {
+                        event(activity, "resumed");
+                    }
+
+                    @Override
+                    public void onActivityPaused(Activity activity) {
+                        event(activity, "paused");
+                        flush();
+                    }
+
+                    @Override
+                    public void onActivityStopped(Activity activity) {
+                        if (sStartedActivities > 0) sStartedActivities--;
+                        event(
+                                activity,
+                                "stopped"
+                                        + (sStartedActivities == 0
+                                                ? ", now in the background"
+                                                : ""));
+                        flush();
+                    }
+
+                    @Override
+                    public void onActivitySaveInstanceState(Activity activity, Bundle state) {}
+
+                    @Override
+                    public void onActivityDestroyed(Activity activity) {
+                        event(
+                                activity,
+                                "destroyed" + (activity.isFinishing() ? " (finishing)" : ""));
+                        flush();
+                    }
+                });
+        app.registerComponentCallbacks(
+                new ComponentCallbacks2() {
+                    @Override
+                    public void onTrimMemory(int level) {
+                        line(
+                                stamp(System.currentTimeMillis())
+                                        + " Android asks for memory, level "
+                                        + level);
+                    }
+
+                    @Override
+                    public void onConfigurationChanged(Configuration config) {}
+
+                    @Override
+                    public void onLowMemory() {
+                        line(stamp(System.currentTimeMillis()) + " Android reports low memory");
+                        flush();
+                    }
+                });
+    }
+
+    private static void event(Activity activity, String what) {
+        line(
+                stamp(System.currentTimeMillis())
+                        + " "
+                        + activity.getClass().getSimpleName()
+                        + " "
+                        + what);
+    }
+
+    private static void heartbeat(Application app) {
+        ActivityManager am = (ActivityManager) app.getSystemService(Context.ACTIVITY_SERVICE);
+        PowerManager power = (PowerManager) app.getSystemService(Context.POWER_SERVICE);
+        ActivityManager.MemoryInfo memory = new ActivityManager.MemoryInfo();
+        if (am != null) am.getMemoryInfo(memory);
+        Debug.MemoryInfo mine = new Debug.MemoryInfo();
+        Debug.getMemoryInfo(mine);
+        line(
+                stamp(System.currentTimeMillis())
+                        + " status: Bare "
+                        + mine.getTotalPss() / 1024
+                        + " MB, phone free "
+                        + memory.availMem / (1024 * 1024)
+                        + " MB"
+                        + (memory.lowMemory ? " (low)" : "")
+                        + ", heat "
+                        + (power != null ? power.getCurrentThermalStatus() : -1)
+                        + ", "
+                        + (sStartedActivities > 0 ? "in front" : "in background"));
+    }
+
+    private static String stamp(long millis) {
+        return new SimpleDateFormat("yyyy-MM-dd HH:mm:ss.SSS", Locale.US).format(new Date(millis));
+    }
+
+    /** Cuts every address in the text down to scheme and host. */
+    static String scrub(String text) {
+        Matcher matcher = URL.matcher(text);
+        return matcher.find() ? matcher.replaceAll("$1$2/...") : text;
+    }
+
+    private static void line(String text) {
+        synchronized (sLock) {
+            BufferedWriter writer = sWriter;
+            if (writer == null) return;
+            try {
+                writer.write(scrub(text));
+                writer.write('\n');
+            } catch (IOException e) {
+                sWriter = null;
+            }
+        }
+    }
+
+    private static void flush() {
+        synchronized (sLock) {
+            BufferedWriter writer = sWriter;
+            if (writer == null) return;
+            try {
+                writer.flush();
+            } catch (IOException e) {
+                sWriter = null;
+            }
+        }
+    }
+}

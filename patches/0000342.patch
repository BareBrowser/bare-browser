+            android:pathData="M 235.0 840.7 C 255.8 785.4 285.6 731.8 325.4 685.7 C 365.2 639.6 415.0 600.9 469.8 573.3 C 524.6 545.7 584.2 529.1 644.7 520.5 C 705.2 511.9 766.4 511.3 827.1 520.7 C 807.1 565.1 783.7 607.4 754.6 646.0 C 725.5 684.6 690.6 719.5 651.2 747.7 C 611.9 776.0 568.1 797.7 521.9 811.4 C 494.2 819.6 465.6 824.9 436.8 828.5 C 412.7 831.4 388.5 833.1 364.4 831.8 C 345.1 830.7 325.8 827.7 306.7 828.7 C 282.7 830.1 258.7 837.9 235.0 840.7 Z" />

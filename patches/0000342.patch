--- /dev/null
+++ b/chrome/android/java/src/org/chromium/chrome/browser/bare/player/BarePlayerController.java
@@ -0,0 +1,712 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.bare.player;
+
+import android.app.Activity;
+import android.content.pm.ActivityInfo;
+import android.content.res.Configuration;
+import android.graphics.Color;
+import android.graphics.drawable.ColorDrawable;
+import android.graphics.drawable.Drawable;
+import android.os.Handler;
+import android.os.Looper;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.FrameLayout;
+import android.widget.PopupMenu;
+import android.widget.Toast;
+
+import org.json.JSONArray;
+import org.json.JSONException;
+import org.json.JSONObject;
+
+import org.chromium.base.Log;
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.chrome.R;
+import org.chromium.chrome.browser.bare.BareMediaRegistryBridge;
+import org.chromium.chrome.browser.media.PictureInPicture;
+import org.chromium.chrome.browser.fullscreen.FullscreenManager;
+import org.chromium.chrome.browser.fullscreen.FullscreenOptions;
+import org.chromium.chrome.browser.tab.Tab;
+import org.chromium.content_public.browser.RenderFrameHost;
+import org.chromium.content_public.browser.WebContents;
+import org.chromium.ui.base.WindowAndroid;
+
+import java.lang.ref.WeakReference;
+import java.util.WeakHashMap;
+
+/**
+ * Bare Player: native controls for the page's own video in fullscreen.
+ *
+ * <p>When a page goes fullscreen with a video in it, the player finds that video (in whichever
+ * frame holds it), asks for fullscreen on the video element itself so the site's own controls and
+ * overlays drop away, and lays native controls over it. Playback never leaves the page: the same
+ * element, the same media pipeline, the same session, cookies, DRM and audio. If no video is found,
+ * or the page will not let the video itself go fullscreen, the site's own fullscreen is left as it
+ * was (or, in the second case, keeps the native controls over it).
+ *
+ * <p>The long-press menu can also open a video in the player, which goes the same way: it puts the
+ * video into fullscreen, and the fullscreen it causes brings the player up.
+ */
+@NullMarked
+public final class BarePlayerController implements FullscreenManager.Observer, BarePlayerView.Delegate {
+    private static final String TAG = "BarePlayer";
+
+    private static final long FIRST_LOOK_MS = 150;
+    private static final long RETRY_LOOK_MS = 400;
+    private static final int LOOK_ATTEMPTS = 3;
+    private static final long POLL_MS = 500;
+    private static final long ENTER_CHECK_MS = 900;
+    private static final long REVEAL_SETTLE_MS = 300;
+    private static final long REVEAL_FALLBACK_MS = 1600;
+
+    private static final WeakHashMap<Activity, BarePlayerController> sControllers =
+            new WeakHashMap<>();
+
+    // The page and frame whose video Bare Player last sent to picture-in-picture, so the
+    // window's expand button can bring it back fullscreen.
+    private static @Nullable WeakReference<WebContents> sPipContents;
+    private static int sPipFrame = -1;
+
+    private final Activity mActivity;
+    private final FullscreenManager mFullscreenManager;
+    private final Handler mHandler = new Handler(Looper.getMainLooper());
+
+    // The player in use, if any.
+    private @Nullable BarePlayerView mView;
+    private @Nullable Tab mTab;
+    private @Nullable WebContents mWebContents;
+    private int mFrameId;
+    private boolean mVideoFullscreen;
+    private boolean mRevealScheduled;
+    private boolean mPollInFlight;
+    private boolean mRefound;
+    private int mSavedOrientation;
+    private int mEntryOrientation;
+    private boolean mOrientationForced;
+    private @Nullable Drawable mSavedWindowBackground;
+
+    // The video's own file, when it plays one straight from an http(s) address.
+    private @Nullable String mDirectSource;
+
+    // Bumped whenever the fullscreen state changes, so answers to an earlier look are dropped.
+    private int mGeneration;
+
+    private final Runnable mPoll = this::poll;
+
+    private BarePlayerController(Activity activity, FullscreenManager fullscreenManager) {
+        mActivity = activity;
+        mFullscreenManager = fullscreenManager;
+        fullscreenManager.addObserver(this);
+    }
+
+    /** Starts watching an activity's fullscreen. */
+    public static void attach(Activity activity, FullscreenManager fullscreenManager) {
+        if (sControllers.containsKey(activity)) return;
+        sControllers.put(activity, new BarePlayerController(activity, fullscreenManager));
+    }
+
+    /** Stops watching, and closes the player if it is up. */
+    public static void detach(Activity activity) {
+        BarePlayerController controller = sControllers.remove(activity);
+        if (controller == null) return;
+        controller.tearDown();
+        controller.mFullscreenManager.removeObserver(controller);
+    }
+
+    /**
+     * Opens the video someone is watching on this page in the player, from the long-press menu.
+     * Does nothing when the player is off.
+     */
+    public static void openFromPage(
+            @Nullable WebContents webContents,
+            @Nullable RenderFrameHost frame,
+            int xDp,
+            int yDp) {
+        if (webContents == null || !BarePlayerSettings.isEnabled()) return;
+        WindowAndroid window = webContents.getTopLevelNativeWindow();
+        Activity activity = window == null ? null : window.getActivity().get();
+        BarePlayerController controller = activity == null ? null : sControllers.get(activity);
+        if (controller == null) return;
+        int frameId = BarePlayerBridge.frameIdOf(frame);
+        if (frameId < 0) {
+            controller.lookOnPage(webContents);
+        } else {
+            controller.lookInFrame(webContents, frameId, xDp, yDp);
+        }
+    }
+
+    /** Ten seconds back or forward for the video in picture-in-picture (the window's buttons). */
+    public static void seekPictureInPicture(@Nullable WebContents webContents, double seconds) {
+        BarePlayerBridge.evaluateAll(webContents, BarePlayerScripts.pipSeekBy(seconds), r -> {});
+    }
+
+    /**
+     * The picture-in-picture window was expanded. If Bare Player sent that video there, it comes
+     * back fullscreen in Bare Player rather than in the page.
+     */
+    public static void onPictureInPictureExpanded(@Nullable WebContents webContents) {
+        WeakReference<WebContents> pip = sPipContents;
+        int frameId = sPipFrame;
+        sPipContents = null;
+        if (webContents == null || pip == null || pip.get() != webContents) return;
+        if (!BarePlayerSettings.isEnabled()) return;
+        new Handler(Looper.getMainLooper())
+                .postDelayed(
+                        () ->
+                                BarePlayerBridge.evaluateIn(
+                                        webContents,
+                                        frameId,
+                                        BarePlayerScripts.FULLSCREEN_AFTER_PIP,
+                                        /* activate= */ true,
+                                        r -> {}),
+                        500);
+    }
+
+    // ---- Fullscreen ----
+
+    @Override
+    public void onEnterFullscreen(Tab tab, FullscreenOptions options) {
+        WebContents webContents = tab.getWebContents();
+        if (webContents == null) return;
+        // The player's own request for fullscreen on the video comes back through here.
+        if (mView != null && webContents == mWebContents) return;
+        if (!BarePlayerSettings.isEnabled()) return;
+        tearDown();
+        mTab = tab;
+        mWebContents = webContents;
+        int generation = ++mGeneration;
+        // Cover the screen straight away, so the page's own fullscreen layout never shows while
+        // the video is found and moved into fullscreen on its own.
+        showView();
+        mHandler.postDelayed(() -> lookForFullscreenVideo(generation, 1), FIRST_LOOK_MS);
+    }
+
+    @Override
+    public void onExitFullscreen(Tab tab) {
+        if (tab != mTab) return;
+        tearDown();
+    }
+
+    /**
+     * Asks every frame for the video it is showing fullscreen. The page may still be building its
+     * fullscreen layout when the browser hears about it, so this looks a few times.
+     */
+    private void lookForFullscreenVideo(int generation, int attempt) {
+        if (generation != mGeneration) return;
+        WebContents webContents = mWebContents;
+        BarePlayerBridge.evaluateAll(
+                webContents,
+                BarePlayerScripts.FIND_FULLSCREEN,
+                json -> {
+                    if (generation != mGeneration) return;
+                    Found found = best(json, /* fromMenu= */ false);
+                    if (found == null) {
+                        if (attempt < LOOK_ATTEMPTS) {
+                            mHandler.postDelayed(
+                                    () -> lookForFullscreenVideo(generation, attempt + 1),
+                                    RETRY_LOOK_MS);
+                        } else {
+                            Log.i(TAG, "No video in fullscreen; the site's own player stays.");
+                            // Lift the cover and leave the page's fullscreen to it.
+                            tearDown();
+                        }
+                        return;
+                    }
+                    takeOver(generation, found);
+                });
+    }
+
+    private void takeOver(int generation, Found found) {
+        mFrameId = found.frameId;
+        boolean self = found.info.optBoolean("self");
+        Log.i(
+                TAG,
+                "Taking over: frame=" + found.frameId + " self=" + self + " kind="
+                        + found.info.optString("kind") + " drm=" + found.info.optBoolean("drm")
+                        + " size=" + found.info.optInt("w") + "x" + found.info.optInt("h"));
+        if (self) {
+            BarePlayerBridge.evaluateIn(
+                    mWebContents, mFrameId, BarePlayerScripts.HIDE_CONTROLS, false, r -> {});
+        } else {
+            // The site made its own container fullscreen; ask for the video alone. The tap that
+            // got here was the user's, on the site's fullscreen button, so the frame is given the
+            // activation that request needs.
+            BarePlayerBridge.evaluateIn(
+                    mWebContents, mFrameId, BarePlayerScripts.ENTER, /* activate= */ true, r -> {});
+        }
+        showView();
+        mHandler.post(mPoll);
+        // If the page keeps the video inside its own fullscreen, still show it after a moment.
+        mHandler.postDelayed(
+                () -> {
+                    if (generation == mGeneration && mView != null) mView.reveal();
+                },
+                REVEAL_FALLBACK_MS);
+    }
+
+    private void showView() {
+        if (mView != null) return;
+        mSavedOrientation = mActivity.getRequestedOrientation();
+        mEntryOrientation = mActivity.getResources().getConfiguration().orientation;
+        mOrientationForced = false;
+        // A video window never shows white: behind the player and in the picture-in-picture
+        // transition the window itself is black, in light mode too. Given back in tearDown.
+        mSavedWindowBackground = mActivity.getWindow().getDecorView().getBackground();
+        mActivity.getWindow().setBackgroundDrawable(new ColorDrawable(Color.BLACK));
+        BarePlayerView view = new BarePlayerView(mActivity, this);
+        ViewGroup root = mActivity.findViewById(android.R.id.content);
+        root.addView(
+                view,
+                new FrameLayout.LayoutParams(
+                        ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT));
+        view.requestApplyInsets();
+        mView = view;
+    }
+
+    /** Closes the controls and gives back what the player changed. Leaves the page alone. */
+    private void tearDown() {
+        mGeneration++;
+        mHandler.removeCallbacksAndMessages(null);
+        mPollInFlight = false;
+        mRefound = false;
+        BarePlayerView view = mView;
+        mView = null;
+        if (view != null) {
+            view.release();
+            view.fadeAway(
+                    () -> {
+                        if (view.getParent() instanceof ViewGroup parent) parent.removeView(view);
+                    });
+            BarePlayerBridge.evaluateIn(
+                    mWebContents, mFrameId, BarePlayerScripts.CLEAN_UP, false, r -> {});
+            if (mSavedWindowBackground != null) {
+                mActivity.getWindow().setBackgroundDrawable(mSavedWindowBackground);
+                mSavedWindowBackground = null;
+            }
+            if (mOrientationForced) {
+                restoreOrientation();
+                mOrientationForced = false;
+            }
+        }
+        mVideoFullscreen = false;
+        mRevealScheduled = false;
+        mTab = null;
+        mWebContents = null;
+    }
+
+    /**
+     * Goes back to how the screen was turned when the player opened. Handing straight back to the
+     * earlier request is not enough: with auto-rotate on and the phone lying flat, nothing turns
+     * the screen back, so the screen is first held where it started, then released.
+     */
+    private void restoreOrientation() {
+        int saved = mSavedOrientation;
+        int current = mActivity.getResources().getConfiguration().orientation;
+        if (current == mEntryOrientation) {
+            mActivity.setRequestedOrientation(saved);
+            return;
+        }
+        mActivity.setRequestedOrientation(
+                mEntryOrientation == Configuration.ORIENTATION_LANDSCAPE
+                        ? ActivityInfo.SCREEN_ORIENTATION_SENSOR_LANDSCAPE
+                        : ActivityInfo.SCREEN_ORIENTATION_PORTRAIT);
+        View decor = mActivity.getWindow().getDecorView();
+        decor.postDelayed(
+                () -> {
+                    if (mView == null) mActivity.setRequestedOrientation(saved);
+                },
+                1500);
+    }
+
+    // ---- Page state ----
+
+    private void poll() {
+        if (mView == null || mPollInFlight) return;
+        mPollInFlight = true;
+        int generation = mGeneration;
+        BarePlayerBridge.evaluateIn(
+                mWebContents,
+                mFrameId,
+                BarePlayerScripts.STATE,
+                false,
+                json -> {
+                    if (generation != mGeneration) return;
+                    mPollInFlight = false;
+                    onState(json);
+                    if (mView != null) mHandler.postDelayed(mPoll, POLL_MS);
+                });
+    }
+
+    private void onState(@Nullable String json) {
+        BarePlayerView view = mView;
+        if (view == null) return;
+        JSONObject state;
+        try {
+            state = json == null || json.equals("null") ? null : new JSONObject(json);
+        } catch (JSONException e) {
+            state = null;
+        }
+        if (state == null || state.optBoolean("gone")) {
+            // A playlist can swap the element for a new one; look once more before giving up.
+            if (!mRefound) {
+                mRefound = true;
+                int generation = mGeneration;
+                BarePlayerBridge.evaluateAll(
+                        mWebContents,
+                        BarePlayerScripts.FIND_FULLSCREEN,
+                        found -> {
+                            if (generation != mGeneration) return;
+                            Found again = best(found, false);
+                            if (again == null) {
+                                Log.i(TAG, "The video went away; the site's own player stays.");
+                                tearDown();
+                            } else {
+                                mFrameId = again.frameId;
+                                mVideoFullscreen = false;
+                                if (!again.info.optBoolean("self")) {
+                                    BarePlayerBridge.evaluateIn(
+                                            mWebContents,
+                                            mFrameId,
+                                            BarePlayerScripts.ENTER,
+                                            true,
+                                            r -> {});
+                                }
+                            }
+                        });
+            }
+            return;
+        }
+        mRefound = false;
+        if (!state.optBoolean("any")) {
+            tearDown();
+            return;
+        }
+        boolean videoFullscreen = state.optBoolean("fs");
+        if (videoFullscreen != mVideoFullscreen) {
+            mVideoFullscreen = videoFullscreen;
+            Log.i(TAG, "Video element fullscreen: " + videoFullscreen);
+        }
+        if (videoFullscreen && !mRevealScheduled) {
+            // The video redraws once more after it becomes the fullscreen element; lifting the
+            // cover only after that gives one transition instead of two blinks.
+            mRevealScheduled = true;
+            int generation = mGeneration;
+            mHandler.postDelayed(
+                    () -> {
+                        if (generation == mGeneration && mView != null) mView.reveal();
+                    },
+                    REVEAL_SETTLE_MS);
+        }
+        String error = state.optString("err", "");
+        if (!videoFullscreen && !error.isEmpty() && !error.equals("null")) {
+            Log.i(TAG, "The page kept its own fullscreen: " + error);
+        }
+        view.update(
+                state.optDouble("t", 0),
+                state.optDouble("d", -1),
+                state.optDouble("b", 0),
+                state.optBoolean("p", true),
+                state.optBoolean("e", false),
+                state.optDouble("r", 1),
+                state.optInt("tt", 0) > 0,
+                state.optBoolean("cc", false),
+                state.optBoolean("pip", false) && PictureInPicture.isEnabled(mActivity),
+                canDownload(state),
+                state.optDouble("w", 0),
+                state.optDouble("h", 0),
+                state.optDouble("rt", 0),
+                state.optDouble("rw", 0),
+                state.optDouble("rh", 0),
+                state.optDouble("iw", 0),
+                state.optDouble("ih", 0));
+    }
+
+    // ---- Long-press menu ----
+
+    private void lookOnPage(WebContents webContents) {
+        int generation = ++mGeneration;
+        BarePlayerBridge.evaluateAll(
+                webContents,
+                BarePlayerScripts.FIND_ON_PAGE,
+                json -> {
+                    if (generation != mGeneration) return;
+                    Found found = best(json, /* fromMenu= */ true);
+                    if (found == null) {
+                        unavailable();
+                        return;
+                    }
+                    BarePlayerBridge.evaluateIn(
+                            webContents, found.frameId, BarePlayerScripts.ENTER, true, r -> {});
+                    // The fullscreen this causes brings the player up. If nothing happens, the
+                    // page or its frame does not allow fullscreen.
+                    mHandler.postDelayed(
+                            () -> {
+                                if (mView == null && generation == mGeneration) unavailable();
+                            },
+                            ENTER_CHECK_MS);
+                });
+    }
+
+    private void lookInFrame(WebContents webContents, int frameId, int xDp, int yDp) {
+        int generation = ++mGeneration;
+        BarePlayerBridge.evaluateIn(
+                webContents,
+                frameId,
+                BarePlayerScripts.findAt(xDp, yDp),
+                false,
+                json -> {
+                    if (generation != mGeneration) return;
+                    if (json == null || json.equals("null")) {
+                        unavailable();
+                        return;
+                    }
+                    BarePlayerBridge.evaluateIn(
+                            webContents, frameId, BarePlayerScripts.ENTER, true, r -> {});
+                    mHandler.postDelayed(
+                            () -> {
+                                if (mView == null && generation == mGeneration) unavailable();
+                            },
+                            ENTER_CHECK_MS);
+                });
+    }
+
+    private void unavailable() {
+        Toast.makeText(mActivity, R.string.bare_player_unavailable, Toast.LENGTH_SHORT).show();
+    }
+
+    // ---- Controls ----
+
+    @Override
+    public void onClose() {
+        WebContents webContents = mWebContents;
+        if (webContents != null && !webContents.isDestroyed()) {
+            webContents.exitFullscreen();
+        }
+        tearDown();
+    }
+
+    @Override
+    public void onTogglePlay() {
+        run(BarePlayerScripts.TOGGLE_PLAY, true);
+    }
+
+    @Override
+    public void onSeekBy(double seconds) {
+        run(BarePlayerScripts.seekBy(seconds), false);
+    }
+
+    @Override
+    public void onSeekTo(double seconds) {
+        run(BarePlayerScripts.seekTo(seconds), false);
+    }
+
+    @Override
+    public void onRate(double rate) {
+        run(BarePlayerScripts.setRate(rate), false);
+    }
+
+    @Override
+    public void onTransform(double scale, double dxCss, double dyCss, int easeMs) {
+        BarePlayerBridge.evaluateIn(
+                mWebContents,
+                mFrameId,
+                BarePlayerScripts.setTransform(scale, dxCss, dyCss, easeMs),
+                false,
+                r -> {});
+    }
+
+    // The swipe-down close sends a position every frame. One call is in flight at a time and only
+    // the newest waits behind it, so the picture follows the finger instead of a queue.
+    private boolean mDragInFlight;
+    private @Nullable String mDragPending;
+
+    private void sendDrag(String script) {
+        if (mDragInFlight) {
+            mDragPending = script;
+            return;
+        }
+        mDragInFlight = true;
+        BarePlayerBridge.evaluateIn(
+                mWebContents,
+                mFrameId,
+                script,
+                false,
+                r -> {
+                    mDragInFlight = false;
+                    String next = mDragPending;
+                    mDragPending = null;
+                    if (next != null && mView != null) sendDrag(next);
+                });
+    }
+
+    @Override
+    public void onCloseDrag(double scale, double dxCss, double dyCss, double radiusCss) {
+        sendDrag(BarePlayerScripts.setDrag(scale, dxCss, dyCss, radiusCss));
+    }
+
+    @Override
+    public void onCloseDragEnd(double scale, double dxCss, double dyCss) {
+        sendDrag(BarePlayerScripts.endDrag(scale, dxCss, dyCss));
+    }
+
+    @Override
+    public void onCaptions() {
+        run(BarePlayerScripts.TOGGLE_CAPTIONS, false);
+    }
+
+    @Override
+    public void onRotate() {
+        int current = mActivity.getResources().getConfiguration().orientation;
+        mActivity.setRequestedOrientation(
+                current == Configuration.ORIENTATION_LANDSCAPE
+                        ? ActivityInfo.SCREEN_ORIENTATION_PORTRAIT
+                        : ActivityInfo.SCREEN_ORIENTATION_SENSOR_LANDSCAPE);
+        mOrientationForced = true;
+    }
+
+    /** Runs a command, then reads the state straight away so the controls follow. */
+    private void run(String script, boolean activate) {
+        int generation = mGeneration;
+        BarePlayerBridge.evaluateIn(
+                mWebContents,
+                mFrameId,
+                script,
+                activate,
+                r -> {
+                    if (generation != mGeneration || mView == null) return;
+                    mHandler.removeCallbacks(mPoll);
+                    mPollInFlight = false;
+                    poll();
+                });
+    }
+
+    /**
+     * Whether there is a file to offer: the video's own address, or what the page fetched for
+     * a streamed video (the same files the long-press menu offers). Never for protected video.
+     */
+    private boolean canDownload(JSONObject state) {
+        if (state.optBoolean("drm")) {
+            mDirectSource = null;
+            return false;
+        }
+        String src = state.isNull("src") ? null : state.optString("src", null);
+        mDirectSource = src == null || src.isEmpty() ? null : src;
+        return mDirectSource != null || BareMediaRegistryBridge.getDownloadSet(mWebContents) != null;
+    }
+
+    @Override
+    public void onDownload(View anchor) {
+        WebContents webContents = mWebContents;
+        int frameId = mFrameId;
+        if (mDirectSource != null) {
+            BarePlayerBridge.download(webContents, frameId, mDirectSource);
+            return;
+        }
+        BareMediaRegistryBridge.DownloadSet set =
+                BareMediaRegistryBridge.getDownloadSet(webContents);
+        if (set == null) return;
+        if (set.audio == null) {
+            BarePlayerBridge.download(webContents, frameId, set.video.url.getSpec());
+            return;
+        }
+        // Streamed video often keeps its sound in a separate file; offer both, as the long-press
+        // menu does.
+        String video = set.video.url.getSpec();
+        String audio = set.audio.url.getSpec();
+        PopupMenu menu = new PopupMenu(mActivity, anchor);
+        menu.getMenu().add(0, 0, 0, R.string.contextmenu_save_video);
+        menu.getMenu().add(0, 1, 1, R.string.contextmenu_save_audio);
+        menu.setOnMenuItemClickListener(
+                item -> {
+                    BarePlayerBridge.download(
+                            webContents, frameId, item.getItemId() == 0 ? video : audio);
+                    return true;
+                });
+        menu.show();
+    }
+
+    @Override
+    public void onPip() {
+        WebContents webContents = mWebContents;
+        int frameId = mFrameId;
+        sPipContents = webContents == null ? null : new WeakReference<>(webContents);
+        sPipFrame = frameId;
+        int generation = mGeneration;
+        BarePlayerBridge.evaluateIn(
+                webContents, frameId, BarePlayerScripts.ENTER_PIP, /* activate= */ true, r -> {});
+        // Once the video is in its own window, leave fullscreen and hand the page back.
+        mHandler.postDelayed(
+                () -> {
+                    if (generation != mGeneration) return;
+                    BarePlayerBridge.evaluateIn(
+                            webContents,
+                            frameId,
+                            BarePlayerScripts.IN_PIP,
+                            false,
+                            json -> {
+                                if (generation != mGeneration) return;
+                                if ("true".equals(json)) {
+                                    onClose();
+                                } else {
+                                    Toast.makeText(
+                                                    mActivity,
+                                                    R.string.bare_player_pip_unavailable,
+                                                    Toast.LENGTH_SHORT)
+                                            .show();
+                                }
+                            });
+                },
+                700);
+    }
+
+    @Override
+    public void onScrub(double seconds) {
+        BarePlayerBridge.evaluateIn(
+                mWebContents, mFrameId, BarePlayerScripts.scrubTo(seconds), false, r -> {});
+    }
+
+    // ---- Answers ----
+
+    private static final class Found {
+        final int frameId;
+        final JSONObject info;
+
+        Found(int frameId, JSONObject info) {
+            this.frameId = frameId;
+            this.info = info;
+        }
+    }
+
+    /**
+     * The best video among the frames' answers. In fullscreen, the one covering most of its frame;
+     * from the menu, a playing one first, then the largest.
+     */
+    private static @Nullable Found best(@Nullable String json, boolean fromMenu) {
+        if (json == null) return null;
+        Found best = null;
+        double bestScore = -1;
+        try {
+            JSONArray answers = new JSONArray(json);
+            for (int i = 0; i < answers.length(); i++) {
+                JSONObject answer = answers.getJSONObject(i);
+                JSONObject info = answer.optJSONObject("r");
+                if (info == null || !"video".equals(info.optString("k"))) continue;
+                double score =
+                        fromMenu
+                                ? info.optDouble("a", 0) + (info.optBoolean("playing") ? 1e9 : 0)
+                                : info.optDouble("cov", 0) + (info.optBoolean("self") ? 10 : 0);
+                if (score > bestScore) {
+                    bestScore = score;
+                    best = new Found(answer.getInt("f"), info);
+                }
+            }
+        } catch (JSONException e) {
+            return null;
+        }
+        return best;
+    }
+}
diff --git a/chrome/android/java/src/org/chromium/chrome/browser/bare/player/BarePlayerIcon.java b/chrome/android/java/src/org/chromium/chrome/browser/bare/player/BarePlayerIcon.java
new file mode 100644
index 00000000000..7c6d6989625
--- /dev/null
+++ b/chrome/android/java/src/org/chromium/chrome/browser/bare/player/BarePlayerIcon.java
@@ -0,0 +1,131 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.bare.player;
+
+import android.content.Context;
+import android.view.HapticFeedbackConstants;
+import android.view.animation.DecelerateInterpolator;
+import android.view.animation.OvershootInterpolator;
+import android.widget.ImageView;
+
+import androidx.appcompat.widget.AppCompatImageView;
+
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.chrome.R;
+import org.chromium.chrome.browser.preferences.ChromePreferenceKeys;
+import org.chromium.chrome.browser.preferences.ChromeSharedPreferences;
+
+/**
+ * A player button: one of the Material icons the browser already uses, in white, centred in a
+ * touch target larger than the icon.
+ */
+@NullMarked
+final class BarePlayerIcon extends AppCompatImageView {
+    static final int PLAY = 0;
+    static final int PAUSE = 1;
+    static final int BACK_10 = 2;
+    static final int FORWARD_10 = 3;
+    static final int CLOSE = 4;
+    static final int ROTATE = 5;
+    static final int LOCK = 6;
+    static final int UNLOCK = 7;
+    static final int FIT = 8;
+    static final int FILL = 9;
+    static final int CAPTIONS = 10;
+    static final int REPLAY = 11;
+    static final int PIP = 12;
+    static final int DOWNLOAD = 13;
+
+    private int mKind = -1;
+    private boolean mPressFeedback;
+
+    BarePlayerIcon(Context context, int kind) {
+        super(context);
+        setScaleType(ImageView.ScaleType.FIT_CENTER);
+        setClickable(true);
+        setFocusable(true);
+        setKind(kind);
+    }
+
+    void setKind(int kind) {
+        if (mKind == kind) return;
+        mKind = kind;
+        setImageResource(drawableFor(kind));
+    }
+
+    /**
+     * Makes a press felt and seen: a light haptic tick (when Bare's haptics setting is on) and a
+     * quick squeeze in, springing back out on release.
+     */
+    void enablePressFeedback() {
+        mPressFeedback = true;
+    }
+
+    @Override
+    public void setPressed(boolean pressed) {
+        boolean was = isPressed();
+        super.setPressed(pressed);
+        if (!mPressFeedback || was == pressed) return;
+        animate().cancel();
+        if (pressed) {
+            if (ChromeSharedPreferences.getInstance()
+                    .readBoolean(ChromePreferenceKeys.BARE_HAPTICS, true)) {
+                performHapticFeedback(HapticFeedbackConstants.VIRTUAL_KEY);
+            }
+            animate()
+                    .scaleX(0.86f)
+                    .scaleY(0.86f)
+                    .setDuration(90)
+                    .setInterpolator(new DecelerateInterpolator())
+                    .start();
+        } else {
+            animate()
+                    .scaleX(1f)
+                    .scaleY(1f)
+                    .setDuration(220)
+                    .setInterpolator(new OvershootInterpolator(3f))
+                    .start();
+        }
+    }
+
+    /** Full white when switched on (subtitles showing), dimmed when off. */
+    void setActive(boolean active) {
+        setImageAlpha(active ? 255 : 150);
+    }
+
+    private static int drawableFor(int kind) {
+        switch (kind) {
+            case PLAY:
+                return R.drawable.bare_player_play;
+            case PAUSE:
+                return R.drawable.bare_player_pause;
+            case BACK_10:
+                return R.drawable.bare_player_back_10;
+            case FORWARD_10:
+                return R.drawable.bare_player_forward_10;
+            case CLOSE:
+                return R.drawable.bare_player_close;
+            case ROTATE:
+                return R.drawable.bare_player_rotate;
+            case LOCK:
+                return R.drawable.bare_player_lock;
+            case UNLOCK:
+                return R.drawable.bare_player_unlock;
+            case FIT:
+                return R.drawable.bare_player_fit;
+            case FILL:
+                return R.drawable.bare_player_fill;
+            case CAPTIONS:
+                return R.drawable.bare_player_captions;
+            case REPLAY:
+                return R.drawable.bare_player_replay;
+            case PIP:
+                return R.drawable.bare_player_pip;
+            case DOWNLOAD:
+            default:
+                return R.drawable.bare_player_download;
+        }
+    }
+}
diff --git a/chrome/android/java/src/org/chromium/chrome/browser/bare/player/BarePlayerScripts.java b/chrome/android/java/src/org/chromium/chrome/browser/bare/player/BarePlayerScripts.java
new file mode 100644
index 00000000000..5c7b057c82b
--- /dev/null
+++ b/chrome/android/java/src/org/chromium/chrome/browser/bare/player/BarePlayerScripts.java
@@ -0,0 +1,314 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.bare.player;
+
+import org.chromium.build.annotations.NullMarked;
+
+import java.util.Locale;
+
+/**
+ * The page side of the player, run in Bare's isolated world.
+ *
+ * <p>Every script first makes sure {@code window.__bp} exists in that world, so each one stands on
+ * its own and a frame that has never seen the player still works. The video the player drives is
+ * kept there as {@code __bp.v}. The page's own variables are out of reach and nothing here is
+ * visible to the page, apart from the plain DOM calls a user's own tap would make: play, pause,
+ * seek, playback rate, fullscreen on the video, and a scale style while zoomed.
+ */
+@NullMarked
+final class BarePlayerScripts {
+    private BarePlayerScripts() {}
+
+    private static final String LIB =
+            "if(!window.__bp){const bp=window.__bp={v:null};"
+                    // Every video under root, including open shadow roots, which custom players
+                    // use often.
+                    + "bp.all=(root,out)=>{if(root.tagName==='VIDEO')out.push(root);"
+                    + "if(root.shadowRoot)bp.all(root.shadowRoot,out);"
+                    + "for(const v of root.querySelectorAll('video'))out.push(v);"
+                    + "for(const e of root.querySelectorAll('*'))if(e.shadowRoot)bp.all(e.shadowRoot,out);"
+                    + "return out;};"
+                    // How much of the window a video covers.
+                    + "bp.area=v=>{const r=v.getBoundingClientRect();"
+                    + "return Math.max(0,Math.min(r.right,innerWidth)-Math.max(r.left,0))"
+                    + "*Math.max(0,Math.min(r.bottom,innerHeight)-Math.max(r.top,0));};"
+                    // The video someone is watching: playing first, then the largest on screen.
+                    + "bp.pick=root=>{let best=null,score=0;for(const v of bp.all(root,[])){"
+                    + "const a=bp.area(v);if(a<=0)continue;"
+                    + "const s=a+(v.paused?0:1e9)+(v.readyState>0?1e8:0);"
+                    + "if(s>score){score=s;best=v;}}return best;};"
+                    // Inside a shadow root, document.fullscreenElement names the host.
+                    + "bp.isFs=v=>{try{return v.matches(':fullscreen');}catch(e){return document.fullscreenElement===v;}};"
+                    // How much of the screen the video covers, against the most a picture of
+                    // that shape could: a 16:9 video across a tall phone counts as full.
+                    + "bp.cov=v=>{const r=v.getBoundingClientRect();if(r.width<=0||r.height<=0)return 0;"
+                    + "const a=r.width/r.height,W=innerWidth,H=innerHeight;"
+                    + "const fit=Math.min(W,H*a)*Math.min(H,W/a);return bp.area(v)/Math.max(1,fit);};"
+                    + "bp.info=v=>({w:v.videoWidth,h:v.videoHeight,"
+                    + "cov:bp.cov(v),"
+                    + "drm:!!v.mediaKeys,ctl:v.controls,"
+                    + "kind:(v.currentSrc||'').startsWith('blob:')?'stream':(v.currentSrc?'file':'none')});"
+                    // A video that is itself fullscreen gets the browser's own controls (and its
+                    // cast button); the player draws its own. Some sites also crop the picture
+                    // with object-fit; the player starts from the whole picture and zooms itself. The rule only matches while the
+                    // video is fullscreen, so however fullscreen ends, the page's controls come
+                    // back. A constructed sheet, so a page's style-src policy does not block it,
+                    // added to whichever document or shadow root holds the video.
+                    + "bp.hideControls=v=>{const root=v.getRootNode();"
+                    + "if(bp.sheet&&bp.sheetRoot===root)return;bp.showControls();"
+                    + "const sh=new CSSStyleSheet();"
+                    + "sh.replaceSync('video:fullscreen{object-fit:contain !important}"
+                    + "video:fullscreen::-webkit-media-controls{display:none !important}');"
+                    + "root.adoptedStyleSheets=[...root.adoptedStyleSheets,sh];bp.sheet=sh;bp.sheetRoot=root;};"
+                    // Moves the picture by dx, dy at scale s. The browser's fullscreen style fixes
+                    // transform and translate (!important), so the move goes through offset-path,
+                    // which it leaves alone; it is applied inside the scale, hence the division.
+                    + "bp.move=(st,dx,dy,s)=>{if(Math.abs(dx)<0.5&&Math.abs(dy)<0.5){"
+                    + "st.removeProperty('offset-path');st.removeProperty('offset-distance');"
+                    + "st.removeProperty('offset-rotate');st.removeProperty('offset-anchor');return;}"
+                    + "st.setProperty('offset-path','path(\\'M0 0 L '+(dx/s).toFixed(2)+' '+(dy/s).toFixed(2)+'\\')','important');"
+                    + "st.setProperty('offset-distance','100%','important');"
+                    + "st.setProperty('offset-rotate','0deg','important');"
+                    + "st.setProperty('offset-anchor','0 0','important');};"
+                    + "bp.showControls=()=>{if(!bp.sheet)return;const root=bp.sheetRoot,sh=bp.sheet;"
+                    + "root.adoptedStyleSheets=root.adoptedStyleSheets.filter(x=>x!==sh);"
+                    + "bp.sheet=null;bp.sheetRoot=null;};"
+                    + "}";
+
+    private static String wrap(String body) {
+        return "(()=>{" + LIB + ";const bp=window.__bp;" + body + "})()";
+    }
+
+    /**
+     * Run in every frame once the page goes fullscreen: finds the video being shown. A frame whose
+     * fullscreen element is a frame says so, and the frame inside answers for itself.
+     */
+    static final String FIND_FULLSCREEN =
+            wrap(
+                    "const fs=document.fullscreenElement;if(!fs)return null;"
+                            + "if(fs.tagName==='IFRAME'||fs.tagName==='FRAME')return {k:'frame'};"
+                            + "const v=bp.pick(fs);if(!v)return {k:'none'};"
+                            + "const i=bp.info(v);"
+                            // A fullscreen game or slide deck with a small video in a corner is
+                            // not a video to take over.
+                            + "const self=bp.isFs(v);"
+                            + "if(!self&&i.cov<0.5)return {k:'small',cov:i.cov};"
+                            + "bp.v=v;i.k='video';i.self=self;return i;");
+
+    /**
+     * Run in the frame that was long-pressed: the video under the press (through any overlay) in
+     * the top frame, else the one being watched in that frame. {@code x}, {@code y} are DIPs from
+     * the top of the page view.
+     */
+    static String findAt(int x, int y) {
+        return wrap(
+                String.format(
+                        Locale.US,
+                        "let v=null;if(window.top===window){const vv=window.visualViewport;"
+                                + "const s=vv?vv.scale:1,ox=vv?vv.offsetLeft:0,oy=vv?vv.offsetTop:0;"
+                                + "for(const e of document.elementsFromPoint(ox+%d/s,oy+%d/s)){"
+                                + "if(e.tagName==='VIDEO'){v=e;break;}"
+                                + "if(e.shadowRoot){const i=bp.all(e,[]);if(i.length){v=i[0];break;}}}}"
+                                + "if(!v)v=bp.pick(document);if(!v)return null;"
+                                + "bp.v=v;const i=bp.info(v);i.k='video';i.playing=!v.paused;"
+                                + "i.a=bp.area(v);return i;",
+                        x,
+                        y));
+    }
+
+    /** Run in every frame from the long-press menu: finds the video someone is watching. */
+    static final String FIND_ON_PAGE =
+            wrap(
+                    "const v=bp.pick(document);if(!v)return null;"
+                            + "bp.v=v;const i=bp.info(v);i.k='video';i.playing=!v.paused;"
+                            + "i.a=bp.area(v);return i;");
+
+    /** Puts the chosen video itself into fullscreen, so the page's own controls are gone. */
+    static final String ENTER =
+            wrap(
+                    "const v=bp.v;if(!v||!v.isConnected)return 'gone';"
+                            + "if(bp.isFs(v))return 'already';"
+                            + "bp.err=null;bp.hideControls(v);v.requestFullscreen({navigationUI:'hide'})"
+                            + ".catch(e=>{bp.err=String(e);});return 'requested';");
+
+    /** What the controls need to draw. */
+    static final String STATE =
+            wrap(
+                    "const v=bp.v;if(!v||!v.isConnected)return {gone:true};"
+                            + "let b=0;for(let i=0;i<v.buffered.length;i++)"
+                            + "if(v.buffered.start(i)<=v.currentTime+1)b=Math.max(b,v.buffered.end(i));"
+                            + "let cc=false;for(const t of v.textTracks)if(t.mode==='showing')cc=true;"
+                            + "return {t:v.currentTime,d:isFinite(v.duration)?v.duration:-1,"
+                            + "p:v.paused,e:v.ended,r:v.playbackRate,w:v.videoWidth,h:v.videoHeight,"
+                            + "b:b,fs:bp.isFs(v),any:!!document.fullscreenElement,"
+                            + "tt:v.textTracks.length,cc:cc,ctl:v.controls,err:bp.err||null,"
+                            + "drm:!!v.mediaKeys,"
+                            + "pip:document.pictureInPictureEnabled===true,"
+                            + "inPip:document.pictureInPictureElement===v,"
+                            + "src:/^https?:/.test(v.currentSrc||'')?v.currentSrc:null,"
+                            + "rt:v.getBoundingClientRect().top,"
+                            + "rw:v.getBoundingClientRect().width,rh:v.getBoundingClientRect().height,"
+                            + "iw:innerWidth,ih:innerHeight};");
+
+    static final String TOGGLE_PLAY =
+            wrap(
+                    "const v=bp.v;if(!v)return null;"
+                            + "if(v.paused||v.ended){v.play().catch(()=>{});return 'play';}"
+                            + "v.pause();return 'pause';");
+
+    static String seekBy(double seconds) {
+        return wrap(
+                String.format(
+                        Locale.US,
+                        "const v=bp.v;if(!v)return null;"
+                                + "const end=isFinite(v.duration)?v.duration:Infinity;"
+                                + "v.currentTime=Math.max(0,Math.min(end,v.currentTime+(%f)));"
+                                + "return v.currentTime;",
+                        seconds));
+    }
+
+    static String seekTo(double seconds) {
+        return wrap(
+                String.format(
+                        Locale.US,
+                        "const v=bp.v;if(!v)return null;bp.scrubT=null;v.currentTime=%f;"
+                                + "return v.currentTime;",
+                        seconds));
+    }
+
+    static String setRate(double rate) {
+        return wrap(
+                String.format(
+                        Locale.US,
+                        "const v=bp.v;if(!v)return null;v.playbackRate=%f;return v.playbackRate;",
+                        rate));
+    }
+
+    /**
+     * Zooms and moves the picture. The browser's fullscreen style locks transform, but leaves the
+     * separate scale and translate properties alone. A short transition eases each update into
+     * the next, so a stream of them reads as one smooth movement.
+     */
+    static String setTransform(double scale, double dxCss, double dyCss, int easeMs) {
+        return wrap(
+                String.format(
+                        Locale.US,
+                        "const v=bp.v;if(!v)return null;const st=v.style;"
+                                + "st.setProperty('transition','scale %dms ease-out, translate %dms ease-out','important');"
+                                + "if(%f<=1.001&&Math.abs(%f)<0.5&&Math.abs(%f)<0.5){"
+                                + "st.setProperty('scale','1','important');bp.move(st,0,0,1);}"
+                                + "else{st.setProperty('scale','%f','important');bp.move(st,%f,%f,%f);}return true;",
+                        easeMs, easeMs, scale, dxCss, dyCss, scale, dxCss, dyCss, scale));
+    }
+
+    /**
+     * The swipe-down close: the picture follows the finger with no easing, so each update lands
+     * as sent. Its corners are rounded by {@code radiusCss}.
+     */
+    static String setDrag(double scale, double dxCss, double dyCss, double radiusCss) {
+        return wrap(
+                String.format(
+                        Locale.US,
+                        "const v=bp.v;if(!v)return null;const st=v.style;"
+                                + "if(bp.rad0===undefined)bp.rad0=st.getPropertyValue('border-radius');"
+                                + "st.setProperty('transition','none','important');"
+                                + "st.setProperty('scale','%f','important');bp.move(st,%f,%f,%f);"
+                                + "st.setProperty('border-radius','%fpx','important');return true;",
+                        scale, dxCss, dyCss, scale, radiusCss));
+    }
+
+    /** The swipe-down is over: the zoom it had, square corners as before. */
+    static String endDrag(double scale, double dxCss, double dyCss) {
+        return wrap(
+                String.format(
+                        Locale.US,
+                        "const v=bp.v;if(!v)return null;const st=v.style;"
+                                + "st.setProperty('transition','none','important');"
+                                + "if(%f<=1.001&&Math.abs(%f)<0.5&&Math.abs(%f)<0.5){"
+                                + "st.setProperty('scale','1','important');bp.move(st,0,0,1);}"
+                                + "else{st.setProperty('scale','%f','important');bp.move(st,%f,%f,%f);}"
+                                + "if(bp.rad0!==undefined){if(bp.rad0)st.setProperty('border-radius',bp.rad0);"
+                                + "else st.removeProperty('border-radius');bp.rad0=undefined;}return true;",
+                        scale, dxCss, dyCss, scale, dxCss, dyCss, scale));
+    }
+
+    /**
+     * A seek while the timeline is dragged. While one is still loading, only the newest position
+     * is kept, and it is applied as soon as that seek lands, so the picture keeps up with the
+     * finger without queueing every position it passed.
+     */
+    static String scrubTo(double seconds) {
+        return wrap(
+                String.format(
+                        Locale.US,
+                        "const v=bp.v;if(!v)return null;bp.scrubT=%f;"
+                                + "if(!bp.hooked)bp.hooked=new WeakSet();"
+                                + "if(!bp.hooked.has(v)){bp.hooked.add(v);"
+                                + "v.addEventListener('seeked',()=>{const t=bp.scrubT;"
+                                + "if(t==null||bp.v!==v)return;bp.scrubT=null;"
+                                + "if(Math.abs(v.currentTime-t)>0.25)v.currentTime=t;});}"
+                                + "if(!v.seeking){bp.scrubT=null;v.currentTime=%f;}return true;",
+                        seconds,
+                        seconds));
+    }
+
+    /**
+     * Asks for the browser's picture-in-picture window for the video. Some sites (YouTube) mark
+     * the video as not allowed in picture-in-picture; the user asked for it, so that mark is lifted
+     * for this request and put back once the window closes.
+     */
+    static final String ENTER_PIP =
+            wrap(
+                    "const v=bp.v;if(!v)return 'gone';bp.err=null;bp.pipV=v;"
+                            + "if(v.disablePictureInPicture){v.disablePictureInPicture=false;"
+                            + "v.addEventListener('leavepictureinpicture',"
+                            + "()=>{v.disablePictureInPicture=true;},{once:true});}"
+                            + "v.requestPictureInPicture().catch(e=>{bp.err=String(e);});"
+                            + "return 'requested';");
+
+    /** Ten seconds either way for the video in picture-in-picture, in whichever frame holds it. */
+    static String pipSeekBy(double seconds) {
+        return wrap(
+                String.format(
+                        Locale.US,
+                        "const v=document.pictureInPictureElement;if(!v)return null;"
+                                + "const end=isFinite(v.duration)?v.duration:Infinity;"
+                                + "v.currentTime=Math.max(0,Math.min(end,v.currentTime+(%f)));"
+                                + "return true;",
+                        seconds));
+    }
+
+    /** After the window's expand button: the same video, back fullscreen in Bare Player. */
+    static final String FULLSCREEN_AFTER_PIP =
+            wrap(
+                    "const v=bp.pipV;bp.pipV=null;if(!v||!v.isConnected)return null;bp.v=v;"
+                            + "v.requestFullscreen({navigationUI:'hide'}).catch(()=>{});"
+                            + "return true;");
+
+    /** Whether the video is in picture-in-picture now. */
+    static final String IN_PIP =
+            wrap("const v=bp.v;return !!v&&document.pictureInPictureElement===v;");
+
+    /** Turns the video's own subtitle tracks on (the first one) or off. */
+    static final String TOGGLE_CAPTIONS =
+            wrap(
+                    "const v=bp.v;if(!v)return null;const ts=[...v.textTracks];"
+                            + "const on=ts.some(t=>t.mode==='showing');"
+                            + "if(on){for(const t of ts)if(t.mode==='showing')t.mode='disabled';return false;}"
+                            + "const t=ts.find(t=>t.kind==='subtitles'||t.kind==='captions');"
+                            + "if(!t)return false;t.mode='showing';return true;");
+
+    /** Undoes what the player changed on the element. */
+    static final String CLEAN_UP =
+            wrap(
+                    "const v=bp.v;if(v){v.style.removeProperty('scale');bp.move(v.style,0,0,1);"
+                            + "v.style.removeProperty('translate');v.style.removeProperty('transition');"
+                            + "if(bp.rad0!==undefined){if(bp.rad0)v.style.setProperty('border-radius',bp.rad0);"
+                            + "else v.style.removeProperty('border-radius');bp.rad0=undefined;}}"
+                            + "bp.showControls();bp.v=null;return true;");
+
+    /** Hides the browser's controls when the video was already fullscreen on its own. */
+    static final String HIDE_CONTROLS = wrap("const v=bp.v;if(v)bp.hideControls(v);return true;");
+}

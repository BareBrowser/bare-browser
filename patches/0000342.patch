+     The layouts tint it like the widget's other icons, so it follows light, dark and dynamic
+     colour. -->
+<vector
+    xmlns:android="http://schemas.android.com/apk/res/android"
+    android:width="24dp"
+    android:height="24dp"
+    android:viewportWidth="700"
+    android:viewportHeight="700">
+    <group
+        android:translateX="-157.45"
+        android:translateY="-162.0">
+        <group>

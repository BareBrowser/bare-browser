+    /**
+     * The seek bar's thumb: a white dot that grows, with a soft halo, while it is held, so a tap
+     * on the bar is felt as well as seen. Its size never changes, only what it draws, so the bar
+     * does not re-lay itself out on every frame.
+     */
+    private static final class PressThumb extends Drawable {
+        private final Paint mDot = new Paint(Paint.ANTI_ALIAS_FLAG);
+        private final Paint mHalo = new Paint(Paint.ANTI_ALIAS_FLAG);
+        private final float mDp;
+        private float mPress;
+
+        PressThumb(float dp) {
+            mDp = dp;
+            mDot.setColor(Color.WHITE);
+            mHalo.setColor(Color.WHITE);
+        }
+
+        float getPress() {
+            return mPress;
+        }
+
+        void setPress(float press) {
+            mPress = press;
+            invalidateSelf();
+        }
+
+        @Override
+        public void draw(Canvas canvas) {
+            float cx = getBounds().exactCenterX();
+            float cy = getBounds().exactCenterY();
+            if (mPress > 0.01f) {
+                mHalo.setAlpha((int) (64 * mPress));
+                canvas.drawCircle(cx, cy, 18 * mDp * mPress, mHalo);
+            }
+            canvas.drawCircle(cx, cy, (6 + 3 * mPress) * mDp, mDot);
+        }
+
+        @Override
+        public int getIntrinsicWidth() {
+            return Math.round(36 * mDp);
+        }
+
+        @Override
+        public int getIntrinsicHeight() {
+            return Math.round(36 * mDp);
+        }
+
+        @Override
+        public void setAlpha(int alpha) {}
+
+        @Override
+        public void setColorFilter(@Nullable ColorFilter filter) {}
+
+        @Override
+        public int getOpacity() {
+            return PixelFormat.TRANSLUCENT;
+        }
+    }

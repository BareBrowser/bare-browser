+    // ---- State from the page ----
+
+    /** Updates the controls from the page's answer. */
+    void update(
+            double time,
+            double duration,
+            double buffered,
+            boolean paused,
+            boolean ended,
+            double rate,
+            boolean hasCaptions,
+            boolean captionsOn,
+            boolean canPip,
+            boolean canDownload,
+            double videoWidth,
+            double videoHeight,
+            double elementTop,
+            double elementWidth,
+            double elementHeight,
+            double windowWidth,
+            double windowHeight) {
+        mTime = time;
+        mDurationSeconds = duration;
+        if (mPaused != paused || ended) {
+            mPaused = paused;
+            mPlay.setKind(
+                    ended ? BarePlayerIcon.REPLAY : paused ? BarePlayerIcon.PLAY : BarePlayerIcon.PAUSE);
+            mPlay.setContentDescription(
+                    getContext().getString(
+                            paused ? R.string.bare_player_play : R.string.bare_player_pause));
+            if (paused) {
+                mHandler.removeCallbacks(mHideRunnable);
+                if (!mLocked) showControls(true);
+            } else {
+                scheduleHide();
+            }
+        }
+        if (Math.abs(mRate - rate) > 0.001) {
+            mRate = rate;
+            updateSpeedLabel();
+        }
+        mCaptions.setVisibility(hasCaptions ? VISIBLE : GONE);
+        mPip.setVisibility(canPip ? VISIBLE : GONE);
+        mDownload.setVisibility(canDownload ? VISIBLE : GONE);
+        mCaptions.setActive(captionsOn);
+        boolean live = duration < 0;
+        mSeek.setEnabled(!live);
+        mBack.setEnabled(!live);
+        mDuration.setText(live ? getContext().getString(R.string.bare_player_live) : format(duration));
+        if (!mUserSeeking && mDrag != DRAG_SEEK) {
+            mPosition.setText(format(time));
+            mSeek.setProgress(live || duration <= 0 ? 0 : (int) (1000 * time / duration));
+            mSeek.setSecondaryProgress(
+                    live || duration <= 0 ? 0 : (int) (1000 * buffered / duration));
+        }
+        placeAroundPicture(
+                videoWidth, videoHeight, elementTop, elementWidth, elementHeight, windowWidth);
+
+        // How far the picture must grow to cover the screen. The element may be larger than the
+        // picture (letterboxed inside it), so this goes by the picture's own shape, fitted into
+        // the element, which the zoom scales about its centre.
+        if (mScale <= 1.001 && elementWidth > 0 && elementHeight > 0 && videoWidth > 0
+                && videoHeight > 0) {
+            double fit = Math.min(elementWidth / videoWidth, elementHeight / videoHeight);
+            double pictureWidth = videoWidth * fit;
+            double pictureHeight = videoHeight * fit;
+            if (getWidth() > 0 && windowWidth > 0) {
+                mCssPerPx = windowWidth / getWidth();
+                mPictureW = pictureWidth / mCssPerPx;
+                mPictureH = pictureHeight / mCssPerPx;
+            }
+            mFillScale =
+                    Math.max(1, Math.max(windowWidth / pictureWidth, windowHeight / pictureHeight));
+        }
+    }

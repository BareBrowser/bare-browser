+
+    private void toggleFit() {
+        setTransform(mScale > 1.001 ? 1 : mFillScale, 0, 0, 220);
+    }
+
+    /**
+     * Applies a zoom and shift, kept so the picture never leaves a gap at an edge it could cover,
+     * and sends it to the page. While fingers move, updates go out often and each one eases into
+     * the next, so the picture glides instead of stepping.
+     */
+    private void setTransform(double scale, double tx, double ty, int easeMs) {
+        mScale = Math.max(1, Math.min(MAX_SCALE, scale));
+        double maxX = mPictureW > 0 ? Math.max(0, (mScale * mPictureW - getWidth()) / 2) : 0;
+        double maxY = mPictureH > 0 ? Math.max(0, (mScale * mPictureH - getHeight()) / 2) : 0;
+        mTx = Math.max(-maxX, Math.min(maxX, tx));
+        mTy = Math.max(-maxY, Math.min(maxY, ty));
+        boolean zoomed = mScale > 1.001;
+        mFit.setKind(zoomed ? BarePlayerIcon.FIT : BarePlayerIcon.FILL);
+        mFit.setContentDescription(
+                getContext().getString(zoomed ? R.string.bare_player_fit : R.string.bare_player_fill));
+        long now = System.currentTimeMillis();
+        if (easeMs > 100 || now - mLastScaleSentMs >= 24) {
+            mLastScaleSentMs = now;
+            mDelegate.onTransform(mScale, mTx * mCssPerPx, mTy * mCssPerPx, easeMs);
+        }
+    }
+
+    /** Moves the video along with the finger, so the frame under it is what shows. */
+    private void scrub(double seconds) {
+        long now = System.currentTimeMillis();
+        if (now - mLastScrubMs < SCRUB_INTERVAL_MS) return;
+        mLastScrubMs = now;
+        mDelegate.onScrub(seconds);
+    }
+
+    private void tapSeek(int seconds) {
+        if (mDurationSeconds < 0 && seconds < 0) return;
+        if (Integer.signum(mTapSeekTotal) != Integer.signum(seconds)) mTapSeekTotal = 0;
+        mTapSeekTotal += seconds;
+        mDelegate.onSeekBy(seconds);
+        showBubble((mTapSeekTotal > 0 ? "+" : "−") + Math.abs(mTapSeekTotal) + " s");
+        mHandler.removeCallbacks(mResetTapSeek);
+        mHandler.postDelayed(mResetTapSeek, 900);
+    }
+
+    private void showBubble(String text) {
+        mBubble.setText(text);
+        mBubble.setVisibility(VISIBLE);
+        mHandler.removeCallbacks(mHideBubble);
+        mHandler.postDelayed(mHideBubble, BUBBLE_MS);
+    }
+
+    // ---- Touch ----
+
+    @Override
+    public boolean onTouchEvent(MotionEvent event) {
+        if (mLocked) {
+            if (event.getActionMasked() == MotionEvent.ACTION_UP) flashUnlock();
+            return true;
+        }
+        if (mClosing) return true;
+        int actionMasked = event.getActionMasked();
+        if (actionMasked == MotionEvent.ACTION_DOWN) {
+            // A new touch while the picture is still coming back takes over from it.
+            mSpring.cancel();
+            resetClose();
+            if (mVelocity != null) mVelocity.recycle();
+            mVelocity = VelocityTracker.obtain();
+        }
+        if (mVelocity != null) mVelocity.addMovement(event);
+        if (mIgnoreUntilUp) {
+            // The finger left after a pinch is not a new drag.
+            int a = event.getActionMasked();
+            if (a == MotionEvent.ACTION_UP || a == MotionEvent.ACTION_CANCEL) mIgnoreUntilUp = false;
+            return true;
+        }
+        if (event.getPointerCount() > 1 || mScaling) {
+            handlePinch(event);
+            return true;
+        }
+        mGestures.onTouchEvent(event);
+        int action = event.getActionMasked();
+        if (action == MotionEvent.ACTION_UP || action == MotionEvent.ACTION_CANCEL) {
+            if (mDrag == DRAG_SEEK && action == MotionEvent.ACTION_UP) {
+                mTime = mDragTargetTime;
+                mDelegate.onSeekTo(mDragTargetTime);
+            }
+            if (mDrag == DRAG_CLOSE) {
+                float velocity = 0;
+                if (action == MotionEvent.ACTION_UP && mVelocity != null) {
+                    mVelocity.computeCurrentVelocity(1000);
+                    velocity = mVelocity.getYVelocity();
+                }
+                boolean flung = velocity > CLOSE_FLING_DP_PER_SECOND * mDp && mClosePull > 0;
+                if (action == MotionEvent.ACTION_UP && (mCloseArmed || flung)) {
+                    finishClose(velocity);
+                } else {
+                    springBack(velocity);
+                }
+            }
+            if (mDrag != DRAG_NONE) {
+                mHandler.removeCallbacks(mHideBubble);
+                mHandler.postDelayed(mHideBubble, 400);
+                scheduleHide();
+            }
+            mDrag = DRAG_NONE;
+        }
+        return true;
+    }
+
+    private final class Gestures extends GestureDetector.SimpleOnGestureListener {
+        @Override
+        public boolean onDown(MotionEvent e) {
+            mDownX = e.getX();
+            mDownY = e.getY();
+            mDrag = DRAG_NONE;
+            return true;
+        }
+
+        @Override
+        public boolean onSingleTapConfirmed(MotionEvent e) {
+            if (!mRevealed) return true;
+            showControls(!mControlsShown);
+            return true;
+        }
+
+        @Override
+        public boolean onDoubleTap(MotionEvent e) {
+            float third = getWidth() / 3f;
+            if (e.getX() < third) {
+                tapSeek(-10);
+            } else if (e.getX() > 2 * third) {
+                tapSeek(10);
+            } else {
+                mDelegate.onTogglePlay();
+            }
+            return true;
+        }
+
+        @Override
+        public boolean onScroll(
+                @Nullable MotionEvent e1, MotionEvent e2, float distanceX, float distanceY) {
+            float dx = e2.getX() - mDownX;
+            float dy = e2.getY() - mDownY;
+            if (mDrag == DRAG_NONE) {
+                if (Math.hypot(dx, dy) < mTouchSlop * 2) return false;
+                if (Math.abs(dx) > Math.abs(dy)) {
+                    if (mDurationSeconds <= 0) return false;
+                    mDrag = DRAG_SEEK;
+                    mDragStartTime = mTime;
+                } else if (mDownX > getWidth() / 3f && mDownX < 2 * getWidth() / 3f) {
+                    if (dy <= 0) return false;
+                    mDrag = DRAG_CLOSE;
+                    mCloseArmed = false;
+                    mCloseControlsWereShown = mControlsShown;
+                    showControls(false);
+                    mCurtain.animate().cancel();
+                    mCurtain.setAlpha(0f);
+                    mCurtain.setVisibility(VISIBLE);
+                    // Measured from where the finger first went down; the distance it had to
+                    // cover to be recognised is given back over the next few slops, so the
+                    // picture neither jumps now nor trails the finger later.
+                    mCloseOriginX = mDownX;
+                    mCloseOriginY = mDownY;
+                    mCloseSlop = (float) Math.hypot(dx, dy);
+                    mCloseDx0 = dx;
+                    mClosePull = 0;
+                    beginClose(e2.getX(), e2.getY());
+                } else if (mDownX < getWidth() / 2f) {
+                    mDrag = DRAG_BRIGHTNESS;
+                    mDragStartLevel = currentBrightness();
+                } else {
+                    mDrag = DRAG_VOLUME;
+                    int max = mAudio.getStreamMaxVolume(AudioManager.STREAM_MUSIC);
+                    mDragStartLevel =
+                            max <= 0
+                                    ? 0
+                                    : (float) mAudio.getStreamVolume(AudioManager.STREAM_MUSIC) / max;
+                }
+                mHandler.removeCallbacks(mHideRunnable);
+                // Re-anchor so the change starts from here, not from the slop.
+                mDownX = e2.getX();
+                mDownY = e2.getY();
+                dx = 0;
+                dy = 0;
+            }
+            switch (mDrag) {
+                case DRAG_CLOSE:
+                    {
+                        // Follows the finger; one tick when the line is crossed. Coming back
+                        // a little short of it disarms, so a finger resting on it does not buzz.
+                        float raw = e2.getY() - mCloseOriginY;
+                        float over = raw - mCloseSlop;
+                        float ramp = clamp01(over / Math.max(1f, 4 * mCloseSlop));
+                        float pull = Math.max(0f, raw - mCloseSlop * (1 - ramp));
+                        float line = getHeight() * CLOSE_LINE;
+                        if (pull >= line && !mCloseArmed) {
+                            mCloseArmed = true;
+                            haptic(HapticFeedbackConstants.CLOCK_TICK);
+                        } else if (pull < line * 0.85f) {
+                            mCloseArmed = false;
+                        }
+                        // The page hears about each position a frame or two after the finger
+                        // is there, so it is sent a little ahead, along the finger's speed.
+                        float lead = 0;
+                        if (mVelocity != null) {
+                            mVelocity.computeCurrentVelocity(1000);
+                            lead = Math.max(0f, mVelocity.getYVelocity()) * CLOSE_LEAD_SECONDS;
+                        }
+                        applyClose(
+                                pull + lead,
+                                (e2.getX() - mCloseOriginX - mCloseDx0) * CLOSE_FOLLOW_X);
+                        break;
+                    }
+                case DRAG_SEEK:
+                    {
+                        // A full screen width is 90 seconds, or the whole video if shorter.
+                        double span = Math.min(90, mDurationSeconds);
+                        double delta = span * dx / Math.max(1, getWidth());
+                        mDragTargetTime =
+                                Math.max(0, Math.min(mDurationSeconds, mDragStartTime + delta));
+                        long d = Math.round(mDragTargetTime - mDragStartTime);
+                        showBubble(
+                                format(mDragTargetTime)
+                                        + "  ("
+                                        + (d >= 0 ? "+" : "−")
+                                        + Math.abs(d)
+                                        + " s)");
+                        if (mDurationSeconds > 0) {
+                            mSeek.setProgress((int) (1000 * mDragTargetTime / mDurationSeconds));
+                        }
+                        scrub(mDragTargetTime);
+                        break;
+                    }
+                case DRAG_BRIGHTNESS:
+                    {
+                        float level = clamp01(mDragStartLevel - dy / (getHeight() * 0.6f));
+                        WindowManager.LayoutParams lp = mActivity.getWindow().getAttributes();
+                        lp.screenBrightness = Math.max(0.01f, level);
+                        mActivity.getWindow().setAttributes(lp);
+                        showBubble(
+                                getContext().getString(R.string.bare_player_brightness)
+                                        + "  "
+                                        + Math.round(level * 100)
+                                        + "%");
+                        break;
+                    }
+                case DRAG_VOLUME:
+                    {
+                        float level = clamp01(mDragStartLevel - dy / (getHeight() * 0.6f));
+                        int max = mAudio.getStreamMaxVolume(AudioManager.STREAM_MUSIC);
+                        int index = Math.round(level * max);
+                        if (index != mAudio.getStreamVolume(AudioManager.STREAM_MUSIC)) {
+                            mAudio.setStreamVolume(AudioManager.STREAM_MUSIC, index, 0);
+                        }
+                        showBubble(
+                                getContext().getString(R.string.bare_player_volume)
+                                        + "  "
+                                        + Math.round(100f * index / Math.max(1, max))
+                                        + "%");
+                        break;
+                    }
+                default:
+                    break;
+            }
+            return true;
+        }
+    }
+
+    /**
+     * Two fingers: zoom about the point between them, and move the picture with them. The point
+     * of the picture under the fingers when they went down stays under them.
+     */
+    private void handlePinch(MotionEvent event) {
+        int action = event.getActionMasked();
+        if (event.getPointerCount() < 2) {
+            if (action == MotionEvent.ACTION_UP || action == MotionEvent.ACTION_CANCEL) {
+                mScaling = false;
+            }
+            return;
+        }
+        float x0 = event.getX(0);
+        float y0 = event.getY(0);
+        float x1 = event.getX(1);
+        float y1 = event.getY(1);
+        float span = (float) Math.hypot(x1 - x0, y1 - y0);
+        float fx = (x0 + x1) / 2f - getWidth() / 2f;
+        float fy = (y0 + y1) / 2f - getHeight() / 2f;
+        if (action == MotionEvent.ACTION_POINTER_DOWN || !mScaling) {
+            mScaling = true;
+            if (mDrag == DRAG_CLOSE) springBack(0);
+            mDrag = DRAG_NONE;
+            // The first finger's tap or drag is called off.
+            MotionEvent cancel = MotionEvent.obtain(event);
+            cancel.setAction(MotionEvent.ACTION_CANCEL);
+            mGestures.onTouchEvent(cancel);
+            cancel.recycle();
+            mPinchSpan0 = Math.max(1f, span);
+            mPinchFocusX0 = fx;
+            mPinchFocusY0 = fy;
+            mPinchScale0 = mScale;
+            mPinchTx0 = mTx;
+            mPinchTy0 = mTy;
+            return;
+        }
+        if (action == MotionEvent.ACTION_MOVE) {
+            double scale =
+                    Math.max(1, Math.min(MAX_SCALE, mPinchScale0 * span / mPinchSpan0));
+            double ratio = scale / mPinchScale0;
+            double tx = fx - ratio * (mPinchFocusX0 - mPinchTx0);
+            double ty = fy - ratio * (mPinchFocusY0 - mPinchTy0);
+            setTransform(scale, tx, ty, 90);
+            showBubble(Math.round(mScale * 100) + "%");
+        } else if (action == MotionEvent.ACTION_POINTER_UP) {
+            mScaling = false;
+            mIgnoreUntilUp = true;
+            // Settle on the whole picture or on the screen when close to either.
+            if (Math.abs(mScale - 1) < 0.08) {
+                setTransform(1, 0, 0, 200);
+            } else if (Math.abs(mScale - mFillScale) < 0.06) {
+                setTransform(mFillScale, mTx, mTy, 200);
+            } else {
+                setTransform(mScale, mTx, mTy, 120);
+            }
+        }
+    }
+
+    /** Starts a swipe-down: from here the page is told where the picture is each frame. */
+    private void beginClose(float pivotX, float pivotY) {
+        resetClose();
+        mCloseActive = true;
+    }
+
+    /**
+     * Puts the picture {@code pull} pixels down and {@code dx} along: smaller the further it has
+     * been pulled, with rounder corners and a darker shade. The video is drawn in a window of its
+     * own that the views above it cannot carry along, so the picture is the page's video element,
+     * moved by the same translate and scale the zoom uses, with no easing in between.
+     */
+    private void applyClose(float pull, float dx) {
+        mClosePull = pull;
+        mCloseDxNow = dx;
+        float p = clamp01(pull / (getHeight() * 0.6f));
+        float eased = p * (2 - p);
+        float scale = 1 - CLOSE_SHRINK * eased;
+        mDelegate.onCloseDrag(
+                mScale * scale,
+                (mTx + dx) * mCssPerPx,
+                (mTy + pull) * mCssPerPx,
+                CLOSE_RADIUS_DP * eased * mCssPerPx * mDp);
+        mCurtain.setAlpha(0.55f * eased);
+    }
+
+    /** Gives the picture back as it was: the zoom it had, no offset, square corners. */
+    private void resetClose() {
+        mSpring.cancel();
+        if (mCloseActive) {
+            mCloseActive = false;
+            mDelegate.onCloseDragEnd(mScale, mTx * mCssPerPx, mTy * mCssPerPx);
+        }
+        mClosePull = 0;
+        if (!mClosing && mRevealed) {
+            mCurtain.setAlpha(0f);
+            mCurtain.setVisibility(GONE);
+        }
+    }
+
+    /** Let go short of the line: it springs back, carrying the finger's speed. */
+    private void springBack(float velocity) {
+        mCloseArmed = false;
+        final float from = mClosePull;
+        final float dx = mCloseDxNow;
+        mSpring.start(
+                from,
+                velocity,
+                0f,
+                400f,
+                0.8f,
+                Float.NaN,
+                pull -> applyClose(pull, from > 1f ? dx * (pull / from) : 0f),
+                () -> {
+                    resetClose();
+                    if (mCloseControlsWereShown) showControls(true);
+                });
+    }
+
+    /**
+     * Let go past the line, or flung: the picture carries the finger's speed on down and out, then
+     * the player leaves fullscreen behind a black cover, so nothing of the page's own layout shows
+     * while the views are put back.
+     */
+    private void finishClose(float velocity) {
+        mClosing = true;
+        mCloseArmed = false;
+        final float dx = mCloseDxNow;
+        final float height = getHeight();
+        mSpring.start(
+                mClosePull,
+                Math.max(velocity, 0f),
+                height * 1.4f,
+                220f,
+                1.0f,
+                height,
+                pull -> applyClose(pull, dx),
+                () -> {
+                    mCurtain.animate().cancel();
+                    mCurtain.setAlpha(1f);
+                    mCurtain.setVisibility(VISIBLE);
+                    mDelegate.onClose();
+                    resetClose();
+                });
+    }
+
+    /** One haptic tick, when Bare's haptics setting is on. */
+    private void haptic(int kind) {
+        boolean on =
+                ChromeSharedPreferences.getInstance()
+                        .readBoolean(ChromePreferenceKeys.BARE_HAPTICS, true);
+        boolean done = on && performHapticFeedback(kind);
+        Log.i(TAG, "Close line crossed: haptics " + (on ? "on" : "off") + ", performed=" + done);
+    }
+
+    /**
+     * A spring that settles a pull distance on a target, starting from the finger's own speed.
+     * Runs on the frame clock, so it carries the motion on from the last touch event.
+     */
+    private final class CloseSpring implements Choreographer.FrameCallback {
+        interface Update {
+            void onPull(float pull);
+        }
+
+        private float mX;
+        private float mV;
+        private float mTarget;
+        private float mStiffness;
+        private float mDamping;
+        private float mStopAt = Float.NaN;
+        private long mLastNanos;
+        private boolean mRunning;
+        private @Nullable Update mUpdate;
+        private @Nullable Runnable mDone;
+
+        void start(
+                float x,
+                float v,
+                float target,
+                float stiffness,
+                float dampingRatio,
+                float stopAt,
+                Update update,
+                Runnable done) {
+            cancel();
+            mX = x;
+            mV = v;
+            mTarget = target;
+            mStiffness = stiffness;
+            mDamping = dampingRatio * 2f * (float) Math.sqrt(stiffness);
+            mStopAt = stopAt;
+            mUpdate = update;
+            mDone = done;
+            mLastNanos = 0;
+            mRunning = true;
+            Choreographer.getInstance().postFrameCallback(this);
+        }
+
+        void cancel() {
+            if (mRunning) Choreographer.getInstance().removeFrameCallback(this);
+            mRunning = false;
+            mUpdate = null;
+            mDone = null;
+        }
+
+        @Override
+        public void doFrame(long frameTimeNanos) {
+            if (!mRunning) return;
+            float dt = mLastNanos == 0 ? 1f / 60f : (frameTimeNanos - mLastNanos) / 1e9f;
+            mLastNanos = frameTimeNanos;
+            dt = Math.min(dt, 1f / 30f);
+            float accel = -mStiffness * (mX - mTarget) - mDamping * mV;
+            mV += accel * dt;
+            mX += mV * dt;
+            Update update = mUpdate;
+            if (update != null) update.onPull(mX);
+            boolean settled =
+                    Float.isNaN(mStopAt)
+                            ? Math.abs(mX - mTarget) < 0.5f && Math.abs(mV) < 8f
+                            : mX >= mStopAt;
+            if (settled) {
+                Runnable done = mDone;
+                mRunning = false;
+                mUpdate = null;
+                mDone = null;
+                if (done != null) done.run();
+            } else {
+                Choreographer.getInstance().postFrameCallback(this);
+            }
+        }
+    }
+
+    private float currentBrightness() {
+        float own = mActivity.getWindow().getAttributes().screenBrightness;
+        if (own >= 0) return own;
+        try {
+            return Settings.System.getInt(
+                            mActivity.getContentResolver(), Settings.System.SCREEN_BRIGHTNESS)
+                    / 255f;
+        } catch (Settings.SettingNotFoundException e) {
+            return 0.5f;
+        }
+    }
+
+    // ---- Lifecycle ----
+
+    /** Gives the window its brightness back and stops pending work. */
+    void release() {
+        mHandler.removeCallbacksAndMessages(null);
+        resetClose();
+        if (mVelocity != null) {
+            mVelocity.recycle();
+            mVelocity = null;
+        }
+        WindowManager.LayoutParams lp = mActivity.getWindow().getAttributes();
+        if (lp.screenBrightness != mOriginalBrightness) {
+            lp.screenBrightness = mOriginalBrightness;
+            mActivity.getWindow().setAttributes(lp);
+        }
+    }
+
+    @Override
+    protected void onDetachedFromWindow() {
+        resetClose();
+        super.onDetachedFromWindow();
+    }
+
+    @Override
+    protected void onWindowVisibilityChanged(int visibility) {
+        super.onWindowVisibilityChanged(visibility);
+        // The activity went away (home, another app): the browser is never left scaled.
+        if (visibility != VISIBLE && !mClosing) {
+            if (mDrag == DRAG_CLOSE) mDrag = DRAG_NONE;
+            resetClose();
+        }
+    }
+
+    @Override
+    protected void onConfigurationChanged(Configuration newConfig) {
+        super.onConfigurationChanged(newConfig);
+        // Picture in picture shows the video alone; the controls would not fit.
+        setVisibility(mActivity.isInPictureInPictureMode() ? INVISIBLE : VISIBLE);
+        if (mDrag == DRAG_CLOSE) mDrag = DRAG_NONE;
+        resetClose();
+        mScale = 1;
+        mTx = 0;
+        mTy = 0;
+        mFit.setKind(BarePlayerIcon.FILL);
+        mDelegate.onTransform(1, 0, 0, 0);
+    }
+
+    private void applyCutout(WindowInsets insets) {
+        DisplayCutout cutout = insets.getDisplayCutout();
+        mSafeLeft = cutout == null ? 0 : cutout.getSafeInsetLeft();
+        mSafeTop = cutout == null ? 0 : cutout.getSafeInsetTop();
+        mSafeRight = cutout == null ? 0 : cutout.getSafeInsetRight();
+        mSafeBottom = cutout == null ? 0 : cutout.getSafeInsetBottom();
+        layoutRows();
+    }
+
+    /**
+     * Works out where the picture is on screen, from the element's box and the picture's own
+     * shape (fitted into the box and centred), at the current zoom.
+     */
+    private void placeAroundPicture(
+            double videoWidth,
+            double videoHeight,
+            double elementTop,
+            double elementWidth,
+            double elementHeight,
+            double windowWidth) {
+        int top = -1;
+        int bottom = -1;
+        if (videoWidth > 0 && videoHeight > 0 && elementWidth > 0 && elementHeight > 0
+                && windowWidth > 0 && getWidth() > 0) {
+            double fit = Math.min(elementWidth / videoWidth, elementHeight / videoHeight);
+            double pictureHeight = videoHeight * fit * mScale;
+            double centre = elementTop + elementHeight / 2;
+            double px = getWidth() / windowWidth;
+            top = (int) Math.round((centre - pictureHeight / 2) * px);
+            bottom = (int) Math.round((centre + pictureHeight / 2) * px);
+        }
+        if (top == mPictureTop && bottom == mPictureBottom) return;
+        mPictureTop = top;
+        mPictureBottom = bottom;
+        layoutRows();
+    }
+
+    /**
+     * Puts the top row just above the picture and the time and seek bar just below it, so they
+     * stay with the video on a tall screen. Where there is no room (landscape, or a zoomed
+     * picture) they sit at the screen's edges, over the picture.
+     */
+    private void layoutRows() {
+        int pad = dp(8);
+        int height = getHeight();
+        int topMargin = mSafeTop + pad;
+        int bottomMargin = mSafeBottom + pad;
+        if (height > 0 && mPictureTop >= 0 && mPictureBottom > mPictureTop) {
+            int topRowHeight = mTopRow.getHeight() > 0 ? mTopRow.getHeight() : dp(44);
+            int bottomRowHeight = mBottomRow.getHeight() > 0 ? mBottomRow.getHeight() : dp(44);
+            topMargin = Math.max(topMargin, mPictureTop - topRowHeight);
+            bottomMargin = Math.max(bottomMargin, height - mPictureBottom - bottomRowHeight);
+        }
+        LayoutParams top = (LayoutParams) mTopRow.getLayoutParams();
+        LayoutParams bottom = (LayoutParams) mBottomRow.getLayoutParams();
+        boolean changed =
+                top.topMargin != topMargin
+                        || bottom.bottomMargin != bottomMargin
+                        || top.leftMargin != mSafeLeft + pad
+                        || top.rightMargin != mSafeRight + pad;
+        if (!changed) return;
+        top.topMargin = topMargin;
+        top.leftMargin = mSafeLeft + pad;
+        top.rightMargin = mSafeRight + pad;
+        bottom.bottomMargin = bottomMargin;
+        bottom.leftMargin = mSafeLeft + pad;
+        bottom.rightMargin = mSafeRight + pad;
+        mTopRow.setLayoutParams(top);
+        mBottomRow.setLayoutParams(bottom);
+    }
+
+    // ---- Helpers ----
+
+    /** A button {@code sizeDp} square showing an icon {@code iconDp} across. */
+    private BarePlayerIcon icon(int kind, int description, int sizeDp, int iconDp) {
+        BarePlayerIcon icon = new BarePlayerIcon(getContext(), kind);
+        icon.setContentDescription(getContext().getString(description));
+        icon.setLayoutParams(new LinearLayout.LayoutParams(dp(sizeDp), dp(sizeDp)));
+        int pad = dp((sizeDp - iconDp) / 2);
+        icon.setPadding(pad, pad, pad, pad);
+        TypedValue ripple = new TypedValue();
+        if (getContext()
+                .getTheme()
+                .resolveAttribute(
+                        android.R.attr.selectableItemBackgroundBorderless, ripple, true)) {
+            icon.setBackgroundResource(ripple.resourceId);
+        }
+        return icon;
+    }
+
+    private TextView timeText(Context context) {
+        TextView text = new TextView(context);
+        text.setTextColor(Color.WHITE);
+        text.setTextSize(TypedValue.COMPLEX_UNIT_SP, 13);
+        text.setFontFeatureSettings("tnum");
+        text.setPadding(dp(12), 0, dp(12), 0);
+        text.setText(format(0));
+        return text;
+    }
+
+    private int dp(int value) {
+        return Math.round(value * mDp);
+    }
+
+    private static float clamp01(float value) {
+        return Math.max(0f, Math.min(1f, value));
+    }
+
+    static String format(double seconds) {
+        if (seconds < 0 || Double.isNaN(seconds)) seconds = 0;
+        long total = (long) seconds;
+        long h = total / 3600;
+        long m = (total / 60) % 60;
+        long s = total % 60;
+        return h > 0
+                ? String.format(Locale.US, "%d:%02d:%02d", h, m, s)
+                : String.format(Locale.US, "%d:%02d", m, s);
+    }
+}

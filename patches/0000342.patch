+    private void pressThumb(boolean pressed) {
+        if (mThumbAnimator != null) mThumbAnimator.cancel();
+        ValueAnimator animator = ValueAnimator.ofFloat(mThumb.getPress(), pressed ? 1f : 0f);
+        animator.setDuration(pressed ? 140 : 220);
+        animator.setInterpolator(new DecelerateInterpolator());
+        animator.addUpdateListener(
+                a -> {
+                    mThumb.setPress((float) a.getAnimatedValue());
+                    mSeek.invalidate();
+                });
+        animator.start();
+        mThumbAnimator = animator;

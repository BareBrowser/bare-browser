+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.bare.player;
+
+import org.jni_zero.CalledByNative;
+import org.jni_zero.JniType;
+import org.jni_zero.NativeMethods;
+
+import org.chromium.base.Callback;
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.content_public.browser.RenderFrameHost;
+import org.chromium.content_public.browser.WebContents;
+
+/**
+ * Talks to the page for the player: runs its script in one frame or in all of them.
+ *
+ * <p>Scripts run in Bare's isolated world, which sees the page's elements but not its variables,
+ * and which the page cannot see. Nothing here touches how the video is fetched or decoded.
+ */
+@NullMarked
+final class BarePlayerBridge {
+    private BarePlayerBridge() {}
+
+    /**
+     * Runs {@code script} in every frame. The callback gets a JSON list of {"f": frame, "r":
+     * result} for every frame that answered something other than null, or null if the page has
+     * gone.
+     */
+    static void evaluateAll(
+            @Nullable WebContents webContents, String script, Callback<@Nullable String> callback) {
+        if (webContents == null || webContents.isDestroyed()) {
+            callback.onResult(null);
+            return;
+        }
+        BarePlayerBridgeJni.get().evaluateAll(webContents, script, callback);
+    }
+
+    /** Runs {@code script} in one frame. {@code activate} counts as a tap in that frame. */
+    static void evaluateIn(
+            @Nullable WebContents webContents,
+            int frameId,
+            String script,
+            boolean activate,
+            Callback<@Nullable String> callback) {
+        if (webContents == null || webContents.isDestroyed()) {
+            callback.onResult(null);
+            return;
+        }
+        BarePlayerBridgeJni.get().evaluateIn(webContents, frameId, script, activate, callback);
+    }
+
+    /** Downloads {@code url} as the page's video, like the long-press menu's Save video. */
+    static void download(@Nullable WebContents webContents, int frameId, String url) {
+        if (webContents == null || webContents.isDestroyed()) return;
+        BarePlayerBridgeJni.get().download(webContents, frameId, url);
+    }
+
+    /** The id {@link #evaluateIn} takes for a frame, or -1 if there is none. */
+    static int frameIdOf(@Nullable RenderFrameHost frame) {
+        if (frame == null) return -1;
+        return BarePlayerBridgeJni.get().frameIdOf(frame);
+    }
+
+    @CalledByNative
+    private static void onResult(
+            Callback<@Nullable String> callback, @JniType("std::string") String json) {
+        callback.onResult(json);
+    }
+
+    @NativeMethods
+    interface Natives {
+        void evaluateAll(
+                WebContents webContents, String script, Callback<@Nullable String> callback);
+
+        void evaluateIn(
+                WebContents webContents,
+                int frameId,
+                String script,
+                boolean activate,
+                Callback<@Nullable String> callback);
+
+        int frameIdOf(RenderFrameHost frame);
+
+        void download(WebContents webContents, int frameId, String url);
+    }
+}

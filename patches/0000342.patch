+
+#include <utility>
+#include <vector>
+
+#include "base/android/jni_android.h"
+#include "base/android/jni_string.h"
+#include "base/android/scoped_java_ref.h"
+#include "base/barrier_callback.h"
+#include "base/functional/bind.h"
+#include "base/json/json_writer.h"
+#include "base/values.h"
+#include "chrome/browser/download/android/download_controller_base.h"
+#include "content/public/browser/context_menu_params.h"
+#include "content/public/browser/frame_tree_node_id.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/common/isolated_world_ids.h"
+#include "services/network/public/mojom/referrer_policy.mojom.h"
+#include "third_party/blink/public/mojom/context_menu/context_menu.mojom.h"
+#include "url/gurl.h"
+#include "third_party/blink/public/mojom/frame/user_activation_notification_type.mojom.h"
+
+// Must come after all headers that specialize FromJniType() / ToJniType().
+#include "chrome/android/chrome_jni_headers/BarePlayerBridge_jni.h"
+
+namespace {
+
+// The same world BareScriptBridge uses, so the player and the other page
+// scripts share one place to keep what they leave behind.
+constexpr int32_t kBareWorld = content::ISOLATED_WORLD_ID_CONTENT_END + 1;
+
+using base::android::JavaRef;
+using base::android::ScopedJavaGlobalRef;
+
+void ReplyJson(const ScopedJavaGlobalRef<jobject>& callback,
+               const base::Value& value) {
+  std::string json;
+  if (std::optional<std::string> written = base::WriteJson(value)) {
+    json = std::move(*written);
+  }
+  Java_BarePlayerBridge_onResult(base::android::AttachCurrentThread(),
+                                 callback, json);
+}
+
+void OnFrameResults(ScopedJavaGlobalRef<jobject> callback,
+                    std::vector<base::Value> results) {
+  base::ListValue list;
+  for (base::Value& result : results) {
+    if (!result.is_none()) {
+      list.Append(std::move(result));
+    }
+  }
+  ReplyJson(callback, base::Value(std::move(list)));
+}
+
+// Tags a frame's answer with the frame it came from, so a later call can go
+// back to the same frame.
+base::Value TagWithFrame(int frame_id, base::Value result) {
+  if (result.is_none()) {
+    return base::Value();
+  }
+  base::DictValue tagged;
+  tagged.Set("f", frame_id);
+  tagged.Set("r", std::move(result));
+  return base::Value(std::move(tagged));
+}
+
+content::RenderFrameHost* FindFrame(const JavaRef<jobject>& jweb_contents,
+                                    jint frame_id) {
+  content::WebContents* web_contents =
+      content::WebContents::FromJavaWebContents(jweb_contents);
+  if (!web_contents) {
+    return nullptr;
+  }
+  content::RenderFrameHost* frame =
+      web_contents->UnsafeFindFrameByFrameTreeNodeId(
+          content::FrameTreeNodeId::FromUnsafeValue(frame_id));
+  if (!frame || !frame->IsRenderFrameLive() ||
+      !frame->IsActive()) {
+    return nullptr;
+  }
+  return frame;
+}
+
+}  // namespace
+
+// Runs the script in every live frame of the page shown in the tab, and
+// answers with a JSON list of {"f": frame, "r": result} for each frame that
+// returned something other than null. Videos often sit in an embedded player
+// from another site, which the main frame cannot see into.
+static void JNI_BarePlayerBridge_EvaluateAll(
+    JNIEnv* env,
+    const JavaRef<jobject>& jweb_contents,
+    const JavaRef<jstring>& jscript,
+    const JavaRef<jobject>& jcallback) {
+  ScopedJavaGlobalRef<jobject> callback(jcallback);
+  content::WebContents* web_contents =
+      content::WebContents::FromJavaWebContents(jweb_contents);
+  if (!web_contents) {
+    ReplyJson(callback, base::Value(base::ListValue()));
+    return;
+  }
+  std::vector<content::RenderFrameHost*> frames;
+  web_contents->GetPrimaryMainFrame()->ForEachRenderFrameHost(
+      [&frames](content::RenderFrameHost* frame) {
+        if (frame->IsRenderFrameLive() && frame->IsActive()) {
+          frames.push_back(frame);
+        }
+      });
+  if (frames.empty()) {
+    ReplyJson(callback, base::Value(base::ListValue()));
+    return;
+  }
+  auto barrier = base::BarrierCallback<base::Value>(
+      frames.size(), base::BindOnce(&OnFrameResults, callback));
+  std::u16string script = base::android::ConvertJavaStringToUTF16(env, jscript);
+  for (content::RenderFrameHost* frame : frames) {
+    frame->ExecuteJavaScriptInIsolatedWorld(
+        script,
+        base::BindOnce(&TagWithFrame, frame->GetFrameTreeNodeId().value())
+            .Then(barrier),
+        kBareWorld);
+  }
+}
+
+// Runs the script in one frame. With |activate|, the frame is first told the
+// user has just interacted with it: the tap that asked for this happened on
+// the player, outside the page, and a page may only enter fullscreen after one.
+static void JNI_BarePlayerBridge_EvaluateIn(JNIEnv* env,
+                                            const JavaRef<jobject>& jweb_contents,
+                                            jint frame_id,
+                                            const JavaRef<jstring>& jscript,
+                                            jboolean activate,
+                                            const JavaRef<jobject>& jcallback) {
+  ScopedJavaGlobalRef<jobject> callback(jcallback);
+  content::RenderFrameHost* frame = FindFrame(jweb_contents, frame_id);
+  if (!frame) {
+    ReplyJson(callback, base::Value());
+    return;
+  }
+  if (activate) {
+    frame->NotifyUserActivation(
+        blink::mojom::UserActivationNotificationType::kInteraction);
+  }
+  frame->ExecuteJavaScriptInIsolatedWorld(
+      base::android::ConvertJavaStringToUTF16(env, jscript),
+      base::BindOnce(
+          [](ScopedJavaGlobalRef<jobject> callback, base::Value value) {
+            ReplyJson(callback, value);
+          },
+          callback),
+      kBareWorld);
+}
+
+// The id evaluateIn() takes for a frame, from the frame the long-press menu
+// was opened in.
+static jint JNI_BarePlayerBridge_FrameIdOf(JNIEnv* env,
+                                         const JavaRef<jobject>& jframe) {
+  content::RenderFrameHost* frame =
+      content::RenderFrameHost::FromJavaRenderFrameHost(jframe);
+  if (!frame) {
+    return -1;
+  }
+  return frame->GetFrameTreeNodeId().value();
+}
+
+// Downloads the video file the player shows, the same way the long-press
+// menu's Save video does: from the page, with the page as referrer, through the
+// browser's own download handling (and the external download manager, if one is
+// chosen).
+static void JNI_BarePlayerBridge_Download(JNIEnv* env,
+                                          const JavaRef<jobject>& jweb_contents,
+                                          jint frame_id,
+                                          const JavaRef<jstring>& jurl) {
+  content::WebContents* web_contents =
+      content::WebContents::FromJavaWebContents(jweb_contents);
+  if (!web_contents) {
+    return;
+  }
+  GURL url(base::android::ConvertJavaStringToUTF8(env, jurl));
+  if (!url.is_valid() || !url.SchemeIsHTTPOrHTTPS()) {
+    return;
+  }
+  content::ContextMenuParams params;
+  params.page_url = web_contents->GetLastCommittedURL();
+  if (content::RenderFrameHost* frame = FindFrame(jweb_contents, frame_id)) {
+    params.frame_url = frame->GetLastCommittedURL();
+  }
+  params.src_url = url;
+  params.media_type = blink::mojom::ContextMenuDataMediaType::kVideo;
+  params.referrer_policy = network::mojom::ReferrerPolicy::kDefault;
+  DownloadControllerBase::Get()->StartContextMenuDownload(url, params,
+                                                          web_contents,
+                                                          /*is_media=*/true);
+}
+
+DEFINE_JNI(BarePlayerBridge)

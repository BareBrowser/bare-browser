From 2c8a309bbea38a1b3eb7cecb19f107708bda5d58 Mon Sep 17 00:00:00 2001
From: Bare <git@barebrowser.org>
Date: Mon, 12 Oct 2026 21:47:07 +0000
Subject: [PATCH] Give Exit an icon in the app menu

0118 added Exit with no icon, so in a menu where every other top-level row
has one, Exit sat out of line. It now uses ic_exit_to_app_white_24dp, the
leave-the-app arrow Chromium already ships for web app notifications, passed
the same way as the Settings and Help icons, so the menu's tint and its icon
position apply to it as to them. What Exit clears and when it closes the
browser are unchanged.
---
 .../tabbed_mode/TabbedAppMenuPropertiesDelegate.java        | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/chrome/android/java/src/org/chromium/chrome/browser/tabbed_mode/TabbedAppMenuPropertiesDelegate.java b/chrome/android/java/src/org/chromium/chrome/browser/tabbed_mode/TabbedAppMenuPropertiesDelegate.java
index 97ff8e4c9e5..7a28c7eea16 100644
--- a/chrome/android/java/src/org/chromium/chrome/browser/tabbed_mode/TabbedAppMenuPropertiesDelegate.java
+++ b/chrome/android/java/src/org/chromium/chrome/browser/tabbed_mode/TabbedAppMenuPropertiesDelegate.java
@@ -1367,7 +1367,11 @@ public class TabbedAppMenuPropertiesDelegate extends AppMenuPropertiesDelegateIm
                         getAppMenuItemTheme(),
                         R.id.bare_exit_id,
                         R.string.bare_menu_exit,
-                        Resources.ID_NULL,
+                        // Bare: the same leave-the-app arrow web apps use, so Exit is not the one
+                        // top-level row without an icon. Tinted like its neighbours.
+                        shouldShowIconBeforeItem()
+                                ? R.drawable.ic_exit_to_app_white_24dp
+                                : Resources.ID_NULL,
                         isMenuIconAtStart()));
     }
 

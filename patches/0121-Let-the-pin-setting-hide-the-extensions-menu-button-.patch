From abf4aa1de72af55f6d700fafcc3f32b675c2999a Mon Sep 17 00:00:00 2001
From: Bare <git@barebrowser.org>
Date: Wed, 9 Sep 2026 00:55:39 +0000
Subject: [PATCH] Let the pin setting hide the extensions menu button on a
 phone

The switch in the extensions menu footer, "Pin to toolbar", changed its own
state and nothing else. The puzzle-piece button stayed in the toolbar whether it
read on or off, and a restart did not settle it either.

The stored state was never wrong. It lives in Pref.PIN_EXTENSIONS_MENU_BUTTON
and was read and written correctly throughout. What never ran was
updateMenuIconVisibility(), the only place the button's visibility is computed.
Its one routine caller is MenuButtonWidthConsumer.updateVisibility, a
ToolbarWidthConsumer, and the only code registering that consumer is
ToolbarTablet. ToolbarPhone registers none, since upstream shows extensions on
tablets only. Patch 0003 put the container on the phone layout without that
wiring, so the button kept the visibility it was inflated with.

Three calls to the method that already exists. Once at the end of construction,
because the preference observer fires on a change and a fresh start is not one.
Once from updateMenuButtonPinState, which that observer already calls. Once when
the menu is dismissed, because the button has to stay while its own menu is
anchored to it, so turning the setting off inside the menu cannot take effect
until the menu goes away. The last one is posted: the host still reports the
menu as showing while it is being dismissed, and shouldShowMenuIcon asks it.

Per-extension pinning is untouched and stays independent of this setting. It
runs off ToolbarActionsModel through onPinnedActionsChanged, which was already
working. With the button hidden and nothing pinned the extensions toolbar
collapses and the neighbouring button takes the space, and the App Menu keeps
its "Open extensions menu" entry, so the menu is still reachable.

Patch 0115 draws the container into the captured toolbar through View.draw,
which honours each child's own visibility, so a hidden button stays out of the
bitmap as well.

Migration note (156.0.8078.25): upstream now calls updateMenuIconVisibility() at the
end of construction itself, so that call is no longer part of this patch.
---
 .../ExtensionsToolbarCoordinatorImpl.java     | 36 +++++++++++++++++++
 1 file changed, 36 insertions(+)

diff --git a/chrome/browser/ui/android/toolbar/java/src/org/chromium/chrome/browser/toolbar/extensions/ExtensionsToolbarCoordinatorImpl.java b/chrome/browser/ui/android/toolbar/java/src/org/chromium/chrome/browser/toolbar/extensions/ExtensionsToolbarCoordinatorImpl.java
index 8858367251b..c76dacfc332 100644
--- a/chrome/browser/ui/android/toolbar/java/src/org/chromium/chrome/browser/toolbar/extensions/ExtensionsToolbarCoordinatorImpl.java
+++ b/chrome/browser/ui/android/toolbar/java/src/org/chromium/chrome/browser/toolbar/extensions/ExtensionsToolbarCoordinatorImpl.java
@@ -48,6 +48,7 @@ import org.chromium.content_public.browser.selection.SelectionDropdownMenuDelega
 import org.chromium.ui.base.ViewUtils;
 import org.chromium.ui.base.WindowAndroid;
 import org.chromium.ui.listmenu.ListMenuButton;
+import org.chromium.ui.listmenu.ListMenuHost;
 import org.chromium.ui.modaldialog.ModalDialogManager;
 import org.chromium.ui.modelutil.PropertyModel;
 import org.chromium.ui.modelutil.PropertyModelChangeProcessor;
@@ -83,6 +84,24 @@ public class ExtensionsToolbarCoordinatorImpl
 
     private boolean mCanShowMenuIcon = true;
     private boolean mShowExtensionsMenuPending;
+
+    // The menu button has to stay on screen while its own menu is anchored to it, whatever the
+    // pin preference says, so the button is re-evaluated once the menu goes away.
+    private final ListMenuHost.PopupMenuShownListener mMenuVisibilityListener =
+            new ListMenuHost.PopupMenuShownListener() {
+                @Override
+                public void onPopupMenuShown() {}
+
+                @Override
+                public void onPopupMenuDismissed() {
+                    // Posted rather than called directly: the host still reports the menu as
+                    // showing while it is being dismissed, and shouldShowMenuIcon() asks it.
+                    mContainer.post(
+                            () -> {
+                                if (!mIsDestroyed) updateMenuIconVisibility();
+                            });
+                }
+            };
     private boolean mIsDestroyed;
     private final ExtensionsToolbarBridge.Observer mExtensionsToolbarBridgeObserver =
             new ExtensionsToolbarBridge.Observer() {
@@ -188,6 +207,9 @@ public class ExtensionsToolbarCoordinatorImpl
                         () ->
                                 mContainer.getResources().getConfiguration().screenWidthDp
                                         < COMPACT_WINDOW_THRESHOLD_DP);
+        ((ListMenuButton) mContainer.findViewById(R.id.extensions_menu_button))
+                .addPopupListener(mMenuVisibilityListener);
+
         mPrefChangeRegistrar = PrefServiceUtil.createFor(profile);
         mPrefChangeRegistrar.addObserver(
                 Pref.PIN_EXTENSIONS_MENU_BUTTON, this::updateMenuButtonPinState);
@@ -240,6 +262,13 @@ public class ExtensionsToolbarCoordinatorImpl
             mLayoutChangeListener = null;
         }
 
+        if (mContainer != null) {
+            ListMenuButton menuButton = mContainer.findViewById(R.id.extensions_menu_button);
+            if (menuButton != null) {
+                menuButton.removePopupListener(mMenuVisibilityListener);
+            }
+        }
+
         mMenuButtonChangeProcessor.destroy();
 
         if (mPrefChangeRegistrar != null) {
@@ -459,6 +488,13 @@ public class ExtensionsToolbarCoordinatorImpl
             mExtensionsMenuCoordinator.setMenuButtonPinned(isMenuButtonPinned());
         }
 
+        // Apply the preference to the button here as well. On a tablet this is redundant, since
+        // the width consumers run on every layout pass and one of them ends in
+        // updateMenuIconVisibility(). A phone registers no width consumers at all, so without
+        // this the button keeps whatever visibility it was inflated with and the pin setting
+        // does nothing.
+        updateMenuIconVisibility();
+
         // Trigger layout and wait for the toolbar to provide us with width allocation.
         ViewUtils.requestLayout(
                 mContainer, "ExtensionsToolbarCoordinatorImpl.updateMenuButtonPinState()");

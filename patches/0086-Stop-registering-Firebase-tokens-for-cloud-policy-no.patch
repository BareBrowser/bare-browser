From 1b1527dd1f2a07bc00daab594216f0041dcf87d7 Mon Sep 17 00:00:00 2001
From: Bare <git@barebrowser.org>
Date: Sun, 23 Aug 2026 17:41:26 +0000
Subject: [PATCH] Stop registering Firebase tokens for cloud policy nobody
 sends

A fresh profile was fetching two Firebase registration tokens on its first
run and keeping them in shared_prefs, under com.google.chrome.fcm.invalidations
for Google project numbers 585406161706 and 245350905893. Both are durable
per-install identifiers, obtained before the user had touched anything.

They come from UserFmRegistrationTokenUploader, which walks every invalidation
project when the profile finishes initialising and registers one token each.
The projects are critical, for enterprise remote commands, and non-critical,
for cloud policy invalidations. Both exist so a management server can tell an
enrolled browser that its policy changed.

This build has no enrollment path, no cloud policy client and no sync, so an
invalidation could never arrive and nothing would act on one if it did. The
registration bought an identifier and nothing else.

The two helpers that only fed the removed loop go with it.

Confirmed on a Pixel 3 with a wiped profile: com.google.android.gms.appid.xml
and the gcm_driver preference files are no longer created at all, where before
they held two live tokens.

This is separate from the caBLE registration removed earlier. That was a
different consumer of the same machinery, which is why one fix did not cover
both.
---
 .../user_fm_registration_token_uploader.cc    | 51 +++++--------------
 1 file changed, 13 insertions(+), 38 deletions(-)

diff --git a/chrome/browser/policy/cloud/user_fm_registration_token_uploader.cc b/chrome/browser/policy/cloud/user_fm_registration_token_uploader.cc
index d2386d277ef..ce3eb695d03 100644
--- a/chrome/browser/policy/cloud/user_fm_registration_token_uploader.cc
+++ b/chrome/browser/policy/cloud/user_fm_registration_token_uploader.cc
@@ -24,27 +24,6 @@
 #include "chrome/browser/ash/cert_provisioning/cert_provisioning_common.h"
 #endif
 
-namespace {
-
-// Returns a set of all project numbers that will be used by user.
-std::set<int64_t> GetAllInvalidationProjectNumbers() {
-  return {
-      policy::kPolicyInvalidationProjectNumber,
-      policy::kRemoteCommandsInvalidationsProjectNumber,
-#if BUILDFLAG(IS_CHROMEOS)
-      ash::cert_provisioning::kCertProvisioningInvalidationProjectNumber,
-#endif
-  };
-}
-
-invalidation::ProfileInvalidationProvider* GetInvalidationProvider(
-    Profile* profile) {
-  return invalidation::ProfileInvalidationProviderFactory::GetForProfile(
-      profile);
-}
-
-}  // namespace
-
 namespace policy {
 
 UserFmRegistrationTokenUploader::UserFmRegistrationTokenUploader(
@@ -71,23 +50,19 @@ void UserFmRegistrationTokenUploader::OnProfileInitializationComplete(
   CHECK(profile_observation_.IsObservingSource(profile));
   profile_observation_.Reset();
 
-  // Initialize now that profile creation is complete and the invalidation
-  // service can safely be initialized.
-  invalidation::ProfileInvalidationProvider* invalidation_provider =
-      GetInvalidationProvider(profile);
-  if (!invalidation_provider) {
-    VLOG(1) << "Invalidation provider does not exist.";
-    return;
-  }
-
-  for (const int64_t project_number : GetAllInvalidationProjectNumbers()) {
-    invalidation::InvalidationListener* invalidation_listener =
-        invalidation_provider->GetInvalidationListener(project_number);
-
-    uploaders_.emplace_back(std::make_unique<FmRegistrationTokenUploader>(
-        PolicyInvalidationScope::kUser, invalidation_listener,
-        policy_manager_->core()));
-  }
+  // De-Googled build: no Firebase registration for cloud policy.
+  //
+  // Upstream fetches one FM registration token per invalidation project here,
+  // and there are two: critical, for remote commands, and non-critical, for
+  // policy invalidations. Each fetch asks Google for a token tied to this
+  // install, which then persists in shared_prefs as a durable identifier. It
+  // was happening on the first run of a fresh profile, before the user had
+  // touched anything.
+  //
+  // Both projects exist so a management server can tell an enrolled browser
+  // that its policy changed. This build has no enrollment path, no cloud policy
+  // client and no sync, so no invalidation could ever arrive or be acted on.
+  // The tokens bought an identifier and nothing else.
 }
 
 }  // namespace policy

index 00000000000..3853b0bab27
--- /dev/null
+++ b/chrome/browser/ui/android/night_mode/java/src/org/chromium/chrome/browser/night_mode/ThemeSwitchOverlay.java
@@ -0,0 +1,186 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.night_mode;
+
+import android.animation.ValueAnimator;
+import android.app.Activity;
+import android.content.Context;
+import android.graphics.Color;
+import android.graphics.drawable.GradientDrawable;
+import android.os.SystemClock;
+import android.provider.Settings;
+import android.util.TypedValue;
+import android.view.Gravity;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.FrameLayout;
+
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+
+/**
+ * Covers the activity relaunch that a theme change causes.
+ *
+ * <p>Changing the theme calls recreate(), which tears the activity down and builds it again. That
+ * takes around 700ms, and for all of it the user sees the old theme sitting there before it
+ * suddenly swaps. The relaunch cannot be made meaningfully faster, so it gets covered instead.
+ *
+ * <p>A window that genuinely outlives an activity needs SYSTEM_ALERT_WINDOW, which is far too
+ * much to ask for a visual flourish. This works with the relaunch rather than around it: the
+ * overlay goes up inside the outgoing activity, so the screenshot the system holds during the
+ * relaunch is already the overlay, and the incoming activity puts the same overlay up before its
+ * first frame and fades it out afterwards. The result reads as one continuous cover even though
+ * it is two views in two activities with a system snapshot between them.
+ */
+@NullMarked
+public class ThemeSwitchOverlay {
+    /** How long a pending switch stays valid, in case an activity never comes back. */
+    private static final long PENDING_TIMEOUT_MS = 4000;
+
+    private static final int CIRCLE_DP = 96;
+    private static final int RING_DP = 7;
+    private static final int CIRCLE_FILL = 0xFF2563EB;
+    private static final int RING_COLOR = 0xFFFFFFFF;
+
+    private static final int FADE_IN_MS = 120;
+    private static final int FADE_OUT_MS = 220;
+    private static final int PULSE_MS = 900;
+
+    private static long sPendingSinceMs;
+
+    private ThemeSwitchOverlay() {}
+
+    /** Records that a theme change is about to relaunch the activities. */
+    public static void markPending() {
+        sPendingSinceMs = SystemClock.elapsedRealtime();
+    }
+
+    private static boolean isPending() {
+        return sPendingSinceMs != 0
+                && SystemClock.elapsedRealtime() - sPendingSinceMs < PENDING_TIMEOUT_MS;
+    }
+
+    /** Clears the pending state once every activity has had its chance to cover. */
+    public static void clearPending() {
+        sPendingSinceMs = 0;
+    }
+
+    /**
+     * Puts the cover up on an activity that is about to be relaunched, so the system snapshot
+     * captures it rather than the old theme.
+     */
+    public static void coverBeforeRelaunch(Activity activity) {
+        if (animationsAreOff(activity)) return;
+        View cover = build(activity);
+        if (cover == null) return;
+        cover.setAlpha(0f);
+        cover.animate().alpha(1f).setDuration(FADE_IN_MS).start();
+    }
+
+    /**
+     * Puts the cover up on a freshly built activity and takes it away once the real UI has drawn.
+     * Does nothing unless a theme change is actually in flight.
+     */
+    public static void coverUntilDrawn(Activity activity) {
+        if (!isPending() || animationsAreOff(activity)) return;
+        final View cover = build(activity);
+        if (cover == null) return;
+
+        final View content = activity.findViewById(android.R.id.content);
+        if (content == null) {
+            remove(cover);
+            return;
+        }
+        content.post(
+                () ->
+                        cover.animate()
+                                .alpha(0f)
+                                .setDuration(FADE_OUT_MS)
+                                .withEndAction(() -> remove(cover))
+                                .start());
+    }
+
+    private static @Nullable View build(Activity activity) {
+        ViewGroup root = activity.findViewById(android.R.id.content);
+        if (root == null) return null;
+
+        FrameLayout cover = new FrameLayout(activity);
+        cover.setBackgroundColor(windowBackground(activity));
+        cover.setClickable(true);
+
+        View mark = new View(activity);
+        GradientDrawable circle = new GradientDrawable();
+        circle.setShape(GradientDrawable.OVAL);
+        circle.setColor(CIRCLE_FILL);
+        circle.setStroke(dp(activity, RING_DP), RING_COLOR);
+        mark.setBackground(circle);
+
+        int size = dp(activity, CIRCLE_DP);
+        FrameLayout.LayoutParams lp = new FrameLayout.LayoutParams(size, size);
+        lp.gravity = Gravity.CENTER;
+        cover.addView(mark, lp);
+
+        // A slow breath rather than a spinner: the snapshot freezes whatever frame it catches,
+        // so anything faster would read as a stalled animation while the relaunch happens.
+        ValueAnimator pulse = ValueAnimator.ofFloat(0.94f, 1.04f);
+        pulse.setDuration(PULSE_MS);
+        pulse.setRepeatMode(ValueAnimator.REVERSE);
+        pulse.setRepeatCount(ValueAnimator.INFINITE);
+        pulse.addUpdateListener(
+                a -> {
+                    float s = (float) a.getAnimatedValue();
+                    mark.setScaleX(s);
+                    mark.setScaleY(s);
+                });
+        pulse.start();
+        mark.addOnAttachStateChangeListener(
+                new View.OnAttachStateChangeListener() {
+                    @Override
+                    public void onViewAttachedToWindow(View v) {}
+
+                    @Override
+                    public void onViewDetachedFromWindow(View v) {
+                        pulse.cancel();
+                    }
+                });
+
+        root.addView(
+                cover,
+                new FrameLayout.LayoutParams(
+                        ViewGroup.LayoutParams.MATCH_PARENT,
+                        ViewGroup.LayoutParams.MATCH_PARENT));
+        return cover;
+    }
+
+    private static void remove(View cover) {
+        ViewGroup parent = (ViewGroup) cover.getParent();
+        if (parent != null) parent.removeView(cover);
+    }
+
+    private static int windowBackground(Activity activity) {
+        TypedValue value = new TypedValue();
+        if (activity.getTheme().resolveAttribute(android.R.attr.colorBackground, value, true)) {
+            if (value.type >= TypedValue.TYPE_FIRST_COLOR_INT
+                    && value.type <= TypedValue.TYPE_LAST_COLOR_INT) {
+                return value.data;
+            }
+            if (value.resourceId != 0) return activity.getColor(value.resourceId);
+        }
+        return Color.BLACK;
+    }
+
+    private static int dp(Context context, int value) {
+        return Math.round(value * context.getResources().getDisplayMetrics().density);
+    }
+
+    /** Respects the system animation setting, which some people turn off deliberately. */
+    private static boolean animationsAreOff(Context context) {
+        return Settings.Global.getFloat(
+                        context.getContentResolver(),
+                        Settings.Global.ANIMATOR_DURATION_SCALE,
+                        1f)
+                == 0f;
+    }
+}

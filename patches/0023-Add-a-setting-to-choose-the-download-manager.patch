From 7a127518f010e5327bef5b486542919014306c00 Mon Sep 17 00:00:00 2001
From: Bare <git@barebrowser.org>
Date: Sun, 16 Aug 2026 17:29:54 +0000
Subject: [PATCH] Add a setting to choose the download manager

Settings, Downloads now has "Use an external download manager", which gates the
handoff added in the previous patch.

Off by default, so a stock install downloads in the browser exactly as before
and installing a download manager for unrelated reasons does not silently
reroute anything.

The summary shown when it is on states that files needing you to be signed in
may fail, because sign-in details are not passed on. That failure is otherwise
invisible and would read as a random bug, so it belongs where someone sees it
before turning the setting on rather than only in a code comment.

The key is registered in ChromePreferenceKeys.getKeysInUse(), which Chromium
validates against.
---
 .../browser/download/DownloadController.java  |  8 ++++++
 .../java/res/xml/download_preferences.xml     |  6 +++++
 .../download/settings/DownloadSettings.java   | 25 +++++++++++++++++++
 .../preferences/ChromePreferenceKeys.java     |  8 ++++++
 .../strings/android_chrome_strings.grd        |  9 +++++++
 5 files changed, 56 insertions(+)

diff --git a/chrome/android/java/src/org/chromium/chrome/browser/download/DownloadController.java b/chrome/android/java/src/org/chromium/chrome/browser/download/DownloadController.java
index 2c7fa8f43dc..5c36258aa11 100644
--- a/chrome/android/java/src/org/chromium/chrome/browser/download/DownloadController.java
+++ b/chrome/android/java/src/org/chromium/chrome/browser/download/DownloadController.java
@@ -21,6 +21,8 @@ import org.chromium.base.Log;
 import org.chromium.build.annotations.NullMarked;
 import org.chromium.build.annotations.Nullable;
 import org.chromium.chrome.browser.pdf.PdfPage;
+import org.chromium.chrome.browser.preferences.ChromePreferenceKeys;
+import org.chromium.chrome.browser.preferences.ChromeSharedPreferences;
 import org.chromium.chrome.browser.pdf.PdfUtils;
 import org.chromium.chrome.browser.profiles.Profile;
 import org.chromium.chrome.browser.tab.Tab;
@@ -56,6 +58,12 @@ public class DownloadController {
     @CalledByNative
     private static boolean maybeSendToExternalDownloadManager(
             GURL url, @JniType("std::string") String mimeType) {
+        if (!ChromeSharedPreferences.getInstance()
+                .readBoolean(
+                        ChromePreferenceKeys.DOWNLOAD_USE_EXTERNAL_DOWNLOAD_MANAGER, false)) {
+            return false;
+        }
+
         Context context = ContextUtils.getApplicationContext();
         if (context == null) return false;
 
diff --git a/chrome/browser/download/android/java/res/xml/download_preferences.xml b/chrome/browser/download/android/java/res/xml/download_preferences.xml
index 6d14eb7186d..7d8adae60d6 100644
--- a/chrome/browser/download/android/java/res/xml/download_preferences.xml
+++ b/chrome/browser/download/android/java/res/xml/download_preferences.xml
@@ -18,6 +18,12 @@ found in the LICENSE file.
         android:summaryOn="@string/text_on"
         android:summaryOff="@string/text_off" />
 
+    <org.chromium.components.browser_ui.settings.ChromeSwitchPreference
+        android:key="external_download_manager_enabled"
+        android:title="@string/external_download_manager_title"
+        android:summaryOn="@string/external_download_manager_summary_on"
+        android:summaryOff="@string/external_download_manager_summary_off" />
+
     <org.chromium.components.browser_ui.settings.ChromeSwitchPreference
         android:key="auto_open_pdf_enabled"
         android:title="@string/auto_open_pdf_enabled_title"
diff --git a/chrome/browser/download/android/java/src/org/chromium/chrome/browser/download/settings/DownloadSettings.java b/chrome/browser/download/android/java/src/org/chromium/chrome/browser/download/settings/DownloadSettings.java
index 4081446d20f..b5b7c80b61a 100644
--- a/chrome/browser/download/android/java/src/org/chromium/chrome/browser/download/settings/DownloadSettings.java
+++ b/chrome/browser/download/android/java/src/org/chromium/chrome/browser/download/settings/DownloadSettings.java
@@ -25,6 +25,8 @@ import org.chromium.chrome.browser.profiles.Profile;
 import org.chromium.chrome.browser.settings.ChromeBaseSettingsFragment;
 import org.chromium.chrome.browser.settings.ChromeManagedPreferenceDelegate;
 import org.chromium.chrome.browser.settings.search.ChromeBaseSearchIndexProvider;
+import org.chromium.chrome.browser.preferences.ChromePreferenceKeys;
+import org.chromium.chrome.browser.preferences.ChromeSharedPreferences;
 import org.chromium.components.browser_ui.settings.ChromeSwitchPreference;
 import org.chromium.components.browser_ui.settings.ManagedPreferenceDelegate;
 import org.chromium.components.browser_ui.settings.SettingsUtils;
@@ -39,6 +41,9 @@ public class DownloadSettings extends ChromeBaseSettingsFragment
     public static final String PREF_LOCATION_PROMPT_ENABLED = "location_prompt_enabled";
     public static final String PREF_AUTO_OPEN_PDF_ENABLED = "auto_open_pdf_enabled";
 
+    /** De-Googled build: hand downloads to an installed download manager app. */
+    public static final String PREF_EXTERNAL_DOWNLOAD_MANAGER = "external_download_manager_enabled";
+
     private DownloadLocationPreference mLocationChangePref;
     private ChromeSwitchPreference mLocationPromptEnabledPref;
     private ManagedPreferenceDelegate mLocationPromptEnabledPrefDelegate;
@@ -51,6 +56,18 @@ public class DownloadSettings extends ChromeBaseSettingsFragment
         mPageTitle.set(getString(R.string.menu_downloads));
         SettingsUtils.addPreferencesFromResource(this, R.xml.download_preferences);
 
+        // De-Googled build: reflect the stored external download manager choice.
+        ChromeSwitchPreference externalDownloadManagerPref =
+                (ChromeSwitchPreference) findPreference(PREF_EXTERNAL_DOWNLOAD_MANAGER);
+        if (externalDownloadManagerPref != null) {
+            externalDownloadManagerPref.setChecked(
+                    ChromeSharedPreferences.getInstance()
+                            .readBoolean(
+                                    ChromePreferenceKeys.DOWNLOAD_USE_EXTERNAL_DOWNLOAD_MANAGER,
+                                    false));
+            externalDownloadManagerPref.setOnPreferenceChangeListener(this);
+        }
+
         mLocationPromptEnabledPref =
                 (ChromeSwitchPreference) findPreference(PREF_LOCATION_PROMPT_ENABLED);
         mLocationPromptEnabledPrefDelegate =
@@ -145,6 +162,14 @@ public class DownloadSettings extends ChromeBaseSettingsFragment
     // Preference.OnPreferenceChangeListener implementation.
     @Override
     public boolean onPreferenceChange(Preference preference, Object newValue) {
+        if (PREF_EXTERNAL_DOWNLOAD_MANAGER.equals(preference.getKey())) {
+            ChromeSharedPreferences.getInstance()
+                    .writeBoolean(
+                            ChromePreferenceKeys.DOWNLOAD_USE_EXTERNAL_DOWNLOAD_MANAGER,
+                            (boolean) newValue);
+            return true;
+        }
+
         if (PREF_LOCATION_PROMPT_ENABLED.equals(preference.getKey())) {
             if ((boolean) newValue) {
                 // Only update if the download location dialog has been shown before.
diff --git a/chrome/browser/preferences/android/java/src/org/chromium/chrome/browser/preferences/ChromePreferenceKeys.java b/chrome/browser/preferences/android/java/src/org/chromium/chrome/browser/preferences/ChromePreferenceKeys.java

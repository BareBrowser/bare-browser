+
+/**
+ * The Incognito page of Privacy & security: the Incognito lock, how it unlocks, wiping after failed
+ * unlocks, and screenshots. These were the Incognito rows of Chromium's Privacy and security page
+ * and keep the same settings.
+ */
+@NullMarked
+public class BareIncognitoSettings extends ChromeBaseSettingsFragment {
+    public static final ChromeBaseSearchIndexProvider SEARCH_INDEX_DATA_PROVIDER =
+            new ChromeBaseSearchIndexProvider(
+                    BareIncognitoSettings.class.getName(), R.xml.bare_incognito_preferences);
+
+    private static final String PREF_INCOGNITO_LOCK = "incognito_lock";
+    private static final String PREF_BIOMETRIC_ONLY = "bare_incognito_biometric_only";
+    private static final String PREF_BLOCK_SCREENSHOTS = "bare_incognito_block_screenshots";
+    private static final String PREF_WIPE_AFTER = "bare_incognito_wipe_after";
+
+    private @Nullable IncognitoLockSettings mIncognitoLockSettings;
+    private final SettableMonotonicObservableSupplier<String> mPageTitle =
+            ObservableSuppliers.createMonotonic();
+
+    @Override
+    public void onCreatePreferences(@Nullable Bundle savedInstanceState, @Nullable String rootKey) {
+        mPageTitle.set(getString(R.string.bare_incognito_settings_title));
+        SettingsUtils.addPreferencesFromResource(this, R.xml.bare_incognito_preferences);
+
+        IncognitoReauthSettingSwitchPreference lock = findPreference(PREF_INCOGNITO_LOCK);
+        assert lock != null;
+        mIncognitoLockSettings = new IncognitoLockSettings(lock, getProfile());
+        mIncognitoLockSettings.setUpIncognitoReauthPreference(getActivity());
+
+        ChromeSwitchPreference biometricOnly = findPreference(PREF_BIOMETRIC_ONLY);
+        if (biometricOnly != null) {
+            biometricOnly.setChecked(BareIncognitoLockPolicy.isBiometricOnly());
+            biometricOnly.setOnPreferenceChangeListener(
+                    (preference, newValue) -> {
+                        BareIncognitoLockPolicy.setBiometricOnly((boolean) newValue);
+                        return true;
+                    });
+        }
+        ChromeSwitchPreference blockScreenshots = findPreference(PREF_BLOCK_SCREENSHOTS);
+        if (blockScreenshots != null) {
+            refreshBlockScreenshots(blockScreenshots);
+            blockScreenshots.setOnPreferenceChangeListener(
+                    (preference, newValue) -> {
+                        ChromeSharedPreferences.getInstance()
+                                .writeBoolean(
+                                        ChromePreferenceKeys.BARE_INCOGNITO_BLOCK_SCREENSHOTS,
+                                        (boolean) newValue);
+                        return true;
+                    });
+        }
+        ListPreference wipe = findPreference(PREF_WIPE_AFTER);
+        if (wipe != null) {
+            wipe.setValue(String.valueOf(BareIncognitoLockPolicy.getWipeAfter()));
+            wipe.setOnPreferenceChangeListener(
+                    (preference, newValue) -> {
+                        BareIncognitoLockPolicy.setWipeAfter(Integer.parseInt((String) newValue));
+                        return true;
+                    });
+        }
+    }
+
+    /**
+     * While the Incognito lock is on, screenshots are always blocked, so the switch shows on and
+     * can't be changed. The user's own choice is kept and shown again when the lock is off.
+     */
+    private void refreshBlockScreenshots(ChromeSwitchPreference blockScreenshots) {
+        // Allowed until the user turns it on, so the stored value is whether to block.
+        boolean stored =
+                ChromeSharedPreferences.getInstance()
+                        .readBoolean(ChromePreferenceKeys.BARE_INCOGNITO_BLOCK_SCREENSHOTS, false);
+        boolean locked = IncognitoReauthManager.isIncognitoReauthEnabled(getProfile());
+        blockScreenshots.setEnabled(!locked);
+        blockScreenshots.setChecked(locked || stored);
+        blockScreenshots.setSummary(
+                locked
+                        ? R.string.bare_incognito_block_screenshots_locked
+                        : R.string.bare_incognito_block_screenshots_summary);
+    }
+
+    @Override
+    public void onStart() {
+        super.onStart();
+        if (mIncognitoLockSettings != null) {
+            mIncognitoLockSettings.updateIncognitoReauthPreferenceIfNeeded(getActivity());
+        }
+    }
+
+    @Override
+    public void onResume() {
+        super.onResume();
+        // Back from the system's lock settings, the lock may have changed.
+        ChromeSwitchPreference blockScreenshots = findPreference(PREF_BLOCK_SCREENSHOTS);
+        if (blockScreenshots != null) refreshBlockScreenshots(blockScreenshots);
+    }
+
+    @Override
+    public void onDestroy() {
+        if (mIncognitoLockSettings != null) mIncognitoLockSettings.destroy();
+        super.onDestroy();
+    }
+
+    @Override
+    public MonotonicObservableSupplier<String> getPageTitle() {
+        return mPageTitle;
+    }
+
+    @Override
+    public @AnimationType int getAnimationType() {
+        return AnimationType.PROPERTY;
+    }
+
+    @Override
+    public @Nullable String getMainMenuKey() {
+        return "bare_incognito";
+    }
+}

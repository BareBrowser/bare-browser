@@ -0,0 +1,55 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.bare;
+
+import android.graphics.Color;
+
+import androidx.annotation.ColorInt;
+
+import org.chromium.base.ObserverList;
+import org.chromium.base.ThreadUtils;
+import org.chromium.build.annotations.NullMarked;
+
+/**
+ * How far pull to refresh has moved a tab's page down. SwipeRefreshHandler sets it while the user
+ * pulls and while the page reloads; the layout that draws the page reads it.
+ */
+@NullMarked
+public final class BarePullOffset {
+    /** Told when a tab's pull offset changes. */
+    public interface Observer {
+        void onPullOffsetChanged(int tabId, float offsetPx);
+    }
+
+    private static final ObserverList<Observer> sObservers = new ObserverList<>();
+    private static @ColorInt int sGapColor = Color.TRANSPARENT;
+
+    public static void set(int tabId, float offsetPx) {
+        ThreadUtils.assertOnUiThread();
+        for (Observer observer : sObservers) observer.onPullOffsetChanged(tabId, offsetPx);
+    }
+
+    public static void addObserver(Observer observer) {
+        ThreadUtils.assertOnUiThread();
+        sObservers.addObserver(observer);
+    }
+
+    public static void removeObserver(Observer observer) {
+        ThreadUtils.assertOnUiThread();
+        sObservers.removeObserver(observer);
+    }
+
+    /** Records the status bar colour, which the gap above a pulled page takes, to look joined. */
+    public static void setGapColor(@ColorInt int color) {
+        sGapColor = color;
+    }
+
+    /** The colour for the gap above a pulled page, or transparent if none is known yet. */
+    public static @ColorInt int getGapColor() {
+        return sGapColor;
+    }
+
+    private BarePullOffset() {}
+}

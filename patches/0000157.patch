+// Bare: picks a .crx with the system file picker and installs it through the
+// same installer, checks and confirmation as a dropped file.
+class DeveloperPrivateLoadCrxFunction : public DeveloperPrivateAPIFunction,
+                                        public ui::SelectFileDialog::Listener {
+ public:
+  DECLARE_EXTENSION_FUNCTION("developerPrivate.loadCrx",
+                             DEVELOPERPRIVATE_LOADCRX)
+  DeveloperPrivateLoadCrxFunction();
+
+  DeveloperPrivateLoadCrxFunction(const DeveloperPrivateLoadCrxFunction&) =
+      delete;
+  DeveloperPrivateLoadCrxFunction& operator=(
+      const DeveloperPrivateLoadCrxFunction&) = delete;
+
+  // ui::SelectFileDialog::Listener:
+  void FileSelected(const ui::SelectedFileInfo& file, int index) override;
+  void FileSelectionCanceled() override;
+
+ protected:
+  ~DeveloperPrivateLoadCrxFunction() override;
+
+  // DeveloperPrivateAPIFunction:
+  ResponseAction Run() override;
+
+ private:
+  struct Checked {
+    std::string error;
+    std::string crx_id;
+  };
+
+  // Reads and verifies the picked file off the UI thread.
+  static Checked CheckFile(const base::FilePath& path);
+
+  void OnChecked(const base::FilePath& path, Checked checked);
+  void OnInstalled(const std::optional<CrxInstallError>& error);
+
+  // Responds, and drops the reference taken in Run().
+  void Finish(ResponseValue response_value);
+
+  scoped_refptr<ui::SelectFileDialog> select_file_dialog_;
+};

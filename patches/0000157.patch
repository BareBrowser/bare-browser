+DeveloperPrivateLoadCrxFunction::DeveloperPrivateLoadCrxFunction() = default;
+
+DeveloperPrivateLoadCrxFunction::~DeveloperPrivateLoadCrxFunction() {
+  // There may be pending file dialogs. Tell them we've gone away so they don't
+  // call back to us.
+  if (select_file_dialog_.get()) {
+    select_file_dialog_->ListenerDestroyed();
+  }
+}
+
+ExtensionFunction::ResponseAction DeveloperPrivateLoadCrxFunction::Run() {
+  content::WebContents* web_contents = GetSenderWebContents();
+  if (!web_contents) {
+    return RespondNow(Error(kCouldNotFindWebContentsError));
+  }
+  Profile* profile = Profile::FromBrowserContext(browser_context());
+  if (profile && supervised_user::AreExtensionsPermissionsEnabled(profile)) {
+    return RespondNow(Error("Child account users cannot install extensions."));
+  }
+  if (ExtensionManagementFactory::GetForBrowserContext(browser_context())
+          ->BlocklistedByDefault()) {
+    return RespondNow(Error("Extension installation is blocked by policy."));
+  }
+
+  select_file_dialog_ = ui::SelectFileDialog::Create(
+      this, std::make_unique<ChromeSelectFilePolicy>(web_contents));
+  // Android has no type for .crx and lists every file whatever is asked for,
+  // so the contents are checked instead. Naming the extension still matters: it
+  // keeps the picker from offering the camera and asking for that permission.
+  // A plain open, not a writable one, so the picker grants one read rather than
+  // lasting access to the file.
+  select_file_dialog_->SetAcceptTypes({u".crx"});
+  // Before SelectFile(): on Android a picker that cannot open cancels from
+  // inside it, and the cancel responds and releases.
+  AddRef();  // Balanced in Finish().
+  ui::SelectFileDialog::FileTypeInfo file_type_info;
+  select_file_dialog_->SelectFile(
+      ui::SelectFileDialog::SELECT_OPEN_FILE,
+      /*title=*/std::u16string(),
+      base::FilePath(), &file_type_info, 0, base::FilePath::StringType(),
+      platform_util::GetTopLevel(web_contents->GetNativeView()));
+  return did_respond() ? AlreadyResponded() : RespondLater();
+}
+
+void DeveloperPrivateLoadCrxFunction::FileSelected(
+    const ui::SelectedFileInfo& file,
+    int index) {
+  select_file_dialog_.reset();
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&DeveloperPrivateLoadCrxFunction::CheckFile,
+                     file.path()),
+      base::BindOnce(&DeveloperPrivateLoadCrxFunction::OnChecked, this,
+                     file.path()));
+}
+
+void DeveloperPrivateLoadCrxFunction::FileSelectionCanceled() {
+  // Bare: on Android this can run inside the dialog's own SelectFile(), when
+  // a picker is already showing and the new one cannot open. Let the dialog go
+  // once that call has returned rather than destroying it under itself.
+  if (select_file_dialog_) {
+    select_file_dialog_->ListenerDestroyed();
+    base::SequencedTaskRunner::GetCurrentDefault()->ReleaseSoon(
+        FROM_HERE, std::move(select_file_dialog_));
+  }
+  Finish(NoArguments());
+}
+
+// static
+DeveloperPrivateLoadCrxFunction::Checked
+DeveloperPrivateLoadCrxFunction::CheckFile(const base::FilePath& path) {
+  // Larger than any extension Bare expects to see, and small enough that the
+  // installer's own copy of the file does not fill the disk.
+  constexpr int64_t kMaxCrxBytes = 256 * 1024 * 1024;
+  Checked checked;
+  base::File file(path, base::File::FLAG_OPEN | base::File::FLAG_READ);
+  if (!file.IsValid()) {
+    checked.error = "Bare could not read that file.";
+    return checked;
+  }
+  int64_t length = file.GetLength();
+  if (length < 0) {
+    checked.error = "Bare could not read that file.";
+    return checked;
+  }
+  if (length > kMaxCrxBytes) {
+    checked.error = "That file is too large to be an extension.";
+    return checked;
+  }
+  file.Close();
+  // The format and signature, as the installer will check them again. Doing it
+  // here gives a plain answer for a file that is not an extension at all, and
+  // the id the file would install under.
+  std::string public_key;
+  crx_file::VerifierResult result = crx_file::Verify(
+      path, crx_file::VerifierFormat::CRX3, {}, {}, &public_key,
+      &checked.crx_id, /*compressed_verified_contents=*/nullptr);
+  if (result != crx_file::VerifierResult::OK_FULL) {
+    checked.error =
+        "That file is not a packed extension, or it is damaged. Bare installs "
+        "signed .crx files only.";
+    checked.crx_id.clear();
+  }
+  return checked;
+}
+
+void DeveloperPrivateLoadCrxFunction::OnChecked(const base::FilePath& path,
+                                                Checked checked) {
+  if (!checked.error.empty()) {
+    Finish(WithArguments(checked.error));
+    return;
+  }
+  content::WebContents* web_contents = GetSenderWebContents();
+  if (!web_contents) {
+    Finish(Error(kCouldNotFindWebContentsError));
+    return;
+  }
+
+  // A file signed with the same key as the uBlock Origin Bare ships would
+  // otherwise replace it in place and keep Bare's provenance. It is the same
+  // author's key, but not the copy Bare checked, so decline and say how to do
+  // it deliberately.
+#if BUILDFLAG(IS_ANDROID)
+  const Extension* installed =
+      ExtensionRegistry::Get(browser_context())
+          ->GetInstalledExtension(checked.crx_id);
+  if (installed && IsProvisionedByBare(browser_context(), *installed)) {
+    Finish(WithArguments(base::StrCat(
+        {installed->name(),
+         " comes with Bare and keeps itself up to date. To install it from a "
+         "file instead, remove it first."})));
+    return;
+  }
+#endif  // BUILDFLAG(IS_ANDROID)
+
+  auto prompt = std::make_unique<ExtensionInstallPrompt>(
+      web_contents, std::make_unique<extensions::InstallPromptData>(
+                        extensions::InstallPromptData::UNSET_PROMPT_TYPE));
+  scoped_refptr<CrxInstaller> crx_installer =
+      CrxInstaller::Create(browser_context(), std::move(prompt));
+  crx_installer->set_error_on_unsupported_requirements(true);
+  crx_installer->set_off_store_install_allow_reason(
+      CrxInstaller::OffStoreInstallAllowedFromSettingsPage);
+  crx_installer->set_install_immediately(true);
+  crx_installer->AddInstallerCallback(
+      base::BindOnce(&DeveloperPrivateLoadCrxFunction::OnInstalled, this));
+  // The picked document itself, never deleted: the installer copies it into a
+  // temporary directory of its own before unpacking.
+  crx_installer->InstallCrx(path);
+}
+
+void DeveloperPrivateLoadCrxFunction::OnInstalled(
+    const std::optional<CrxInstallError>& error) {
+  if (!error || (error->type() == CrxInstallErrorType::OTHER &&
+                 (error->detail() == CrxInstallErrorDetail::USER_CANCELED ||
+                  error->detail() == CrxInstallErrorDetail::USER_ABORTED))) {
+    Finish(NoArguments());
+    return;
+  }
+  Finish(WithArguments(base::UTF16ToUTF8(error->message())));
+}
+
+void DeveloperPrivateLoadCrxFunction::Finish(ResponseValue response_value) {
+  Respond(std::move(response_value));
+  Release();  // Balanced in Run().
+}

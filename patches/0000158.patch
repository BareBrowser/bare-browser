diff --git a/chrome/browser/resources/extensions/item.css b/chrome/browser/resources/extensions/item.css
index b4d8faf687c..3083b2422f9 100644
--- a/chrome/browser/resources/extensions/item.css
+++ b/chrome/browser/resources/extensions/item.css
@@ -203,6 +203,16 @@ cr-tooltip-icon {
   margin-inline-start: 8px;
 }
 
+/* Bare: the card's Allow in Incognito switch, a row of its own above the
+   buttons, lined up with them and with the enable switch below it. */
+#incognito-row {
+  border-top: var(--cr-separator-line);
+  box-sizing: border-box;
+  gap: 12px;
+  min-height: var(--cr-section-min-height);
+  padding-inline: 20px;
+}
+
 #source-indicator {
   margin-inline-start: 24px;
   margin-top: 24px;
diff --git a/chrome/browser/resources/extensions/item.html.ts b/chrome/browser/resources/extensions/item.html.ts
index de143736336..411c6d028ae 100644
--- a/chrome/browser/resources/extensions/item.html.ts
+++ b/chrome/browser/resources/extensions/item.html.ts
@@ -156,6 +156,17 @@ export function getHtml(this: ItemElement) {
       </div>
     </div>
   </div>
+  ${this.showIncognitoToggle_() ? html`
+    <div id="incognito-row" class="layout-horizontal-center cr-secondary-text">
+      <span id="incognito-label" class="flex">$i18n{itemAllowIncognito}</span>
+      <cr-toggle id="incognitoToggle" aria-labelledby="incognito-label"
+          aria-describedby="a11yAssociation"
+          ?checked="${this.data.incognitoAccess.isActive}"
+          ?disabled="${this.isIncognitoToggleDisabled_()}"
+          @change="${this.onAllowIncognitoChange_}">
+      </cr-toggle>
+    </div>
+  ` : ''}
   <div id="button-strip" class="layout-horizontal-center cr-secondary-text">
     <div class="layout-horizontal-center flex">
       <cr-button id="detailsButton" @click="${this.onDetailsClick_}"
diff --git a/chrome/browser/resources/extensions/item.ts b/chrome/browser/resources/extensions/item.ts
index 055bedcb693..1eb014a030a 100644
--- a/chrome/browser/resources/extensions/item.ts
+++ b/chrome/browser/resources/extensions/item.ts
@@ -158,6 +158,7 @@ export class ExtensionsItemElement extends ExtensionsItemElementBase {
 
       // Whether or not dev mode is enabled.
       inDevMode: {type: Boolean},
+      incognitoAvailable: {type: Boolean},
       safetyCheckShowing: {type: Boolean},
 
       // The underlying ExtensionInfo itself. Public for use in declarative
@@ -174,6 +175,7 @@ export class ExtensionsItemElement extends ExtensionsItemElementBase {
 
   accessor delegate: ItemDelegate|null = null;
   accessor inDevMode: boolean = false;
+  accessor incognitoAvailable: boolean = false;
   accessor safetyCheckShowing: boolean = false;
   accessor data: chrome.developerPrivate.ExtensionInfo =
       createDummyExtensionInfo();
@@ -257,6 +259,27 @@ export class ExtensionsItemElement extends ExtensionsItemElementBase {
     this.$.enableToggle.checked = this.isEnabled_();
   }
 
+  // Bare: the same condition as the details page. Chromium decides which kinds
+  // of extension can run in Incognito, and a profile can have Incognito turned
+  // off altogether.
+  protected showIncognitoToggle_(): boolean {
+    return this.incognitoAvailable && this.data.incognitoAccess.isEnabled;
+  }
+
+  // Bare: an extension installed by policy can have the change held back until
+  // restart, which the details page explains; the card only shows the state.
+  protected isIncognitoToggleDisabled_(): boolean {
+    return !!this.data.controlledInfo;
+  }
+
+  protected onAllowIncognitoChange_(e: Event) {
+    assert(this.delegate);
+    const toggle = e.target as CrToggleElement;
+    this.delegate.setItemAllowedIncognito(this.data.id, toggle.checked);
+    // Show what Chromium reports; the change comes back as an update to data.
+    toggle.checked = this.data.incognitoAccess.isActive;
+  }
+
   protected onErrorsClick_() {
     if (this.data.installWarnings && this.data.installWarnings.length > 0) {
       this.fire('show-install-warnings', this.data.installWarnings);

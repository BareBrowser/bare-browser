From 928c1bcbf87a55ee4d9065fd253be55fe61d1a03 Mon Sep 17 00:00:00 2001
From: Bare <git@barebrowser.org>
Date: Mon, 12 Oct 2026 21:58:20 +0000
Subject: [PATCH] Let a light page keep its own canvas on a dark theme

With a dark theme and "Apply dark theme to sites" off, bbc.com showed a white
header over black content with near-black text. 0033 set the page base
colour to black for every tab created while the theme was dark, to stop a
white flash before a page paints. But the base colour is not only what shows
before a page paints: Blink also uses it as the canvas of any page that leaves
its own html and body backgrounds transparent, for as long as the page is
shown. BBC is such a page, and so is anything that declares no colour scheme
and no background. Their dark text sat on black. The colour was also never
reconsidered: a tab kept whatever it got when it was created, through any
later theme change.

Measured on a Pixel 3 with Dark selected and the checkbox off: BBC's html and
body are transparent and its headings are rgb(32, 34, 36) on the canvas; a test
page with no background showed dark text on black. Turning the checkbox on and
off did reach the page without a restart, but turning it off left that black
canvas behind, which looks as if the setting had not applied.

The base colour now follows the page's life instead. Each committed navigation
starts black on a dark theme, the default otherwise, read afresh every time,
and the first non-empty paint hands the canvas back to the page. After it, on
the same phone: BBC and the test page show dark text on white with the
checkbox off and are darkened with it on, both changing live in regular and
incognito tabs. A screen recording of a dark page loading another dark page
stayed black in every frame, and a page that stalls for a second and a half
before painting stayed dark until it painted.
---
 chrome/browser/android/tab_android.cc | 70 ++++++++++++++++++++++-----
 1 file changed, 57 insertions(+), 13 deletions(-)

diff --git a/chrome/browser/android/tab_android.cc b/chrome/browser/android/tab_android.cc
index 3eaeba43d02..ec97ad3f929 100644
--- a/chrome/browser/android/tab_android.cc
+++ b/chrome/browser/android/tab_android.cc
@@ -78,6 +78,7 @@
 #include "content/public/browser/devtools_agent_host.h"
 #include "content/public/browser/navigation_controller.h"
 #include "content/public/browser/navigation_entry.h"
+#include "content/public/browser/navigation_handle.h"
 #include "content/public/browser/render_frame_host.h"
 #include "content/public/browser/render_process_host.h"
 #include "content/public/browser/render_view_host.h"
@@ -117,6 +118,56 @@ BrowserWindowInterface* FindBrowserWindowInterface(SessionID window_id) {
   return nullptr;
 }
 
+// Bare: keeps the canvas dark between a navigation and the page's first paint
+// on a dark theme, and only then. The page base colour is not just what shows
+// before a page paints: Blink also uses it as the canvas of every page that
+// leaves its own background transparent, for as long as the page is shown.
+// Held black, it put such a light page's dark text on black even with "Apply
+// dark theme to sites" off. So each committed navigation starts black on a dark
+// theme, and the first non-empty paint hands the canvas back to the page.
+class PrePaintBackground
+    : public content::WebContentsObserver,
+      public content::WebContentsUserData<PrePaintBackground> {
+ public:
+  PrePaintBackground(const PrePaintBackground&) = delete;
+  PrePaintBackground& operator=(const PrePaintBackground&) = delete;
+  ~PrePaintBackground() override = default;
+
+  // Black on a dark theme, the default otherwise. Re-read at every navigation,
+  // so a theme change applies from the next page on.
+  void Apply() {
+    auto* theme =
+        night_mode::WebContentsThemeClient::FromWebContents(web_contents());
+    if (theme && theme->IsNightModeEnabled()) {
+      web_contents()->SetPageBaseBackgroundColor(SK_ColorBLACK);
+    } else {
+      web_contents()->SetPageBaseBackgroundColor(std::nullopt);
+    }
+  }
+
+ private:
+  explicit PrePaintBackground(content::WebContents* web_contents)
+      : content::WebContentsObserver(web_contents),
+        content::WebContentsUserData<PrePaintBackground>(*web_contents) {}
+  friend class content::WebContentsUserData<PrePaintBackground>;
+
+  // content::WebContentsObserver:
+  void DidFinishNavigation(content::NavigationHandle* handle) override {
+    if (handle->IsInPrimaryMainFrame() && handle->HasCommitted() &&
+        !handle->IsSameDocument()) {
+      Apply();
+    }
+  }
+
+  void DidFirstVisuallyNonEmptyPaint() override {
+    web_contents()->SetPageBaseBackgroundColor(std::nullopt);
+  }
+
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(PrePaintBackground);
+
 }  // namespace
 
 // static
@@ -399,19 +450,12 @@ void TabAndroid::InitWebContents(
 
   night_mode::WebContentsThemeClient::CreateForWebContents(web_contents_.get());
 
-  // De-Googled build: paint the pre-paint background black in night mode.
-  //
-  // Before a page paints its own background the renderer fills with its base colour, which
-  // defaults to white. On a dark theme that produces a white flash on every navigation, which
-  // is glaring on an OLED screen at night.
-  //
-  // The theme client created just above already answers whether night mode is on, so the colour
-  // follows the user theme rather than being forced. In light mode nothing is set and the
-  // default white is kept.
-  if (night_mode::WebContentsThemeClient::FromWebContents(web_contents_.get())
-          ->IsNightModeEnabled()) {
-    web_contents_->SetPageBaseBackgroundColor(SK_ColorBLACK);
-  }
+  // De-Googled build: keep the canvas dark until a page first paints, on a dark
+  // theme. Without it every navigation flashed white before the page appeared,
+  // glaring on an OLED screen at night. PrePaintBackground hands the canvas back
+  // to the page at its first paint.
+  PrePaintBackground::CreateForWebContents(web_contents_.get());
+  PrePaintBackground::FromWebContents(web_contents_.get())->Apply();
 
   renderer_preferences_util::UpdateFromSystemSettings(
       web_contents_->GetMutableRendererPrefs(),

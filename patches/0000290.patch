+
+package org.chromium.chrome.browser.task_manager.ui;
+
+import android.animation.Animator;
+import android.animation.AnimatorListenerAdapter;
+import android.animation.ValueAnimator;
+import android.content.Context;
+import android.graphics.Color;
+import android.graphics.Rect;
+import android.graphics.drawable.ColorDrawable;
+import android.graphics.drawable.Drawable;
+import android.graphics.drawable.GradientDrawable;
+import android.view.Gravity;
+import android.view.MotionEvent;
+import android.view.VelocityTracker;
+import android.view.View;
+import android.view.ViewConfiguration;
+import android.view.ViewGroup;
+import android.view.animation.Interpolator;
+import android.widget.FrameLayout;
+import android.widget.LinearLayout;
+import android.widget.PopupWindow;
+
+import androidx.annotation.ColorInt;
+
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.components.browser_ui.styles.SemanticColorUtils;
+import org.chromium.ui.interpolators.Interpolators;
+
+/**
+ * A card that comes up from behind the bottom toolbar, the way the three-dot menu does, in the
+ * toolbar's colour. It opens part way, can be dragged or scrolled up to nearly the full height and
+ * dragged down to close. The toolbar stays in front of it, undimmed.
+ */
+@NullMarked
+final class RiseSheet {
+    private static final float HEIGHT = 0.92f;
+    private static final float COMPACT_HIDDEN = 0.46f;
+    private static final long SETTLE_MS = 300;
+    private static final long CLOSE_MS = 220;
+    private static final float FLING_DP_PER_SECOND = 900f;
+    private static final float HANDLE_ZONE_DP = 28f;
+    private static final float CLOSE_DRAG_DP = 48f;
+    private static final float CORNER_DP = 24f;
+    private static final int SCRIM_COLOR = 0x66000000;
+
+    private final PopupWindow mPopup;
+    private final Frame mFrame;
+    private final View mScrim;
+    private final LinearLayout mCard;
+    private final View mScroll;
+    private final int mHeight;
+    private final int mCompactY;
+    private @Nullable ValueAnimator mAnimator;
+    private boolean mClosing;
+
+    /**
+     * Shows {@code content} as the card. {@code scroll} is the part of it that scrolls, so a drag
+     * on it moves the card only when it should.
+     */
+    static void show(View root, View content, View scroll) {
+        Context context = root.getContext();
+        Rect frame = new Rect();
+        root.getWindowVisibleDisplayFrame(frame);
+        int bottom = toolbarTop(root, frame.bottom);
+        int windowHeight = Math.max(1, bottom - frame.top);
+        RiseSheet sheet =
+                new RiseSheet(
+                        context,
+                        content,
+                        scroll,
+                        Math.round(windowHeight * HEIGHT),
+                        toolbarColor(root, context),
+                        frame.width(),
+                        windowHeight);
+        sheet.mPopup.showAtLocation(root, Gravity.NO_GRAVITY, frame.left, frame.top);
+        sheet.mFrame.post(
+                () ->
+                        sheet.animateTo(
+                                sheet.mCompactY,
+                                SETTLE_MS,
+                                Interpolators.EMPHASIZED_DECELERATE,
+                                null));
+    }
+
+    private RiseSheet(
+            Context context,
+            View content,
+            View scroll,
+            int height,
+            @ColorInt int color,
+            int width,
+            int windowHeight) {
+        mHeight = height;
+        mCompactY = Math.round(height * COMPACT_HIDDEN);
+        mScroll = scroll;
+        float density = context.getResources().getDisplayMetrics().density;
+
+        mCard = new LinearLayout(context);
+        mCard.setOrientation(LinearLayout.VERTICAL);
+        float corner = CORNER_DP * density;
+        GradientDrawable shape = new GradientDrawable();
+        shape.setColor(color);
+        shape.setCornerRadii(new float[] {corner, corner, corner, corner, 0, 0, 0, 0});
+        mCard.setBackground(shape);
+        GradientDrawable bar = new GradientDrawable();
+        bar.setCornerRadius(2 * density);
+        bar.setColor(SemanticColorUtils.getDefaultIconColor(context));
+        bar.setAlpha(110);
+        View handle = new View(context);
+        handle.setBackground(bar);
+        handle.setImportantForAccessibility(View.IMPORTANT_FOR_ACCESSIBILITY_NO);
+        LinearLayout.LayoutParams handleParams =
+                new LinearLayout.LayoutParams(Math.round(38 * density), Math.round(4 * density));
+        handleParams.gravity = Gravity.CENTER_HORIZONTAL;
+        handleParams.topMargin = Math.round(10 * density);
+        handleParams.bottomMargin = Math.round(10 * density);
+        mCard.addView(handle, handleParams);
+        mCard.addView(
+                content,
+                new LinearLayout.LayoutParams(
+                        ViewGroup.LayoutParams.MATCH_PARENT, 0, 1f));
+
+        mFrame = new Frame(context);
+        mScrim = new View(context);
+        mScrim.setBackgroundColor(SCRIM_COLOR);
+        mScrim.setAlpha(0f);
+        mFrame.addView(
+                mScrim,
+                new FrameLayout.LayoutParams(
+                        ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT));
+        mFrame.addView(
+                mCard,
+                new FrameLayout.LayoutParams(
+                        ViewGroup.LayoutParams.MATCH_PARENT, height, Gravity.BOTTOM));
+        moveTo(height);
+
+        mPopup = new PopupWindow(mFrame, width, windowHeight);
+        mPopup.setBackgroundDrawable(new ColorDrawable(Color.TRANSPARENT));
+        mPopup.setFocusable(true);
+        mPopup.setOutsideTouchable(true);
+        mPopup.setAnimationStyle(0);
+        mPopup.setClippingEnabled(false);
+    }
+
+    /** The screen y of the top of the bottom toolbar, else {@code fallback}. */
+    private static int toolbarTop(View root, int fallback) {
+        int[] at = new int[2];
+        View address = find(root, "control_container");
+        if (address != null && address.isShown() && address.getHeight() > 0) {
+            address.getLocationOnScreen(at);
+            if (at[1] > root.getHeight() / 2) return at[1];
+        }
+        View row = find(root, "bottom_app_bar_container");
+        if (row != null && row.isShown() && row.getHeight() > 0) {
+            View slot = find(row, "bottom_container_slot");
+            View edge = slot != null && slot.isShown() && slot.getHeight() > 0 ? slot : row;
+            edge.getLocationOnScreen(at);
+            return at[1];
+        }
+        return fallback;
+    }
+
+    private static @ColorInt int toolbarColor(View root, Context context) {
+        View address = find(root, "control_container");
+        View bar = address != null && address.isShown() ? address : null;
+        int[] at = new int[2];
+        if (bar != null) {
+            bar.getLocationOnScreen(at);
+            if (at[1] <= root.getHeight() / 2) bar = null;
+        }
+        if (bar == null) bar = find(root, "bottom_app_bar_container");
+        Integer color = bar == null ? null : plainColor(bar, 3);
+        return color != null ? color : SemanticColorUtils.getColorSurfaceContainerHigh(context);
+    }
+
+    private static @Nullable Integer plainColor(View view, int depth) {
+        Drawable background = view.getBackground();
+        if (view.getVisibility() == View.VISIBLE
+                && background instanceof ColorDrawable plain
+                && Color.alpha(plain.getColor()) == 255) {
+            return plain.getColor();
+        }
+        if (depth == 0 || !(view instanceof ViewGroup group)) return null;
+        for (int i = 0; i < group.getChildCount(); i++) {
+            Integer color = plainColor(group.getChildAt(i), depth - 1);
+            if (color != null) return color;
+        }
+        return null;
+    }
+
+    private static @Nullable View find(View root, String name) {
+        int id = root.getResources().getIdentifier(name, "id", root.getContext().getPackageName());
+        return id == 0 ? null : root.findViewById(id);
+    }
+
+    /** Puts the card at {@code y} below its top position and dims the page to match. */
+    private void moveTo(float y) {
+        mCard.setTranslationY(y);
+        float shown = (mHeight - y) / Math.max(1f, mHeight - mCompactY);
+        mScrim.setAlpha(Math.max(0f, Math.min(1f, shown)));
+    }
+
+    private void animateTo(
+            float y, long duration, Interpolator interpolator, @Nullable Runnable after) {
+        stop();
+        ValueAnimator animator = ValueAnimator.ofFloat(mCard.getTranslationY(), y);
+        animator.setDuration(duration);
+        animator.setInterpolator(interpolator);
+        animator.addUpdateListener(a -> moveTo((float) a.getAnimatedValue()));
+        if (after != null) {
+            animator.addListener(
+                    new AnimatorListenerAdapter() {
+                        @Override
+                        public void onAnimationEnd(Animator animation) {
+                            after.run();
+                        }
+                    });
+        }
+        mAnimator = animator;
+        animator.start();
+    }
+
+    private void stop() {
+        if (mAnimator != null) mAnimator.cancel();
+        mAnimator = null;
+    }
+
+    private void close() {
+        if (mClosing) return;
+        mClosing = true;
+        animateTo(mHeight, CLOSE_MS, Interpolators.EMPHASIZED_ACCELERATE, mPopup::dismiss);
+    }
+
+    /** Down closes from half or full height, up opens all the way, a small drag puts it back. */
+    private void release(float startY, float velocity) {
+        float y = mCard.getTranslationY();
+        float density = mFrame.getResources().getDisplayMetrics().density;
+        float fling = FLING_DP_PER_SECOND * density;
+        float moved = y - startY;
+        if (velocity > fling || (velocity >= -fling && moved > CLOSE_DRAG_DP * density)) {
+            close();
+        } else if (velocity < -fling || moved < -CLOSE_DRAG_DP * density) {
+            animateTo(0, SETTLE_MS, Interpolators.EMPHASIZED_DECELERATE, null);
+        } else {
+            animateTo(
+                    startY < mCompactY / 2f ? 0 : mCompactY,
+                    SETTLE_MS,
+                    Interpolators.EMPHASIZED_DECELERATE,
+                    null);
+        }
+    }
+
+    /**
+     * Takes a gesture from the list when it should move the card: up while the card is half open,
+     * down while the list is at its top, and any drag on the handle. A tap above the card closes
+     * it.
+     */
+    private final class Frame extends FrameLayout {
+        private final int mSlop;
+        private float mDownY;
+        private float mStartY;
+        private boolean mDragging;
+        private boolean mAbove;
+        private @Nullable VelocityTracker mVelocity;
+
+        Frame(Context context) {
+            super(context);
+            mSlop = ViewConfiguration.get(context).getScaledTouchSlop();
+        }
+
+        private float cardTop() {
+            return mCard.getTop() + mCard.getTranslationY();
+        }
+
+        @Override
+        public boolean onInterceptTouchEvent(MotionEvent event) {
+            if (mClosing) return true;
+            track(event);
+            switch (event.getActionMasked()) {
+                case MotionEvent.ACTION_DOWN:
+                    stop();
+                    mDownY = event.getY();
+                    mStartY = mCard.getTranslationY();
+                    mDragging = false;
+                    mAbove = mDownY < cardTop();
+                    float zone = HANDLE_ZONE_DP * getResources().getDisplayMetrics().density;
+                    boolean onHandle = !mAbove && mDownY < cardTop() + zone;
+                    return mAbove || onHandle;
+                case MotionEvent.ACTION_MOVE:
+                    float dy = event.getY() - mDownY;
+                    if (Math.abs(dy) <= mSlop) return false;
+                    boolean halfOpen = mStartY > 1;
+                    boolean listAtTop = !mScroll.canScrollVertically(-1);
+                    if ((halfOpen && dy < 0) || (dy > 0 && listAtTop)) {
+                        mDragging = true;
+                        mDownY = event.getY();
+                        mStartY = mCard.getTranslationY();
+                        return true;
+                    }
+                    return false;
+                default:
+                    return false;
+            }
+        }
+
+        @Override
+        public boolean onTouchEvent(MotionEvent event) {
+            if (mClosing) return true;
+            track(event);
+            switch (event.getActionMasked()) {
+                case MotionEvent.ACTION_MOVE:
+                    float dy = event.getY() - mDownY;
+                    if (!mDragging && !mAbove && Math.abs(dy) > mSlop) {
+                        mDragging = true;
+                        mDownY = event.getY();
+                        dy = 0;
+                    }
+                    if (mDragging) moveTo(Math.max(0, Math.min(mHeight, mStartY + dy)));
+                    return true;
+                case MotionEvent.ACTION_UP:
+                    if (mDragging) {
+                        float velocity = 0;
+                        if (mVelocity != null) {
+                            mVelocity.computeCurrentVelocity(1000);
+                            velocity = mVelocity.getYVelocity();
+                        }
+                        release(mStartY, velocity);
+                    } else if (mAbove) {
+                        close();
+                    }
+                    clearVelocity();
+                    return true;
+                case MotionEvent.ACTION_CANCEL:
+                    if (mDragging) release(mStartY, 0);
+                    clearVelocity();
+                    return true;
+                default:
+                    return true;
+            }
+        }
+
+        private void track(MotionEvent event) {
+            if (event.getActionMasked() == MotionEvent.ACTION_DOWN) clearVelocity();
+            if (mVelocity == null) mVelocity = VelocityTracker.obtain();
+            mVelocity.addMovement(event);
+        }
+
+        private void clearVelocity() {
+            if (mVelocity != null) {
+                mVelocity.recycle();
+                mVelocity = null;
+            }
+        }
+    }
+}

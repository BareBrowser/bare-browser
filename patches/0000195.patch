+import android.view.ViewGroup;
+import android.widget.TextView;
+
+import androidx.test.core.app.ApplicationProvider;
+
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.robolectric.annotation.Config;
+
+import org.chromium.base.test.BaseRobolectricTestRunner;
+import org.chromium.chrome.R;
+
+/** Tests for what the welcome's Page translation page shows. */
+@RunWith(BaseRobolectricTestRunner.class)
+@Config(qualifiers = "w360dp-h640dp")
+public class BareWelcomeTranslatePageUnitTest {
+    private final Context mContext =
+            new ContextThemeWrapper(
+                    ApplicationProvider.getApplicationContext(), R.style.Theme_BrowserUI_DayNight);
+
+    private View inflate() {
+        View page =
+                LayoutInflater.from(mContext)
+                        .inflate(R.layout.bare_welcome_page_translate, new android.widget.FrameLayout(mContext), false);
+        int width = View.MeasureSpec.makeMeasureSpec(1080, View.MeasureSpec.EXACTLY);
+        int height = View.MeasureSpec.makeMeasureSpec(1920, View.MeasureSpec.EXACTLY);
+        page.measure(width, height);
+        page.layout(0, 0, 1080, 1920);
+        return page;
+    }
+
+    private static String text(View page, int id) {
+        TextView view = page.findViewById(id);
+        assertNotNull(view);
+        return view.getText().toString();
+    }
+
+    @Test
+    public void testThePageShowsTheTitleIntroAndTheOneRow() {
+        View page = inflate();
+        assertEquals("Page translation", text(page, R.id.bare_page_title));
+        View row = page.findViewById(R.id.bare_row_translate);
+        assertNotNull("the page has no switch row", row);
+        assertNotNull(row.findViewById(R.id.bare_option_label));
+        assertNotNull(row.findViewById(R.id.bare_option_hint));
+        assertNotNull(row.findViewById(R.id.bare_option_switch));
+        assertNotNull(row.findViewById(R.id.bare_option_icon));
+    }
+
+    @Test
+    public void testTheRowIsNamedAndSaysItIsOffUnlessTurnedOn() {
+        assertEquals("Translate pages with Google", mContext.getString(R.string.bare_welcome_opt_translate));
+        assertEquals("Off unless you turn it on", mContext.getString(R.string.bare_welcome_hint_translate));
+    }
+
+    @Test
+    public void testThePageSaysWhereTranslateAppearsAndThatTheShortcutIsKept() {
+        View page = inflate();
+        String where = text(page, R.id.bare_translate_where);
+        assertTrue(where.contains("adds Translate to the menu"));
+        assertTrue(where.contains("Settings, Appearance, Address bar shortcut"));
+        assertTrue(where.contains("does not change the shortcut you already chose"));
+    }
+
+    @Test
+    public void testThePrivacyWordingIsAccurate() {
+        View page = inflate();
+        String intro = mContext.getString(R.string.bare_welcome_translate_intro);
+        assertTrue(intro.contains("only happens when you tap Translate"));
+        String note = text(page, R.id.bare_translate_note);
+        assertTrue(note.contains("sent to Google, and Google can see it"));
+        assertTrue(note.contains("Other tabs are not sent"));
+        assertTrue(note.contains("IP address"));
+        assertTrue(note.contains("may get other details about the page"));
+        assertTrue(note.contains("may stop working"));
+        assertTrue(note.contains("Settings, Translate pages"));
+        // Nothing here claims the page is hidden from Google or that nothing else is sent.
+        String all = intro + where(page) + note;
+        for (String claim : new String[] {"private", "hidden", "sandbox", "anonymous", "nothing else"}) {
+            assertFalse("claims " + claim, all.toLowerCase(java.util.Locale.ROOT).contains(claim));
+        }
+    }
+
+    private static String where(View page) {
+        return text(page, R.id.bare_translate_where);
+    }
+
+    @Test
+    public void testThePageIsLaidOutTopToBottomWithinTheWidth() {
+        View page = inflate();
+        // The page scrolls, so its content is one column: title, intro, the row, then the two notes.
+        ViewGroup column = (ViewGroup) ((ViewGroup) page).getChildAt(0);
+        int previousBottom = -1;
+        for (int i = 0; i < column.getChildCount(); i++) {
+            View child = column.getChildAt(i);
+            assertTrue("child " + i + " is outside the width", child.getRight() <= 1080);
+            assertTrue("child " + i + " overlaps the one above it", child.getTop() >= previousBottom);
+            previousBottom = child.getBottom();
+        }
+        assertEquals(5, column.getChildCount());
+    }
+}

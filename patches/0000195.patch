+
+import java.util.HashMap;
+import java.util.Map;
+
+/** Tests for the Translate pages screen in Settings. */
+@RunWith(BaseRobolectricTestRunner.class)
+public class BareTranslateSettingsScreenUnitTest {
+    private final Context mContext =
+            new ContextThemeWrapper(
+                    ApplicationProvider.getApplicationContext(), R.style.Theme_BrowserUI_DayNight);
+
+    @Before
+    public void setUp() {
+        ChromeSharedPreferences.getInstance().removeKey(ChromePreferenceKeys.BARE_PAGE_TRANSLATION);
+    }
+
+    @After
+    public void tearDown() {
+        ChromeSharedPreferences.getInstance().removeKey(ChromePreferenceKeys.BARE_PAGE_TRANSLATION);
+    }
+
+    private ChromeSwitchPreference inflateSwitch() {
+        PreferenceScreen screen =
+                new PreferenceManager(mContext)
+                        .inflateFromResource(mContext, R.xml.bare_translate_preferences, null);
+        ChromeSwitchPreference preference = screen.findPreference("bare_translate_enabled");
+        assertNotNull("the screen has no Page translation switch", preference);
+        return preference;
+    }
+
+    @Test
+    public void testTheScreenHasOneSwitchAndThePrivacyText() {
+        PreferenceScreen screen =
+                new PreferenceManager(mContext)
+                        .inflateFromResource(mContext, R.xml.bare_translate_preferences, null);
+        assertEquals(2, screen.getPreferenceCount());
+        String about = screen.findPreference("bare_translate_about").getSummary().toString();
+        assertTrue(about.contains("only happens when you tap Translate"));
+        assertTrue(about.contains("sent to Google"));
+        assertTrue(about.contains("Other tabs are not sent"));
+        assertTrue(about.contains("may stop working"));
+        // No custom server fields: that route is not offered.
+        assertEquals(null, screen.findPreference("bare_translate_server"));
+        assertEquals(null, screen.findPreference("bare_translate_key"));
+    }
+
+    @Test
+    public void testTheSwitchSaysWhereTranslateAppearsAndThatTheShortcutIsKept() {
+        ChromeSwitchPreference preference = inflateSwitch();
+        assertEquals("Translate pages with Google", preference.getTitle().toString());
+        String summary = preference.getSummary().toString();
+        assertTrue(summary.contains("menu"));
+        assertTrue(summary.contains("Appearance, Address bar shortcut"));
+        assertTrue(summary.contains("Your shortcut is not changed"));
+        assertTrue(summary.contains("Off by default"));
+        assertFalse(preference.isPersistent());
+    }
+
+    @Test
+    public void testTheSwitchStartsOffAndShowsAStoredChoice() {
+        ChromeSwitchPreference preference = inflateSwitch();
+        BareTranslateSettingsFragment.bindSwitch(preference);
+        assertFalse(preference.isChecked());
+
+        BarePageTranslation.setEnabled(true);
+        ChromeSwitchPreference second = inflateSwitch();
+        BareTranslateSettingsFragment.bindSwitch(second);
+        assertTrue(second.isChecked());
+    }
+
+    @Test
+    public void testChangingTheSwitchStoresTheChoice() {
+        ChromeSwitchPreference preference = inflateSwitch();
+        BareTranslateSettingsFragment.bindSwitch(preference);
+
+        assertTrue(preference.getOnPreferenceChangeListener().onPreferenceChange(preference, true));
+        assertTrue(BarePageTranslation.isEnabled());
+        assertTrue(preference.getOnPreferenceChangeListener().onPreferenceChange(preference, false));
+        assertFalse(BarePageTranslation.isEnabled());
+    }
+
+    @Test
+    public void testTurningItOnChangesNothingButItself() {
+        SharedPreferences prefs = ContextUtils.getAppSharedPreferences();
+        Map<String, ?> before = new HashMap<>(prefs.getAll());
+        ChromeSwitchPreference preference = inflateSwitch();
+        BareTranslateSettingsFragment.bindSwitch(preference);
+        preference.getOnPreferenceChangeListener().onPreferenceChange(preference, true);
+
+        Map<String, Object> after = new HashMap<>(prefs.getAll());
+        for (String key : before.keySet()) {
+            assertEquals("changed " + key, before.get(key), after.get(key));
+        }
+        after.keySet().removeAll(before.keySet());
+        // Only the choice itself was added; the address bar shortcut was not touched.
+        assertEquals(1, after.size());
+        assertTrue(after.containsKey(ChromePreferenceKeys.BARE_PAGE_TRANSLATION));
+    }
+
+    @Test
+    public void testSettingsListsTheScreen() {
+        assertTrue(mainSettingsContains("bare_translate", BareTranslateSettingsFragment.class.getName()));
+    }
+
+    private boolean mainSettingsContains(String key, String fragment) {
+        try (XmlResourceParser parser = mContext.getResources().getXml(R.xml.main_preferences)) {
+            int event = parser.getEventType();
+            while (event != XmlPullParser.END_DOCUMENT) {
+                if (event == XmlPullParser.START_TAG) {
+                    String foundKey = null;
+                    String foundFragment = null;
+                    for (int i = 0; i < parser.getAttributeCount(); i++) {
+                        String name = parser.getAttributeName(i);
+                        if ("key".equals(name)) foundKey = parser.getAttributeValue(i);
+                        if ("fragment".equals(name)) foundFragment = parser.getAttributeValue(i);
+                    }
+                    if (key.equals(foundKey) && fragment.equals(foundFragment)) return true;
+                }
+                event = parser.next();
+            }
+        } catch (Exception e) {
+            throw new AssertionError("could not read the main settings screen", e);
+        }
+        return false;
+    }
+}

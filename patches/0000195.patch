+package org.chromium.chrome.browser.bare;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+
+import org.junit.After;
+import org.junit.Before;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+
+import org.chromium.base.test.BaseRobolectricTestRunner;
+import org.chromium.chrome.browser.preferences.ChromePreferenceKeys;
+import org.chromium.chrome.browser.preferences.ChromeSharedPreferences;
+
+/** Tests for the page translation choice and the welcome page that sets it. */
+@RunWith(BaseRobolectricTestRunner.class)
+public class BarePageTranslationUnitTest {
+    @Before
+    public void setUp() {
+        reset();
+    }
+
+    @After
+    public void tearDown() {
+        reset();
+    }
+
+    private static void reset() {
+        ChromeSharedPreferences.getInstance().removeKey(ChromePreferenceKeys.BARE_PAGE_TRANSLATION);
+    }
+
+    private static boolean stored() {
+        return ChromeSharedPreferences.getInstance()
+                .readBoolean(ChromePreferenceKeys.BARE_PAGE_TRANSLATION, false);
+    }
+
+    @Test
+    public void testItIsOffUntilTheUserTurnsItOn() {
+        assertFalse(BarePageTranslation.isEnabled());
+        assertFalse(stored());
+    }
+
+    @Test
+    public void testTheChoiceIsKept() {
+        BarePageTranslation.setEnabled(true);
+        assertTrue(BarePageTranslation.isEnabled());
+        assertTrue(stored());
+        BarePageTranslation.setEnabled(false);
+        assertFalse(BarePageTranslation.isEnabled());
+    }
+
+    @Test
+    public void testTheWelcomeOpensWithItOff() {
+        assertFalse(BareWelcomeOverlay.currentChoices(false).pageTranslation);
+        assertFalse(BareWelcomeOverlay.currentChoices(true).pageTranslation);
+    }
+
+    @Test
+    public void testAReviewShowsTheChoiceAlreadyMade() {
+        BarePageTranslation.setEnabled(true);
+        assertTrue(BareWelcomeOverlay.currentChoices(true).pageTranslation);
+    }
+
+    @Test
+    public void testAFirstShowingWritesWhatWasChosen() {
+        BareWelcomeOverlay.Choices choices = BareWelcomeOverlay.currentChoices(false);
+        BareWelcomeOverlay.applyChoices(choices);
+        assertFalse(stored());
+
+        choices.pageTranslation = true;
+        choices.pageTranslationTouched = true;
+        BareWelcomeOverlay.applyChoices(choices);
+        assertTrue(stored());
+    }
+
+    @Test
+    public void testAReviewLeavesAnUntouchedChoiceAlone() {
+        BarePageTranslation.setEnabled(true);
+        BareWelcomeOverlay.Choices choices = BareWelcomeOverlay.currentChoices(true);
+        choices.pageTranslation = false;
+        BareWelcomeOverlay.applyChoices(choices);
+        assertTrue(stored());
+    }
+
+    @Test
+    public void testAReviewCanTurnItOff() {
+        BarePageTranslation.setEnabled(true);
+        BareWelcomeOverlay.Choices choices = BareWelcomeOverlay.currentChoices(true);
+        choices.pageTranslation = false;
+        choices.pageTranslationTouched = true;
+        BareWelcomeOverlay.applyChoices(choices);
+        assertEquals(false, stored());
+    }
+}

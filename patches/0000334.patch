+std::vector<uint8_t> StoreKey(const KdfParams& kdf, const Key& key) {
+  std::vector<uint8_t> out;
+  out.reserve(kStoredKeySize);
+  out.push_back(kdf.log2_n);
+  out.insert(out.end(), kdf.salt.begin(), kdf.salt.end());
+  out.insert(out.end(), key.bytes().begin(), key.bytes().end());
+  return out;
+}
+
+std::optional<StoredKey> LoadStoredKey(base::span<const uint8_t> stored) {
+  if (stored.size() != kStoredKeySize) {
+    return std::nullopt;
+  }
+  StoredKey out;
+  out.kdf.log2_n = stored[0];
+  base::span(out.kdf.salt).copy_from(stored.subspan(1u).first<kSaltSize>());
+  base::span(out.key.bytes_).copy_from(
+      stored.subspan(1u + kSaltSize).first<kKeySize>());
+  if (!KdfParamsInRange(out.kdf)) {
+    return std::nullopt;
+  }
+  return out;
+}

+package org.chromium.chrome.browser.bare.backup;
+
+import android.app.Activity;
+import android.content.Context;
+import android.content.SharedPreferences;
+import android.net.Uri;
+import android.os.Handler;
+import android.os.Looper;
+import android.os.PowerManager;
+import android.view.View;
+
+import androidx.annotation.StringRes;
+
+import org.chromium.base.ActivityState;
+import org.chromium.base.ApplicationState;
+import org.chromium.base.ApplicationStatus;
+import org.chromium.base.Callback;
+import org.chromium.base.ContextUtils;
+import org.chromium.base.Log;
+import org.chromium.base.library_loader.LibraryLoader;
+import org.chromium.base.task.PostTask;
+import org.chromium.base.task.TaskTraits;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.chrome.R;
+import org.chromium.chrome.browser.profiles.Profile;
+import org.chromium.chrome.browser.profiles.ProfileManager;
+import org.chromium.components.browser_ui.widget.RiseSheet;
+
+import java.lang.ref.WeakReference;
+import java.util.Arrays;
+import java.util.Calendar;
+
+/**
+ * Automatic backups. Nothing is scheduled with Android: when a backup is due, Bare writes it as
+ * the user leaves the app, or a little after it comes back to the front if that didn't happen.
+ * When Bare isn't used, nothing runs, and nothing has changed that would need backing up.
+ *
+ * <p>A run builds the full backup with the key kept on the phone, writes it beside the last one
+ * under a temporary name, reads it back and opens it, and only then swaps it in. A run that fails
+ * or is cut short leaves the last good file as it was.
+ */
+public final class BareAutoBackup {
+    private static final String TAG = "BareAutoBackup";
+
+    static final String PREFS_FILE = "bare_backup_rule";
+    static final String KEY_RULE = "rule";
+    static final String KEY_FOLDER = "folder_uri";
+    static final String KEY_FOLDER_LABEL = "folder_label";
+    static final String KEY_KEEP = "keep";
+    static final String KEY_KEY = "key_blob";
+    static final String KEY_SECRET_KIND = "secret_kind";
+    static final String KEY_LAST_SUCCESS = "last_success_ms";
+    static final String KEY_LAST_ATTEMPT = "last_attempt_ms";
+    static final String KEY_LAST_ERROR = "last_error";
+    static final String KEY_FAILURE_EPOCH = "failure_epoch";
+    static final String KEY_CARD_EPOCH = "card_shown_epoch";
+    static final String KEY_IN_PROGRESS = "in_progress_ms";
+    static final String KEY_LAST_FILE = "last_file";
+    static final String KEY_LAST_SIZE = "last_size";
+    static final String KEY_SCHEMA = "schema";
+
+    static final int RULE_MANUAL = 0;
+    static final int RULE_DAILY = 1;
+    static final int RULE_WEEKLY = 2;
+    static final int RULE_MONTHLY = 3;
+
+    static final String ERROR_NONE = "none";
+    static final String ERROR_FOLDER_GONE = "folder_gone";
+    static final String ERROR_PERMISSION_LOST = "permission_lost";
+    static final String ERROR_STORAGE_FULL = "storage_full";
+    static final String ERROR_WRITE_FAILED = "write_failed";
+    static final String ERROR_BUILD_FAILED = "build_failed";
+    static final String ERROR_KEY_LOST = "key_lost";
+    /** Not stored: a run asked for while one is under way. */
+    static final String ERROR_BUSY = "busy";
+
+    private static final String FIXED_NAME = "Bare backup.bare";
+    private static final String TEMP_NAME = "Bare backup.bare.tmp";
+    private static final String OLD_SUFFIX = ".old";
+    private static final long RETRY_AFTER_FAILURE_MS = 60 * 60 * 1000;
+    private static final long STALE_RUN_MS = 15 * 60 * 1000;
+    private static final long OPEN_RUN_DELAY_MS = 20_000;
+    private static final long OPEN_CARD_DELAY_MS = 3_000;
+    private static final long WAKE_LOCK_MS = 2 * 60 * 1000;
+    private static final long SPACE_MARGIN = 8 * 1024 * 1024;
+    private static final int MAX_FILE_BYTES = 80 * 1024 * 1024;
+
+    private static final Handler sHandler = new Handler(Looper.getMainLooper());
+    private static final Runnable sOpenRun = BareAutoBackup::runIfDue;
+    private static final Runnable sOpenCard = BareAutoBackup::showCardIfDue;
+    private static boolean sAttached;
+    private static boolean sRunning;
+    private static WeakReference<Activity> sActivity = new WeakReference<>(null);
+
+    private BareAutoBackup() {}
+
+    static SharedPreferences prefs() {
+        return ContextUtils.getApplicationContext()
+                .getSharedPreferences(PREFS_FILE, Context.MODE_PRIVATE);
+    }
+
+    /**
+     * Starts watching for the user leaving Bare and coming back. Called for each new browser
+     * window; does the registration once.
+     */
+    public static void attach(Activity activity) {
+        sActivity = new WeakReference<>(activity);
+        if (!sAttached) {
+            sAttached = true;
+            ApplicationStatus.registerApplicationStateListener(
+                    state -> {
+                        if (state == ApplicationState.HAS_STOPPED_ACTIVITIES) {
+                            sHandler.removeCallbacks(sOpenRun);
+                            sHandler.removeCallbacks(sOpenCard);
+                            runIfDue();
+                        } else if (state == ApplicationState.HAS_RUNNING_ACTIVITIES) {
+                            onFront();
+                        }
+                    });
+        }
+        onFront();
+    }
+
+    private static void onFront() {
+        sHandler.removeCallbacks(sOpenRun);
+        sHandler.removeCallbacks(sOpenCard);
+        sHandler.postDelayed(sOpenCard, OPEN_CARD_DELAY_MS);
+        sHandler.postDelayed(sOpenRun, OPEN_RUN_DELAY_MS);
+    }
+
+    // ---------------------------------------------------------------------------------------
+    // State the pages read and change.
+
+    static int rule() {
+        return prefs().getInt(KEY_RULE, RULE_MANUAL);
+    }
+
+    /** Whether automatic backups are on: a schedule, a kept key and a folder. */
+    static boolean isOn() {
+        SharedPreferences prefs = prefs();
+        return prefs.getInt(KEY_RULE, RULE_MANUAL) != RULE_MANUAL
+                && prefs.contains(KEY_KEY)
+                && prefs.contains(KEY_FOLDER);
+    }
+
+    static String lastError() {
+        return prefs().getString(KEY_LAST_ERROR, ERROR_NONE);
+    }
+
+    /** Switches between Daily, Weekly and Monthly while backups are on. */
+    static void setRule(int rule) {
+        if (rule == RULE_MANUAL) {
+            turnOff();
+            return;
+        }
+        prefs().edit().putInt(KEY_RULE, rule).apply();
+    }
+
+    static int keep() {
+        int keep = prefs().getInt(KEY_KEEP, 1);
+        return keep == 3 || keep == 5 ? keep : 1;
+    }
+
+    static void setKeep(int keep) {
+        prefs().edit().putInt(KEY_KEEP, keep).apply();
+    }
+
+    /**
+     * Turns backups on, or replaces the key or folder of backups already on. {@code wrappedKey}
+     * comes from {@link BareBackupKeyStore#wrap}. The first backup is due at once.
+     */
+    static void turnOn(int rule, Uri folder, String label, String wrappedKey, boolean isCode) {
+        SharedPreferences prefs = prefs();
+        String oldFolder = prefs.getString(KEY_FOLDER, null);
+        if (oldFolder != null && !oldFolder.equals(folder.toString())) {
+            BareBackupFolder.releaseGrant(ContextUtils.getApplicationContext(), Uri.parse(oldFolder));
+        }
+        prefs.edit()
+                .putInt(KEY_SCHEMA, 1)
+                .putInt(KEY_RULE, rule)
+                .putString(KEY_FOLDER, folder.toString())
+                .putString(KEY_FOLDER_LABEL, label)
+                .putString(KEY_KEY, wrappedKey)
+                .putString(KEY_SECRET_KIND, isCode ? "code" : "passphrase")
+                .putLong(KEY_LAST_SUCCESS, 0)
+                .putString(KEY_LAST_ERROR, ERROR_NONE)
+                .remove(KEY_IN_PROGRESS)
+                .apply();
+    }
+
+    /** Moves backups to another folder. The old folder's files stay where they are. */
+    static void setFolder(Uri folder, String label) {
+        SharedPreferences prefs = prefs();
+        String oldFolder = prefs.getString(KEY_FOLDER, null);
+        if (oldFolder != null && !oldFolder.equals(folder.toString())) {
+            BareBackupFolder.releaseGrant(ContextUtils.getApplicationContext(), Uri.parse(oldFolder));
+        }
+        prefs.edit()
+                .putString(KEY_FOLDER, folder.toString())
+                .putString(KEY_FOLDER_LABEL, label)
+                .putLong(KEY_LAST_SUCCESS, 0)
+                .putString(KEY_LAST_ERROR, ERROR_NONE)
+                .apply();
+    }
+
+    /**
+     * Back to Manual: the kept key is deleted, so nothing can write a backup until setup runs
+     * again with a new passphrase. The folder stays chosen for next time. Files already written
+     * stay where they are and still open with the passphrase the user saved.
+     */
+    static void turnOff() {
+        prefs().edit()
+                .putInt(KEY_RULE, RULE_MANUAL)
+                .remove(KEY_KEY)
+                .remove(KEY_SECRET_KIND)
+                .putString(KEY_LAST_ERROR, ERROR_NONE)
+                .remove(KEY_IN_PROGRESS)
+                .apply();
+        BareBackupKeyStore.delete();
+    }
+
+    // ---------------------------------------------------------------------------------------
+    // Running.
+
+    /** Writes a backup if one is due. Quietly does nothing otherwise. */
+    static void runIfDue() {
+        if (!isOn() || !LibraryLoader.getInstance().isInitialized()) return;
+        SharedPreferences prefs = prefs();
+        long now = System.currentTimeMillis();
+        if (!BareBackupBridge.isBackupDue(rule(), prefs.getLong(KEY_LAST_SUCCESS, 0), now)) return;
+        // After a failure, wait a while: a folder that is gone stays gone for a few app switches.
+        if (!ERROR_NONE.equals(lastError())
+                && Math.abs(now - prefs.getLong(KEY_LAST_ATTEMPT, 0)) < RETRY_AFTER_FAILURE_MS) {
+            return;
+        }
+        run(null);
+    }
+
+    /** Writes a backup now. {@code done} gets {@link #ERROR_NONE} or the reason it failed. */
+    static void runNow(Callback<String> done) {
+        if (!isOn()) {
+            done.onResult(ERROR_KEY_LOST);
+            return;
+        }
+        run(done);
+    }
+
+    private static void run(@Nullable Callback<String> done) {
+        SharedPreferences prefs = prefs();
+        long now = System.currentTimeMillis();
+        long started = prefs.getLong(KEY_IN_PROGRESS, 0);
+        if (sRunning || (started != 0 && Math.abs(now - started) < STALE_RUN_MS)) {
+            if (done != null) done.onResult(ERROR_BUSY);
+            return;
+        }
+        if (!ProfileManager.isInitialized()) {
+            if (done != null) done.onResult(ERROR_BUSY);
+            return;
+        }
+        Profile profile = ProfileManager.getLastUsedRegularProfile();
+        Context context = ContextUtils.getApplicationContext();
+        String wrapped = prefs.getString(KEY_KEY, "");
+        Uri tree = Uri.parse(prefs.getString(KEY_FOLDER, ""));
+        boolean isCode = !"passphrase".equals(prefs.getString(KEY_SECRET_KIND, "code"));
+        int keep = keep();
+        sRunning = true;
+        prefs.edit().putLong(KEY_IN_PROGRESS, now).putLong(KEY_LAST_ATTEMPT, now).apply();
+        PowerManager power = context.getSystemService(PowerManager.class);
+        PowerManager.WakeLock wakeLock =
+                power == null ? null : power.newWakeLock(PowerManager.PARTIAL_WAKE_LOCK, "Bare:backup");
+        if (wakeLock != null) wakeLock.acquire(WAKE_LOCK_MS);
+        Run run = new Run(context, new BareBackupFolder(context, tree), keep, wakeLock, done);
+
+        PostTask.postTask(
+                TaskTraits.USER_VISIBLE_MAY_BLOCK,
+                () -> {
+                    byte[] stored = BareBackupKeyStore.unwrap(wrapped);
+                    String problem = null;
+                    if (stored == null) {
+                        problem = ERROR_KEY_LOST;
+                    } else if (!run.mFolder.hasGrant()) {
+                        problem = ERROR_PERMISSION_LOST;
+                    } else if (!run.mFolder.exists()) {
+                        problem = ERROR_FOLDER_GONE;
+                    }
+                    String failure = problem;
+                    PostTask.postTask(
+                            TaskTraits.UI_DEFAULT,
+                            () -> {
+                                if (failure != null) {
+                                    if (stored != null) Arrays.fill(stored, (byte) 0);
+                                    run.finish(failure);
+                                    return;
+                                }
+                                run.build(profile, stored, isCode);
+                            });
+                });
+    }
+
+    /** One backup run, from the kept key to the swapped-in file. */
+    private static final class Run {
+        private final Context mContext;
+        private final BareBackupFolder mFolder;
+        private final int mKeep;
+        private final PowerManager.@Nullable WakeLock mWakeLock;
+        private final @Nullable Callback<String> mDone;
+
+        Run(
+                Context context,
+                BareBackupFolder folder,
+                int keep,
+                PowerManager.@Nullable WakeLock wakeLock,
+                @Nullable Callback<String> done) {
+            mContext = context;
+            mFolder = folder;
+            mKeep = keep;
+            mWakeLock = wakeLock;
+            mDone = done;
+        }
+
+        void build(Profile profile, byte[] stored, boolean isCode) {
+            BareBackupBridge.buildAutoBackup(
+                    profile,
+                    stored,
+                    isCode,
+                    BareBackupIo.deviceLabel(),
+                    BareBackupIo.bareVersion(mContext),
+                    BareBackupIo.bareVersionCode(mContext),
+                    bytes -> {
+                        if (bytes == null || bytes.length == 0) {
+                            Arrays.fill(stored, (byte) 0);
+                            finish(ERROR_BUILD_FAILED);
+                            return;
+                        }
+                        PostTask.postTask(
+                                TaskTraits.USER_VISIBLE_MAY_BLOCK,
+                                () -> writeTemp(bytes, stored));
+                    });
+        }
+
+        /** Off the UI thread: tidies up after an earlier run, then writes and reads back. */
+        private void writeTemp(byte[] bytes, byte[] stored) {
+            String failure = null;
+            byte[] readBack = null;
+            Uri temp = null;
+            long free = mFolder.freeBytes();
+            if (free >= 0 && free < bytes.length + SPACE_MARGIN) {
+                failure = ERROR_STORAGE_FULL;
+            } else {
+                recoverEarlierRun();
+                try {
+                    temp = mFolder.create(TEMP_NAME);
+                    if (temp == null) throw new java.io.IOException("not created");
+                    mFolder.write(temp, bytes);
+                    readBack = mFolder.read(temp, MAX_FILE_BYTES);
+                    if (readBack == null) throw new java.io.IOException("not read back");
+                } catch (java.io.IOException | RuntimeException e) {
+                    Log.w(TAG, "Backup not written: %s", e.getClass().getSimpleName());
+                    failure = mFolder.exists() ? ERROR_WRITE_FAILED : ERROR_FOLDER_GONE;
+                }
+            }
+            if (failure != null && temp != null) mFolder.delete(temp);
+            String result = failure;
+            Uri written = temp;
+            byte[] check = readBack;
+            long size = bytes.length;
+            PostTask.postTask(
+                    TaskTraits.UI_DEFAULT,
+                    () -> {
+                        if (result != null) {
+                            Arrays.fill(stored, (byte) 0);
+                            finish(result);
+                            return;
+                        }
+                        BareBackupBridge.verifyWithStoredKey(
+                                check,
+                                stored,
+                                ok -> {
+                                    Arrays.fill(stored, (byte) 0);
+                                    PostTask.postTask(
+                                            TaskTraits.USER_VISIBLE_MAY_BLOCK,
+                                            () -> swapIn(written, ok, size));
+                                });
+                    });
+        }
+
+        /**
+         * A run that was cut short may have left the temporary file, or the last good file under
+         * its ".old" name. The temporary file goes; an ".old" whose file is missing gets its name
+         * back, and goes if the file is there.
+         */
+        private void recoverEarlierRun() {
+            mFolder.deleteIfThere(TEMP_NAME);
+            for (String name : mFolder.names()) {
+                if (!name.endsWith(OLD_SUFFIX)) continue;
+                String base = name.substring(0, name.length() - OLD_SUFFIX.length());
+                if (!BareBackupBridge.isBackupFileName(base)) continue;
+                Uri old = mFolder.find(name);
+                if (old == null) continue;
+                if (mFolder.find(base) == null) {
+                    mFolder.rename(old, base);
+                } else {
+                    mFolder.delete(old);
+                }
+            }
+        }
+
+        /** Off the UI thread: puts the checked file in place and prunes the oldest. */
+        private void swapIn(Uri temp, boolean ok, long size) {
+            if (!ok) {
+                mFolder.delete(temp);
+                done(ERROR_WRITE_FAILED, null, 0);
+                return;
+            }
+            String name = mKeep == 1 ? FIXED_NAME : datedName();
+            Uri existing = mFolder.find(name);
+            Uri old = null;
+            if (existing != null) {
+                mFolder.deleteIfThere(name + OLD_SUFFIX);
+                old = mFolder.rename(existing, name + OLD_SUFFIX);
+                if (old == null) {
+                    mFolder.delete(temp);
+                    done(ERROR_WRITE_FAILED, null, 0);
+                    return;
+                }
+            }
+            // From here a complete file always exists under one of the names.
+            if (mFolder.rename(temp, name) == null) {
+                if (old != null) mFolder.rename(old, name);
+                mFolder.delete(temp);
+                done(ERROR_WRITE_FAILED, null, 0);
+                return;
+            }
+            if (old != null) mFolder.delete(old);
+            for (String prune : BareBackupBridge.backupNamesToPrune(mFolder.names(), mKeep)) {
+                if (!prune.equals(name)) mFolder.deleteIfThere(prune);
+            }
+            done(ERROR_NONE, name, size);
+        }
+
+        private void done(String result, @Nullable String name, long size) {
+            PostTask.postTask(
+                    TaskTraits.UI_DEFAULT,
+                    () -> {
+                        if (ERROR_NONE.equals(result)) {
+                            prefs().edit()
+                                    .putString(KEY_LAST_FILE, name)
+                                    .putLong(KEY_LAST_SIZE, size)
+                                    .apply();
+                        }
+                        finish(result);
+                    });
+        }
+
+        void finish(String result) {
+            SharedPreferences prefs = prefs();
+            SharedPreferences.Editor edit = prefs.edit().remove(KEY_IN_PROGRESS);
+            if (ERROR_NONE.equals(result)) {
+                // Written last, so a run cut short before this point is simply still due.
+                edit.putLong(KEY_LAST_SUCCESS, System.currentTimeMillis())
+                        .putString(KEY_LAST_ERROR, ERROR_NONE);
+            } else if (prefs.contains(KEY_KEY)) {
+                // The first failure after a success starts a new epoch, which gets one card.
+                if (ERROR_NONE.equals(prefs.getString(KEY_LAST_ERROR, ERROR_NONE))) {
+                    edit.putLong(KEY_FAILURE_EPOCH, prefs.getLong(KEY_FAILURE_EPOCH, 0) + 1);
+                }
+                edit.putString(KEY_LAST_ERROR, result);
+            }
+            edit.apply();
+            sRunning = false;
+            if (mWakeLock != null && mWakeLock.isHeld()) mWakeLock.release();
+            Log.i(TAG, "Backup run: %s", result);
+            if (mDone != null) mDone.onResult(result);
+        }
+
+        private static String datedName() {
+            Calendar now = Calendar.getInstance();
+            return BareBackupBridge.datedBackupName(
+                    now.get(Calendar.YEAR),
+                    now.get(Calendar.MONTH) + 1,
+                    now.get(Calendar.DAY_OF_MONTH),
+                    now.get(Calendar.HOUR_OF_DAY),
+                    now.get(Calendar.MINUTE));
+        }
+    }
+
+    // ---------------------------------------------------------------------------------------
+    // The failure card.
+
+    /** What the card says for a failure. */
+    static @StringRes int failureText(String error) {
+        switch (error) {
+            case ERROR_FOLDER_GONE:
+            case ERROR_PERMISSION_LOST:
+                return R.string.bare_autobackup_card_folder;
+            case ERROR_STORAGE_FULL:
+                return R.string.bare_autobackup_card_storage;
+            case ERROR_KEY_LOST:
+                return R.string.bare_autobackup_card_key;
+            default:
+                return R.string.bare_autobackup_card_failed;
+        }
+    }
+
+    /**
+     * Once per failure: a card over the browser with Fix it and Don't show again. Swiping it away
+     * counts as seen. Not while another card, the welcome or What's new is up.
+     */
+    static void showCardIfDue() {
+        Activity activity = sActivity.get();
+        if (activity == null
+                || activity.isFinishing()
+                || ApplicationStatus.getStateForActivity(activity) != ActivityState.RESUMED) {
+            return;
+        }
+        SharedPreferences prefs = prefs();
+        String error = lastError();
+        long epoch = prefs.getLong(KEY_FAILURE_EPOCH, 0);
+        if (ERROR_NONE.equals(error)
+                || rule() == RULE_MANUAL
+                || epoch <= prefs.getLong(KEY_CARD_EPOCH, 0)
+                || RiseSheet.isOpen()
+                || activity.findViewById(R.id.bare_welcome_root) != null
+                || activity.findViewById(R.id.bare_whats_new_root) != null) {
+            return;
+        }
+        View root = activity.getWindow().getDecorView();
+        boolean shown =
+                RiseSheet.showMessage(
+                        root,
+                        activity.getString(failureText(error)),
+                        activity.getString(R.string.bare_autobackup_fix_it),
+                        () -> openFix(activity, error),
+                        activity.getString(R.string.bare_autobackup_dont_show),
+                        BareAutoBackup::turnOff,
+                        null);
+        if (shown) prefs.edit().putLong(KEY_CARD_EPOCH, epoch).apply();
+    }
+
+    /** Where Fix it goes. */
+    static void openFix(Activity activity, String error) {
+        org.chromium.chrome.browser.settings.SettingsNavigationFactory.createSettingsNavigation()
+                .startSettings(activity, BareBackupSettingsFragment.class, null);
+    }
+}

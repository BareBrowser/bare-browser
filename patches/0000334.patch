+// --------------------------------------------------------- automatic backups
+
+// The key for automatic backups, from the passphrase setup showed or the user
+// chose. Empty on failure.
+std::vector<uint8_t> DeriveStoredKeyOffThread(std::vector<uint8_t> key_input) {
+  const KdfParams kdf = NewKdfParams();
+  std::optional<Key> key = DeriveKey(key_input, kdf);
+  WipeSecret(key_input);
+  if (!key) {
+    return {};
+  }
+  return StoreKey(kdf, *key);
+}
+
+std::vector<uint8_t> EncryptWithStoredKeyOffThread(
+    Description description,
+    std::string zip,
+    std::vector<uint8_t> stored) {
+  std::optional<StoredKey> loaded = LoadStoredKey(stored);
+  WipeSecret(stored);
+  std::optional<std::vector<uint8_t>> file;
+  if (loaded) {
+    file = WriteFullFile(description, loaded->kdf, NewAeadParams(),
+                         loaded->key, base::as_byte_span(zip));
+  }
+  OPENSSL_cleanse(zip.data(), zip.size());
+  return file.value_or(std::vector<uint8_t>());
+}
+
+void OnCollectedForAuto(base::WeakPtr<Profile> profile,
+                        Description description,
+                        std::vector<uint8_t> stored,
+                        ScopedJavaGlobalRef<jobject> callback,
+                        CollectedExtensions extensions) {
+  JNIEnv* env = AttachCurrentThread();
+  if (!profile) {
+    WipeSecret(stored);
+    Java_BareBackupBridge_onBytes(env, callback, std::vector<uint8_t>());
+    return;
+  }
+  JavaAndroidPrefs android;
+  Sources sources = SourcesFor(profile.get(), &android);
+  sources.extensions = &extensions;
+  std::optional<BuiltPackage> built = BuildPackage(Kind::kFull, sources);
+  if (!built) {
+    WipeSecret(stored);
+    Java_BareBackupBridge_onBytes(env, callback, std::vector<uint8_t>());
+    return;
+  }
+  for (const auto& [name, count] : built->counts) {
+    description.contents[name] = count;
+  }
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&EncryptWithStoredKeyOffThread, std::move(description),
+                     std::move(built->zip), std::move(stored)),
+      base::BindOnce(
+          [](ScopedJavaGlobalRef<jobject> callback,
+             std::vector<uint8_t> bytes) {
+            Java_BareBackupBridge_onBytes(AttachCurrentThread(), callback,
+                                          bytes);
+          },
+          std::move(callback)));
+}
+
+// Opens a file an automatic backup just wrote, with the key it was written
+// with: the salt must be the kept one and every part must read back.
+bool VerifyWithStoredKeyOffThread(std::vector<uint8_t> file,
+                                  std::vector<uint8_t> stored) {
+  std::optional<StoredKey> loaded = LoadStoredKey(stored);
+  WipeSecret(stored);
+  auto parsed = ParseFile(file);
+  if (!loaded || !parsed.has_value() || parsed->kind != Kind::kFull ||
+      parsed->kdf.salt != loaded->kdf.salt ||
+      parsed->kdf.log2_n != loaded->kdf.log2_n) {
+    return false;
+  }
+  auto body = DecryptBody(*parsed, loaded->key);
+  if (!body.has_value()) {
+    return false;
+  }
+  auto package = ReadPackage(*body);
+  OPENSSL_cleanse(body->data(), body->size());
+  return package.has_value() &&
+         ReadManifest(*package, Kind::kFull).has_value();

index 00000000000..048c0c1f942
--- /dev/null
+++ b/chrome/android/java/src/org/chromium/chrome/browser/bare/backup/BareBackupKeyStore.java
@@ -0,0 +1,112 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.bare.backup;
+
+import android.security.keystore.KeyGenParameterSpec;
+import android.security.keystore.KeyProperties;
+import android.util.Base64;
+
+import org.chromium.base.Log;
+import org.chromium.build.annotations.Nullable;
+
+import java.security.GeneralSecurityException;
+import java.security.KeyStore;
+import java.util.Arrays;
+
+import javax.crypto.Cipher;
+import javax.crypto.KeyGenerator;
+import javax.crypto.SecretKey;
+import javax.crypto.spec.GCMParameterSpec;
+
+/**
+ * Keeps an automatic backup's key on the phone, encrypted with a key that lives in Android's
+ * keystore and never leaves it. Backups run while nobody is there to type a passphrase, so the
+ * keystore key needs no unlock; it guards against the key being copied off the phone, not against
+ * someone using the phone. It goes when Bare is uninstalled.
+ */
+final class BareBackupKeyStore {
+    private static final String TAG = "BareBackupKey";
+    private static final String PROVIDER = "AndroidKeyStore";
+    private static final String ALIAS = "bare_backup_wrap";
+    private static final String TRANSFORMATION = "AES/GCM/NoPadding";
+    private static final int IV_SIZE = 12;
+    private static final int TAG_BITS = 128;
+
+    private BareBackupKeyStore() {}
+
+    /** Encrypts {@code key}, making the keystore key if there is none. Null on failure. */
+    static @Nullable String wrap(byte[] key) {
+        try {
+            Cipher cipher = Cipher.getInstance(TRANSFORMATION);
+            cipher.init(Cipher.ENCRYPT_MODE, keystoreKey(/* create= */ true));
+            byte[] iv = cipher.getIV();
+            byte[] sealed = cipher.doFinal(key);
+            byte[] out = new byte[iv.length + sealed.length];
+            System.arraycopy(iv, 0, out, 0, iv.length);
+            System.arraycopy(sealed, 0, out, iv.length, sealed.length);
+            return Base64.encodeToString(out, Base64.NO_WRAP);
+        } catch (GeneralSecurityException | RuntimeException e) {
+            Log.w(TAG, "Couldn't keep the key: %s", e.getClass().getSimpleName());
+            return null;
+        }
+    }
+
+    /** The key {@link #wrap} was given, or null if the keystore key is gone or the blob is bad. */
+    static byte @Nullable [] unwrap(String wrapped) {
+        byte[] bytes = null;
+        try {
+            bytes = Base64.decode(wrapped, Base64.NO_WRAP);
+            if (bytes.length <= IV_SIZE) return null;
+            SecretKey key = keystoreKey(/* create= */ false);
+            if (key == null) return null;
+            Cipher cipher = Cipher.getInstance(TRANSFORMATION);
+            cipher.init(
+                    Cipher.DECRYPT_MODE,
+                    key,
+                    new GCMParameterSpec(TAG_BITS, Arrays.copyOfRange(bytes, 0, IV_SIZE)));
+            return cipher.doFinal(bytes, IV_SIZE, bytes.length - IV_SIZE);
+        } catch (GeneralSecurityException | RuntimeException e) {
+            Log.w(TAG, "Couldn't read the key: %s", e.getClass().getSimpleName());
+            return null;
+        } finally {
+            if (bytes != null) Arrays.fill(bytes, (byte) 0);
+        }
+    }
+
+    /** Deletes the keystore key, which makes every wrapped key useless. */
+    static void delete() {
+        try {
+            KeyStore store = KeyStore.getInstance(PROVIDER);
+            store.load(null);
+            store.deleteEntry(ALIAS);
+        } catch (GeneralSecurityException | java.io.IOException | RuntimeException e) {
+            Log.w(TAG, "Couldn't delete the key: %s", e.getClass().getSimpleName());
+        }
+    }
+
+    private static @Nullable SecretKey keystoreKey(boolean create)
+            throws GeneralSecurityException {
+        KeyStore store = KeyStore.getInstance(PROVIDER);
+        try {
+            store.load(null);
+        } catch (java.io.IOException e) {
+            throw new GeneralSecurityException(e);
+        }
+        KeyStore.Entry entry = store.getEntry(ALIAS, null);
+        if (entry instanceof KeyStore.SecretKeyEntry secret) return secret.getSecretKey();
+        if (!create) return null;
+        KeyGenerator generator =
+                KeyGenerator.getInstance(KeyProperties.KEY_ALGORITHM_AES, PROVIDER);
+        generator.init(
+                new KeyGenParameterSpec.Builder(
+                                ALIAS,
+                                KeyProperties.PURPOSE_ENCRYPT | KeyProperties.PURPOSE_DECRYPT)
+                        .setBlockModes(KeyProperties.BLOCK_MODE_GCM)
+                        .setEncryptionPaddings(KeyProperties.ENCRYPTION_PADDING_NONE)
+                        .setKeySize(256)
+                        .build());
+        return generator.generateKey();
+    }
+}

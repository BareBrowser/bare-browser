diff --git a/chrome/browser/bare/backup/backup_schedule.cc b/chrome/browser/bare/backup/backup_schedule.cc
new file mode 100644
index 00000000000..e47e1cb530c
--- /dev/null
+++ b/chrome/browser/bare/backup/backup_schedule.cc
@@ -0,0 +1,116 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/bare/backup/backup_schedule.h"
+
+#include <algorithm>
+
+#include "base/strings/string_util.h"
+#include "base/strings/stringprintf.h"
+
+namespace bare::backup {
+
+namespace {
+
+constexpr int64_t kDayMs = int64_t{24} * 60 * 60 * 1000;
+constexpr int64_t kClockSlackMs = int64_t{5} * 60 * 1000;
+constexpr std::string_view kDatedPrefix = "Bare backup ";
+constexpr std::string_view kSuffix = ".bare";
+
+// "YYYY-MM-DD HHMM" between the prefix and the suffix.
+bool IsDatedName(std::string_view name) {
+  if (!base::StartsWith(name, kDatedPrefix) || !base::EndsWith(name, kSuffix)) {
+    return false;
+  }
+  name.remove_prefix(kDatedPrefix.size());
+  name.remove_suffix(kSuffix.size());
+  if (name.size() != 15) {
+    return false;
+  }
+  for (size_t i = 0; i < name.size(); ++i) {
+    const char c = name[i];
+    if (i == 4 || i == 7) {
+      if (c != '-') {
+        return false;
+      }
+    } else if (i == 10) {
+      if (c != ' ') {
+        return false;
+      }
+    } else if (!base::IsAsciiDigit(c)) {
+      return false;
+    }
+  }
+  return true;
+}
+
+}  // namespace
+
+int64_t BackupPeriodMs(int rule) {
+  switch (static_cast<BackupRule>(rule)) {
+    case BackupRule::kDaily:
+      return kDayMs;
+    case BackupRule::kWeekly:
+      return 7 * kDayMs;
+    case BackupRule::kMonthly:
+      return 30 * kDayMs;
+    case BackupRule::kManual:
+      return 0;
+  }
+  return 0;
+}
+
+bool IsBackupDue(int rule, int64_t last_success_ms, int64_t now_ms) {
+  const int64_t period = BackupPeriodMs(rule);
+  if (period == 0) {
+    return false;
+  }
+  if (last_success_ms <= 0 || now_ms < last_success_ms - kClockSlackMs) {
+    return true;
+  }
+  return now_ms - last_success_ms >= period;
+}
+
+std::string DatedBackupName(int year, int month, int day, int hour,
+                            int minute) {
+  return base::StringPrintf("Bare backup %04d-%02d-%02d %02d%02d.bare", year,
+                            month, day, hour, minute);
+}
+
+bool IsBackupFileName(std::string_view name) {
+  return name == kFixedBackupName || IsDatedName(name);
+}
+
+std::vector<std::string> BackupNamesToPrune(
+    const std::vector<std::string>& names,
+    int keep) {
+  std::vector<std::string> ours;
+  for (const std::string& name : names) {
+    if (IsBackupFileName(name) &&
+        std::ranges::find(ours, name) == ours.end()) {
+      ours.push_back(name);
+    }
+  }
+  if (keep <= 1) {
+    std::erase(ours, std::string(kFixedBackupName));
+    return ours;
+  }
+  // Oldest first. Dated names sort by date as text.
+  std::ranges::sort(ours, [](const std::string& a, const std::string& b) {
+    const bool a_fixed = a == kFixedBackupName;
+    const bool b_fixed = b == kFixedBackupName;
+    if (a_fixed != b_fixed) {
+      return a_fixed;
+    }
+    return a < b;
+  });
+  const size_t kept = static_cast<size_t>(keep);
+  if (ours.size() <= kept) {
+    return {};
+  }
+  ours.resize(ours.size() - kept);
+  return ours;
+}
+
+}  // namespace bare::backup

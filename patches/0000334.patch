diff --git a/chrome/android/java/src/org/chromium/chrome/browser/bare/backup/BareBackupFolder.java b/chrome/android/java/src/org/chromium/chrome/browser/bare/backup/BareBackupFolder.java
new file mode 100644
index 00000000000..1fe2eb698b5
--- /dev/null
+++ b/chrome/android/java/src/org/chromium/chrome/browser/bare/backup/BareBackupFolder.java
@@ -0,0 +1,314 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.bare.backup;
+
+import android.content.ContentResolver;
+import android.content.Context;
+import android.content.Intent;
+import android.content.UriPermission;
+import android.database.Cursor;
+import android.net.Uri;
+import android.os.Environment;
+import android.os.StatFs;
+import android.provider.DocumentsContract;
+
+import org.chromium.build.annotations.Nullable;
+
+import java.io.File;
+import java.io.FileNotFoundException;
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.OutputStream;
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * The folder automatic backups go to: a folder the user granted through Android's folder picker,
+ * by default Download/BareBackup. A grant, unlike files Bare makes in Downloads by itself, still
+ * reaches the old backups after Bare is reinstalled, once the folder is picked again.
+ *
+ * <p>Everything here does disk or provider work; call it off the UI thread, except {@link
+ * #pickerIntent}.
+ */
+final class BareBackupFolder {
+    static final String DEFAULT_LABEL = "Download/BareBackup";
+    private static final String EXTERNAL_STORAGE = "com.android.externalstorage.documents";
+    private static final String DEFAULT_DOCUMENT = "primary:Download/BareBackup";
+    private static final String MIME = "application/octet-stream";
+    private static final String TEST_NAME = ".bare-test.tmp";
+    private static final String TEST_RENAMED = ".bare-test-2.tmp";
+
+    private final Context mContext;
+    private final Uri mTree;
+
+    BareBackupFolder(Context context, Uri tree) {
+        mContext = context.getApplicationContext();
+        mTree = tree;
+    }
+
+    Uri tree() {
+        return mTree;
+    }
+
+    /**
+     * The folder picker, opened on Download/BareBackup. The folder is made first so the picker can
+     * open in it.
+     */
+    static Intent pickerIntent() {
+        File folder =
+                new File(
+                        Environment.getExternalStoragePublicDirectory(
+                                Environment.DIRECTORY_DOWNLOADS),
+                        "BareBackup");
+        if (!folder.isDirectory()) {
+            // Allowed on Android 11 and up; on 10 the picker's own "new folder" is the fallback.
+            folder.mkdirs();
+        }
+        Intent intent = new Intent(Intent.ACTION_OPEN_DOCUMENT_TREE);
+        intent.putExtra(
+                DocumentsContract.EXTRA_INITIAL_URI,
+                DocumentsContract.buildDocumentUri(EXTERNAL_STORAGE, DEFAULT_DOCUMENT));
+        intent.addFlags(
+                Intent.FLAG_GRANT_READ_URI_PERMISSION
+                        | Intent.FLAG_GRANT_WRITE_URI_PERMISSION
+                        | Intent.FLAG_GRANT_PERSISTABLE_URI_PERMISSION);
+        return intent;
+    }
+
+    /** Keeps the grant across restarts. False if Android refused it. */
+    boolean keepGrant() {
+        try {
+            mContext.getContentResolver()
+                    .takePersistableUriPermission(
+                            mTree,
+                            Intent.FLAG_GRANT_READ_URI_PERMISSION
+                                    | Intent.FLAG_GRANT_WRITE_URI_PERMISSION);
+            return true;
+        } catch (SecurityException e) {
+            return false;
+        }
+    }
+
+    /** Gives the grant back, when the user picks another folder or turns backups off. */
+    static void releaseGrant(Context context, Uri tree) {
+        try {
+            context.getContentResolver()
+                    .releasePersistableUriPermission(
+                            tree,
+                            Intent.FLAG_GRANT_READ_URI_PERMISSION
+                                    | Intent.FLAG_GRANT_WRITE_URI_PERMISSION);
+        } catch (SecurityException e) {
+            // Not held any more.
+        }
+    }
+
+    /** Whether Bare still holds a write grant for the folder. */
+    boolean hasGrant() {
+        for (UriPermission permission :
+                mContext.getContentResolver().getPersistedUriPermissions()) {
+            if (permission.getUri().equals(mTree) && permission.isWritePermission()) return true;
+        }
+        return false;
+    }
+
+    /** What the screens call the folder: "Download/BareBackup", or the folder's own name. */
+    String label() {
+        String id = DocumentsContract.getTreeDocumentId(mTree);
+        if (EXTERNAL_STORAGE.equals(mTree.getAuthority()) && id.startsWith("primary:")) {
+            String path = id.substring("primary:".length());
+            if (!path.isEmpty()) return path;
+        }
+        String name = displayName(root());
+        return name == null ? id : name;
+    }
+
+    /** Whether the folder is a volume's top or the Downloads folder itself, which aren't used. */
+    boolean isTooHigh() {
+        String id = DocumentsContract.getTreeDocumentId(mTree);
+        int colon = id.indexOf(':');
+        String path = colon < 0 ? id : id.substring(colon + 1);
+        return path.isEmpty() || path.equalsIgnoreCase("Download");
+    }
+
+    /** Whether the folder is there and answers. */
+    boolean exists() {
+        return displayName(root()) != null;
+    }
+
+    /**
+     * Makes, renames and deletes a small file. A folder that can't do all three, such as some
+     * cloud folders, can't hold backups safely.
+     */
+    boolean canHoldBackups() {
+        Uri test = null;
+        try {
+            deleteIfThere(TEST_NAME);
+            deleteIfThere(TEST_RENAMED);
+            test = create(TEST_NAME);
+            if (test == null) return false;
+            try (OutputStream out = mContext.getContentResolver().openOutputStream(test, "w")) {
+                if (out == null) return false;
+                out.write(new byte[] {'b', 'a', 'r', 'e'});
+            }
+            Uri renamed = rename(test, TEST_RENAMED);
+            if (renamed == null) return false;
+            test = renamed;
+            boolean deleted = delete(test);
+            test = null;
+            return deleted;
+        } catch (IOException | RuntimeException e) {
+            return false;
+        } finally {
+            if (test != null) delete(test);
+        }
+    }
+
+    /** Free bytes where the folder is, if it is on the phone's own storage; else -1. */
+    long freeBytes() {
+        String id = DocumentsContract.getTreeDocumentId(mTree);
+        if (!EXTERNAL_STORAGE.equals(mTree.getAuthority()) || !id.startsWith("primary:")) {
+            return -1;
+        }
+        try {
+            return new StatFs(Environment.getExternalStorageDirectory().getPath())
+                    .getAvailableBytes();
+        } catch (IllegalArgumentException e) {
+            return -1;
+        }
+    }
+
+    /** The names of the folder's files. */
+    List<String> names() {
+        List<String> names = new ArrayList<>();
+        Uri children =
+                DocumentsContract.buildChildDocumentsUriUsingTree(
+                        mTree, DocumentsContract.getTreeDocumentId(mTree));
+        try (Cursor cursor =
+                mContext.getContentResolver()
+                        .query(
+                                children,
+                                new String[] {DocumentsContract.Document.COLUMN_DISPLAY_NAME},
+                                null,
+                                null,
+                                null)) {
+            while (cursor != null && cursor.moveToNext()) {
+                String name = cursor.getString(0);
+                if (name != null) names.add(name);
+            }
+        } catch (RuntimeException e) {
+            // An empty list: nothing is deleted.
+        }
+        return names;
+    }
+
+    /** The document for a file of this name in the folder, or null. */
+    @Nullable
+    Uri find(String name) {
+        Uri children =
+                DocumentsContract.buildChildDocumentsUriUsingTree(
+                        mTree, DocumentsContract.getTreeDocumentId(mTree));
+        try (Cursor cursor =
+                mContext.getContentResolver()
+                        .query(
+                                children,
+                                new String[] {
+                                    DocumentsContract.Document.COLUMN_DOCUMENT_ID,
+                                    DocumentsContract.Document.COLUMN_DISPLAY_NAME
+                                },
+                                null,
+                                null,
+                                null)) {
+            while (cursor != null && cursor.moveToNext()) {
+                if (name.equals(cursor.getString(1))) {
+                    return DocumentsContract.buildDocumentUriUsingTree(mTree, cursor.getString(0));
+                }
+            }
+        } catch (RuntimeException e) {
+            return null;
+        }
+        return null;
+    }
+
+    @Nullable
+    Uri create(String name) throws FileNotFoundException {
+        return DocumentsContract.createDocument(
+                mContext.getContentResolver(), root(), MIME, name);
+    }
+
+    /** Writes {@code bytes} to the document and flushes them to disk. */
+    void write(Uri document, byte[] bytes) throws IOException {
+        ContentResolver resolver = mContext.getContentResolver();
+        try (android.os.ParcelFileDescriptor descriptor =
+                resolver.openFileDescriptor(document, "w")) {
+            if (descriptor == null) throw new IOException("no descriptor");
+            try (java.io.FileOutputStream out =
+                    new java.io.FileOutputStream(descriptor.getFileDescriptor())) {
+                out.write(bytes);
+                out.flush();
+                out.getFD().sync();
+            }
+        }
+    }
+
+    byte @Nullable [] read(Uri document, int limit) {
+        try (InputStream in = mContext.getContentResolver().openInputStream(document)) {
+            if (in == null) return null;
+            java.io.ByteArrayOutputStream out = new java.io.ByteArrayOutputStream();
+            byte[] buffer = new byte[64 * 1024];
+            int total = 0;
+            int n;
+            while ((n = in.read(buffer)) > 0) {
+                total += n;
+                if (total > limit) return null;
+                out.write(buffer, 0, n);
+            }
+            return out.toByteArray();
+        } catch (IOException | RuntimeException e) {
+            return null;
+        }
+    }
+
+    @Nullable
+    Uri rename(Uri document, String name) {
+        try {
+            return DocumentsContract.renameDocument(mContext.getContentResolver(), document, name);
+        } catch (FileNotFoundException | RuntimeException e) {
+            return null;
+        }
+    }
+
+    boolean delete(Uri document) {
+        try {
+            return DocumentsContract.deleteDocument(mContext.getContentResolver(), document);
+        } catch (FileNotFoundException | RuntimeException e) {
+            return false;
+        }
+    }
+
+    void deleteIfThere(String name) {
+        Uri document = find(name);
+        if (document != null) delete(document);
+    }
+
+    private Uri root() {
+        return DocumentsContract.buildDocumentUriUsingTree(
+                mTree, DocumentsContract.getTreeDocumentId(mTree));
+    }
+
+    private @Nullable String displayName(Uri document) {
+        try (Cursor cursor =
+                mContext.getContentResolver()
+                        .query(
+                                document,
+                                new String[] {DocumentsContract.Document.COLUMN_DISPLAY_NAME},
+                                null,
+                                null,
+                                null)) {
+            return cursor != null && cursor.moveToFirst() ? cursor.getString(0) : null;
+        } catch (RuntimeException e) {
+            return null;
+        }
+    }
+}

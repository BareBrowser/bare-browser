+  ScopedJavaGlobalRef<jobject> callback(jcallback);
+  std::vector<uint8_t> key_input =
+      bare_backup::SecretBytes(std::move(secret), secret_is_code);
+  if (key_input.empty()) {
+    Java_BareBackupBridge_onBytes(env, callback, std::vector<uint8_t>());
+    return;
+  }
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_BLOCKING},
+      base::BindOnce(&bare_backup::DeriveStoredKeyOffThread,
+                     std::move(key_input)),
+      base::BindOnce(
+          [](ScopedJavaGlobalRef<jobject> callback,
+             std::vector<uint8_t> stored) {
+            Java_BareBackupBridge_onBytes(AttachCurrentThread(), callback,
+                                          stored);
+            OPENSSL_cleanse(stored.data(), stored.size());
+          },
+          std::move(callback)));
+}
+
+static void JNI_BareBackupBridge_BuildAutoBackup(
+    JNIEnv* env,
+    const JavaRef<jobject>& jprofile,
+    std::vector<uint8_t> stored_key,
+    jboolean secret_is_code,
+    std::string device_label,
+    std::string bare_version,
+    jint bare_version_code,
+    const JavaRef<jobject>& jcallback) {
+  ScopedJavaGlobalRef<jobject> callback(jcallback);
+  Profile* profile = Profile::FromJavaObject(jprofile);
+  if (!profile || profile->IsOffTheRecord()) {
+    bare_backup::WipeSecret(stored_key);
+    Java_BareBackupBridge_onBytes(env, callback, std::vector<uint8_t>());
+    return;
+  }
+  bare_backup::Description description;
+  description.created = bare_backup::UtcTimestamp(base::Time::Now());
+  description.bare_version = bare_version;
+  description.bare_version_code = bare_version_code;
+  description.device_label = device_label;
+  description.secret = secret_is_code ? "code" : "passphrase";
+  bare_backup::CollectExtensions(
+      profile, /*with_files=*/true,
+      base::BindOnce(&bare_backup::OnCollectedForAuto, profile->GetWeakPtr(),
+                     std::move(description), std::move(stored_key),
+                     std::move(callback)));
+}
+
+static void JNI_BareBackupBridge_VerifyWithStoredKey(
+    JNIEnv* env,
+    std::vector<uint8_t> file,
+    std::vector<uint8_t> stored_key,
+    const JavaRef<jobject>& jcallback) {
+  ScopedJavaGlobalRef<jobject> callback(jcallback);
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&bare_backup::VerifyWithStoredKeyOffThread,
+                     std::move(file), std::move(stored_key)),
+      base::BindOnce(
+          [](ScopedJavaGlobalRef<jobject> callback, bool ok) {
+            Java_BareBackupBridge_onBoolean(AttachCurrentThread(), callback,
+                                            ok);
+          },
+          std::move(callback)));
+}
+
+static bool JNI_BareBackupBridge_IsBackupDue(JNIEnv* env,
+                                             jint rule,
+                                             jlong last_success_ms,
+                                             jlong now_ms) {
+  return bare_backup::IsBackupDue(rule, last_success_ms, now_ms);
+}
+
+// Names travel joined by NUL, which no file name contains.
+static std::string JNI_BareBackupBridge_BackupNamesToPrune(JNIEnv* env,
+                                                           std::string names,
+                                                           jint keep) {
+  std::vector<std::string> list = base::SplitString(
+      names, std::string(1, '\0'), base::KEEP_WHITESPACE,
+      base::SPLIT_WANT_NONEMPTY);
+  return base::JoinString(bare_backup::BackupNamesToPrune(list, keep),
+                          std::string(1, '\0'));
+}
+
+static std::string JNI_BareBackupBridge_DatedBackupName(JNIEnv* env,
+                                                        jint year,
+                                                        jint month,
+                                                        jint day,
+                                                        jint hour,
+                                                        jint minute) {
+  return bare_backup::DatedBackupName(year, month, day, hour, minute);
+}
+
+static bool JNI_BareBackupBridge_IsBackupFileName(JNIEnv* env,
+                                                  std::string name) {
+  return bare_backup::IsBackupFileName(name);
+}
+
 DEFINE_JNI(BareBackupBridge)

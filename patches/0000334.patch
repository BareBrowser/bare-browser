+constexpr int64_t kHour = int64_t{60} * 60 * 1000;
+constexpr int64_t kDay = 24 * kHour;
+constexpr int64_t kNow = int64_t{1'762'950'000'000};
+
+constexpr int kManual = static_cast<int>(BackupRule::kManual);
+constexpr int kDaily = static_cast<int>(BackupRule::kDaily);
+constexpr int kWeekly = static_cast<int>(BackupRule::kWeekly);
+constexpr int kMonthly = static_cast<int>(BackupRule::kMonthly);
+
+TEST(BackupScheduleTest, ManualIsNeverDue) {
+  EXPECT_FALSE(IsBackupDue(kManual, 0, kNow));
+  EXPECT_FALSE(IsBackupDue(kManual, kNow - 365 * kDay, kNow));
+  EXPECT_FALSE(IsBackupDue(7, 0, kNow));
+  EXPECT_FALSE(IsBackupDue(-1, 0, kNow));
+}
+
+TEST(BackupScheduleTest, NeverDoneIsDue) {
+  EXPECT_TRUE(IsBackupDue(kDaily, 0, kNow));
+  EXPECT_TRUE(IsBackupDue(kWeekly, 0, kNow));
+  EXPECT_TRUE(IsBackupDue(kMonthly, 0, kNow));
+}
+
+TEST(BackupScheduleTest, DailyEdges) {
+  EXPECT_FALSE(IsBackupDue(kDaily, kNow - kDay + 1, kNow));
+  EXPECT_TRUE(IsBackupDue(kDaily, kNow - kDay, kNow));
+  EXPECT_FALSE(IsBackupDue(kDaily, kNow, kNow));
+}
+
+TEST(BackupScheduleTest, WeeklyEdges) {
+  EXPECT_FALSE(IsBackupDue(kWeekly, kNow - 7 * kDay + 1, kNow));
+  EXPECT_TRUE(IsBackupDue(kWeekly, kNow - 7 * kDay, kNow));
+  EXPECT_FALSE(IsBackupDue(kWeekly, kNow - 6 * kDay, kNow));
+}
+
+TEST(BackupScheduleTest, MonthlyEdges) {
+  EXPECT_FALSE(IsBackupDue(kMonthly, kNow - 30 * kDay + 1, kNow));
+  EXPECT_TRUE(IsBackupDue(kMonthly, kNow - 30 * kDay, kNow));
+  EXPECT_FALSE(IsBackupDue(kMonthly, kNow - 29 * kDay, kNow));
+}
+
+TEST(BackupScheduleTest, ClockSetBack) {
+  // A little behind is a clock correction, not a reason to back up.
+  EXPECT_FALSE(IsBackupDue(kWeekly, kNow + 4 * 60 * 1000, kNow));
+  // Further back, the last backup looks like it is from the future.
+  EXPECT_TRUE(IsBackupDue(kWeekly, kNow + 6 * 60 * 1000, kNow));
+  EXPECT_TRUE(IsBackupDue(kMonthly, kNow + kDay, kNow));
+}
+
+TEST(BackupScheduleTest, ClockSetForward) {
+  EXPECT_TRUE(IsBackupDue(kMonthly, kNow, kNow + 31 * kDay));
+}
+
+TEST(BackupScheduleTest, Periods) {
+  EXPECT_EQ(BackupPeriodMs(kManual), 0);
+  EXPECT_EQ(BackupPeriodMs(kDaily), kDay);
+  EXPECT_EQ(BackupPeriodMs(kWeekly), 7 * kDay);
+  EXPECT_EQ(BackupPeriodMs(kMonthly), 30 * kDay);
+  EXPECT_EQ(BackupPeriodMs(4), 0);
+}
+
+TEST(BackupScheduleTest, Names) {
+  EXPECT_EQ(DatedBackupName(2026, 11, 2, 9, 5),
+            "Bare backup 2026-11-02 0905.bare");
+  for (const char* name :
+       {"Bare backup.bare", "Bare backup 2026-11-02 0905.bare",
+        "Bare backup 1999-12-31 2359.bare"}) {
+    EXPECT_TRUE(IsBackupFileName(name)) << name;
+  }
+  for (const char* name :
+       {"", "Bare backup (1).bare", "Bare backup.bare.tmp",
+        "Bare backup.bare.old", "bare backup.bare", "Bare backup.BARE",
+        "Bare backup 2026-11-2 0905.bare", "Bare backup 2026-11-02 905.bare",
+        "Bare backup 2026-11-02_0905.bare", "Bare backup 2026-11-02 0905.bare ",
+        "Bare backup 2026-11-02 0905 (1).bare", "Bare setup 2026-11-02.bare",
+        "notes.txt", "Bare backup abcd-ef-gh ijkl.bare"}) {
+    EXPECT_FALSE(IsBackupFileName(name)) << name;
+  }
+}
+
+TEST(BackupScheduleTest, KeepThree) {
+  const std::vector<std::string> names = {
+      "Bare backup 2026-11-04 0900.bare", "Bare backup 2026-11-01 0900.bare",
+      "Bare backup 2026-11-03 0900.bare", "Bare backup 2026-11-02 0900.bare",
+      "holiday.jpg"};
+  EXPECT_EQ(BackupNamesToPrune(names, 3),
+            std::vector<std::string>({"Bare backup 2026-11-01 0900.bare"}));
+  EXPECT_TRUE(BackupNamesToPrune(names, 5).empty());
+}
+
+TEST(BackupScheduleTest, KeepMoreCountsTheFixedNameAsOldest) {
+  const std::vector<std::string> names = {
+      "Bare backup 2026-11-02 0900.bare", "Bare backup.bare",
+      "Bare backup 2026-11-03 0900.bare", "Bare backup 2026-11-04 0900.bare"};
+  EXPECT_EQ(BackupNamesToPrune(names, 3),
+            std::vector<std::string>({"Bare backup.bare"}));
+}
+
+TEST(BackupScheduleTest, KeepOneDropsDatedFiles) {
+  const std::vector<std::string> names = {
+      "Bare backup 2026-11-02 0900.bare", "Bare backup.bare",
+      "Bare backup 2026-11-03 0900.bare", "Bare setup 2026-11-01.bare"};
+  EXPECT_EQ(BackupNamesToPrune(names, 1),
+            std::vector<std::string>({"Bare backup 2026-11-02 0900.bare",
+                                      "Bare backup 2026-11-03 0900.bare"}));

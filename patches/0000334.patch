@@ -0,0 +1,56 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_BARE_BACKUP_BACKUP_SCHEDULE_H_
+#define CHROME_BROWSER_BARE_BACKUP_BACKUP_SCHEDULE_H_
+
+#include <stdint.h>
+
+#include <string>
+#include <string_view>
+#include <vector>
+
+// When an automatic backup is due, and the names of the files it writes.
+// Nothing is scheduled with Android: Bare asks IsBackupDue() when the user
+// leaves it, and a little while after it comes back to the front.
+namespace bare::backup {
+
+// Stored as an int in the rule's preferences.
+enum class BackupRule : int {
+  kManual = 0,
+  kDaily = 1,
+  kWeekly = 2,
+  kMonthly = 3,
+};
+
+// How long `rule` waits between backups, or 0 for Manual and unknown values.
+int64_t BackupPeriodMs(int rule);
+
+// Whether a backup should be made now. Never for Manual. Always when none has
+// been made yet, and when the clock reads more than five minutes before the
+// last success: it was set back, and waiting for it to catch up could take as
+// long as it moved.
+bool IsBackupDue(int rule, int64_t last_success_ms, int64_t now_ms);
+
+// The one file kept when the rule keeps a single backup.
+inline constexpr std::string_view kFixedBackupName = "Bare backup.bare";
+
+// "Bare backup 2026-11-12 0941.bare", for keeping the last 3 or 5. Local time.
+std::string DatedBackupName(int year, int month, int day, int hour, int minute);
+
+// Whether `name` is the fixed name or a dated one. Nothing else in the folder
+// is ever renamed or deleted.
+bool IsBackupFileName(std::string_view name);
+
+// Of `names`, the backup files to delete so that the newest `keep` remain.
+// Names that aren't backup files are never listed. Keeping one means keeping
+// the fixed name, so every dated file goes; keeping more counts the fixed
+// name as older than any dated one.
+std::vector<std::string> BackupNamesToPrune(
+    const std::vector<std::string>& names,
+    int keep);
+
+}  // namespace bare::backup
+
+#endif  // CHROME_BROWSER_BARE_BACKUP_BACKUP_SCHEDULE_H_

From 91a135f2219fb2591f668ee008c462faf80215c6 Mon Sep 17 00:00:00 2001
From: Bare <git@barebrowser.org>
Date: Wed, 9 Sep 2026 21:18:23 +0000
Subject: [PATCH] Move the update check to the current account and bound what
 it reads

The three GitHub URLs in the update check still named the account the project
was first published under. GitHub redirects an old account name only while it
stays registered, so every install was one released username away from taking
its release feed and its download link from whoever claimed the name next, and
the feed connection follows redirects. They are one constant now, since the
three have to move together and did not last time.

The old name has to stay registered regardless. Builds up to 1.0.0-alpha.2 were
compiled against it and ask it for a feed for as long as they run.

The rest is about what the feed is allowed to say. The tag was read as anything
up to the closing quote, so a tag could carry ../ back up the path and the
release row would open somewhere else on github.com. Tags now have to match
Bare's own shape, and releasePageFor checks its argument before building a URL
rather than trusting the caller: a tag stored by an older build is still in
preferences and arrives here after an update.

Versions are matched whole instead of searched for. Searching accepted a version
inside a longer string, which meant a number too large for an int matched on one
of its own substrings; the digit runs are bounded as well, so Integer.parseInt
cannot overflow. It threw from a callback nothing catches, and the tag had not
been written yet at that point, so it took the browser down without leaving
anything behind to do it again. Both readings now come out unreadable, which the
ordering already treats as older, so a tag like that never offers itself as an
update.

The read stops after half a megabyte. The tag is in the first entry, and without
a limit a server that never stops sending is answered by growing a string until
the browser dies.

BareUpdateCheckUnitTest covers the ordering, both overflow readings, the whole
match, and the URL the release row builds. There was no coverage before.
---
 .../chrome/browser/bare/BareUpdateCheck.java  | 61 +++++++++++---
 chrome/android/junit/BUILD.gn                 |  1 +
 .../browser/bare/BareUpdateCheckUnitTest.java | 80 +++++++++++++++++++
 3 files changed, 132 insertions(+), 10 deletions(-)
 create mode 100644 chrome/android/junit/src/org/chromium/chrome/browser/bare/BareUpdateCheckUnitTest.java

diff --git a/chrome/android/java/src/org/chromium/chrome/browser/bare/BareUpdateCheck.java b/chrome/android/java/src/org/chromium/chrome/browser/bare/BareUpdateCheck.java
index 6e201bf72a9..5d0eaee26b3 100644
--- a/chrome/android/java/src/org/chromium/chrome/browser/bare/BareUpdateCheck.java
+++ b/chrome/android/java/src/org/chromium/chrome/browser/bare/BareUpdateCheck.java
@@ -47,13 +47,21 @@ public class BareUpdateCheck {
         int MANUAL = 1;
     }
 
+    /**
+     * Where releases live.
+     *
+     * <p>One constant rather than three literals, because the three URLs below have to move
+     * together and did not the last time the account name changed. Builds up to 1.0.0-alpha.2
+     * were compiled against the old account, so that name has to stay registered: those installs
+     * ask it for a feed for as long as they run.
+     */
+    private static final String REPO = "https://github.com/BareBrowser/bare-browser";
+
     /** The public release feed. No API token, no rate limit worth worrying about. */
-    private static final String RELEASES_FEED =
-            "https://github.com/Shshtwy/bare-browser/releases.atom";
+    private static final String RELEASES_FEED = REPO + "/releases.atom";
 
     /** Where a user is sent to read about and download a release. */
-    public static final String RELEASES_PAGE =
-            "https://github.com/Shshtwy/bare-browser/releases/latest";
+    public static final String RELEASES_PAGE = REPO + "/releases/latest";
 
     /**
      * The page for one specific release.
@@ -62,19 +70,49 @@ public class BareUpdateCheck {
      * the row just offered even if a newer one appears between the check and the tap.
      */
     public static String releasePageFor(String tag) {
-        return "https://github.com/Shshtwy/bare-browser/releases/tag/" + tag;
+        if (!TAG.matcher(tag).matches()) return RELEASES_PAGE;
+        return REPO + "/releases/tag/" + tag;
     }
 
     private static final long CHECK_INTERVAL_MS = TimeUnit.DAYS.toMillis(1);
     private static final long REMINDER_INTERVAL_MS = TimeUnit.DAYS.toMillis(7);
     private static final int TIMEOUT_MS = 15000;
 
+    /**
+     * How much of the feed is read before giving up.
+     *
+     * <p>The tag wanted is in the first entry, so a feed that has not produced one inside this
+     * much text is not going to. Without a limit the read follows whatever the server sends, and
+     * a server that never stops sending is answered by growing a string until the browser dies.
+     */
+    private static final int MAX_FEED_BYTES = 512 * 1024;
+
+    /**
+     * A whole release tag in Bare's scheme, anchored.
+     *
+     * <p>The feed is read as text, so whatever sits between /releases/tag/ and the closing quote
+     * arrives here. Accepting only this shape is what keeps a tag from carrying ../ back up the
+     * path and sending the release row somewhere else on github.com, and it is also what keeps
+     * the numbers short enough for the parse below.
+     */
+    private static final Pattern TAG =
+            Pattern.compile("v\\d{1,4}\\.\\d{1,4}\\.\\d{1,4}(?:-[a-z]{1,12}\\.\\d{1,4})?");
+
     /** Matches the tag out of a feed entry link, for example .../releases/tag/v1.0.0-alpha.2 */
-    private static final Pattern TAG_IN_LINK = Pattern.compile("/releases/tag/([^\"']+)");
+    private static final Pattern TAG_IN_LINK =
+            Pattern.compile("/releases/tag/(" + TAG.pattern() + ")[\"']");
 
-    /** MAJOR.MINOR.PATCH with an optional -channel.N suffix, which is Bare's own scheme. */
+    /**
+     * MAJOR.MINOR.PATCH with an optional -channel.N suffix, which is Bare's own scheme.
+     *
+     * <p>Matched whole rather than searched for, and each run of digits is bounded. Searching
+     * accepted a version inside a longer string, so a number too big for an int still matched on
+     * one of its own substrings and came back as an enormous version rather than an unreadable
+     * one. Matching whole leaves it unreadable, which the ordering below already treats as older.
+     */
     private static final Pattern VERSION =
-            Pattern.compile("v?(\\d+)\\.(\\d+)\\.(\\d+)(?:-([a-z]+)\\.(\\d+))?");
+            Pattern.compile(
+                    "v?(\\d{1,9})\\.(\\d{1,9})\\.(\\d{1,9})(?:-([a-z]{1,12})\\.(\\d{1,9}))?");
 
     private BareUpdateCheck() {}
 
@@ -223,8 +261,11 @@ public class BareUpdateCheck {
             try (BufferedReader reader =
                     new BufferedReader(new InputStreamReader(connection.getInputStream()))) {
                 String line;
+                int read = 0;
                 // The feed is newest first, so the first tag link is the latest release.
                 while ((line = reader.readLine()) != null) {
+                    read += line.length() + 1;
+                    if (read > MAX_FEED_BYTES) return null;
                     Matcher matcher = TAG_IN_LINK.matcher(line);
                     if (matcher.find()) return matcher.group(1);
                 }
@@ -272,8 +313,8 @@ public class BareUpdateCheck {
     static int compare(String left, String right) {
         Matcher a = VERSION.matcher(left);
         Matcher b = VERSION.matcher(right);
-        if (!a.find()) return -1;
-        if (!b.find()) return 1;
+        if (!a.matches()) return -1;
+        if (!b.matches()) return 1;
         for (int group = 1; group <= 3; group++) {
             int diff =
                     Integer.compare(

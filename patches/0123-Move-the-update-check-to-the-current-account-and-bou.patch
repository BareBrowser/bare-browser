+package org.chromium.chrome.browser.bare;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertTrue;
+
+import org.junit.Test;
+import org.junit.runner.RunWith;
+
+import org.chromium.base.test.BaseRobolectricTestRunner;
+
+/** Unit tests for the version ordering and the release URL the update check builds. */
+@RunWith(BaseRobolectricTestRunner.class)
+public class BareUpdateCheckUnitTest {
+
+    @Test
+    public void testOrdersReleases() {
+        assertTrue(BareUpdateCheck.compare("v1.0.1", "v1.0.0") > 0);
+        assertTrue(BareUpdateCheck.compare("v1.1.0", "v1.0.9") > 0);
+        assertTrue(BareUpdateCheck.compare("v2.0.0", "v1.9.9") > 0);
+        assertEquals(0, BareUpdateCheck.compare("v1.0.0", "1.0.0"));
+    }
+
+    @Test
+    public void testReleaseOutranksItsPrerelease() {
+        assertTrue(BareUpdateCheck.compare("v1.0.0", "v1.0.0-alpha.9") > 0);
+        assertTrue(BareUpdateCheck.compare("v1.0.0-beta.1", "v1.0.0-alpha.1") > 0);
+        assertTrue(BareUpdateCheck.compare("v1.0.0-alpha.2", "v1.0.0-alpha.1") > 0);
+    }
+
+    @Test
+    public void testUnreadableVersionSortsOlder() {
+        assertTrue(BareUpdateCheck.compare("not-a-version", "v1.0.0") < 0);
+        assertTrue(BareUpdateCheck.compare("v1.0.0", "not-a-version") > 0);
+    }
+
+    /**
+     * A run of digits long enough to overflow an int used to throw out of the callback.
+     *
+     * <p>It now reads as unreadable rather than as an enormous version, so it sorts as older and
+     * never offers itself as an update.
+     */
+    @Test
+    public void testOverlongNumberSortsOlderAndDoesNotThrow() {
+        assertTrue(BareUpdateCheck.compare("v99999999999.0.0", "v1.0.0") < 0);
+        assertTrue(BareUpdateCheck.compare("v1.0.0-alpha.99999999999", "v1.0.0-alpha.1") < 0);
+    }
+
+    /** A version inside a longer string is not a version. */
+    @Test
+    public void testVersionMustBeTheWholeString() {
+        assertTrue(BareUpdateCheck.compare("release-v9.0.0-notes", "v1.0.0") < 0);
+    }
+
+    @Test
+    public void testReleasePageUsesTheTag() {
+        assertEquals(
+                "https://github.com/BareBrowser/bare-browser/releases/tag/v1.0.0-alpha.2",
+                BareUpdateCheck.releasePageFor("v1.0.0-alpha.2"));
+    }
+
+    /** A tag that is not one falls back to the releases page rather than building a path from it. */
+    @Test
+    public void testReleasePageRefusesAnythingElse() {
+        assertEquals(BareUpdateCheck.RELEASES_PAGE, BareUpdateCheck.releasePageFor("../../evil"));
+        assertEquals(
+                BareUpdateCheck.RELEASES_PAGE,
+                BareUpdateCheck.releasePageFor("v1.0.0/../../../other/releases/tag/v1"));
+        assertEquals(BareUpdateCheck.RELEASES_PAGE, BareUpdateCheck.releasePageFor(""));
+    }
+
+    @Test
+    public void testReleaseUrlsPointAtTheCurrentAccount() {
+        assertTrue(BareUpdateCheck.RELEASES_PAGE.startsWith(
+                "https://github.com/BareBrowser/bare-browser/"));
+    }
+}

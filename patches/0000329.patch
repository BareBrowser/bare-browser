@@ -0,0 +1,293 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/bare/backup/backup_extensions_browser.h"
+
+#include <utility>
+
+#include "base/barrier_callback.h"
+#include "base/files/file_enumerator.h"
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/functional/bind.h"
+#include "base/json/json_reader.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/task/thread_pool.h"
+#include "chrome/browser/profiles/profile.h"
+#include "extensions/browser/crx_installer.h"
+#include "extensions/browser/extension_registry.h"
+#include "extensions/browser/install/crx_install_error.h"
+#include "extensions/common/extension.h"
+#include "extensions/common/manifest.h"
+#include "extensions/common/manifest_handlers/manifest_url_handlers.h"
+#include "extensions/common/permissions/permission_message.h"
+#include "extensions/common/permissions/permissions_data.h"
+
+namespace bare::backup {
+
+namespace {
+
+using extensions::Extension;
+using extensions::Manifest;
+using extensions::mojom::ManifestLocation;
+
+// Leaves room in a 64 MB package for everything else.
+constexpr uint64_t kMaxFolderBytes = 48 * 1024 * 1024;
+constexpr int64_t kMaxFileBytes = 16 * 1024 * 1024;
+constexpr size_t kMaxFolderFiles = 1500;
+constexpr size_t kMaxManifestDepth = 32;
+
+struct FolderToRead {
+  std::string id;
+  base::FilePath path;
+};
+
+// Reads each folder whole or not at all.
+CollectedExtensions ReadFolders(CollectedExtensions collected,
+                                std::vector<FolderToRead> folders) {
+  for (const FolderToRead& folder : folders) {
+    std::map<std::string, std::string> files;
+    uint64_t total = 0;
+    bool fits = true;
+    base::FileEnumerator walk(folder.path, /*recursive=*/true,
+                              base::FileEnumerator::FILES);
+    for (base::FilePath path = walk.Next(); fits && !path.empty();
+         path = walk.Next()) {
+      base::FilePath relative;
+      if (base::IsLink(path) || !folder.path.AppendRelativePath(path, &relative)) {
+        continue;
+      }
+      const std::string relative_name = relative.AsUTF8Unsafe();
+      if (!ShouldCopyExtensionFile(relative_name)) {
+        continue;
+      }
+      const std::string name = ExtensionFilesPrefix(folder.id) + relative_name;
+      std::string contents;
+      if (!IsSafeEntryName(name) || files.size() >= kMaxFolderFiles ||
+          walk.GetInfo().GetSize() > kMaxFileBytes ||
+          !base::ReadFileToStringWithMaxSize(path, &contents, kMaxFileBytes)) {
+        fits = false;
+        break;
+      }
+      total += contents.size();
+      fits = total <= kMaxFolderBytes;
+      files.emplace(name, std::move(contents));
+    }
+    for (ExtensionRecord& record : collected.records) {
+      if (record.id == folder.id) {
+        record.files = fits && !files.empty();
+      }
+    }
+    if (fits && !files.empty()) {
+      collected.files.merge(files);
+    } else {
+      collected.too_large.push_back(folder.id);
+    }
+  }
+  return collected;
+}
+
+std::vector<std::u16string> PermissionsOf(const Extension& extension) {
+  std::vector<std::u16string> permissions;
+  for (const extensions::PermissionMessage& message :
+       extension.permissions_data()->GetPermissionMessages()) {
+    permissions.push_back(message.message());
+  }
+  return permissions;
+}
+
+// The folder written out for the installer, or an empty path on failure.
+base::FilePath WriteFolder(base::FilePath profile_path,
+                           std::map<std::string, std::string> files) {
+  base::FilePath dir;
+  if (!base::CreateTemporaryDirInDir(profile_path, "BareRestore", &dir)) {
+    return base::FilePath();
+  }
+  for (const auto& [relative, contents] : files) {
+    const base::FilePath path = dir.Append(base::FilePath::FromUTF8Unsafe(relative));
+    if (path.ReferencesParent() || !dir.IsParent(path) ||
+        !base::CreateDirectory(path.DirName()) ||
+        !base::WriteFile(path, contents)) {
+      base::DeletePathRecursively(dir);
+      return base::FilePath();
+    }
+  }
+  return dir;
+}
+
+void StartInstall(base::WeakPtr<Profile> profile,
+                  std::string id,
+                  std::string public_key,
+                  base::OnceCallback<void(std::pair<std::string, std::string>)>
+                      done,
+                  base::FilePath dir) {
+  if (dir.empty() || !profile) {
+    std::move(done).Run({id, "Bare couldn't write the extension's files."});
+    return;
+  }
+  scoped_refptr<extensions::CrxInstaller> installer =
+      extensions::CrxInstaller::CreateSilent(profile.get());
+  installer->set_allow_silent_install(true);
+  installer->set_expected_id(id);
+  installer->set_install_immediately(true);
+  // The folder comes from a file or another phone, so nothing vouches for
+  // where its code came from.
+  installer->set_is_gallery_install(false);
+  installer->AddInstallerCallback(base::BindOnce(
+      [](std::string id,
+         base::OnceCallback<void(std::pair<std::string, std::string>)> done,
+         const std::optional<extensions::CrxInstallError>& error) {
+        std::move(done).Run(
+            {id, error ? base::UTF16ToUTF8(error->message()) : std::string()});
+      },
+      id, std::move(done)));
+  installer->InstallUnpackedCrx(id, public_key, dir);
+}
+
+}  // namespace
+
+ExtensionReviewItem::ExtensionReviewItem() = default;
+ExtensionReviewItem::ExtensionReviewItem(const ExtensionReviewItem&) = default;
+ExtensionReviewItem& ExtensionReviewItem::operator=(
+    const ExtensionReviewItem&) = default;
+ExtensionReviewItem::~ExtensionReviewItem() = default;
+
+void CollectExtensions(Profile* profile,
+                       bool with_files,
+                       base::OnceCallback<void(CollectedExtensions)> done) {
+  CollectedExtensions collected;
+  std::vector<FolderToRead> folders;
+  const extensions::ExtensionSet installed =
+      extensions::ExtensionRegistry::Get(profile)
+          ->GenerateInstalledExtensionsSet();
+  for (const scoped_refptr<const Extension>& extension : installed) {
+    const ManifestLocation location = extension->location();
+    if (extension->id() == kBundledUboId ||
+        Manifest::IsComponentLocation(location) ||
+        Manifest::IsExternalLocation(location) ||
+        Manifest::IsPolicyLocation(location)) {
+      continue;
+    }
+    ExtensionRecord record;
+    if (location == ManifestLocation::kInternal) {
+      record.kind = ExtensionKind::kCrx;
+    } else if (Manifest::IsUnpackedLocation(location)) {
+      record.kind = ExtensionKind::kUnpacked;
+    } else {
+      continue;
+    }
+    record.id = extension->id();
+    record.name = extension->name();
+    record.version = extension->VersionString();
+    const GURL& update_url =
+        extensions::ManifestURL::GetUpdateURL(extension.get());
+    if (update_url.is_valid()) {
+      record.update_url = update_url.spec();
+    }
+    record.from_webstore = extension->from_webstore();
+    for (const std::u16string& permission : PermissionsOf(*extension)) {
+      record.permissions.push_back(base::UTF16ToUTF8(permission));
+    }
+    if (with_files && record.kind == ExtensionKind::kCrx) {
+      folders.push_back({record.id, extension->path()});
+    }
+    collected.records.push_back(std::move(record));
+  }
+
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE,
+      {base::MayBlock(), base::TaskPriority::USER_VISIBLE,
+       base::TaskShutdownBehavior::CONTINUE_ON_SHUTDOWN},
+      base::BindOnce(&ReadFolders, std::move(collected), std::move(folders)),
+      std::move(done));
+}
+
+std::vector<ExtensionReviewItem> DescribeExtensionsForRestore(
+    Profile* profile,
+    const Package& package,
+    const PackageSummary& summary) {
+  extensions::ExtensionRegistry* registry =
+      extensions::ExtensionRegistry::Get(profile);
+  size_t skipped = 0;
+  std::vector<ExtensionReviewItem> items;
+  for (ExtensionRecord& record : ReadExtensionList(package, summary, skipped)) {
+    ExtensionReviewItem item;
+    item.installed_here = registry->GetInstalledExtension(record.id);
+    for (const std::string& permission : record.permissions) {
+      item.permissions.push_back(base::UTF8ToUTF16(permission));
+    }
+    if (record.files) {
+      auto files = ExtensionFilesForRestore(package, summary.kind, record);
+      if (!files.has_value()) {
+        item.problem = files.error();
+      } else {
+        // Read what the folder itself asks for, rather than trusting the
+        // list.
+        std::optional<base::DictValue> manifest = base::JSONReader::ReadDict(
+            files->files.at("manifest.json"), base::JSON_ALLOW_TRAILING_COMMAS,
+            kMaxManifestDepth);
+        std::u16string error;
+        scoped_refptr<Extension> extension =
+            manifest ? Extension::Create(
+                           profile->GetPath().AppendASCII("BareRestore"),
+                           ManifestLocation::kInternal, *manifest,
+                           Extension::REQUIRE_KEY, &error)
+                     : nullptr;
+        if (!extension || extension->id() != record.id) {
+          item.problem = ExtensionFilesError::kBadManifest;
+        } else {
+          item.permissions = PermissionsOf(*extension);
+        }
+      }
+    }
+    item.record = std::move(record);
+    items.push_back(std::move(item));
+  }
+  return items;
+}
+
+void InstallExtensions(Profile* profile,
+                       const Package& package,
+                       const PackageSummary& summary,
+                       const std::vector<std::string>& approved_ids,
+                       base::OnceCallback<void(ExtensionInstallResults)> done) {
+  struct Job {
+    ExtensionRecord record;
+    ExtensionFiles files;
+  };
+  std::vector<Job> jobs;
+  for (const ExtensionReviewItem& item :
+       DescribeExtensionsForRestore(profile, package, summary)) {
+    if (!item.CanInstall() ||
+        std::ranges::find(approved_ids, item.record.id) == approved_ids.end()) {
+      continue;
+    }
+    auto files = ExtensionFilesForRestore(package, summary.kind, item.record);
+    if (files.has_value()) {
+      jobs.push_back({item.record, std::move(*files)});
+    }
+  }
+
+  auto barrier = base::BarrierCallback<std::pair<std::string, std::string>>(
+      jobs.size(),
+      base::BindOnce(
+          [](base::OnceCallback<void(ExtensionInstallResults)> done,
+             std::vector<std::pair<std::string, std::string>> results) {
+            std::move(done).Run(
+                ExtensionInstallResults(results.begin(), results.end()));
+          },
+          std::move(done)));
+  for (Job& job : jobs) {
+    base::ThreadPool::PostTaskAndReplyWithResult(
+        FROM_HERE,
+        {base::MayBlock(), base::TaskPriority::USER_VISIBLE,
+         base::TaskShutdownBehavior::SKIP_ON_SHUTDOWN},
+        base::BindOnce(&WriteFolder, profile->GetPath(),
+                       std::move(job.files.files)),
+        base::BindOnce(&StartInstall, profile->GetWeakPtr(), job.record.id,
+                       job.files.public_key, barrier));
+  }
+}
+
+}  // namespace bare::backup

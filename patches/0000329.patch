+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_BARE_BACKUP_BACKUP_EXTENSIONS_H_
+#define CHROME_BROWSER_BARE_BACKUP_BACKUP_EXTENSIONS_H_
+
+#include <stddef.h>
+
+#include <map>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/types/expected.h"
+#include "base/values.h"
+#include "chrome/browser/bare/backup/backup_file.h"
+#include "chrome/browser/bare/backup/backup_package.h"
+
+// Extensions in a package:
+//
+//   setup/extensions.json       the list, in every kind of package:
+//     {"extensions": [{"id": "...", "name": "...", "version": "1.2",
+//                      "kind": "crx" | "unpacked", "update_url": "...",
+//                      "from_webstore": false, "files": true,
+//                      "permissions": ["Read your browsing history"]}]}
+//   setup/extensions/<id>/...   the installed folder of a "crx" extension, in
+//                               full packages only
+//
+// A restored folder isn't signature-checked: its ID comes from the key in its
+// manifest. So files are only taken from a full package, which the user's
+// code protects, and the key must hash to the listed ID. Extension storage
+// and settings are never in a package.
+namespace bare::backup {
+
+// The bundled uBlock Origin. Bare installs it itself, so a package never
+// carries it and a restore refuses anything claiming its ID.
+inline constexpr char kBundledUboId[] = "fkgkibajhfbepljeaefdnfnegdcjomkh";
+
+inline constexpr size_t kMaxListedExtensions = 500;
+
+enum class ExtensionKind {
+  // Installed from a CRX. Its folder can travel.
+  kCrx,
+  // Loaded from a folder in developer mode. Listed by name only.
+  kUnpacked,
+};
+
+struct ExtensionRecord {
+  ExtensionRecord();
+  ExtensionRecord(const ExtensionRecord&);
+  ExtensionRecord& operator=(const ExtensionRecord&);
+  ~ExtensionRecord();
+
+  std::string id;
+  std::string name;
+  std::string version;
+  ExtensionKind kind = ExtensionKind::kCrx;
+  // Where updates come from, which is also the best answer Bare has to
+  // "where did this come from": it doesn't record the download URL.
+  std::string update_url;
+  bool from_webstore = false;
+  // Whether the package carries the folder.
+  bool files = false;
+  // Permission messages when the backup was made, for a setup restore that
+  // can only list the extension.
+  std::vector<std::string> permissions;
+};
+
+// What a backup collected from the profile: the list, and for a full backup
+// the files, keyed by package path.
+struct CollectedExtensions {
+  CollectedExtensions();
+  CollectedExtensions(CollectedExtensions&&);
+  CollectedExtensions& operator=(CollectedExtensions&&);
+  ~CollectedExtensions();
+
+  std::vector<ExtensionRecord> records;
+  std::map<std::string, std::string> files;
+  // Extensions whose folder didn't fit in a package; listed without files.
+  std::vector<std::string> too_large;
+};
+
+// Whether a file of an installed folder goes in a package. Chromium's own
+// _metadata (hashes, verified contents, indexed rulesets) is rebuilt on
+// install and stays behind.
+bool ShouldCopyExtensionFile(std::string_view relative_path);
+
+// "setup/extensions/<id>/".
+std::string ExtensionFilesPrefix(std::string_view id);
+
+base::DictValue ExtensionListToJson(const std::vector<ExtensionRecord>& list);
+
+// Entries that fail a check are dropped and counted in `skipped`. In a setup
+// package every record comes back with `files` false.
+std::vector<ExtensionRecord> ExtensionListFromJson(const base::DictValue& json,
+                                                   Kind package_kind,
+                                                   size_t& skipped);
+
+enum class ExtensionFilesError {
+  kSetupPackage,
+  kNotCrx,
+  kBundled,
+  kNoFiles,
+  kNoManifest,
+  kBadManifest,
+  kNoKey,
+  kKeyMismatch,
+  kVersionMismatch,
+};
+
+struct ExtensionFiles {
+  ExtensionFiles();
+  ExtensionFiles(ExtensionFiles&&);
+  ExtensionFiles& operator=(ExtensionFiles&&);
+  ~ExtensionFiles();
+
+  // Base64 DER, as the installed manifest carries it.
+  std::string public_key;
+  // Path inside the extension folder to contents, without _metadata.
+  std::map<std::string, std::string> files;
+};
+
+// The folder for `record` from a full package, after the checks a restore
+// needs before handing it to the installer: the record is a CRX extension
+// other than the bundled uBO, its manifest parses, carries a key that hashes
+// to the ID, and has the listed version.
+base::expected<ExtensionFiles, ExtensionFilesError> ExtensionFilesForRestore(
+    const Package& package,
+    Kind package_kind,
+    const ExtensionRecord& record);
+
+}  // namespace bare::backup
+
+#endif  // CHROME_BROWSER_BARE_BACKUP_BACKUP_EXTENSIONS_H_

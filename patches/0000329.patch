new file mode 100644
index 00000000000..3a2076fbf5e
--- /dev/null
+++ b/chrome/browser/bare/backup/backup_extensions.cc
@@ -0,0 +1,200 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/bare/backup/backup_extensions.h"
+
+#include <set>
+#include <utility>
+
+#include "base/base64.h"
+#include "base/json/json_reader.h"
+#include "base/strings/strcat.h"
+#include "base/strings/string_util.h"
+#include "components/crx_file/id_util.h"
+#include "url/gurl.h"
+
+namespace bare::backup {
+
+namespace {
+
+constexpr char kMetadataFolder[] = "_metadata/";
+constexpr size_t kMaxNameLength = 1024;
+constexpr size_t kMaxPermissions = 100;
+constexpr size_t kMaxManifestDepth = 32;
+
+const char* KindName(ExtensionKind kind) {
+  return kind == ExtensionKind::kUnpacked ? "unpacked" : "crx";
+}
+
+// IdIsValid() also takes upper case, which Chromium never writes. Only the
+// lower-case form compares equal to the bundled uBO's ID and to the ID the
+// installer derives from the key.
+bool IsLowerCaseId(const std::string& id) {
+  return crx_file::id_util::IdIsValid(id) && id == base::ToLowerASCII(id);
+}
+
+bool IsShortString(const std::string* text) {
+  return text && text->size() <= kMaxNameLength;
+}
+
+}  // namespace
+
+ExtensionRecord::ExtensionRecord() = default;
+ExtensionRecord::ExtensionRecord(const ExtensionRecord&) = default;
+ExtensionRecord& ExtensionRecord::operator=(const ExtensionRecord&) = default;
+ExtensionRecord::~ExtensionRecord() = default;
+
+CollectedExtensions::CollectedExtensions() = default;
+CollectedExtensions::CollectedExtensions(CollectedExtensions&&) = default;
+CollectedExtensions& CollectedExtensions::operator=(CollectedExtensions&&) =
+    default;
+CollectedExtensions::~CollectedExtensions() = default;
+
+ExtensionFiles::ExtensionFiles() = default;
+ExtensionFiles::ExtensionFiles(ExtensionFiles&&) = default;
+ExtensionFiles& ExtensionFiles::operator=(ExtensionFiles&&) = default;
+ExtensionFiles::~ExtensionFiles() = default;
+
+bool ShouldCopyExtensionFile(std::string_view relative_path) {
+  return !relative_path.empty() && !relative_path.starts_with(kMetadataFolder);
+}
+
+std::string ExtensionFilesPrefix(std::string_view id) {
+  return base::StrCat({kExtensionFilesPrefix, id, "/"});
+}
+
+base::DictValue ExtensionListToJson(const std::vector<ExtensionRecord>& list) {
+  base::ListValue extensions;
+  for (const ExtensionRecord& record : list) {
+    base::ListValue permissions;
+    for (const std::string& permission : record.permissions) {
+      permissions.Append(permission);
+    }
+    base::DictValue json;
+    json.Set("id", record.id);
+    json.Set("name", record.name);
+    json.Set("version", record.version);
+    json.Set("kind", KindName(record.kind));
+    json.Set("update_url", record.update_url);
+    json.Set("from_webstore", record.from_webstore);
+    json.Set("files", record.files);
+    json.Set("permissions", std::move(permissions));
+    extensions.Append(std::move(json));
+  }
+  base::DictValue json;
+  json.Set("extensions", std::move(extensions));
+  return json;
+}
+
+std::vector<ExtensionRecord> ExtensionListFromJson(const base::DictValue& json,
+                                                   Kind package_kind,
+                                                   size_t& skipped) {
+  std::vector<ExtensionRecord> records;
+  skipped = 0;
+  const base::ListValue* list = json.FindList("extensions");
+  if (!list) {
+    return records;
+  }
+  std::set<std::string> seen;
+  for (const base::Value& value : *list) {
+    const base::DictValue* entry = value.GetIfDict();
+    const std::string* id = entry ? entry->FindString("id") : nullptr;
+    const std::string* name = entry ? entry->FindString("name") : nullptr;
+    const std::string* version =
+        entry ? entry->FindString("version") : nullptr;
+    const std::string* kind = entry ? entry->FindString("kind") : nullptr;
+    if (records.size() >= kMaxListedExtensions || !id ||
+        !IsLowerCaseId(*id) || *id == kBundledUboId ||
+        !seen.insert(*id).second || !IsShortString(name) ||
+        !IsShortString(version) || !kind ||
+        (*kind != "crx" && *kind != "unpacked")) {
+      ++skipped;
+      continue;
+    }
+    ExtensionRecord record;
+    record.id = *id;
+    record.name = *name;
+    record.version = *version;
+    record.kind =
+        *kind == "unpacked" ? ExtensionKind::kUnpacked : ExtensionKind::kCrx;
+    if (const std::string* url = entry->FindString("update_url")) {
+      const GURL update_url(*url);
+      if (update_url.is_valid() && update_url.SchemeIsHTTPOrHTTPS()) {
+        record.update_url = update_url.spec();
+      }
+    }
+    // Anyone can write a file, so it never decides that an extension came
+    // from the store. Restored extensions are installed as from elsewhere.
+    record.from_webstore = false;
+    record.files = package_kind == Kind::kFull &&
+                   record.kind == ExtensionKind::kCrx &&
+                   entry->FindBool("files").value_or(false);
+    if (const base::ListValue* permissions = entry->FindList("permissions")) {
+      for (const base::Value& permission : *permissions) {
+        if (permission.is_string() &&
+            IsShortString(&permission.GetString()) &&
+            record.permissions.size() < kMaxPermissions) {
+          record.permissions.push_back(permission.GetString());
+        }
+      }
+    }
+    records.push_back(std::move(record));
+  }
+  return records;
+}
+
+base::expected<ExtensionFiles, ExtensionFilesError> ExtensionFilesForRestore(
+    const Package& package,
+    Kind package_kind,
+    const ExtensionRecord& record) {
+  if (package_kind != Kind::kFull) {
+    return base::unexpected(ExtensionFilesError::kSetupPackage);
+  }
+  if (record.kind != ExtensionKind::kCrx) {
+    return base::unexpected(ExtensionFilesError::kNotCrx);
+  }
+  if (base::ToLowerASCII(record.id) == kBundledUboId) {
+    return base::unexpected(ExtensionFilesError::kBundled);
+  }
+
+  ExtensionFiles result;
+  const std::string prefix = ExtensionFilesPrefix(record.id);
+  for (auto it = package.lower_bound(prefix);
+       it != package.end() && it->first.starts_with(prefix); ++it) {
+    const std::string relative = it->first.substr(prefix.size());
+    if (ShouldCopyExtensionFile(relative)) {
+      result.files.emplace(relative, it->second);
+    }
+  }
+  if (result.files.empty()) {
+    return base::unexpected(ExtensionFilesError::kNoFiles);
+  }
+
+  auto manifest_file = result.files.find("manifest.json");
+  if (manifest_file == result.files.end()) {
+    return base::unexpected(ExtensionFilesError::kNoManifest);
+  }
+  std::optional<base::DictValue> manifest = base::JSONReader::ReadDict(
+      manifest_file->second, base::JSON_ALLOW_TRAILING_COMMAS,
+      kMaxManifestDepth);
+  if (!manifest) {
+    return base::unexpected(ExtensionFilesError::kBadManifest);
+  }
+  const std::string* key = manifest->FindString("key");
+  if (!key || key->empty()) {
+    return base::unexpected(ExtensionFilesError::kNoKey);
+  }
+  std::optional<std::vector<uint8_t>> key_bytes = base::Base64Decode(*key);
+  if (!key_bytes || crx_file::id_util::GenerateId(*key_bytes) != record.id) {
+    return base::unexpected(ExtensionFilesError::kKeyMismatch);
+  }
+  const std::string* version = manifest->FindString("version");
+  if (!version || *version != record.version) {
+    return base::unexpected(ExtensionFilesError::kVersionMismatch);
+  }
+  result.public_key = *key;
+  return result;
+}
+
+}  // namespace bare::backup

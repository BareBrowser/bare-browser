+// Adds the files of each listed extension that has them, all or none per
+// extension, and the list. Returns false only if the list itself won't fit.
+bool AddExtensions(PackageWriter& writer,
+                   Kind kind,
+                   const CollectedExtensions& collected,
+                   BuiltPackage& built) {
+  std::vector<ExtensionRecord> records = collected.records;
+  for (ExtensionRecord& record : records) {
+    if (std::ranges::find(collected.too_large, record.id) !=
+        collected.too_large.end()) {
+      built.extensions_too_large.push_back(record.id);
+    }
+    if (kind != Kind::kFull || !record.files) {
+      record.files = false;
+      continue;
+    }
+    const std::string prefix = ExtensionFilesPrefix(record.id);
+    size_t count = 0;
+    uint64_t bytes = 0;
+    for (auto it = collected.files.lower_bound(prefix);
+         it != collected.files.end() && it->first.starts_with(prefix); ++it) {
+      ++count;
+      bytes += it->second.size();
+    }
+    // Leave room for the list and the manifest.
+    if (count == 0 || count + 2 > writer.entries_left() ||
+        bytes + 1024 * 1024 > writer.bytes_left()) {
+      record.files = false;
+      built.extensions_too_large.push_back(record.id);
+      continue;
+    }
+    for (auto it = collected.files.lower_bound(prefix);
+         it != collected.files.end() && it->first.starts_with(prefix); ++it) {
+      if (!writer.Add(it->first, it->second)) {
+        // A name the reader would refuse. The extension goes without files;
+        // the ones already added are harmless, as nothing reads them unless
+        // the record says so.
+        record.files = false;
+        break;
+      }
+    }
+  }
+  built.counts["extensions"] = static_cast<int>(records.size());
+  return AddJson(writer, kSetupExtensions, ExtensionListToJson(records));
+}

+// One CRX extension with its folder, one unpacked, as a backup collects them.
+CollectedExtensions TestExtensions(std::string& crx_id,
+                                   size_t big_file_size = 0) {
+  std::vector<uint8_t> spki =
+      crypto::keypair::PrivateKey::GenerateRsa2048().ToSubjectPublicKeyInfo();
+  crx_id = crx_file::id_util::GenerateId(spki);
+  CollectedExtensions collected;
+  ExtensionRecord crx;
+  crx.id = crx_id;
+  crx.name = "Crx";
+  crx.version = "1.0";
+  crx.files = true;
+  ExtensionRecord unpacked;
+  unpacked.id = std::string(32, 'p');
+  unpacked.name = "Unpacked";
+  unpacked.version = "0.1";
+  unpacked.kind = ExtensionKind::kUnpacked;
+  collected.records = {crx, unpacked};
+
+  base::DictValue manifest;
+  manifest.Set("name", "Crx");
+  manifest.Set("version", "1.0");
+  manifest.Set("key", base::Base64Encode(spki));
+  const std::string prefix = ExtensionFilesPrefix(crx_id);
+  collected.files[prefix + "manifest.json"] = *base::WriteJson(manifest);
+  collected.files[prefix + "a b/c.js"] = "x";
+  if (big_file_size) {
+    collected.files[prefix + "big.bin"] = std::string(big_file_size, 'z');
+  }
+  return collected;
+}
+
+TEST_F(BackupContentsTest, ExtensionsInPackages) {
+  std::string crx_id;
+  const CollectedExtensions collected = TestExtensions(crx_id);
+  Sources sources = old_phone_.sources();
+  sources.extensions = &collected;
+
+  // Full: the list, and the CRX extension's folder.
+  Package full =
+      ThroughFile(Kind::kFull, *BuildPackage(Kind::kFull, sources));
+  auto summary = ReadManifest(full, Kind::kFull);
+  ASSERT_TRUE(summary.has_value());
+  EXPECT_NE(std::ranges::find(summary->sections, "extensions"),
+            summary->sections.end());
+  size_t skipped = 0;
+  std::vector<ExtensionRecord> list =
+      ReadExtensionList(full, *summary, skipped);
+  ASSERT_EQ(list.size(), 2u);
+  EXPECT_TRUE(list[0].files);
+  EXPECT_FALSE(list[1].files);
+  EXPECT_TRUE(ExtensionFilesForRestore(full, Kind::kFull, list[0]).has_value());
+  RestoreReport report = RestorePackage(full, *summary, RestoreChoices(),
+                                        new_phone_.sources(), u"Restored");
+  EXPECT_TRUE(report.ignored_entries.empty());
+
+  // Setup: the list only.
+  Package setup =
+      ThroughFile(Kind::kSetup, *BuildPackage(Kind::kSetup, sources));
+  for (const auto& [name, contents] : setup) {
+    EXPECT_FALSE(name.starts_with("setup/extensions/")) << name;
+  }
+  summary = ReadManifest(setup, Kind::kSetup);
+  list = ReadExtensionList(setup, *summary, skipped);
+  ASSERT_EQ(list.size(), 2u);
+  EXPECT_FALSE(list[0].files);
+}
+
+TEST_F(BackupContentsTest, ExtensionTooBigGoesWithoutFiles) {
+  std::string crx_id;

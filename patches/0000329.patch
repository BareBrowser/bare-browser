+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_BARE_BACKUP_BACKUP_EXTENSIONS_BROWSER_H_
+#define CHROME_BROWSER_BARE_BACKUP_BACKUP_EXTENSIONS_BROWSER_H_
+
+#include <map>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/functional/callback_forward.h"
+#include "chrome/browser/bare/backup/backup_contents.h"
+#include "chrome/browser/bare/backup/backup_extensions.h"
+
+class Profile;
+
+// The part of extension backup that talks to the profile's extension system.
+// All functions are called on the UI thread.
+namespace bare::backup {
+
+// Lists the profile's extensions: CRX installs, and unpacked ones by name.
+// The bundled uBO, component, external and policy extensions are left out.
+// With `with_files`, also reads each CRX extension's installed folder, off the
+// UI thread. Folders that won't fit a package are listed in `too_large`.
+void CollectExtensions(Profile* profile,
+                       bool with_files,
+                       base::OnceCallback<void(CollectedExtensions)> done);
+
+struct ExtensionReviewItem {
+  ExtensionReviewItem();
+  ExtensionReviewItem(const ExtensionReviewItem&);
+  ExtensionReviewItem& operator=(const ExtensionReviewItem&);
+  ~ExtensionReviewItem();
+
+  ExtensionRecord record;
+  bool installed_here = false;
+  // Why the folder can't be installed, when the package carries one.
+  std::optional<ExtensionFilesError> problem;
+  // From the folder's manifest when there is one, otherwise as listed.
+  std::vector<std::u16string> permissions;
+
+  bool CanInstall() const {
+    return record.files && !installed_here && !problem;
+  }
+};
+
+// One entry per listed extension, for the review screen.
+std::vector<ExtensionReviewItem> DescribeExtensionsForRestore(
+    Profile* profile,
+    const Package& package,
+    const PackageSummary& summary);
+
+// Extension ID to an error message, empty on success.
+using ExtensionInstallResults = std::map<std::string, std::string>;
+
+// Installs the approved extensions that CanInstall(), under their own IDs,
+// as normal installs so they keep updating. The review screen was the
+// permission prompt, so the installer shows none. Each folder is written to a
+// temporary directory in the profile, which the installer takes over.
+void InstallExtensions(Profile* profile,
+                       const Package& package,
+                       const PackageSummary& summary,
+                       const std::vector<std::string>& approved_ids,
+                       base::OnceCallback<void(ExtensionInstallResults)> done);
+
+}  // namespace bare::backup
+
+#endif  // CHROME_BROWSER_BARE_BACKUP_BACKUP_EXTENSIONS_BROWSER_H_

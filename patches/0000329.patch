@@ -0,0 +1,225 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/bare/backup/backup_extensions.h"
+
+#include <string>
+#include <vector>
+
+#include "base/base64.h"
+#include "base/json/json_writer.h"
+#include "base/strings/strcat.h"
+#include "components/crx_file/id_util.h"
+#include "crypto/keypair.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace bare::backup {
+namespace {
+
+struct TestKey {
+  TestKey() {
+    std::vector<uint8_t> spki =
+        crypto::keypair::PrivateKey::GenerateRsa2048().ToSubjectPublicKeyInfo();
+    public_key = base::Base64Encode(spki);
+    id = crx_file::id_util::GenerateId(spki);
+  }
+  std::string public_key;
+  std::string id;
+};
+
+ExtensionRecord Record(const std::string& id,
+                       ExtensionKind kind = ExtensionKind::kCrx) {
+  ExtensionRecord record;
+  record.id = id;
+  record.name = "Test extension";
+  record.version = "1.2";
+  record.kind = kind;
+  record.update_url = "https://updates.example.test/updates.xml";
+  record.files = kind == ExtensionKind::kCrx;
+  record.permissions = {"Read and change your data on all websites"};
+  return record;
+}
+
+// An installed folder as a full package carries it.
+void AddFolder(Package& package,
+               const std::string& id,
+               const std::string& key,
+               const std::string& version = "1.2") {
+  base::DictValue manifest;
+  manifest.Set("name", "__MSG_name__");
+  manifest.Set("version", version);
+  manifest.Set("manifest_version", 2);
+  if (!key.empty()) {
+    manifest.Set("key", key);
+  }
+  const std::string prefix = ExtensionFilesPrefix(id);
+  package[prefix + "manifest.json"] = *base::WriteJson(manifest);
+  package[prefix + "background.js"] = "chrome.storage.local.set({a: 1});";
+  package[prefix + "img/icon@2x.png"] = "png";
+  package[prefix + "_metadata/verified_contents.json"] = "[]";
+}
+
+TEST(BackupExtensionsTest, CopyRule) {
+  EXPECT_TRUE(ShouldCopyExtensionFile("manifest.json"));
+  EXPECT_TRUE(ShouldCopyExtensionFile("js/_metadata/x.js"));
+  EXPECT_FALSE(ShouldCopyExtensionFile("_metadata/computed_hashes.json"));
+  EXPECT_FALSE(ShouldCopyExtensionFile(
+      "_metadata/generated_indexed_rulesets/_ruleset1"));
+  EXPECT_FALSE(ShouldCopyExtensionFile(""));
+}
+
+TEST(BackupExtensionsTest, ListRoundTrip) {
+  TestKey a, b;
+  std::vector<ExtensionRecord> list = {
+      Record(a.id), Record(b.id, ExtensionKind::kUnpacked)};
+  const base::DictValue json = ExtensionListToJson(list);
+
+  size_t skipped = 1;
+  std::vector<ExtensionRecord> full =
+      ExtensionListFromJson(json, Kind::kFull, skipped);
+  EXPECT_EQ(skipped, 0u);
+  ASSERT_EQ(full.size(), 2u);
+  EXPECT_EQ(full[0].id, a.id);
+  EXPECT_EQ(full[0].name, "Test extension");
+  EXPECT_EQ(full[0].version, "1.2");
+  EXPECT_EQ(full[0].update_url, "https://updates.example.test/updates.xml");
+  EXPECT_TRUE(full[0].files);
+  EXPECT_FALSE(full[0].from_webstore);
+  EXPECT_EQ(full[0].permissions, list[0].permissions);
+  EXPECT_EQ(full[1].kind, ExtensionKind::kUnpacked);
+  EXPECT_FALSE(full[1].files);
+
+  // A setup package never offers files, whatever the list says.
+  std::vector<ExtensionRecord> setup =
+      ExtensionListFromJson(json, Kind::kSetup, skipped);
+  EXPECT_FALSE(setup[0].files);
+}
+
+TEST(BackupExtensionsTest, StoreClaimIgnored) {
+  TestKey a;
+  ExtensionRecord record = Record(a.id);
+  record.from_webstore = true;
+  const base::DictValue json = ExtensionListToJson({record});
+  // The file says the store, as a backup made from a store install would.
+  const base::ListValue* written = json.FindList("extensions");
+  ASSERT_TRUE(written);
+  ASSERT_EQ(written->size(), 1u);
+  EXPECT_EQ((*written)[0].GetDict().FindBool("from_webstore"), true);
+  size_t skipped = 0;
+  std::vector<ExtensionRecord> read =
+      ExtensionListFromJson(json, Kind::kFull, skipped);
+  ASSERT_EQ(read.size(), 1u);
+  EXPECT_FALSE(read[0].from_webstore);
+}
+
+TEST(BackupExtensionsTest, BadListEntriesSkipped) {
+  TestKey a;
+  base::DictValue json = ExtensionListToJson({
+      Record(a.id),
+      Record(a.id),            // duplicate
+      Record(kBundledUboId),   // the bundled uBO
+      Record("not-an-id"),
+      Record("FKGKIBAJHFBEPLJEAEFDNFNEGDCJOMKH"),  // uBO in upper case
+  });
+  base::ListValue& list = *json.FindList("extensions");
+  base::DictValue odd_kind = list[0].GetDict().Clone();
+  odd_kind.Set("id", TestKey().id);
+  odd_kind.Set("kind", "theme");
+  list.Append(std::move(odd_kind));
+  base::DictValue bad_url = list[0].GetDict().Clone();
+  bad_url.Set("id", TestKey().id);
+  bad_url.Set("update_url", "javascript:alert(1)");
+  list.Append(std::move(bad_url));
+  list.Append("not an entry");
+
+  size_t skipped = 0;
+  std::vector<ExtensionRecord> records =
+      ExtensionListFromJson(json, Kind::kFull, skipped);
+  EXPECT_EQ(skipped, 6u);
+  ASSERT_EQ(records.size(), 2u);
+  EXPECT_EQ(records[0].id, a.id);
+  // A bad update URL is dropped, the extension kept.
+  EXPECT_EQ(records[1].update_url, "");
+}
+
+TEST(BackupExtensionsTest, FilesForRestore) {
+  TestKey a;
+  Package package;
+  AddFolder(package, a.id, a.public_key);
+  package["setup/settings.json"] = "{}";
+
+  auto files = ExtensionFilesForRestore(package, Kind::kFull, Record(a.id));
+  ASSERT_TRUE(files.has_value());
+  EXPECT_EQ(files->public_key, a.public_key);
+  EXPECT_EQ(files->files.size(), 3u);
+  EXPECT_TRUE(files->files.contains("img/icon@2x.png"));
+  EXPECT_FALSE(files->files.contains("_metadata/verified_contents.json"));
+}
+
+TEST(BackupExtensionsTest, FilesRefused) {
+  TestKey a, b;
+  Package package;
+  AddFolder(package, a.id, a.public_key);
+
+  EXPECT_EQ(ExtensionFilesForRestore(package, Kind::kSetup, Record(a.id))
+                .error(),
+            ExtensionFilesError::kSetupPackage);
+  EXPECT_EQ(ExtensionFilesForRestore(package, Kind::kFull,
+                                     Record(a.id, ExtensionKind::kUnpacked))
+                .error(),
+            ExtensionFilesError::kNotCrx);
+  EXPECT_EQ(ExtensionFilesForRestore(package, Kind::kFull,
+                                     Record(kBundledUboId))
+                .error(),
+            ExtensionFilesError::kBundled);
+  EXPECT_EQ(ExtensionFilesForRestore(package, Kind::kFull,
+                                     Record("FKGKIBAJHFBEPLJEAEFDNFNEGDCJOMKH"))
+                .error(),
+            ExtensionFilesError::kBundled);
+  EXPECT_EQ(
+      ExtensionFilesForRestore(package, Kind::kFull, Record(b.id)).error(),
+      ExtensionFilesError::kNoFiles);
+
+  // Someone else's code under this ID: the key hashes to another ID.
+  Package swapped;
+  AddFolder(swapped, a.id, b.public_key);
+  EXPECT_EQ(
+      ExtensionFilesForRestore(swapped, Kind::kFull, Record(a.id)).error(),
+      ExtensionFilesError::kKeyMismatch);
+
+  Package no_key;
+  AddFolder(no_key, a.id, "");
+  EXPECT_EQ(
+      ExtensionFilesForRestore(no_key, Kind::kFull, Record(a.id)).error(),
+      ExtensionFilesError::kNoKey);
+
+  Package bad_key = package;
+  bad_key[ExtensionFilesPrefix(a.id) + "manifest.json"] =
+      R"({"version": "1.2", "key": "not base64!"})";
+  EXPECT_EQ(
+      ExtensionFilesForRestore(bad_key, Kind::kFull, Record(a.id)).error(),
+      ExtensionFilesError::kKeyMismatch);
+
+  Package newer;
+  AddFolder(newer, a.id, a.public_key, "2.0");
+  EXPECT_EQ(
+      ExtensionFilesForRestore(newer, Kind::kFull, Record(a.id)).error(),
+      ExtensionFilesError::kVersionMismatch);
+
+  Package broken = package;
+  broken[ExtensionFilesPrefix(a.id) + "manifest.json"] = "{not json";
+  EXPECT_EQ(
+      ExtensionFilesForRestore(broken, Kind::kFull, Record(a.id)).error(),
+      ExtensionFilesError::kBadManifest);
+
+  Package only_metadata;
+  only_metadata[ExtensionFilesPrefix(a.id) + "_metadata/x"] = "x";
+  only_metadata[ExtensionFilesPrefix(a.id) + "background.js"] = "x";
+  EXPECT_EQ(ExtensionFilesForRestore(only_metadata, Kind::kFull, Record(a.id))
+                .error(),
+            ExtensionFilesError::kNoManifest);
+}

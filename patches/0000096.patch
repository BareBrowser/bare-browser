Subject: [PATCH] Patch 0000096

---
 gpu/command_buffer/service/service_utils.cc | 8 ++++++++
 gpu/config/gpu_info_collector.cc            | 8 ++++++++
 ui/gl/gl_context_egl.cc                     | 2 ++
 3 files changed, 18 insertions(+)

diff --git a/gpu/command_buffer/service/service_utils.cc b/gpu/command_buffer/service/service_utils.cc
index 75376d1c523..264299fa1d9 100644
--- a/gpu/command_buffer/service/service_utils.cc
+++ b/gpu/command_buffer/service/service_utils.cc
@@ -157,7 +157,15 @@ gl::GLContextAttribs GenerateGLContextAttribsForDecoder(
     if (IsWebGL2OrES3ContextType(context_type)) {
       attribs.client_major_es_version = 3;
       attribs.client_minor_es_version = 0;
+#if BUILDFLAG(IS_ANDROID)
+      // Bare: Android does not build SwiftShader, so there is no software
+      // renderer to fall back to. Refusing the version fallback only turns a
+      // driver that rejects ES3 into a dead GPU process; let GLContextEGL retry
+      // 3.1 -> 3.0 -> 2.0.
+      attribs.allow_es_version_fallback = true;
+#else
       attribs.allow_es_version_fallback = false;
+#endif
     } else {
       DCHECK(IsWebGL1OrES2ContextType(context_type));
       attribs.client_major_es_version = 2;
diff --git a/gpu/config/gpu_info_collector.cc b/gpu/config/gpu_info_collector.cc

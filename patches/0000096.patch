   TRACE_EVENT("gpu,startup", "gpu_info_collector::InitializeGLContext");
   gl::GLContextAttribs attribs;
+#if BUILDFLAG(IS_ANDROID)
+  // Bare: Android does not build SwiftShader, so there is no software renderer
+  // to fall back to. Refusing the version fallback only turns a driver that
+  // rejects ES3 into a dead GPU process; let GLContextEGL retry 3.1 -> 3.0 ->
+  // 2.0.
+  attribs.allow_es_version_fallback = true;
+#else
   attribs.allow_es_version_fallback = false;
+#endif
   scoped_refptr<gl::GLContext> context(
       gl::init::CreateGLContext(nullptr, surface, attribs));
   if (!context.get()) {

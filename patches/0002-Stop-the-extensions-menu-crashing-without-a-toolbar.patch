From 5909c721f63581c96bf5cb18405edb1eda3112e5 Mon Sep 17 00:00:00 2001
From: Bare <git@barebrowser.org>
Date: Sat, 15 Aug 2026 04:07:03 +0000
Subject: [PATCH] Stop the extensions menu crashing without a toolbar

The extensions toolbar coordinator is only created for Desktop Android, but extension support can still be enabled on a phone-sized layout. Guard against a null coordinator and fall back to opening the extension management page rather than crashing.
---
 .../chrome/browser/ChromeTabbedActivity.java  | 35 ++++++++++++++-----
 .../browser/ChromeTabbedActivityUnitTest.java | 15 ++++++++
 2 files changed, 41 insertions(+), 9 deletions(-)

diff --git a/chrome/android/java/src/org/chromium/chrome/browser/ChromeTabbedActivity.java b/chrome/android/java/src/org/chromium/chrome/browser/ChromeTabbedActivity.java
index 4e3ec193aaa..cf8d5ed1993 100644
--- a/chrome/android/java/src/org/chromium/chrome/browser/ChromeTabbedActivity.java
+++ b/chrome/android/java/src/org/chromium/chrome/browser/ChromeTabbedActivity.java
@@ -4662,17 +4662,15 @@ public class ChromeTabbedActivity extends ChromeActivity implements PreAttachInt
         } else if (id == R.id.extensions_menu_menu_id) {
             ExtensionsToolbarCoordinator coordinator =
                     getToolbarManager().getExtensionsToolbarCoordinator();
-            coordinator.showExtensionsMenu();
+            if (!showExtensionsMenu(coordinator)) {
+                // The extensions toolbar is currently only created for Desktop Android. Extension
+                // support can still be enabled on a phone-sized layout, so keep this menu action
+                // useful by opening the extension management page instead of crashing.
+                openManageExtensionsPage(currentTab);
+            }
             RecordUserAction.record("MobileMenuExtensionsMenu");
         } else if (id == R.id.manage_extensions_menu_id) {
-            LoadUrlParams params =
-                    new LoadUrlParams(
-                            UrlConstants.CHROME_EXTENSIONS_URL, PageTransition.AUTO_TOPLEVEL);
-            getTabCreator(/* incognito= */ false)
-                    .createNewTab(
-                            params,
-                            TabLaunchType.FROM_CHROME_UI,
-                            getCurrentTabModel().isIncognito() ? null : currentTab);
+            openManageExtensionsPage(currentTab);
             RecordUserAction.record("MobileMenuManageExtensions");
             Profile profile = mTabModelProfileSupplier.get();
             if (profile != null) {
@@ -4849,6 +4847,25 @@ public class ChromeTabbedActivity extends ChromeActivity implements PreAttachInt
         return true;
     }
 
+    @VisibleForTesting
+    static boolean showExtensionsMenu(@Nullable ExtensionsToolbarCoordinator coordinator) {
+        if (coordinator == null) {
+            return false;
+        }
+        coordinator.showExtensionsMenu();
+        return true;
+    }
+
+    private void openManageExtensionsPage(@Nullable Tab currentTab) {
+        LoadUrlParams params =
+                new LoadUrlParams(UrlConstants.CHROME_EXTENSIONS_URL, PageTransition.AUTO_TOPLEVEL);
+        getTabCreator(/* incognito= */ false)
+                .createNewTab(
+                        params,
+                        TabLaunchType.FROM_CHROME_UI,
+                        getCurrentTabModel().isIncognito() ? null : currentTab);
+    }
+
     private void openForeignSessionTab(String sessionTag, int tabId) {
         Profile profile = getTabModelSelector().getCurrentModel().getProfile();
         ForeignSessionHelper helper = new ForeignSessionHelper(profile);
diff --git a/chrome/android/junit/src/org/chromium/chrome/browser/ChromeTabbedActivityUnitTest.java b/chrome/android/junit/src/org/chromium/chrome/browser/ChromeTabbedActivityUnitTest.java
index 2f8206b5658..f3fe9828c69 100644
--- a/chrome/android/junit/src/org/chromium/chrome/browser/ChromeTabbedActivityUnitTest.java
+++ b/chrome/android/junit/src/org/chromium/chrome/browser/ChromeTabbedActivityUnitTest.java
@@ -46,6 +46,7 @@ import org.chromium.chrome.browser.tabmodel.IncognitoTabHostRegistry;
 import org.chromium.chrome.browser.tabmodel.TabModel;
 import org.chromium.chrome.browser.tabmodel.TabModelSelectorBase;
 import org.chromium.chrome.browser.tasks.tab_management.vertical_tabs.VerticalTabsActionDelegate;
+import org.chromium.chrome.browser.toolbar.extensions.ExtensionsToolbarCoordinator;
 
 /** Unit tests for {@link ChromeTabbedActivity}. */
 @RunWith(BaseRobolectricTestRunner.class)
@@ -358,4 +359,18 @@ public class ChromeTabbedActivityUnitTest {
         activity.onPreCreate();
         verify(activity).supportRequestWindowFeature(Window.FEATURE_ACTION_MODE_OVERLAY);
     }
+
+    @Test
+    public void showExtensionsMenu_nullCoordinatorReturnsFalse() {
+        assertFalse(ChromeTabbedActivity.showExtensionsMenu(null));
+    }
+
+    @Test
+    public void showExtensionsMenu_coordinatorShowsMenu() {
+        ExtensionsToolbarCoordinator coordinator = mock(ExtensionsToolbarCoordinator.class);
+
+        assertTrue(ChromeTabbedActivity.showExtensionsMenu(coordinator));
+
+        verify(coordinator).showExtensionsMenu();
+    }
 }

+package org.chromium.chrome.browser.bare;
+
+import android.app.Activity;
+import android.content.Context;
+import android.net.Uri;
+import android.widget.Toast;
+
+import androidx.appcompat.app.AlertDialog;
+
+import org.chromium.base.ApplicationStatus;
+import org.chromium.base.ContextUtils;
+import org.chromium.base.Log;
+import org.chromium.base.task.PostTask;
+import org.chromium.base.task.TaskTraits;
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.chrome.R;
+import org.chromium.chrome.browser.app.ChromeActivity;
+import org.chromium.chrome.browser.download.items.OfflineContentAggregatorFactory;
+import org.chromium.chrome.browser.tab.Tab;
+import org.chromium.chrome.browser.ui.extensions.ExtensionUtilBridge;
+import org.chromium.components.offline_items_collection.ContentId;
+import org.chromium.components.offline_items_collection.OfflineContentProvider;
+import org.chromium.components.offline_items_collection.OfflineItem;
+import org.chromium.components.offline_items_collection.OfflineItemState;
+import org.chromium.components.offline_items_collection.UpdateDelta;
+import org.chromium.content_public.browser.WebContents;
+
+import java.io.File;
+import java.io.FileInputStream;
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.OutputStream;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Locale;
+import java.util.Set;
+
+/**
+ * Offers to install an extension when a .crx file has finished downloading, so that one fetched
+ * from a project's release page is not left sitting in Downloads. Only a download that finishes
+ * while Bare is running is offered; the ones already there at startup are not. The install itself
+ * is the same one Load CRX uses, including its prompt, and nothing is installed without it.
+ */
+@NullMarked
+public final class BareCrxDownloadWatcher implements OfflineContentProvider.Observer {
+    private static final String TAG = "BareCrx";
+    private static final long MAX_BYTES = 256L * 1024 * 1024;
+    private static final String CRX_MIME = "application/x-chrome-extension";
+
+    private static @Nullable BareCrxDownloadWatcher sInstance;
+
+    private final Set<ContentId> mOffered = new HashSet<>();
+
+    private BareCrxDownloadWatcher() {}
+
+    /** Starts watching, once. Needs native code, since the download list lives there. */
+    public static void start(OfflineContentProvider provider) {
+        if (sInstance != null) return;
+        sInstance = new BareCrxDownloadWatcher();
+        provider.addObserver(sInstance);
+    }
+
+    /** Whether the item is a finished extension package. */
+    static boolean isFinishedCrx(OfflineItem item) {
+        if (item.state != OfflineItemState.COMPLETE) return false;
+        if (CRX_MIME.equals(item.mimeType)) return true;
+        // Release pages often serve the file as a generic download, so go by the name as well.
+        String path = item.filePath == null ? "" : item.filePath.toLowerCase(Locale.ROOT);
+        String title = item.title == null ? "" : item.title.toLowerCase(Locale.ROOT);
+        return path.endsWith(".crx") || title.endsWith(".crx");
+    }
+
+    @Override
+    public void onItemsAdded(List<OfflineItem> items) {}
+
+    @Override
+    public void onItemRemoved(ContentId id) {
+        mOffered.remove(id);
+    }
+
+    @Override
+    public void onItemUpdated(OfflineItem item, @Nullable UpdateDelta updateDelta) {
+        // Only the moment a download finishes, not a later update to one that already had.
+        if (updateDelta == null || !updateDelta.stateChanged) return;
+        if (!isFinishedCrx(item) || item.filePath == null || item.filePath.isEmpty()) return;
+        if (!mOffered.add(item.id)) return;
+        offer(item.id, item.title == null ? item.filePath : item.title, item.filePath);
+    }
+
+    /**
+     * Copies the downloaded file somewhere native code can read it, then installs from there. A
+     * download is often kept behind a content address that only Android's content resolver can
+     * open, so reading it by path from native code fails.
+     */
+    private static void install(WebContents webContents, String path) {
+        Context context = ContextUtils.getApplicationContext();
+        PostTask.postTask(
+                TaskTraits.BEST_EFFORT_MAY_BLOCK,
+                () -> {
+                    File copy = new File(context.getCacheDir(), "bare-crx-offer.crx");
+                    try (InputStream in = open(context, path);
+                            OutputStream out = new FileOutputStream(copy)) {
+                        byte[] buffer = new byte[64 * 1024];
+                        long total = 0;
+                        int read;
+                        while ((read = in.read(buffer)) > 0) {
+                            total += read;
+                            // Larger than any extension Bare expects; the installer checks again.
+                            if (total > MAX_BYTES) throw new IOException("too large");
+                            out.write(buffer, 0, read);
+                        }
+                    } catch (IOException | RuntimeException e) {
+                        Log.w(TAG, "Could not read the downloaded extension", e);
+                        PostTask.postTask(
+                                TaskTraits.UI_DEFAULT,
+                                () ->
+                                        Toast.makeText(
+                                                        context,
+                                                        R.string.bare_crx_offer_unreadable,
+                                                        Toast.LENGTH_LONG)
+                                                .show());
+                        return;
+                    }
+                    PostTask.postTask(
+                            TaskTraits.UI_DEFAULT,
+                            () ->
+                                    ExtensionUtilBridge.installCrxFromFile(
+                                            webContents, copy.getAbsolutePath()));
+                });
+    }
+
+    private static InputStream open(Context context, String path) throws IOException {
+        if (path.startsWith("content:")) {
+            InputStream stream = context.getContentResolver().openInputStream(Uri.parse(path));
+            if (stream == null) throw new IOException("no stream");
+            return stream;
+        }
+        return new FileInputStream(path);
+    }
+
+    private static void offer(ContentId id, String name, String path) {
+        Activity activity = ApplicationStatus.getLastTrackedFocusedActivity();
+        if (!(activity instanceof ChromeActivity chromeActivity)) return;
+        Tab tab = chromeActivity.getActivityTab();
+        if (tab == null || tab.isIncognito()) return;
+        WebContents webContents = tab.getWebContents();
+        if (webContents == null) return;
+        new AlertDialog.Builder(activity, R.style.ThemeOverlay_BrowserUI_AlertDialog)
+                .setTitle(R.string.bare_crx_offer_title)
+                .setMessage(activity.getString(R.string.bare_crx_offer_message, name))
+                .setPositiveButton(
+                        R.string.bare_crx_offer_install,
+                        (dialog, which) -> {
+                            // The file may have moved since it finished, as a download is first
+                            // written somewhere temporary and then published, so ask where it is
+                            // now.
+                            OfflineContentAggregatorFactory.get()
+                                    .getItemById(
+                                            id,
+                                            current ->
+                                                    install(
+                                                            webContents,
+                                                            current != null
+                                                                            && current.filePath
+                                                                                    != null
+                                                                    ? current.filePath
+                                                                    : path));
+                        })
+                .setNegativeButton(R.string.bare_crx_offer_not_now, null)
+                .show();
+    }
+}

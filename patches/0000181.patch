+namespace {
+
+struct CrxCheck {
+  std::string error;
+  std::string crx_id;
+};
+
+// Reads and verifies a downloaded file off the UI thread. The same checks as Load CRX on the
+// extensions page, which this mirrors: a size limit, then the format and signature, which also
+// give the id the file would install under.
+CrxCheck CheckCrxFile(const base::FilePath& path) {
+  constexpr int64_t kMaxCrxBytes = 256 * 1024 * 1024;
+  CrxCheck checked;
+  base::File file(path, base::File::FLAG_OPEN | base::File::FLAG_READ);
+  if (!file.IsValid()) {
+    checked.error = "Bare could not read that file.";
+    return checked;
+  }
+  int64_t length = file.GetLength();
+  if (length < 0) {
+    checked.error = "Bare could not read that file.";
+    return checked;
+  }
+  if (length > kMaxCrxBytes) {
+    checked.error = "That file is too large to be an extension.";
+    return checked;
+  }
+  file.Close();
+  std::string public_key;
+  crx_file::VerifierResult result = crx_file::Verify(
+      path, crx_file::VerifierFormat::CRX3, {}, {}, &public_key,
+      &checked.crx_id, /*compressed_verified_contents=*/nullptr);
+  if (result != crx_file::VerifierResult::OK_FULL) {
+    checked.error =
+        "That file is not a packed extension, or it is damaged. Bare installs "
+        "signed .crx files only.";
+    checked.crx_id.clear();
+  }
+  return checked;
+}
+
+void ReportCrxError(const std::string& message) {
+  extensions::Java_ExtensionUtilBridge_onCrxInstallError(
+      base::android::AttachCurrentThread(), message);
+}
+
+void OnCrxInstalled(const std::optional<extensions::CrxInstallError>& error) {
+  if (!error || (error->type() == extensions::CrxInstallErrorType::OTHER &&
+                 (error->detail() ==
+                      extensions::CrxInstallErrorDetail::USER_CANCELED ||
+                  error->detail() ==
+                      extensions::CrxInstallErrorDetail::USER_ABORTED))) {
+    return;
+  }
+  ReportCrxError(base::UTF16ToUTF8(error->message()));
+}
+
+void StartCrxInstall(base::WeakPtr<content::WebContents> web_contents,
+                     const base::FilePath& path,
+                     CrxCheck checked) {
+  if (!checked.error.empty()) {
+    ReportCrxError(checked.error);
+    return;
+  }
+  if (!web_contents) {
+    return;
+  }
+  content::BrowserContext* context = web_contents->GetBrowserContext();
+
+  // A file signed with the key of the uBlock Origin Bare ships would replace it in place and keep
+  // Bare's provenance, so it is declined here as it is on the extensions page.
+  const extensions::Extension* installed =
+      extensions::ExtensionRegistry::Get(context)->GetInstalledExtension(
+          checked.crx_id);
+  if (installed && extensions::IsProvisionedByBare(context, *installed)) {
+    ReportCrxError(base::StrCat(
+        {installed->name(),
+         " comes with Bare and keeps itself up to date. To install it from a "
+         "file instead, remove it first."}));
+    return;
+  }
+
+  auto prompt = std::make_unique<ExtensionInstallPrompt>(
+      web_contents.get(),
+      std::make_unique<extensions::InstallPromptData>(
+          extensions::InstallPromptData::UNSET_PROMPT_TYPE));
+  scoped_refptr<extensions::CrxInstaller> installer =
+      extensions::CrxInstaller::Create(context, std::move(prompt));
+  installer->set_error_on_unsupported_requirements(true);
+  installer->set_off_store_install_allow_reason(
+      extensions::CrxInstaller::OffStoreInstallAllowedFromSettingsPage);
+  installer->set_install_immediately(true);
+  installer->AddInstallerCallback(base::BindOnce(&OnCrxInstalled));
+  // The downloaded file itself, never deleted: the installer copies it before unpacking.
+  installer->InstallCrx(path);
+}
+
+}  // namespace
+
+// static
+void JNI_ExtensionUtilBridge_InstallCrxFromFile(
+    JNIEnv* env,
+    content::WebContents* web_contents,
+    const std::string& path) {
+  CHECK(web_contents);
+  base::FilePath file_path(path);
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&CheckCrxFile, file_path),
+      base::BindOnce(&StartCrxInstall, web_contents->GetWeakPtr(), file_path));
+}
+
 DEFINE_JNI(ExtensionUtilBridge)

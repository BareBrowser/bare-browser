From 400dc49dbace8bee484926badd43215d9f8d75b6 Mon Sep 17 00:00:00 2001
From: Bare <git@barebrowser.org>
Date: Sun, 23 Aug 2026 17:26:04 +0000
Subject: [PATCH] Never show the welcome as a bare circle, and never bank
 unseen choices

On Android 12 and above the reveal that fades in the copy, the option rows,
the label and the footer was driven only by the splash exit callback. When
the splash had already gone before the listener was registered the callback
never came. The four views were set to alpha 0 up front, so they stayed
invisible for good: a blue circle on an empty screen. The circle is the Start
button, so a press on it wrote KEY_SHOWN_FOR_VERSION and ran applyChoices
with the defaults, committing an update mode and four other settings the user
had never been shown, and retiring the screen so it could not come back.

The reveal is now armed from three places and runs once: layout, the splash
exit, and a watchdog. Below Android 12 layout drives it as before. Above, the
splash exit gets a short window to take the travel so the handover still looks
right, and the watchdog covers it either way.

Start also refuses to finish while the rows are still hidden. Pressing the
circle before the reveal brings the rows up instead of ending the screen, so
there is no path that banks a choice the user could not see.

Also gates the update check on the welcome being finished. It runs on the
first foreground, which is while the welcome is still up, so the first
automatic check went out under a default nobody had agreed to. The flag is
written after the preference it depends on. The daily throttle is unchanged.

The feed request now sends User-Agent: Bare/<version>. The platform default
carried the device model and Android build, which the server has no use for.
---
 .../chrome/browser/bare/BareUpdateCheck.java  | 19 ++++++++
 .../browser/bare/BareWelcomeOverlay.java      | 47 +++++++++++++++++--
 .../preferences/ChromePreferenceKeys.java     |  7 +++
 3 files changed, 68 insertions(+), 5 deletions(-)

diff --git a/chrome/android/java/src/org/chromium/chrome/browser/bare/BareUpdateCheck.java b/chrome/android/java/src/org/chromium/chrome/browser/bare/BareUpdateCheck.java
index 8564980e211..791712a0746 100644
--- a/chrome/android/java/src/org/chromium/chrome/browser/bare/BareUpdateCheck.java
+++ b/chrome/android/java/src/org/chromium/chrome/browser/bare/BareUpdateCheck.java
@@ -80,6 +80,16 @@ public class BareUpdateCheck {
         prefs().writeInt(ChromePreferenceKeys.BARE_UPDATE_MODE, mode);
     }
 
+    /** Whether the welcome screen has been completed and an update preference stored. */
+    public static boolean isOnboardingComplete() {
+        return prefs().readBoolean(ChromePreferenceKeys.BARE_UPDATE_ONBOARDED, false);
+    }
+
+    /** Called by the welcome screen once the user has pressed Start. */
+    public static void setOnboardingComplete() {
+        prefs().writeBoolean(ChromePreferenceKeys.BARE_UPDATE_ONBOARDED, true);
+    }
+
     public static boolean isReminderEnabled() {
         return prefs().readBoolean(ChromePreferenceKeys.BARE_UPDATE_REMINDER, false);
     }
@@ -118,6 +128,10 @@ public class BareUpdateCheck {
      * network; it only decides whether the weekly nudge is due.
      */
     public static void onBrowserForegrounded() {
+        // Nothing automatic before the user has been asked. The welcome screen runs on the
+        // first foreground, so without this the very first check went out while the choice
+        // was still on screen, under a default the user had not agreed to.
+        if (!isOnboardingComplete()) return;
         long since = System.currentTimeMillis() - getLastCheckMs();
         if (getMode() == UpdateMode.MANUAL) {
             if (isReminderEnabled() && since >= REMINDER_INTERVAL_MS) {
@@ -177,6 +191,11 @@ public class BareUpdateCheck {
             connection.setInstanceFollowRedirects(true);
             connection.setUseCaches(false);
             connection.setRequestProperty("Accept", "application/atom+xml");
+            // The platform default carries the device model and Android build. The server has
+            // no use for either, so send the product and its version and nothing else.
+            String version = currentVersion();
+            connection.setRequestProperty(
+                    "User-Agent", version == null ? "Bare" : "Bare/" + version);
             if (connection.getResponseCode() != HttpURLConnection.HTTP_OK) return null;
             try (BufferedReader reader =
                     new BufferedReader(new InputStreamReader(connection.getInputStream()))) {
diff --git a/chrome/android/java/src/org/chromium/chrome/browser/bare/BareWelcomeOverlay.java b/chrome/android/java/src/org/chromium/chrome/browser/bare/BareWelcomeOverlay.java
index bf22c06ca12..970d4c7fcc8 100644
--- a/chrome/android/java/src/org/chromium/chrome/browser/bare/BareWelcomeOverlay.java
+++ b/chrome/android/java/src/org/chromium/chrome/browser/bare/BareWelcomeOverlay.java
@@ -77,6 +77,12 @@ public class BareWelcomeOverlay {
     /** How long the circle takes to travel from the splash position down to its resting place. */
     private static final long SETTLE_MS = 620;
 
+    /** How long the splash exit gets to drive the reveal before layout does it instead. */
+    private static final long SPLASH_HANDOVER_MS = 450;
+
+    /** Backstop for the reveal if neither layout nor the splash exit ever arrives. */
+    private static final long REVEAL_WATCHDOG_MS = 1500;
+
     /** Fade used for the copy once the circle has landed. */
     private static final long FADE_MS = 340;
 
@@ -127,6 +133,21 @@ public class BareWelcomeOverlay {
         label.setAlpha(0f);
         footer.setAlpha(0f);
 
+        // The rows start invisible and only the reveal brings them back, so whatever else
+        // happens the reveal has to run. It is armed from three places and runs once.
+        //
+        // The bug this replaces: on Android 12 and above the reveal was driven only by the
+        // splash exit callback. When the splash had already gone by the time the listener was
+        // registered the callback never arrived, the rows stayed at alpha 0 for good, and the
+        // welcome showed a circle and nothing else.
+        boolean[] revealed = {false};
+        Runnable reveal =
+                () -> {
+                    if (revealed[0]) return;
+                    revealed[0] = true;
+                    playEntry(circle, copy, options, label, footer);
+                };
+
         // Park the circle where the splash drew its icon as soon as there is a layout, so the
         // overlay already matches the splash before the splash goes away.
         overlay.getViewTreeObserver()
@@ -138,25 +159,39 @@ public class BareWelcomeOverlay {
                                 overlay.getViewTreeObserver().removeOnGlobalLayoutListener(this);
                                 placeAtSplash(overlay, circle);
                                 if (Build.VERSION.SDK_INT < Build.VERSION_CODES.S) {
-                                    playEntry(circle, copy, options, label, footer);
+                                    reveal.run();
+                                } else {
+                                    // Give the splash exit a short window to drive the travel
+                                    // itself, then reveal regardless.
+                                    overlay.postDelayed(reveal, SPLASH_HANDOVER_MS);
                                 }
                             }
                         });
 
-        // Drive the travel off the splash leaving rather than off layout.
+        // Drive the travel off the splash leaving rather than off layout, when the splash is
+        // still there to hand over from.
         //
         // Layout happens while the splash is still on screen, so animating there ran the whole
         // travel behind it: the splash then faded out over a circle already parked at the bottom,
         // which read as one screen dissolving into another. Taking the exit ourselves lets the
         // splash be removed on the same frame the travel starts, so the circle appears to carry
-        // straight on from it.
+        // straight on from it. If the exit never comes the watchdog above has it covered.
         if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S) {
-            takeOverSplashExit(
-                    activity, () -> playEntry(circle, copy, options, label, footer));
+            takeOverSplashExit(activity, reveal);
         }
 
+        // Last resort, in case the overlay never reaches a layout pass at all.
+        overlay.postDelayed(reveal, REVEAL_WATCHDOG_MS);
+
         circle.setOnClickListener(
                 view -> {
+                    // Refuse to bank choices that were never on screen. If the reveal has not
+                    // run yet this press brings the rows up instead of ending the screen, so a
+                    // user cannot commit defaults they were never shown.
+                    if (!revealed[0]) {
+                        reveal.run();
+                        return;
+                    }
                     view.performHapticFeedback(HapticFeedbackConstants.CONFIRM);
                     view.setOnClickListener(null);
                     // Only now is the welcome spent. Leaving before pressing Start used to count
@@ -721,6 +756,8 @@ public class BareWelcomeOverlay {
                         ? BareUpdateCheck.UpdateMode.AUTOMATIC
                         : BareUpdateCheck.UpdateMode.MANUAL);
         BareUpdateCheck.setReminderEnabled(choices.updateChoice == 2);
+        // Last, so an automatic check can only begin after the preference above is stored.
+        BareUpdateCheck.setOnboardingComplete();
 
         whenProfileReady(
                 profile -> {
diff --git a/chrome/browser/preferences/android/java/src/org/chromium/chrome/browser/preferences/ChromePreferenceKeys.java b/chrome/browser/preferences/android/java/src/org/chromium/chrome/browser/preferences/ChromePreferenceKeys.java
index afc81dda75c..944d26389ba 100644
--- a/chrome/browser/preferences/android/java/src/org/chromium/chrome/browser/preferences/ChromePreferenceKeys.java
+++ b/chrome/browser/preferences/android/java/src/org/chromium/chrome/browser/preferences/ChromePreferenceKeys.java
@@ -408,6 +408,12 @@ public final class ChromePreferenceKeys {
     /** Whether the menu should carry a dot. Cleared when the user opens the update row. */
     public static final String BARE_UPDATE_BADGE = "Chrome.Bare.UpdateBadge";
 
+    /**
+     * Set once the welcome screen has been completed and the update preference stored. Until
+     * then nothing may contact the release feed, because the user has not been asked yet.
+     */
+    public static final String BARE_UPDATE_ONBOARDED = "Chrome.Bare.UpdateOnboarded";
+
     public static final String DOWNLOAD_USE_EXTERNAL_DOWNLOAD_MANAGER =
             "Chrome.Download.UseExternalDownloadManager";
 
@@ -1223,6 +1229,7 @@ public final class ChromePreferenceKeys {
                 BARE_UPDATE_LAST_CHECK_MS,
                 BARE_UPDATE_LATEST_TAG,
                 BARE_UPDATE_MODE,
+                BARE_UPDATE_ONBOARDED,
                 BARE_UPDATE_REMINDER,
                 DOWNLOAD_EXTERNAL_MANAGER_PACKAGE,
                 DOWNLOAD_USE_EXTERNAL_DOWNLOAD_MANAGER,

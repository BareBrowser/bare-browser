+    /** The colour at the left edge of {@code bar}, outside the address field, or null. */
+    private static @Nullable Integer sample(View bar) {
+        if (bar.getWidth() <= 0 || bar.getHeight() <= 0) return null;
+        float density = bar.getResources().getDisplayMetrics().density;
+        Bitmap bitmap = Bitmap.createBitmap(1, 1, Bitmap.Config.ARGB_8888);
+        Canvas canvas = new Canvas(bitmap);
+        canvas.translate(-2 * density, -bar.getHeight() / 2f);
+        bar.draw(canvas);
+        int pixel = bitmap.getPixel(0, 0);
+        bitmap.recycle();
+        return Color.alpha(pixel) == 255 ? pixel : null;
+    }

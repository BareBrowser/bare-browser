@@ -0,0 +1,116 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.bare;
+
+import android.net.Uri;
+
+import org.json.JSONArray;
+import org.json.JSONException;
+import org.json.JSONObject;
+
+import org.chromium.base.Callback;
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.content_public.browser.WebContents;
+
+import java.util.Locale;
+
+/**
+ * Finds the file behind the video that was pressed.
+ *
+ * <p>A page that plays through Media Source gives its video element a blob: address, which is
+ * not a file, and the registry of what the tab fetched cannot say which of several videos was
+ * pressed. Pages in that shape often still know a plain file for the video they show, in their own
+ * data. This asks the page, at the place that was pressed, for the video there and for any file
+ * address its data names, and takes one only when that is unambiguous.
+ *
+ * <p>Nothing leaves the browser. The answer is an address, and the download that follows goes
+ * through the browser's own network stack with the profile's own cookies, the same as any other
+ * download.
+ */
+@NullMarked
+public final class BareMediaProbe {
+    private BareMediaProbe() {}
+
+    /**
+     * Finds the video under a point, reads its address, and collects file addresses from the
+     * page's data under the names pages use for them.
+     *
+     * <p>The video is the first video found under the point, looking through anything laid over
+     * it. {@code videos} counts the videos on the page that take up room, which is what makes a
+     * data address safe to use: with one, there is nothing to mix it up with.
+     */
+    static final String PROBE_SCRIPT =
+            "(function(x,y){function abs(u){try{return new URL(u,location.href).href;}"
+                    + "catch(e){return '';}}var v=null,els=document.elementsFromPoint(x,y);"
+                    + "for(var i=0;i<els.length&&!v;i++){var e=els[i];if(e.tagName==='VIDEO'){v=e;}"
+                    + "else if(e.querySelector){v=e.querySelector('video');}}var out={src:'',"
+                    + "videos:0,candidates:[]};var vs=document.querySelectorAll('video');"
+                    + "for(var j=0;j<vs.length;j++){var r=vs[j].getBoundingClientRect();"
+                    + "if(r.width>50&&r.height>50)out.videos++;}if(v){var s=v.currentSrc||v.src;"
+                    + "if(s&&!/^blob:/.test(s))out.src=abs(s);}var keys=['playable_url_quality_hd',"
+                    + "'browser_native_hd_url','playable_url','browser_native_sd_url','video_url',"
+                    + "'contentUrl'];var text='';var ss=document.querySelectorAll('script');"
+                    + "for(var k=0;k<ss.length;k++){text+=ss[k].textContent+' ';}"
+                    + "for(var q=0;q<keys.length;q++){var needle='\"'+keys[q]+'\":\"';var p=0;"
+                    + "while((p=text.indexOf(needle,p))>=0){p+=needle.length;var end=p;"
+                    + "while(end<text.length&&!(text.charCodeAt(end)===34&&text.charCodeAt(end-1)"
+                    + "!==92))end++;var raw=text.slice(p,end),u=raw;try{u=JSON.parse('\"'+raw+'\"');}"
+                    + "catch(e){}if(/^https?:/.test(u)&&out.candidates.indexOf(u)<0)"
+                    + "out.candidates.push(u);p=end;}}return JSON.stringify(out);})";
+
+    /** Asks the page about the point, and passes on the address to download, or null. */
+    public static void find(
+            @Nullable WebContents webContents, int xDp, int yDp, Callback<@Nullable String> done) {
+        if (webContents == null || webContents.isDestroyed()) {
+            done.onResult(null);
+            return;
+        }
+        BareScriptBridge.evaluate(
+                webContents,
+                PROBE_SCRIPT + "(" + xDp + "," + yDp + ")",
+                result -> done.onResult(choose(result)));
+    }
+
+    /**
+     * Picks the address out of what the script returned.
+     *
+     * <p>The video's own address wins when it is a file. A data address is used only when the page
+     * has exactly one video, because in a feed it could belong to any of them. Anything that is
+     * not a web address, or is not on https, is refused; http is let through only for the user's
+     * own machine, so that a page served locally can be tried.
+     */
+    static @Nullable String choose(@Nullable String scriptResult) {
+        if (scriptResult == null) return null;
+        try {
+            Object decoded = new org.json.JSONTokener(scriptResult).nextValue();
+            if (!(decoded instanceof String)) return null;
+            JSONObject json = new JSONObject((String) decoded);
+            String src = json.optString("src", "");
+            if (isFileAddress(src)) return src;
+            if (json.optInt("videos", 0) != 1) return null;
+            JSONArray candidates = json.optJSONArray("candidates");
+            if (candidates == null) return null;
+            for (int i = 0; i < candidates.length(); i++) {
+                String candidate = candidates.getString(i);
+                if (isFileAddress(candidate)) return candidate;
+            }
+            return null;
+        } catch (JSONException e) {
+            return null;
+        }
+    }
+
+    static boolean isFileAddress(String address) {
+        if (address.isEmpty()) return false;
+        Uri uri = Uri.parse(address);
+        String scheme = uri.getScheme();
+        String host = uri.getHost();
+        if (scheme == null || host == null) return false;
+        scheme = scheme.toLowerCase(Locale.ROOT);
+        if (scheme.equals("https")) return true;
+        return scheme.equals("http") && (host.equals("localhost") || host.startsWith("127."));
+    }
+}

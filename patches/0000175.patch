--- /dev/null
+++ b/chrome/android/junit/src/org/chromium/chrome/browser/bare/BareMediaProbeUnitTest.java
@@ -0,0 +1,80 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.bare;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertNull;
+import static org.junit.Assert.assertTrue;
+
+import org.json.JSONObject;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+
+import org.chromium.base.test.BaseRobolectricTestRunner;
+
+/** Unit tests for how {@link BareMediaProbe} chooses among what the page reports. */
+@RunWith(BaseRobolectricTestRunner.class)
+public class BareMediaProbeUnitTest {
+    /** The script's answer is a JSON string, which is itself returned as a JSON string. */
+    private static String answer(String json) {
+        return JSONObject.quote(json);
+    }
+
+    @Test
+    public void testTheVideosOwnFileWins() {
+        String result =
+                answer(
+                        "{\"src\":\"https://cdn.example/v.mp4\",\"videos\":3,"
+                                + "\"candidates\":[\"https://cdn.example/other.mp4\"]}");
+        assertEquals("https://cdn.example/v.mp4", BareMediaProbe.choose(result));
+    }
+
+    @Test
+    public void testADataAddressNeedsExactlyOneVideoOnThePage() {
+        String one =
+                answer(
+                        "{\"src\":\"\",\"videos\":1,"
+                                + "\"candidates\":[\"https://cdn.example/a.mp4\","
+                                + "\"https://cdn.example/b.mp4\"]}");
+        assertEquals("https://cdn.example/a.mp4", BareMediaProbe.choose(one));
+
+        // In a feed the address could belong to any of the videos, so none is guessed.
+        String feed =
+                answer("{\"src\":\"\",\"videos\":4,\"candidates\":[\"https://cdn.example/a.mp4\"]}");
+        assertNull(BareMediaProbe.choose(feed));
+        String none =
+                answer("{\"src\":\"\",\"videos\":0,\"candidates\":[\"https://cdn.example/a.mp4\"]}");
+        assertNull(BareMediaProbe.choose(none));
+    }
+
+    @Test
+    public void testNothingFoundIsNull() {
+        assertNull(BareMediaProbe.choose(answer("{\"src\":\"\",\"videos\":1,\"candidates\":[]}")));
+        assertNull(BareMediaProbe.choose(null));
+        assertNull(BareMediaProbe.choose("not json"));
+        assertNull(BareMediaProbe.choose("null"));
+    }
+
+    @Test
+    public void testOnlyWebAddressesAreFiles() {
+        assertTrue(BareMediaProbe.isFileAddress("https://cdn.example/v.mp4"));
+        assertFalse(BareMediaProbe.isFileAddress("blob:https://site.example/1234"));
+        assertFalse(BareMediaProbe.isFileAddress("data:video/mp4;base64,AAAA"));
+        assertFalse(BareMediaProbe.isFileAddress("javascript:alert(1)"));
+        assertFalse(BareMediaProbe.isFileAddress("http://cdn.example/v.mp4"));
+        assertTrue(BareMediaProbe.isFileAddress("http://127.0.0.1:8000/clip.mp4"));
+        assertFalse(BareMediaProbe.isFileAddress(""));
+    }
+
+    @Test
+    public void testABadCandidateIsSkippedForAGoodOne() {
+        String result =
+                answer(
+                        "{\"src\":\"\",\"videos\":1,\"candidates\":[\"http://cdn.example/a.mp4\","
+                                + "\"https://cdn.example/b.mp4\"]}");
+        assertEquals("https://cdn.example/b.mp4", BareMediaProbe.choose(result));
+    }
+}

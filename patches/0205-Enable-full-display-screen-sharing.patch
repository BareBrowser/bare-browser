+/** Headless fragment used to invoke the MediaProjection API, once per Activity task. */
 @NullMarked
 public class MediaCapturePickerHeadlessFragment extends Fragment {
     private static final String TAG = "MediaCapturePickerHeadlessFragment";
+    // Survives Activity recreation, not process death. A result after process death is ignored.
+    private static final SparseArray<Delegate> sPendingDelegates = new SparseArray<>();
 
     @Retention(RetentionPolicy.SOURCE)
     @Target(ElementType.TYPE_USE)

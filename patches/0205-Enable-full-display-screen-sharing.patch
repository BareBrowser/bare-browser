+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.content_public.browser.media.capture;
+
+import android.os.Build;
+import android.os.SystemClock;
+
+import org.chromium.base.Callback;
+import org.chromium.base.ThreadUtils;
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+
+/** Owns one public full-display request and its local, account-free startup report. */
+@NullMarked
+public final class ScreenCaptureSession {
+    private static @Nullable ScreenCaptureSession sActive;
+
+    private final long mStartedAt = SystemClock.elapsedRealtime();
+    private final StringBuilder mReport =
+            new StringBuilder("Screen capture v1; Android API " + Build.VERSION.SDK_INT + "\n");
+    private @Nullable Callback<String> mOnFailure;
+    private int mStageCount;
+    private boolean mFailed;
+
+    private ScreenCaptureSession(Callback<String> onFailure) {
+        mOnFailure = onFailure;
+        record("request accepted");
+    }
+
+    /** Returns null while another request, system prompt or capture is still owned. */
+    public static synchronized @Nullable ScreenCaptureSession acquire(Callback<String> onFailure) {
+        if (sActive != null) return null;
+        sActive = new ScreenCaptureSession(onFailure);
+        return sActive;
+    }
+
+    public synchronized void record(String stage) {
+        if (mStageCount++ >= 24) return;
+        mReport.append(SystemClock.elapsedRealtime() - mStartedAt)
+                .append(" ms: ")
+                .append(stage)
+                .append('\n');
+    }
+
+    /** Reports only fixed stage names and exception classes, never URLs or exception messages. */
+    public void fail(String reason) {
+        final Callback<String> callback;
+        final String report;
+        synchronized (this) {
+            if (mFailed || mOnFailure == null) return;
+            mFailed = true;
+            callback = mOnFailure;
+            report = mReport + "Failure: " + reason;
+        }
+        ThreadUtils.runOnUiThread(() -> callback.onResult(report));
+    }
+
+    public void release() {
+        synchronized (ScreenCaptureSession.class) {
+            if (sActive == this) sActive = null;
+        }
+        synchronized (this) {
+            mOnFailure = null;
+        }
+    }
+
+    static synchronized void resetForTesting() {
+        if (sActive != null) sActive.release();
+    }
+}

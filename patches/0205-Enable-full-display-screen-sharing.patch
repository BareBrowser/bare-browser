+package org.chromium.chrome.browser.media;
+
+import android.app.Activity;
+import android.app.AlertDialog;
+import android.content.ClipData;
+import android.content.ClipboardManager;
+import android.content.Context;
+import android.content.Intent;
+import android.media.projection.MediaProjectionConfig;
+import android.media.projection.MediaProjectionManager;
+import android.os.Build;
+
+import androidx.activity.result.ActivityResult;
+import androidx.fragment.app.FragmentActivity;
+
+import org.chromium.base.ContextUtils;
+import org.chromium.base.Log;
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.chrome.R;
+import org.chromium.chrome.browser.media.MediaCapturePickerHeadlessFragment.CaptureAction;
+import org.chromium.content_public.browser.WebContents;
+import org.chromium.content_public.browser.WebContentsObserver;
+import org.chromium.content_public.browser.media.capture.ScreenCapture;
+import org.chromium.content_public.browser.media.capture.ScreenCaptureSession;
+import org.chromium.ui.base.WindowAndroid;
+
+import java.lang.ref.WeakReference;
+
+/** Public Android consent fallback for builds without a proprietary picker delegate. */
+@NullMarked
+final class FullScreenCapturePicker {
+    private static final String TAG = "FullScreenCapture";
+
+    static boolean allowsFullDisplay(MediaCapturePickerManager.Params params) {
+        // excludeSelfBrowserSurface excludes a tab choice, not a whole-display choice.
+        return params.allowedCaptureLevel == AllowedScreenCaptureLevel.DESKTOP
+                && !params.captureThisTab
+                && !params.excludeMonitorTypeSurfaces;
+    }
+
+    static void show(
+            Context context,
+            MediaCapturePickerManager.Params params,
+            MediaCapturePickerManager.Delegate delegate) {
+        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.R || !allowsFullDisplay(params)) {
+            showFailure(
+                    params.webContents,
+                    context.getString(R.string.bare_capture_unavailable));
+            delegate.onCancel();
+            return;
+        }
+        Activity activity = ContextUtils.activityFromContext(context);
+        if (!(activity instanceof FragmentActivity) || activity.isFinishing()) {
+            delegate.onCancel();
+            return;
+        }
+        WeakReference<WebContents> contents = new WeakReference<>(params.webContents);
+        ScreenCaptureSession session =
+                ScreenCaptureSession.acquire(report -> showFailure(contents.get(), report));
+        if (session == null) {
+            showFailure(
+                    params.webContents,
+                    context.getString(R.string.bare_capture_busy));
+            delegate.onCancel();
+            return;
+        }
+        new Request(params, delegate, session).showDisclosure(activity);
+    }
+
+    private static void showFailure(@Nullable WebContents webContents, String report) {
+        Log.w(TAG, "%s", report);
+        if (webContents == null || webContents.isDestroyed()) return;
+        WindowAndroid window = webContents.getTopLevelNativeWindow();
+        if (window == null) return;
+        Context context = window.getContext().get();
+        Activity activity = context == null ? null : ContextUtils.activityFromContext(context);
+        if (activity == null || activity.isFinishing() || activity.isDestroyed()) return;
+        try {
+            new AlertDialog.Builder(activity)
+                    .setTitle(R.string.bare_capture_failure_title)
+                    .setMessage(report)
+                    .setPositiveButton(android.R.string.ok, null)
+                    .setNeutralButton(
+                            R.string.bare_capture_copy_report,
+                            (dialog, which) -> {
+                                ClipboardManager clipboard =
+                                        (ClipboardManager)
+                                                activity.getSystemService(Context.CLIPBOARD_SERVICE);
+                                if (clipboard != null) {
+                                    clipboard.setPrimaryClip(
+                                            ClipData.newPlainText(
+                                                    activity.getString(R.string.bare_capture_report_label),
+                                                    report));
+                                }
+                            })
+                    .show();
+        } catch (RuntimeException error) {
+            // The requesting activity may have disappeared before the UI task ran.
+            Log.w(TAG, "Cannot show capture report: %s", error.getClass().getSimpleName());
+        }
+    }
+
+    private static final class Request {
+        private final MediaCapturePickerManager.Params mParams;
+        private final MediaCapturePickerManager.Delegate mDelegate;
+        private final ScreenCaptureSession mSession;
+        private final WebContentsObserver mObserver;
+        private @Nullable AlertDialog mDialog;
+        private boolean mPromptLaunched;
+        private boolean mFinished;
+
+        Request(
+                MediaCapturePickerManager.Params params,
+                MediaCapturePickerManager.Delegate delegate,
+                ScreenCaptureSession session) {
+            mParams = params;
+            mDelegate = delegate;
+            mSession = session;
+            mObserver =
+                    new WebContentsObserver(params.webContents) {
+                        @Override
+                        public void webContentsDestroyed() {
+                            cancel();
+                        }
+
+                        @Override
+                        public void onTopLevelNativeWindowChanged(@Nullable WindowAndroid window) {
+                            if (!mPromptLaunched) cancel();
+                        }
+                    };
+            if (delegate instanceof MediaCapturePickerManagerBridge bridge) {
+                bridge.setOnRequestDestroyed(this::cancel);
+            }
+        }
+
+        private boolean isAlive() {
+            return !mParams.webContents.isDestroyed()
+                    && (!(mDelegate instanceof MediaCapturePickerManagerBridge bridge)
+                            || bridge.isRequestAlive());
+        }
+
+        void showDisclosure(Activity activity) {
+            if (mFinished || !isAlive()) {
+                cancel();
+                return;
+            }
+            try {
+                mDialog =
+                        new AlertDialog.Builder(activity)
+                                .setTitle(R.string.bare_capture_disclosure_title)
+                                .setMessage(
+                                        activity.getString(
+                                                R.string.bare_capture_disclosure, mParams.appName))
+                                .setNegativeButton(android.R.string.cancel, (dialog, which) -> cancel())
+                                .setPositiveButton(
+                                        R.string.bare_capture_continue, (dialog, which) -> launchPrompt())
+                                .setOnCancelListener(dialog -> cancel())
+                                .create();
+                mDialog.show();
+            } catch (RuntimeException error) {
+                mSession.fail("Disclosure: " + error.getClass().getSimpleName());
+                cancel();
+            }
+        }
+
+        private void launchPrompt() {
+            if (mFinished || !isAlive()) {
+                cancel();
+                return;
+            }
+            WindowAndroid window = mParams.webContents.getTopLevelNativeWindow();
+            Context context = window == null ? null : window.getContext().get();
+            Activity activity = context == null ? null : ContextUtils.activityFromContext(context);
+            if (!(activity instanceof FragmentActivity fragmentActivity)) {
+                cancel();
+                return;
+            }
+            try {
+                MediaProjectionManager manager =
+                        (MediaProjectionManager)
+                                activity.getSystemService(Context.MEDIA_PROJECTION_SERVICE);
+                if (manager == null) {
+                    mSession.fail("MediaProjection service is unavailable");
+                    cancel();
+                    return;
+                }
+                Intent intent =
+                        Build.VERSION.SDK_INT >= Build.VERSION_CODES.UPSIDE_DOWN_CAKE
+                                ? manager.createScreenCaptureIntent(
+                                        MediaProjectionConfig.createConfigForDefaultDisplay())
+                                : manager.createScreenCaptureIntent();
+                MediaCapturePickerHeadlessFragment fragment =
+                        MediaCapturePickerHeadlessFragment.getInstance(fragmentActivity);
+                mPromptLaunched = true;
+                mSession.record("Android consent opened");
+                fragment.startAndroidCapturePrompt(this::onResult, intent);
+            } catch (RuntimeException error) {
+                mPromptLaunched = false;
+                mSession.fail("Android consent: " + error.getClass().getSimpleName());
+                cancel();
+            }
+        }
+
+        private void onResult(@CaptureAction int action, ActivityResult result) {
+            mPromptLaunched = false;
+            if (mFinished) {
+                mSession.release();
+                return;
+            }
+            if (!isAlive()
+                    || action == CaptureAction.CAPTURE_CANCELLED
+                    || result.getResultCode() != Activity.RESULT_OK
+                    || result.getData() == null) {
+                cancel();
+                return;
+            }
+            mSession.record("Android consent granted");
+            if (!ScreenCapture.onFullDisplayPick(mParams.webContents, result, mSession)) {
+                mSession.fail("Another pending native capture owns the handoff");
+                cancel();
+                return;
+            }
+            // Native completion can synchronously destroy the picker bridge.
+            finish();
+            mDelegate.onPickWindow();
+            MediaCapturePickerManager.recordResult(MediaCapturePickerManager.Result.WINDOW_SELECTED);
+        }
+
+        private void finish() {
+            mFinished = true;
+            mObserver.observe(null);
+            if (mDelegate instanceof MediaCapturePickerManagerBridge bridge) {
+                bridge.setOnRequestDestroyed(null);
+            }
+            if (mDialog != null) {
+                try {
+                    mDialog.dismiss();
+                } catch (RuntimeException error) {
+                    Log.w(TAG, "Disclosure activity no longer exists");
+                }
+                mDialog = null;
+            }
+        }
+
+        private void cancel() {
+            if (mFinished) return;
+            finish();
+            // Keep ownership until the old Android prompt returns, even after navigation.
+            // Its result must never be delivered to a newer request.
+            if (!mPromptLaunched) mSession.release();
+            if (isAlive()) mDelegate.onCancel();
+            MediaCapturePickerManager.recordResult(MediaCapturePickerManager.Result.CANCELLED);
+        }
+    }
+}

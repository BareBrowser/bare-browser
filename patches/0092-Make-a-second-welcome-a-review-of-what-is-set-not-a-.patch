-    private static void addRow(
+    /**
+     * Moves the three profile-backed rows onto what the profile actually holds.
+     *
+     * <p>Only for a review. The welcome is built before native is up, so those three rows start at
+     * the defaults a fresh profile would be given. That is the right answer the first time and the
+     * wrong one on every later showing, where it would show a user their own settings replaced by
+     * defaults and then write those defaults back when they pressed Start. Rows the user has
+     * already touched are left alone, so a late read cannot undo a deliberate choice.
+     */
+    private static void seedFromProfile(
+            Activity activity,
+            Choices choices,
+            TextView engineValue,
+            TextView autofillValue,
+            MaterialSwitch backgroundToggle) {
+        whenProfileReady(
+                profile -> {
+                    PrefService prefs = UserPrefs.get(profile);
+
+                    if (!choices.platformAutofillKnown) {
+                        choices.platformAutofill =
+                                prefs.getBoolean(Pref.AUTOFILL_USING_PLATFORM_AUTOFILL);
+                        choices.platformAutofillKnown = true;
+                        autofillValue.setText(
+                                choices.platformAutofill
+                                        ? R.string.bare_welcome_value_platform_autofill
+                                        : R.string.bare_welcome_value_builtin);
+                    }
+
+                    if (!choices.backgroundMediaKnown) {
+                        choices.backgroundMedia = prefs.getBoolean(Pref.BACKGROUND_MEDIA_PLAYBACK);
+                        choices.backgroundMediaKnown = true;
+                        backgroundToggle.setChecked(choices.backgroundMedia);
+                    }
+
+                    TemplateUrlService service = TemplateUrlServiceFactory.getForProfile(profile);
+                    if (service.isLoaded()) {
+                        seedEngine(service, choices, engineValue);
+                        return;
+                    }
+                    service.registerLoadListener(
+                            new TemplateUrlService.LoadListener() {
+                                @Override
+                                public void onTemplateUrlServiceLoaded() {
+                                    service.unregisterLoadListener(this);
+                                    seedEngine(service, choices, engineValue);
+                                }
+                            });
+                    service.load();
+                });
+    }
+
+    /** Moves the search engine row onto whatever the profile currently searches with. */
+    private static void seedEngine(
+            TemplateUrlService service, Choices choices, TextView engineValue) {
+        if (choices.engineKnown) return;
+        TemplateUrl current = service.getDefaultSearchEngineTemplateUrl();
+        if (current == null) return;
+        choices.engineKeyword = current.getKeyword();
+        choices.engineKnown = true;
+        engineValue.setText(current.getShortName());
+    }
+
+    /** The collapsed label for the downloads row: off, ask each time, or the chosen app. */
+    private static String downloadLabel(Activity activity, Choices choices) {
+        if (!choices.externalDownloadManager) {
+            return activity.getString(R.string.bare_welcome_value_off);
+        }
+        ComponentName component =
+                ComponentName.unflattenFromString(choices.downloadManagerComponent);
+        if (component != null) {
+            try {
+                CharSequence label =
+                        activity.getPackageManager()
+                                .getActivityInfo(component, 0)
+                                .loadLabel(activity.getPackageManager());
+                if (label != null && label.length() > 0) return label.toString();
+            } catch (PackageManager.NameNotFoundException e) {
+                // The app it names is gone, so fall through to asking each time.
+            }
+        }
+        return activity.getString(R.string.bare_welcome_value_ask);
+    }
+

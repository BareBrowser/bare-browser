From 566e760681d83ca5da4d4d45c36401041ebef711 Mon Sep 17 00:00:00 2001
From: Bare <git@barebrowser.org>
Date: Sun, 8 Nov 2026 06:53:01 +0000
Subject: [PATCH] Patch 0000025

---
 .../browser/magic_stack/HomeModulesConfigManager.java      | 5 ++++-
 .../ntp_customization/NtpCustomizationConfigManager.java   | 7 ++++++-
 2 files changed, 10 insertions(+), 2 deletions(-)

diff --git a/chrome/browser/magic_stack/android/java/src/org/chromium/chrome/browser/magic_stack/HomeModulesConfigManager.java b/chrome/browser/magic_stack/android/java/src/org/chromium/chrome/browser/magic_stack/HomeModulesConfigManager.java
index 0d80babfbdf..74a34ca2f8e 100644
--- a/chrome/browser/magic_stack/android/java/src/org/chromium/chrome/browser/magic_stack/HomeModulesConfigManager.java
+++ b/chrome/browser/magic_stack/android/java/src/org/chromium/chrome/browser/magic_stack/HomeModulesConfigManager.java
@@ -86,7 +86,10 @@ public class HomeModulesConfigManager {
      * @param moduleType {@link ModuleType} needed to be notified to the listeners.
      */
     public boolean getPrefModuleTypeEnabled(@ModuleType int moduleType) {
-        return mSharedPreferencesManager.readBoolean(getSettingsPreferenceKey(moduleType), true);
+        // De-Googled build: new tab page cards are off by default. Each card can be
+        // turned back on individually under Customize new tab page.
+        return mSharedPreferencesManager.readBoolean(
+                getSettingsPreferenceKey(moduleType), false);
     }
 
     /**
diff --git a/chrome/browser/ntp_customization/java/src/org/chromium/chrome/browser/ntp_customization/NtpCustomizationConfigManager.java b/chrome/browser/ntp_customization/java/src/org/chromium/chrome/browser/ntp_customization/NtpCustomizationConfigManager.java
index 75e9ac315bb..2a81ef3dfe2 100644
--- a/chrome/browser/ntp_customization/java/src/org/chromium/chrome/browser/ntp_customization/NtpCustomizationConfigManager.java
+++ b/chrome/browser/ntp_customization/java/src/org/chromium/chrome/browser/ntp_customization/NtpCustomizationConfigManager.java
@@ -224,7 +224,12 @@ public class NtpCustomizationConfigManager {
 
         mIsMvtToggleOn =
                 ChromeSharedPreferences.getInstance()
-                        .readBoolean(ChromePreferenceKeys.IS_MVT_VISIBLE, true);
+                        .readBoolean(
+                                // De-Googled build: the shortcuts row is hidden by
+                                // default. It shows your most visited sites on every
+                                // new tab, which is visible to anyone glancing over.
+                                // Re-enable under Customize new tab page.
+                                ChromePreferenceKeys.IS_MVT_VISIBLE, false);
     }
 
     @VisibleForTesting

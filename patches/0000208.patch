+        int share = Math.round(52 * density);
+        int margin = extensions > 0 && !minimal ? mToolbarSidePadding + share : 0;
+        ViewGroup.MarginLayoutParams params =
+                (ViewGroup.MarginLayoutParams) mToolbarButtonsContainer.getLayoutParams();
+        if (params.getMarginEnd() != margin) {
+            params.setMarginEnd(margin);
+            mToolbarButtonsContainer.setLayoutParams(params);
+        }
+        int end = mBareLocationBarEndPadding;
+        if (extensions > 0) {
+            end = minimal ? end + extensions : Math.round(2 * density);
+        }
+        if (locationBar.getPaddingEnd() != end) {
+            locationBar.setPaddingRelative(
+                    locationBar.getPaddingStart(),
+                    locationBar.getPaddingTop(),
+                    end,
+                    locationBar.getPaddingBottom());
+        }
+    }

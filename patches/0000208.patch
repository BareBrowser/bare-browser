+    private void applyExtensionsInsideLocationBar() {
+        View locationBar = findViewById(R.id.location_bar);
+        if (locationBar == null) return;
+        View urlBar = locationBar.findViewById(R.id.url_bar);
+        if (mBareLocationBarEndPadding < 0) {
+            mBareLocationBarEndPadding = locationBar.getPaddingEnd();
+            mBareUrlBarEndPadding = urlBar != null ? urlBar.getPaddingEnd() : 0;
+        }
+        float density = getResources().getDisplayMetrics().density;

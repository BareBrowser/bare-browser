@@ -20,6 +20,7 @@ import org.jni_zero.JNINamespace;
 import org.chromium.base.ActivityState;
 import org.chromium.base.ApplicationStatus;
 import org.chromium.base.ApplicationStatus.ActivityStateListener;
+import org.chromium.base.ContextUtils;
 import org.chromium.base.Log;
 import org.chromium.build.annotations.NullMarked;
 import org.chromium.build.annotations.Nullable;
@@ -244,17 +245,42 @@ public class ScreenOrientationProviderImpl
 
     @Override
     public void lockOrientation(@Nullable WindowAndroid window, byte webScreenOrientation) {
-        // De-Googled build: pages are not allowed to dictate screen orientation.
+        // De-Googled build: by default pages are not allowed to dictate screen orientation.
         //
-        // Sites commonly call screen.orientation.lock("landscape") when entering
-        // fullscreen video. Honouring that calls Activity.setRequestedOrientation(),
-        // which overrides the user's system rotation lock outright - the device
-        // rotates even when the user has explicitly locked rotation. Ignoring the
-        // request leaves fullscreen video following the phone, as every other app
-        // does.
+        // Sites commonly call screen.orientation.lock("landscape") when entering fullscreen
+        // video. Honouring that calls Activity.setRequestedOrientation(), which overrides the
+        // user's system rotation lock outright - the device rotates even when the user has
+        // explicitly locked rotation. Ignoring the request leaves fullscreen video following
+        // the phone, as every other app does.
         //
-        // unlockOrientation() is deliberately left working, so any orientation
-        // state set before this build can still be cleared.
+        // Settings, Media can turn this off, which brings back the browser's own behaviour of
+        // honouring the lock. The key is the same string as
+        // ChromePreferenceKeys.BARE_MEDIA_FULLSCREEN_FOLLOWS_PHONE; it is read on every call so a
+        // change applies without a restart.
+        //
+        // unlockOrientation() is deliberately left working, so any orientation state set before
+        // this build can still be cleared.
+        if (ContextUtils.getAppSharedPreferences()
+                .getBoolean("Bare.Media.FullscreenFollowsPhone", true)) {
+            return;
+        }
+
+        // WindowAndroid may be null if the tab is being reparented.
+        if (window == null) return;
+        Activity activity = window.getActivity().get();
+
+        // Locking orientation is only supported for web contents that have an associated
+        // activity. Note that we can't just use the focused activity, as that would lead to bugs
+        // where unlockOrientation unlocks a different activity to the one that was locked.
+        if (activity == null) return;
+
+        int orientation =
+                getOrientationFromWebScreenOrientations(webScreenOrientation, window, activity);
+        if (orientation == ActivityInfo.SCREEN_ORIENTATION_UNSPECIFIED) {
+            return;
+        }
+
+        setMaybeDelayedRequestedOrientation(activity, /* lock= */ true, orientation);
     }
 

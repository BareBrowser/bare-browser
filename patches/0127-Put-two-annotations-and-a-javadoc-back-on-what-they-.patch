From 0cedbe59ac740cc2f34aee4e7a56f681d3af1cf0 Mon Sep 17 00:00:00 2001
From: Bare <git@barebrowser.org>
Date: Thu, 10 Sep 2026 04:04:25 +0000
Subject: [PATCH] Put two annotations and a javadoc back on what they describe

Both patches inserted a declaration immediately after an existing javadoc rather
than after the method it belonged to.

In LogoMediator the insertion landed between @VisibleForTesting and
getDefaultGoogleLogoDrawable, so the annotation moved onto the private helper
and the method that is reached from tests lost it. In PwaRestorePromoUtils the
upstream javadoc for launchPromoIfNeeded, @param and @return included, ended up
introducing a boolean constant.

Only the order changes. No behaviour depends on either.

Migration note (156.0.8078.25): upstream deleted PwaRestorePromoUtils.java, so only
the LogoMediator part remains.
---
 .../chromium/chrome/browser/logo/LogoMediator.java   | 12 ++++++------
 1 file changed, 6 insertions(+), 6 deletions(-)

diff --git a/chrome/browser/ui/android/logo/java/src/org/chromium/chrome/browser/logo/LogoMediator.java b/chrome/browser/ui/android/logo/java/src/org/chromium/chrome/browser/logo/LogoMediator.java
index f4af8b9d764..4558c011e2b 100644
--- a/chrome/browser/ui/android/logo/java/src/org/chromium/chrome/browser/logo/LogoMediator.java
+++ b/chrome/browser/ui/android/logo/java/src/org/chromium/chrome/browser/logo/LogoMediator.java
@@ -351,12 +351,6 @@ public class LogoMediator implements TemplateUrlServiceObserver {
         }
     }
 
-    /**
-     * Get the default Google logo drawable if available.
-     *
-     * @return The default Google logo drawable.
-     */
-    @VisibleForTesting
     /**
      * Bare: the no-AI DuckDuckGo entry carries its wordmark in the APK rather than fetching one,
      * so it is served from resources here instead of through the logo bridge. The keyword has to
@@ -366,6 +360,12 @@ public class LogoMediator implements TemplateUrlServiceObserver {
         return "noai.duckduckgo.com".equals(mSearchEngineKeyword);
     }
 
+    /**
+     * Get the default Google logo drawable if available.
+     *
+     * @return The default Google logo drawable.
+     */
+    @VisibleForTesting
     @Nullable Drawable getDefaultGoogleLogoDrawable() {
         if (isBareNoAiEngine()) {
             return LogoUtils.getNoAiLogoDrawable(mContext);

+            for (int k = 0; k < mPlaces.length; k++) {
+                if (mPlaces[k] == position) return k;
+            }
+            return -1;
+        }
+
+        /** How far the list has scrolled past its first row, in pixels. */
+        private float scrolled() {
+            if (mList.getChildCount() == 0) return 0;
+            int first = mList.getFirstVisiblePosition();
+            if (first >= mTops.length) return 0;
+            return mTops[first] - mList.getChildAt(0).getTop();
+        }
+
+        private int menuColor() {
+            return SemanticColorUtils.getMenuBgColor(getContext());
+        }
+
+        /** A raised copy of the row that follows the finger while its place stays empty. */
+        private void lift(View child, float[] origin) {
+            Bitmap bitmap =
+                    Bitmap.createBitmap(
+                            Math.max(1, child.getWidth()),
+                            Math.max(1, child.getHeight()),
+                            Bitmap.Config.ARGB_8888);
+            Canvas canvas = new Canvas(bitmap);
+            canvas.drawColor(menuColor());
+            child.draw(canvas);
+            ImageView lift = new ImageView(getContext());
+            lift.setImageBitmap(bitmap);
+            GradientDrawable shape = new GradientDrawable();
+            shape.setColor(menuColor());
+            shape.setCornerRadius(dp(8));
+            lift.setBackground(shape);
+            lift.setClipToOutline(true);
+            lift.setElevation(dp(LIFT_ELEVATION_DP));
+            lift.setAlpha(0.96f);
+            lift.setScaleX(LIFT_SCALE);
+            lift.setScaleY(LIFT_SCALE);
+            lift.setImportantForAccessibility(View.IMPORTANT_FOR_ACCESSIBILITY_NO);
+            addView(lift, new FrameLayout.LayoutParams(child.getWidth(), child.getHeight()));
+            lift.setTranslationX(origin[0]);
+            lift.setTranslationY(origin[1]);
+            mLiftStartY = origin[1];
+            mLift = lift;
+        }
+
+        /** Where the list's top is in this frame; a row sits at this plus its top minus scrolled(). */
+        private float listTop() {
+            return originOf(mList)[1];
+        }
+
+        /** The place nearest to the middle of the raised row. */
+        private int nearestPlace() {
+            ImageView lift = mLift;
+            if (lift == null || mPlaces.length == 0) return mDragPlace;
+            float middle =
+                    lift.getTranslationY() - listTop() + scrolled() + mHeights[mRowPosition] / 2f;
+            int best = mDragPlace;
+            float bestDistance = Float.MAX_VALUE;
+            for (int k = 0; k < mPlaces.length; k++) {
+                int p = mPlaces[k];
+                float distance = Math.abs(mTops[p] + mHeights[p] / 2f - middle);
+                if (distance < bestDistance) {
+                    bestDistance = distance;
+                    best = k;
+                }
+            }
+            return best;
+        }
+
+        /** The position whose row ends up in place {@code k} with the dragged row at the target. */
+        private int rowAtPlace(int k) {
+            int from = mDragPlace;
+            int to = mTargetPlace;
+            if (k == to) return mPlaces[from];
+            if (from < to && k >= from && k < to) return mPlaces[k + 1];
+            if (from > to && k > to && k <= from) return mPlaces[k - 1];
+            return mPlaces[k];
+        }
+
+        /** Moves the other rows aside so there is a gap where the raised row would land. */
+        private void retarget() {
+            int target = nearestPlace();
+            if (target == mTargetPlace) return;
+            mTargetPlace = target;
+            ActionHaptics.tick(this);
+            int count = mTops.length;
+            int[] heightAt = mHeights.clone();
+            int[] rowAt = new int[count];
+            for (int p = 0; p < count; p++) rowAt[p] = p;
+            for (int k = 0; k < mPlaces.length; k++) {
+                rowAt[mPlaces[k]] = rowAtPlace(k);
+                heightAt[mPlaces[k]] = mHeights[rowAt[mPlaces[k]]];
+            }
+            int gap = Math.max(0, mList.getDividerHeight());
+            int top = 0;
+            float[] next = new float[count];
+            for (int p = 0; p < count; p++) {
+                next[rowAt[p]] = top - mTops[rowAt[p]];
+                top += heightAt[p] + gap;
+            }
+            if (mSlide != null) mSlide.cancel();
+            mFrom = mOffsets.clone();
+            mTo = next;
+            ValueAnimator slide = ValueAnimator.ofFloat(0f, 1f);
+            slide.setDuration(SLIDE_MS);
+            slide.setInterpolator(Interpolators.FAST_OUT_SLOW_IN_INTERPOLATOR);
+            slide.addUpdateListener(
+                    a -> {
+                        float f = (float) a.getAnimatedValue();
+                        for (int p = 0; p < mOffsets.length; p++) {
+                            mOffsets[p] = mFrom[p] + (mTo[p] - mFrom[p]) * f;
+                        }
+                        mList.invalidate();
+                    });
+            mSlide = slide;
+            slide.start();
+        }
+
+        /** Puts each row shown where the drag has it; the dragged row's own place stays empty. */
+        private void applyOffsets() {
+            int first = mList.getFirstVisiblePosition();
+            for (int i = 0; i < mList.getChildCount(); i++) {
+                int position = first + i;
+                View child = mList.getChildAt(i);
+                if (position >= mOffsets.length) continue;
+                child.setTranslationY(mRowChild == null ? 0f : mOffsets[position]);
+                child.setAlpha(mRowChild != null && position == mRowPosition ? 0f : 1f);
+            }
+        }
+
+        /** Scrolls the list while the finger is near its top or bottom edge. */
+        private void autoScroll(long frameTimeNanos) {
+            mScrolling = false;
+            if (mRowChild == null || mSettling) return;
+            float listTop = Math.max(originOf(mList)[1], 0f);
+            float listBottom = Math.min(originOf(mList)[1] + mList.getHeight(), getHeight());
+            float zone = dp(EDGE_ZONE_DP);
+            float step = 0;
+            if (mLastY < listTop + zone && mList.canScrollVertically(-1)) {
+                float near = (listTop + zone - mLastY) / zone;
+                step = -dp(MAX_SCROLL_DP_PER_FRAME) * Math.min(1f, near * near);
+            } else if (mLastY > listBottom - zone && mList.canScrollVertically(1)) {
+                float near = (mLastY - (listBottom - zone)) / zone;
+                step = dp(MAX_SCROLL_DP_PER_FRAME) * Math.min(1f, near * near);
+            }
+            if (step == 0) return;
+            mList.scrollListBy(Math.round(step));
+            retarget();
+            mScrolling = true;
+            Choreographer.getInstance().postFrameCallback(mAutoScroll);
+        }
+
+        private boolean handleRowDrag(MotionEvent event) {
+            if (mSettling) return true;
+            switch (event.getActionMasked()) {
+                case MotionEvent.ACTION_MOVE:
+                    mLastY = event.getY();
+                    if (mLift != null) mLift.setTranslationY(mLiftStartY + mLastY - mRowDownY);
+                    retarget();
+                    if (!mScrolling) {
+                        mScrolling = true;
+                        Choreographer.getInstance().postFrameCallback(mAutoScroll);
+                    }
+                    return true;
+                case MotionEvent.ACTION_UP:
+                    finishRowDrag(true);
+                    return true;
+                case MotionEvent.ACTION_CANCEL:
+                    finishRowDrag(false);
+                    return true;
+                default:
+                    // The finger-down that started the drag arrives here once more.
+                    return true;
+            }
+        }
+
+        /** Lets the raised row settle into its gap, then saves the move in one step. */
+        private void finishRowDrag(boolean drop) {
+            if (mRowChild == null || mSettling) return;
+            Choreographer.getInstance().removeFrameCallback(mAutoScroll);
+            mScrolling = false;
+            boolean moved = drop && mTargetPlace >= 0 && mTargetPlace != mDragPlace;
+            int targetId = moved ? itemIdAt(mPlaces[mTargetPlace]) : -1;
+            boolean after = mTargetPlace > mDragPlace;
+            int movedId = mRowId;
+            if (!moved) {
+                // Back where it came from: the others slide back too.
+                mTargetPlace = mDragPlace;
+                if (mSlide != null) mSlide.cancel();
+                mFrom = mOffsets.clone();
+                mTo = new float[mOffsets.length];
+            }
+            float landing =
+                    listTop()
+                            - scrolled()
+                            + mTops[mRowPosition]
+                            + (moved ? mTo[mRowPosition] : 0);
+            mSettling = true;
+            ImageView lift = mLift;
+            if (lift == null) {
+                endRowDrag(movedId, targetId, after);
+                return;
+            }
+            ValueAnimator settle = ValueAnimator.ofFloat(0f, 1f);
+            float startY = lift.getTranslationY();
+            settle.setDuration(SETTLE_MS_DROP);
+            settle.setInterpolator(Interpolators.DECELERATE_INTERPOLATOR);
+            settle.addUpdateListener(
+                    a -> {
+                        float f = (float) a.getAnimatedValue();
+                        lift.setTranslationY(startY + (landing - startY) * f);
+                        float scale = LIFT_SCALE + (1f - LIFT_SCALE) * f;
+                        lift.setScaleX(scale);
+                        lift.setScaleY(scale);
+                        lift.setElevation(dp(LIFT_ELEVATION_DP) * (1f - f));
+                        if (!moved) {
+                            for (int p = 0; p < mOffsets.length; p++) {
+                                mOffsets[p] = mFrom[p] + (mTo[p] - mFrom[p]) * f;
+                            }
+                            mList.invalidate();
+                        }
+                    });
+            settle.addListener(
+                    new AnimatorListenerAdapter() {
+                        @Override
+                        public void onAnimationEnd(Animator animation) {
+                            endRowDrag(movedId, targetId, after);
+                        }
+                    });
+            if (mSlide != null && !moved) mSlide.cancel();
+            settle.start();
+        }
+
+        /**
+         * Saves the move and clears the drag in one go. The menu is rebuilt in the new order while
+         * the rows are still drawn where the drag put them, so the rebuild does not show.
+         */
+        private void endRowDrag(int movedId, int targetId, boolean after) {
+            if (mSlide != null) mSlide.cancel();
+            mSlide = null;
+            boolean changed = false;
+            if (targetId != -1) changed = mMoveHandler.move(movedId, targetId, after);
+            if (changed) ActionHaptics.tick(this);
+            mList.getViewTreeObserver().removeOnPreDrawListener(mApplyOffsets);
+            mList.setRecyclerListener(null);
+            mRowChild = null;
+            mRowPosition = -1;
+            mDragPlace = -1;
+            mTargetPlace = -1;
+            for (int i = 0; i < mList.getChildCount(); i++) {
+                View child = mList.getChildAt(i);
+                child.setTranslationY(0f);
+                child.setAlpha(1f);
+            }
+            if (mLift != null) removeView(mLift);
+            mLift = null;
+            mSettling = false;
+            mList.invalidate();
+        }
+
+        /** Draws the drag handles over the list; they move with their rows. */
+        private final class RowHandles extends Drawable {
+            @Override
+            public void draw(Canvas canvas) {
+                if (!editing()) return;
+                for (int i = 0; i < mList.getChildCount(); i++) {
+                    int position = mList.getFirstVisiblePosition() + i;
+                    if (!movable(position) || position == mRowPosition) continue;
+                    View child = mList.getChildAt(i);
+                    float centerX = child.getLeft() + child.getWidth() - dp(84);
+                    float centerY =
+                            child.getTop() + child.getTranslationY() + child.getHeight() / 2f;
+                    for (int line = -1; line <= 1; line++) {
+                        float y = centerY + line * dp(5);
+                        canvas.drawRoundRect(
+                                centerX - dp(8),
+                                y - dp(1),
+                                centerX + dp(8),
+                                y + dp(1),
+                                dp(1),
+                                dp(1),
+                                mHandlePaint);
+                    }
+                }
+            }
+
+            @Override
+            public void setAlpha(int alpha) {}
+
+            @Override
+            public void setColorFilter(android.graphics.ColorFilter colorFilter) {}
+
+            @Override
+            public int getOpacity() {
+                return android.graphics.PixelFormat.TRANSLUCENT;
+            }
+        }
+
+        @Override
+        public boolean onInterceptTouchEvent(MotionEvent event) {
+            // Only a finger-down on a handle is taken; every other touch goes to the list.
+            return event.getActionMasked() == MotionEvent.ACTION_DOWN && beginRowDrag(event);
+        }
+
+        @Override
+        public boolean onTouchEvent(MotionEvent event) {
+            if (mRowChild != null) return handleRowDrag(event);
+            return super.onTouchEvent(event);
+        }
+    }

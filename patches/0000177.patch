@@ -119,6 +123,60 @@ public final class BarePageTranslator {
                 .show();
     }
 
+    /**
+     * Asks for the address of a translation server. This is what the menu item does until one is
+     * set, so that the feature can be found without knowing where its setting is.
+     */
+    private static void showSetupDialog(Activity activity, Tab tab) {
+        EditText field = new EditText(activity);
+        field.setInputType(InputType.TYPE_CLASS_TEXT | InputType.TYPE_TEXT_VARIATION_URI);
+        field.setSingleLine(true);
+        field.setHint(R.string.bare_translate_server_hint);
+        String existing = BareTranslateSettings.getEndpoint();
+        if (!existing.isEmpty()) field.setText(existing);
+        FrameLayout holder = new FrameLayout(activity);
+        int pad = (int) (20 * activity.getResources().getDisplayMetrics().density);
+        holder.setPadding(pad, pad / 2, pad, 0);
+        holder.addView(field);
+        AlertDialog dialog =
+                new AlertDialog.Builder(activity, R.style.ThemeOverlay_BrowserUI_AlertDialog)
+                        .setTitle(R.string.bare_translate_setup_title)
+                        .setMessage(R.string.bare_translate_setup_message)
+                        .setView(holder)
+                        .setPositiveButton(R.string.bare_translate_setup_save, null)
+                        .setNeutralButton(R.string.bare_translate_setup_settings, null)
+                        .setNegativeButton(R.string.cancel, null)
+                        .create();
+        dialog.setOnShowListener(
+                d -> {
+                    // Set here so that a refused address leaves the dialog open.
+                    dialog.getButton(AlertDialog.BUTTON_POSITIVE)
+                            .setOnClickListener(
+                                    v -> {
+                                        String entered = field.getText().toString().trim();
+                                        if (!BareTranslateProtocol.isAllowedEndpoint(entered)) {
+                                            field.setError(
+                                                    activity.getString(
+                                                            R.string.bare_translate_setup_refused));
+                                            return;
+                                        }
+                                        BareTranslateSettings.setEndpoint(entered);
+                                        dialog.dismiss();
+                                        onMenuItemClicked(activity, tab);
+                                    });
+                    dialog.getButton(AlertDialog.BUTTON_NEUTRAL)
+                            .setOnClickListener(
+                                    v -> {
+                                        dialog.dismiss();
+                                        SettingsNavigationFactory.createSettingsNavigation()
+                                                .startSettings(
+                                                        activity,
+                                                        BareTranslateSettingsFragment.class);
+                                    });
+                });
+        dialog.show();
+    }
+
     private static void start(Context context, Tab tab) {
         WebContents webContents = tab.getWebContents();
         if (webContents == null) return;
diff --git a/chrome/android/java/src/org/chromium/chrome/browser/translate/TranslateUtils.java b/chrome/android/java/src/org/chromium/chrome/browser/translate/TranslateUtils.java
index b3c00fb5b88..edaa32e3da5 100644
--- a/chrome/android/java/src/org/chromium/chrome/browser/translate/TranslateUtils.java
+++ b/chrome/android/java/src/org/chromium/chrome/browser/translate/TranslateUtils.java
@@ -5,7 +5,6 @@
 package org.chromium.chrome.browser.translate;
 
 import org.chromium.build.annotations.NullMarked;
-import org.chromium.chrome.browser.bare.translate.BareTranslateSettings;
 import org.chromium.chrome.browser.tab.Tab;
 
 /** Utility classes related to the translate feature. */
@@ -28,10 +27,8 @@ public class TranslateUtils {
      * @param menuLogging Whether logging should be performed in this check.
      */
     public static boolean canTranslateCurrentTab(Tab tab, boolean menuLogging) {
-        // De-Googled build: the item shows when the user has pointed page translation at a server.
-        // Google's own service needs an API key this build does not have.
-        return !tab.isNativePage()
-                && tab.getWebContents() != null
-                && BareTranslateSettings.isConfigured();
+        // De-Googled build: the item always shows, so it can be found. Without a server it asks
+        // for one. Google's own service needs an API key this build does not have.
+        return !tab.isNativePage() && tab.getWebContents() != null;
     }
 }

From f429a71ae6ae645084d14f846eae90125caaac32 Mon Sep 17 00:00:00 2001
From: Bare <git@barebrowser.org>
Date: Mon, 7 Sep 2026 07:20:01 +0000
Subject: [PATCH] Stop fetching the suggested sites list from Google

The new tab page asks www.gstatic.com for a list of popular sites so it has
something to show before there is any browsing history to show, and the list it
comes back with is Google, Amazon, Facebook and YouTube. Nothing else in this
browser reaches that host, and unlike the component updater there is no security
argument for keeping it.

MostVisitedSites already treats the provider as optional: it is a unique_ptr,
it is null checked everywhere it is read, and the one place that is not checked
runs only as the download callback, which cannot fire when no fetch is started.
So the factory returns nothing and the tiles come from the user's own history.
---
 .../ntp_tiles/chrome_popular_sites_factory.cc        | 12 +++++++-----
 1 file changed, 7 insertions(+), 5 deletions(-)

diff --git a/chrome/browser/ntp_tiles/chrome_popular_sites_factory.cc b/chrome/browser/ntp_tiles/chrome_popular_sites_factory.cc
index 90e98a8366f..784d3805e3f 100644
--- a/chrome/browser/ntp_tiles/chrome_popular_sites_factory.cc
+++ b/chrome/browser/ntp_tiles/chrome_popular_sites_factory.cc
@@ -12,9 +12,11 @@
 
 std::unique_ptr<ntp_tiles::PopularSites>
 ChromePopularSitesFactory::NewForProfile(Profile* profile) {
-  return std::make_unique<ntp_tiles::PopularSitesImpl>(
-      profile->GetPrefs(), TemplateURLServiceFactory::GetForProfile(profile),
-      g_browser_process->variations_service(),
-      profile->GetDefaultStoragePartition()
-          ->GetURLLoaderFactoryForBrowserProcess());
+  // Bare ships no popular sites. Upstream downloads a list from
+  // www.gstatic.com to fill the new tab page before there is any browsing
+  // history to fill it with, and that list is Google, Amazon, Facebook and
+  // YouTube. MostVisitedSites already treats this as optional and null-checks
+  // it everywhere it is read, so declining to build it leaves the tiles to the
+  // user's own history.
+  return nullptr;
 }

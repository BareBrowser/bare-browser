From 6cf20a6c30b98bd58534344d9f62eaa0049d95bd Mon Sep 17 00:00:00 2001
From: Bare <git@barebrowser.org>
Date: Sat, 15 Aug 2026 17:56:36 +0000
Subject: [PATCH] Patch 0000003

---
 .../chrome/browser/toolbar/ToolbarManager.java      |  6 +++++-
 .../toolbar/java/res/layout/toolbar_phone.xml       | 13 +++++++++++++
 2 files changed, 18 insertions(+), 1 deletion(-)

diff --git a/chrome/android/java/src/org/chromium/chrome/browser/toolbar/ToolbarManager.java b/chrome/android/java/src/org/chromium/chrome/browser/toolbar/ToolbarManager.java
index 774d76e8da1..c92353d82ed 100644
--- a/chrome/android/java/src/org/chromium/chrome/browser/toolbar/ToolbarManager.java
+++ b/chrome/android/java/src/org/chromium/chrome/browser/toolbar/ToolbarManager.java
@@ -2779,7 +2779,11 @@ public class ToolbarManager
                                                         mActivityTabProvider.asObservable(),
                                                         mTabCreatorManager.getTabCreator(false),
                                                         getBrowsingModeThemeColorProvider(),
-                                                        (ToolbarTablet) mToolbarLayout,
+                                                        // The extensions coordinator only needs a ViewGroup; ToolbarLayout (the
+                                                        // common base of ToolbarPhone and ToolbarTablet) already satisfies that.
+                                                        // Casting to ToolbarTablet crashed on phone layouts once the extensions
+                                                        // toolbar stub was added to toolbar_phone.xml.
+                                                        mToolbarLayout,
                                                         contextMenuPopulatorFactory,
                                                         selectionDropdownMenuDelegate,
                                                         mTabModelSelector,
diff --git a/chrome/browser/ui/android/toolbar/java/res/layout/toolbar_phone.xml b/chrome/browser/ui/android/toolbar/java/res/layout/toolbar_phone.xml
index 9e1f21d5a0c..d6ed4755066 100644
--- a/chrome/browser/ui/android/toolbar/java/res/layout/toolbar_phone.xml
+++ b/chrome/browser/ui/android/toolbar/java/res/layout/toolbar_phone.xml
@@ -74,6 +74,19 @@ found in the LICENSE file.
             android:layout_height="match_parent"
             android:visibility="gone"/>
 
+        <!-- Extensions toolbar. ToolbarManager only creates the
+             ExtensionsToolbarCoordinator when this stub is present in the control
+             container, so declaring it here enables the extensions menu (popups,
+             pinning, per-site permissions) on phone-sized layouts, which previously
+             had no way to reach it. Mirrors toolbar_tablet.xml. -->
+        <ViewStub
+            android:id="@+id/extensions_toolbar_container_stub"
+            android:inflatedId="@+id/extensions_toolbar_container"
+            android:layout_width="wrap_content"
+            android:layout_height="?attr/toolbarButtonHeight"
+            android:layout_gravity="top"
+            android:layout_marginVertical="?attr/toolbarButtonMarginVertical"/>
+
         <org.chromium.chrome.browser.toolbar.top.ToggleTabStackButton
             android:id="@+id/tab_switcher_button"
             style="@style/ToolbarHoverableButton"

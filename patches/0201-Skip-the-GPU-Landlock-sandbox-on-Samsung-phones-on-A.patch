From 8241788fb96081e67fc141e93d6a4ee548d92e6c Mon Sep 17 00:00:00 2001
From: Bare <git@barebrowser.org>
Date: Fri, 16 Oct 2026 18:07:17 +0000
Subject: [PATCH] Skip the GPU Landlock sandbox on Samsung phones on Android 17

Samsung's One UI 9 kernels (6.12, seen on the S26+ and S26 Ultra) get the
Landlock ruleset refcount wrong. Once the GPU process restricts itself,
the kernel warns about the refcount in landlock_get_ruleset on clone and
in landlock_put_ruleset_deferred when credentials are freed, then frees
the ruleset while it is still in use. The next file open or unix socket
send checked against it reads freed memory, and the phone panics and
reboots. The same phones ran Bare fine on One UI 8.5.

Chrome itself never turns this sandbox on. Desktop-class Android builds
force it on, and Bare is one of them.

On Samsung devices on Android 17 or later we now skip Landlock in the
GPU process and log one line saying so. Every other device keeps it.
This is temporary: once Samsung ships a fixed kernel, the check should
be narrowed to the affected builds or removed.

Reported in issue #82.
---
 sandbox/policy/linux/landlock_gpu_policy_android.cc | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/sandbox/policy/linux/landlock_gpu_policy_android.cc b/sandbox/policy/linux/landlock_gpu_policy_android.cc
index 8d2c9ae0136..997a5b7819a 100644
--- a/sandbox/policy/linux/landlock_gpu_policy_android.cc
+++ b/sandbox/policy/linux/landlock_gpu_policy_android.cc
@@ -11,6 +11,7 @@
 #include "base/command_line.h"
 #include "base/files/scoped_file.h"
 #include "base/logging.h"
+#include "base/strings/string_util.h"
 #include "base/threading/thread_id_name_manager.h"
 #include "build/build_config.h"
 #include "sandbox/linux/services/thread_helpers.h"
@@ -71,6 +72,18 @@ bool ApplyLandlock(sandbox::mojom::Sandbox sandbox_type) {
     return false;
   }
 
+  // Samsung kernels shipped with Android 17 (One UI 9) corrupt the Landlock
+  // ruleset refcount and panic the whole phone once the GPU process restricts
+  // itself. Temporary: narrow this to the affected builds, or drop it, once
+  // Samsung ships a fixed kernel.
+  if (base::android::android_info::sdk_int() >=
+          base::android::android_info::SdkVersion::SDK_VERSION_CINNAMON_BUN &&
+      base::EqualsCaseInsensitiveASCII(
+          base::android::android_info::manufacturer(), "samsung")) {
+    LOG(ERROR) << "Skipping Landlock on Samsung Android 17+ (kernel bug)";
+    return false;
+  }
+
   // TODO(akhna): ideally, Landlock would be applied in a single-threaded
   // environment. However, the variety of threads created by the Android
   // Runtime make this non-trivial. We should eventually find a way to mitigate
-- 

+
+<resources>
+    <!-- Title of the task manager card. -->
+    <string name="bare_tasks_title">Task manager</string>
+    <!-- Button that sorts the task list by memory use. -->
+    <string name="bare_tasks_memory">Memory</string>
+    <!-- Button that sorts the task list by processor use. CPU is short for central processing unit. -->
+    <string name="bare_tasks_cpu">CPU</string>
+    <!-- Line under the title. %1$s is the total memory in use, for example 1.2 GB; %2$d is the number of tasks. -->
+    <plurals name="bare_tasks_summary">
+        <item quantity="one">%1$s in use, %2$d task</item>
+        <item quantity="other">%1$s in use, %2$d tasks</item>
+    </plurals>
+    <!-- Processor use of one task. %1$.1f is a percentage such as 2.5. -->
+    <string name="bare_tasks_cpu_value">%1$.1f%% CPU</string>
+    <!-- Details of an opened task, on two lines. %1$d is the process number; %2$s is the network use, for example 3 MB. -->
+    <string name="bare_tasks_process_network">Process %1$d\nNetwork %2$s</string>
+    <!-- Button that ends a task. -->
+    <string name="bare_tasks_end">End</string>
+    <!-- Shown in place of the End button for a task that cannot be ended. %1$s is the browser name. -->
+    <string name="bare_tasks_needed_by">Needed by %1$s</string>
+    <!-- Toast after a task was ended. %1$s is the task name. -->
+    <string name="bare_tasks_ended">Ended %1$s</string>
+    <!-- Name of the graphics process. -->
+    <string name="bare_tasks_type_graphics">Graphics</string>
+    <!-- Name of a page process that is waiting for the next tab. -->
+    <string name="bare_tasks_type_spare">Spare renderer</string>
+    <!-- Kind label of the main browser process. -->
+    <string name="bare_tasks_type_browser">Browser</string>
+    <!-- Kind label of the graphics process. -->
+    <string name="bare_tasks_type_graphics_process">Graphics process</string>
+    <!-- Kind label of a helper (utility) process. -->
+    <string name="bare_tasks_type_utility">Utility process</string>
+    <!-- Kind label of an extension. -->
+    <string name="bare_tasks_type_extension">Extension</string>
+    <!-- Kind label of a page process that is ready for the next tab. -->
+    <string name="bare_tasks_type_ready">Ready for the next tab</string>
+    <!-- Kind label of a tab. -->
+    <string name="bare_tasks_type_tab">Tab</string>
+    <!-- Kind label of a page process that is not a tab. -->
+    <string name="bare_tasks_type_page">Page process</string>
+    <!-- Kind label of any other process. -->
+    <string name="bare_tasks_type_process">Process</string>
+</resources>

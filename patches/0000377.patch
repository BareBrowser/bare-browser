+    /**
+     * How many characters at the start of a title are the browser's translated prefix, for example
+     * "Tab: ". It is the text up to and including the first colon (also the full-width one) and the
+     * space after it, when that colon is near the start. Zero when there is no such prefix.
+     */
+    private static int prefixLength(String title) {
+        int limit = Math.min(title.length(), 40);
+        for (int i = 1; i < limit; i++) {
+            char c = title.charAt(i);
+            if (c == ':' || c == '\uFF1A') {
+                int end = i + 1;
+                if (end < title.length() && title.charAt(end) == ' ') end++;
+                return end;
+            }
         }
+        return 0;

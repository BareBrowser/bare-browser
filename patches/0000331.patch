+            throw new SecurityException("commitment");
+        }
+        return BareBackupBridge.matchingCode(a, b);
+    }
+
+    private void awaitConfirmation(DataInputStream in) throws IOException {
+        int type = in.readUnsignedByte();
+        int length = in.readInt();
+        if (length < 0 || length > MAX_CONTROL_FRAME) throw new IOException("frame");
+        in.skipBytes(length);
+        if (type == FRAME_CONFIRM) {
+            mHandler.post(
+                    () -> {
+                        mConfirmedThere = true;
+                        maybeConfirmed();
+                    });
+        } else {
+            mHandler.post(() -> fail(R.string.bare_direct_not_confirmed));
+        }
+    }
+
+    // ---------------------------------------------------------------------------------------
+    // The person's answer.
+
+    /** This phone's person says the codes match. */
+    void confirmCode() {
+        if (mEnded || mState != State.CHECKING || mConfirmedHere) return;
+        mConfirmedHere = true;
+        send(FRAME_CONFIRM);
+        notifyObservers();
+        maybeConfirmed();
+    }
+
+    /** This phone's person says they don't, or backs out. */
+    void cancel() {
+        if (mEnded) return;
+        if (mOut != null) send(FRAME_CANCEL);
+        end(State.FAILED, 0);
+    }
+
+    private void maybeConfirmed() {
+        if (mEnded || !mConfirmedHere || !mConfirmedThere) return;
+        mHandler.removeCallbacks(mGiveUp);
+        setState(State.CONFIRMED);
+    }
+
+    private void send(int type) {
+        DataOutputStream out = mOut;
+        if (out == null) return;
+        mWriter.execute(
+                () -> {
+                    try {
+                        synchronized (out) {
+                            out.writeByte(type);
+                            out.writeInt(0);
+                            out.flush();
+                        }
+                    } catch (IOException e) {
+                        // The other side has gone; its own error says so.
+                    }
+                });
+    }
+
+    // ---------------------------------------------------------------------------------------
+    // Ending.
+
+    private void fail(@StringRes int error) {
+        end(State.FAILED, error);
+    }
+
+    @SuppressLint("MissingPermission")
+    private void end(@State int state, @StringRes int error) {
+        if (mEnded) return;
+        mEnded = true;
+        mError = error;
+        mHandler.removeCallbacks(mGiveUp);
+        mHandler.removeCallbacks(mRediscover);
+        closeQuietly(mServer);
+        closeQuietly(mSocket);
+        mIo.shutdownNow();
+        mWriter.shutdown();
+        if (mIdentity != null) mIdentity.delete();
+        if (mReceiver != null) {
+            try {
+                mContext.unregisterReceiver(mReceiver);
+            } catch (IllegalArgumentException e) {
+                // Not registered.
+            }
+        }
+        if (mManager != null && mChannel != null) {
+            WifiP2pManager.Channel channel = mChannel;
+            mManager.clearLocalServices(channel, null);
+            mManager.clearServiceRequests(channel, null);
+            mManager.stopPeerDiscovery(channel, null);
+            mManager.cancelConnect(channel, null);
+            mManager.removeGroup(channel, null);
+            channel.close();
+        }
+        BareDirectServiceImpl.end(mContext);
+        if (sCurrent == this) sCurrent = null;
+        setState(state);
+    }
+
+    private void setState(@State int state) {
+        mState = state;
+        notifyObservers();
+    }
+
+    private void notifyObservers() {
+        for (Observer observer : mObservers) observer.onChanged();
+    }
+
+    // ---------------------------------------------------------------------------------------
+    // Helpers.
+
+    private byte[] randomNonce() {
+        byte[] nonce = new byte[32];
+        mRandom.nextBytes(nonce);
+        return nonce;
+    }
+
+    private static void write(DataOutputStream out, int type, JSONObject message)
+            throws IOException {
+        byte[] bytes = message.toString().getBytes(StandardCharsets.UTF_8);
+        synchronized (out) {
+            out.writeByte(type);
+            out.writeInt(bytes.length);
+            out.write(bytes);
+            out.flush();
+        }
+    }
+
+    private static JSONObject read(DataInputStream in, int expected)
+            throws IOException, JSONException {
+        return readBody(in, in.readUnsignedByte(), expected);
+    }
+
+    /** The rest of a frame whose type byte has been read. */
+    private static JSONObject readBody(DataInputStream in, int type, int expected)
+            throws IOException, JSONException {
+        int length = in.readInt();
+        if (type == FRAME_CANCEL) throw new IOException("cancelled");
+        if (type != expected || length < 0 || length > MAX_CONTROL_FRAME) {
+            throw new IOException("frame");
+        }
+        byte[] bytes = new byte[length];
+        in.readFully(bytes);
+        return new JSONObject(new String(bytes, StandardCharsets.UTF_8));
+    }
+
+    private static String hex(byte[] bytes) {
+        StringBuilder out = new StringBuilder(bytes.length * 2);
+        for (byte b : bytes) out.append(String.format("%02x", b & 0xff));
+        return out.toString();
+    }
+
+    private static byte[] unhex(String hex) throws IOException {
+        if (hex.length() % 2 != 0 || hex.length() > 128) throw new IOException("hex");
+        byte[] out = new byte[hex.length() / 2];
+        for (int i = 0; i < out.length; i++) {
+            int high = Character.digit(hex.charAt(2 * i), 16);
+            int low = Character.digit(hex.charAt(2 * i + 1), 16);
+            if (high < 0 || low < 0) throw new IOException("hex");
+            out[i] = (byte) ((high << 4) | low);
+        }
+        return out;
+    }
+
+    private static void closeQuietly(@Nullable Closeable closeable) {
+        if (closeable == null) return;
+        try {
+            closeable.close();
+        } catch (IOException e) {
+            // Already closed.
+        }
+    }
+
+    /** A Wi-Fi Direct call whose failure ends the transfer. */
+    private final class Step implements WifiP2pManager.ActionListener {
+        private final Runnable mNext;
+
+        Step(Runnable next) {
+            mNext = next;
+        }
+
+        @Override
+        public void onSuccess() {
+            if (!mEnded) mNext.run();
+        }
+
+        @Override
+        public void onFailure(int reason) {
+            fail(
+                    reason == WifiP2pManager.P2P_UNSUPPORTED
+                            ? R.string.bare_direct_unsupported
+                            : R.string.bare_direct_couldnt_start);
+        }
+    }
+
+    /** A Wi-Fi Direct call whose result doesn't matter: clean-up, or a retry that comes again. */
+    private final class Done implements WifiP2pManager.ActionListener {
+        private final Runnable mNext;
+
+        Done(Runnable next) {
+            mNext = next;
+        }
+
+        @Override
+        public void onSuccess() {
+            if (!mEnded) mNext.run();
+        }
+
+        @Override
+        public void onFailure(int reason) {
+            if (!mEnded) mNext.run();
+        }
+    }
+}

+                new BareDirectSession(ContextUtils.getApplicationContext(), sending);
+        sCurrent = session;
+        session.begin();
+        return session;
+    }
+
+    void addObserver(Observer observer) {
+        mObservers.addObserver(observer);
+    }
+
+    void removeObserver(Observer observer) {
+        mObservers.removeObserver(observer);
+    }
+
+    boolean isSending() {
+        return mSending;
+    }
+
+    void setMode(@Mode int mode) {
+        mMode = mode;
+    }
+
+    @Mode
+    int getMode() {
+        return mMode;
+    }
+
+    @State
+    int getState() {
+        return mState;
+    }
+
+    @StringRes
+    int getError() {
+        return mError;
+    }
+
+    String getPeerModel() {
+        return mPeerModel;
+    }
+
+    String getCode() {
+        return mCode;
+    }
+
+    boolean isConfirmedHere() {
+        return mConfirmedHere;
+    }
+
+    List<Peer> getPeers() {
+        return new ArrayList<>(mPeers.values());
+    }
+
+    /** This phone's name as the other phone sees it. */
+    static String thisModel() {
+        return Build.MODEL;
+    }
+
+    // ---------------------------------------------------------------------------------------
+    // Wi-Fi Direct.
+
+    @SuppressLint("MissingPermission") // The pages ask before starting a session.
+    private void begin() {
+        mManager = (WifiP2pManager) mContext.getSystemService(Context.WIFI_P2P_SERVICE);
+        if (mManager == null) {
+            fail(R.string.bare_direct_unsupported);
+            return;
+        }
+        mChannel =
+                mManager.initialize(
+                        mContext, Looper.getMainLooper(), () -> fail(R.string.bare_direct_lost));
+        if (mChannel == null) {
+            fail(R.string.bare_direct_unsupported);
+            return;
+        }
+        IntentFilter filter = new IntentFilter();
+        filter.addAction(WifiP2pManager.WIFI_P2P_STATE_CHANGED_ACTION);
+        filter.addAction(WifiP2pManager.WIFI_P2P_CONNECTION_CHANGED_ACTION);
+        mReceiver =
+                new BroadcastReceiver() {
+                    @Override
+                    public void onReceive(Context context, Intent intent) {
+                        onBroadcast(intent);
+                    }
+                };
+        ContextUtils.registerProtectedBroadcastReceiver(mContext, mReceiver, filter);
+        BareDirectServiceImpl.begin(mContext);
+        mHandler.postDelayed(mGiveUp, GIVE_UP_MS);
+
+        // A group left over from an earlier transfer would make this phone look busy.
+        mManager.removeGroup(
+                mChannel,
+                new Done(
+                        () -> {
+                            if (mSending) {
+                                look();
+                            } else {
+                                advertise();
+                            }
+                        }));
+    }
+
+    @SuppressLint("MissingPermission")
+    private void advertise() {
+        if (mEnded || mManager == null || mChannel == null) return;
+        Map<String, String> record = new HashMap<>();
+        record.put("v", PROTOCOL_VERSION);
+        record.put("m", thisModel());
+        WifiP2pDnsSdServiceInfo info =
+                WifiP2pDnsSdServiceInfo.newInstance("Bare", SERVICE_TYPE, record);
+        WifiP2pManager manager = mManager;
+        WifiP2pManager.Channel channel = mChannel;
+        manager.clearLocalServices(
+                channel,
+                new Done(
+                        () ->
+                                manager.addLocalService(
+                                        channel,
+                                        info,
+                                        new Step(
+                                                () -> {
+                                                    setState(State.WAITING);
+                                                    rediscover();
+                                                }))));
+    }
+
+    @SuppressLint("MissingPermission")
+    private void look() {
+        if (mEnded || mManager == null || mChannel == null) return;
+        WifiP2pManager manager = mManager;
+        WifiP2pManager.Channel channel = mChannel;
+        // A request for one service type only returns names, never the text record that
+        // carries the model, so ask for every service and pick Bare out of the answers.
+        manager.setDnsSdResponseListeners(
+                channel,
+                (instance, type, device) -> onNamed(type, device),
+                (domain, record, device) -> onFound(domain, record, device));
+        manager.clearServiceRequests(
+                channel,
+                new Done(
+                        () ->
+                                manager.addServiceRequest(
+                                        channel,
+                                        WifiP2pDnsSdServiceRequest.newInstance(),
+                                        new Step(
+                                                () -> {
+                                                    setState(State.LOOKING);
+                                                    rediscover();
+                                                }))));
+    }
+
+    /**
+     * Keeps this phone findable (receiver) or keeps looking (sender). Android stops either after
+     * a while on its own.
+     */
+    @SuppressLint("MissingPermission")
+    private void rediscover() {

+package org.chromium.chrome.browser.bare.backup;
+
+import android.app.Notification;
+import android.content.Context;
+import android.content.Intent;
+import android.content.pm.ServiceInfo;
+import android.os.IBinder;
+
+import androidx.core.app.ServiceCompat;
+
+import org.chromium.base.SplitCompatService;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.chrome.R;
+import org.chromium.chrome.browser.notifications.NotificationUmaTracker;
+import org.chromium.chrome.browser.notifications.NotificationWrapperBuilderFactory;
+import org.chromium.chrome.browser.notifications.channels.ChromeChannelDefinitions;
+import org.chromium.components.browser_ui.notifications.ForegroundServiceUtils;
+import org.chromium.components.browser_ui.notifications.NotificationMetadata;
+
+/**
+ * The foreground service for a phone-to-phone transfer. It only holds Bare in the foreground with
+ * an ongoing notification; {@link BareDirectSession} does the work.
+ */
+public class BareDirectServiceImpl extends SplitCompatService.Impl {
+    private static final String NOTIFICATION_TAG = "bare_direct";
+    private static final int NOTIFICATION_ID = 0x62646972;
+
+    private static boolean sRunning;
+
+    static void begin(Context context) {
+        if (sRunning) return;
+        sRunning = true;
+        ForegroundServiceUtils.getInstance()
+                .startForegroundService(new Intent(context, BareDirectService.class));
+    }
+
+    static void end(Context context) {
+        if (!sRunning) return;
+        sRunning = false;
+        context.stopService(new Intent(context, BareDirectService.class));
+    }
+
+    @Override
+    public int onStartCommand(@Nullable Intent intent, int flags, int startId) {
+        if (!sRunning) {
+            getService().stopSelf();
+            return android.app.Service.START_NOT_STICKY;
+        }
+        ForegroundServiceUtils.getInstance()
+                .startForeground(
+                        getService(),
+                        NOTIFICATION_ID,
+                        notification(getService()),
+                        ServiceInfo.FOREGROUND_SERVICE_TYPE_CONNECTED_DEVICE);
+        // A transfer can't be picked up again after Android ends it.
+        return android.app.Service.START_NOT_STICKY;
+    }
+
+    @Override
+    public void onDestroy() {
+        ForegroundServiceUtils.getInstance()
+                .stopForeground(getService(), ServiceCompat.STOP_FOREGROUND_REMOVE);
+        super.onDestroy();
+    }
+
+    @Override
+    public @Nullable IBinder onBind(Intent intent) {
+        return null;
+    }
+
+    private static Notification notification(Context context) {
+        return NotificationWrapperBuilderFactory.createNotificationWrapperBuilder(
+                        ChromeChannelDefinitions.ChannelId.BROWSER,
+                        new NotificationMetadata(
+                                NotificationUmaTracker.SystemNotificationType.UNKNOWN,
+                                NOTIFICATION_TAG,
+                                NOTIFICATION_ID))
+                .setSmallIcon(R.drawable.ic_archive)
+                .setOngoing(true)
+                .setLocalOnly(true)
+                .setContentTitle(context.getString(R.string.bare_direct_notification_title))
+                .setContentText(context.getString(R.string.bare_direct_notification_text))
+                .build();
+    }
+}

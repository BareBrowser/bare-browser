+        if (mState != State.WAITING && mState != State.LOOKING) return;
+        if (mSending) {
+            mManager.discoverServices(mChannel, new Done(() -> {}));
+        } else {
+            mManager.discoverPeers(mChannel, new Done(() -> {}));
+        }
+        mHandler.postDelayed(mRediscover, REDISCOVER_MS);
+    }
+
+    /** A receiver that answered with its name only, listed by device name until its record. */
+    private void onNamed(String type, WifiP2pDevice device) {
+        if (mEnded || !type.contains(SERVICE_TYPE)) return;
+        if (mPeers.containsKey(device.deviceAddress)) return;
+        mPeers.put(device.deviceAddress, new Peer(device.deviceAddress, device.deviceName));
+        notifyObservers();
+    }
+
+    private void onFound(String domain, Map<String, String> record, WifiP2pDevice device) {
+        if (mEnded || !domain.contains(SERVICE_TYPE)) return;
+        if (!PROTOCOL_VERSION.equals(record.get("v"))) return;
+        String model = record.get("m");
+        if (model == null || model.isEmpty()) model = device.deviceName;
+        mPeers.put(device.deviceAddress, new Peer(device.deviceAddress, model));
+        notifyObservers();
+    }
+
+    /** The sender picked a receiver. */
+    @SuppressLint("MissingPermission")
+    void connect(Peer peer) {
+        if (mEnded || !mSending || mState != State.LOOKING) return;
+        if (mManager == null || mChannel == null) return;
+        mPeerModel = peer.model;
+        setState(State.CONNECTING);
+        WifiP2pConfig config = new WifiP2pConfig();
+        config.deviceAddress = peer.address;
+        config.wps.setup = WpsInfo.PBC;
+        // Lets the receiver be group owner where Android agrees.
+        config.groupOwnerIntent = 0;
+        mManager.connect(mChannel, config, new Step(() -> {}));
+    }
+
+    private void onBroadcast(Intent intent) {
+        if (mEnded || mManager == null || mChannel == null) return;
+        String action = intent.getAction();
+        if (WifiP2pManager.WIFI_P2P_STATE_CHANGED_ACTION.equals(action)) {
+            int p2p = intent.getIntExtra(WifiP2pManager.EXTRA_WIFI_STATE, -1);
+            if (p2p == WifiP2pManager.WIFI_P2P_STATE_DISABLED) fail(R.string.bare_direct_wifi_off);
+            return;
+        }
+        if (WifiP2pManager.WIFI_P2P_CONNECTION_CHANGED_ACTION.equals(action)) {
+            mManager.requestConnectionInfo(mChannel, this::onConnectionInfo);
+        }
+    }
+
+    private void onConnectionInfo(@Nullable WifiP2pInfo info) {
+        if (mEnded || info == null) return;
+        if (!info.groupFormed) {
+            // The group went away after the link was up: the other phone left or moved off.
+            if (mLinking) fail(R.string.bare_direct_lost);
+            return;
+        }
+        if (mLinking || info.groupOwnerAddress == null) return;
+        mLinking = true;
+        if (!mSending) setState(State.CONNECTING);
+        InetAddress owner = info.groupOwnerAddress;
+        boolean listen = info.isGroupOwner;
+        mIo.execute(() -> link(owner, listen));
+    }
+
+    // ---------------------------------------------------------------------------------------
+    // The connection, on the IO thread.
+
+    private void link(InetAddress owner, boolean listen) {
+        try {
+            Socket plain = listen ? accept(owner) : dial(owner);
+            plain.setSoTimeout(HANDSHAKE_TIMEOUT_MS);
+            Socket tls;
+            byte[] receiverCertificate;

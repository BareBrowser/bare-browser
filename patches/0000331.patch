+                BareDirectTls.Pinning pinning = new BareDirectTls.Pinning();
+                tls = pinning.connect(plain);
+                receiverCertificate = pinning.seen();
+                if (receiverCertificate == null) throw new IOException("no certificate");
+            } else {
+                BareDirectTls.Identity identity = BareDirectTls.Identity.create();
+                mIdentity = identity;
+                tls = identity.serve(plain);
+                receiverCertificate = identity.certificateBytes();
+            }

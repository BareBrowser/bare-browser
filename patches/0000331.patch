+
+package org.chromium.chrome.browser.bare.backup;
+
+import android.content.Context;
+import android.os.Bundle;
+
+import androidx.preference.Preference;
+import androidx.preference.PreferenceScreen;
+
+import org.chromium.build.annotations.Nullable;
+import org.chromium.chrome.R;
+import org.chromium.components.browser_ui.settings.ChromeBasePreference;
+
+import java.util.List;
+
+/** Settings > Backup and transfer > Send to another device. */
+public class BareDirectSendFragment extends BareDirectFragment {
+    private BareScreenLock mScreenLock;
+    private BareDirectModePreference mModes;
+
+    @Override
+    public void onCreate(@Nullable Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+        mScreenLock = new BareScreenLock(this);
+    }
+
+    @Override
+    protected int title() {
+        return R.string.bare_direct_send;
+    }
+
+    @Override
+    protected boolean isSending() {
+        return true;
+    }
+
+    @Override
+    public void onCreatePreferences(@Nullable Bundle savedInstanceState, @Nullable String rootKey) {
+        super.onCreatePreferences(savedInstanceState, rootKey);
+        if (mSession == null) choose();
+    }
+
+    /** The mode cards and the button. */
+    private void choose() {
+        PreferenceScreen screen = clear();
+        if (mModes == null) mModes = new BareDirectModePreference(getContext(), null);
+        screen.addPreference(mModes);
+        button(screen, R.string.bare_direct_find, this::find);
+    }
+
+    private void find() {
+        int mode = mModes.getMode();
+        Runnable search =
+                () ->
+                        mGate.check(
+                                () -> {
+                                    BareDirectSession session =
+                                            BareDirectSession.start(/* sending= */ true);
+                                    session.setMode(mode);
+                                    attach(session);
+                                },
+                                reason -> {});
+        if (mode == BareDirectSession.Mode.SETUP || !BareScreenLock.isSet(getContext())) {
+            search.run();
+            return;
+        }
+        mScreenLock.confirm(
+                ok -> {
+                    if (ok && getContext() != null) search.run();
+                });
+    }
+
+    @Override
+    protected void render() {
+        Context context = getContext();
+        PreferenceScreen screen = clear();
+        if (renderShared(screen, this::again)) return;
+        BareDirectSession session = mSession;
+        if (session == null) {
+            choose();
+            return;
+        }
+        heading(
+                screen,
+                context.getString(R.string.bare_direct_looking),
+                context.getString(R.string.bare_direct_looking_body));
+        List<BareDirectSession.Peer> peers = session.getPeers();
+        for (BareDirectSession.Peer peer : peers) {
+            Preference row = new ChromeBasePreference(context);
+            row.setTitle(peer.model);
+            row.setSummary(R.string.bare_direct_tap_to_connect);
+            row.setOnPreferenceClickListener(
+                    preference -> {
+                        session.connect(peer);
+                        return true;
+                    });
+            screen.addPreference(row);
+        }
+    }
+
+    private void again() {
+        if (mSession != null) mSession.removeObserver(this);
+        mSession = null;
+        choose();
+    }
+}

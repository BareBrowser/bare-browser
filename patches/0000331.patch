+
+/**
+ * Settings > Backup and transfer > Receive from another device, and the welcome's "From another
+ * phone".
+ */
+public class BareDirectReceiveFragment extends BareDirectFragment {
+    /** Set when opened from the welcome, which the restore then completes. */
+    public static final String ARG_FROM_WELCOME = "from_welcome";
+
+    private boolean mStarted;
+
+    @Override
+    protected int title() {
+        return R.string.bare_direct_receive;
+    }
+
+    @Override
+    protected boolean isSending() {
+        return false;
+    }
+
+    boolean fromWelcome() {
+        return getArguments() != null && getArguments().getBoolean(ARG_FROM_WELCOME);
+    }
+
+    @Override
+    public void onStart() {
+        super.onStart();
+        if (mStarted || mSession != null) return;
+        mStarted = true;
+        begin();
+    }
+
+    private void begin() {
+        mGate.check(
+                () -> attach(BareDirectSession.start(/* sending= */ false)),
+                reason -> showBlocked(reason));
+    }
+
+    private void showBlocked(int reason) {
+        if (getContext() == null) return;
+        PreferenceScreen screen = clear();
+        heading(screen, getContext().getString(reason), null);
+        button(screen, R.string.bare_direct_try_again, this::begin);
+    }
+
+    @Override
+    protected void render() {
+        Context context = getContext();
+        PreferenceScreen screen = clear();
+        if (renderShared(screen, this::begin)) return;
+        heading(
+                screen,
+                context.getString(R.string.bare_direct_waiting),
+                context.getString(R.string.bare_direct_waiting_body));
+        heading(
+                screen,
+                context.getString(R.string.bare_direct_this_phone, BareDirectSession.thisModel()),
+                null);
+    }
+}

+        JSONObject back = read(in, FRAME_HELLO_BACK);
+        if (!PROTOCOL_VERSION.equals(back.optString("v"))) throw new IOException("version");
+        byte[] b = unhex(back.optString("b"));
+        String model = back.optString("model");
+        mHandler.post(() -> mPeerModel = model.isEmpty() ? mPeerModel : model);

+        State.WAITING,
+        State.LOOKING,
+        State.CONNECTING,
+        State.CHECKING,
+        State.CONFIRMED,
+        State.FAILED
+    })
+    @Retention(RetentionPolicy.SOURCE)
+    @interface State {
+        int STARTING = 0;
+        // The receiver is advertising.
+        int WAITING = 1;
+        // The sender is listing receivers.
+        int LOOKING = 2;
+        int CONNECTING = 3;
+        // Both phones show the code.
+        int CHECKING = 4;
+        int CONFIRMED = 5;
+        int FAILED = 6;
+    }
+
+    /** What the sender chose to send. */
+    @IntDef({Mode.SETUP, Mode.COPY, Mode.MOVE})
+    @Retention(RetentionPolicy.SOURCE)
+    @interface Mode {
+        int SETUP = 0;
+        int COPY = 1;
+        int MOVE = 2;
+    }
+
+    /** A receiver the sender has found. */
+    static final class Peer {
+        final String address;
+        final String model;
+
+        Peer(String address, String model) {
+            this.address = address;
+            this.model = model;
+        }
+    }
+
+    interface Observer {
+        void onChanged();
+    }
+
+    private static @Nullable BareDirectSession sCurrent;
+
+    private final boolean mSending;
+    private final Context mContext;
+    private final Handler mHandler = new Handler(Looper.getMainLooper());
+    private final ObserverList<Observer> mObservers = new ObserverList<>();
+    private final ExecutorService mIo = Executors.newSingleThreadExecutor();
+    private final ExecutorService mWriter = Executors.newSingleThreadExecutor();
+    private final Map<String, Peer> mPeers = new LinkedHashMap<>();

@@ -0,0 +1,244 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.bare.backup;
+
+import android.security.keystore.KeyGenParameterSpec;
+import android.security.keystore.KeyProperties;
+
+import org.chromium.build.annotations.Nullable;
+
+import java.io.IOException;
+import java.math.BigInteger;
+import java.net.Socket;
+import java.security.GeneralSecurityException;
+import java.security.KeyPairGenerator;
+import java.security.KeyStore;
+import java.security.Principal;
+import java.security.PrivateKey;
+import java.security.SecureRandom;
+import java.security.cert.CertificateException;
+import java.security.cert.X509Certificate;
+import java.security.spec.ECGenParameterSpec;
+import java.util.Date;
+
+import javax.net.ssl.KeyManager;
+import javax.net.ssl.SSLContext;
+import javax.net.ssl.SSLEngine;
+import javax.net.ssl.SSLSocket;
+import javax.net.ssl.TrustManager;
+import javax.net.ssl.X509ExtendedKeyManager;
+import javax.net.ssl.X509ExtendedTrustManager;
+import javax.security.auth.x500.X500Principal;
+
+/**
+ * TLS for a phone-to-phone transfer. The receiver is the TLS server, with a key pair and
+ * self-signed certificate made in Android Keystore for this transfer and deleted after it. The
+ * sender accepts whatever single certificate it is shown and keeps its bytes; the matching code
+ * is what proves it was the right one.
+ */
+final class BareDirectTls {
+    private static final String KEYSTORE = "AndroidKeyStore";
+    private static final String PROTOCOL = "TLSv1.3";
+
+    private BareDirectTls() {}
+
+    /** The receiver's key and certificate for one transfer. */
+    static final class Identity {
+        private final String mAlias;
+        private final PrivateKey mKey;
+        private final X509Certificate mCertificate;
+
+        private Identity(String alias, PrivateKey key, X509Certificate certificate) {
+            mAlias = alias;
+            mKey = key;
+            mCertificate = certificate;
+        }
+
+        static Identity create() throws GeneralSecurityException, IOException {
+            byte[] random = new byte[8];
+            new SecureRandom().nextBytes(random);
+            String alias = "bare_direct_" + new BigInteger(1, random).toString(16);
+            long now = System.currentTimeMillis();
+            KeyPairGenerator generator =
+                    KeyPairGenerator.getInstance(KeyProperties.KEY_ALGORITHM_EC, KEYSTORE);
+            generator.initialize(
+                    new KeyGenParameterSpec.Builder(alias, KeyProperties.PURPOSE_SIGN)
+                            .setAlgorithmParameterSpec(new ECGenParameterSpec("secp256r1"))
+                            .setDigests(
+                                    KeyProperties.DIGEST_NONE,
+                                    KeyProperties.DIGEST_SHA256,
+                                    KeyProperties.DIGEST_SHA384,
+                                    KeyProperties.DIGEST_SHA512)
+                            .setCertificateSubject(new X500Principal("CN=Bare"))
+                            .setCertificateSerialNumber(new BigInteger(1, random))
+                            .setCertificateNotBefore(new Date(now - 24L * 3600 * 1000))
+                            .setCertificateNotAfter(new Date(now + 24L * 3600 * 1000))
+                            .build());
+            generator.generateKeyPair();
+            KeyStore store = KeyStore.getInstance(KEYSTORE);
+            store.load(null);
+            PrivateKey key = (PrivateKey) store.getKey(alias, null);
+            X509Certificate certificate = (X509Certificate) store.getCertificate(alias);
+            return new Identity(alias, key, certificate);
+        }
+
+        byte[] certificateBytes() throws CertificateException {
+            return mCertificate.getEncoded();
+        }
+
+        void delete() {
+            try {
+                KeyStore store = KeyStore.getInstance(KEYSTORE);
+                store.load(null);
+                store.deleteEntry(mAlias);
+            } catch (GeneralSecurityException | IOException e) {
+                // The key is useless without the transfer it was made for.
+            }
+        }
+
+        /** Wraps a connected socket as the TLS server. */
+        SSLSocket serve(Socket socket) throws GeneralSecurityException, IOException {
+            SSLContext context = SSLContext.getInstance("TLS");
+            context.init(new KeyManager[] {new OneKey(mAlias, mKey, mCertificate)}, null, null);
+            return start(context, socket, /* client= */ false);
+        }
+    }
+
+    /** The sender's side: trusts the one certificate it is shown, and remembers it. */
+    static final class Pinning {
+        private byte @Nullable [] mSeen;
+
+        SSLSocket connect(Socket socket) throws GeneralSecurityException, IOException {
+            SSLContext context = SSLContext.getInstance("TLS");
+            context.init(null, new TrustManager[] {new RememberOne()}, null);
+            return start(context, socket, /* client= */ true);
+        }
+
+        /** The receiver's certificate as sent, or null before the handshake. */
+        byte @Nullable [] seen() {
+            return mSeen;
+        }
+
+        private final class RememberOne extends X509ExtendedTrustManager {
+            @Override
+            public void checkServerTrusted(X509Certificate[] chain, String authType)
+                    throws CertificateException {
+                if (chain == null || chain.length != 1) {
+                    throw new CertificateException("expected one certificate");
+                }
+                mSeen = chain[0].getEncoded();
+            }
+
+            @Override
+            public void checkServerTrusted(
+                    X509Certificate[] chain, String authType, Socket socket)
+                    throws CertificateException {
+                checkServerTrusted(chain, authType);
+            }
+
+            @Override
+            public void checkServerTrusted(
+                    X509Certificate[] chain, String authType, SSLEngine engine)
+                    throws CertificateException {
+                checkServerTrusted(chain, authType);
+            }
+
+            @Override
+            public void checkClientTrusted(X509Certificate[] chain, String authType)
+                    throws CertificateException {
+                throw new CertificateException("no client certificates");
+            }
+
+            @Override
+            public void checkClientTrusted(
+                    X509Certificate[] chain, String authType, Socket socket)
+                    throws CertificateException {
+                throw new CertificateException("no client certificates");
+            }
+
+            @Override
+            public void checkClientTrusted(
+                    X509Certificate[] chain, String authType, SSLEngine engine)
+                    throws CertificateException {
+                throw new CertificateException("no client certificates");
+            }
+
+            @Override
+            public X509Certificate[] getAcceptedIssuers() {
+                return new X509Certificate[0];
+            }
+        }
+    }
+
+    private static SSLSocket start(SSLContext context, Socket socket, boolean client)
+            throws IOException {
+        SSLSocket tls =
+                (SSLSocket)
+                        context.getSocketFactory()
+                                .createSocket(
+                                        socket,
+                                        socket.getInetAddress().getHostAddress(),
+                                        socket.getPort(),
+                                        /* autoClose= */ true);
+        tls.setUseClientMode(client);
+        tls.setEnabledProtocols(new String[] {PROTOCOL});
+        tls.startHandshake();
+        if (!PROTOCOL.equals(tls.getSession().getProtocol())) {
+            tls.close();
+            throw new IOException("not TLS 1.3");
+        }
+        return tls;
+    }
+
+    /** Offers the transfer's key and nothing else Bare keeps in Keystore. */
+    private static final class OneKey extends X509ExtendedKeyManager {
+        private final String mAlias;
+        private final PrivateKey mKey;
+        private final X509Certificate mCertificate;
+
+        OneKey(String alias, PrivateKey key, X509Certificate certificate) {
+            mAlias = alias;
+            mKey = key;
+            mCertificate = certificate;
+        }
+
+        @Override
+        public String[] getServerAliases(String keyType, Principal[] issuers) {
+            return new String[] {mAlias};
+        }
+
+        @Override
+        public String chooseServerAlias(String keyType, Principal[] issuers, Socket socket) {
+            return mAlias;
+        }
+
+        @Override
+        public String chooseEngineServerAlias(
+                String keyType, Principal[] issuers, SSLEngine engine) {
+            return mAlias;
+        }
+
+        @Override
+        public String @Nullable [] getClientAliases(String keyType, Principal[] issuers) {
+            return null;
+        }
+
+        @Override
+        public @Nullable String chooseClientAlias(
+                String[] keyType, Principal[] issuers, Socket socket) {
+            return null;
+        }
+
+        @Override
+        public X509Certificate[] getCertificateChain(String alias) {
+            return new X509Certificate[] {mCertificate};
+        }
+
+        @Override
+        public PrivateKey getPrivateKey(String alias) {
+            return mKey;
+        }
+    }
+}

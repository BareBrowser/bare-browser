index 00000000000..7aa18950a91
--- /dev/null
+++ b/chrome/android/java/src/org/chromium/chrome/browser/bare/backup/BareDirectFragment.java
@@ -0,0 +1,207 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.bare.backup;
+
+import android.app.AlertDialog;
+import android.content.Context;
+import android.graphics.Typeface;
+import android.os.Bundle;
+import android.util.TypedValue;
+import android.view.Gravity;
+import android.widget.LinearLayout;
+import android.widget.TextView;
+
+import androidx.annotation.StringRes;
+import androidx.preference.PreferenceScreen;
+
+import org.chromium.base.supplier.MonotonicObservableSupplier;
+import org.chromium.base.supplier.ObservableSuppliers;
+import org.chromium.base.supplier.SettableMonotonicObservableSupplier;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.chrome.R;
+import org.chromium.chrome.browser.settings.ChromeBaseSettingsFragment;
+import org.chromium.components.browser_ui.settings.TextMessagePreference;
+
+/** What the Send and Receive pages share: the checks, the code dialog and failure. */
+abstract class BareDirectFragment extends ChromeBaseSettingsFragment
+        implements BareDirectSession.Observer {
+    private final SettableMonotonicObservableSupplier<String> mPageTitle =
+            ObservableSuppliers.createMonotonic();
+    protected BareDirectGate mGate;
+    protected @Nullable BareDirectSession mSession;
+    private @Nullable AlertDialog mCodeDialog;
+
+    protected abstract @StringRes int title();
+
+    /** Rebuilds the page for the session's state. */
+    protected abstract void render();
+
+    @Override
+    public void onCreate(@Nullable Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+        mGate = new BareDirectGate(this);
+    }
+
+    @Override
+    public void onCreatePreferences(@Nullable Bundle savedInstanceState, @Nullable String rootKey) {
+        mPageTitle.set(getContext().getString(title()));
+        setPreferenceScreen(getPreferenceManager().createPreferenceScreen(getContext()));
+        BareDirectSession running = BareDirectSession.current();
+        if (running != null && running.isSending() == isSending()) attach(running);
+    }
+
+    protected abstract boolean isSending();
+
+    protected void attach(BareDirectSession session) {
+        if (mSession != null) mSession.removeObserver(this);
+        mSession = session;
+        session.addObserver(this);
+        onChanged();
+    }
+
+    @Override
+    public void onChanged() {
+        if (getContext() == null) return;
+        BareDirectSession session = mSession;
+        if (session != null && session.getState() == BareDirectSession.State.CHECKING) {
+            showCode(session);
+        } else {
+            dismissCode();
+        }
+        render();
+    }
+
+    private void showCode(BareDirectSession session) {
+        if (mCodeDialog != null || session.isConfirmedHere()) return;
+        Context context = getContext();
+        String code = session.getCode();
+        TextView codeView = new TextView(context);
+        codeView.setText(code.substring(0, 3) + " " + code.substring(3));
+        codeView.setTypeface(Typeface.MONOSPACE, Typeface.BOLD);
+        codeView.setTextSize(TypedValue.COMPLEX_UNIT_SP, 34);
+        codeView.setGravity(Gravity.CENTER);
+        codeView.setContentDescription(String.join(" ", code.split("")));
+        LinearLayout layout = BareBackupDialogs.padded(context);
+        layout.addView(codeView);
+        String other =
+                session.getPeerModel().isEmpty()
+                        ? context.getString(R.string.bare_direct_the_other_phone)
+                        : session.getPeerModel();
+        mCodeDialog =
+                BareBackupDialogs.showSecure(
+                BareBackupDialogs.builder(context)
+                        .setTitle(R.string.bare_direct_code_title)
+                        .setMessage(context.getString(R.string.bare_direct_code_message, other))
+                        .setView(layout)
+                        .setCancelable(false)
+                        .setNegativeButton(
+                                R.string.bare_direct_code_differs,
+                                (d, w) -> {
+                                    mCodeDialog = null;
+                                    session.cancel();
+                                })
+                        .setPositiveButton(
+                                R.string.bare_direct_code_matches,
+                                (d, w) -> {
+                                    mCodeDialog = null;
+                                    session.confirmCode();
+                                })
+                        .create());
+    }
+
+    private void dismissCode() {
+        if (mCodeDialog == null) return;
+        mCodeDialog.dismiss();
+        mCodeDialog = null;
+    }
+
+    // Rows.
+
+    protected PreferenceScreen clear() {
+        PreferenceScreen screen = getPreferenceManager().createPreferenceScreen(getContext());
+        setPreferenceScreen(screen);
+        return screen;
+    }
+
+    protected void heading(
+            PreferenceScreen screen, CharSequence title, @Nullable CharSequence body) {
+        TextMessagePreference row = new TextMessagePreference(getContext(), null);
+        row.setTitle(title);
+        if (body != null) row.setSummary(body);
+        screen.addPreference(row);
+    }
+
+    protected void button(PreferenceScreen screen, @StringRes int title, Runnable onClick) {
+        BareBackupButtonPreference button = new BareBackupButtonPreference(getContext());
+        button.setTitle(title);
+        button.setOnClick(onClick);
+        screen.addPreference(button);
+    }
+
+    /** The row for the states both sides share. False if the state is one the page draws. */
+    protected boolean renderShared(PreferenceScreen screen, Runnable tryAgain) {
+        BareDirectSession session = mSession;
+        if (session == null) return false;
+        Context context = getContext();
+        String other =
+                session.getPeerModel().isEmpty()
+                        ? context.getString(R.string.bare_direct_the_other_phone)
+                        : session.getPeerModel();
+        switch (session.getState()) {
+            case BareDirectSession.State.CONNECTING:
+                heading(
+                        screen,
+                        context.getString(R.string.bare_direct_connecting, other),
+                        context.getString(R.string.bare_direct_accept_hint));
+                return true;
+            case BareDirectSession.State.CHECKING:
+                heading(
+                        screen,
+                        context.getString(R.string.bare_direct_code_title),
+                        session.isConfirmedHere()
+                                ? context.getString(R.string.bare_direct_waiting_confirm, other)
+                                : null);
+                return true;
+            case BareDirectSession.State.CONFIRMED:
+                heading(
+                        screen,
+                        context.getString(R.string.bare_direct_connected, other),
+                        context.getString(R.string.bare_direct_both_confirmed));
+                return true;
+            case BareDirectSession.State.FAILED:
+                int error = session.getError();
+                heading(
+                        screen,
+                        context.getString(error == 0 ? R.string.bare_direct_stopped : error),
+                        context.getString(R.string.bare_direct_nothing_sent));
+                button(screen, R.string.bare_direct_try_again, tryAgain);
+                return true;
+            default:
+                return false;
+        }
+    }
+
+    @Override
+    public void onDestroy() {
+        dismissCode();
+        BareDirectSession session = mSession;
+        if (session != null) {
+            session.removeObserver(this);
+            // Leaving the page ends the transfer; a rotation doesn't.
+            if (getActivity() == null || getActivity().isFinishing()) session.cancel();
+        }
+        super.onDestroy();
+    }
+
+    @Override
+    public MonotonicObservableSupplier<String> getPageTitle() {
+        return mPageTitle;
+    }
+
+    @Override
+    public @AnimationType int getAnimationType() {
+        return AnimationType.PROPERTY;
+    }
+}

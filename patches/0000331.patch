+ * It outlives the page that started it, so a rotation or a trip to the notification shade doesn't
+ * break the connection.
+ *
+ * <p>The receiver advertises a Wi-Fi Direct service. The sender finds it and connects, which makes
+ * Android ask on the receiver. Whichever phone Android makes group owner listens on {@link #PORT};
+ * the other connects to it. TLS runs over that connection with the receiver as server.
+ */
+public final class BareDirectSession {
+    private static final String SERVICE_TYPE = "_baredirect._tcp";
+    private static final String PROTOCOL_VERSION = "1";
+    static final int PORT = 51747;
+
+    private static final int CONNECT_TIMEOUT_MS = 10_000;
+    private static final int CONNECT_ATTEMPTS = 6;
+    private static final long REDISCOVER_MS = 20_000;
+    private static final long GIVE_UP_MS = 10 * 60 * 1000;

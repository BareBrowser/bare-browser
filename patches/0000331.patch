+    private volatile boolean mAcceptedHere;
+    private boolean mConfirmedThere;
+    private boolean mLinking;
+    private boolean mEnded;
+
+    private BareDirectTls.@Nullable Identity mIdentity;
+    private @Nullable ServerSocket mServer;
+    private @Nullable Socket mSocket;
+    private @Nullable DataOutputStream mOut;
+
+    private final Runnable mGiveUp = () -> fail(R.string.bare_direct_timeout);
+    private final Runnable mRediscover = this::rediscover;
+
+    private BareDirectSession(Context context, boolean sending) {
+        mContext = context;
+        mSending = sending;
+    }
+
+    /** The transfer under way, if any. */
+    static @Nullable BareDirectSession current() {
+        return sCurrent;
+    }
+
+    /** Ends any earlier transfer and starts a new one. */
+    static BareDirectSession start(boolean sending) {
+        if (sCurrent != null) sCurrent.cancel();

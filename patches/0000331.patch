@@ -0,0 +1,59 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/bare/backup/backup_transfer_code.h"
+
+#include <openssl/hmac.h>
+#include <openssl/mem.h>
+
+#include "base/check.h"
+#include "base/check_op.h"
+#include "base/strings/stringprintf.h"
+
+namespace bare::backup {
+
+namespace {
+
+std::array<uint8_t, 32> HmacSha256(base::span<const uint8_t> key,
+                                   base::span<const uint8_t> message) {
+  std::array<uint8_t, 32> out{};
+  unsigned int length = 0;
+  CHECK(HMAC(EVP_sha256(), key.data(), key.size(), message.data(),
+             message.size(), out.data(), &length));
+  CHECK_EQ(length, out.size());
+  return out;
+}
+
+}  // namespace
+
+std::array<uint8_t, 32> TransferCommitment(base::span<const uint8_t> a,
+                                           base::span<const uint8_t> cert) {
+  return HmacSha256(a, cert);
+}
+
+bool VerifyTransferCommitment(base::span<const uint8_t> a,
+                              base::span<const uint8_t> cert,
+                              base::span<const uint8_t> commitment) {
+  if (a.size() != kTransferNonceLength || commitment.size() != 32) {
+    return false;
+  }
+  const std::array<uint8_t, 32> expected = HmacSha256(a, cert);
+  return CRYPTO_memcmp(expected.data(), commitment.data(), expected.size()) ==
+         0;
+}
+
+std::string MatchingCode(base::span<const uint8_t> a,
+                         base::span<const uint8_t> b) {
+  if (a.size() != kTransferNonceLength || b.size() != kTransferNonceLength) {
+    return std::string();
+  }
+  const std::array<uint8_t, 32> mac = HmacSha256(a, b);
+  // 2^32 isn't a multiple of a million, so a few codes come up about 0.02%
+  // more often than the rest. That doesn't help anyone guess one.
+  const uint32_t value = (uint32_t{mac[0]} << 24) | (uint32_t{mac[1]} << 16) |
+                         (uint32_t{mac[2]} << 8) | uint32_t{mac[3]};
+  return base::StringPrintf("%06u", value % 1000000u);
+}
+
+}  // namespace bare::backup

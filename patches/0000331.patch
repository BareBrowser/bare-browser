new file mode 100644
index 00000000000..d74defb847a
--- /dev/null
+++ b/chrome/browser/bare/backup/backup_transfer_code.h
@@ -0,0 +1,43 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_BARE_BACKUP_BACKUP_TRANSFER_CODE_H_
+#define CHROME_BROWSER_BARE_BACKUP_BACKUP_TRANSFER_CODE_H_
+
+#include <stddef.h>
+#include <stdint.h>
+
+#include <array>
+#include <string>
+
+#include "base/containers/span.h"
+
+// The matching code two phones show before a transfer. Inside TLS, the sender
+// commits to a random `a` and the receiver's certificate before it sees the
+// receiver's random `b`, so a phone in the middle can't pick values that make
+// both screens agree.
+//
+//   sender -> receiver: Commitment(a, certificate)
+//   receiver -> sender: b
+//   sender -> receiver: a   (receiver checks it against the commitment)
+//   both show:          MatchingCode(a, b)
+namespace bare::backup {
+
+inline constexpr size_t kTransferNonceLength = 32;
+
+std::array<uint8_t, 32> TransferCommitment(base::span<const uint8_t> a,
+                                           base::span<const uint8_t> cert);
+
+// Constant time. False if `a` is the wrong length.
+bool VerifyTransferCommitment(base::span<const uint8_t> a,
+                              base::span<const uint8_t> cert,
+                              base::span<const uint8_t> commitment);
+
+// Six digits, "000000" to "999999". Empty if either nonce is the wrong length.
+std::string MatchingCode(base::span<const uint8_t> a,
+                         base::span<const uint8_t> b);
+
+}  // namespace bare::backup
+
+#endif  // CHROME_BROWSER_BARE_BACKUP_BACKUP_TRANSFER_CODE_H_
diff --git a/chrome/browser/bare/backup/backup_transfer_code_unittest.cc b/chrome/browser/bare/backup/backup_transfer_code_unittest.cc
new file mode 100644
index 00000000000..cf5aa128b41
--- /dev/null
+++ b/chrome/browser/bare/backup/backup_transfer_code_unittest.cc
@@ -0,0 +1,63 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/bare/backup/backup_transfer_code.h"
+
+#include <set>
+#include <string>
+#include <vector>
+
+#include "base/strings/string_util.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace bare::backup {
+namespace {
+
+std::vector<uint8_t> Bytes(uint8_t fill, size_t size = kTransferNonceLength) {
+  return std::vector<uint8_t>(size, fill);
+}
+
+TEST(BackupTransferCodeTest, CommitmentChecksOut) {
+  const std::vector<uint8_t> a = Bytes(1);
+  const std::vector<uint8_t> cert = {0x30, 0x82, 0x01, 0x0a};
+  const std::array<uint8_t, 32> commitment = TransferCommitment(a, cert);
+  EXPECT_TRUE(VerifyTransferCommitment(a, cert, commitment));
+
+  // Another certificate, as a phone in the middle would present.
+  const std::vector<uint8_t> other_cert = {0x30, 0x82, 0x01, 0x0b};
+  EXPECT_FALSE(VerifyTransferCommitment(a, other_cert, commitment));
+  // Another `a` revealed after the fact.
+  EXPECT_FALSE(VerifyTransferCommitment(Bytes(2), cert, commitment));
+  // Wrong sizes.
+  EXPECT_FALSE(VerifyTransferCommitment(Bytes(1, 31), cert, commitment));
+  EXPECT_FALSE(VerifyTransferCommitment(
+      a, cert, base::span(commitment).first(31u)));
+}
+
+TEST(BackupTransferCodeTest, CodeIsSixDigitsAndSameOnBothSides) {
+  const std::string code = MatchingCode(Bytes(1), Bytes(2));
+  ASSERT_EQ(code.size(), 6u);
+  for (char c : code) {
+    EXPECT_TRUE(base::IsAsciiDigit(c));
+  }
+  EXPECT_EQ(MatchingCode(Bytes(1), Bytes(2)), code);
+  // The order of a and b matters: only the sender's a is the key.
+  EXPECT_NE(MatchingCode(Bytes(2), Bytes(1)), code);
+}
+
+TEST(BackupTransferCodeTest, CodesSpread) {
+  std::set<std::string> codes;
+  for (int i = 0; i < 200; ++i) {
+    codes.insert(MatchingCode(Bytes(static_cast<uint8_t>(i)), Bytes(7)));
+  }
+  EXPECT_GT(codes.size(), 195u);
+}
+
+TEST(BackupTransferCodeTest, WrongNonceSizes) {
+  EXPECT_EQ(MatchingCode(Bytes(1, 16), Bytes(2)), "");
+  EXPECT_EQ(MatchingCode(Bytes(1), Bytes(2, 33)), "");
+}
+
+}  // namespace
+}  // namespace bare::backup

+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.bare.backup;
+
+import android.Manifest;
+import android.content.Context;
+import android.content.Intent;
+import android.content.pm.PackageManager;
+import android.location.LocationManager;
+import android.net.wifi.WifiManager;
+import android.os.Build;
+import android.provider.Settings;
+
+import androidx.activity.result.ActivityResultLauncher;
+import androidx.activity.result.contract.ActivityResultContracts;
+import androidx.annotation.StringRes;
+import androidx.core.content.ContextCompat;
+import androidx.fragment.app.Fragment;
+
+import org.chromium.base.Callback;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.chrome.R;
+
+import java.util.Map;
+
+/**
+ * What a phone needs before it can look for, or be found by, another phone: Wi-Fi Direct, Wi-Fi
+ * turned on, and Android's permission for nearby devices. On Android 10 to 12 that permission is
+ * location, and Location must be on as well. Nothing is asked until Send or Receive is tapped.
+ */
+final class BareDirectGate {
+    private final Fragment mFragment;
+    private final ActivityResultLauncher<String[]> mAsk;
+    private @Nullable Runnable mThen;
+    private @Nullable Callback<Integer> mBlocked;
+
+    /** Call from the fragment's onCreate. */
+    BareDirectGate(Fragment fragment) {
+        mFragment = fragment;
+        mAsk =
+                fragment.registerForActivityResult(
+                        new ActivityResultContracts.RequestMultiplePermissions(), this::onAnswer);
+    }
+
+    /**
+     * Runs {@code then} once everything is in place. Otherwise explains what's missing, offers
+     * Android's page for it, and passes the reason to {@code blocked}.
+     */
+    void check(Runnable then, Callback<Integer> blocked) {
+        Context context = mFragment.getContext();
+        if (context == null) return;
+        mThen = then;
+        mBlocked = blocked;
+        if (!context.getPackageManager().hasSystemFeature(PackageManager.FEATURE_WIFI_DIRECT)) {
+            block(R.string.bare_direct_unsupported, null);
+            return;
+        }
+        WifiManager wifi = context.getSystemService(WifiManager.class);
+        if (wifi == null || !wifi.isWifiEnabled()) {
+            block(R.string.bare_direct_wifi_off, new Intent(Settings.Panel.ACTION_WIFI));
+            return;
+        }
+        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.TIRAMISU) {
+            LocationManager location = context.getSystemService(LocationManager.class);
+            if (location == null || !location.isLocationEnabled()) {
+                block(
+                        R.string.bare_direct_location_off,
+                        new Intent(Settings.ACTION_LOCATION_SOURCE_SETTINGS));
+                return;
+            }
+        }
+        String permission = permission();
+        if (ContextCompat.checkSelfPermission(context, permission)
+                == PackageManager.PERMISSION_GRANTED) {
+            run();
+            return;
+        }
+        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.TIRAMISU) {
+            // Android's own prompt says "location", which needs saying why first.
+            BareBackupDialogs.builder(context)
+                    .setMessage(R.string.bare_direct_location_why)
+                    .setNegativeButton(
+                            android.R.string.cancel,
+                            (d, w) -> blocked(R.string.bare_direct_permission_denied))
+                    .setPositiveButton(
+                            R.string.bare_direct_continue,
+                            (d, w) -> mAsk.launch(new String[] {permission}))
+                    .setCancelable(false)
+                    .show();
+            return;
+        }
+        mAsk.launch(new String[] {permission});
+    }
+
+    private static String permission() {
+        return Build.VERSION.SDK_INT >= Build.VERSION_CODES.TIRAMISU
+                ? Manifest.permission.NEARBY_WIFI_DEVICES
+                : Manifest.permission.ACCESS_FINE_LOCATION;
+    }
+
+    private void onAnswer(Map<String, Boolean> granted) {
+        if (Boolean.TRUE.equals(granted.get(permission()))) {
+            run();
+        } else {
+            blocked(R.string.bare_direct_permission_denied);
+        }
+    }
+
+    private void run() {
+        Runnable then = mThen;
+        mThen = null;
+        if (then != null) then.run();
+    }
+
+    private void block(@StringRes int reason, @Nullable Intent settings) {
+        Context context = mFragment.getContext();
+        if (context == null) return;
+        if (settings == null) {
+            BareBackupDialogs.message(context, reason);
+        } else {
+            BareBackupDialogs.builder(context)
+                    .setMessage(reason)
+                    .setNegativeButton(android.R.string.cancel, null)
+                    .setPositiveButton(
+                            R.string.bare_direct_open_settings,
+                            (d, w) -> mFragment.startActivity(settings))
+                    .show();
+        }
+        blocked(reason);
+    }
+
+    private void blocked(@StringRes int reason) {
+        Callback<Integer> blocked = mBlocked;
+        if (blocked != null) blocked.onResult(reason);
+    }
+}

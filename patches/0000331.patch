+import android.widget.RadioButton;
+
+import androidx.preference.Preference;
+import androidx.preference.PreferenceViewHolder;
+
+import org.chromium.build.annotations.Nullable;
+import org.chromium.chrome.R;
+
+/** The three option cards on the Send page: Share my setup, Copy everything, Move everything. */
+public class BareDirectModePreference extends Preference {
+    private static final int[] CARDS = {
+        R.id.bare_direct_mode_setup, R.id.bare_direct_mode_copy, R.id.bare_direct_mode_move
+    };
+    private static final int[] RADIOS = {
+        R.id.bare_direct_mode_setup_radio,
+        R.id.bare_direct_mode_copy_radio,
+        R.id.bare_direct_mode_move_radio
+    };
+
+    private @BareDirectSession.Mode int mMode = BareDirectSession.Mode.SETUP;
+
+    public BareDirectModePreference(Context context, @Nullable AttributeSet attrs) {
+        super(context, attrs);
+        setLayoutResource(R.layout.bare_direct_modes);
+        setSelectable(false);
+    }
+
+    @BareDirectSession.Mode
+    int getMode() {
+        return mMode;
+    }
+
+    @Override
+    public void onBindViewHolder(PreferenceViewHolder holder) {
+        super.onBindViewHolder(holder);
+        for (int i = 0; i < CARDS.length; i++) {
+            int mode = i;
+            RadioButton radio = (RadioButton) holder.findViewById(RADIOS[i]);
+            radio.setChecked(mMode == mode);
+            radio.setOnClickListener(v -> choose(mode));
+            holder.findViewById(CARDS[i]).setOnClickListener(v -> choose(mode));
+        }
+    }
+
+    private void choose(int mode) {
+        mMode = mode;
+        notifyChanged();
+    }
+}

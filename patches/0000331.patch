+        JSONObject reveal = new JSONObject();
+        reveal.put("a", hex(a));
+        write(out, FRAME_REVEAL, reveal);
+        return BareBackupBridge.matchingCode(a, b);
+    }
+
+    private String pairAsReceiver(DataInputStream in, DataOutputStream out, byte[] certificate)
+            throws IOException, JSONException {
+        JSONObject hello = read(in, FRAME_HELLO);
+        if (!PROTOCOL_VERSION.equals(hello.optString("v"))) throw new IOException("version");
+        byte[] commitment = unhex(hello.optString("commit"));
+        String model = hello.optString("model");
+        mHandler.post(() -> mPeerModel = model);
+
+        byte[] b = randomNonce();
+        JSONObject back = new JSONObject();
+        back.put("v", PROTOCOL_VERSION);
+        back.put("model", thisModel());
+        back.put("b", hex(b));
+        write(out, FRAME_HELLO_BACK, back);

+            Socket socket = new Socket();
+            try {
+                socket.connect(new InetSocketAddress(owner, PORT), CONNECT_TIMEOUT_MS);
+                return socket;
+            } catch (IOException e) {
+                last = e;
+                socket.close();
+                // The group owner may not be listening yet.
+                try {
+                    Thread.sleep(1000);
+                } catch (InterruptedException interrupted) {
+                    throw new IOException(interrupted);
+                }
+            }
+        }
+        throw last;
+    }
+
+    private String pairAsSender(DataInputStream in, DataOutputStream out, byte[] certificate)
+            throws IOException, JSONException {

+    // Frame types. Each frame is a type byte, a 4-byte big-endian length and the payload.
+    static final int FRAME_HELLO = 1;
+    static final int FRAME_HELLO_BACK = 2;
+    static final int FRAME_REVEAL = 3;
+    static final int FRAME_CONFIRM = 4;
+    static final int FRAME_CANCEL = 5;

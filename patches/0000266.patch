+import org.chromium.chrome.browser.search_engines.settings.BareEngineLogos;
+import org.chromium.components.browser_ui.bottomsheet.BottomSheetContent;
+import org.chromium.components.browser_ui.bottomsheet.BottomSheetController;
+import org.chromium.components.browser_ui.bottomsheet.BottomSheetControllerProvider;
+import org.chromium.components.browser_ui.bottomsheet.BottomSheetType;
+import org.chromium.components.browser_ui.styles.SemanticColorUtils;
+import org.chromium.components.search_engines.StarterPackId;
+import org.chromium.components.search_engines.TemplateUrl;
+import org.chromium.components.search_engines.TemplateUrlService;
+import org.chromium.ui.base.WindowAndroid;
+
+import java.util.ArrayList;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Set;
+
+/**
+ * The list of search engines the address bar's engine icon opens, as a card from the bottom like
+ * the menu and the extensions. Picking an engine sends the next search to it without changing the
+ * default; picking the default drops an earlier choice.
+ */
+@NullMarked
+public final class BareEngineCard implements BottomSheetContent {
+    private static final BottomSheetType SHEET_TYPE =
+            new BottomSheetType.Builder().setUserInitiated(true).build();
+
+    private static final long KEYBOARD_GONE_MS = 250;
+
+    private final FrameLayout mContainer;
+    private final String mTitle;
+
+    /**
+     * Shows the card and returns whether it did. It does not when there is no sheet to show it in
+     * or no engine to list, and the caller falls back to the plain list.
+     */
+    public static boolean show(
+            Context context, WindowAndroid window, TemplateUrlService service, Object owner) {
+        // A sheet will not open over the keyboard or while the address bar has focus, and the
+        // engine icon is often tapped with the bar open. Let the bar go and put the keyboard away
+        // first, then open the card once they have gone.
+        @Nullable Activity activity = window.getActivity().get();
+        if (activity != null) {
+            View decor = activity.getWindow().getDecorView();
+            @Nullable View focused = activity.getCurrentFocus();
+            boolean typing = focused instanceof EditText;
+            if (typing) focused.clearFocus();
+            if (typing || window.getKeyboardDelegate().isKeyboardShowing(decor)) {
+                window.getKeyboardDelegate().hideKeyboard(decor);
+                decor.postDelayed(
+                        () -> {
+                            if (!present(context, window, service, owner)) {
+                                BareEnginePicker.show(context, service, owner);
+                            }
+                        },
+                        KEYBOARD_GONE_MS);
+                return true;
+            }
+        }
+        return present(context, window, service, owner);
+    }
+
+    private static boolean present(
+            Context context, WindowAndroid window, TemplateUrlService service, Object owner) {
+        BottomSheetController controller = BottomSheetControllerProvider.from(window);
+        if (controller == null) return false;
+        List<TemplateUrl> engines = new ArrayList<>();
+        Set<String> seen = new HashSet<>();
+        for (TemplateUrl tu : service.getTemplateUrls()) {
+            if (tu.getStarterPackId() != StarterPackId.NONE) continue;
+            if (tu.getKeyword().isEmpty() || !seen.add(tu.getShortName())) continue;
+            engines.add(tu);
+        }
+        if (engines.isEmpty()) return false;
+        @Nullable TemplateUrl defaultEngine = service.getDefaultSearchEngineTemplateUrl();
+        @Nullable String chosen = BareSearchOverride.getName();
+        BareEngineCard[] holder = new BareEngineCard[1];
+        LinearLayout column = new LinearLayout(context);
+        column.setOrientation(LinearLayout.VERTICAL);
+        float density = context.getResources().getDisplayMetrics().density;
+        column.setPadding(0, Math.round(4 * density), 0, 0);
+        column.addView(titleView(context, density));
+        for (TemplateUrl tu : engines) {
+            boolean current =
+                    chosen != null
+                            ? tu.getShortName().equals(chosen)
+                            : defaultEngine != null && tu.getURL().equals(defaultEngine.getURL());
+            column.addView(
+                    row(
+                            context,
+                            density,
+                            tu,
+                            current,
+                            v -> {
+                                controller.hideContent(holder[0], true);
+                                if (defaultEngine != null
+                                        && tu.getURL().equals(defaultEngine.getURL())) {
+                                    BareSearchOverride.clear(owner);
+                                } else {
+                                    BareSearchOverride.set(
+                                            owner, tu.getURL(), tu.getShortName());
+                                }
+                            }));
+        }
+        holder[0] = new BareEngineCard(context, column);
+        return controller.requestShowContent(holder[0], true);
+    }
+
+    private BareEngineCard(Context context, View column) {
+        mTitle = context.getString(R.string.bare_engine_once_title);
+        mContainer = new FrameLayout(context);
+        mContainer.addView(
+                column,
+                new FrameLayout.LayoutParams(
+                        ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT));
+        float density = context.getResources().getDisplayMetrics().density;
+        mContainer.setPadding(0, 0, 0, Math.round(16 * density));
+    }
+
+    private static TextView titleView(Context context, float density) {
+        TextView title = new TextView(context);
+        title.setText(R.string.bare_engine_once_title);
+        title.setTextSize(TypedValue.COMPLEX_UNIT_SP, 14);
+        title.setTextColor(SemanticColorUtils.getDefaultTextColor(context));
+        title.setAlpha(0.7f);
+        title.setPadding(Math.round(24 * density), Math.round(8 * density), Math.round(24 * density), Math.round(8 * density));
+        return title;
+    }
+
+    private static View row(
+            Context context,
+            float density,
+            TemplateUrl engine,
+            boolean current,
+            View.OnClickListener onClick) {
+        LinearLayout row = new LinearLayout(context);
+        row.setOrientation(LinearLayout.HORIZONTAL);
+        row.setGravity(Gravity.CENTER_VERTICAL);
+        row.setMinimumHeight(Math.round(56 * density));
+        row.setPadding(Math.round(24 * density), 0, Math.round(24 * density), 0);
+        TypedValue ripple = new TypedValue();
+        if (context.getTheme()
+                .resolveAttribute(android.R.attr.selectableItemBackground, ripple, true)) {
+            row.setBackgroundResource(ripple.resourceId);
+        }
+        row.setClickable(true);
+        row.setFocusable(true);
+        row.setOnClickListener(onClick);
+
+        ImageView logo = new ImageView(context);
+        int size = Math.round(28 * density);
+        logo.setScaleType(ImageView.ScaleType.FIT_CENTER);
+        @Nullable Bitmap bitmap = BareEngineLogos.get(context, engine.getURL());
+        Drawable drawable =
+                bitmap != null
+                        ? new BitmapDrawable(context.getResources(), bitmap)
+                        : new BareEngineLetterDrawable(engine.getShortName());
+        logo.setImageDrawable(drawable);
+        LinearLayout.LayoutParams logoParams = new LinearLayout.LayoutParams(size, size);
+        logoParams.setMarginEnd(Math.round(16 * density));
+        row.addView(logo, logoParams);
+
+        TextView name = new TextView(context);
+        name.setText(engine.getShortName());
+        name.setTextSize(TypedValue.COMPLEX_UNIT_SP, 16);
+        name.setTextColor(SemanticColorUtils.getDefaultTextColor(context));
+        row.addView(name, new LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1f));
+
+        if (current) {
+            ImageView check = new ImageView(context);
+            check.setImageResource(R.drawable.bare_engine_check);
+            check.setColorFilter(SemanticColorUtils.getDefaultIconColor(context));
+            int checkSize = Math.round(24 * density);
+            row.addView(check, new LinearLayout.LayoutParams(checkSize, checkSize));
+        }
+        return row;
+    }
+
+    @Override
+    public View getContentView() {
+        return mContainer;
+    }
+
+    @Override
+    public @Nullable View getToolbarView() {
+        return null;
+    }
+
+    @Override
+    public int getVerticalScrollOffset() {
+        return 0;
+    }
+
+    @Override
+    public void destroy() {}
+
+    @Override
+    public BottomSheetType getSheetType() {
+        return SHEET_TYPE;
+    }
+
+    @Override
+    public int getPriority() {
+        return ContentPriority.HIGH;
+    }
+
+    @Override
+    public boolean swipeToDismissEnabled() {
+        return true;
+    }
+
+    @Override
+    public boolean showHandlebar() {
+        return true;
+    }
+
+    @Override
+    public int getPeekHeight() {
+        return HeightMode.DISABLED;
+    }
+
+    @Override
+    public float getHalfHeightRatio() {
+        return HeightMode.DISABLED;
+    }
+
+    @Override
+    public float getFullHeightRatio() {
+        return HeightMode.WRAP_CONTENT;
+    }
+
+    @Override
+    public @Nullable String getSheetContentDescription(Context context) {
+        return mTitle;
+    }
+
+    @Override
+    public int getSheetHalfHeightAccessibilityStringId() {
+        return R.string.bare_engine_once_title;
+    }
+
+    @Override
+    public int getSheetFullHeightAccessibilityStringId() {
+        return R.string.bare_engine_once_title;
+    }
+
+    @Override
+    public int getSheetClosedAccessibilityStringId() {
+        return R.string.bare_engine_once_title;
+    }
+}

diff --git a/chrome/browser/chrome_browser_field_trials.cc b/chrome/browser/chrome_browser_field_trials.cc
index 1615831c76b..82901b4b4fe 100644
--- a/chrome/browser/chrome_browser_field_trials.cc
+++ b/chrome/browser/chrome_browser_field_trials.cc
@@ -130,15 +130,22 @@ void ChromeBrowserFieldTrials::RegisterFeatureOverrides(
   variations::FeatureOverrides feature_overrides(*feature_list);
 
 #if BUILDFLAG(IS_ANDROID)
-  // Bare: smooth scrolling is on unless the user turned it off in Settings,
+  // Bare: smooth scrolling is off unless the user turned it on in Settings,
   // Browsing. The browser decides here, and the feature list carries the answer
   // to every process, including the one that reads the touches.
+  //
+  // It used to be on by default. Once, on the first start of a version that
+  // has this, the saved choice is cleared so everyone starts with it off,
+  // already for that start. Turned on after that, it stays on.
   {
     base::android::SharedPreferencesManager prefs =
         android::shared_preferences::GetChromeSharedPreferences();
-    const bool smooth = prefs.ReadBoolean("Chrome.Bare.SmoothScrolling", true);
-    if (!smooth) {
-      feature_overrides.DisableFeature(ui::kBareSmoothScrolling);
+    if (!prefs.ContainsKey("Chrome.Bare.SmoothScrollingReset")) {
+      prefs.RemoveKey("Chrome.Bare.SmoothScrolling");
+      prefs.WriteString("Chrome.Bare.SmoothScrollingReset", "off");
+    }
+    if (prefs.ReadBoolean("Chrome.Bare.SmoothScrolling", false)) {
+      feature_overrides.EnableFeature(ui::kBareSmoothScrolling);
     }
   }
   // Bare: every site gets its own process on every phone, whatever upstream
@@ -322,7 +329,8 @@ void ChromeBrowserFieldTrials::RegisterFeatureOverrides(

 .../external_intents/ExternalNavigationHandler.java      | 9 ++++++---
 1 file changed, 6 insertions(+), 3 deletions(-)

diff --git a/components/external_intents/android/java/src/org/chromium/components/external_intents/ExternalNavigationHandler.java b/components/external_intents/android/java/src/org/chromium/components/external_intents/ExternalNavigationHandler.java
index d7080c8ff0c..5ad4e6ec9c8 100644
--- a/components/external_intents/android/java/src/org/chromium/components/external_intents/ExternalNavigationHandler.java
+++ b/components/external_intents/android/java/src/org/chromium/components/external_intents/ExternalNavigationHandler.java
@@ -2164,8 +2164,9 @@ public class ExternalNavigationHandler implements ExternalNavigationHelper {
      * the question is put. Answering yes hands the navigation back to the ordinary launch path,
      * so Android still shows its chooser afterwards where it would have.
      *
-     * <p>Returns null only when there is no Activity to host a dialog, in which case the caller
-     * carries on and launches as it would have.
+     * <p>With no Activity to host the dialog the navigation is kept here instead. Asking is the
+     * whole of what the setting promises, so carrying on and launching would have handed the page
+     * to another app on a consent that was never given.
      */
     private @Nullable OverrideUrlLoadingResult askBeforeLeavingForApp(
             Intent targetIntent,
@@ -2176,7 +2177,9 @@ public class ExternalNavigationHandler implements ExternalNavigationHelper {
             GURL browserFallbackUrl,
             GURL intentTargetUrl) {
         Context context = mDelegate.getContext();
-        if (ContextUtils.activityFromContext(context) == null) return null;
+        if (ContextUtils.activityFromContext(context) == null) {
+            return OverrideUrlLoadingResult.forNoOverride();
+        }
         assumeNonNull(context);
 
         // The app label is only used to name the app in the dialog. It stays null when several

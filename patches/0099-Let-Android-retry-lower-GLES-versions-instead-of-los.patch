From 62264a5490ab143f145dae10aecb9777b7a033b8 Mon Sep 17 00:00:00 2001
From: Bare <git@barebrowser.org>
Date: Wed, 26 Aug 2026 20:57:35 +0000
Subject: [PATCH] Let Android retry lower GLES versions instead of losing the
 GPU

Android does not build SwiftShader, yet the two places that create a GL context
for an ES3 decoder and for GPU info collection both clear
allow_es_version_fallback, as if a software renderer were there to catch the
failure. Clearing it switches off the retry already sitting in GLContextEGL. A
device whose driver refuses an ES3 context gets EGL_BAD_MATCH or
EGL_BAD_ATTRIBUTE, no second attempt, and a GPU process with nowhere to go.

Set it on Android instead, so the existing walk down from 3.1 to 3.0 to 2.0
stays available. The failures along the way were already logged and the
success was not, so log that too: when a report says the browser started, we
want to know which version it settled on.

Devices that are handed ES3 on the first try never reach any of this. The
retry only runs once eglCreateContext has already failed.

Migration note (156.0.8078.25): upstream removed ShouldFallbackToSWIfGLES3NotSupported(),
which this patch used to change, and wrote allow_es_version_fallback = false
into its two callers, service_utils.cc and gpu_info_collector.cc. The Android
exception now sits at both call sites.
---
 gpu/command_buffer/service/service_utils.cc | 8 ++++++++
 gpu/config/gpu_info_collector.cc            | 8 ++++++++
 ui/gl/gl_context_egl.cc                     | 2 ++
 3 files changed, 18 insertions(+)

diff --git a/gpu/command_buffer/service/service_utils.cc b/gpu/command_buffer/service/service_utils.cc
index 75376d1c523..264299fa1d9 100644
--- a/gpu/command_buffer/service/service_utils.cc
+++ b/gpu/command_buffer/service/service_utils.cc
@@ -157,7 +157,15 @@ gl::GLContextAttribs GenerateGLContextAttribsForDecoder(
     if (IsWebGL2OrES3ContextType(context_type)) {
       attribs.client_major_es_version = 3;
       attribs.client_minor_es_version = 0;
+#if BUILDFLAG(IS_ANDROID)
+      // Bare: Android does not build SwiftShader, so there is no software
+      // renderer to fall back to. Refusing the version fallback only turns a
+      // driver that rejects ES3 into a dead GPU process; let GLContextEGL retry
+      // 3.1 -> 3.0 -> 2.0.
+      attribs.allow_es_version_fallback = true;
+#else
       attribs.allow_es_version_fallback = false;
+#endif
     } else {
       DCHECK(IsWebGL1OrES2ContextType(context_type));
       attribs.client_major_es_version = 2;
diff --git a/gpu/config/gpu_info_collector.cc b/gpu/config/gpu_info_collector.cc
index b9d879fd6ac..8ea7df9139c 100644
--- a/gpu/config/gpu_info_collector.cc
+++ b/gpu/config/gpu_info_collector.cc
@@ -91,7 +91,15 @@ scoped_refptr<gl::GLSurface> InitializeGLSurface(gl::GLDisplay* display) {
 scoped_refptr<gl::GLContext> InitializeGLContext(gl::GLSurface* surface) {
   TRACE_EVENT("gpu,startup", "gpu_info_collector::InitializeGLContext");
   gl::GLContextAttribs attribs;
+#if BUILDFLAG(IS_ANDROID)
+  // Bare: Android does not build SwiftShader, so there is no software renderer
+  // to fall back to. Refusing the version fallback only turns a driver that
+  // rejects ES3 into a dead GPU process; let GLContextEGL retry 3.1 -> 3.0 ->
+  // 2.0.
+  attribs.allow_es_version_fallback = true;
+#else
   attribs.allow_es_version_fallback = false;
+#endif
   scoped_refptr<gl::GLContext> context(
       gl::init::CreateGLContext(nullptr, surface, attribs));
   if (!context.get()) {
diff --git a/ui/gl/gl_context_egl.cc b/ui/gl/gl_context_egl.cc
index ff6ae82a43f..0f08ad54165 100644
--- a/ui/gl/gl_context_egl.cc
+++ b/ui/gl/gl_context_egl.cc
@@ -402,6 +402,8 @@ bool GLContextEGL::InitializeImpl(GLSurface* compatible_surface,
                            context_attributes.data());
       // Stop searching as soon as a context is successfully created.
       if (context_) {
+        LOG(WARNING) << "Fallback eglCreateContext ES " << version.first << "."
+                     << version.second << " succeeded.";
         return true;
       } else {
         LOG(ERROR) << "Fallback eglCreateContext ES " << version.first << "."

diff --git a/chrome/android/java/src/org/chromium/chrome/browser/toolbar/ToolbarManager.java b/chrome/android/java/src/org/chromium/chrome/browser/toolbar/ToolbarManager.java
index c92353d82ed..881421081f8 100644
--- a/chrome/android/java/src/org/chromium/chrome/browser/toolbar/ToolbarManager.java
+++ b/chrome/android/java/src/org/chromium/chrome/browser/toolbar/ToolbarManager.java
@@ -2716,6 +2716,57 @@ public class ToolbarManager
                                 mTabCreatorManager.getTabCreator(
                                         tabModelSelector.isIncognitoSelected()));
                     });
+
+            // De-Googled build: the bottom bar's spare slot toggles incognito mode.
+            //
+            // Pressing it switches to the incognito tab model and highlights the button;
+            // pressing it again switches back and clears the highlight. Switching to an empty
+            // incognito model would show nothing, so a tab is created in that case.
+            PropertyModel incognitoModel = mActionRegistry.get(ActionId.INCOGNITO).get();
+            if (incognitoModel != null) {
+                incognitoModel.set(
+                        ActionProperties.ON_PRESS_CALLBACK,
+                        v -> {
+                            boolean goingIncognito = !tabModelSelector.isIncognitoSelected();
+                            if (goingIncognito
+                                    && tabModelSelector.getModel(/* incognito= */ true).getCount()
+                                            == 0) {
+                                TabCreatorUtil.launchNtp(
+                                        mTabCreatorManager.getTabCreator(/* incognito= */ true));
+                            } else {
+                                tabModelSelector.selectModel(goingIncognito);
+                            }
+                        });
+
+                // The mode also changes without the button being pressed, for instance when the
+                // last incognito tab is closed, so the highlight follows the current model rather
+                // than being set only on press. TabModelSelectorObserver has no callback for a
+                // model switch; the current model is exposed as an observable supplier instead.
+                // Tint the icon red while incognito is active, and clear the tint when it is
+                // not. A null tint makes the binder fall back to the view's own colour, so the
+                // button returns to matching its neighbours without having to know their colour.
+                //
+                // addSyncObserverAndCallIfNonNull also fires with the current value, so the
+                // state is correct from the start without setting it separately.
+                tabModelSelector
+                        .getCurrentTabModelSupplier()
+                        .addSyncObserverAndCallIfNonNull(
+                                model -> {
+                                    if (model == null) return;
+                                    boolean incognito = model.isIncognito();
+                                    incognitoModel.set(ActionProperties.IS_SELECTED, incognito);
+                                    incognitoModel.set(
+                                            ActionProperties.ICON_TINT,
+                                            incognito
+                                                    ? android.content.res.ColorStateList.valueOf(
+                                                            mActivity
+                                                                    .getColor(
+                                                                            org.chromium.chrome.R
+                                                                                    .color
+                                                                                    .default_red))
+                                                    : null);
+                                });
+            }
         }
 
         if (mActionRegistry != null) {

From ef56641327f514f955e7514933d5c4c3caa81d7e Mon Sep 17 00:00:00 2001
From: Bare <git@barebrowser.org>
Date: Sun, 23 Aug 2026 17:17:00 +0000
Subject: [PATCH] Stop asking Google for a messaging token at every cold start

chrome_browser_main_android called RegisterForCloudMessages unconditionally
during startup, which requests an InstanceID token from Google before the
user has done anything at all.

The token exists for caBLEv2: this phone acting as a security key for a
desktop signed in to the same Google account. The pairing is advertised
through DeviceInfo sync. This build has neither sign-in nor sync, so the
feature could never complete, and the request bought nothing.

Passkeys on the device are untouched. They go through Android credential
manager and the platform authenticator, which do not use GCM.
---
 chrome/browser/chrome_browser_main_android.cc | 17 +++++++++++------
 1 file changed, 11 insertions(+), 6 deletions(-)

diff --git a/chrome/browser/chrome_browser_main_android.cc b/chrome/browser/chrome_browser_main_android.cc
index 91ca9fcee02..506871c22f5 100644
--- a/chrome/browser/chrome_browser_main_android.cc
+++ b/chrome/browser/chrome_browser_main_android.cc
@@ -23,7 +23,6 @@
 #include "chrome/browser/browser_process.h"
 #include "chrome/browser/data_saver/data_saver.h"
 #include "chrome/browser/profiles/profile.h"
-#include "chrome/browser/webauthn/android/cable_module_android.h"
 #include "components/crash/content/browser/child_exit_observer_android.h"
 #include "components/crash/content/browser/child_process_crash_observer_android.h"
 #include "components/metrics/stability_metrics_helper.h"
@@ -86,11 +85,17 @@ void ChromeBrowserMainPartsAndroid::PostProfileInit(Profile* profile,
       base::BindOnce(&android::Java_ChromeBackupWatcher_destroy,
                      base::android::AttachCurrentThread(), watcher));
 
-  // The GCM driver can be used at this point because the primary profile has
-  // been created. Register non-profile-specific things that use GCM so that no
-  // messages can be processed (and dropped) because the handler wasn't
-  // installed in time.
-  webauthn::authenticator::RegisterForCloudMessages();
+  // De-Googled build: no caBLE cloud-message registration.
+  //
+  // RegisterForCloudMessages asks for an InstanceID token at every cold start,
+  // which is a request to Google before the user has done anything. What it buys
+  // is caBLEv2: this phone acting as a security key for a desktop signed in to
+  // the same account. The pairing is published through DeviceInfo sync, and this
+  // build has no sign-in and no sync, so the feature cannot work whether or not
+  // the token exists.
+  //
+  // Passkeys on this device are unaffected. They go through Android's credential
+  // manager and the platform authenticator, neither of which touches GCM.
 }
 
 int ChromeBrowserMainPartsAndroid::PreEarlyInitialization() {

@@ -0,0 +1,60 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.toolbar;
+
+import android.content.Context;
+
+import androidx.appcompat.app.AlertDialog;
+
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.chrome.browser.ui.bottombar.BottomBarConfigUtils;
+import org.chromium.ui.base.DeviceFormFactor;
+
+/**
+ * Switches between the full toolbar (address bar and bottom bar) and the minimal one (address bar
+ * only). The long press menu on the address bar and Settings, Address bar both go through here, so
+ * they always agree, because there is a single stored choice.
+ *
+ * <p>The layout is built when the browser starts, so a change takes effect after a restart and the
+ * user is asked whether to restart now.
+ */
+@NullMarked
+public final class BareMinimalLayoutToggle {
+    private static @Nullable Runnable sRestart;
+
+    private BareMinimalLayoutToggle() {}
+
+    /** Set at startup: restarts the browser. The toolbar code cannot reach it on its own. */
+    public static void setRestartAction(@Nullable Runnable restart) {
+        sRestart = restart;
+    }
+
+    /** Phones only, since tablets never had the bottom bar. */
+    public static boolean isAvailable(Context context) {
+        return !DeviceFormFactor.isNonMultiDisplayContextOnTablet(context);
+    }
+
+    /** Flips the stored choice and offers a restart. */
+    public static void toggle(Context context) {
+        set(context, !BottomBarConfigUtils.isMinimalLayoutChosen());
+    }
+
+    /** Stores the choice and, if it differs from what is running, offers a restart. */
+    public static void set(Context context, boolean minimal) {
+        BottomBarConfigUtils.setMinimalLayoutChosen(minimal);
+        if (!BottomBarConfigUtils.isMinimalLayoutChangePending()) return;
+        AlertDialog.Builder builder =
+                new AlertDialog.Builder(context, R.style.ThemeOverlay_BrowserUI_AlertDialog)
+                        .setMessage(R.string.bare_minimal_layout_restart_message)
+                        .setNegativeButton(R.string.bare_minimal_layout_later, null);
+        Runnable restart = sRestart;
+        if (restart != null) {
+            builder.setPositiveButton(
+                    R.string.bare_minimal_layout_restart, (dialog, which) -> restart.run());
+        }
+        builder.show();
+    }
+}

From 9b51e2e729450125eb7c5f50ea3eab8a4a8beed4 Mon Sep 17 00:00:00 2001
From: Bare <git@barebrowser.org>
Date: Wed, 14 Oct 2026 04:21:16 +0000
Subject: [PATCH] Do not download the translate ranker model without an API key

Every tab gets a translate client, and building it builds the translate
ranker, which loads its model from the profile and, when there is none,
downloads it from www.gstatic.com. Nothing gated that on an API key,
unlike the language list and the hints fetch. The model only helps
decide whether to offer translation, and translation does not run
without a key, so the download could only fetch a file nothing would
use.

Without a key the ranker now has no model URL. Its loader stops after
looking in the profile, and no request is made.
---
 components/translate/core/browser/translate_ranker_impl.cc | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/components/translate/core/browser/translate_ranker_impl.cc b/components/translate/core/browser/translate_ranker_impl.cc
index e159d0d5916..472a7581fba 100644
--- a/components/translate/core/browser/translate_ranker_impl.cc
+++ b/components/translate/core/browser/translate_ranker_impl.cc
@@ -27,6 +27,7 @@
 #include "components/translate/core/browser/translate_metrics_logger.h"
 #include "components/translate/core/browser/translate_ranker_model.pb.h"
 #include "components/translate/core/common/translate_switches.h"
+#include "google_apis/google_api_keys.h"
 #include "services/metrics/public/cpp/ukm_builders.h"
 #include "services/metrics/public/cpp/ukm_recorder.h"
 #include "services/metrics/public/cpp/ukm_source_id.h"
@@ -178,6 +179,12 @@ GURL TranslateRankerImpl::GetModelURL() {
       !base::FeatureList::IsEnabled(kTranslateRankerEnforcement)) {
     return GURL();
   }
+  // Bare: the ranker only decides whether to offer translation, and nothing
+  // asks it without an API key. Without a URL the loader stops after the cache
+  // instead of downloading the model from www.gstatic.com.
+  if (!google_apis::HasAPIKeyConfigured()) {
+    return GURL();
+  }
   // Allow override of the ranker model URL from the command line.
   std::string raw_url;
   base::CommandLine* command_line = base::CommandLine::ForCurrentProcess();

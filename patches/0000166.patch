+    // Switching tabs.
+
+    private static class RecordingTabSwitcher implements BareTabSwitchDelegate {
+        int calls;
+        boolean lastNext;
+
+        @Override
+        public boolean switchTab(boolean next) {
+            calls++;
+            lastNext = next;
+            return true;
+        }
+    }
+
+    private void lift(float x, int action) {
+        MotionEvent event =
+                MotionEvent.obtain(mDownTime, mDownTime + 120, action, x, 80, 0);
+        mView.onTouchEvent(event);
+        event.recycle();
+    }
+
+    @Test
+    public void testSwipingLeftAsksForTheNextTab() {
+        RecordingTabSwitcher switcher = new RecordingTabSwitcher();
+        mView.setTabSwitchDelegate(switcher);
+        setAction(BareToolbarSwipeAction.SWITCH_TABS);
+        down(800, 80);
+        assertTrue(move(800 - mSlop - 10, 80));
+        lift(300, MotionEvent.ACTION_UP);
+        assertEquals(1, switcher.calls);
+        assertTrue(switcher.lastNext);
+    }
+
+    @Test
+    public void testSwipingRightAsksForThePreviousTab() {
+        RecordingTabSwitcher switcher = new RecordingTabSwitcher();
+        mView.setTabSwitchDelegate(switcher);
+        setAction(BareToolbarSwipeAction.SWITCH_TABS);
+        down(200, 80);

@@ -0,0 +1,42 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.bare;
+
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.chrome.browser.tabmodel.TabModel;
+import org.chromium.chrome.browser.tabmodel.TabModelSelector;
+import org.chromium.chrome.browser.tabmodel.TabModelUtils;
+
+/**
+ * Moves one tab along in the list the user is looking at.
+ *
+ * <p>Stays inside the current tab model, so a swipe in a normal window never lands in an Incognito
+ * tab. It does not wrap around: the ends of the list are ends, and swiping past one does nothing,
+ * as the address bar's own swipe behaves.
+ */
+@NullMarked
+public final class BareTabSwitcher {
+    private BareTabSwitcher() {}
+
+    /**
+     * Selects the tab after or before the current one.
+     *
+     * @param selector The tab model selector, which may not exist yet.
+     * @param next True for the following tab, false for the previous one.
+     * @return Whether a different tab was selected.
+     */
+    public static boolean switchTab(@Nullable TabModelSelector selector, boolean next) {
+        if (selector == null) return false;
+        TabModel model = selector.getCurrentModel();
+        int count = model.getCount();
+        int current = model.index();
+        if (count < 2 || current < 0 || current >= count) return false;
+        int target = current + (next ? 1 : -1);
+        if (target < 0 || target >= count) return false;
+        TabModelUtils.setIndex(model, target);
+        return true;
+    }
+}

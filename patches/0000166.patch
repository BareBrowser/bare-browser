+package org.chromium.chrome.browser.ui.bottombar;
+
+import org.chromium.build.annotations.NullMarked;
+
+/**
+ * Moves to a neighbouring tab for a sideways swipe along the bottom bar.
+ *
+ * <p>Lives beside the bar because the bar's module cannot see the tab model. Whatever builds the
+ * bar hands it an implementation.
+ */
+@NullMarked
+public interface BareTabSwitchDelegate {
+    /**
+     * Selects the tab after or before the current one.
+     *
+     * @param next True for the following tab, false for the previous one.
+     * @return Whether a tab was selected. False at either end of the list.
+     */
+    boolean switchTab(boolean next);
+}

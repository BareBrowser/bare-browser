+import android.animation.ValueAnimator;
+import android.app.Activity;
+import android.content.SharedPreferences;
+import android.os.Build;
+import android.view.LayoutInflater;
+import android.view.View;
+import android.view.ViewGroup;
+import android.view.accessibility.AccessibilityManager;
+import android.view.accessibility.AccessibilityNodeInfo;
+import android.view.animation.PathInterpolator;
+import android.widget.FrameLayout;
+import android.widget.RadioButton;
+import android.widget.TextView;
+
+import androidx.activity.ComponentActivity;
+import androidx.activity.OnBackPressedCallback;
+import androidx.core.graphics.Insets;
+import androidx.core.view.ViewCompat;
+import androidx.core.view.WindowInsetsCompat;
+
+import com.google.android.material.materialswitch.MaterialSwitch;
+
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.chrome.R;
+import org.chromium.chrome.browser.bare.canvas.BareCanvasFlowView;
+import org.chromium.chrome.browser.preferences.ChromePreferenceKeys;
+import org.chromium.chrome.browser.preferences.ChromeSharedPreferences;
+import org.chromium.components.browser_ui.widget.RiseSheet;
+
+/**
+ * The two pages an update from 2.0.4 or earlier shows after What's new: canvas reading, then the
+ * menu. Each is shown once. Continue saves what the page shows; Skip and Back leave the setting as
+ * it was. A page left without an answer comes back at the next start, like the backup page.
+ */
+@NullMarked
+final class BareUpgradePagesOverlay {
+    /** Set once the canvas page has had Continue, Skip or Back, or the welcome covered it. */
+    static final String KEY_CANVAS_PAGE_DONE = "upgrade_canvas_page_done";
+
+    /** The same for the menu page. */
+    static final String KEY_MENU_PAGE_DONE = "upgrade_menu_page_done";
+
+    private static final int PAGE_CANVAS = 0;
+    private static final int PAGE_MENU = 1;
+    private static final long SWAP_MS = 320;
+
+    private final Activity mActivity;
+    private final SharedPreferences mPrefs;
+    private final ViewGroup mRoot;
+    private final Runnable mThen;
+    private final View mOverlay;
+    private final FrameLayout mStage;
+    private final View[] mHiddenBehind;
+    private @Nullable OnBackPressedCallback mBackCallback;
+
+    private int mPage = -1;
+    private boolean mDone;
+
+    private boolean mCanvasOn;
+    private boolean mCanvasTouched;
+    private @Nullable MaterialSwitch mCanvasSwitch;
+    private @Nullable BareCanvasFlowView mCanvasPicture;
+
+    private boolean mMenuCard;
+    private @Nullable BareMenuStyleView mMenuPicture;
+    private @Nullable View mMenuCardRow;
+    private @Nullable View mMenuClassicRow;
+
+    /**
+     * Shows whichever of the two pages this profile has not answered yet, then runs {@code then}.
+     * Runs {@code then} straight away when there is nothing to show.
+     */
+    static void maybeShow(Activity activity, SharedPreferences prefs, Runnable then) {
+        boolean canvas = !prefs.getBoolean(KEY_CANVAS_PAGE_DONE, false);
+        boolean menu = !prefs.getBoolean(KEY_MENU_PAGE_DONE, false);
+        // Only for a profile that finished a welcome before; a new install sees both in it.
+        if ((!canvas && !menu) || !prefs.getBoolean("shown", false)) {
+            then.run();
+            return;
+        }
+        if (RiseSheet.isOpen()) return;
+        @Nullable ViewGroup root = activity.findViewById(android.R.id.content);
+        if (root == null || root.findViewById(R.id.bare_upgrade_pages_root) != null) return;
+        new BareUpgradePagesOverlay(activity, prefs, root, then)
+                .show(canvas ? PAGE_CANVAS : PAGE_MENU);
+    }
+
+    private BareUpgradePagesOverlay(
+            Activity activity, SharedPreferences prefs, ViewGroup root, Runnable then) {
+        mActivity = activity;
+        mPrefs = prefs;
+        mRoot = root;
+        mThen = then;
+        mOverlay =
+                LayoutInflater.from(activity)
+                        .inflate(R.layout.bare_upgrade_pages_overlay, root, false);
+        // Not part of the activity's saved state, like the welcome.
+        mOverlay.setSaveFromParentEnabled(false);
+        mStage = mOverlay.findViewById(R.id.bare_upgrade_pages_stage);
+        mHiddenBehind = new View[root.getChildCount()];
+        mMenuCard =
+                ChromeSharedPreferences.getInstance()
+                        .readBoolean(ChromePreferenceKeys.BARE_MENU_CARD, true);
+    }
+
+    private void show(int page) {
+        // Keeps a screen reader on these pages, away from the browser they cover.
+        for (int i = 0; i < mHiddenBehind.length; i++) {
+            mHiddenBehind[i] = mRoot.getChildAt(i);
+            mHiddenBehind[i].setImportantForAccessibility(
+                    View.IMPORTANT_FOR_ACCESSIBILITY_NO_HIDE_DESCENDANTS);
+        }
+        mOverlay.findViewById(R.id.bare_upgrade_pages_continue)
+                .setOnClickListener(v -> answer(/* save= */ true));
+        mOverlay.findViewById(R.id.bare_upgrade_pages_skip)
+                .setOnClickListener(v -> answer(/* save= */ false));
+        if (mActivity instanceof ComponentActivity componentActivity) {
+            mBackCallback =
+                    new OnBackPressedCallback(true) {
+                        @Override
+                        public void handleOnBackPressed() {
+                            answer(/* save= */ false);
+                        }
+                    };
+            componentActivity.getOnBackPressedDispatcher().addCallback(mBackCallback);
+        }
+
+        // The browser draws edge to edge, so keep the content clear of the system bars. The
+        // insets are read from the window, as the welcome does, because the browser consumes them.
+        mOverlay.addOnLayoutChangeListener(
+                (view, l, t, r, b, oldL, oldT, oldR, oldB) -> {
+                    WindowInsetsCompat insets = ViewCompat.getRootWindowInsets(view);
+                    if (insets == null) return;
+                    Insets bars =
+                            insets.getInsets(
+                                    WindowInsetsCompat.Type.systemBars()
+                                            | WindowInsetsCompat.Type.displayCutout());
+                    if (view.getPaddingTop() == bars.top
+                            && view.getPaddingBottom() == bars.bottom
+                            && view.getPaddingLeft() == bars.left
+                            && view.getPaddingRight() == bars.right) {
+                        return;
+                    }
+                    view.post(() -> view.setPadding(bars.left, bars.top, bars.right, bars.bottom));
+                });
+        mRoot.addView(mOverlay);
+
+        // When What's new was seen at an earlier start, this is the first screen, and the system
+        // splash would otherwise fade out over it.
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S) {
+            mActivity
+                    .getSplashScreen()
+                    .setOnExitAnimationListener(splashView -> splashView.remove());
+        }
+        showPage(page);
+    }
+
+    // -------------------------------------------------------------------------------------------
+    // Moving through the pages.
+
+    private void showPage(int page) {
+        mPage = page;
+        View view = page == PAGE_CANVAS ? buildCanvasPage() : buildMenuPage();
+        @Nullable View old = mStage.getChildCount() > 0 ? mStage.getChildAt(0) : null;
+        mStage.addView(view);
+        if (old != null) {
+            if (!ValueAnimator.areAnimatorsEnabled()) {
+                mStage.removeView(old);
+            } else {
+                // The old page moves off to the start side, the new one comes in from the end.
+                float density = mActivity.getResources().getDisplayMetrics().density;
+                boolean rtl = mStage.getLayoutDirection() == View.LAYOUT_DIRECTION_RTL;
+                float shift = 32 * density * (rtl ? -1 : 1);
+                old.setImportantForAccessibility(
+                        View.IMPORTANT_FOR_ACCESSIBILITY_NO_HIDE_DESCENDANTS);
+                old.animate()
+                        .alpha(0f)
+                        .translationX(-shift)
+                        .setDuration(SWAP_MS)
+                        .setInterpolator(easeOut())
+                        .withEndAction(() -> mStage.removeView(old))
+                        .start();
+                view.setAlpha(0f);
+                view.setTranslationX(shift);
+                view.animate()
+                        .alpha(1f)
+                        .translationX(0f)
+                        .setDuration(SWAP_MS)
+                        .setInterpolator(easeOut())
+                        .start();
+            }
+        }
+        // A screen reader starts at the new page's title.
+        AccessibilityManager accessibility =
+                (AccessibilityManager) mActivity.getSystemService(Activity.ACCESSIBILITY_SERVICE);
+        if (accessibility != null && accessibility.isEnabled()) {
+            View title = view.findViewById(R.id.bare_page_title);
+            title.post(
+                    () ->
+                            title.performAccessibilityAction(
+                                    AccessibilityNodeInfo.ACTION_ACCESSIBILITY_FOCUS, null));
+        }
+    }
+
+    /** Continue saves what the page shows; Skip and Back keep what was there. Both move on. */
+    private void answer(boolean save) {
+        if (mDone) return;
+        if (mPage == PAGE_CANVAS) {
+            // Written only when the switch was used: its starting position may not have been read
+            // from the profile yet, and an untouched switch already matches the setting.
+            if (save && mCanvasTouched) {
+                boolean on = mCanvasOn;
+                BareWelcomeOverlay.whenProfileReady(
+                        profile -> BareSecurityChoices.setBlockCanvasReading(profile, on));
+            }
+            mPrefs.edit().putBoolean(KEY_CANVAS_PAGE_DONE, true).apply();
+            if (!mPrefs.getBoolean(KEY_MENU_PAGE_DONE, false)) {
+                showPage(PAGE_MENU);
+                return;
+            }
+        } else {
+            if (save) {
+                ChromeSharedPreferences.getInstance()
+                        .writeBoolean(ChromePreferenceKeys.BARE_MENU_CARD, mMenuCard);
+            }
+            mPrefs.edit().putBoolean(KEY_MENU_PAGE_DONE, true).apply();
+        }
+        finish();
+    }
+
+    private void finish() {
+        mDone = true;
+        if (mBackCallback != null) mBackCallback.remove();
+        mRoot.removeView(mOverlay);
+        for (View behind : mHiddenBehind) {
+            behind.setImportantForAccessibility(View.IMPORTANT_FOR_ACCESSIBILITY_AUTO);
+        }
+        mThen.run();
+    }
+
+    // -------------------------------------------------------------------------------------------
+    // The canvas page: the welcome's own page, with its switch and picture.
+
+    private View buildCanvasPage() {
+        View page =
+                LayoutInflater.from(mActivity)
+                        .inflate(R.layout.bare_welcome_page_canvas, mStage, false);
+        mCanvasPicture = page.findViewById(R.id.bare_canvas_flow);
+        mCanvasPicture.setBlocking(mCanvasOn, false);
+        View row = page.findViewById(R.id.bare_row_canvas);
+        BareWelcomeOverlay.setUpOptionRow(
+                row,
+                R.drawable.ic_grid_view_24dp,
+                R.string.bare_welcome_opt_canvas,
+                R.string.bare_welcome_hint_canvas);
+        mCanvasSwitch =
+                BareWelcomeOverlay.switchOptionRow(
+                        row,
+                        mCanvasOn,
+                        on -> {
+                            mCanvasOn = on;
+                            mCanvasTouched = true;
+                            if (mCanvasPicture != null) mCanvasPicture.setBlocking(on, true);
+                        });
+        // Off unless the user already turned it on, which only the profile knows.
+        BareWelcomeOverlay.whenProfileReady(
+                profile -> {
+                    if (mDone || mCanvasTouched) return;
+                    mCanvasOn = BareSecurityChoices.isBlockCanvasReading(profile);
+                    if (mCanvasSwitch != null) mCanvasSwitch.setChecked(mCanvasOn);
+                    if (mCanvasPicture != null) mCanvasPicture.setBlocking(mCanvasOn, false);
+                });
+        return page;
+    }
+
+    // -------------------------------------------------------------------------------------------
+    // The menu page: Bare's card or the classic list, starting on the one in use.
+
+    private View buildMenuPage() {
+        View page =
+                LayoutInflater.from(mActivity)
+                        .inflate(R.layout.bare_upgrade_page_menu, mStage, false);
+        mMenuPicture = page.findViewById(R.id.bare_menu_style_picture);
+        mMenuPicture.setCardStyle(mMenuCard, false);
+        mMenuCardRow = page.findViewById(R.id.bare_menu_option_card);
+        mMenuClassicRow = page.findViewById(R.id.bare_menu_option_classic);
+        menuRow(mMenuCardRow, R.string.bare_welcome_menu_card_option, true);
+        menuRow(mMenuClassicRow, R.string.bare_welcome_menu_classic_option, false);
+        updateMenuRows();
+        return page;
+    }
+
+    private void menuRow(View row, int labelRes, boolean card) {
+        ((TextView) row.findViewById(R.id.bare_chooser_label)).setText(labelRes);
+        row.setOnClickListener(
+                v -> {
+                    if (mMenuCard == card) return;
+                    mMenuCard = card;
+                    updateMenuRows();
+                    if (mMenuPicture != null) mMenuPicture.setCardStyle(card, true);
+                });
+        row.setAccessibilityDelegate(
+                new View.AccessibilityDelegate() {
+                    @Override
+                    public void onInitializeAccessibilityNodeInfo(
+                            View host, AccessibilityNodeInfo info) {
+                        super.onInitializeAccessibilityNodeInfo(host, info);
+                        info.setClassName(RadioButton.class.getName());
+                        info.setCheckable(true);
+                        info.setChecked(mMenuCard == card);
+                    }
+                });
+    }
+
+    private void updateMenuRows() {
+        if (mMenuCardRow == null || mMenuClassicRow == null) return;
+        mMenuCardRow
+                .findViewById(R.id.bare_chooser_check)
+                .setVisibility(mMenuCard ? View.VISIBLE : View.INVISIBLE);
+        mMenuClassicRow
+                .findViewById(R.id.bare_chooser_check)
+                .setVisibility(mMenuCard ? View.INVISIBLE : View.VISIBLE);
+    }
+
+    private static PathInterpolator easeOut() {
+        return new PathInterpolator(0.2f, 0.8f, 0.2f, 1f);
+    }
+}

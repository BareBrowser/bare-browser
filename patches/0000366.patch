diff --git a/chrome/android/java/src/org/chromium/chrome/browser/bare/BareMenuStyleView.java b/chrome/android/java/src/org/chromium/chrome/browser/bare/BareMenuStyleView.java
new file mode 100644
index 00000000000..4b3a00eeb27
--- /dev/null
+++ b/chrome/android/java/src/org/chromium/chrome/browser/bare/BareMenuStyleView.java
@@ -0,0 +1,259 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.bare;
+
+import android.animation.ValueAnimator;
+import android.content.Context;
+import android.graphics.Canvas;
+import android.graphics.Paint;
+import android.graphics.RectF;
+import android.util.AttributeSet;
+import android.view.View;
+import android.view.animation.PathInterpolator;
+
+import androidx.core.content.ContextCompat;
+
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.chrome.R;
+
+/**
+ * The picture on the menu page an update shows: a small phone screen whose menu is either Bare's
+ * card, rising from behind the toolbar, or the classic list that opens from the menu button. A
+ * change of choice plays the one going away out and the other in.
+ */
+@NullMarked
+public class BareMenuStyleView extends View {
+    private static final long MOVE_MS = 460;
+    private static final long INTRO_DELAY_MS = 280;
+
+    private final Paint mFill = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint mStroke = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final RectF mRect = new RectF();
+    private final RectF mRow = new RectF();
+    private final float mDensity;
+
+    private boolean mCardStyle = true;
+    // How far each menu is open, 0 to 1.
+    private float mCard;
+    private float mClassic;
+    private boolean mIntroPending = true;
+    private @Nullable ValueAnimator mAnimator;
+
+    public BareMenuStyleView(Context context, @Nullable AttributeSet attrs) {
+        super(context, attrs);
+        mDensity = context.getResources().getDisplayMetrics().density;
+        mStroke.setStyle(Paint.Style.STROKE);
+        mStroke.setStrokeWidth(1.25f * mDensity);
+        updateDescription();
+    }
+
+    /** Shows one menu or the other, moving between them unless animations are off. */
+    public void setCardStyle(boolean card, boolean animate) {
+        mCardStyle = card;
+        updateDescription();
+        if (mIntroPending && !isAttachedToWindow()) return;
+        mIntroPending = false;
+        moveTo(animate);
+    }
+
+    @Override
+    protected void onAttachedToWindow() {
+        super.onAttachedToWindow();
+        if (!mIntroPending) return;
+        mIntroPending = false;
+        // The chosen menu opens a moment after the page appears, so it is seen to open.
+        if (ValueAnimator.areAnimatorsEnabled()) {
+            postDelayed(() -> moveTo(true), INTRO_DELAY_MS);
+        } else {
+            moveTo(false);
+        }
+    }
+
+    @Override
+    protected void onDetachedFromWindow() {
+        if (mAnimator != null) mAnimator.cancel();
+        super.onDetachedFromWindow();
+    }
+
+    private void moveTo(boolean animate) {
+        if (mAnimator != null) mAnimator.cancel();
+        float cardTo = mCardStyle ? 1f : 0f;
+        float classicTo = mCardStyle ? 0f : 1f;
+        if (!animate || !ValueAnimator.areAnimatorsEnabled() || !isAttachedToWindow()) {
+            mCard = cardTo;
+            mClassic = classicTo;
+            invalidate();
+            return;
+        }
+        float cardFrom = mCard;
+        float classicFrom = mClassic;
+        ValueAnimator animator = ValueAnimator.ofFloat(0f, 1f);
+        animator.setDuration(MOVE_MS);
+        animator.setInterpolator(new PathInterpolator(0.4f, 0f, 0.2f, 1f));
+        animator.addUpdateListener(
+                a -> {
+                    float f = (float) a.getAnimatedValue();
+                    mCard = cardFrom + (cardTo - cardFrom) * f;
+                    mClassic = classicFrom + (classicTo - classicFrom) * f;
+                    invalidate();
+                });
+        mAnimator = animator;
+        animator.start();
+    }
+
+    private void updateDescription() {
+        setContentDescription(
+                getContext()
+                        .getString(
+                                mCardStyle
+                                        ? R.string.bare_upgrade_menu_picture_card
+                                        : R.string.bare_upgrade_menu_picture_classic));
+    }
+
+    @Override
+    protected void onMeasure(int widthSpec, int heightSpec) {
+        setMeasuredDimension(MeasureSpec.getSize(widthSpec), Math.round(196 * mDensity));
+    }
+
+    @Override
+    protected void onDraw(Canvas canvas) {
+        Context context = getContext();
+        int accent = ContextCompat.getColor(context, R.color.bare_welcome_accent);
+        int card = ContextCompat.getColor(context, R.color.bare_welcome_card);
+        int background = ContextCompat.getColor(context, R.color.bare_welcome_bg);
+        int divider = ContextCompat.getColor(context, R.color.bare_welcome_divider);
+        int soft = ContextCompat.getColor(context, R.color.bare_welcome_soft);
+        float d = mDensity;
+        boolean rtl = getLayoutDirection() == LAYOUT_DIRECTION_RTL;
+
+        // The screen.
+        float screenWidth = Math.min(getWidth() - 48 * d, 240 * d);
+        float left = (getWidth() - screenWidth) / 2f;
+        float right = left + screenWidth;
+        float top = 14 * d;
+        float bottom = getHeight() - 14 * d;
+        float radius = 16 * d;
+        mRect.set(left, top, right, bottom);
+        mFill.setColor(background);
+        canvas.drawRoundRect(mRect, radius, radius, mFill);
+
+        // A page: a few lines of text.
+        mFill.setColor(divider);
+        float line = top + 18 * d;
+        float[] widths = {0.62f, 0.86f, 0.74f, 0.8f, 0.5f};
+        for (float w : widths) {
+            float start = rtl ? right - 14 * d - (screenWidth - 28 * d) * w : left + 14 * d;
+            float end = rtl ? right - 14 * d : start + (screenWidth - 28 * d) * w;
+            mRect.set(start, line, end, line + 6 * d);
+            canvas.drawRoundRect(mRect, 3 * d, 3 * d, mFill);
+            line += 16 * d;
+        }
+
+        // The toolbar, with the menu button at its end.
+        float barTop = bottom - 30 * d;
+        float menuX = rtl ? left + 18 * d : right - 18 * d;
+        float barMid = (barTop + bottom) / 2f;
+
+        // Bare's card comes up from behind the toolbar, so it is drawn under it and clipped to the
+        // screen above it.
+        if (mCard > 0f) {
+            float cardHeight = 84 * d;
+            float shift = (1f - mCard) * cardHeight;
+            canvas.save();
+            canvas.clipRect(left, top, right, barTop);
+            mRect.set(left + 8 * d, barTop - cardHeight + shift, right - 8 * d, barTop + 12 * d);
+            mFill.setColor(card);
+            mFill.setAlpha(Math.round(255 * Math.min(1f, mCard * 1.6f)));
+            canvas.drawRoundRect(mRect, 14 * d, 14 * d, mFill);
+            mStroke.setColor(divider);
+            mStroke.setAlpha(mFill.getAlpha());
+            canvas.drawRoundRect(mRect, 14 * d, 14 * d, mStroke);
+            // A row of round shortcuts and two lines under them.
+            float rowY = mRect.top + 22 * d;
+            float spacing = (mRect.width() - 24 * d) / 4f;
+            mFill.setColor(soft);
+            mFill.setAlpha(mStroke.getAlpha());
+            for (int i = 0; i < 4; i++) {
+                canvas.drawCircle(mRect.left + 12 * d + spacing * (i + 0.5f), rowY, 9 * d, mFill);
+            }
+            mFill.setColor(accent);
+            mFill.setAlpha(mStroke.getAlpha());
+            for (int i = 0; i < 4; i++) {
+                canvas.drawCircle(mRect.left + 12 * d + spacing * (i + 0.5f), rowY, 3 * d, mFill);
+            }
+            mFill.setColor(divider);
+            mFill.setAlpha(mStroke.getAlpha());
+            float lineY = rowY + 20 * d;
+            for (int i = 0; i < 2; i++) {
+                mRow.set(left + 22 * d, lineY, right - 22 * d - i * 40 * d, lineY + 5 * d);
+                if (rtl) mRow.offset(i * 40 * d, 0);
+                canvas.drawRoundRect(mRow, 2.5f * d, 2.5f * d, mFill);
+                lineY += 13 * d;
+            }
+            canvas.restore();
+            mStroke.setAlpha(255);
+            mFill.setAlpha(255);
+        }
+
+        // The bar keeps the screen's rounded bottom corners.
+        mFill.setColor(card);
+        canvas.save();
+        canvas.clipRect(left, barTop, right, bottom);
+        mRect.set(left, top, right, bottom);
+        canvas.drawRoundRect(mRect, radius, radius, mFill);
+        canvas.restore();
+        mFill.setColor(divider);
+        canvas.drawRect(left, barTop, right, barTop + 1 * d, mFill);
+        // The address bar.
+        float pillStart = rtl ? left + 34 * d : left + 12 * d;
+        float pillEnd = rtl ? right - 12 * d : right - 34 * d;
+        mRect.set(pillStart, barMid - 7 * d, pillEnd, barMid + 7 * d);
+        canvas.drawRoundRect(mRect, 7 * d, 7 * d, mFill);
+        // The menu button, three dots.
+        mFill.setColor(accent);
+        for (int i = -1; i <= 1; i++) {
+            canvas.drawCircle(menuX, barMid + i * 5 * d, 1.7f * d, mFill);
+        }
+
+        // The classic list opens from the menu button.
+        if (mClassic > 0f) {
+            float listWidth = Math.min(108 * d, screenWidth * 0.55f);
+            float listHeight = 92 * d;
+            float scale = 0.7f + 0.3f * mClassic;
+            float pivotX = menuX;
+            float pivotY = barTop - 4 * d;
+            canvas.save();
+            canvas.scale(scale, scale, pivotX, pivotY);
+            float listRight = rtl ? left + 6 * d + listWidth : right - 6 * d;
+            float listLeft = listRight - listWidth;
+            mRect.set(listLeft, pivotY - listHeight, listRight, pivotY);
+            int alpha = Math.round(255 * Math.min(1f, mClassic * 1.4f));
+            mFill.setColor(card);
+            mFill.setAlpha(alpha);
+            canvas.drawRoundRect(mRect, 6 * d, 6 * d, mFill);
+            mStroke.setColor(divider);
+            mStroke.setAlpha(alpha);
+            canvas.drawRoundRect(mRect, 6 * d, 6 * d, mStroke);
+            mFill.setColor(divider);
+            mFill.setAlpha(alpha);
+            float rowY = mRect.top + 12 * d;
+            for (int i = 0; i < 5; i++) {
+                float rowEnd = mRect.right - 12 * d - (i % 2) * 18 * d;
+                mRow.set(mRect.left + 12 * d, rowY, rowEnd, rowY + 5 * d);
+                canvas.drawRoundRect(mRow, 2.5f * d, 2.5f * d, mFill);
+                rowY += 16 * d;
+            }
+            canvas.restore();
+            mStroke.setAlpha(255);
+            mFill.setAlpha(255);
+        }
+
+        // The screen's edge, last so nothing draws over it.
+        mStroke.setColor(divider);
+        mRect.set(left, top, right, bottom);
+        canvas.drawRoundRect(mRect, radius, radius, mStroke);
+    }
+}
